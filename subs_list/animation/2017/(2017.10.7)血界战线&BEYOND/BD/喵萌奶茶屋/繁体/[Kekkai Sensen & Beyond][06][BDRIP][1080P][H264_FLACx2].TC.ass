Dialogue: 0,0:00:50.07,0:00:53.78,CN,,0,0,0,,{\c&H00030303\bord2\3c&H00FFFFFF\blur3\fn微软雅黑\fs40\an8\fad(0,1200)}翻譯：青淮 呆呆 大助  校對：Nemeton  時軸：紅塵  後期：poi  繁化：風風 特效：果汁
Dialogue: 0,0:00:03.27,0:00:03.90,CN,,0,0,0,,切
Dialogue: 0,0:00:04.38,0:00:07.61,CN,,0,0,0,,好不容易才找到東西
Dialogue: 0,0:00:07.61,0:00:08.89,CN,,0,0,0,,怎麼辦
Dialogue: 0,0:00:09.10,0:00:12.12,CN,,0,0,0,,他們沒有眼睛 我的義眼就沒用了
Dialogue: 0,0:00:12.12,0:00:15.49,CN,,0,0,0,,這種時候只要用氣勢就可以了 陰毛
Dialogue: 0,0:00:15.75,0:00:17.52,CN,,0,0,0,,你真是什麼都用這一套啊
Dialogue: 0,0:00:19.71,0:00:20.53,CN,,0,0,0,,小心 雷歐
Dialogue: 0,0:00:31.42,0:00:32.45,CN,,0,0,0,,米修菈?
Dialogue: 0,0:00:39.18,0:00:40.43,CN,,0,0,0,,抉擇吧
Dialogue: 0,0:00:40.81,0:00:43.09,CN,,0,0,0,,讓誰看到最後
Dialogue: 0,0:00:47.03,0:00:47.69,CN,,0,0,0,,不要
Dialogue: 0,0:00:48.55,0:00:49.65,CN,,0,0,0,,不要 米修菈
Dialogue: 0,0:00:50.41,0:00:52.21,CN,,0,0,0,,你沒必要去背負這些
Dialogue: 0,0:00:53.19,0:00:56.03,CN,,0,0,0,,要奪走的話 就從我這裡奪去吧
Dialogue: 0,0:00:56.65,0:00:58.25,CN,,0,0,0,,如你所願
Dialogue: 0,0:01:11.89,0:01:13.95,CN,,0,0,0,,米修菈!!
Dialogue: 0,0:02:56.75,0:02:59.02,CN,,0,0,0,,喔?你醒了
Dialogue: 0,0:02:59.21,0:03:00.37,CN,,0,0,0,,醫生…
Dialogue: 0,0:03:01.52,0:03:04.49,CN,,0,0,0,,怎麼?聽說你頭槌失敗了
Dialogue: 0,0:03:04.90,0:03:05.41,CN,,0,0,0,,咦?
Dialogue: 0,0:03:05.72,0:03:07.06,CN,,0,0,0,,真是冒失
Dialogue: 0,0:03:09.95,0:03:11.00,CN,,0,0,0,,殺了他
Dialogue: 0,0:03:11.60,0:03:13.63,CN,,0,0,0,,我一定要殺了他
Dialogue: 0,0:03:14.43,0:03:15.68,CN,,0,0,0,,啊 對了
Dialogue: 0,0:03:16.63,0:03:17.62,CN,,0,0,0,,那個…醫生
Dialogue: 0,0:03:23.58,0:03:25.71,CN,,0,0,0,,我是不推薦啦
Dialogue: 0,0:03:26.46,0:03:27.49,CN,,0,0,0,,說起來
Dialogue: 0,0:03:27.76,0:03:30.48,CN,,0,0,0,,赫爾沙雷姆茲·羅特的醫療措施
Dialogue: 0,0:03:30.77,0:03:35.12,CN,,0,0,0,,大多數都是建立在那邊的規則存在的基礎上
Dialogue: 0,0:03:35.49,0:03:37.64,CN,,0,0,0,,一旦將這種方法用於人界
Dialogue: 0,0:03:37.78,0:03:40.13,CN,,0,0,0,,就會發生 從縫合的位置開始裡外翻轉啦
Dialogue: 0,0:03:40.13,0:03:43.28,CN,,0,0,0,,牽連一整個村子產生新生物啦 這種事
Dialogue: 0,0:03:43.73,0:03:47.20,CN,,0,0,0,,所以要想使你妹妹奇蹟般地能夠正常行走
Dialogue: 0,0:03:47.41,0:03:49.33,CN,,0,0,0,,要想視力恢復得和原來一樣
Dialogue: 0,0:03:49.89,0:03:52.58,CN,,0,0,0,,其風險還是不可估量的
Dialogue: 0,0:03:55.86,0:03:58.67,CN,,0,0,0,,果然這雙眼睛的情況也差不多嗎
Dialogue: 0,0:04:02.89,0:04:03.40,CN,,0,0,0,,等…
Dialogue: 0,0:04:08.08,0:04:09.83,CN,,0,0,0,,神之義眼嗎
Dialogue: 0,0:04:11.42,0:04:13.84,CN,,0,0,0,,第一次看到實物
Dialogue: 0,0:04:14.91,0:04:15.60,CN,,0,0,0,,醫生
Dialogue: 0,0:04:16.18,0:04:18.89,CN,,0,0,0,,聽說以前神之義眼的持有者身邊
Dialogue: 0,0:04:19.32,0:04:22.95,CN,,0,0,0,,一定會出現失明的人 這是真的嗎
Dialogue: 0,0:04:23.33,0:04:25.33,CN,,0,0,0,,哎呀 你調查得挺詳細嘛
Dialogue: 0,0:04:25.73,0:04:26.90,CN,,0,0,0,,你說的沒錯
Dialogue: 0,0:04:27.29,0:04:32.37,CN,,0,0,0,,人界異界有共53冊文獻是這樣記載的
Dialogue: 0,0:04:33.72,0:04:34.91,CN,,0,0,0,,雷歐納魯德
Dialogue: 0,0:04:35.18,0:04:38.53,CN,,0,0,0,,你想治好妹妹的眼睛吧
Dialogue: 0,0:04:39.14,0:04:40.61,CN,,0,0,0,,當然了
Dialogue: 0,0:04:41.16,0:04:44.06,CN,,0,0,0,,我來赫爾沙雷姆茲·羅特就是為了這個
Dialogue: 0,0:04:44.41,0:04:45.53,CN,,0,0,0,,這樣嗎
Dialogue: 0,0:04:47.73,0:04:52.04,CN,,0,0,0,,其實有關神之義眼持有者的記載並不少
Dialogue: 0,0:04:52.14,0:04:55.66,CN,,0,0,0,,但其中提到摘除義眼的記載數目卻為零
Dialogue: 0,0:04:57.02,0:05:01.03,CN,,0,0,0,,恐怕將這義眼摘除並不能算是醫療行為
Dialogue: 0,0:05:01.62,0:05:06.51,CN,,0,0,0,,要說的話 就只能算是單方面違背與神性存在之間的契約
Dialogue: 0,0:05:07.40,0:05:10.46,CN,,0,0,0,,其代價想必是與之相應的
Dialogue: 0,0:05:27.47,0:05:28.27,CN,,0,0,0,,可惡
Dialogue: 0,0:05:28.88,0:05:30.11,CN,,0,0,0,,已經走投無路了
Dialogue: 0,0:05:36.15,0:05:37.77,CN,,0,0,0,,喔?那是什麼
Dialogue: 0,0:05:38.26,0:05:39.06,CN,,0,0,0,,是哥哥
Dialogue: 0,0:05:40.38,0:05:41.19,CN,,0,0,0,,那這個呢
Dialogue: 0,0:05:41.43,0:05:42.22,CN,,0,0,0,,我自己
Dialogue: 0,0:05:42.78,0:05:45.25,CN,,0,0,0,,你是公主我卻是烏龜啊
Dialogue: 0,0:05:45.79,0:05:47.57,CN,,0,0,0,,不是啦 你仔細看
Dialogue: 0,0:05:47.92,0:05:49.72,CN,,0,0,0,,哥哥是龜騎士
Dialogue: 0,0:05:50.42,0:05:52.78,CN,,0,0,0,,從幽靈手裡保護公主
Dialogue: 0,0:05:53.58,0:05:54.88,CN,,0,0,0,,但還是烏龜啊
Dialogue: 0,0:05:55.36,0:05:56.48,CN,,0,0,0,,烏龜不也挺好嗎
Dialogue: 0,0:05:56.77,0:05:57.92,CN,,0,0,0,,不好啦
Dialogue: 0,0:05:58.37,0:05:59.85,CN,,0,0,0,,烏龜可是遲鈍的象徵
Dialogue: 0,0:06:03.17,0:06:03.83,CN,,0,0,0,,對不起
Dialogue: 0,0:06:04.49,0:06:05.90,CN,,0,0,0,,對不起 米修菈
Dialogue: 0,0:06:19.12,0:06:22.01,CN,,0,0,0,,只要不曾放棄追尋光明
Dialogue: 0,0:06:22.63,0:06:25.51,CN,,0,0,0,,人的靈魂就絕不會敗北
Dialogue: 0,0:06:26.98,0:06:28.24,CN,,0,0,0,,…絕對不會
Dialogue: 0,0:06:30.45,0:06:31.38,CN,,0,0,0,,克勞斯先生
Dialogue: 0,0:06:32.52,0:06:35.20,CN,,0,0,0,,我果然還是看不到光明
Dialogue: 0,0:06:39.99,0:06:41.91,CN,,0,0,0,,擋道了 陰毛
Dialogue: 0,0:06:41.91,0:06:43.74,CN,,0,0,0,,別用單個詞稱呼我啊
Dialogue: 0,0:06:44.02,0:06:45.88,CN,,0,0,0,,屈辱感倍增啊
Dialogue: 0,0:06:45.88,0:06:46.58,CN,,0,0,0,,好好
Dialogue: 0,0:06:46.74,0:06:48.11,CN,,0,0,0,,陰毛大人
Dialogue: 0,0:06:48.67,0:06:51.81,CN,,0,0,0,,別把我叫得好像是下面的毛的統領一樣啊
Dialogue: 0,0:06:52.15,0:06:54.11,CN,,0,0,0,,要打架嗎 陰毛閣下
Dialogue: 0,0:06:54.11,0:06:56.62,CN,,0,0,0,,來啊 可惡 來啊
Dialogue: 0,0:06:57.70,0:06:59.06,CN,,0,0,0,,痛痛痛…
Dialogue: 0,0:06:59.40,0:07:01.94,CN,,0,0,0,,滅亡吧 陰毛星人
Dialogue: 0,0:07:02.58,0:07:04.61,CN,,0,0,0,,救命啊 救命啊
Dialogue: 0,0:07:05.79,0:07:08.07,CN,,0,0,0,,這叫聲聽著真悅耳
Dialogue: 0,0:07:13.34,0:07:15.56,CN,,0,0,0,,你們倆能住手嗎
Dialogue: 0,0:07:17.56,0:07:20.16,CN,,0,0,0,,那滿面春風的笑容是怎麼回事
Dialogue: 0,0:07:20.44,0:07:24.38,CN,,0,0,0,,那個人越被逼到極限就會變得越友善
Dialogue: 0,0:07:29.27,0:07:30.45,CN,,0,0,0,,啊 克勞斯
Dialogue: 0,0:07:30.84,0:07:31.45,CN,,0,0,0,,謝謝
Dialogue: 0,0:07:32.61,0:07:34.11,CN,,0,0,0,,別太勉強自己
Dialogue: 0,0:07:34.46,0:07:35.80,CN,,0,0,0,,那可不行啊
Dialogue: 0,0:07:36.21,0:07:38.34,CN,,0,0,0,,如果有人又發動「震災召喚」
Dialogue: 0,0:07:38.53,0:07:40.23,CN,,0,0,0,,會有數以萬計的人死亡
Dialogue: 0,0:07:40.71,0:07:42.65,CN,,0,0,0,,我一定會完成代碼逆算
Dialogue: 0,0:07:43.02,0:07:44.44,CN,,0,0,0,,將犯人追查到底的
Dialogue: 0,0:07:48.02,0:07:49.03,CN,,0,0,0,,是吉貝爾特
Dialogue: 0,0:07:49.65,0:07:51.78,CN,,0,0,0,,喔…好漂亮啊
Dialogue: 0,0:07:52.30,0:07:54.42,CN,,0,0,0,,他說明天傍晚就回來
Dialogue: 0,0:07:54.80,0:07:57.07,CN,,0,0,0,,這麼匆忙幹什麼啊
Dialogue: 0,0:07:57.51,0:08:00.89,CN,,0,0,0,,侄女的結婚儀式慢慢享受不就好啦
Dialogue: 0,0:08:04.05,0:08:05.10,CN,,0,0,0,,斯塔費茲先生
Dialogue: 0,0:08:05.76,0:08:06.92,CN,,0,0,0,,這邊已經準備好了
Dialogue: 0,0:08:07.07,0:08:07.57,CN,,0,0,0,,嗯
Dialogue: 0,0:08:08.74,0:08:11.62,CN,,0,0,0,,好了 是時候打擊他們一下了
Dialogue: 0,0:08:15.96,0:08:18.12,CN,,0,0,0,,來吧 開始了
Dialogue: 0,0:08:18.59,0:08:20.12,CN,,0,0,0,,演算開始!
Dialogue: 0,0:08:24.15,0:08:26.27,CN,,0,0,0,,給我等著瞧吧 蠢貨們
Dialogue: 0,0:08:26.34,0:08:31.61,CN,,0,0,0,,我這就循著你們惡行的痕跡 讓你們完全暴露出來
Dialogue: 0,0:08:32.21,0:08:36.20,CN,,0,0,0,,趁著還沒被定罪儘管悠閒地歡笑吧
Dialogue: 0,0:08:38.37,0:08:39.08,CN,,0,0,0,,發生什麼事了
Dialogue: 0,0:08:45.26,0:08:47.59,CN,,0,0,0,,嗯?那傢伙不是…
Dialogue: 0,0:08:48.21,0:08:49.77,CN,,0,0,0,,普拉納里歐博士嗎
Dialogue: 0,0:08:50.07,0:08:50.78,CN,,0,0,0,,真的嗎?
Dialogue: 0,0:08:51.64,0:08:54.48,CN,,0,0,0,,那傢伙不是在一年前被捉住並收監了嗎
Dialogue: 0,0:08:55.01,0:08:57.78,CN,,0,0,0,,他不會是把身體組織的一部分留在外面了吧
Dialogue: 0,0:08:59.64,0:09:00.74,CN,,0,0,0,,緊急召集
Dialogue: 0,0:09:01.99,0:09:03.73,CN,,0,0,0,,如果讓那傢伙繼續進化下去的話
Dialogue: 0,0:09:03.88,0:09:05.37,CN,,0,0,0,,事態會變得無法挽回的
Dialogue: 0,0:09:05.86,0:09:07.73,CN-UP,,0,0,0,,這次一定會一點不剩地…
Dialogue: 0,0:09:07.73,0:09:10.48,CN,,0,0,0,,好的 那我先去趟便利商店吧
Dialogue: 0,0:09:49.85,0:09:50.88,CN,,0,0,0,,啊 錢包忘了
Dialogue: 0,0:09:55.23,0:09:56.39,CN,,0,0,0,,你是誰啊
Dialogue: 0,0:09:59.49,0:10:02.66,CN,,0,0,0,,即使打倒了我 還會有第二個第三個我…
Dialogue: 0,0:10:05.01,0:10:05.76,CN,,0,0,0,,可以撤了
Dialogue: 0,0:10:06.20,0:10:07.58,CN,,0,0,0,,請把他認真地密封好
Dialogue: 0,0:10:07.66,0:10:10.58,CN,,0,0,0,,是關起來還是焚毀掉就交給你們了
Dialogue: 0,0:10:10.70,0:10:11.21,CN,,0,0,0,,遵命
Dialogue: 0,0:10:11.61,0:10:12.70,CN,,0,0,0,,千萬別打碎了
Dialogue: 0,0:10:12.83,0:10:13.92,CN,,0,0,0,,他的細胞會留下來的
Dialogue: 0,0:10:14.91,0:10:16.97,CN,,0,0,0,,處理得還真是乾脆快速
Dialogue: 0,0:10:20.04,0:10:20.67,CN,,0,0,0,,克勞斯
Dialogue: 0,0:10:23.06,0:10:24.99,CN,,0,0,0,,聯繫不上安妮拉
Dialogue: 0,0:10:29.11,0:10:30.66,CN,,0,0,0,,你們是誰啊
Dialogue: 0,0:10:33.77,0:10:34.83,CN,,0,0,0,,沒事吧
Dialogue: 0,0:10:35.15,0:10:36.00,CN,,0,0,0,,發生了什麼事
Dialogue: 0,0:10:37.02,0:10:38.92,CN,,0,0,0,,入…入口
Dialogue: 0,0:10:40.69,0:10:42.53,CN,,0,0,0,,電梯不見了
Dialogue: 0,0:10:43.25,0:10:45.28,CN,,0,0,0,,總之我們先去別處看看吧
Dialogue: 0,0:10:45.73,0:10:47.28,CN,,0,0,0,,入口並不只有這一個
Dialogue: 0,0:10:48.09,0:10:49.90,CN,,0,0,0,,請大家分頭去確認一下吧
Dialogue: 0,0:10:53.45,0:10:54.57,CN,,0,0,0,,你沒事吧?史帝夫
Dialogue: 0,0:10:54.78,0:10:55.99,CN,,0,0,0,,嗯?沒事
Dialogue: 0,0:10:56.66,0:10:58.10,CN,,0,0,0,,我也聯繫一下尤利安吧
Dialogue: 0,0:10:58.73,0:11:01.02,CN,,0,0,0,,你就在事務所下層先等著吧
Dialogue: 0,0:11:01.67,0:11:02.54,CN,,0,0,0,,多謝了
Dialogue: 0,0:11:07.65,0:11:09.26,CN,,0,0,0,,到底發生了什麼事
Comment: 0,0:11:12.15,0:11:15.07,CN,,0,0,0,,螢幕字: 大停工 Get·the·Lockout
Dialogue: 0,0:11:12.15,0:11:15.07,STAFF-微软雅黑,,0,0,0,,{\an5\fad(0,0)\bord0\blur1\alpha20\p1\c&H06C9EE&\fscx238\fscy238\pos(464,652)}m 0 0 l 50 0 l 50 50 l 0 50
Dialogue: 0,0:11:12.15,0:11:15.07,STAFF-微软雅黑,,0,0,0,,{\an5\fad(0,0)\bord0\blur1\alpha20\p1\c&H101B09&\fscx238\fscy238\pos(586,652)}m 0 0 l 50 0 l 50 50 l 0 50
Dialogue: 0,0:11:12.15,0:11:15.07,STAFF-微软雅黑,,0,0,0,,{\an5\fad(0,0)\bord0\blur1\alpha20\p1\c&H06C9EE&\fscx238\fscy238\pos(708,654)}m 0 0 l 50 0 l 50 50 l 0 50
Dialogue: 0,0:11:12.15,0:11:15.07,CN,,0,0,0,,{\fn方正粗雅宋_GBK\fs60\bord1\blur5\fsp0\c&HFDFDFD&\3c&H07D6F1&\fscx83\fscy100\pos(614,588)}Get·the·Lockout
Dialogue: 0,0:11:12.15,0:11:15.07,CN,,0,0,0,,{\fn微软雅黑\fs120\bord1\b1\blur5\fsp35\c&H090909&\3c&H090909&\pos(600.8,706.8)}大{\c&HFDFDFD&\3c&HFDFDFD&}停{\c&H090909&\3c&H090909&}工
Dialogue: 0,0:11:19.96,0:11:21.11,CN,,0,0,0,,你頭上有東西啊
Dialogue: 0,0:11:21.48,0:11:22.64,CN,,0,0,0,,我弄不掉它們
Dialogue: 0,0:11:23.05,0:11:24.54,CN,,0,0,0,,看來你們是沒什麼收穫
Dialogue: 0,0:11:25.04,0:11:25.66,CN,,0,0,0,,沒錯
Dialogue: 0,0:11:28.01,0:11:28.66,CN,,0,0,0,,怎麼樣了
Dialogue: 0,0:11:29.00,0:11:31.79,CN,,0,0,0,,行不通 出來就到了地鐵的站台上
Dialogue: 0,0:11:32.24,0:11:36.07,CN,,0,0,0,,我這邊的入口連的是不認識的用具室的門
Dialogue: 0,0:11:36.44,0:11:38.22,CN,,0,0,0,,我來囉 各位久等了
Dialogue: 0,0:11:39.80,0:11:41.76,CN,,0,0,0,,開鎖公司來了喔
Dialogue: 0,0:11:42.18,0:11:43.26,CN,,0,0,0,,你來了啊 尤利安
Dialogue: 0,0:11:44.00,0:11:44.68,CN,,0,0,0,,幫大忙了
Dialogue: 0,0:11:53.08,0:11:55.70,CN,,0,0,0,,嗯…這可不太妙
Dialogue: 0,0:11:56.07,0:11:57.72,CN,,0,0,0,,現在是二級{\fsp5}「防衛警戒態勢」
Dialogue: 0,0:11:56.07,0:11:57.72,CN,,0,0,0,,{\fs35\pos(758,652)}DEFense readiness CONdition
Dialogue: 0,0:11:57.80,0:11:58.37,CN,,0,0,0,,什麼?
Dialogue: 0,0:11:58.81,0:12:01.63,CN,,0,0,0,,而且現在已經從內部完全上鎖了
Dialogue: 0,0:12:02.97,0:12:04.89,CN,,0,0,0,,裡面有誰在嗎
Dialogue: 0,0:12:05.01,0:12:06.30,CN,,0,0,0,,估計安妮拉在
Dialogue: 0,0:12:06.90,0:12:09.11,CN,,0,0,0,,有沒有可能是她做的手腳?
Dialogue: 0,0:12:09.72,0:12:10.77,CN,,0,0,0,,不 不太可能
Dialogue: 0,0:12:11.82,0:12:13.76,CN,,0,0,0,,完全想不到她有什麼理由這麼做
Dialogue: 0,0:12:14.53,0:12:15.67,CN,,0,0,0,,這樣嗎
Dialogue: 0,0:12:16.05,0:12:21.74,CN,,0,0,0,,總之 從物理和魔法層面進行的連接都被完全截斷了
Dialogue: 0,0:12:29.07,0:12:29.78,CN,,0,0,0,,珍小姐!
Dialogue: 0,0:12:30.67,0:12:33.50,CN,,0,0,0,,糟糕了 那傢伙完全不知情
Dialogue: 0,0:12:37.73,0:12:38.80,CN,,0,0,0,,您好 這邊是皇…
Dialogue: 0,0:12:45.42,0:12:46.32,CN,,0,0,0,,珍小姐!
Dialogue: 0,0:12:50.28,0:12:51.83,CN,,0,0,0,,鬥流血法
Dialogue: 0,0:12:52.14,0:12:53.88,CN,,0,0,0,,紅絡新婦
Dialogue: 0,0:13:01.79,0:13:03.00,CN,,0,0,0,,沒事吧 珍
Dialogue: 0,0:13:03.94,0:13:05.79,CN,,0,0,0,,我…我看到了
Dialogue: 0,0:13:06.16,0:13:06.67,CN,,0,0,0,,嗯?
Dialogue: 0,0:13:07.40,0:13:10.14,CN,,0,0,0,,裡面滿是巨大的昆蟲
Dialogue: 0,0:13:10.77,0:13:15.21,CN,,0,0,0,,形容一下的話就是直徑過一公尺的長腳蚊!
Dialogue: 0,0:13:15.84,0:13:16.70,CN,,0,0,0,,真的假的
Dialogue: 0,0:13:18.57,0:13:19.78,CN,,0,0,0,,但是啊…
Dialogue: 0,0:13:19.86,0:13:21.57,CN,,0,0,0,,再怎麼說也就是蟲子吧
Dialogue: 0,0:13:22.04,0:13:23.77,CN,,0,0,0,,就算聚集上上億隻
Dialogue: 0,0:13:23.77,0:13:25.69,CN,,0,0,0,,駭進我們的防衛系統
Dialogue: 0,0:13:25.69,0:13:28.04,CN,,0,0,0,,提高「防衛警戒態勢」等級這可能嗎
Dialogue: 0,0:13:29.52,0:13:31.47,CN,,0,0,0,,看來它們也擁有相應的智能
Dialogue: 0,0:13:32.45,0:13:37.08,CN,,0,0,0,,那群傢伙在這短短的兩小時內侵入並繁殖
Dialogue: 0,0:13:37.30,0:13:39.22,CN,,0,0,0,,據此看來我們還不能否認這種可能性——
Dialogue: 0,0:13:39.36,0:13:42.02,CN,,0,0,0,,它們曾經歷過一系列超出我們常識的進化
Dialogue: 0,0:13:46.09,0:13:47.93,CN,,0,0,0,,事態緊急 刻不容緩啊
Dialogue: 0,0:13:48.29,0:13:52.57,CN,,0,0,0,,尤利安 解除這封鎖要花多長時間?
Dialogue: 0,0:13:53.13,0:13:55.37,CN,,0,0,0,,給我三個小時應該能解決
Dialogue: 0,0:13:55.69,0:13:56.33,CN,,0,0,0,,拜託了
Dialogue: 0,0:13:57.01,0:13:59.29,CN,,0,0,0,,萬一出了什麼意外 又得重頭演算了
Dialogue: 0,0:14:00.31,0:14:03.08,CN,,0,0,0,,根據我的預測 那群傢伙在幾天內就會…
Dialogue: 0,0:14:05.33,0:14:06.16,CN,,0,0,0,,怎麼了 少年?
Dialogue: 0,0:14:08.42,0:14:09.96,CN,,0,0,0,,我看到了「震災存在」!
Dialogue: 0,0:14:10.73,0:14:12.99,CN,,0,0,0,,現在正在被召喚來
Dialogue: 0,0:14:13.28,0:14:15.66,CN,,0,0,0,,什麼 這也太快了
Dialogue: 0,0:14:16.20,0:14:19.97,CN,,0,0,0,,難道說那些傢伙成功縮短了最短詠唱時間嗎?
Dialogue: 0,0:14:21.99,0:14:25.94,CN,,0,0,0,,話這麼說 可我們什麼也看不到啊
Dialogue: 0,0:14:26.84,0:14:29.83,CN,,0,0,0,,該死 要是他的指尖接觸到了地面一切都完了啊
Dialogue: 0,0:14:32.64,0:14:35.12,CN,,0,0,0,,嗨! 史帝夫先生!
Dialogue: 0,0:14:35.65,0:14:37.10,CN,,0,0,0,,我已經就位了唷
Dialogue: 0,0:14:37.45,0:14:39.01,CN,,0,0,0,,咦? 是K·K嗎
Dialogue: 0,0:14:40.26,0:14:42.39,CN,,0,0,0,,你這沒出息的聲音是怎麼回事
Dialogue: 0,0:14:42.79,0:14:45.89,CN,,0,0,0,,我現在可是打算賣你個人情啊
Dialogue: 0,0:14:46.10,0:14:48.62,CN,,0,0,0,,至少也感謝我一下吧
Dialogue: 0,0:14:49.12,0:14:50.46,CN,,0,0,0,,喂 你要做什麼
Dialogue: 0,0:14:50.46,0:14:53.40,CN,,0,0,0,,啊 裡面確實一副慘狀啊
Dialogue: 0,0:14:53.92,0:14:55.79,CN,,0,0,0,,這是什麼蜂房嗎
Dialogue: 0,0:14:56.08,0:14:58.90,CN,,0,0,0,,總之 我先來一發電擊彈
Dialogue: 0,0:14:59.17,0:15:00.56,CN,,0,0,0,,將它們清理乾淨怎麼樣
Dialogue: 0,0:15:00.90,0:15:03.24,CN,,0,0,0,,不要啊!!
Dialogue: 0,0:15:04.36,0:15:06.90,CN,,0,0,0,,裡面的電腦還在演算當中啊
Dialogue: 0,0:15:06.90,0:15:08.10,CN,,0,0,0,,會全部被你清理掉的啊
Dialogue: 0,0:15:08.31,0:15:11.30,CN,,0,0,0,,而且安妮拉也有可能還在裡面
Dialogue: 0,0:15:12.10,0:15:12.62,CN,,0,0,0,,嘖
Dialogue: 0,0:15:12.80,0:15:14.05,CN,,0,0,0,,你這咂嘴是要幹什麼啊
Dialogue: 0,0:15:14.25,0:15:16.27,CN,,0,0,0,,我說什麼奇怪的話了嗎
Dialogue: 0,0:15:21.46,0:15:25.11,CN,,0,0,0,,初…次…見…面… 諸位
Dialogue: 0,0:15:25.58,0:15:26.40,CN,,0,0,0,,是誰?
Dialogue: 0,0:15:27.18,0:15:28.09,CN,,0,0,0,,先報上名字來
Dialogue: 0,0:15:28.49,0:15:31.74,CN,,0,0,0,,名字什麼的…我沒有
Dialogue: 0,0:15:32.32,0:15:37.37,CN,,0,0,0,,我幾十分鐘前才意識到自我存在
Dialogue: 0,0:15:37.76,0:15:40.09,CN,,0,0,0,,不過就這段時間
Dialogue: 0,0:15:40.83,0:15:46.31,CN,,0,0,0,,我已經進化得十分接近人類了
Dialogue: 0,0:15:47.11,0:15:48.56,CN,,0,0,0,,你有何目的
Dialogue: 0,0:15:49.51,0:15:51.01,CN,,0,0,0,,目的?
Dialogue: 0,0:15:51.54,0:15:52.93,CN,,0,0,0,,簡單來說
Dialogue: 0,0:15:52.93,0:15:57.79,CN,,0,0,0,,就是在我進化成神之前希望暫借一下此地
Dialogue: 0,0:15:58.04,0:15:59.87,CN,,0,0,0,,請容我拒絕
Dialogue: 0,0:16:00.29,0:16:03.81,CN,,0,0,0,,我們現在就必須回到那裡
Dialogue: 0,0:16:07.60,0:16:09.87,CN,,0,0,0,,是我表達有誤
Dialogue: 0,0:16:09.96,0:16:12.45,CN,,0,0,0,,我並沒有在徵求你們的同意
Dialogue: 0,0:16:12.82,0:16:16.45,CN,,0,0,0,,你們沒有選擇的餘地
Dialogue: 0,0:16:20.98,0:16:22.00,CN,,0,0,0,,光網?
Dialogue: 0,0:16:22.39,0:16:24.57,CN,,0,0,0,,糟了 進入一級「防衛警戒態勢」了
Dialogue: 0,0:16:35.52,0:16:39.34,CN,,0,0,0,,完了 這是超級警戒模式了
Dialogue: 0,0:16:46.49,0:16:49.65,CN,,0,0,0,,雷歐納魯德 剛剛你說出現了光網對吧
Dialogue: 0,0:16:49.80,0:16:51.09,CN,,0,0,0,,咦?是的
Dialogue: 0,0:16:52.01,0:16:53.78,CN,,0,0,0,,你侵入我的眼球的話
Dialogue: 0,0:16:54.07,0:16:55.87,CN,,0,0,0,,我就也能夠看到了對嗎
Dialogue: 0,0:16:56.99,0:16:57.53,CN,,0,0,0,,是的
Dialogue: 0,0:17:01.86,0:17:02.62,CN,,0,0,0,,原來如此
Dialogue: 0,0:17:03.63,0:17:05.71,CN,,0,0,0,,老大 你打算怎麼做
Dialogue: 0,0:17:06.97,0:17:10.88,CN,,0,0,0,,自古以來 人被反鎖在家門外的時候
Dialogue: 0,0:17:11.16,0:17:12.47,CN,,0,0,0,,都是從二樓爬進去的
Dialogue: 0,0:17:24.88,0:17:27.20,CN,,0,0,0,,當血鬥術的發動達到極限
Dialogue: 0,0:17:27.88,0:17:30.40,CN,,0,0,0,,血液又恢復原狀的話會如何
Dialogue: 0,0:17:31.15,0:17:33.57,CN,,0,0,0,,當然會在那一瞬間「嘩!」一下就完蛋了
Dialogue: 0,0:17:34.37,0:17:35.72,CN,,0,0,0,,看來在爬到地方之前
Dialogue: 0,0:17:35.92,0:17:38.81,CN,,0,0,0,,必須給血液中注入保持狀態的「念」
Dialogue: 0,0:17:39.15,0:17:42.91,CN,,0,0,0,,啊?這也太亂來了吧老大
Dialogue: 0,0:17:43.14,0:17:47.53,CN,,0,0,0,,你的技能和燃燒凍結什麼的 完全不是一個等級啊
Dialogue: 0,0:17:48.80,0:17:51.90,CN,,0,0,0,,放心吧 我可是受過鍛鍊的
Dialogue: 0,0:18:20.33,0:18:22.37,CN,,0,0,0,,克勞斯先生的字典裡從來沒出現過吧…
Dialogue: 0,0:18:23.05,0:18:24.59,CN,,0,0,0,,放棄之類的字眼
Dialogue: 0,0:18:31.87,0:18:33.90,CN,,0,0,0,,K·K 作戰開始
Dialogue: 0,0:18:35.37,0:18:37.56,CN,,0,0,0,,給我好好抓緊了唷
Dialogue: 0,0:18:41.55,0:18:44.10,CN,,0,0,0,,嘿嘿嘿 沒用的
Dialogue: 0,0:18:44.51,0:18:47.14,CN,,0,0,0,,這個安全系統的防禦能力到底有多強
Dialogue: 0,0:18:47.37,0:18:50.51,CN,,0,0,0,,你們不是應該更清楚嗎
Dialogue: 0,0:19:06.37,0:19:07.96,CN,,0,0,0,,不 這是…
Dialogue: 0,0:19:08.52,0:19:09.32,CN,,0,0,0,,不對
Dialogue: 0,0:19:16.11,0:19:18.04,CN,,0,0,0,,果然是佯攻嗎
Dialogue: 0,0:19:37.11,0:19:38.07,CN,,0,0,0,,好 做得好
Dialogue: 0,0:19:38.50,0:19:39.46,CN,,0,0,0,,這樣的話…
Dialogue: 0,0:19:40.13,0:19:43.88,CN,,0,0,0,,尤利安 解除攻擊性防禦屏障…
Dialogue: 0,0:19:44.22,0:19:45.14,CN,,0,0,0,,不可能的
Dialogue: 0,0:19:45.75,0:19:46.63,CN,,0,0,0,,只要一瞬間就可以
Dialogue: 0,0:19:47.18,0:19:49.21,CN,,0,0,0,,只要你能撐開幾秒鐘的時間
Dialogue: 0,0:19:49.68,0:19:50.96,CN,,0,0,0,,我就可以強行擠進去
Dialogue: 0,0:19:54.79,0:19:57.92,CN,,0,0,0,,真是夠了 這鎖眼也太小了吧
Dialogue: 0,0:20:10.52,0:20:12.55,CN,,0,0,0,,布雷格利德流 血鬥術
Dialogue: 0,0:20:13.38,0:20:14.64,CN,,0,0,0,,32式
Dialogue: 0,0:20:16.03,0:20:18.76,CN,,0,0,0,,{\fsp10}電速刺尖擊
Dialogue: 0,0:20:16.03,0:20:18.76,CN -ﾏｾ,,0,0,0,,{\fs35\fscx67\fscy100}ブリッツウインディヒカイトドゥシュテェヒェン
Dialogue: 0,0:20:21.93,0:20:23.58,CN,,0,0,0,,終於要完成了!
Dialogue: 0,0:20:23.58,0:20:25.98,CN,,0,0,0,,離地面只差20英尺了
Dialogue: 0,0:20:23.58,0:20:25.98,CN,,0,0,0,,{\fs40\pos(718,656)\fscx118\fscy93}6.1m
Dialogue: 0,0:20:26.13,0:20:28.58,CN,,0,0,0,,利希塔 你真是個天才
Dialogue: 0,0:20:28.58,0:20:31.92,CN,,0,0,0,,這將會成為被載入史冊的大災難啊
Dialogue: 0,0:20:33.30,0:20:35.14,CN,,0,0,0,,忍不住了 我得去小便
Dialogue: 0,0:20:35.14,0:20:36.55,CN,,0,0,0,,蠢貨啊你
Dialogue: 0,0:20:36.55,0:20:39.41,CN,,0,0,0,,只差一點點了 忍耐一下啊
Dialogue: 0,0:20:39.53,0:20:41.77,CN,,0,0,0,,太好了 馬上完成了
Dialogue: 0,0:20:41.77,0:20:43.53,CN,,0,0,0,,要開始倒數計時嗎
Dialogue: 0,0:20:44.47,0:20:45.71,CN,,0,0,0,,好主意
Dialogue: 0,0:20:45.71,0:20:47.64,CN,,0,0,0,,笨蛋 還早著呢
Dialogue: 0,0:20:47.85,0:20:49.10,CN,,0,0,0,,你快點 卡魯
Dialogue: 0,0:20:48.68,0:20:49.81,CN-UP,,0,0,0,,等等我
Dialogue: 0,0:20:50.52,0:20:51.43,CN,,0,0,0,,該死
Dialogue: 0,0:20:52.77,0:20:54.41,CN,,0,0,0,,要完成了喔
Dialogue: 0,0:20:55.36,0:20:59.40,CN,,0,0,0,,十 九 八 七
Dialogue: 0,0:20:59.52,0:21:02.34,CN,,0,0,0,,六 五 四
Dialogue: 0,0:21:02.41,0:21:04.16,CN,,0,0,0,,三 二
Dialogue: 0,0:21:04.36,0:21:05.42,CN,,0,0,0,,一
Dialogue: 0,0:21:06.13,0:21:07.88,CN,,0,0,0,,艾絲梅拉達式血凍道
Dialogue: 0,0:21:08.70,0:21:10.75,CN,,0,0,0,,{\fsp10}絕對零度之風
Dialogue: 0,0:21:08.70,0:21:10.75,CN -ﾏｾ,,0,0,0,,{\fs35}ヴィエントデルセロアブソルート
Dialogue: 0,0:21:16.11,0:21:17.64,CN,,0,0,0,,阻止召喚…
Dialogue: 0,0:21:18.49,0:21:19.32,CN,,0,0,0,,完成
Dialogue: 0,0:21:27.14,0:21:32.22,CN,,0,0,0,,就這樣 史上最重大的封鎖停工事件落下了帷幕
Dialogue: 0,0:21:33.04,0:21:36.22,CN,,0,0,0,,本來以為史帝夫先生會支持不住的
Dialogue: 0,0:21:36.68,0:21:38.71,CN,,0,0,0,,但他快速處理完自己手頭的事情之後
Dialogue: 0,0:21:39.10,0:21:42.07,CN,,0,0,0,,說著 我回去休息一會 就早早回去了
Dialogue: 0,0:21:43.07,0:21:47.09,CN,,0,0,0,,而事務所也開始了大規模的檢修
Dialogue: 0,0:21:47.93,0:21:48.97,CN,,0,0,0,,來了
Dialogue: 0,0:21:48.97,0:21:49.86,CN,,0,0,0,,歡迎光臨
Dialogue: 0,0:21:54.50,0:21:56.01,CN,,0,0,0,,這一小段時間內
Dialogue: 0,0:21:57.30,0:21:59.32,CN,,0,0,0,,我們失去了放鬆偷懶的地方
Dialogue: 0,0:23:35.38,0:23:36.33,CN,,0,0,0,,不能放棄
Dialogue: 0,0:23:40.94,0:23:43.31,CN,,0,0,0,,是啊 米修菈
Dialogue: 0,0:23:45.76,0:23:47.03,CN,,0,0,0,,與孤獨相遇時
Dialogue: 0,0:23:47.54,0:23:48.95,CN,,0,0,0,,就會不知所措
Dialogue: 0,0:23:49.20,0:23:51.49,CN,,0,0,0,,倍受絕望之感折磨呢
Dialogue: 0,0:23:52.12,0:23:53.29,CN,,0,0,0,,但是請放心
Dialogue: 0,0:23:53.71,0:23:55.75,CN,,0,0,0,,若絕望的是世界
Dialogue: 0,0:23:56.04,0:23:59.56,CN,,0,0,0,,希望也必然存在於這世界
Dialogue: 0,0:15:59.87,0:16:00.31,CN,,0,0,0,,
