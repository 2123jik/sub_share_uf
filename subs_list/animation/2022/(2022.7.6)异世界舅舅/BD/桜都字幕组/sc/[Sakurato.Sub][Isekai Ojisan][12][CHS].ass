Comment: 0,0:00:00.00,0:00:00.00,OPJP,,0,0,0,code once,function contains_pt(ass_shape,pt_x,pt_y)   local cnt=0 local pt_x,pt_y=math.round(pt_x*1,3),math.round(pt_y*1,3)   local function line_isect_cnt(x1,y1,x2,y2,y)       local top,bottom=math.min(y1,y2),math.max(y1,y2)       if y>=top and y<bottom and bottom-top>1e-4 then           local x=x1+((x2-x1)/(y2-y1))*(y-y1)           if x and x<=pt_x then               cnt=cnt+sgn(y2-y1)           end       end   end   local function isTop(y1,y2,y3,y4)       local y={y1,y2,y3,y4}       for i=1,3 do           if y[i]<y[i+1] then               return 1           elseif y[i]>y[i+1] then               return 0           end       end       return 0   end   local function ignore_max_extreme_pt(x1,y1,y2,y3,x4,y4,t,x)       if t==0 and x1<=x then           cnt=cnt+isTop(y1,y2,y3,y4)       elseif t==1 and x4<=x then           cnt=cnt-isTop(y4,y3,y2,y1)       end     end   local function count(x1,y1,x2,y2,x3,y3,x4,y4,t)       if t then           t=math.round(t,5)           if t<1 and t>0 then               if cubic_bezier(x1,x2,x3,x4,t)<=pt_x then                   local ang=-angle_at(t,x1,y1,x2,y2,x3,y3,x4,y4)                   cnt=cnt+sgn(ang%180==0 and 0 or ang)               end           else ignore_max_extreme_pt(x1,y1,y2,y3,x4,y4,t,pt_x)           end       end   end   local function bezier_isect_cnt(x1,y1,x2,y2,x3,y3,x4,y4,y)       local top,bottom=math.min(y1,y2,y3,y4),math.max(y1,y2,y3,y4)       local left,right=math.min(x1,x2,x3,x4),math.max(x1,x2,x3,x4)       if right-left<1e-4 then           line_isect_cnt(x1,y1,x4,y4,y)       else           if y>=top and y<=bottom and bottom-top>1e-4 then               local a,b,c,d=math.round(3*y2+y4-3*y3-y1,5),math.round(3*y1-6*y2+3*y3,5),math.round(3*y2-3*y1,5),math.round(y1,5)               local t1,t2,t3=solveCubic(a,b,c,d-y)               count(x1,y1,x2,y2,x3,y3,x4,y4,t1) count(x1,y1,x2,y2,x3,y3,x4,y4,t2) count(x1,y1,x2,y2,x3,y3,x4,y4,t3)           end       end   end   for m i