Comment: 0,0:00:00.00,0:00:00.00,OPJP,,0,0,0,code once,function pixelate(ass_shape,n1,n2)   local left,top,_,_,width,height=Bounding(ass_shape)   local n1,n2=n1 or 3,n2 or 10 local px={n={}}   for i=n1,n2 do     local w,h=width/i,height/i local x0,y0=left+w/2,top+h/2     local x1,y1,x2,y2=math.round(-w/2,1),math.round(-h/2,1),math.round(w/2,1),math.round(-h/2,1)     local x3,y3,x4,y4=math.round(w/2,1),math.round(h/2,1),math.round(-w/2,1),math.round(h/2,1)     px[i-n1+1]={} local rect='m '..x1..' '..y1..' l '..x2..' '..y2..' l '..x3..' '..y3..' l '..x4..' '..y4..' '     for xi=1,i do       for yi=1,i do         local cx,cy=x0+(xi-1)*w,y0+(yi-1)*h         if contains_pt(ass_shape,cx,cy) then           px[i-n1+1][px[i-n1+1]+1]={x=math.round(cx,1),y=math.round(cy,1),s=rect}         end       end     end     px.n[i-n1+1]=px[i-n1+1]   end   px[px+1]={{x=0,y=0,s=ass_shape}} px.n[px.n+1]=1   return px end
