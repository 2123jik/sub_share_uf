Dialogue: 0,0:24:52.52,0:24:56.02,Default,,0,0,0,,{\blur2\bord1\fs120\fsp15\fnFZFW ZhenZhuTiJF L\c&H020103&\3c&H00013A&\pos(960,750)}期盼之人
Comment: 0,0:00:00.00,0:00:01.57,screen,,0,0,0,,screen
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,,Dialogue
Dialogue: 0,0:00:02.53,0:00:06.20,Default,,0,0,0,,不死 它是个不断变化的球
Dialogue: 0,0:00:07.99,0:00:10.16,Default,,0,0,0,,你好 我叫玖芽
Dialogue: 0,0:00:10.53,0:00:14.00,Default,,0,0,0,,出现在此的 是争夺他的人
Dialogue: 0,0:00:14.25,0:00:15.87,Default,,0,0,0,,哟 那边的小哥
Dialogue: 0,0:00:16.55,0:00:19.60,Default,,0,0,0,,以及阻止他们的人
Dialogue: 0,0:00:21.89,0:00:24.07,Default,,0,0,0,,被毒侵蚀过的人啊
Dialogue: 0,0:00:25.23,0:00:27.04,Default,,0,0,0,,可是很耐毒的
Dialogue: 0,0:00:27.51,0:00:28.80,Default,,0,0,0,,你是贾南达的…
Dialogue: 0,0:00:29.83,0:00:30.71,Default,,0,0,0,,托娜莉？
Dialogue: 0,0:02:05.85,0:02:09.96,Default,,0,0,0,,这是从小就经常站在我肩头的三趾猫头鹰
Dialogue: 0,0:02:11.24,0:02:13.12,Default,,0,0,0,,它的第三只脚趾会释放毒素
Dialogue: 0,0:02:13.39,0:02:15.49,Default,,0,0,0,,所以我每天都会吸收一点
Dialogue: 0,0:02:15.88,0:02:19.17,Default,,0,0,0,,后来我才知道 这个毒和西牵牛花的很像
Dialogue: 0,0:02:20.75,0:02:22.45,Default,,0,0,0,,猫头鹰少女 托娜莉
Dialogue: 0,0:02:22.86,0:02:24.54,Default,,0,0,0,,外祖母的传记里有记载
Dialogue: 0,0:02:25.34,0:02:26.48,Default,,0,0,0,,你为什么会来这村里
Dialogue: 0,0:02:26.90,0:02:29.28,Default,,0,0,0,,不是还有贾南达岛主的工作吗
Dialogue: 0,0:02:29.75,0:02:31.37,Default,,0,0,0,,交给同伴了
Dialogue: 0,0:02:31.88,0:02:34.07,Default,,0,0,0,,毕竟我还有很多没做完的事
Dialogue: 0,0:02:34.41,0:02:37.53,Default,,0,0,0,,既然相遇了就姑且给你个忠告
Dialogue: 0,0:02:38.00,0:02:40.09,Default,,0,0,0,,别再缠着不死了
Dialogue: 0,0:02:40.24,0:02:41.51,Default,,0,0,0,,这可不行
Dialogue: 0,0:02:42.10,0:02:44.21,Default,,0,0,0,,不死是我们守护团的东西
Dialogue: 0,0:02:44.54,0:02:45.71,Default,,0,0,0,,守护团吗
Dialogue: 0,0:02:46.09,0:02:47.93,Default,,0,0,0,,贾南达也有很多你们的人呢
Dialogue: 0,0:02:48.40,0:02:51.87,Default,,0,0,0,,只要不会危害到不死我是无所谓的
Dialogue: 0,0:02:52.19,0:02:55.34,Default,,0,0,0,,但是 如果你要和敲门者联手的话
Dialogue: 0,0:02:55.77,0:02:57.00,Default,,0,0,0,,就另当别论了
Dialogue: 0,0:02:57.78,0:02:59.03,Default,,0,0,0,,你不明白
Dialogue: 0,0:02:59.37,0:03:02.15,Default,,0,0,0,,敲门者对你和不死都是个威胁
Dialogue: 0,0:03:02.25,0:03:03.65,Default,,0,0,0,,不会的
Dialogue: 0,0:03:03.74,0:03:08.14,Default,,0,0,0,,它是祖母传给我 为了连系我们的重要伙伴
Dialogue: 0,0:03:09.50,0:03:11.35,Default,,0,0,0,,这个阿姨真吓人
Dialogue: 0,0:03:11.54,0:03:13.10,Default,,0,0,0,,她想杀了你
Dialogue: 0,0:03:13.68,0:03:16.69,Default,,0,0,0,,但别害怕 我会保护你的
Dialogue: 0,0:03:17.01,0:03:19.17,Default,,0,0,0,,连精神都被控制了吗
Dialogue: 0,0:03:19.55,0:03:21.26,Default,,0,0,0,,我会在一瞬间解决的
Dialogue: 0,0:03:27.82,0:03:28.64,Default,,0,0,0,,里贾德
Dialogue: 0,0:03:52.27,0:03:54.36,Default,,0,0,0,,可恶 根扎进去了
Dialogue: 0,0:03:58.16,0:03:59.77,Default,,0,0,0,,不行 不能睡
Dialogue: 0,0:04:01.76,0:04:04.14,Default,,0,0,0,,我要死在这了吗
Dialogue: 0,0:04:05.35,0:04:06.21,Default,,0,0,0,,不死
Dialogue: 0,0:04:07.52,0:04:08.24,Default,,0,0,0,,不死
Dialogue: 0,0:04:09.95,0:04:10.74,Default,,0,0,0,,不死…
Dialogue: 0,0:04:16.30,0:04:17.43,Default,,0,0,0,,你醒啦
Dialogue: 0,0:04:18.27,0:04:19.85,Default,,0,0,0,,我是这个村子的村长
Dialogue: 0,0:04:20.06,0:04:22.11,Default,,0,0,0,,很高兴见到你
Dialogue: 0,0:04:22.34,0:04:23.47,Default,,0,0,0,,昨晚发生什么了
Dialogue: 0,0:04:24.68,0:04:25.74,Default,,0,0,0,,我来带路
Dialogue: 0,0:04:36.19,0:04:38.04,Default,,0,0,0,,不死先生 你可算赶上了
Dialogue: 0,0:04:38.45,0:04:39.66,Default,,0,0,0,,发生什么了
Dialogue: 0,0:04:40.65,0:04:42.74,Default,,0,0,0,,咱俩睡着的时候
Dialogue: 0,0:04:42.91,0:04:45.53,Default,,0,0,0,,她被玖芽左臂里的敲门者袭击了
Dialogue: 0,0:04:45.85,0:04:46.65,Default,,0,0,0,,为什么
Dialogue: 0,0:04:46.79,0:04:47.82,Default,,0,0,0,,玖芽在哪
Dialogue: 0,0:04:48.09,0:04:50.18,Default,,0,0,0,,似乎被敲门者带走了
Dialogue: 0,0:04:50.91,0:04:55.06,Default,,0,0,0,,比起你 敲门者可能更恨她吧
Dialogue: 0,0:04:57.08,0:04:58.48,Default,,0,0,0,,全身都被侵蚀了
Dialogue: 0,0:05:00.00,0:05:02.03,Default,,0,0,0,,喂 得想点办法啊
Dialogue: 0,0:05:02.18,0:05:02.68,Default,,0,0,0,,赶快
Dialogue: 0,0:05:02.68,0:05:04.12,Default,,0,0,0,,别露出这种表情
Dialogue: 0,0:05:04.73,0:05:05.92,Default,,0,0,0,,笑一笑
Dialogue: 0,0:05:09.94,0:05:10.59,Default,,0,0,0,,喝吧
Dialogue: 0,0:05:13.06,0:05:15.08,Default,,0,0,0,,酒？这时候还喝？
Dialogue: 0,0:05:15.26,0:05:17.15,Default,,0,0,0,,已经没救了
Dialogue: 0,0:05:17.37,0:05:20.17,Default,,0,0,0,,体内肯定被开了很多洞吧
Dialogue: 0,0:05:20.53,0:05:22.97,Default,,0,0,0,,只能把积存的瘀血吐出来
Dialogue: 0,0:05:23.35,0:05:26.44,Default,,0,0,0,,所以最后至少让她喝一口最喜欢的酒吧
Dialogue: 0,0:05:26.90,0:05:27.99,Default,,0,0,0,,怎么会
Dialogue: 0,0:05:28.53,0:05:30.51,Default,,0,0,0,,我又没能保护到
Dialogue: 0,0:05:30.77,0:05:32.51,Default,,0,0,0,,没关系 不死
Dialogue: 0,0:05:32.92,0:05:34.64,Default,,0,0,0,,我现在很好
Dialogue: 0,0:05:34.98,0:05:36.89,Default,,0,0,0,,有什么我能做的吗
Dialogue: 0,0:05:37.46,0:05:40.14,Default,,0,0,0,,你愿意为我这个老阿姨做些什么吗
Dialogue: 0,0:05:40.25,0:05:41.35,Default,,0,0,0,,我好开心啊
Dialogue: 0,0:05:42.11,0:05:46.11,Default,,0,0,0,,那能在我死之前陪着我吗
Dialogue: 0,0:05:46.58,0:05:47.94,Default,,0,0,0,,这样就行了吗
Dialogue: 0,0:05:49.87,0:05:50.83,Default,,0,0,0,,足够了
Dialogue: 0,0:05:52.67,0:05:55.80,Default,,0,0,0,,听说你一直待在那个岛上
Dialogue: 0,0:05:56.40,0:05:58.28,Default,,0,0,0,,这40年都干了些什么呀
Dialogue: 0,0:05:58.71,0:06:01.49,Default,,0,0,0,,跟敲门者战斗 打败 吃掉它们
Dialogue: 0,0:06:01.63,0:06:02.41,Default,,0,0,0,,就这些？
Dialogue: 0,0:06:02.53,0:06:03.06,Default,,0,0,0,,不
Dialogue: 0,0:06:03.28,0:06:06.55,Default,,0,0,0,,因为这副身体最能让我感受到自我
Dialogue: 0,0:06:06.90,0:06:08.54,Default,,0,0,0,,我就想试试能把它发挥到什么程度
Dialogue: 0,0:06:09.22,0:06:12.31,Default,,0,0,0,,于是就开始练习射箭 锻炼身体
Dialogue: 0,0:06:12.55,0:06:14.48,Default,,0,0,0,,但却没一件是我擅长的
Dialogue: 0,0:06:15.07,0:06:16.98,Default,,0,0,0,,你为什么不离开岛呢
Dialogue: 0,0:06:17.56,0:06:18.37,Default,,0,0,0,,那是因为…
Dialogue: 0,0:06:18.98,0:06:21.74,Default,,0,0,0,,我不想再看到任何人死去了
Dialogue: 0,0:06:23.75,0:06:26.69,Default,,0,0,0,,我一直和一个叫皮欧兰的人生活在一起
Dialogue: 0,0:06:27.68,0:06:29.11,Default,,0,0,0,,她死的时候
Dialogue: 0,0:06:30.43,0:06:31.74,Default,,0,0,0,,我想只要不再见任何人
Dialogue: 0,0:06:32.72,0:06:34.86,Default,,0,0,0,,就不会再有这种痛苦的感受了
Dialogue: 0,0:06:35.66,0:06:36.80,Default,,0,0,0,,这是我当时的想法
Dialogue: 0,0:06:39.68,0:06:42.36,Default,,0,0,0,,我没有阻止他人死亡的能力
Dialogue: 0,0:06:42.87,0:06:44.05,Default,,0,0,0,,有很多没能挽救的
Dialogue: 0,0:06:44.56,0:06:46.56,Default,,0,0,0,,还有因为我死去的人们
Dialogue: 0,0:06:46.78,0:06:49.23,Default,,0,0,0,,今后你也要这样活下去吗
Dialogue: 0,0:06:49.66,0:06:50.99,Default,,0,0,0,,一个人静静地活着
Dialogue: 0,0:06:51.33,0:06:51.98,Default,,0,0,0,,如果可以的话
Dialogue: 0,0:06:52.40,0:06:55.62,Default,,0,0,0,,但这次你听到村里的危机却赶来了
Dialogue: 0,0:06:56.44,0:07:04.01,Default,,0,0,0,,我觉得你需要能理解你的人 也就是同伴
Dialogue: 0,0:07:04.53,0:07:05.57,Default,,0,0,0,,我受不了
Dialogue: 0,0:07:06.17,0:07:08.17,Default,,0,0,0,,受不了他们不惜牺牲自己
Dialogue: 0,0:07:08.50,0:07:10.09,Default,,0,0,0,,也要帮助我
Dialogue: 0,0:07:10.42,0:07:12.80,Default,,0,0,0,,所有人都会经历同伴的死
Dialogue: 0,0:07:13.11,0:07:15.68,Default,,0,0,0,,这并非你独有的烦恼
Dialogue: 0,0:07:15.85,0:07:16.68,Default,,0,0,0,,不是的
Dialogue: 0,0:07:17.03,0:07:18.96,Default,,0,0,0,,大家都会死 而我会活下去
Dialogue: 0,0:07:19.27,0:07:20.52,Default,,0,0,0,,今后一直会是这样
Dialogue: 0,0:07:21.15,0:07:22.83,Default,,0,0,0,,我一个人也能活下去
Dialogue: 0,0:07:23.18,0:07:24.35,Default,,0,0,0,,我不需要同伴
Dialogue: 0,0:07:25.64,0:07:26.32,Default,,0,0,0,,不死
Dialogue: 0,0:07:27.02,0:07:31.26,Default,,0,0,0,,我想看看那些你曾经遇到的人们
Dialogue: 0,0:07:32.86,0:07:35.31,Default,,0,0,0,,这是我这个将死之人最后的愿望
Dialogue: 0,0:07:35.72,0:07:36.31,Default,,0,0,0,,求你了
Dialogue: 0,0:07:36.90,0:07:37.63,Default,,0,0,0,,知道了
Dialogue: 0,0:07:38.45,0:07:39.36,Default,,0,0,0,,你可别被吓到
Dialogue: 0,0:07:40.97,0:07:43.60,Default,,0,0,0,,最开始遇到的是这个人
Dialogue: 0,0:07:44.14,0:07:45.86,Default,,0,0,0,,很年轻的模样
Dialogue: 0,0:07:46.60,0:07:47.61,Default,,0,0,0,,我不知道他的名字
Dialogue: 0,0:07:48.06,0:07:49.37,Default,,0,0,0,,他就像睡着一样死了
Dialogue: 0,0:07:50.13,0:07:51.82,Default,,0,0,0,,因为我没能帮上任何忙
Dialogue: 0,0:07:53.70,0:07:55.44,Default,,0,0,0,,下个遇到的是玛琦
Dialogue: 0,0:07:56.08,0:07:58.79,Default,,0,0,0,,她悉心照料了什么都不会的我
Dialogue: 0,0:07:59.76,0:08:02.21,Default,,0,0,0,,帕罗娜则拼了命地保护玛琦
Dialogue: 0,0:08:03.05,0:08:05.58,Default,,0,0,0,,但她俩都被早瀨杀了
Dialogue: 0,0:08:06.80,0:08:08.72,Default,,0,0,0,,然后我在塔库那哈遇到了谷谷
Dialogue: 0,0:08:09.26,0:08:11.62,Default,,0,0,0,,他为了我去和敲门者战斗
Dialogue: 0,0:08:12.01,0:08:13.09,Default,,0,0,0,,但也因此…
Dialogue: 0,0:08:14.26,0:08:17.21,Default,,0,0,0,,我从新那里夺走了他弟弟 谷谷
Dialogue: 0,0:08:19.52,0:08:22.24,Default,,0,0,0,,谷谷还有其他家人
Dialogue: 0,0:08:22.72,0:08:24.82,Default,,0,0,0,,酒爷 还有…
Dialogue: 0,0:08:25.19,0:08:25.71,Default,,0,0,0,,小玲
Dialogue: 0,0:08:29.75,0:08:31.41,Default,,0,0,0,,怎么了 不死先生
Dialogue: 0,0:08:31.74,0:08:34.97,Default,,0,0,0,,那之后我被带到了贾南达岛
Dialogue: 0,0:08:35.43,0:08:36.20,Default,,0,0,0,,在那里…
Dialogue: 0,0:08:36.64,0:08:38.84,Default,,0,0,0,,和一个叫南多的强者决斗
Dialogue: 0,0:08:39.32,0:08:42.46,Default,,0,0,0,,南多为了救弟弟不惜拼上性命
Dialogue: 0,0:08:43.10,0:08:44.08,Default,,0,0,0,,是个值得尊敬的人
Dialogue: 0,0:08:45.32,0:08:48.87,Default,,0,0,0,,所以我才下定决心要帮助贾南达的人们
Dialogue: 0,0:08:50.03,0:08:53.52,Default,,0,0,0,,还有其他为了我拼上性命战斗的人
Dialogue: 0,0:08:54.75,0:08:55.47,Default,,0,0,0,,威洛
Dialogue: 0,0:08:56.78,0:08:57.54,Default,,0,0,0,,米娅
Dialogue: 0,0:08:58.59,0:08:59.38,Default,,0,0,0,,乌帕
Dialogue: 0,0:08:59.83,0:09:00.63,Default,,0,0,0,,还有…
Dialogue: 0,0:09:01.11,0:09:02.96,Default,,0,0,0,,桑戴尔和托娜莉
Dialogue: 0,0:09:06.96,0:09:08.06,Default,,0,0,0,,还活着
Dialogue: 0,0:09:08.91,0:09:10.47,Default,,0,0,0,,他们俩还活着
Dialogue: 0,0:09:12.37,0:09:13.50,Default,,0,0,0,,太好了
Dialogue: 0,0:09:15.45,0:09:16.14,Default,,0,0,0,,你还好吗
Dialogue: 0,0:09:24.80,0:09:25.48,Default,,0,0,0,,不死
Dialogue: 0,0:09:26.18,0:09:28.30,Default,,0,0,0,,托娜莉 是个怎样的人
Dialogue: 0,0:09:29.02,0:09:29.59,Default,,0,0,0,,托娜莉吗
Dialogue: 0,0:09:30.22,0:09:31.14,Default,,0,0,0,,托娜莉她…
Dialogue: 0,0:09:31.87,0:09:34.18,Default,,0,0,0,,我一直觉得她很讨厌
Dialogue: 0,0:09:34.74,0:09:38.74,Default,,0,0,0,,但是 她带来了一群并肩战斗的伙伴
Dialogue: 0,0:09:40.82,0:09:43.33,Default,,0,0,0,,多管闲事了？
Dialogue: 0,0:09:43.96,0:09:45.44,Default,,0,0,0,,现在我很感激
Dialogue: 0,0:09:45.90,0:09:48.31,Default,,0,0,0,,不再是讨厌的家伙了？
Dialogue: 0,0:09:48.92,0:09:49.40,Default,,0,0,0,,嗯
Dialogue: 0,0:09:52.75,0:09:58.99,Default,,0,0,0,,不死 你勾起了很多大家还活着时的回忆
Dialogue: 0,0:09:59.90,0:10:00.86,Default,,0,0,0,,即便只是这些
Dialogue: 0,0:10:01.51,0:10:04.26,Default,,0,0,0,,也让我觉得活过真好
Dialogue: 0,0:10:15.59,0:10:17.63,Default,,0,0,0,,不死先生今后打算去哪
Dialogue: 0,0:10:18.14,0:10:19.29,Default,,0,0,0,,还没想好
Dialogue: 0,0:10:19.56,0:10:20.44,Default,,0,0,0,,这样啊
Dialogue: 0,0:10:21.30,0:10:25.08,Default,,0,0,0,,我要回一趟故乡 告知她的死讯
Dialogue: 0,0:10:25.86,0:10:27.77,Default,,0,0,0,,以后应付守护团的时候
Dialogue: 0,0:10:27.91,0:10:29.91,Default,,0,0,0,,请你一定要变成她
Dialogue: 0,0:10:30.33,0:10:35.24,Default,,0,0,0,,她是为了你才练就了百毒不侵的身体
Dialogue: 0,0:10:35.51,0:10:37.26,Default,,0,0,0,,为了我？为什么
Dialogue: 0,0:10:37.91,0:10:39.40,Default,,0,0,0,,你们是什么人
Dialogue: 0,0:10:39.61,0:10:41.50,Default,,0,0,0,,抱歉 我不能说
Dialogue: 0,0:10:41.78,0:10:42.95,Default,,0,0,0,,这是她的意思
Dialogue: 0,0:10:43.55,0:10:45.80,Default,,0,0,0,,说被你知道了会不好意思的
Dialogue: 0,0:10:46.00,0:10:47.84,Default,,0,0,0,,那至少能告诉我名字吗
Dialogue: 0,0:10:48.10,0:10:51.30,Default,,0,0,0,,我和她都最喜欢你了
Dialogue: 0,0:10:52.38,0:10:55.52,Default,,0,0,0,,「比起一支箭 还是很多支箭更有威力」
Dialogue: 0,0:10:56.15,0:11:00.72,Default,,0,0,0,,你的同伴 并不是为了让你痛苦才活着
Dialogue: 0,0:11:01.67,0:11:02.17,Default,,0,0,0,,再见
Dialogue: 0,0:11:13.85,0:11:14.57,Default,,0,0,0,,托娜莉
Dialogue: 0,0:11:15.39,0:11:17.23,Default,,0,0,0,,你现在在哪啊
Dialogue: 0,0:11:18.35,0:11:21.00,Default,,0,0,0,,心中已经没有遗憾了吗
Dialogue: 0,0:11:51.22,0:11:55.68,Default,,0,0,0,,她是为了你才练就了百毒不侵的身体
Dialogue: 0,0:11:58.72,0:11:59.60,Default,,0,0,0,,这样啊
Dialogue: 0,0:11:59.98,0:12:01.30,Default,,0,0,0,,原来是这样啊
Dialogue: 0,0:12:01.43,0:12:04.94,Default,,0,0,0,,我觉得你需要同伴
Dialogue: 0,0:12:06.78,0:12:09.46,Default,,0,0,0,,比起一支箭 还是很多支箭…
Dialogue: 0,0:12:16.36,0:12:18.06,Default,,0,0,0,,同伴吗
Dialogue: 0,0:12:33.39,0:12:35.86,Default,,0,0,0,,我应该去找能理解自己的人吗
Dialogue: 0,0:12:36.34,0:12:39.17,Default,,0,0,0,,但还是不想去有人的地方啊
Dialogue: 0,0:12:39.35,0:12:40.61,Default,,0,0,0,,有个好消息
Dialogue: 0,0:12:40.91,0:12:42.14,Default,,0,0,0,,敲门者出现了
Dialogue: 0,0:12:42.30,0:12:45.26,Default,,0,0,0,,在两个你赶不到的地方
Dialogue: 0,0:12:45.71,0:12:47.33,Default,,0,0,0,,这算哪门子好消息啊
Dialogue: 0,0:12:47.40,0:12:50.07,Default,,0,0,0,,这样封闭自己的意义就没了
Dialogue: 0,0:12:50.32,0:12:53.30,Default,,0,0,0,,不管你在哪 敲门者都会袭击人类
Dialogue: 0,0:12:53.64,0:12:55.48,Default,,0,0,0,,竟然不找我 去袭击别人
Dialogue: 0,0:12:55.72,0:12:58.27,Default,,0,0,0,,它们是想毁灭世界吗
Dialogue: 0,0:12:58.45,0:13:00.17,Default,,0,0,0,,为什么要这样做啊
Dialogue: 0,0:13:00.42,0:13:01.03,Default,,0,0,0,,谁知道呢
Dialogue: 0,0:13:01.36,0:13:04.45,Default,,0,0,0,,我能想到的可能是羡慕我们吧
Dialogue: 0,0:13:04.69,0:13:07.70,Default,,0,0,0,,你啊 怎么什么都不知道啊
Dialogue: 0,0:13:07.98,0:13:10.96,Default,,0,0,0,,我又不会精神控制
Dialogue: 0,0:13:11.07,0:13:13.23,Default,,0,0,0,,当然没法知道它们的想法
Dialogue: 0,0:13:13.47,0:13:15.58,Default,,0,0,0,,但你能控制肉体吧
Dialogue: 0,0:13:15.85,0:13:17.46,Default,,0,0,0,,那就阻止它们啊
Dialogue: 0,0:13:17.63,0:13:18.97,Default,,0,0,0,,你就什么想法也没有吗
Dialogue: 0,0:13:19.27,0:13:23.34,Default,,0,0,0,,既然你这么想 那这就是你接下来该去做的
Dialogue: 0,0:13:24.13,0:13:26.03,Default,,0,0,0,,别扯这些没用的 倒是来帮我啊
Dialogue: 0,0:13:28.49,0:13:29.45,Default,,0,0,0,,居然跑了
Dialogue: 0,0:13:30.59,0:13:32.43,Default,,0,0,0,,你在这吗 不死
Dialogue: 0,0:13:34.03,0:13:35.75,Default,,0,0,0,,玖芽？你没事吧
Dialogue: 0,0:13:35.91,0:13:37.63,Default,,0,0,0,,我醒过来就在树林里了
Dialogue: 0,0:13:38.13,0:13:41.96,Default,,0,0,0,,但是 是它把我带到你这里的
Dialogue: 0,0:13:43.17,0:13:45.25,Default,,0,0,0,,我做了什么坏事吗
Dialogue: 0,0:13:45.82,0:13:47.34,Default,,0,0,0,,我什么都不记得了
Dialogue: 0,0:13:49.13,0:13:50.28,Default,,0,0,0,,你胳膊上的那个东西
Dialogue: 0,0:13:50.72,0:13:52.22,Default,,0,0,0,,果然还是除掉为好
Dialogue: 0,0:13:52.85,0:13:54.67,Default,,0,0,0,,别这样 我害怕
Dialogue: 0,0:13:54.82,0:13:56.43,Default,,0,0,0,,别变成那副模样
Dialogue: 0,0:13:56.57,0:13:58.41,Default,,0,0,0,,这样下去会烂掉的
Dialogue: 0,0:13:58.59,0:13:59.46,Default,,0,0,0,,没关系
Dialogue: 0,0:13:59.71,0:14:02.06,Default,,0,0,0,,我已经把左臂给它了
Dialogue: 0,0:14:02.06,0:14:03.35,Default,,0,0,0,,别说蠢话
Dialogue: 0,0:14:07.33,0:14:11.35,Default,,0,0,0,,不行 我还有必须要做的事
Dialogue: 0,0:14:14.98,0:14:16.49,Default,,0,0,0,,看来到此为止了
Dialogue: 0,0:14:16.92,0:14:18.87,Default,,0,0,0,,身体快支撑不住了
Dialogue: 0,0:14:19.75,0:14:22.97,Default,,0,0,0,,这是我最后一次跟你见面
Dialogue: 0,0:14:27.57,0:14:29.66,Default,,0,0,0,,我送你回大人们那
Dialogue: 0,0:14:31.72,0:14:32.43,Default,,0,0,0,,跟我来
Dialogue: 0,0:14:34.27,0:14:35.10,Default,,0,0,0,,不死
Dialogue: 0,0:14:39.18,0:14:40.85,Default,,0,0,0,,给你块布 缠上吧
Dialogue: 0,0:14:41.42,0:14:42.71,Default,,0,0,0,,谢谢你
Dialogue: 0,0:14:43.10,0:14:44.36,Default,,0,0,0,,气味很近了
Dialogue: 0,0:14:44.91,0:14:46.02,Default,,0,0,0,,估计明天就能到
Dialogue: 0,0:14:47.22,0:14:49.49,Default,,0,0,0,,不行 老实点
Dialogue: 0,0:14:49.49,0:14:51.51,Default,,0,0,0,,你回去之后要怎么办
Dialogue: 0,0:14:51.95,0:14:53.83,Default,,0,0,0,,要维持守护团的运转
Dialogue: 0,0:14:54.08,0:14:54.67,Default,,0,0,0,,维持？
Dialogue: 0,0:14:55.22,0:14:56.74,Default,,0,0,0,,总有一天我会生下孩子
Dialogue: 0,0:14:56.99,0:14:58.01,Default,,0,0,0,,把我的血脉
Dialogue: 0,0:14:58.58,0:15:01.49,Default,,0,0,0,,不 把早瀨的血脉延续下去
Dialogue: 0,0:15:02.24,0:15:03.49,Default,,0,0,0,,不太懂
Dialogue: 0,0:15:07.96,0:15:10.21,Default,,0,0,0,,今天是最后一天能见到你
Dialogue: 0,0:15:10.47,0:15:12.32,Default,,0,0,0,,所以就告诉你吧
Dialogue: 0,0:15:14.07,0:15:16.39,Default,,0,0,0,,早瀨有一个愿望
Dialogue: 0,0:15:17.57,0:15:19.88,Default,,0,0,0,,这跟守护团无关
Dialogue: 0,0:15:20.08,0:15:21.39,Default,,0,0,0,,是一个秘密的目的
Dialogue: 0,0:15:21.92,0:15:24.93,Default,,0,0,0,,是只有我们血亲之间才知道的
Dialogue: 0,0:15:25.62,0:15:29.36,Default,,0,0,0,,不死 我想和你生孩子
Dialogue: 0,0:15:30.63,0:15:31.67,Default,,0,0,0,,这就是目的？
Dialogue: 0,0:15:31.87,0:15:32.43,Default,,0,0,0,,是的
Dialogue: 0,0:15:32.73,0:15:35.50,Default,,0,0,0,,如果目的达成了你们就会放过我吗
Dialogue: 0,0:15:35.93,0:15:37.47,Default,,0,0,0,,我不知道 大概是吧
Dialogue: 0,0:15:37.88,0:15:40.74,Default,,0,0,0,,但母亲和过世的外祖母一定会满足的
Dialogue: 0,0:15:41.01,0:15:44.32,Default,,0,0,0,,但我不知道要怎样才能有孩子
Dialogue: 0,0:15:44.48,0:15:47.41,Default,,0,0,0,,听母亲说 只要一起睡觉就行了
Dialogue: 0,0:15:47.49,0:15:48.43,Default,,0,0,0,,仅此而已？
Dialogue: 0,0:15:48.89,0:15:50.86,Default,,0,0,0,,我已经跟很多人一起睡过了
Dialogue: 0,0:15:50.86,0:15:52.46,Default,,0,0,0,,但从来没有过孩子啊
Dialogue: 0,0:15:52.79,0:15:56.18,Default,,0,0,0,,听说只有到了一定年纪的女孩子才会怀孕
Dialogue: 0,0:15:56.46,0:15:58.96,Default,,0,0,0,,而且还得你想要
Dialogue: 0,0:15:59.46,0:16:00.42,Default,,0,0,0,,你会答应吧
Dialogue: 0,0:16:00.74,0:16:03.81,Default,,0,0,0,,虽然母亲说我还太小
Dialogue: 0,0:16:04.23,0:16:06.36,Default,,0,0,0,,但我会努力的
Dialogue: 0,0:16:07.07,0:16:10.61,Default,,0,0,0,,如果这样你们就会对我失去兴趣的话
Dialogue: 0,0:16:13.78,0:16:15.20,Default,,0,0,0,,谢谢你
Dialogue: 0,0:16:15.76,0:16:18.08,Default,,0,0,0,,这样我就能不留遗憾地回去了
Dialogue: 0,0:16:18.44,0:16:20.57,Default,,0,0,0,,告诉你胳膊里的那东西
Dialogue: 0,0:16:20.94,0:16:23.45,Default,,0,0,0,,等它会说话了再来找我
Dialogue: 0,0:16:23.70,0:16:25.65,Default,,0,0,0,,它肯定听着呢
Dialogue: 0,0:16:27.19,0:16:29.44,Default,,0,0,0,,快睡吧 不死
Dialogue: 0,0:16:33.93,0:16:34.85,Default,,0,0,0,,她肯定…
Dialogue: 0,0:16:35.42,0:16:38.57,Default,,0,0,0,,也需要能理解她 帮助她的人吧
Dialogue: 0,0:16:50.35,0:16:51.73,Default,,0,0,0,,玖芽大人
Dialogue: 0,0:16:52.14,0:16:54.38,Default,,0,0,0,,你在哪 玖芽大人
Dialogue: 0,0:16:59.43,0:17:00.66,Default,,0,0,0,,她在路边昏倒了
Dialogue: 0,0:17:01.15,0:17:02.88,Default,,0,0,0,,还活着 但胳膊已经开始腐烂了
Dialogue: 0,0:17:03.41,0:17:05.59,Default,,0,0,0,,得赶快切掉给她治疗
Dialogue: 0,0:17:04.99,0:17:05.93,up,,0,0,0,,玖芽大人
Dialogue: 0,0:17:07.32,0:17:09.16,Default,,0,0,0,,失去意识了 赶快
Dialogue: 0,0:17:08.28,0:17:09.63,up,,0,0,0,,喂 你们听见了吗
Dialogue: 0,0:17:09.25,0:17:10.80,Default,,0,0,0,,现在让她死了就麻烦了
Dialogue: 0,0:17:10.03,0:17:11.66,up,,0,0,0,,一定要治好她的胳臂
Dialogue: 0,0:17:11.92,0:17:14.10,Default,,0,0,0,,还有告诉她父母
Dialogue: 0,0:17:14.46,0:17:16.29,Default,,0,0,0,,多重视下自己的孩子
Dialogue: 0,0:17:17.68,0:17:18.38,Default,,0,0,0,,等等
Dialogue: 0,0:17:19.31,0:17:22.10,Default,,0,0,0,,她这样的小孩我随时都能杀掉
Dialogue: 0,0:17:22.92,0:17:23.64,Default,,0,0,0,,快走
Dialogue: 0,0:17:26.37,0:17:29.19,Default,,0,0,0,,搞不好下一个来的就是你和玖芽的孩子
Dialogue: 0,0:17:29.36,0:17:30.99,Default,,0,0,0,,不会的 我没睡着
Dialogue: 0,0:17:31.71,0:17:33.94,Default,,0,0,0,,你的生殖器官是有功能的
Dialogue: 0,0:17:34.03,0:17:36.23,Default,,0,0,0,,有这个想法去镇上就好了
Dialogue: 0,0:17:37.02,0:17:38.10,Default,,0,0,0,,你在说啥
Dialogue: 0,0:17:38.86,0:17:41.09,Default,,0,0,0,,抱歉 你好像还不懂
Dialogue: 0,0:17:41.38,0:17:44.52,Default,,0,0,0,,我只是提议你可以去镇上看看
Dialogue: 0,0:17:45.83,0:17:46.78,Default,,0,0,0,,也是
Dialogue: 0,0:17:47.41,0:17:49.20,Default,,0,0,0,,既然去哪敲门者都会来
Dialogue: 0,0:17:50.07,0:17:52.33,Default,,0,0,0,,那去寻找能理解我的人也是个办法
Dialogue: 0,0:17:53.28,0:17:55.21,Default,,0,0,0,,走吧 去镇上
Dialogue: 0,0:17:58.28,0:17:59.67,Default,,0,0,0,,{\pos(1300,1050)}等等我
Dialogue: 0,0:17:58.27,0:17:59.10,Default,,0,0,0,,{\pos(600,1050)}来比赛吧
Dialogue: 0,0:18:05.11,0:18:06.73,Default,,0,0,0,,这是别的国家的
Dialogue: 0,0:18:07.00,0:18:09.00,Default,,0,0,0,,不行 这里用不了
Dialogue: 0,0:18:09.47,0:18:10.84,Default,,0,0,0,,那把这个卖给你
Dialogue: 0,0:18:11.27,0:18:13.43,Default,,0,0,0,,我可以出一个银币
Dialogue: 0,0:18:13.72,0:18:14.48,Default,,0,0,0,,好的
Dialogue: 0,0:18:15.10,0:18:16.08,Default,,0,0,0,,我要买那个
Dialogue: 0,0:18:16.32,0:18:17.34,Default,,0,0,0,,三个银币
Dialogue: 0,0:18:17.52,0:18:19.51,Default,,0,0,0,,还需要两把剑
Dialogue: 0,0:18:19.78,0:18:20.33,Default,,0,0,0,,给
Dialogue: 0,0:18:21.84,0:18:23.20,Default,,0,0,0,,新的食物
Dialogue: 0,0:18:23.62,0:18:24.20,Default,,0,0,0,,真美味
Dialogue: 0,0:18:26.01,0:18:27.60,Default,,0,0,0,,久违的羽绒被
Dialogue: 0,0:18:27.95,0:18:28.59,Default,,0,0,0,,真舒服
Dialogue: 0,0:18:29.27,0:18:30.72,Default,,0,0,0,,城镇 真好
Dialogue: 0,0:18:31.62,0:18:32.36,Default,,0,0,0,,太棒了
Dialogue: 0,0:18:32.90,0:18:35.04,Default,,0,0,0,,我开始想着要寻找同伴了
Dialogue: 0,0:18:35.50,0:18:35.97,Default,,0,0,0,,但是
Dialogue: 0,0:18:36.37,0:18:40.56,Default,,0,0,0,,这并不意味着我把别人卷入危险的不安感消失了
Dialogue: 0,0:18:44.20,0:18:46.41,Default,,0,0,0,,要想顺利待在城里是有窍门的
Dialogue: 0,0:18:47.05,0:18:48.47,Default,,0,0,0,,根据以往的经验
Dialogue: 0,0:18:48.79,0:18:51.08,Default,,0,0,0,,只要我在同一个地方超过7天
Dialogue: 0,0:18:51.33,0:18:53.32,Default,,0,0,0,,敲门者就会找上门来
Dialogue: 0,0:18:53.99,0:18:56.19,Default,,0,0,0,,第一天 第二天是安全的
Dialogue: 0,0:18:56.68,0:18:58.01,Default,,0,0,0,,但第三天就危险了
Dialogue: 0,0:18:58.50,0:19:00.05,Default,,0,0,0,,就算我看不见
Dialogue: 0,0:19:00.50,0:19:03.48,Default,,0,0,0,,它们也会把种子栽入石头和植物里
Dialogue: 0,0:19:04.87,0:19:06.21,Default,,0,0,0,,所以就算我来到镇上
Dialogue: 0,0:19:06.85,0:19:08.90,Default,,0,0,0,,也会在第三天开始前离开
Dialogue: 0,0:19:09.51,0:19:11.35,Default,,0,0,0,,第四天就到别的地方去了
Dialogue: 0,0:19:11.96,0:19:13.05,Default,,0,0,0,,绝不会久留
Dialogue: 0,0:19:13.90,0:19:18.16,Default,,0,0,0,,我大概每半年会遇上一次敲门者
Dialogue: 0,0:19:18.80,0:19:19.19,Default,,0,0,0,,但是
Dialogue: 0,0:19:19.80,0:19:21.58,Default,,0,0,0,,新出现了9名遇难者
Dialogue: 0,0:19:22.10,0:19:24.68,Default,,0,0,0,,在我力所不及的地方还是会出现伤亡
Dialogue: 0,0:19:25.29,0:19:27.12,Default,,0,0,0,,这也是唯一让我心有不甘的事
Dialogue: 0,0:19:27.96,0:19:31.42,Default,,0,0,0,,要是能和其他人联手 就能救更多人
Dialogue: 0,0:19:31.88,0:19:33.76,Default,,0,0,0,,好想赶快找到同伴
Dialogue: 0,0:19:35.55,0:19:37.74,Default,,0,0,0,,我不断在城镇间穿梭
Dialogue: 0,0:19:38.46,0:19:42.60,Default,,0,0,0,,收集新的食物 书籍 工具
Dialogue: 0,0:19:43.76,0:19:45.45,Default,,0,0,0,,还有动物和昆虫
Dialogue: 0,0:19:45.88,0:19:48.44,Default,,0,0,0,,我必须记住它们 以后才能变出来
Dialogue: 0,0:19:49.51,0:19:51.60,Default,,0,0,0,,我旅行了4个月后
Dialogue: 0,0:19:51.96,0:19:53.41,Default,,0,0,0,,得知了里贾德的死讯
Dialogue: 0,0:19:56.42,0:19:59.51,Default,,0,0,0,,现在它回到托娜莉身边了吗
Dialogue: 0,0:20:00.43,0:20:03.34,Default,,0,0,0,,好羡慕能回到同伴身边的里贾德
Dialogue: 0,0:20:05.48,0:20:07.43,Default,,0,0,0,,寻找同伴的事迟迟没有进展
Dialogue: 0,0:20:08.34,0:20:10.68,Default,,0,0,0,,就算找到了能理解我的人
Dialogue: 0,0:20:11.10,0:20:13.12,Default,,0,0,0,,但一想到要见证他们的死
Dialogue: 0,0:20:13.47,0:20:15.02,Default,,0,0,0,,我就会变得犹豫不决
Dialogue: 0,0:20:15.94,0:20:18.11,Default,,0,0,0,,他们死后留下的东西
Dialogue: 0,0:20:18.52,0:20:20.31,Default,,0,0,0,,对我来说才是真正的同伴
Dialogue: 0,0:20:21.27,0:20:22.95,Default,,0,0,0,,无法互通心意
Dialogue: 0,0:20:23.24,0:20:24.80,Default,,0,0,0,,就算在脑海中对话
Dialogue: 0,0:20:25.04,0:20:27.20,Default,,0,0,0,,也只会回复那些我已经知道的词语
Dialogue: 0,0:20:27.98,0:20:30.38,Default,,0,0,0,,只有他们才是我真正的同伴
Dialogue: 0,0:20:30.88,0:20:31.91,Default,,0,0,0,,你好 不死
Dialogue: 0,0:20:32.30,0:20:34.18,Default,,0,0,0,,我是守护团副团长 绪海
Dialogue: 0,0:20:35.58,0:20:37.42,Default,,0,0,0,,你们还在搞啊 守护团
Dialogue: 0,0:20:37.87,0:20:38.30,Default,,0,0,0,,是的
Dialogue: 0,0:20:38.81,0:20:42.51,Default,,0,0,0,,现在我们正在赫纳大陆全境招募同志
Dialogue: 0,0:20:43.00,0:20:47.67,Default,,0,0,0,,赞同的城镇会受到我们的庇护 升起那面旗帜
Dialogue: 0,0:20:48.32,0:20:51.67,Default,,0,0,0,,那是已经准备好应对敲门者来袭的标志
Dialogue: 0,0:20:52.10,0:20:52.98,Default,,0,0,0,,这里的市民
Dialogue: 0,0:20:53.14,0:20:55.87,Default,,0,0,0,,在敲门者出现的时候 也会并肩战斗吧
Dialogue: 0,0:20:56.61,0:20:59.58,Default,,0,0,0,,这对你胳膊上那个东西是一种背叛吧
Dialogue: 0,0:20:59.99,0:21:01.10,Default,,0,0,0,,它不会反抗吗
Dialogue: 0,0:21:01.57,0:21:04.54,Default,,0,0,0,,有时会稍微闹点别扭
Dialogue: 0,0:21:05.21,0:21:07.21,Default,,0,0,0,,但它和其他的敲门者不一样
Dialogue: 0,0:21:07.55,0:21:09.11,Default,,0,0,0,,它很配合
Dialogue: 0,0:21:09.44,0:21:11.15,Default,,0,0,0,,你是玖芽的女儿吗
Dialogue: 0,0:21:11.32,0:21:11.73,Default,,0,0,0,,是的
Dialogue: 0,0:21:12.16,0:21:13.59,Default,,0,0,0,,母亲受您照顾了
Dialogue: 0,0:21:15.01,0:21:16.40,Default,,0,0,0,,别担心
Dialogue: 0,0:21:16.64,0:21:19.07,Default,,0,0,0,,我是母亲17岁时生下的
Dialogue: 0,0:21:19.42,0:21:23.22,Default,,0,0,0,,您是替儿时的母亲分担苦恼的温柔的人
Dialogue: 0,0:21:23.62,0:21:24.80,Default,,0,0,0,,这是我所听到的
Dialogue: 0,0:21:26.69,0:21:28.83,Default,,0,0,0,,她在半年前去世了
Dialogue: 0,0:21:29.29,0:21:34.25,Default,,0,0,0,,接下来我腹中的孩子就会继承早瀨的意志吧
Dialogue: 0,0:21:34.94,0:21:37.52,Default,,0,0,0,,到那时还请您多多照顾
Dialogue: 0,0:21:38.84,0:21:39.72,Default,,0,0,0,,知道了
Dialogue: 0,0:21:40.41,0:21:43.85,Default,,0,0,0,,早瀨的后代之后还会时不时来见我
Dialogue: 0,0:21:44.27,0:21:46.29,Default,,0,0,0,,我是第二代继承人汐
Dialogue: 0,0:21:46.48,0:21:47.70,Default,,0,0,0,,很高心见到你
Dialogue: 0,0:21:49.10,0:21:49.90,Default,,0,0,0,,放手
Dialogue: 0,0:21:50.32,0:21:51.11,Default,,0,0,0,,你好
Dialogue: 0,0:21:51.67,0:21:53.78,Default,,0,0,0,,我是第三代继承人千翠
Dialogue: 0,0:21:55.85,0:22:00.05,Default,,0,0,0,,她们一个个都是和我自来熟的怪人
Dialogue: 0,0:22:01.79,0:22:03.42,Default,,0,0,0,,但只要我变成托娜莉的样子
Dialogue: 0,0:22:03.65,0:22:05.57,Default,,0,0,0,,她们就会立刻露出失望的表情
Dialogue: 0,0:22:05.70,0:22:06.56,Default,,0,0,0,,跟我拉开距离
Dialogue: 0,0:22:07.06,0:22:08.72,Default,,0,0,0,,那样子太好玩了
Dialogue: 0,0:22:08.94,0:22:11.54,Default,,0,0,0,,我渐渐有点盼着她们来了
Dialogue: 0,0:22:11.93,0:22:15.05,Default,,0,0,0,,但另一方面 却有一个让我不甘的事实
Dialogue: 0,0:22:15.32,0:22:18.33,Default,,0,0,0,,北边的山里出现了10只敲门者
Dialogue: 0,0:22:18.33,0:22:20.73,Default,,0,0,0,,但守护团都给处理掉了
Dialogue: 0,0:22:20.95,0:22:21.81,Default,,0,0,0,,是吗
Dialogue: 0,0:22:22.56,0:22:27.20,Default,,0,0,0,,击退敲门者的不是我 而是她们
Dialogue: 0,0:22:36.43,0:22:38.06,Default,,0,0,0,,你在看什么书
Dialogue: 0,0:22:40.64,0:22:43.38,Default,,0,0,0,,基本都是烹饪和裁缝书
Dialogue: 0,0:22:43.74,0:22:48.67,Default,,0,0,0,,巨型船的构造 建筑指南书 水的制作方法
Dialogue: 0,0:22:49.26,0:22:50.67,Default,,0,0,0,,这本是魔法书
Dialogue: 0,0:22:51.43,0:22:53.26,Default,,0,0,0,,是因为做不出来才看吗
Dialogue: 0,0:22:53.58,0:22:54.50,Default,,0,0,0,,谁知道了
Dialogue: 0,0:22:54.76,0:22:55.44,Default,,0,0,0,,你是谁
Dialogue: 0,0:22:56.26,0:22:58.63,Default,,0,0,0,,我是第六代继承人 迦白
Dialogue: 0,0:22:59.85,0:23:00.47,Default,,0,0,0,,男的？
Dialogue: 0,0:24:32.92,0:24:36.32,Default,,0,0,0,,继承了早瀨意志的迦白
Dialogue: 0,0:24:37.12,0:24:40.53,Default,,0,0,0,,不死开始和他一起行动
Dialogue: 0,0:24:41.09,0:24:43.81,Default,,0,0,0,,人们对他们或崇拜 或迫害
Dialogue: 0,0:24:44.23,0:24:46.85,Default,,0,0,0,,敲门者的危害不断蔓延
Dialogue: 0,0:24:47.64,0:24:49.98,Default,,0,0,0,,在愁眉苦脸的不死面前
Dialogue: 0,0:24:50.44,0:24:52.76,Default,,0,0,0,,一个奇怪的王子出现了
