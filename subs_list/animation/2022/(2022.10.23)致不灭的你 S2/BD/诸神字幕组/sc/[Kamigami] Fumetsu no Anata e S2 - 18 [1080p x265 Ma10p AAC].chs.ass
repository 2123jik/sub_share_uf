Dialogue: 0,0:02:02.97,0:02:06.98,TITLE2,,30,0,0,,{\c&H121F38&}不死之身的死
Dialogue: 1,0:24:53.01,0:24:56.01,TITLE2,,30,0,0,,{\c&H121618&\clip(700,700,1180,760)}又见日出
Dialogue: 0,0:24:53.01,0:24:56.01,TITLE2,,30,0,0,,{\c&H121F38&}又见日出
Comment: 0,0:00:00.00,0:00:00.00,TEXT-JP,,0,0,0,,-----TEXT-JP-----
Dialogue: 0,0:00:02.52,0:00:08.88,TEXT-JP,,0,0,0,,戦いが始まって４日　王都レンリルは混迷を極めていた
Dialogue: 0,0:00:08.88,0:00:10.74,TEXT-JP,,0,0,0,,人殺しだァ
Dialogue: 0,0:00:11.59,0:00:17.74,TEXT-JP,,0,0,0,,いつ果てるとも知れぬ敵の攻撃にフシは追い詰められる
Dialogue: 0,0:00:17.74,0:00:20.87,TEXT-JP,,0,0,0,,さらに不死身の三戦士も
Dialogue: 0,0:00:23.45,0:00:26.25,TEXT-JP,,0,0,0,,楽に…なりたい
Dialogue: 0,0:00:26.25,0:00:27.88,TEXT-JP,,0,0,0,,大丈夫
Dialogue: 0,0:00:28.56,0:00:30.91,TEXT-JP,,0,0,0,,私が守ってあげます
Dialogue: 0,0:02:10.78,0:02:15.01,TEXT-JP,,0,0,0,,やめて　やめて　ふーちゃんをころさないで
Dialogue: 0,0:02:15.01,0:02:15.74,TEXT-JP,,0,0,0,,あなたは…
Dialogue: 0,0:02:16.49,0:02:19.41,TEXT-JP,,0,0,0,,まさか　マーチ
Dialogue: 0,0:02:59.76,0:03:01.28,TEXT-JP,,0,0,0,,やめなさい　左手
Dialogue: 0,0:03:01.52,0:03:03.48,TEXT-JP,,0,0,0,,今すぐやめないと
Dialogue: 0,0:03:09.33,0:03:10.46,TEXT-JP,,0,0,0,,いたい
Dialogue: 0,0:03:42.20,0:03:45.68,TEXT-JP,,0,0,0,,ごめんなさい　私のせいで
Dialogue: 0,0:03:46.51,0:03:51.12,TEXT-JP,,0,0,0,,全部…奪われてしまいました
Dialogue: 0,0:03:55.71,0:04:03.12,TEXT-JP,,0,0,0,,やっと　やっと会えたとお…思ったのに
Dialogue: 0,0:04:05.25,0:04:12.32,TEXT-JP,,0,0,0,,なんねんも　なんねんも　かかったのに
Dialogue: 0,0:04:14.10,0:04:17.98,TEXT-JP,,0,0,0,,すぐかってにどこかにいくんだから
Dialogue: 0,0:04:18.94,0:04:21.30,TEXT-JP,,0,0,0,,マーチをおいて
Dialogue: 0,0:04:35.50,0:04:36.62,TEXT-JP,,0,0,0,,きず
Dialogue: 0,0:04:38.56,0:04:42.02,TEXT-JP,,0,0,0,,だ…だいじょうぶだったのね
Dialogue: 0,0:04:45.19,0:04:49.89,TEXT-JP,,0,0,0,,そうね　だめよね　おちこんでちゃ
Dialogue: 0,0:04:50.70,0:04:53.46,TEXT-JP,,0,0,0,,そう　そうよ
Dialogue: 0,0:04:54.36,0:04:57.65,TEXT-JP,,0,0,0,,やれる　やるの
Dialogue: 0,0:04:58.26,0:04:59.65,TEXT-JP,,0,0,0,,マーチが
Dialogue: 0,0:05:04.16,0:05:05.88,TEXT-JP,,0,0,0,,ど…こへ
Dialogue: 0,0:05:07.71,0:05:10.29,TEXT-JP,,0,0,0,,ふーちゃんを助けににきまってるわ
Dialogue: 0,0:05:10.29,0:05:12.55,TEXT-JP,,0,0,0,,どう…やって
Dialogue: 0,0:05:12.55,0:05:15.69,TEXT-JP,,0,0,0,,そこでまっててね　おいしゃさん　よぶから
Dialogue: 0,0:05:16.08,0:05:17.91,TEXT-JP,,0,0,0,,いきましょ　おうまさん
Dialogue: 0,0:05:22.40,0:05:26.34,TEXT-JP,,0,0,0,,変だ　街が止まったままだ
Dialogue: 0,0:05:29.50,0:05:34.81,TEXT-JP,,0,0,0,,壊れた家の修理も　弾の補充もされていない
Dialogue: 0,0:05:34.81,0:05:36.61,TEXT-JP,,0,0,0,,まるで無抵抗
Dialogue: 0,0:05:36.61,0:05:38.52,TEXT-JP,,0,0,0,,また気絶か　フシ
Dialogue: 0,0:05:38.52,0:05:42.32,TEXT-JP,,0,0,0,,いいや　あいつが同じヘマをするとは思えない
Dialogue: 0,0:05:42.81,0:05:44.74,TEXT-JP,,0,0,0,,まさか死んだのか
Dialogue: 0,0:05:45.80,0:05:46.88,TEXT-JP,,0,0,0,,フシ
Dialogue: 0,0:05:51.30,0:05:55.52,TEXT-JP,,0,0,0,,あなたはしんでなんかいないわ　ふーちゃん
Dialogue: 0,0:06:05.12,0:06:06.01,TEXT-JP,,0,0,0,,どうした
Dialogue: 0,0:06:06.01,0:06:07.31,TEXT-JP,,0,0,0,,どうなってる
Dialogue: 0,0:06:07.31,0:06:09.69,TEXT-JP,,0,0,0,,見張りがやられて　ノッカーが…
Dialogue: 0,0:06:15.76,0:06:19.52,TEXT-JP,,0,0,0,,手の空いてる者　バリケードを作るのを手伝ってくれ
Dialogue: 0,0:06:26.17,0:06:28.02,TEXT-JP,,0,0,0,,元気になってね
Dialogue: 0,0:06:28.83,0:06:31.70,TEXT-JP,,0,0,0,,ユイスのお母さん　俺　行きますね
Dialogue: 0,0:06:32.09,0:06:33.16,TEXT-JP,,0,0,0,,カムさん
Dialogue: 0,0:06:33.16,0:06:35.57,TEXT-JP,,0,0,0,,ミゲルという市民兵がいたら
Dialogue: 0,0:06:35.57,0:06:38.82,TEXT-JP,,0,0,0,,ユイスとここで待ってると伝えてくれないかしら
Dialogue: 0,0:06:38.82,0:06:39.75,TEXT-JP,,0,0,0,,ミゲル
Dialogue: 0,0:06:40.48,0:06:42.71,TEXT-JP,,0,0,0,,恋人なの
Dialogue: 0,0:06:51.86,0:06:54.75,TEXT-JP,,0,0,0,,まままッ任せてください　お母さん
Dialogue: 0,0:06:54.75,0:06:56.75,TEXT-JP,,0,0,0,,必ず連れてまいります
Dialogue: 0,0:07:02.26,0:07:05.38,TEXT-JP,,0,0,0,,フシさんが復活するまで耐えるんだ
Dialogue: 0,0:07:06.97,0:07:09.82,TEXT-JP,,0,0,0,,今の馬　女の子が乗ってなかったか
Dialogue: 0,0:07:11.00,0:07:13.25,TEXT-JP,,0,0,0,,あれみて　おうまさん
Dialogue: 0,0:07:18.82,0:07:20.00,TEXT-JP,,0,0,0,,誰か来た
Dialogue: 0,0:07:20.00,0:07:21.21,TEXT-JP,,0,0,0,,助けか
Dialogue: 0,0:07:36.49,0:07:38.25,TEXT-JP,,0,0,0,,あなたは
Dialogue: 0,0:07:38.25,0:07:42.31,TEXT-JP,,0,0,0,,わたしはマーチよ　おねえさん　おいしゃさんどこかしら
Dialogue: 0,0:07:42.31,0:07:44.02,TEXT-JP,,0,0,0,,ここよ　病院なの
Dialogue: 0,0:07:44.02,0:07:45.22,TEXT-JP,,0,0,0,,どうしたの
Dialogue: 0,0:07:45.22,0:07:48.97,TEXT-JP,,0,0,0,,ケガしてるひとがおうちにいるの　ふーちゃんのおうちにきて
Dialogue: 0,0:07:48.97,0:07:50.24,TEXT-JP,,0,0,0,,ふーちゃん
Dialogue: 0,0:07:50.95,0:07:52.30,TEXT-JP,,0,0,0,,ふしちゃんよ
Dialogue: 0,0:07:52.30,0:07:56.95,TEXT-JP,,0,0,0,,わかったわ　人を連れてくから　あなたは裏へ回って避難を
Dialogue: 0,0:07:56.95,0:07:58.50,TEXT-JP,,0,0,0,,しまった　矢が
Dialogue: 0,0:08:03.23,0:08:04.70,TEXT-JP,,0,0,0,,セラ　使え
Dialogue: 0,0:08:04.70,0:08:06.27,TEXT-JP,,0,0,0,,ありがとう　ミゲル
Dialogue: 0,0:08:13.25,0:08:14.97,TEXT-JP,,0,0,0,,背中が空いてるぜッ
Dialogue: 0,0:08:14.97,0:08:16.12,TEXT-JP,,0,0,0,,すまない
Dialogue: 0,0:08:17.79,0:08:20.75,TEXT-JP,,0,0,0,,中で手当てしろ　裏から入れる
Dialogue: 0,0:08:20.75,0:08:23.69,TEXT-JP,,0,0,0,,いや　ここを片づけるのが先だ
Dialogue: 0,0:08:24.33,0:08:28.80,TEXT-JP,,0,0,0,,こっちから城に向かって　フシさんの仲間もそこにいるはずよ
Dialogue: 0,0:08:28.80,0:08:30.86,TEXT-JP,,0,0,0,,ありがとう　おねえさん
Dialogue: 0,0:08:41.05,0:08:43.25,TEXT-JP,,0,0,0,,フシからの反応がない
Dialogue: 0,0:08:45.44,0:08:47.57,TEXT-JP,,0,0,0,,メサール　どこだ
Dialogue: 0,0:08:51.15,0:08:53.45,TEXT-JP,,0,0,0,,カイ　ハイロ
Dialogue: 0,0:08:53.45,0:08:54.39,TEXT-JP,,0,0,0,,坊ちゃま
Dialogue: 0,0:08:54.84,0:08:58.35,TEXT-JP,,0,0,0,,どこにも見当たりません　レンリルは広すぎます
Dialogue: 0,0:08:58.35,0:09:02.02,TEXT-JP,,0,0,0,,空から捜せば　せめてフシは見つかるだろう
Dialogue: 0,0:09:02.02,0:09:05.54,TEXT-JP,,0,0,0,,ですから　私どもは高い所が苦手でして
Dialogue: 0,0:09:05.54,0:09:08.09,TEXT-JP,,0,0,0,,カイどのの死体は見つけました
Dialogue: 0,0:09:08.09,0:09:09.53,TEXT-JP,,0,0,0,,状況を見るに
Dialogue: 0,0:09:09.53,0:09:12.57,TEXT-JP,,0,0,0,,カハクどのにやられたと思われます
Dialogue: 0,0:09:13.23,0:09:14.66,TEXT-JP,,0,0,0,,カハク
Dialogue: 0,0:09:23.16,0:09:25.20,TEXT-JP,,0,0,0,,あそこか　フシ
Dialogue: 0,0:09:30.65,0:09:31.53,TEXT-JP,,0,0,0,,フシ
Dialogue: 0,0:09:31.53,0:09:33.36,TEXT-JP,,0,0,0,,君　１人でどうしたの
Dialogue: 0,0:09:33.36,0:09:35.59,TEXT-JP,,0,0,0,,近くにパパがいるのかな
Dialogue: 0,0:09:37.39,0:09:41.84,TEXT-JP,,0,0,0,,ながいあいだ　ふーちゃんがおせわになったわ　ボンのおじちゃん
Dialogue: 0,0:09:44.56,0:09:46.10,TEXT-JP,,0,0,0,,君は…
Dialogue: 0,0:09:52.02,0:09:55.74,TEXT-JP,,0,0,0,,２００年前の生贄の少女
Dialogue: 0,0:09:58.56,0:10:01.16,TEXT-JP,,0,0,0,,いっしょにふーちゃんのところにいきましょう
Dialogue: 0,0:10:01.16,0:10:03.66,TEXT-JP,,0,0,0,,居場所を知っているのかい
Dialogue: 0,0:10:10.27,0:10:13.05,TEXT-JP,,0,0,0,,フシ　家にいたのか
Dialogue: 0,0:10:17.00,0:10:20.00,TEXT-JP,,0,0,0,,あれ　おにいさんがいない
Dialogue: 0,0:10:21.45,0:10:25.24,TEXT-JP,,0,0,0,,もうおいしゃさんにつれていってもらったのかしら
Dialogue: 0,0:10:26.19,0:10:29.28,TEXT-JP,,0,0,0,,こっここで何があったんだい　マーチ
Dialogue: 0,0:10:29.73,0:10:36.66,TEXT-JP,,0,0,0,,ふしちゃんがこう　わあって　ぐちゃぐちゃってされたの
Dialogue: 0,0:10:38.04,0:10:40.62,TEXT-JP,,0,0,0,,ヤノメのおにいさんに
Dialogue: 0,0:10:41.53,0:10:42.89,TEXT-JP,,0,0,0,,カハクに
Dialogue: 0,0:10:44.59,0:10:48.45,TEXT-JP,,0,0,0,,僕のせいだ　フシを一人にしたから
Dialogue: 0,0:10:49.08,0:10:52.65,TEXT-JP,,0,0,0,,ふーちゃんはね　がんばってもどろうとしたの
Dialogue: 0,0:10:52.65,0:10:54.51,TEXT-JP,,0,0,0,,でも　だめだった
Dialogue: 0,0:10:54.51,0:10:57.16,TEXT-JP,,0,0,0,,おにいさんがうでをきろうとしたら
Dialogue: 0,0:10:57.16,0:11:01.64,TEXT-JP,,0,0,0,,うでからまるいやつが出てきて　どこかにいっちゃったの
Dialogue: 0,0:11:01.64,0:11:05.77,TEXT-JP,,0,0,0,,この場所でフシが消えたっていうのかい
Dialogue: 0,0:11:05.77,0:11:08.85,TEXT-JP,,0,0,0,,おじちゃん　やっぱりここにはいないの
Dialogue: 0,0:11:09.66,0:11:13.42,TEXT-JP,,0,0,0,,「おれはここにいるよー」って　ふーちゃん　いってないの
Dialogue: 0,0:11:13.42,0:11:16.94,TEXT-JP,,0,0,0,,おじちゃんがマーチたちをみつけてくれたときみたいに
Dialogue: 0,0:11:16.94,0:11:19.55,TEXT-JP,,0,0,0,,ふーちゃんをみつけられないの
Dialogue: 0,0:11:35.11,0:11:37.95,TEXT-JP,,0,0,0,,すまない　いない
Dialogue: 0,0:11:38.91,0:11:40.47,TEXT-JP,,0,0,0,,みていない
Dialogue: 0,0:11:41.87,0:11:43.02,TEXT-JP,,0,0,0,,みえない
Dialogue: 0,0:11:44.98,0:11:47.88,TEXT-JP,,0,0,0,,これで終わりなのか　フシ
Dialogue: 0,0:11:49.05,0:11:51.15,TEXT-JP,,0,0,0,,このまま　僕たちは…
Dialogue: 0,0:11:51.15,0:11:53.89,TEXT-JP,,0,0,0,,逃げろ　ここはもうだめだ
Dialogue: 0,0:11:55.50,0:11:58.86,TEXT-JP,,0,0,0,,見ろ　この街に逃げ場なんてない
Dialogue: 0,0:12:01.55,0:12:04.28,TEXT-JP,,0,0,0,,だめ　全然減らない
Dialogue: 0,0:12:05.42,0:12:07.53,TEXT-JP,,0,0,0,,がんばるんだ　セラ
Dialogue: 0,0:12:07.53,0:12:11.00,TEXT-JP,,0,0,0,,俺らが潰れたら　病院のみんなが死んでしまう
Dialogue: 0,0:12:12.41,0:12:14.48,TEXT-JP,,0,0,0,,このまま　僕たちは…
Dialogue: 0,0:12:15.80,0:12:17.05,TEXT-JP,,0,0,0,,滅ぶのか
Dialogue: 0,0:12:17.73,0:12:21.18,TEXT-JP,,0,0,0,,これが見たかったのか　ミスターブラック
Dialogue: 0,0:12:21.18,0:12:25.18,TEXT-JP,,0,0,0,,フシもレンリルも死んで　これで嬉しいのか
Dialogue: 0,0:12:29.37,0:12:32.06,TEXT-JP,,0,0,0,,何か悪いことでもあったか
Dialogue: 0,0:12:40.02,0:12:41.15,TEXT-JP,,0,0,0,,わるいわ
Dialogue: 0,0:12:42.36,0:12:43.81,TEXT-JP,,0,0,0,,わるいわよ
Dialogue: 0,0:12:45.03,0:12:50.29,TEXT-JP,,0,0,0,,生きることはうばわれちゃだめなのよ　なにがなんでもだめなの
Dialogue: 0,0:12:50.99,0:12:54.00,TEXT-JP,,0,0,0,,ならば　奪い返せばいい
Dialogue: 0,0:12:58.25,0:13:00.34,TEXT-JP,,0,0,0,,エコ　いたのか
Dialogue: 0,0:13:03.61,0:13:05.49,TEXT-JP,,0,0,0,,大丈夫か
Dialogue: 0,0:13:29.99,0:13:31.20,TEXT-JP,,0,0,0,,これは…
Dialogue: 0,0:13:31.98,0:13:35.29,TEXT-JP,,0,0,0,,ふーちゃん？ふーちゃんなのね
Dialogue: 0,0:13:42.08,0:13:44.61,TEXT-JP,,0,0,0,,ロープがまだ繋がっている
Dialogue: 0,0:13:44.61,0:13:47.63,TEXT-JP,,0,0,0,,つまり　まだ街とフシは繋がっている
Dialogue: 0,0:13:49.03,0:13:51.56,TEXT-JP,,0,0,0,,フシ　お前の…
Dialogue: 0,0:13:51.56,0:13:53.56,TEXT-JP,,0,0,0,,最後の足掻きか
Dialogue: 0,0:13:55.10,0:13:58.65,TEXT-JP,,0,0,0,,もう一度意識を宿すことができれば
Dialogue: 0,0:13:59.97,0:14:01.80,TEXT-JP,,0,0,0,,やりましょ　おじちゃん
Dialogue: 0,0:14:01.80,0:14:06.34,TEXT-JP,,0,0,0,,ふーちゃんをまたにんげんにもどすの　とられたものをとりかえすの
Dialogue: 0,0:14:07.00,0:14:08.99,TEXT-JP,,0,0,0,,しかし　ダメだ
Dialogue: 0,0:14:08.99,0:14:13.25,TEXT-JP,,0,0,0,,ノッカーの居場所は同じノッカーを腕に宿したカハクか
Dialogue: 0,0:14:13.25,0:14:16.76,TEXT-JP,,0,0,0,,あるいは異物としてとらえられるフシの二人だけ
Dialogue: 0,0:14:17.98,0:14:19.86,TEXT-JP,,0,0,0,,僕たちじゃ見つけられない
Dialogue: 0,0:14:19.86,0:14:21.67,TEXT-JP,,0,0,0,,みつけるまでさがすの
Dialogue: 0,0:14:21.67,0:14:23.88,TEXT-JP,,0,0,0,,マーチ　がんばるわ
Dialogue: 0,0:14:23.88,0:14:26.34,TEXT-JP,,0,0,0,,あいつらは僕らをみてるんだ
Dialogue: 0,0:14:26.85,0:14:30.55,TEXT-JP,,0,0,0,,都合よく目の前にあらわれるわけがない
Dialogue: 0,0:14:30.55,0:14:35.47,TEXT-JP,,0,0,0,,賢いノッカーなら　僕たちが絶対に手を出せない所まで行っている
Dialogue: 0,0:14:36.04,0:14:39.94,TEXT-JP,,0,0,0,,あとはゆっくり　レンリルが死ぬのを待つだけ
Dialogue: 0,0:14:41.44,0:14:45.71,TEXT-JP,,0,0,0,,かたや　ものすごい速さで無限増殖するモンスター
Dialogue: 0,0:14:46.37,0:14:50.51,TEXT-JP,,0,0,0,,かたや　死んだら死にっぱなしの人間
Dialogue: 0,0:14:48.97,0:14:50.09,TEXT-JP-U,,0,0,0,,セラ
Dialogue: 0,0:14:52.51,0:14:54.84,TEXT-JP,,0,0,0,,じゃあ　どうすればいいの
Dialogue: 0,0:14:55.52,0:14:59.50,TEXT-JP,,0,0,0,,ふーちゃん　ほんとうにもうどうにもならないの
Dialogue: 0,0:15:00.25,0:15:02.96,TEXT-JP,,0,0,0,,マーチたちはなにをすればいいの
Dialogue: 0,0:15:03.76,0:15:07.55,TEXT-JP,,0,0,0,,もうみんなをおもいだしてくれないの
Dialogue: 0,0:15:35.36,0:15:38.57,TEXT-JP,,0,0,0,,ミゲル　ここはおれに任せてセラと病院へ
Dialogue: 0,0:15:38.57,0:15:40.08,TEXT-JP,,0,0,0,,まだ戦える
Dialogue: 0,0:15:40.52,0:15:42.00,TEXT-JP,,0,0,0,,行け
Dialogue: 0,0:15:43.36,0:15:44.96,TEXT-JP,,0,0,0,,「思い出して」
Dialogue: 0,0:15:45.55,0:15:46.79,TEXT-JP,,0,0,0,,思い出す
Dialogue: 0,0:15:47.42,0:15:49.37,TEXT-JP,,0,0,0,,そう　そうだ
Dialogue: 0,0:15:49.84,0:15:52.51,TEXT-JP,,0,0,0,,フシは姿を奪われるだけじゃなく
Dialogue: 0,0:15:52.51,0:15:56.64,TEXT-JP,,0,0,0,,記憶の中にあるその人の姿形も奪われる
Dialogue: 0,0:15:57.66,0:15:59.87,TEXT-JP,,0,0,0,,かたちとおと
Dialogue: 0,0:16:01.07,0:16:07.13,TEXT-JP,,0,0,0,,かたちとおととにおいをとられちゃうって　くろいおじさんがいっていたわね
Dialogue: 0,0:16:07.13,0:16:09.53,TEXT-JP,,0,0,0,,そうなのか　ミスターブラック
Dialogue: 0,0:16:14.33,0:16:18.16,TEXT-JP,,0,0,0,,形　音　匂い
Dialogue: 0,0:16:18.16,0:16:23.50,TEXT-JP,,0,0,0,,それを伝えられたら　フシはみんなの記憶を取り戻せるのだろうか
Dialogue: 0,0:16:23.50,0:16:27.89,TEXT-JP,,0,0,0,,いや　どうやって　目も耳もないこのフシに
Dialogue: 0,0:16:28.64,0:16:30.97,TEXT-JP,,0,0,0,,どんな変化を起こせるというんだ
Dialogue: 0,0:16:32.18,0:16:35.14,TEXT-JP,,0,0,0,,彼に何を与えることができる
Dialogue: 0,0:16:41.55,0:16:42.88,TEXT-JP,,0,0,0,,おじちゃん
Dialogue: 0,0:16:44.11,0:16:45.41,TEXT-JP,,0,0,0,,カム
Dialogue: 0,0:16:45.81,0:16:47.91,TEXT-JP,,0,0,0,,だめだ　早く
Dialogue: 0,0:16:47.91,0:16:50.62,TEXT-JP,,0,0,0,,イヤ　離して　助けないと
Dialogue: 0,0:16:50.62,0:16:52.40,TEXT-JP,,0,0,0,,早く行くんだ
Dialogue: 0,0:16:58.83,0:17:02.35,TEXT-JP,,0,0,0,,マーチ　外に出て待っててくれないかい
Dialogue: 0,0:17:03.28,0:17:07.58,TEXT-JP,,0,0,0,,それから数を数えて　１００になっても僕が出てこなかったら
Dialogue: 0,0:17:07.58,0:17:12.01,TEXT-JP,,0,0,0,,お馬さんに乗って　キリヤト地区にあるウラリスの兵舎に行くんだ
Dialogue: 0,0:17:12.01,0:17:15.19,TEXT-JP,,0,0,0,,これを見せれば　みんな助けてくれるだろう
Dialogue: 0,0:17:20.22,0:17:21.41,TEXT-JP,,0,0,0,,おじちゃん
Dialogue: 0,0:17:26.06,0:17:28.11,TEXT-JP,,0,0,0,,そういえば　エコはどこに
Dialogue: 0,0:17:30.36,0:17:31.82,TEXT-JP,,0,0,0,,急がないと
Dialogue: 0,0:17:32.52,0:17:39.29,TEXT-JP,,0,0,0,,マーチ　君が僕を呼んでくれた意味を今　しっかりつかみ取ることにしたよ
Dialogue: 0,0:17:43.39,0:17:44.43,TEXT-JP,,0,0,0,,フシ
Dialogue: 0,0:17:49.92,0:17:52.72,TEXT-JP,,0,0,0,,カム　だめ　起きて
Dialogue: 0,0:18:00.05,0:18:01.50,TEXT-JP,,0,0,0,,そんな
Dialogue: 0,0:18:10.89,0:18:14.42,TEXT-JP,,0,0,0,,全部思い出せ　フシッ
Dialogue: 0,0:18:36.69,0:18:38.09,TEXT-JP,,0,0,0,,陛下
Dialogue: 0,0:18:39.19,0:18:41.06,TEXT-JP,,0,0,0,,ボン様
Dialogue: 0,0:18:47.88,0:18:50.18,TEXT-JP,,0,0,0,,これが僕の夢か
Dialogue: 0,0:18:51.62,0:18:53.44,TEXT-JP,,0,0,0,,なんて愉快なんだ
Dialogue: 0,0:19:10.38,0:19:11.88,TEXT-JP,,0,0,0,,坊ちゃま
Dialogue: 0,0:19:13.55,0:19:16.64,TEXT-JP,,0,0,0,,フシ　目を覚ませ
Dialogue: 0,0:20:01.64,0:20:02.66,TEXT-JP,,0,0,0,,みんな
Dialogue: 0,0:20:09.79,0:20:12.62,TEXT-JP,,0,0,0,,目を開けるんだ　フシ
Dialogue: 0,0:20:18.56,0:20:19.65,TEXT-JP,,0,0,0,,みんな
Dialogue: 0,0:20:20.27,0:20:21.69,TEXT-JP,,0,0,0,,さよなら
Dialogue: 0,0:20:49.95,0:20:51.07,TEXT-JP,,0,0,0,,これは…
Dialogue: 0,0:20:51.79,0:20:53.94,TEXT-JP,,0,0,0,,やった　助かったぞ
Dialogue: 0,0:20:54.33,0:20:57.52,TEXT-JP,,0,0,0,,神はまだ俺たちを見捨ててなかったんだ
Dialogue: 0,0:20:58.53,0:21:00.53,TEXT-JP,,0,0,0,,ケガ人はみんなこちらへ
Dialogue: 0,0:21:00.53,0:21:02.21,TEXT-JP,,0,0,0,,行こう　セラ
Dialogue: 0,0:21:08.99,0:21:10.60,TEXT-JP,,0,0,0,,なんにしてる
Dialogue: 0,0:21:10.60,0:21:13.63,TEXT-JP,,0,0,0,,カムを…カムを助けないと
Dialogue: 0,0:21:16.38,0:21:21.21,TEXT-JP,,0,0,0,,カムは…カムはユイスのことが好きだったのよ
Dialogue: 0,0:21:21.21,0:21:25.38,TEXT-JP,,0,0,0,,きっとあなたがユイスの家族になるのを知ってて
Dialogue: 0,0:21:26.18,0:21:28.26,TEXT-JP,,0,0,0,,だから頑張ってくれたんだわ
Dialogue: 0,0:21:33.05,0:21:38.45,TEXT-JP,,0,0,0,,俺たち　カムの分まで生きて人々を守るんだ
Dialogue: 0,0:21:42.01,0:21:45.07,TEXT-JP,,0,0,0,,ええ　できるかしら
Dialogue: 0,0:21:45.07,0:21:46.55,TEXT-JP,,0,0,0,,できるさ
Dialogue: 0,0:21:58.16,0:22:00.11,TEXT-JP,,0,0,0,,中に入れッ　急げ
Dialogue: 0,0:22:00.11,0:22:00.88,TEXT-JP,,0,0,0,,セラ
Dialogue: 0,0:22:41.33,0:22:46.01,TEXT-JP,,0,0,0,,ニガサナイヨ
Dialogue: 0,0:24:32.82,0:24:36.32,TEXT-JP,,0,0,0,,はじまりの姿に戻ったフシ
Dialogue: 0,0:24:36.92,0:24:42.43,TEXT-JP,,0,0,0,,全てを知ったボンはフシのために命をかけた
Dialogue: 0,0:24:43.67,0:24:46.38,TEXT-JP,,0,0,0,,希望はまだ残されている
Dialogue: 0,0:24:46.96,0:24:53.01,TEXT-JP,,0,0,0,,ノッカーとの決着をつけるため　不死身の仲間が立ち上がる
Comment: 0,0:00:00.00,0:00:00.00,TEXT-CN,,0,0,0,,
Dialogue: 1,0:00:02.52,0:00:08.88,TEXT-CN,,0,0,0,,战斗进入第四天 王都连利尔一片狼藉
Dialogue: 1,0:00:08.88,0:00:10.74,TEXT-CN,,0,0,0,,杀人了
Dialogue: 1,0:00:11.59,0:00:17.74,TEXT-CN,,0,0,0,,敌人不断涌来 不死已经精疲力尽
Dialogue: 1,0:00:17.74,0:00:20.87,TEXT-CN,,0,0,0,,不死的三战士也相继倒下
Dialogue: 1,0:00:23.45,0:00:26.25,TEXT-CN,,0,0,0,,我想要…解脱
Dialogue: 1,0:00:26.25,0:00:27.88,TEXT-CN,,0,0,0,,别担心
Dialogue: 1,0:00:28.56,0:00:30.91,TEXT-CN,,0,0,0,,我来保护你
Dialogue: 1,0:02:10.78,0:02:15.01,TEXT-CN,,0,0,0,,住手 快住手 不许杀小不
Dialogue: 1,0:02:15.01,0:02:15.74,TEXT-CN,,0,0,0,,不会吧…
Dialogue: 1,0:02:16.49,0:02:19.41,TEXT-CN,,0,0,0,,你是…玛琪
Dialogue: 1,0:02:59.76,0:03:01.28,TEXT-CN,,0,0,0,,快停下 左手
Dialogue: 1,0:03:01.52,0:03:03.48,TEXT-CN,,0,0,0,,不然的话…
Dialogue: 1,0:03:09.33,0:03:10.46,TEXT-CN,,0,0,0,,好痛
Dialogue: 1,0:03:42.20,0:03:45.68,TEXT-CN,,0,0,0,,对不起 都怪我
Dialogue: 1,0:03:46.51,0:03:51.12,TEXT-CN,,0,0,0,,不死的一切都被夺走了
Dialogue: 1,0:03:55.71,0:04:03.12,TEXT-CN,,0,0,0,,明明…明明马上就要见面了
Dialogue: 1,0:04:05.25,0:04:12.32,TEXT-CN,,0,0,0,,为了这一天 我等了好多年
Dialogue: 1,0:04:14.10,0:04:17.98,TEXT-CN,,0,0,0,,你总是一溜烟就不见了
Dialogue: 1,0:04:18.94,0:04:21.30,TEXT-CN,,0,0,0,,丢下我一个人
Dialogue: 1,0:04:35.50,0:04:36.62,TEXT-CN,,0,0,0,,你的伤…
Dialogue: 1,0:04:38.56,0:04:42.02,TEXT-CN,,0,0,0,,都好了啊
Dialogue: 1,0:04:45.19,0:04:49.89,TEXT-CN,,0,0,0,,是啊 我不该消沉的
Dialogue: 1,0:04:50.70,0:04:53.46,TEXT-CN,,0,0,0,,对啊 没错
Dialogue: 1,0:04:54.36,0:04:57.65,TEXT-CN,,0,0,0,,我能行 我要坚持下去
Dialogue: 1,0:04:58.26,0:04:59.65,TEXT-CN,,0,0,0,,相信自己
Dialogue: 1,0:05:04.16,0:05:05.88,TEXT-CN,,0,0,0,,你要去哪里
Dialogue: 1,0:05:07.71,0:05:10.29,TEXT-CN,,0,0,0,,当然是去救小不
Dialogue: 1,0:05:10.29,0:05:12.55,TEXT-CN,,0,0,0,,怎么救
Dialogue: 1,0:05:12.55,0:05:15.69,TEXT-CN,,0,0,0,,你不要乱跑 我去叫医生
Dialogue: 1,0:05:16.08,0:05:17.91,TEXT-CN,,0,0,0,,我们走吧 小马
Dialogue: 1,0:05:22.40,0:05:26.34,TEXT-CN,,0,0,0,,好奇怪 整座城市都停摆了
Dialogue: 1,0:05:29.50,0:05:34.81,TEXT-CN,,0,0,0,,既没有修理房屋 也没有补充弹药
Dialogue: 1,0:05:34.81,0:05:36.61,TEXT-CN,,0,0,0,,仿佛放弃了抵抗
Dialogue: 1,0:05:36.61,0:05:38.52,TEXT-CN,,0,0,0,,难道不死又晕倒了
Dialogue: 1,0:05:38.52,0:05:42.32,TEXT-CN,,0,0,0,,不 他应该不会再犯同样的错误
Dialogue: 1,0:05:42.81,0:05:44.74,TEXT-CN,,0,0,0,,难道是死了
Dialogue: 1,0:05:45.80,0:05:46.88,TEXT-CN,,0,0,0,,不死
Dialogue: 1,0:05:51.30,0:05:55.52,TEXT-CN,,0,0,0,,你才不会死呢 小不
Dialogue: 1,0:06:05.12,0:06:06.01,TEXT-CN,,0,0,0,,怎么了
Dialogue: 1,0:06:06.01,0:06:07.31,TEXT-CN,,0,0,0,,出什么事了
Dialogue: 1,0:06:07.31,0:06:09.69,TEXT-CN,,0,0,0,,守卫被干掉了 敲门者要闯进来了
Dialogue: 1,0:06:15.76,0:06:19.52,TEXT-CN,,0,0,0,,手上没活的人都来帮忙堵门
Dialogue: 1,0:06:26.17,0:06:28.02,TEXT-CN,,0,0,0,,你要快点好起来
Dialogue: 1,0:06:28.83,0:06:31.70,TEXT-CN,,0,0,0,,悠丝妈妈 我过去一趟
Dialogue: 1,0:06:32.09,0:06:33.16,TEXT-CN,,0,0,0,,卡姆
Dialogue: 1,0:06:33.16,0:06:35.57,TEXT-CN,,0,0,0,,你要是遇见民兵队的米基尔
Dialogue: 1,0:06:35.57,0:06:38.82,TEXT-CN,,0,0,0,,请帮忙传个话 就说我和悠丝在这里等他
Dialogue: 1,0:06:38.82,0:06:39.75,TEXT-CN,,0,0,0,,米基尔
Dialogue: 1,0:06:40.48,0:06:42.71,TEXT-CN,,0,0,0,,算是男朋友吧
Dialogue: 1,0:06:51.86,0:06:54.75,TEXT-CN,,0,0,0,,包包包…包在我身上 阿姨
Dialogue: 1,0:06:54.75,0:06:56.75,TEXT-CN,,0,0,0,,我一定把他带过来
Dialogue: 1,0:07:02.26,0:07:05.38,TEXT-CN,,0,0,0,,我们要坚持到不死回来
Dialogue: 1,0:07:06.97,0:07:09.82,TEXT-CN,,0,0,0,,我好像看到一个小姑娘骑着马跑过去了
Dialogue: 1,0:07:11.00,0:07:13.25,TEXT-CN,,0,0,0,,小马 快看那边
Dialogue: 1,0:07:18.82,0:07:20.00,TEXT-CN,,0,0,0,,外面来人了
Dialogue: 1,0:07:20.00,0:07:21.21,TEXT-CN,,0,0,0,,是来帮忙的吗
Dialogue: 1,0:07:36.49,0:07:38.25,TEXT-CN,,0,0,0,,你是谁
Dialogue: 1,0:07:38.25,0:07:42.31,TEXT-CN,,0,0,0,,我叫玛琪 大姐姐 医生在哪里
Dialogue: 1,0:07:42.31,0:07:44.02,TEXT-CN,,0,0,0,,这里就是医院
Dialogue: 1,0:07:44.02,0:07:45.22,TEXT-CN,,0,0,0,,出什么事了
Dialogue: 1,0:07:45.22,0:07:48.97,TEXT-CN,,0,0,0,,家里有人受伤了 我想找医生去小不家
Dialogue: 1,0:07:48.97,0:07:50.24,TEXT-CN,,0,0,0,,小不
Dialogue: 1,0:07:50.95,0:07:52.30,TEXT-CN,,0,0,0,,就是不死
Dialogue: 1,0:07:52.30,0:07:56.95,TEXT-CN,,0,0,0,,我知道了 我会带人过去的 你快躲到后边去
Dialogue: 1,0:07:56.95,0:07:58.50,TEXT-CN,,0,0,0,,糟了 没箭了
Dialogue: 1,0:08:03.23,0:08:04.70,TEXT-CN,,0,0,0,,塞拉 给你剑
Dialogue: 1,0:08:04.70,0:08:06.27,TEXT-CN,,0,0,0,,谢了 米基尔
Dialogue: 1,0:08:13.25,0:08:14.97,TEXT-CN,,0,0,0,,小心背后
Dialogue: 1,0:08:14.97,0:08:16.12,TEXT-CN,,0,0,0,,多谢
Dialogue: 1,0:08:17.79,0:08:20.75,TEXT-CN,,0,0,0,,快进去疗伤 从后门进
Dialogue: 1,0:08:20.75,0:08:23.69,TEXT-CN,,0,0,0,,不行 得先搞定这里
Dialogue: 1,0:08:24.33,0:08:28.80,TEXT-CN,,0,0,0,,走这条路去城堡 不死的同伴也在那里
Dialogue: 1,0:08:28.80,0:08:30.86,TEXT-CN,,0,0,0,,谢谢你 大姐姐
Dialogue: 1,0:08:41.05,0:08:43.25,TEXT-CN,,0,0,0,,不死没有回应
Dialogue: 1,0:08:45.44,0:08:47.57,TEXT-CN,,0,0,0,,梅沙尔 你在哪里
Dialogue: 1,0:08:51.15,0:08:53.45,TEXT-CN,,0,0,0,,凯 海洛
Dialogue: 1,0:08:53.45,0:08:54.39,TEXT-CN,,0,0,0,,殿下
Dialogue: 1,0:08:54.84,0:08:58.35,TEXT-CN,,0,0,0,,哪里都找不到 连利尔太大了
Dialogue: 1,0:08:58.35,0:09:02.02,TEXT-CN,,0,0,0,,你们就不能去天上找吗
Dialogue: 1,0:09:02.02,0:09:05.54,TEXT-CN,,0,0,0,,都说了我们恐高
Dialogue: 1,0:09:05.54,0:09:08.09,TEXT-CN,,0,0,0,,倒是找到了凯的尸体
Dialogue: 1,0:09:08.09,0:09:09.53,TEXT-CN,,0,0,0,,从现场情况来看
Dialogue: 1,0:09:09.53,0:09:12.57,TEXT-CN,,0,0,0,,应该是被卡哈库干掉的
Dialogue: 1,0:09:13.23,0:09:14.66,TEXT-CN,,0,0,0,,卡哈库
Dialogue: 1,0:09:23.16,0:09:25.20,TEXT-CN,,0,0,0,,你在那里啊 不死
Dialogue: 1,0:09:30.65,0:09:31.53,TEXT-CN,,0,0,0,,不死
Dialogue: 1,0:09:31.53,0:09:33.36,TEXT-CN,,0,0,0,,怎么就你一个人
Dialogue: 1,0:09:33.36,0:09:35.59,TEXT-CN,,0,0,0,,爸爸不在身边吗
Dialogue: 1,0:09:37.39,0:09:41.84,TEXT-CN,,0,0,0,,谢谢你一直照顾小不 边贤叔叔
Dialogue: 1,0:09:44.56,0:09:46.10,TEXT-CN,,0,0,0,,你是…
Dialogue: 1,0:09:52.02,0:09:55.74,TEXT-CN,,0,0,0,,两百年前被当作祭品的少女
Dialogue: 1,0:09:58.56,0:10:01.16,TEXT-CN,,0,0,0,,我们一起去找不死吧
Dialogue: 1,0:10:01.16,0:10:03.66,TEXT-CN,,0,0,0,,你知道他在哪里吗
Dialogue: 1,0:10:10.27,0:10:13.05,TEXT-CN,,0,0,0,,原来他在家里
Dialogue: 1,0:10:17.00,0:10:20.00,TEXT-CN,,0,0,0,,奇怪 大哥哥不见了
Dialogue: 1,0:10:21.45,0:10:25.24,TEXT-CN,,0,0,0,,难道是被医生带走了
Dialogue: 1,0:10:26.19,0:10:29.28,TEXT-CN,,0,0,0,,这里发生了什么 玛琪
Dialogue: 1,0:10:29.73,0:10:36.66,TEXT-CN,,0,0,0,,小不被包裹起来 拧来拧去 然后就变得血肉模糊了
Dialogue: 1,0:10:38.04,0:10:40.62,TEXT-CN,,0,0,0,,都是亚诺梅的大哥哥干的
Dialogue: 1,0:10:41.53,0:10:42.89,TEXT-CN,,0,0,0,,卡哈库干的
Dialogue: 1,0:10:44.59,0:10:48.45,TEXT-CN,,0,0,0,,都怪我 没能一直陪着他
Dialogue: 1,0:10:49.08,0:10:52.65,TEXT-CN,,0,0,0,,小不一直拼命挣扎
Dialogue: 1,0:10:52.65,0:10:54.51,TEXT-CN,,0,0,0,,但还是没能挣脱出来
Dialogue: 1,0:10:54.51,0:10:57.16,TEXT-CN,,0,0,0,,大哥哥想砍断自己的胳膊
Dialogue: 1,0:10:57.16,0:11:01.64,TEXT-CN,,0,0,0,,结果从里面窜出来一个圆滚滚的东西 后来就跑掉了
Dialogue: 1,0:11:01.64,0:11:05.77,TEXT-CN,,0,0,0,,不死就是在这里消失的吗
Dialogue: 1,0:11:05.77,0:11:08.85,TEXT-CN,,0,0,0,,叔叔 他真的不在这里吗
Dialogue: 1,0:11:09.66,0:11:13.42,TEXT-CN,,0,0,0,,小不没对你说「我就在这里」吗
Dialogue: 1,0:11:13.42,0:11:16.94,TEXT-CN,,0,0,0,,既然你能找到我们
Dialogue: 1,0:11:16.94,0:11:19.55,TEXT-CN,,0,0,0,,就不能用同样的方法找到小不吗
Dialogue: 1,0:11:35.11,0:11:37.95,TEXT-CN,,0,0,0,,很遗憾 他不在这里
Dialogue: 1,0:11:38.91,0:11:40.47,TEXT-CN,,0,0,0,,我没看到他
Dialogue: 1,0:11:41.87,0:11:43.02,TEXT-CN,,0,0,0,,我看不见他
Dialogue: 1,0:11:44.98,0:11:47.88,TEXT-CN,,0,0,0,,到此为止了吗 不死
Dialogue: 1,0:11:49.05,0:11:51.15,TEXT-CN,,0,0,0,,我们就这样…
Dialogue: 1,0:11:51.15,0:11:53.89,TEXT-CN,,0,0,0,,快跑 这里已经守不住了
Dialogue: 1,0:11:55.50,0:11:58.86,TEXT-CN,,0,0,0,,看啊 这座城市根本无处可逃
Dialogue: 1,0:12:01.55,0:12:04.28,TEXT-CN,,0,0,0,,不行 怎么砍也砍不完
Dialogue: 1,0:12:05.42,0:12:07.53,TEXT-CN,,0,0,0,,坚持住 塞拉
Dialogue: 1,0:12:07.53,0:12:11.00,TEXT-CN,,0,0,0,,我们要是倒下了 医院里的人都会死
Dialogue: 1,0:12:12.41,0:12:14.48,TEXT-CN,,0,0,0,,我们就只能…
Dialogue: 1,0:12:15.80,0:12:17.05,TEXT-CN,,0,0,0,,等死吗
Dialogue: 1,0:12:17.73,0:12:21.18,TEXT-CN,,0,0,0,,这就是你要的结果吗 黑先生
Dialogue: 1,0:12:21.18,0:12:25.18,TEXT-CN,,0,0,0,,非要看到不死和连利尔都毁了 你才满意吗
Dialogue: 1,0:12:29.37,0:12:32.06,TEXT-CN,,0,0,0,,这样有什么不好
Dialogue: 1,0:12:40.02,0:12:41.15,TEXT-CN,,0,0,0,,不好
Dialogue: 1,0:12:42.36,0:12:43.81,TEXT-CN,,0,0,0,,当然不好
Dialogue: 1,0:12:45.03,0:12:50.29,TEXT-CN,,0,0,0,,生命不应该被剥夺 说什么也不行
Dialogue: 1,0:12:50.99,0:12:54.00,TEXT-CN,,0,0,0,,那就去抢回来
Dialogue: 1,0:12:58.25,0:13:00.34,TEXT-CN,,0,0,0,,艾可 你怎么来了
Dialogue: 1,0:13:03.61,0:13:05.49,TEXT-CN,,0,0,0,,你不要紧吧
Dialogue: 1,0:13:29.99,0:13:31.20,TEXT-CN,,0,0,0,,这是…
Dialogue: 1,0:13:31.98,0:13:35.29,TEXT-CN,,0,0,0,,小不 是小不对吧
Dialogue: 1,0:13:42.08,0:13:44.61,TEXT-CN,,0,0,0,,绳子还没断
Dialogue: 1,0:13:44.61,0:13:47.63,TEXT-CN,,0,0,0,,那么整座城跟不死的连接就没有断
Dialogue: 1,0:13:49.03,0:13:51.56,TEXT-CN,,0,0,0,,不死 这是你…
Dialogue: 1,0:13:51.56,0:13:53.56,TEXT-CN,,0,0,0,,最后的挣扎吗
Dialogue: 1,0:13:55.10,0:13:58.65,TEXT-CN,,0,0,0,,有没有可能让他再次拥有意识
Dialogue: 1,0:13:59.97,0:14:01.80,TEXT-CN,,0,0,0,,试试吧 叔叔
Dialogue: 1,0:14:01.80,0:14:06.34,TEXT-CN,,0,0,0,,让小不变回人 把失去的都抢回来
Dialogue: 1,0:14:07.00,0:14:08.99,TEXT-CN,,0,0,0,,我做不到
Dialogue: 1,0:14:08.99,0:14:13.25,TEXT-CN,,0,0,0,,能感知敲门者方位的人只有被同类寄生的卡哈库
Dialogue: 1,0:14:13.25,0:14:16.76,TEXT-CN,,0,0,0,,再就是视其为异物的不死了
Dialogue: 1,0:14:17.98,0:14:19.86,TEXT-CN,,0,0,0,,凭我们是找不到的
Dialogue: 1,0:14:19.86,0:14:21.67,TEXT-CN,,0,0,0,,找不到就一直找
Dialogue: 1,0:14:21.67,0:14:23.88,TEXT-CN,,0,0,0,,我会努力找的
Dialogue: 1,0:14:23.88,0:14:26.34,TEXT-CN,,0,0,0,,它们一直在看着我们
Dialogue: 1,0:14:26.85,0:14:30.55,TEXT-CN,,0,0,0,,不会让我们找到的
Dialogue: 1,0:14:30.55,0:14:35.47,TEXT-CN,,0,0,0,,敲门者很狡猾 它们会躲在我们根本到不了的地方
Dialogue: 1,0:14:36.04,0:14:39.94,TEXT-CN,,0,0,0,,然后静静地等待连利尔灭亡
Dialogue: 1,0:14:41.44,0:14:45.71,TEXT-CN,,0,0,0,,一边是快速无限繁殖的怪物
Dialogue: 1,0:14:46.37,0:14:50.51,TEXT-CN,,0,0,0,,一边是只有一次生命的人类
Dialogue: 1,0:14:48.97,0:14:50.09,TEXT-CN-U,,0,0,0,,塞拉
Dialogue: 1,0:14:52.51,0:14:54.84,TEXT-CN,,0,0,0,,那我们该怎么办
Dialogue: 1,0:14:55.52,0:14:59.50,TEXT-CN,,0,0,0,,小不 你再也变不回来了吗
Dialogue: 1,0:15:00.25,0:15:02.96,TEXT-CN,,0,0,0,,我们要怎么帮你
Dialogue: 1,0:15:03.76,0:15:07.55,TEXT-CN,,0,0,0,,你再也想不起我们了吗
Dialogue: 1,0:15:35.36,0:15:38.57,TEXT-CN,,0,0,0,,米基尔 这里交给我 你快带塞拉去医院
Dialogue: 1,0:15:38.57,0:15:40.08,TEXT-CN,,0,0,0,,我还能继续战斗
Dialogue: 1,0:15:40.52,0:15:42.00,TEXT-CN,,0,0,0,,快走
Dialogue: 1,0:15:43.36,0:15:44.96,TEXT-CN,,0,0,0,,「想起来」
Dialogue: 1,0:15:45.55,0:15:46.79,TEXT-CN,,0,0,0,,回忆
Dialogue: 1,0:15:47.42,0:15:49.37,TEXT-CN,,0,0,0,,对了 回忆
Dialogue: 1,0:15:49.84,0:15:52.51,TEXT-CN,,0,0,0,,不死不仅失去了人形
Dialogue: 1,0:15:52.51,0:15:56.64,TEXT-CN,,0,0,0,,就连他记忆中那些人的样子也被夺走了
Dialogue: 1,0:15:57.66,0:15:59.87,TEXT-CN,,0,0,0,,外貌和声音
Dialogue: 1,0:16:01.07,0:16:07.13,TEXT-CN,,0,0,0,,黑袍子叔叔说过被抢走的是外貌 声音和气味吧
Dialogue: 1,0:16:07.13,0:16:09.53,TEXT-CN,,0,0,0,,是这样吗 黑先生
Dialogue: 1,0:16:14.33,0:16:18.16,TEXT-CN,,0,0,0,,外貌 声音 气味
Dialogue: 1,0:16:18.16,0:16:23.50,TEXT-CN,,0,0,0,,如果有办法告诉不死 他就能想起所有人吗
Dialogue: 1,0:16:23.50,0:16:27.89,TEXT-CN,,0,0,0,,可是他现在没有眼睛耳朵 我又该如何告诉他
Dialogue: 1,0:16:28.64,0:16:30.97,TEXT-CN,,0,0,0,,要怎么才能影响他
Dialogue: 1,0:16:32.18,0:16:35.14,TEXT-CN,,0,0,0,,我能给他什么
Dialogue: 1,0:16:41.55,0:16:42.88,TEXT-CN,,0,0,0,,叔叔
Dialogue: 1,0:16:44.11,0:16:45.41,TEXT-CN,,0,0,0,,卡姆
Dialogue: 1,0:16:45.81,0:16:47.91,TEXT-CN,,0,0,0,,别过去 快走
Dialogue: 1,0:16:47.91,0:16:50.62,TEXT-CN,,0,0,0,,放开我 我要去救他
Dialogue: 1,0:16:50.62,0:16:52.40,TEXT-CN,,0,0,0,,赶紧走
Dialogue: 1,0:16:58.83,0:17:02.35,TEXT-CN,,0,0,0,,玛琪 你到外面等我吧
Dialogue: 1,0:17:03.28,0:17:07.58,TEXT-CN,,0,0,0,,如果数到一百我还没有出来
Dialogue: 1,0:17:07.58,0:17:12.01,TEXT-CN,,0,0,0,,你就骑马去乌拉里斯军在及利亚的营地
Dialogue: 1,0:17:12.01,0:17:15.19,TEXT-CN,,0,0,0,,给他们看这个 他们就会收留你
Dialogue: 1,0:17:20.22,0:17:21.41,TEXT-CN,,0,0,0,,叔叔
Dialogue: 1,0:17:26.06,0:17:28.11,TEXT-CN,,0,0,0,,艾可去哪里了
Dialogue: 1,0:17:30.36,0:17:31.82,TEXT-CN,,0,0,0,,没有时间了
Dialogue: 1,0:17:32.52,0:17:39.29,TEXT-CN,,0,0,0,,玛琪 我终于明白你为什么叫我来了
Dialogue: 1,0:17:43.39,0:17:44.43,TEXT-CN,,0,0,0,,不死
Dialogue: 1,0:17:49.92,0:17:52.72,TEXT-CN,,0,0,0,,卡姆 别睡 快起来
Dialogue: 1,0:18:00.05,0:18:01.50,TEXT-CN,,0,0,0,,不要啊
Dialogue: 1,0:18:10.89,0:18:14.42,TEXT-CN,,0,0,0,,快给我想起来 不死
Dialogue: 1,0:18:36.69,0:18:38.09,TEXT-CN,,0,0,0,,陛下
Dialogue: 1,0:18:39.19,0:18:41.06,TEXT-CN,,0,0,0,,国王陛下
Dialogue: 1,0:18:47.88,0:18:50.18,TEXT-CN,,0,0,0,,原来我在做梦啊
Dialogue: 1,0:18:51.62,0:18:53.44,TEXT-CN,,0,0,0,,倒是个美梦
Dialogue: 1,0:19:10.38,0:19:11.88,TEXT-CN,,0,0,0,,殿下
Dialogue: 1,0:19:13.55,0:19:16.64,TEXT-CN,,0,0,0,,不死 赶紧醒过来
Dialogue: 1,0:20:01.64,0:20:02.66,TEXT-CN,,0,0,0,,是你们
Dialogue: 1,0:20:09.79,0:20:12.62,TEXT-CN,,0,0,0,,快睁开双眼 不死
Dialogue: 1,0:20:18.56,0:20:19.65,TEXT-CN,,0,0,0,,各位
Dialogue: 1,0:20:20.27,0:20:21.69,TEXT-CN,,0,0,0,,永别了
Dialogue: 1,0:20:49.95,0:20:51.07,TEXT-CN,,0,0,0,,这是…
Dialogue: 1,0:20:51.79,0:20:53.94,TEXT-CN,,0,0,0,,太好了 得救了
Dialogue: 1,0:20:54.33,0:20:57.52,TEXT-CN,,0,0,0,,我就知道神不会舍弃我们的
Dialogue: 1,0:20:58.53,0:21:00.53,TEXT-CN,,0,0,0,,伤员都到里面来
Dialogue: 1,0:21:00.53,0:21:02.21,TEXT-CN,,0,0,0,,我们走吧 塞拉
Dialogue: 1,0:21:08.99,0:21:10.60,TEXT-CN,,0,0,0,,你在干什么
Dialogue: 1,0:21:10.60,0:21:13.63,TEXT-CN,,0,0,0,,不能扔下卡姆不管
Dialogue: 1,0:21:16.38,0:21:21.21,TEXT-CN,,0,0,0,,卡姆…他一直喜欢悠丝
Dialogue: 1,0:21:21.21,0:21:25.38,TEXT-CN,,0,0,0,,他一定是知道了你和她会成为一家人
Dialogue: 1,0:21:26.18,0:21:28.26,TEXT-CN,,0,0,0,,才这么拼命的
Dialogue: 1,0:21:33.05,0:21:38.45,TEXT-CN,,0,0,0,,我们要替他活下去 保护更多的人
Dialogue: 1,0:21:42.01,0:21:45.07,TEXT-CN,,0,0,0,,嗯 我们能活下来吗
Dialogue: 1,0:21:45.07,0:21:46.55,TEXT-CN,,0,0,0,,别说傻话
Dialogue: 1,0:21:58.16,0:22:00.11,TEXT-CN,,0,0,0,,快到里面去
Dialogue: 1,0:22:00.11,0:22:00.88,TEXT-CN,,0,0,0,,塞拉
Dialogue: 1,0:22:41.33,0:22:46.01,TEXT-CN,,0,0,0,,别想摆脱我
Dialogue: 1,0:24:32.82,0:24:36.32,TEXT-CN,,0,0,0,,不死变回了最初的形态
Dialogue: 1,0:24:36.92,0:24:42.43,TEXT-CN,,0,0,0,,边贤想通了之后 便在不死身上赌上了性命
Dialogue: 1,0:24:43.67,0:24:46.38,TEXT-CN,,0,0,0,,他们还有希望
Dialogue: 1,0:24:46.96,0:24:53.01,TEXT-CN,,0,0,0,,为了和敲门者一决胜负 不死的同伴纷纷展开行动
