Dialogue: 0,0:24:17.10,0:24:26.95,屏幕字背景,,0,0,0,,{\an1\c&HFFFFFF&\fs160\3c&H000000&\pos(30,677)}　　　　　　第拾柒話\N{\fs240}少年啊 保持住你的弱小
Dialogue: 0,0:00:03.97,0:00:05.35,CHS,,0,0,0,,好多地方都變長了
Dialogue: 0,0:00:11.23,0:00:12.98,CHS,,0,0,0,,白衣人既然來了
Dialogue: 0,0:00:13.52,0:00:16.52,CHS,,0,0,0,,想必他們的目的就是帶走安德拉爆炎擁有者吧
Dialogue: 0,0:00:17.19,0:00:18.02,CHS,,0,0,0,,那麼
Dialogue: 0,0:00:18.23,0:00:20.07,CHS,,0,0,0,,是否該先跟灰島的人聯手
Dialogue: 0,0:00:20.61,0:00:23.45,CHS,,0,0,0,,擺脫這種三方混戰的局面
Dialogue: 0,0:00:25.16,0:00:28.03,CHS,,0,0,0,,我要代替太陽神消滅你們
Dialogue: 0,0:00:49.68,0:00:50.56,CHS,,0,0,0,,哎呀
Dialogue: 0,0:00:50.64,0:00:51.43,CHS,,0,0,0,,不管用
Dialogue: 0,0:00:51.89,0:00:53.48,CHS,,0,0,0,,怎麼是絕緣的啊
Dialogue: 0,0:00:56.90,0:00:58.57,CHS,,0,0,0,,妊神星 你退後
Dialogue: 0,0:00:59.44,0:01:00.82,CHS,,0,0,0,,不要搗亂
Dialogue: 0,0:01:10.58,0:01:12.41,CHS,,0,0,0,,這可不行
Dialogue: 0,0:01:13.16,0:01:14.71,CHS,,0,0,0,,必須拉開距離 否則對我很不利
Dialogue: 0,0:01:16.62,0:01:18.63,CHS,,0,0,0,,她的步幅與我相同 距離拉不開
Dialogue: 0,0:01:19.21,0:01:20.34,CHS,,0,0,0,,別說拉開距離了
Dialogue: 0,0:01:21.05,0:01:22.09,CHS,,0,0,0,,反而讓她後來居上了
Dialogue: 0,0:01:24.47,0:01:26.38,CHS,,0,0,0,,亞羅你在搞什麼鬼
Dialogue: 0,0:01:26.47,0:01:28.14,CHS,,0,0,0,,太沒用了吧
Dialogue: 0,0:01:32.22,0:01:33.14,CHS,,0,0,0,,對不起
Dialogue: 0,0:01:33.14,0:01:34.89,CHS,,0,0,0,,就你這樣的還保護我呢
Dialogue: 0,0:01:35.23,0:01:37.27,CHS,,0,0,0,,要說柱與守護人的關係
Dialogue: 0,0:01:37.52,0:01:39.36,CHS,,0,0,0,,象團長與我
Dialogue: 0,0:01:39.48,0:01:42.03,CHS,,0,0,0,,卡戎與妊神星 這樣的組合才叫搭檔
Dialogue: 0,0:01:42.03,0:01:45.61,CHS,,0,0,0,,搭檔的組成是以互補為前提的
Dialogue: 0,0:01:45.99,0:01:48.28,CHS,,0,0,0,,硬是被拆開來 自然配合不到一處去
Dialogue: 0,0:01:52.87,0:01:56.41,CHS,,0,0,0,,我用全身電擊為你按摩
Dialogue: 0,0:01:57.33,0:01:59.17,CHS,,0,0,0,,讓我們好好相處吧
Dialogue: 0,0:01:59.58,0:02:03.25,CHS,,0,0,0,,她看起來渾身帶電耶
Dialogue: 0,0:02:03.50,0:02:05.67,CHS,,0,0,0,,靠近她是會觸電的
Dialogue: 0,0:02:07.34,0:02:09.80,CHS,,0,0,0,,我不想聽你的藉口 亞羅
Dialogue: 0,0:02:11.60,0:02:14.02,CHS,,0,0,0,,要是不能好好保護我 我就宰了你
Dialogue: 0,0:02:15.52,0:02:16.64,CHS,,0,0,0,,太棒了
Dialogue: 0,0:02:16.77,0:02:18.69,CHS,,0,0,0,,動力裝置熱機完畢了
Dialogue: 0,0:02:18.77,0:02:20.56,CHS,,0,0,0,,很有調教的價值
Dialogue: 0,0:02:22.23,0:02:24.78,CHS,,0,0,0,,卡戎很快就會把第六柱抓來
Dialogue: 0,0:02:25.11,0:02:27.74,CHS,,0,0,0,,亞羅也別總陰沉著一張臉
Dialogue: 0,0:02:29.45,0:02:31.03,CHS,,0,0,0,,來大鬧一場吧
Dialogue: 0,0:02:32.83,0:02:35.66,CHS,,0,0,0,,要是讓電波女放出毒電波那就完了
Dialogue: 0,0:02:36.25,0:02:38.71,CHS,,0,0,0,,這一帶的電漿體密度在上升
Dialogue: 0,0:02:39.14,0:02:40.21,CHS,,0,0,0,,得抓緊時間了
Dialogue: 0,0:02:40.88,0:02:42.71,CHS,,0,0,0,,亞瑟 你在哪裡?
Dialogue: 0,0:02:43.38,0:02:44.34,CHS,,0,0,0,,Walk
Dialogue: 0,0:02:47.26,0:02:48.13,CHS,,0,0,0,,Snap
Dialogue: 0,0:02:51.51,0:02:52.35,CHS,,0,0,0,,哪吒呢?
Dialogue: 0,0:02:54.01,0:02:55.93,CHS,,0,0,0,,放開我
Dialogue: 0,0:02:54.65,0:02:55.64,CHS2,,0,0,0,,別亂動
Dialogue: 0,0:02:57.35,0:02:59.23,CHS,,0,0,0,,對了 小鬼在那邊
Dialogue: 0,0:02:59.52,0:03:01.15,CHS,,0,0,0,,壞人自相殘殺吧
Dialogue: 0,0:03:02.02,0:03:02.86,CHS,,0,0,0,,過來了
Dialogue: 0,0:03:05.73,0:03:06.82,CHS,,0,0,0,,別擋路
Dialogue: 0,0:03:07.40,0:03:09.74,CHS,,0,0,0,,讓我先把那個弱雞幹掉
Dialogue: 0,0:03:10.41,0:03:12.32,CHS,,0,0,0,,你不管哪吒了嗎?
Dialogue: 0,0:03:13.87,0:03:17.83,CHS,,0,0,0,,我不是說了 如果可以 我更願意痛打弱雞
Dialogue: 0,0:03:23.88,0:03:24.71,CHS,,0,0,0,,Clap
Dialogue: 0,0:03:26.55,0:03:27.96,CHS,,0,0,0,,真是見鬼了
Dialogue: 0,0:03:28.59,0:03:29.34,CHS,,0,0,0,,森羅
Dialogue: 0,0:03:29.51,0:03:30.38,CHS,,0,0,0,,先去救哪吒
Dialogue: 0,0:03:30.43,0:03:31.13,CHS,,0,0,0,,是
Dialogue: 0,0:03:31.38,0:03:32.14,CHS,,0,0,0,,走吧
Dialogue: 0,0:03:32.55,0:03:33.85,CHS,,0,0,0,,別想跑
Dialogue: 0,0:03:37.27,0:03:38.31,CHS,,0,0,0,,現在怎麼辦?
Dialogue: 0,0:03:38.64,0:03:39.98,CHS,,0,0,0,,我們也過去嗎?
Dialogue: 0,0:03:40.27,0:03:42.10,CHS,,0,0,0,,稍安勿躁 利茲
Dialogue: 0,0:03:42.60,0:03:44.15,CHS,,0,0,0,,很快就會有死人了
Dialogue: 0,0:03:44.52,0:03:46.15,CHS,,0,0,0,,少不了你的素材
Dialogue: 0,0:03:47.86,0:03:50.15,CHS,,0,0,0,,多虧有因果大小姐的力量
Dialogue: 0,0:03:50.74,0:03:53.99,CHS,,0,0,0,,我總算能盡情發揮自己的能力了
Dialogue: 0,0:03:54.62,0:03:56.12,CHS,,0,0,0,,危險 危險
Dialogue: 0,0:03:56.45,0:03:57.91,CHS,,0,0,0,,危險的要人命
Dialogue: 0,0:03:58.33,0:04:00.50,CHS,,0,0,0,,利茲 去讓他們見識一下
Dialogue: 0,0:04:02.96,0:04:06.84,CHS,,0,0,0,,什麼是玩弄人的咒術
Dialogue: 0,0:05:45.23,0:05:46.19,CHS,,0,0,0,,可惡
Dialogue: 0,0:05:51.73,0:05:54.44,CHS,,0,0,0,,跟你打還挺花功夫的
Dialogue: 0,0:05:55.15,0:05:57.70,CHS,,0,0,0,,有沒有更好對付一些的
Dialogue: 0,0:05:57.70,0:05:59.45,CHS,,0,0,0,,放開我 放開我
Dialogue: 0,0:06:03.29,0:06:04.95,CHS,,0,0,0,,這股黑煙是
Dialogue: 0,0:06:09.83,0:06:11.79,CHS,,0,0,0,,身體好燙
Dialogue: 0,0:06:12.34,0:06:13.59,CHS,,0,0,0,,好燙啊
Dialogue: 0,0:06:17.18,0:06:18.97,CHS,,0,0,0,,將高溫的煤煙吸入體內
Dialogue: 0,0:06:19.34,0:06:20.89,CHS,,0,0,0,,讓身體從內燃燒吧
Dialogue: 0,0:06:24.60,0:06:26.31,CHS,,0,0,0,,弱得正好
Dialogue: 0,0:06:35.44,0:06:36.57,CHS,,0,0,0,,救到手了
Dialogue: 0,0:06:36.99,0:06:38.82,CHS,,0,0,0,,你安全了 哪吒
Dialogue: 0,0:06:40.70,0:06:41.99,CHS,,0,0,0,,第六柱
Dialogue: 0,0:06:42.24,0:06:44.20,CHS,,0,0,0,,不可以離開我的身邊哦
Dialogue: 0,0:06:46.95,0:06:49.00,CHS,,0,0,0,,那是用來開發智力的小熊
Dialogue: 0,0:06:49.79,0:06:51.54,CHS,,0,0,0,,這孩子是屬於我們灰島的
Dialogue: 0,0:06:51.63,0:06:52.46,CHS,,0,0,0,,小熊
Dialogue: 0,0:06:53.71,0:06:54.59,CHS,,0,0,0,,抓到了
Dialogue: 0,0:06:54.80,0:06:57.09,CHS,,0,0,0,,別礙事 亞瑟 是我先抓到他的
Dialogue: 0,0:06:57.26,0:06:58.42,CHS,,0,0,0,,少廢話 惡魔
Dialogue: 0,0:06:58.42,0:06:59.80,CHS,,0,0,0,,你把這小鬼嚇到了
Dialogue: 0,0:07:03.97,0:07:04.97,CHS,,0,0,0,,搶籃板
Dialogue: 0,0:07:10.39,0:07:11.31,CHS,,0,0,0,,你這是犯規
Dialogue: 0,0:07:12.02,0:07:13.69,CHS,,0,0,0,,來呀 來呀來呀
Dialogue: 0,0:07:18.15,0:07:19.95,CHS,,0,0,0,,正適合拿來當素材
Dialogue: 0,0:07:21.41,0:07:24.66,CHS,,0,0,0,,還差一個拿來當底料的焰人
Dialogue: 0,0:07:27.79,0:07:29.79,CHS,,0,0,0,,那裡有個正合適的人選
Dialogue: 0,0:07:32.92,0:07:34.50,CHS,,0,0,0,,我來讓你變大吧
Dialogue: 0,0:07:37.92,0:07:38.84,CHS,,0,0,0,,焰人
Dialogue: 0,0:07:43.64,0:07:44.85,CHS,,0,0,0,,死屍烈焰
Dialogue: 0,0:07:53.27,0:07:54.81,CHS,,0,0,0,,詐屍了
Dialogue: 0,0:07:54.94,0:07:56.82,CHS,,0,0,0,,好邪惡的力量
Dialogue: 0,0:08:04.24,0:08:06.53,CHS,,0,0,0,,屍體襲擊了焰人
Dialogue: 0,0:08:06.95,0:08:08.24,CHS,,0,0,0,,哦哦 神啊
Dialogue: 0,0:08:12.87,0:08:15.71,CHS,,0,0,0,,去吧 大焰人
Dialogue: 0,0:08:25.72,0:08:26.97,CHS,,0,0,0,,這 這是
Dialogue: 0,0:08:27.60,0:08:28.81,CHS,,0,0,0,,巨型焰人
Dialogue: 0,0:08:30.93,0:08:33.60,CHS,,0,0,0,,之前曾在上野出現過的那個焰人
Dialogue: 0,0:08:34.06,0:08:35.98,CHS,,0,0,0,,就是這個女人用能力製造出來的嗎?
Dialogue: 0,0:08:36.40,0:08:39.15,CHS,,0,0,0,,連屍體也敢褻瀆
Dialogue: 0,0:08:39.48,0:08:41.78,CHS,,0,0,0,,這次的底料是戰鬥人員
Dialogue: 0,0:08:41.99,0:08:45.07,CHS,,0,0,0,,自然比之前的失敗品要厲害得多
Dialogue: 0,0:08:50.24,0:08:51.33,CHS,,0,0,0,,喂 我是黑野
Dialogue: 0,0:08:53.50,0:08:54.29,CHS,,0,0,0,,社長
Dialogue: 0,0:08:54.92,0:08:56.71,CHS,,0,0,0,,是 是
Dialogue: 0,0:08:57.71,0:08:59.80,CHS,,0,0,0,,我是優先解決的弱者
Dialogue: 0,0:09:00.96,0:09:02.63,CHS,,0,0,0,,傻瓜? 我?
Dialogue: 0,0:09:04.26,0:09:05.13,CHS,,0,0,0,,是
Dialogue: 0,0:09:05.72,0:09:07.26,CHS,,0,0,0,,覺醒了安德拉爆炎的少年
Dialogue: 0,0:09:07.39,0:09:09.43,CHS,,0,0,0,,被一個似乎十分強大的焰人吸入體中
Dialogue: 0,0:09:10.85,0:09:11.89,CHS,,0,0,0,,是的
Dialogue: 0,0:09:13.02,0:09:14.94,CHS,,0,0,0,,所以我便優先朝弱者
Dialogue: 0,0:09:15.48,0:09:18.44,CHS,,0,0,0,,什麼? 是不是傻? 您是說我嗎?
Dialogue: 0,0:09:19.32,0:09:20.11,CHS,,0,0,0,,是
Dialogue: 0,0:09:20.90,0:09:21.73,CHS,,0,0,0,,是
Dialogue: 0,0:09:22.57,0:09:25.11,CHS,,0,0,0,,我明白了 抱歉失陪了
Dialogue: 0,0:09:32.45,0:09:36.08,CHS,,0,0,0,,這年頭 社畜可真不好當啊
Dialogue: 0,0:09:43.30,0:09:45.93,CHS,,0,0,0,,現在第8隊和灰島不該相爭
Dialogue: 0,0:09:46.76,0:09:48.34,CHS,,0,0,0,,先將哪吒奪回來再說
Dialogue: 0,0:09:49.55,0:09:50.81,CHS,,0,0,0,,我會協助你們
Dialogue: 0,0:10:03.28,0:10:04.28,CHS,,0,0,0,,喂 亞羅
Dialogue: 0,0:10:04.36,0:10:06.61,CHS,,0,0,0,,你去拖住那個愛調教人的老太婆
Dialogue: 0,0:10:06.86,0:10:09.16,CHS,,0,0,0,,我找第六柱有事
Dialogue: 0,0:10:10.78,0:10:13.83,CHS,,0,0,0,,這回再搞砸 我真的會宰了你的
Dialogue: 0,0:10:14.16,0:10:15.25,CHS,,0,0,0,,我明白
Dialogue: 0,0:10:18.54,0:10:19.96,CHS,,0,0,0,,怎麼可以擅自跑掉呢
Dialogue: 0,0:10:23.67,0:10:25.59,CHS,,0,0,0,,你真的很愛給我搗亂啊
Dialogue: 0,0:10:28.26,0:10:29.26,CHS,,0,0,0,,就是他吧
Dialogue: 0,0:10:29.34,0:10:30.93,CHS,,0,0,0,,一臉蠢樣
Dialogue: 0,0:10:31.93,0:10:35.10,CHS,,0,0,0,,我來幫你 嗨起來吧
Dialogue: 0,0:10:42.52,0:10:45.99,CHS,,0,0,0,,沒錯 小孩子就要有想像力
Dialogue: 0,0:10:46.53,0:10:48.70,CHS,,0,0,0,,要想像的天馬行空
Dialogue: 0,0:10:49.24,0:10:52.37,CHS,,0,0,0,,燃燒吧 強大吧 奮鬥吧
Dialogue: 0,0:10:54.74,0:10:56.20,CHS,,0,0,0,,我的想像
Dialogue: 0,0:10:56.91,0:10:58.46,CHS,,0,0,0,,想像力
Dialogue: 0,0:11:02.54,0:11:06.46,CHS,,0,0,0,,我的想像力被汙染了
Dialogue: 0,0:11:08.76,0:11:12.89,CHS,,0,0,0,,我內心的瘋子在煽動著我
Dialogue: 0,0:11:14.22,0:11:15.01,CHS,,0,0,0,,☆
Dialogue: 0,0:11:16.22,0:11:17.60,CHS,,0,0,0,,希望在上
Dialogue: 0,0:11:18.77,0:11:19.98,CHS,,0,0,0,,心情在下
Dialogue: 0,0:11:21.94,0:11:24.61,CHS,,0,0,0,,瘋子在從下向上煽動著
Dialogue: 0,0:11:26.19,0:11:27.74,CHS,,0,0,0,,煽動著我不斷朝上
Dialogue: 0,0:11:28.49,0:11:30.15,CHS,,0,0,0,,伴隨著沉重的煙霧一起
Dialogue: 0,0:11:31.45,0:11:33.03,CHS,,0,0,0,,朝著希望而去
Dialogue: 0,0:11:35.45,0:11:36.70,CHS,,0,0,0,,希望在上
Dialogue: 0,0:11:38.08,0:11:39.25,CHS,,0,0,0,,當真如此嗎?
Dialogue: 0,0:11:40.62,0:11:43.00,CHS,,0,0,0,,迎面而來的煙霧是如此熏人
Dialogue: 0,0:11:44.67,0:11:45.84,CHS,,0,0,0,,希望在上
Dialogue: 0,0:11:46.75,0:11:47.92,CHS,,0,0,0,,心情在下
Dialogue: 0,0:11:49.34,0:11:50.67,CHS,,0,0,0,,我快要窒息了
Dialogue: 0,0:11:51.93,0:11:53.14,CHS,,0,0,0,,要窒息了
Dialogue: 0,0:11:53.84,0:11:56.72,CHS2,,0,0,0,,等你啊
Dialogue: 0,0:11:54.93,0:11:58.52,CHS,,0,0,0,,我要窒息了
Dialogue: 0,0:12:01.19,0:12:03.15,CHS,,0,0,0,,被汙染的想像力
Dialogue: 0,0:12:04.61,0:12:05.94,CHS,,0,0,0,,讓我快要窒息了
Dialogue: 0,0:12:16.70,0:12:20.75,CHS,,0,0,0,,你們所有人 都跟著希望一起窒息吧
Dialogue: 0,0:12:24.63,0:12:25.84,CHS,,0,0,0,,他怎麼突然這樣了?
Dialogue: 0,0:12:26.88,0:12:28.30,CHS,,0,0,0,,是喪失自我了嗎?
Dialogue: 0,0:12:29.84,0:12:30.84,CHS,,0,0,0,,妊神星
Dialogue: 0,0:12:31.63,0:12:33.05,CHS,,0,0,0,,你動了什麼手腳對吧
Dialogue: 0,0:12:36.18,0:12:37.56,CHS,,0,0,0,,Motor Head
Dialogue: 0,0:12:37.89,0:12:40.43,CHS,,0,0,0,,我稍微調整了一下能使人產生壓力與興奮情緒的
Dialogue: 0,0:12:40.43,0:12:44.31,CHS,,0,0,0,,多巴胺和β—內啡肽的分泌量
Dialogue: 0,0:12:44.44,0:12:46.94,CHS,,0,0,0,,這本就是他所擁有的資質
Dialogue: 0,0:12:47.02,0:12:48.57,CHS,,0,0,0,,不會弄壞他的
Dialogue: 0,0:12:49.40,0:12:51.03,CHS,,0,0,0,,被汙染的想像力
Dialogue: 0,0:12:51.03,0:12:54.49,CHS,,0,0,0,,本來就是這小子壓力過大的表現
Dialogue: 0,0:12:54.78,0:12:57.78,CHS,,0,0,0,,所有人一起窒息吧
Dialogue: 0,0:13:17.97,0:13:19.72,CHS,,0,0,0,,喂喂喂 開玩笑的吧
Dialogue: 0,0:13:20.56,0:13:22.02,CHS,,0,0,0,,大隊長 情況不妙
Dialogue: 0,0:13:22.35,0:13:24.14,CHS,,0,0,0,,現在立刻離開那裡
Dialogue: 0,0:13:24.56,0:13:25.27,CHS,,0,0,0,,是伏爾甘嗎?
Dialogue: 0,0:13:25.35,0:13:26.15,CHS,,0,0,0,,有什麼問題嗎?
Dialogue: 0,0:13:27.23,0:13:29.27,CHS,,0,0,0,,放射線反應超過基準值
Dialogue: 0,0:13:29.40,0:13:31.19,CHS,,0,0,0,,無能力者最好先避一避
Dialogue: 0,0:13:32.15,0:13:33.69,CHS,,0,0,0,,修女 利希特 你們到這邊來
Dialogue: 0,0:13:34.40,0:13:36.70,CHS,,0,0,0,,肯定是那個電波女做了什麼
Dialogue: 0,0:13:37.16,0:13:38.57,CHS,,0,0,0,,對付她 我們需要亞瑟
Dialogue: 0,0:13:38.78,0:13:41.16,CHS,,0,0,0,,等我帶上亞瑟去找你們
Dialogue: 0,0:13:41.87,0:13:42.79,CHS,,0,0,0,,亞瑟
Dialogue: 0,0:13:43.33,0:13:44.75,CHS,,0,0,0,,亞瑟 你在哪裡?
Dialogue: 0,0:13:45.83,0:13:47.71,CHS,,0,0,0,,駕 阿銀
Dialogue: 0,0:13:47.96,0:13:49.46,CHS,,0,0,0,,阿銀就阿銀吧
Dialogue: 0,0:13:49.71,0:13:51.21,CHS,,0,0,0,,現在需要借助你的力量
Dialogue: 0,0:13:53.84,0:13:56.18,CHS,,0,0,0,,要離放射線源多遠比較合適
Dialogue: 0,0:13:56.59,0:14:00.39,CHS,,0,0,0,,無能力者保持兩百公尺左右的距離應該就可以了
Dialogue: 0,0:14:01.43,0:14:03.43,CHS,,0,0,0,,但是在裡面作戰的能力者
Dialogue: 0,0:14:03.43,0:14:05.06,CHS,,0,0,0,,他們的處境就非常危險了
Dialogue: 0,0:14:12.11,0:14:14.82,CHS,,0,0,0,,這些放射線是第三代能力者釋放的
Dialogue: 0,0:14:15.53,0:14:17.78,CHS,,0,0,0,,我們能力者目前還不要緊
Dialogue: 0,0:14:18.82,0:14:22.58,CHS,,0,0,0,,可放射線若再不斷變強
Dialogue: 0,0:14:22.58,0:14:23.54,CHS,,0,0,0,,那就真的危險了
Dialogue: 0,0:14:23.91,0:14:26.08,CHS,,0,0,0,,利茲 巨人呢?
Dialogue: 0,0:14:26.58,0:14:27.83,CHS,,0,0,0,,因果大小姐
Dialogue: 0,0:14:28.12,0:14:30.71,CHS,,0,0,0,,你跑下來會很危險的
Dialogue: 0,0:14:30.88,0:14:32.84,CHS,,0,0,0,,攻擊又不會落到我身上
Dialogue: 0,0:14:33.17,0:14:36.13,CHS,,0,0,0,,妊神星對第六柱的大腦進行了干涉
Dialogue: 0,0:14:36.76,0:14:38.72,CHS,,0,0,0,,那道熱線似乎就是放射線
Dialogue: 0,0:14:39.34,0:14:42.01,CHS,,0,0,0,,放射線 這可不得了了
Dialogue: 0,0:14:42.26,0:14:44.10,CHS,,0,0,0,,所以說因果大小姐
Dialogue: 0,0:14:44.43,0:14:45.72,CHS,,0,0,0,,你站在那裡會死的哦
Dialogue: 0,0:14:46.10,0:14:47.10,CHS,,0,0,0,,真的嗎?
Dialogue: 0,0:14:51.02,0:14:52.27,CHS,,0,0,0,,在這種情況下
Dialogue: 0,0:14:52.48,0:14:54.11,CHS,,0,0,0,,要怎麼帶走第六柱啊
Dialogue: 0,0:14:54.11,0:14:57.19,CHS,,0,0,0,,要死了要死了 妊神星最棒了
Dialogue: 0,0:14:57.57,0:14:58.74,CHS,,0,0,0,,妊神星那丫頭
Dialogue: 0,0:14:59.11,0:15:01.28,CHS,,0,0,0,,淨會搗蛋
Dialogue: 0,0:15:01.57,0:15:03.24,CHS,,0,0,0,,那個巨型焰人
Dialogue: 0,0:15:03.49,0:15:05.12,CHS,,0,0,0,,突然開始胡亂攻擊
Dialogue: 0,0:15:06.75,0:15:07.62,CHS,,0,0,0,,黑野
Dialogue: 0,0:15:07.87,0:15:09.08,CHS,,0,0,0,,我們得阻止哪吒
Dialogue: 0,0:15:09.42,0:15:10.50,CHS,,0,0,0,,不得已
Dialogue: 0,0:15:11.50,0:15:12.38,CHS,,0,0,0,,只好殺了他
Dialogue: 0,0:15:12.54,0:15:15.21,CHS,,0,0,0,,他好歹也是灰島寶貴的能力者 你竟然想殺了他
Dialogue: 0,0:15:15.21,0:15:16.80,CHS,,0,0,0,,你到底是不是灰島的員工啊
Dialogue: 0,0:15:16.80,0:15:17.55,CHS,,0,0,0,,你是我上司嗎?
Dialogue: 0,0:15:17.55,0:15:19.93,CHS,,0,0,0,,別老想著收拾別人
Dialogue: 0,0:15:20.05,0:15:21.55,CHS,,0,0,0,,想想自己的職務吧
Dialogue: 0,0:15:21.55,0:15:22.59,CHS,,0,0,0,,你是我上司嗎?
Dialogue: 0,0:15:22.68,0:15:24.22,CHS,,0,0,0,,我們得破壞掉巨人那部分
Dialogue: 0,0:15:24.35,0:15:25.60,CHS,,0,0,0,,把哪吒挖出來
Dialogue: 0,0:15:26.02,0:15:26.85,CHS,,0,0,0,,準備上吧
Dialogue: 0,0:15:31.31,0:15:32.27,CHS,,0,0,0,,好硬
Dialogue: 0,0:15:40.53,0:15:41.41,CHS,,0,0,0,,黑野
Dialogue: 0,0:15:41.70,0:15:43.74,CHS,,0,0,0,,我去引開雷射 幫你製造機會
Dialogue: 0,0:15:44.16,0:15:45.16,CHS,,0,0,0,,你就趁機
Dialogue: 0,0:15:53.08,0:15:54.13,CHS,,0,0,0,,好強
Dialogue: 0,0:15:57.25,0:15:59.84,CHS,,0,0,0,,變強太多了
Dialogue: 0,0:16:03.80,0:16:05.05,CHS,,0,0,0,,我乾脆換工作吧
Dialogue: 0,0:16:06.18,0:16:09.89,CHS2,,0,0,0,,簡直了 怎麼就這麼強呢
Dialogue: 0,0:16:07.77,0:16:09.64,CHS,,0,0,0,,喂 你在搞什麼鬼?
Dialogue: 0,0:16:09.98,0:16:11.52,CHS,,0,0,0,,說好的要協助我呢?
Dialogue: 0,0:16:10.52,0:16:12.31,CHS2,,0,0,0,,我還是更喜歡對付弱者
Dialogue: 0,0:16:14.52,0:16:15.40,CHS,,0,0,0,,死定了
Dialogue: 0,0:16:27.20,0:16:28.08,CHS,,0,0,0,,卡戎
Dialogue: 0,0:16:28.24,0:16:30.41,CHS,,0,0,0,,保護柱的安全是我的使命
Dialogue: 0,0:16:32.33,0:16:33.62,CHS,,0,0,0,,我會保護你的
Dialogue: 0,0:16:40.88,0:16:42.22,CHS,,0,0,0,,我來掩護你
Dialogue: 0,0:16:42.59,0:16:43.93,CHS,,0,0,0,,你靠速度逼近對方
Dialogue: 0,0:16:44.05,0:16:45.51,CHS,,0,0,0,,將第六柱拖出來
Dialogue: 0,0:16:45.68,0:16:47.72,CHS,,0,0,0,,不用你保護我 我自己也能辦到
Dialogue: 0,0:16:48.35,0:16:49.68,CHS,,0,0,0,,男人這種生物
Dialogue: 0,0:16:49.85,0:16:51.73,CHS,,0,0,0,,明明內心總也長不大
Dialogue: 0,0:16:52.39,0:16:55.35,CHS,,0,0,0,,為什麼卻愛毫無意義的憧憬著想要變強
Dialogue: 0,0:16:56.40,0:16:58.82,CHS,,0,0,0,,你很棒哦 你的力量太強大了
Dialogue: 0,0:16:58.90,0:17:00.07,CHS,,0,0,0,,讓他們知道你的厲害
Dialogue: 0,0:17:00.07,0:17:01.15,CHS,,0,0,0,,沒問題的 你可以的
Dialogue: 0,0:17:01.15,0:17:02.78,CHS,,0,0,0,,只要肯努力 你就一定能做到的
Dialogue: 0,0:17:06.41,0:17:08.12,CHS,,0,0,0,,雖然現在沒什麼事
Dialogue: 0,0:17:08.78,0:17:12.58,CHS,,0,0,0,,可若輻射能濃度繼續升高 真的會出大事的
Dialogue: 0,0:17:13.33,0:17:15.79,CHS,,0,0,0,,見鬼 真是刻不容緩啊
Dialogue: 0,0:17:16.42,0:17:18.63,CHS,,0,0,0,,必須盡快將亞瑟帶去才行
Dialogue: 0,0:17:19.04,0:17:20.75,CHS,,0,0,0,,你要帶我去哪裡 讓我去幹嘛
Dialogue: 0,0:17:20.88,0:17:23.34,CHS,,0,0,0,,我需要你成為傳奇騎士
Dialogue: 0,0:17:25.55,0:17:26.97,CHS,,0,0,0,,你說什麼?
Dialogue: 0,0:17:27.39,0:17:29.60,CHS,,0,0,0,,傳奇騎士?
Dialogue: 0,0:17:30.26,0:17:31.93,CHS,,0,0,0,,竟然是 騎士
Dialogue: 0,0:17:31.93,0:17:33.73,CHS,,0,0,0,,而且是 傳奇
Dialogue: 0,0:17:33.73,0:17:34.31,CHS,,0,0,0,,冷靜
Dialogue: 0,0:17:34.31,0:17:36.15,CHS2,,0,0,0,,危險 別鬧了
Dialogue: 0,0:17:34.60,0:17:36.52,CHS,,0,0,0,,去哪裡? 伏爾甘 我應該去哪裡?
Dialogue: 0,0:17:37.40,0:17:40.07,CHS,,0,0,0,,有個地方能讓你成為傳奇騎士
Dialogue: 0,0:17:40.07,0:17:41.07,CHS,,0,0,0,,那是在哪裡?
Dialogue: 0,0:17:41.28,0:17:42.44,CHS,,0,0,0,,快點帶我去
Dialogue: 0,0:17:47.28,0:17:49.24,CHS,,0,0,0,,嘿 很有騎士風範哦
Dialogue: 0,0:17:49.66,0:17:51.29,CHS,,0,0,0,,就是火柴盒車頂啊
Dialogue: 0,0:17:52.62,0:17:53.54,CHS,,0,0,0,,你
Dialogue: 0,0:17:54.08,0:17:58.33,CHS,,0,0,0,,不會又想跟驢子那次一樣呼嚨我吧
Dialogue: 0,0:18:01.67,0:18:03.21,CHS,,0,0,0,,說話別那麼難聽
Dialogue: 0,0:18:03.51,0:18:04.55,CHS,,0,0,0,,相信我
Dialogue: 0,0:18:06.05,0:18:08.84,CHS,,0,0,0,,艙口中心有個洞你看到了嗎?
Dialogue: 0,0:18:09.22,0:18:10.85,CHS,,0,0,0,,嗯 看到了
Dialogue: 0,0:18:11.60,0:18:14.35,CHS,,0,0,0,,把你的王者之劍插進去
Dialogue: 0,0:18:15.31,0:18:16.64,CHS,,0,0,0,,你聽說過的吧
Dialogue: 0,0:18:17.06,0:18:20.48,CHS,,0,0,0,,傳奇騎士將傳奇之劍插進洞裡的故事
Dialogue: 0,0:18:28.91,0:18:32.16,CHS,,0,0,0,,將劍插入洞裡的傳奇騎士
Dialogue: 0,0:18:32.70,0:18:34.37,CHS,,0,0,0,,那個小洞的下面有一台機器
Dialogue: 0,0:18:34.37,0:18:38.29,CHS,,0,0,0,,它能為亞瑟的王者之劍產生的電漿體施加增幅效果
Dialogue: 0,0:18:38.96,0:18:40.54,CHS,,0,0,0,,利用增幅後的電漿體
Dialogue: 0,0:18:40.67,0:18:42.75,CHS,,0,0,0,,干涉電波女的電波
Dialogue: 0,0:18:43.30,0:18:45.13,CHS,,0,0,0,,起到攔截電波的效果
Dialogue: 0,0:18:45.30,0:18:47.55,CHS,,0,0,0,,從而施展擬似EMP攻擊
Dialogue: 0,0:18:49.05,0:18:50.55,CHS,,0,0,0,,慢著 你說反了吧
Dialogue: 0,0:18:50.80,0:18:52.93,CHS,,0,0,0,,傳奇騎士應該是把劍拔出來才對
Dialogue: 0,0:18:53.43,0:18:55.43,CHS,,0,0,0,,這種無關緊要的東西倒是知道不少
Dialogue: 0,0:18:56.93,0:19:00.02,CHS,,0,0,0,,那你就插進去再拔出來嘛
Dialogue: 0,0:19:01.15,0:19:02.86,CHS,,0,0,0,,伏爾甘你在說什麼啊
Dialogue: 0,0:19:03.65,0:19:04.44,CHS,,0,0,0,,你是不是傻
Dialogue: 0,0:19:04.44,0:19:05.65,CHS,,0,0,0,,是你傻吧
Dialogue: 0,0:19:06.07,0:19:08.36,CHS,,0,0,0,,亞瑟你現在手持的是傳奇之劍
Dialogue: 0,0:19:08.57,0:19:11.28,CHS,,0,0,0,,但你還沒有拔過傳奇之劍
Dialogue: 0,0:19:11.49,0:19:15.04,CHS,,0,0,0,,所以你要先把它插進去 然後再拔出來
Dialogue: 0,0:19:15.45,0:19:17.16,CHS,,0,0,0,,難道你要錯過這次機會嗎?
Dialogue: 0,0:19:18.62,0:19:23.09,CHS,,0,0,0,,那 那不就是那個嗎?
Dialogue: 0,0:19:24.59,0:19:26.21,CHS,,0,0,0,,近在手邊的破銅爛鐵
Dialogue: 0,0:19:26.55,0:19:29.47,CHS,,0,0,0,,其實就是傳奇兵器的那種展開嗎?
Dialogue: 0,0:19:29.59,0:19:31.09,CHS,,0,0,0,,沒錯 就是這個
Dialogue: 0,0:19:32.14,0:19:33.30,CHS,,0,0,0,,破銅爛鐵
Dialogue: 0,0:19:33.64,0:19:37.02,CHS,,0,0,0,,現在的王者之劍在亞瑟腦中到底是個什麼定位啊
Dialogue: 0,0:19:37.68,0:19:40.73,CHS,,0,0,0,,亞瑟的設定要素太多 好難抓到他的點啊
Dialogue: 0,0:19:41.40,0:19:42.81,CHS,,0,0,0,,嗯嗯
Dialogue: 0,0:19:44.40,0:19:45.98,CHS,,0,0,0,,我能成為傳奇騎士嗎?
Dialogue: 0,0:19:45.98,0:19:46.69,CHS,,0,0,0,,能
Dialogue: 0,0:19:46.69,0:19:48.78,CHS,,0,0,0,,好的懂了
Dialogue: 0,0:19:48.99,0:19:50.61,CHS,,0,0,0,,還好他是個笨蛋
Dialogue: 0,0:19:55.24,0:19:57.58,CHS,,0,0,0,,EMP
Dialogue: 0,0:20:00.08,0:20:02.54,CHS,,0,0,0,,擴大
Dialogue: 0,0:20:10.63,0:20:11.84,CHS,,0,0,0,,該死的混蛋
Dialogue: 0,0:20:12.18,0:20:14.26,CHS,,0,0,0,,不會又是那個電漿男吧
Dialogue: 0,0:20:14.89,0:20:16.60,CHS,,0,0,0,,是伏爾甘和亞瑟做的
Dialogue: 0,0:20:16.97,0:20:19.22,CHS,,0,0,0,,這就是之前說的干擾電波啊
Dialogue: 0,0:20:19.68,0:20:20.81,CHS,,0,0,0,,亞羅
Dialogue: 0,0:20:22.23,0:20:24.06,CHS,,0,0,0,,我的毒電波被阻斷了
Dialogue: 0,0:20:24.40,0:20:26.02,CHS,,0,0,0,,我去揍飛那個礙事的傢伙
Dialogue: 0,0:20:26.11,0:20:28.19,CHS,,0,0,0,,讓小鬼再發一回飆
Dialogue: 0,0:20:28.65,0:20:31.36,CHS,,0,0,0,,我感覺被阻斷了反而更好
Dialogue: 0,0:20:35.45,0:20:36.41,CHS,,0,0,0,,休想得逞
Dialogue: 0,0:20:37.66,0:20:40.95,CHS,,0,0,0,,可是拜剛剛的EMP所賜 鐵梟也無法啟動了
Dialogue: 0,0:20:43.71,0:20:45.33,CHS,,0,0,0,,現在的情況我了解了
Dialogue: 0,0:20:45.71,0:20:47.84,CHS,,0,0,0,,只要阻止那個不良少女就行了吧
Dialogue: 0,0:20:48.21,0:20:49.55,CHS,,0,0,0,,你的人偶居然還能動
Dialogue: 0,0:20:50.05,0:20:52.67,CHS,,0,0,0,,因為我的主天使不是靠電力
Dialogue: 0,0:20:52.88,0:20:54.72,CHS,,0,0,0,,而是靠火焰驅動的
Dialogue: 0,0:20:57.80,0:20:58.81,CHS,,0,0,0,,在那裡
Dialogue: 0,0:21:03.14,0:21:04.10,CHS,,0,0,0,,礙事
Dialogue: 0,0:21:05.77,0:21:06.65,CHS,,0,0,0,,被發現了嗎?
Dialogue: 0,0:21:06.65,0:21:08.15,CHS,,0,0,0,,伏爾甘 我可以拔劍了吧
Dialogue: 0,0:21:08.32,0:21:09.15,CHS,,0,0,0,,還不行
Dialogue: 0,0:21:09.23,0:21:11.32,CHS,,0,0,0,,要知道你手裡的可是傳奇之劍
Dialogue: 0,0:21:11.69,0:21:13.49,CHS,,0,0,0,,不是說拔就能拔的
Dialogue: 0,0:21:13.49,0:21:15.03,CHS,,0,0,0,,這 這樣啊
Dialogue: 0,0:21:16.32,0:21:17.41,CHS,,0,0,0,,話說伏爾甘啊
Dialogue: 0,0:21:17.87,0:21:21.37,CHS,,0,0,0,,為什麼承載著聖劍的大石頭 還有個駕駛座啊
Dialogue: 0,0:21:23.87,0:21:26.71,CHS,,0,0,0,,怎麼回事 大石頭怎麼會動 這不對吧
Dialogue: 0,0:21:27.63,0:21:29.42,CHS,,0,0,0,,EMP強度正在下降
Dialogue: 0,0:21:29.67,0:21:33.51,CHS,,0,0,0,,見鬼 亞瑟騎士遊戲的效果正在減弱
Dialogue: 0,0:21:37.30,0:21:38.18,CHS,,0,0,0,,亞瑟
Dialogue: 0,0:21:38.26,0:21:39.89,CHS,,0,0,0,,承載著劍的大石頭
Dialogue: 0,0:21:40.06,0:21:41.64,CHS,,0,0,0,,其實是蛇的背部
Dialogue: 0,0:21:41.93,0:21:43.39,CHS,,0,0,0,,你可別被甩下去了
Dialogue: 0,0:21:43.77,0:21:44.73,CHS,,0,0,0,,大蛇
Dialogue: 0,0:21:44.98,0:21:45.85,CHS,,0,0,0,,沒錯
Dialogue: 0,0:21:46.10,0:21:47.15,CHS,,0,0,0,,你仔細看
Dialogue: 0,0:21:47.60,0:21:48.65,CHS,,0,0,0,,必殺
Dialogue: 0,0:21:49.02,0:21:50.41,CHS,,0,0,0,,蛇行駕駛
Dialogue: 0,0:21:55.45,0:21:57.74,CHS,,0,0,0,,剛剛好像有東西飛過去了
Dialogue: 0,0:21:58.41,0:21:59.62,CHS,,0,0,0,,沒射中
Dialogue: 0,0:22:01.20,0:22:02.49,CHS,,0,0,0,,可惡的大蛇
Dialogue: 0,0:22:03.25,0:22:06.33,CHS,,0,0,0,,你還想把我騎士王亞瑟甩下去
Dialogue: 0,0:22:06.33,0:22:08.29,CHS,,0,0,0,,我不會讓你得逞的
Dialogue: 0,0:22:08.83,0:22:11.46,CHS,,0,0,0,,聖劍不拔你能奈我何
Dialogue: 0,0:22:11.75,0:22:13.59,CHS,,0,0,0,,輻射能濃度正在上升
Dialogue: 0,0:22:14.51,0:22:15.76,CHS,,0,0,0,,森羅
Dialogue: 0,0:22:16.34,0:22:18.80,CHS,,0,0,0,,快趁現在想辦法解決啊
Dialogue: 0,0:24:03.84,0:24:07.54,CHS,,0,0,0,,被大焰人捲入其中 陷入瘋狂的哪吒
Dialogue: 0,0:24:07.70,0:24:12.04,CHS,,0,0,0,,放射線越來越強 最終迎來最大的危機
Dialogue: 0,0:24:12.12,0:24:14.71,CHS,,0,0,0,,誰能來阻止一下他啊
Dialogue: 0,0:24:14.79,0:24:16.71,CHS,,0,0,0,,笨蛋
Dialogue: 0,0:24:17.30,0:24:20.09,CHS,,0,0,0,,下集 炎炎消防隊 貳之章
Dialogue: 0,0:24:20.30,0:24:23.84,CHS,,0,0,0,,第十七話 少年啊 保持住你的弱小
Dialogue: 0,0:24:23.93,0:24:26.47,CHS,,0,0,0,,化為熊熊烈焰吧 拉托姆
Comment: 0,0:00:00.00,0:00:00.00,OPCN,,0,0,0,,====================OP====================
Dialogue: 0,0:04:21.40,0:04:26.36,OPCN,,0,0,0,,Fly & Fire 化作晴空萬里 救濟歌唱
Dialogue: 0,0:04:26.36,0:04:28.82,OPCN,,0,0,0,,昂首高歌 唱慈悲為懷
Dialogue: 0,0:04:28.99,0:04:31.33,OPCN,,0,0,0,,繼往開來 闊步向未來
Dialogue: 0,0:04:31.41,0:04:33.79,OPCN,,0,0,0,,脫胎換骨 浴火再歸來
Dialogue: 0,0:04:33.87,0:04:36.29,OPCN,,0,0,0,,四苦八苦 盡數歸塵土
Dialogue: 0,0:04:36.41,0:04:38.83,OPCN,,0,0,0,,太陽藏在陰雲後
Dialogue: 0,0:04:38.92,0:04:41.17,OPCN,,0,0,0,,風裹挾著黑暗
Dialogue: 0,0:04:42.84,0:04:46.17,OPCN,,0,0,0,,遊船別走 淒淒又戚戚
Dialogue: 0,0:04:47.93,0:04:51.64,OPCN,,0,0,0,,搖搖盪盪 夕陽未落
Dialogue: 0,0:04:51.64,0:04:56.35,OPCN,,0,0,0,,腫脹潰爛 等待是未醒的夢
Dialogue: 0,0:04:57.56,0:05:01.48,OPCN,,0,0,0,,點一盞橙燈 把天空照亮
Dialogue: 0,0:05:01.48,0:05:05.11,OPCN,,0,0,0,,啊啊 這閉塞的世界多無聊
Dialogue: 0,0:05:05.11,0:05:07.61,OPCN,,0,0,0,,讓膩味的生活迎來解放
Dialogue: 0,0:05:07.74,0:05:12.45,OPCN,,0,0,0,,管他大火還是業火 跳進去說hello
Dialogue: 0,0:05:12.49,0:05:17.66,OPCN,,0,0,0,,不見五指的車道 你已被悲傷的陰影綁架其中
Dialogue: 0,0:05:17.66,0:05:23.25,OPCN,,0,0,0,,來吧 Say Hello 站起來就往前走
Dialogue: 0,0:05:23.25,0:05:28.34,OPCN,,0,0,0,,綻放永恆光明 解放在此刻降臨
Dialogue: 0,0:05:28.34,0:05:35.76,OPCN,,0,0,0,,搖啊搖 搖啊搖 搖啊搖 火光在搖啊搖啊搖
Dialogue: 0,0:04:21.40,0:04:26.36,OPJP,,0,0,0,,Fly & Fire 帰す快晴 救済唱歌
Dialogue: 0,0:04:26.36,0:04:28.82,OPJP,,0,0,0,,あぶれだ声 慈愛を
Dialogue: 0,0:04:28.99,0:04:31.33,OPJP,,0,0,0,,はみ出したって未来を
Dialogue: 0,0:04:31.41,0:04:33.79,OPJP,,0,0,0,,グットバック 再生へ
Dialogue: 0,0:04:33.87,0:04:36.29,OPJP,,0,0,0,,四苦八苦 無い方へ
Dialogue: 0,0:04:36.41,0:04:38.83,OPJP,,0,0,0,,曇天に隠れた太陽
Dialogue: 0,0:04:38.92,0:04:41.17,OPJP,,0,0,0,,風よ闇を攫って
Dialogue: 0,0:04:42.84,0:04:46.17,OPJP,,0,0,0,,遊覧船待って 泣いて憂う
Dialogue: 0,0:04:47.93,0:04:51.64,OPJP,,0,0,0,,揺らせ まだ夕景 そう笑って
Dialogue: 0,0:04:51.64,0:04:56.35,OPJP,,0,0,0,,腫れて爛れて 待ってるがまだ夢
Dialogue: 0,0:04:57.56,0:05:01.48,OPJP,,0,0,0,,橙色のライトで空を照らせ
Dialogue: 0,0:05:01.48,0:05:05.11,OPJP,,0,0,0,,そう 閉じ込めたってつまらないぜ
Dialogue: 0,0:05:05.11,0:05:07.61,OPJP,,0,0,0,,飽きたる日々に来たる解放
Dialogue: 0,0:05:07.74,0:05:12.45,OPJP,,0,0,0,,大火でも業火でも飛び込んでハロー
Dialogue: 0,0:05:12.49,0:05:17.66,OPJP,,0,0,0,,暗い車道 悲しみの影に君が包まれても
Dialogue: 0,0:05:17.66,0:05:23.25,OPJP,,0,0,0,,さあ セイハロー 立ったのなら歩き出そう
Dialogue: 0,0:05:23.25,0:05:28.34,OPJP,,0,0,0,,輝け延々と いま訪れる解放
Dialogue: 0,0:05:28.34,0:05:35.76,OPJP,,0,0,0,,揺れる 揺れる 揺れる 火が揺れる
