Dialogue: 0,0:00:01.83,0:00:03.83,CHS,,0,0,0,,人的死因多種多樣
Dialogue: 0,0:00:04.54,0:00:05.37,CHS,,0,0,0,,老死
Dialogue: 0,0:00:05.66,0:00:06.50,CHS,,0,0,0,,自殺
Dialogue: 0,0:00:06.70,0:00:07.66,CHS,,0,0,0,,病死
Dialogue: 0,0:00:08.21,0:00:12.42,CHS,,0,0,0,,如今世界上最令世人恐懼的死因是…
Dialogue: 0,0:00:14.38,0:00:15.55,CHS,,0,0,0,,燒死
Dialogue: 0,0:00:22.47,0:00:23.93,CHS,,0,0,0,,好燙
Dialogue: 0,0:00:26.02,0:00:28.64,CHS,,0,0,0,,新門大隊長 你跑哪裡去了啊
Dialogue: 0,0:00:28.73,0:00:31.23,CHS,,0,0,0,,別說你已經把我們給忘了
Dialogue: 0,0:02:29.81,0:02:33.48,CHS,,0,0,0,,我們這次來是為了學會使出火場怪力
Dialogue: 0,0:02:33.56,0:02:35.23,CHS,,0,0,0,,新門大隊長
Dialogue: 0,0:02:35.40,0:02:37.40,CHS,,0,0,0,,這麼做的意義到底是什麼啊
Dialogue: 0,0:02:39.73,0:02:42.99,CHS,,0,0,0,,新門大隊長 這麼做有什麼意義嗎?
Dialogue: 0,0:02:43.15,0:02:44.07,CHS,,0,0,0,,鬼知道
Dialogue: 0,0:02:44.82,0:02:46.61,CHS,,0,0,0,,就當是原國式的疼愛方式吧
Dialogue: 0,0:02:47.49,0:02:49.33,CHS,,0,0,0,,所謂火場怪力
Dialogue: 0,0:02:49.66,0:02:52.41,CHS,,0,0,0,,是一種超越了自身極限的極限的力量
Dialogue: 0,0:02:53.25,0:02:56.21,CHS,,0,0,0,,所以為了讓他們超越極限的極限
Dialogue: 0,0:02:56.21,0:02:57.67,CHS,,0,0,0,,這樣做是有必要的
Dialogue: 0,0:02:58.59,0:03:01.05,CHS,,0,0,0,,我小時候 紺爐就是這樣鍛鍊我的
Dialogue: 0,0:03:17.19,0:03:19.36,CHS,,0,0,0,,既然是叫火場怪力
Dialogue: 0,0:03:19.73,0:03:20.86,CHS,,0,0,0,,身為消防員
Dialogue: 0,0:03:20.94,0:03:24.24,CHS,,0,0,0,,唯有能自如掌握這種力量才能算是獨當一面
Dialogue: 0,0:03:24.24,0:03:25.65,CHS,,0,0,0,,這樣說也不為過
Dialogue: 0,0:03:26.24,0:03:27.99,CHS,,0,0,0,,第8隊的大隊長
Dialogue: 0,0:03:28.95,0:03:31.83,CHS,,0,0,0,,他就是火場怪力的典型代表
Dialogue: 0,0:03:32.29,0:03:35.58,CHS,,0,0,0,,大概只有他那種人才配稱為消防員之楷模吧
Dialogue: 0,0:03:36.21,0:03:37.83,CHS,,0,0,0,,櫻備大隊長
Dialogue: 0,0:03:38.00,0:03:40.50,CHS,,0,0,0,,無能力者能達到那種水準的
Dialogue: 0,0:03:40.84,0:03:42.17,CHS,,0,0,0,,除了他沒別人了
Dialogue: 0,0:03:42.88,0:03:44.09,CHS,,0,0,0,,這麼做有什麼意義
Dialogue: 0,0:03:46.34,0:03:47.22,CHS,,0,0,0,,這樣搞
Dialogue: 0,0:03:47.22,0:03:47.97,CHS,,0,0,0,,啊啊
Dialogue: 0,0:03:47.97,0:03:48.76,CHS,,0,0,0,,有什麼
Dialogue: 0,0:03:48.76,0:03:49.64,CHS,,0,0,0,,啊啊
Dialogue: 0,0:03:49.64,0:03:50.39,CHS,,0,0,0,,意義
Dialogue: 0,0:03:50.39,0:03:51.26,CHS,,0,0,0,,啊啊
Dialogue: 0,0:03:51.26,0:03:52.22,CHS,,0,0,0,,這樣搞
Dialogue: 0,0:03:52.22,0:03:53.01,CHS,,0,0,0,,啊啊
Dialogue: 0,0:03:53.01,0:03:53.93,CHS,,0,0,0,,有什麼
Dialogue: 0,0:03:53.93,0:03:54.68,CHS,,0,0,0,,啊啊
Dialogue: 0,0:03:57.85,0:03:59.60,CHS,,0,0,0,,被火烤
Dialogue: 0,0:04:00.56,0:04:03.40,CHS,,0,0,0,,被貨車拖著滿城跑
Dialogue: 0,0:04:04.15,0:04:06.57,CHS,,0,0,0,,光著身子被人戳來戳去
Dialogue: 0,0:04:07.45,0:04:08.70,CHS,,0,0,0,,被甩得頭暈眼花
Dialogue: 0,0:04:09.57,0:04:10.62,CHS,,0,0,0,,這到底
Dialogue: 0,0:04:11.20,0:04:12.95,CHS,,0,0,0,,有什麼意義
Dialogue: 0,0:04:13.12,0:04:14.62,CHS,,0,0,0,,要想掌握火場怪力
Dialogue: 0,0:04:14.79,0:04:17.12,CHS,,0,0,0,,必須超越極限的極限
Dialogue: 0,0:04:17.25,0:04:18.29,CHS,,0,0,0,,是
Dialogue: 0,0:04:19.21,0:04:21.38,CHS,,0,0,0,,紺爐當初這樣對我的時候就是以此為解釋的
Dialogue: 0,0:04:21.63,0:04:22.67,CHS,,0,0,0,,所以呢
Dialogue: 0,0:04:26.76,0:04:28.97,CHS,,0,0,0,,的確 這麼做的意義到底是什麼呢
Dialogue: 0,0:04:30.22,0:04:31.93,CHS,,0,0,0,,我都沒有問過他耶
Dialogue: 0,0:04:32.26,0:04:33.05,CHS,,0,0,0,,欸欸
Dialogue: 0,0:04:35.31,0:04:36.97,CHS,,0,0,0,,好了 開練吧
Dialogue: 0,0:04:37.56,0:04:40.81,CHS,,0,0,0,,真的什麼意義也沒有嗎?
Dialogue: 0,0:04:40.85,0:04:42.15,CHS,,0,0,0,,鬼知道
Dialogue: 0,0:04:42.23,0:04:43.90,CHS,,0,0,0,,有必要這麼斤斤計較嗎?
Dialogue: 0,0:04:44.27,0:04:45.90,CHS,,0,0,0,,之前那些又算什麼
Dialogue: 0,0:04:44.27,0:04:45.90,CHS2,,0,0,0,,開什麼玩笑
Dialogue: 0,0:04:45.90,0:04:47.74,CHS,,0,0,0,,我要告你權力騷擾
Dialogue: 0,0:04:46.66,0:04:48.37,CHS2,,0,0,0,,去死吧混蛋
Dialogue: 0,0:04:47.94,0:04:50.66,CHS,,0,0,0,,疼愛的效果還挺顯著的 每一下都飽含憤怒
Dialogue: 0,0:04:51.91,0:04:52.95,CHS,,0,0,0,,不錯嘛
Dialogue: 0,0:04:53.24,0:04:55.87,CHS,,0,0,0,,每一招都帶著奪人性命的呼吸
Dialogue: 0,0:04:56.33,0:04:58.29,CHS,,0,0,0,,甚至都有殺意了 很好
Dialogue: 0,0:04:58.29,0:04:59.58,CHS,,0,0,0,,這不是廢話嗎
Dialogue: 0,0:04:59.66,0:05:01.87,CHS,,0,0,0,,這裡面全是我們的憤怒與憎恨
Dialogue: 0,0:05:07.09,0:05:08.63,CHS,,0,0,0,,沒 沒事吧
Dialogue: 0,0:05:13.14,0:05:14.30,CHS,,0,0,0,,做過火了吧
Dialogue: 0,0:05:17.68,0:05:19.60,CHS,,0,0,0,,憤怒引發憤怒
Dialogue: 0,0:05:20.18,0:05:21.52,CHS,,0,0,0,,對他人釋放殺意
Dialogue: 0,0:05:21.52,0:05:25.36,CHS,,0,0,0,,之後也必然會有殺意降臨在自己頭上
Dialogue: 0,0:05:28.44,0:05:30.95,CHS,,0,0,0,,你們都學過奪人性命的呼吸了
Dialogue: 0,0:05:31.45,0:05:32.61,CHS,,0,0,0,,自己的命
Dialogue: 0,0:05:32.91,0:05:33.99,CHS,,0,0,0,,同伴的命
Dialogue: 0,0:05:34.41,0:05:35.53,CHS,,0,0,0,,敵人的命
Dialogue: 0,0:05:36.12,0:05:38.12,CHS,,0,0,0,,也了解了生命之可貴
Dialogue: 0,0:05:41.46,0:05:43.92,CHS,,0,0,0,,但你們還是太嫩了
Dialogue: 0,0:05:45.38,0:05:47.50,CHS,,0,0,0,,邁入火場
Dialogue: 0,0:05:48.05,0:05:51.97,CHS,,0,0,0,,就意味著要投身於不動明王的業火之中
Dialogue: 0,0:05:52.80,0:05:55.22,CHS,,0,0,0,,稍有鬆懈就會喪命
Dialogue: 0,0:05:55.72,0:05:59.72,CHS,,0,0,0,,明王業火會來要你們的命
Dialogue: 0,0:06:01.06,0:06:02.85,CHS,,0,0,0,,繼奪人性命的呼吸之後
Dialogue: 0,0:06:03.39,0:06:05.40,CHS,,0,0,0,,你們要感受的是
Dialogue: 0,0:06:11.90,0:06:13.28,CHS,,0,0,0,,別發呆
Dialogue: 0,0:06:13.99,0:06:15.62,CHS,,0,0,0,,當心明王帶走你們的小命
Dialogue: 0,0:06:18.03,0:06:19.08,CHS,,0,0,0,,怎麼會?
Dialogue: 0,0:06:19.45,0:06:21.00,CHS,,0,0,0,,竟然比超人飛踢還快
Dialogue: 0,0:06:26.54,0:06:28.42,CHS,,0,0,0,,普通的踢腿和掌打就
Dialogue: 0,0:06:29.34,0:06:31.42,CHS,,0,0,0,,這就是火場怪力?
Dialogue: 0,0:06:32.22,0:06:32.84,CHS,,0,0,0,,還沒完呢
Dialogue: 0,0:06:32.84,0:06:33.67,CHS,,0,0,0,,沒完呢
Dialogue: 0,0:07:07.25,0:07:08.42,CHS,,0,0,0,,我還可以
Dialogue: 0,0:07:13.71,0:07:15.72,CHS,,0,0,0,,可 可惡
Dialogue: 0,0:07:15.93,0:07:17.55,CHS,,0,0,0,,已經打了五個小時
Dialogue: 0,0:07:17.97,0:07:20.39,CHS,,0,0,0,,體內的氧氣都耗光了
Dialogue: 0,0:07:21.39,0:07:22.97,CHS,,0,0,0,,都快失去意識了
Dialogue: 0,0:07:23.81,0:07:26.73,CHS,,0,0,0,,再繼續下去的話就要得灰病了
Dialogue: 0,0:07:27.77,0:07:29.27,CHS,,0,0,0,,到起火極限了嗎?
Dialogue: 0,0:07:32.07,0:07:35.53,CHS,,0,0,0,,新門大隊長 今天的訓練就到這裡吧
Dialogue: 0,0:07:35.57,0:07:36.65,CHS,,0,0,0,,訓練?
Dialogue: 0,0:07:36.95,0:07:39.32,CHS,,0,0,0,,我還沒開始呢
Dialogue: 0,0:07:41.41,0:07:42.33,CHS,,0,0,0,,站起來
Dialogue: 0,0:07:43.20,0:07:44.75,CHS,,0,0,0,,開始訓練了
Dialogue: 0,0:07:51.17,0:07:52.80,CHS,,0,0,0,,喂 紺爐在嗎?
Dialogue: 0,0:07:53.75,0:07:55.05,CHS,,0,0,0,,第5隊的大隊長
Dialogue: 0,0:07:55.76,0:07:58.34,CHS,,0,0,0,,你也是來讓少主鍛鍊你的嗎?
Dialogue: 0,0:07:58.55,0:07:59.76,CHS,,0,0,0,,別說傻話了
Dialogue: 0,0:07:59.97,0:08:02.89,CHS,,0,0,0,,我是研究人員 野蠻的事我不做
Dialogue: 0,0:08:03.43,0:08:06.73,CHS,,0,0,0,,你昨天提到兩年前和鬼打過
Dialogue: 0,0:08:06.73,0:08:08.39,CHS,,0,0,0,,我來問問詳細情況
Dialogue: 0,0:08:09.69,0:08:11.19,CHS,,0,0,0,,昨天提到的
Dialogue: 0,0:08:11.98,0:08:13.61,CHS,,0,0,0,,你是說分身體嗎?
Dialogue: 0,0:08:13.73,0:08:14.82,CHS,,0,0,0,,對 沒錯
Dialogue: 0,0:08:14.90,0:08:17.45,CHS,,0,0,0,,我想了解得更詳細一些
Dialogue: 0,0:08:17.95,0:08:20.16,CHS,,0,0,0,,再詳細啊
Dialogue: 0,0:08:20.87,0:08:23.62,CHS,,0,0,0,,我所知道的昨天已經全說了
Dialogue: 0,0:08:24.12,0:08:26.16,CHS,,0,0,0,,不提這個 你先進來吧
Dialogue: 0,0:08:26.66,0:08:29.50,CHS,,0,0,0,,就知道會是這個回答 所以這次要直接問你的身體
Dialogue: 0,0:08:30.75,0:08:31.88,CHS,,0,0,0,,請進吧
Dialogue: 0,0:08:32.34,0:08:33.92,CHS,,0,0,0,,還有其他人嗎?
Dialogue: 0,0:08:36.21,0:08:40.34,CHS,,0,0,0,,我是第6特殊消防隊大隊長 火代子黃
Dialogue: 0,0:08:40.93,0:08:42.76,CHS,,0,0,0,,火代子大隊長 就是她
Dialogue: 0,0:08:43.39,0:08:44.72,CHS,,0,0,0,,先從觸診開始
Dialogue: 0,0:08:45.26,0:08:46.56,CHS,,0,0,0,,這是要對我做什麼啊
Dialogue: 0,0:08:50.60,0:08:52.52,CHS,,0,0,0,,怎麼了? 快站起來
Dialogue: 0,0:08:52.90,0:08:55.11,CHS,,0,0,0,,現在才要開始訓練嗎?
Dialogue: 0,0:08:55.65,0:08:58.44,CHS,,0,0,0,,再繼續下去的話他們會得灰病的
Dialogue: 0,0:08:58.74,0:09:01.86,CHS,,0,0,0,,這次訓練為的就是讓他們超越這個極限
Dialogue: 0,0:09:02.78,0:09:03.74,CHS,,0,0,0,,給我站起來
Dialogue: 0,0:09:08.83,0:09:10.58,CHS,,0,0,0,,打從一開始
Dialogue: 0,0:09:11.54,0:09:17.34,CHS,,0,0,0,,我就…沒想著要半途而廢
Dialogue: 0,0:09:18.59,0:09:20.76,CHS,,0,0,0,,聽起來像在逞強啊
Dialogue: 0,0:09:32.44,0:09:36.02,CHS,,0,0,0,,光站著挨打跟放棄了也沒兩樣
Dialogue: 0,0:09:40.65,0:09:42.20,CHS,,0,0,0,,喂 怎麼回事?
Dialogue: 0,0:09:42.82,0:09:44.24,CHS,,0,0,0,,再不動彈可就沒命了
Dialogue: 0,0:09:45.12,0:09:46.83,CHS,,0,0,0,,敵人是不會等你恢復的
Dialogue: 0,0:09:47.37,0:09:50.12,CHS,,0,0,0,,我…知道…
Dialogue: 0,0:10:01.76,0:10:03.47,CHS,,0,0,0,,體內的氧氣耗盡
Dialogue: 0,0:10:04.39,0:10:05.93,CHS,,0,0,0,,無法呼吸了
Dialogue: 0,0:10:07.18,0:10:09.93,CHS,,0,0,0,,我感覺到自己的生命在燃燒
Dialogue: 0,0:10:12.18,0:10:15.44,CHS,,0,0,0,,意識要消失了
Dialogue: 0,0:10:23.65,0:10:24.74,CHS,,0,0,0,,火場
Dialogue: 0,0:10:27.07,0:10:28.58,CHS,,0,0,0,,明王的業火
Dialogue: 0,0:10:31.83,0:10:32.83,CHS,,0,0,0,,火場
Dialogue: 0,0:10:34.46,0:10:36.17,CHS,,0,0,0,,我在火場裡
Dialogue: 0,0:10:37.33,0:10:38.38,CHS,,0,0,0,,森羅
Dialogue: 0,0:10:41.59,0:10:42.72,CHS,,0,0,0,,森羅
Dialogue: 0,0:10:52.73,0:10:53.81,CHS,,0,0,0,,這裡是…
Dialogue: 0,0:10:55.27,0:10:56.31,CHS,,0,0,0,,我剛才…
Dialogue: 0,0:10:56.81,0:10:58.02,CHS,,0,0,0,,在淺草…
Dialogue: 0,0:11:05.53,0:11:06.57,CHS,,0,0,0,,小象
Dialogue: 0,0:11:08.03,0:11:09.08,CHS,,0,0,0,,媽媽
Dialogue: 0,0:11:11.24,0:11:12.79,CHS,,0,0,0,,不行動就會被殺掉
Dialogue: 0,0:11:14.66,0:11:16.21,CHS,,0,0,0,,不想再失去了
Dialogue: 0,0:11:17.92,0:11:19.17,CHS,,0,0,0,,寶貴的生命
Dialogue: 0,0:11:20.29,0:11:21.50,CHS,,0,0,0,,沒有第二次
Dialogue: 0,0:11:22.63,0:11:25.38,CHS,,0,0,0,,死了就無法重來
Dialogue: 0,0:11:29.51,0:11:32.22,CHS,,0,0,0,,緊張與恐懼讓身體變得僵硬
Dialogue: 0,0:11:34.02,0:11:35.39,CHS,,0,0,0,,不行動就會死
Dialogue: 0,0:11:36.31,0:11:37.39,CHS,,0,0,0,,會被殺死
Dialogue: 0,0:11:38.27,0:11:41.69,CHS,,0,0,0,,人死了 一切就都完了
Dialogue: 0,0:11:43.48,0:11:45.36,CHS,,0,0,0,,我就只是個膽小鬼嗎?
Dialogue: 0,0:11:46.90,0:11:48.61,CHS,,0,0,0,,我要一事無成地死去嗎?
Dialogue: 0,0:11:50.74,0:11:51.78,CHS,,0,0,0,,我該做什麼?
Dialogue: 0,0:11:52.83,0:11:53.99,CHS,,0,0,0,,我能做什麼?
Dialogue: 0,0:11:55.00,0:11:56.71,CHS,,0,0,0,,拚盡了一切
Dialogue: 0,0:11:57.96,0:11:59.38,CHS,,0,0,0,,卻什麼也沒留下
Dialogue: 0,0:12:00.92,0:12:02.04,CHS,,0,0,0,,這時候
Dialogue: 0,0:12:02.55,0:12:03.75,CHS,,0,0,0,,我能做什麼
Dialogue: 0,0:12:13.01,0:12:14.47,CHS,,0,0,0,,生存本能
Dialogue: 0,0:12:16.18,0:12:18.06,CHS,,0,0,0,,死亡的緊張
Dialogue: 0,0:12:18.77,0:12:20.44,CHS,,0,0,0,,帶給了我笑容
Dialogue: 0,0:12:22.82,0:12:24.73,CHS,,0,0,0,,一小撮的能量
Dialogue: 0,0:12:26.28,0:12:27.95,CHS,,0,0,0,,死亡的恐懼
Dialogue: 0,0:12:28.90,0:12:30.78,CHS,,0,0,0,,會帶給我什麼
Dialogue: 0,0:12:44.00,0:12:45.34,CHS,,0,0,0,,這火焰
Dialogue: 0,0:12:46.01,0:12:47.51,CHS,,0,0,0,,還不錯嘛
Dialogue: 0,0:13:09.45,0:13:10.95,CHS,,0,0,0,,有什麼發現嗎?
Dialogue: 0,0:13:11.57,0:13:16.33,CHS,,0,0,0,,你的火焰沒什麼特別的 跟其他能力者的一樣
Dialogue: 0,0:13:16.99,0:13:18.79,CHS,,0,0,0,,既然火焰本身不存在特殊性
Dialogue: 0,0:13:19.08,0:13:21.79,CHS,,0,0,0,,那麼促成安德拉連接的 應該另有契機
Dialogue: 0,0:13:23.33,0:13:26.59,CHS,,0,0,0,,紺爐中隊長和第4隊的海牙大隊長
Dialogue: 0,0:13:27.38,0:13:30.26,CHS,,0,0,0,,都是在大火災時出現的安德拉連接
Dialogue: 0,0:13:31.51,0:13:32.84,CHS,,0,0,0,,熊熊燃燒的大火
Dialogue: 0,0:13:33.39,0:13:34.89,CHS,,0,0,0,,無數人的喪生
Dialogue: 0,0:13:35.80,0:13:38.31,CHS,,0,0,0,,契機是否就藏在這裡面呢?
Dialogue: 0,0:13:39.23,0:13:40.35,CHS,,0,0,0,,火代子大隊長
Dialogue: 0,0:13:40.85,0:13:44.23,CHS,,0,0,0,,你剛才說他的火焰跟一般人的沒兩樣
Dialogue: 0,0:13:44.48,0:13:46.19,CHS,,0,0,0,,就你觸碰到的印象看來
Dialogue: 0,0:13:46.36,0:13:49.99,CHS,,0,0,0,,安德拉爆炎和普通火焰有什麼區別嗎?
Dialogue: 0,0:14:02.33,0:14:03.46,CHS,,0,0,0,,有什麼問題嗎?
Dialogue: 0,0:14:03.54,0:14:05.29,CHS,,0,0,0,,不 沒什麼
Dialogue: 0,0:14:06.38,0:14:08.88,CHS,,0,0,0,,去問問其他經歷過安德拉連接的人吧
Dialogue: 0,0:14:09.63,0:14:12.88,CHS,,0,0,0,,海牙大隊長應該也是留下了聖痕的人之一
Dialogue: 0,0:14:13.43,0:14:15.26,CHS,,0,0,0,,問問他或許會有什麼收穫
Dialogue: 0,0:14:16.14,0:14:19.27,CHS,,0,0,0,,身負聖痕的我遭到了白衣人的襲擊
Dialogue: 0,0:14:20.02,0:14:21.93,CHS,,0,0,0,,那位大隊長不會有什麼事嗎?
Dialogue: 0,0:14:22.35,0:14:23.35,CHS,,0,0,0,,抓緊時間吧
Dialogue: 0,0:14:32.07,0:14:35.11,CHS,,0,0,0,,真好 太好了
Dialogue: 0,0:14:36.70,0:14:38.87,CHS,,0,0,0,,閣下是位高手啊
Dialogue: 0,0:14:39.87,0:14:41.29,CHS,,0,0,0,,不知閣下是什麼人
Dialogue: 0,0:14:41.50,0:14:44.67,CHS,,0,0,0,,看起來像是白衣人的同黨
Dialogue: 0,0:14:44.67,0:14:46.54,CHS,,0,0,0,,擁有聖痕之人啊
Dialogue: 0,0:14:47.13,0:14:48.71,CHS,,0,0,0,,我來接你了
Dialogue: 0,0:14:51.21,0:14:53.22,CHS,,0,0,0,,黃金手
Dialogue: 0,0:15:00.01,0:15:02.77,CHS,,0,0,0,,什麼時候…繞到我背後…
Dialogue: 0,0:15:03.35,0:15:05.73,CHS,,0,0,0,,你背後什麼也沒有
Dialogue: 0,0:15:07.35,0:15:09.19,CHS,,0,0,0,,並非只有守護人
Dialogue: 0,0:15:09.48,0:15:11.11,CHS,,0,0,0,,才是傳教者的矛
Dialogue: 0,0:15:11.98,0:15:13.15,CHS,,0,0,0,,你到底…
Dialogue: 0,0:15:14.65,0:15:16.03,CHS,,0,0,0,,是什麼人?
Dialogue: 0,0:15:18.03,0:15:19.53,CHS,,0,0,0,,屠殺人
Dialogue: 0,0:15:24.33,0:15:29.17,CHS,,0,0,0,,身為消防官 其使命便是守護人命與財產
Dialogue: 0,0:15:30.25,0:15:34.47,CHS,,0,0,0,,可最重要的還是自己的命
Dialogue: 0,0:15:34.97,0:15:39.35,CHS,,0,0,0,,自己的命都沒了 那能救的人也救不了了
Dialogue: 0,0:15:41.10,0:15:42.31,CHS,,0,0,0,,拉托姆
Dialogue: 0,0:15:42.64,0:15:43.68,CHS,,0,0,0,,拉托姆
Dialogue: 0,0:15:47.77,0:15:49.81,CHS,,0,0,0,,看著部下死去真讓人不好受啊
Dialogue: 0,0:15:51.27,0:15:52.32,CHS,,0,0,0,,帕恩
Dialogue: 0,0:15:52.90,0:15:54.69,CHS,,0,0,0,,切記不論何時都要保持冷靜
Dialogue: 0,0:15:55.28,0:15:57.15,CHS,,0,0,0,,謹慎行事
Dialogue: 0,0:15:58.11,0:16:00.95,CHS,,0,0,0,,在現場要懂得珍惜自己的生命
Dialogue: 0,0:16:02.33,0:16:04.54,CHS,,0,0,0,,我們不是什麼英雄
Dialogue: 0,0:16:05.12,0:16:08.54,CHS,,0,0,0,,我們也跟受災者一樣都是人
Dialogue: 0,0:16:10.08,0:16:12.29,CHS,,0,0,0,,您對英雄心懷憧憬嗎?
Dialogue: 0,0:16:12.50,0:16:13.80,CHS,,0,0,0,,好問題
Dialogue: 0,0:16:15.46,0:16:20.01,CHS,,0,0,0,,若真有那種超越人類智慧的生物就好了
Dialogue: 0,0:16:34.86,0:16:36.49,CHS,,0,0,0,,幫我把人抬下來
Dialogue: 0,0:16:36.61,0:16:37.40,CHS,,0,0,0,,是
Dialogue: 0,0:16:47.29,0:16:49.33,CHS,,0,0,0,,看起來沒有打鬥痕跡啊
Dialogue: 0,0:16:50.12,0:16:53.25,CHS,,0,0,0,,海牙大隊長會不會是自殺的呢?
Dialogue: 0,0:16:53.42,0:16:54.75,CHS,,0,0,0,,海牙大隊長
Dialogue: 0,0:16:55.21,0:16:58.46,CHS,,0,0,0,,自兩年前的那場大火災之後就變得有些神經質
Dialogue: 0,0:16:59.17,0:17:00.22,CHS,,0,0,0,,但是
Dialogue: 0,0:17:00.68,0:17:02.68,CHS,,0,0,0,,他不是那種會自殺的人
Dialogue: 0,0:17:03.26,0:17:04.47,CHS,,0,0,0,,這麼說
Dialogue: 0,0:17:04.56,0:17:06.22,CHS,,0,0,0,,像海牙大隊長這等人物
Dialogue: 0,0:17:06.47,0:17:09.06,CHS,,0,0,0,,連反擊的機會都沒有便被人殺害了
Dialogue: 0,0:17:10.35,0:17:12.23,CHS,,0,0,0,,這敵人相當恐怖
Dialogue: 0,0:17:16.40,0:17:18.11,CHS,,0,0,0,,靜靜地燃燒著
Dialogue: 0,0:17:19.15,0:17:21.32,CHS,,0,0,0,,但又非常灼熱
Dialogue: 0,0:17:22.45,0:17:24.03,CHS,,0,0,0,,他就快掌握了
Dialogue: 0,0:17:33.96,0:17:35.34,CHS,,0,0,0,,海牙大隊長
Dialogue: 0,0:17:36.80,0:17:37.92,CHS,,0,0,0,,安德拉連接
Dialogue: 0,0:17:47.47,0:17:48.68,CHS,,0,0,0,,還不能…還不能…
Dialogue: 0,0:17:48.75,0:17:53.56,CHS,,0,0,0,,不能…不能…不能…
Dialogue: 0,0:17:54.23,0:17:56.23,CHS,,0,0,0,,這就是死亡嗎?
Dialogue: 0,0:17:56.82,0:17:58.53,CHS,,0,0,0,,火場怪力
Dialogue: 0,0:17:59.61,0:18:00.78,CHS,,0,0,0,,我還不能
Dialogue: 0,0:18:01.20,0:18:03.03,CHS,,0,0,0,,還不能死在這裡
Dialogue: 0,0:18:11.54,0:18:14.21,CHS,,0,0,0,,新門大隊長 這就是
Dialogue: 0,0:18:14.64,0:18:15.21,CHS,,0,0,0,,對
Dialogue: 0,0:18:16.08,0:18:18.46,CHS,,0,0,0,,這就是超越極限中的極限 淬鍊出的火焰
Dialogue: 0,0:18:19.71,0:18:20.76,CHS,,0,0,0,,還在練啊
Dialogue: 0,0:18:21.67,0:18:25.47,CHS,,0,0,0,,很好 你們兩個都做得不錯
Dialogue: 0,0:18:31.77,0:18:34.44,CHS,,0,0,0,,你們要做到隨時都能進入剛剛那種狀態
Dialogue: 0,0:18:34.73,0:18:38.36,CHS,,0,0,0,,我剛剛 做了什麼?
Dialogue: 0,0:18:39.15,0:18:42.24,CHS,,0,0,0,,第一天就有這樣的成果 看來訓練很順利嘛
Dialogue: 0,0:18:43.40,0:18:44.53,CHS,,0,0,0,,怎麼了? 森羅
Dialogue: 0,0:18:45.78,0:18:48.16,CHS,,0,0,0,,那就是死亡的壓力
Dialogue: 0,0:18:54.25,0:18:56.42,CHS,,0,0,0,,海牙大隊長死了?
Dialogue: 0,0:19:14.60,0:19:16.10,CHS,,0,0,0,,海牙大隊長之死
Dialogue: 0,0:19:16.69,0:19:18.11,CHS,,0,0,0,,鑑於本人有抖M體質
Dialogue: 0,0:19:18.44,0:19:20.52,CHS,,0,0,0,,最終以自殺結案
Dialogue: 0,0:19:21.86,0:19:25.65,CHS,,0,0,0,,但他全身被鐵樁刺穿
Dialogue: 0,0:19:26.24,0:19:29.12,CHS,,0,0,0,,其死狀之慘 實在不像是自殺
Dialogue: 0,0:19:34.45,0:19:35.66,CHS,,0,0,0,,好了
Dialogue: 0,0:19:38.29,0:19:40.92,CHS,,0,0,0,,少主 第4隊的海牙他
Dialogue: 0,0:19:41.25,0:19:44.30,CHS,,0,0,0,,白衣人可能還會來我們這裡
Dialogue: 0,0:19:45.88,0:19:46.80,CHS,,0,0,0,,紺爐
Dialogue: 0,0:19:47.34,0:19:49.51,CHS,,0,0,0,,你可別瞞著我擅自行動
Dialogue: 0,0:19:49.89,0:19:51.81,CHS,,0,0,0,,森羅他們說了
Dialogue: 0,0:19:52.64,0:19:55.27,CHS,,0,0,0,,皇國現在需要團結一心
Dialogue: 0,0:19:56.77,0:19:59.69,CHS,,0,0,0,,要是對淺草和第8隊有利
Dialogue: 0,0:20:00.06,0:20:01.52,CHS,,0,0,0,,那我就沒意見
Dialogue: 0,0:20:02.98,0:20:08.32,CHS,,0,0,0,,火焰乃靈魂之吐息 黑煙乃靈魂之解放
Dialogue: 0,0:20:09.91,0:20:13.49,CHS,,0,0,0,,灰燼歸於灰燼 靈魂啊
Dialogue: 0,0:20:14.12,0:20:17.75,CHS,,0,0,0,,化為熊熊烈焰吧 拉托姆
Dialogue: 0,0:20:21.21,0:20:24.38,CHS,,0,0,0,,據說海牙大隊長他殉職過世了
Dialogue: 0,0:20:24.63,0:20:28.01,CHS,,0,0,0,,身負聖痕的班茲大隊長也請務必小心
Dialogue: 0,0:20:28.76,0:20:31.05,CHS,,0,0,0,,我認為該考慮找個護衛了
Dialogue: 0,0:20:33.85,0:20:37.77,CHS,,0,0,0,,這是神給予我們的試煉
Dialogue: 0,0:20:38.81,0:20:41.31,CHS,,0,0,0,,那麼我們第1隊
Dialogue: 0,0:20:41.65,0:20:45.19,CHS,,0,0,0,,必須當好聖陽教徒的楷模
Dialogue: 0,0:20:46.07,0:20:48.70,CHS,,0,0,0,,絕不能被恐怖分子所打敗
Dialogue: 0,0:20:49.28,0:20:52.95,CHS,,0,0,0,,我們要以身作則 將這種態度傳達給大家
Dialogue: 0,0:20:54.33,0:20:56.95,CHS,,0,0,0,,聖陽之火與我等同在
Dialogue: 0,0:20:57.25,0:20:58.75,CHS,,0,0,0,,化為神之劍
Dialogue: 0,0:20:59.16,0:21:00.58,CHS,,0,0,0,,破除黑暗
Dialogue: 0,0:21:11.09,0:21:15.06,CHS,,0,0,0,,走吧 是時候收復這個國家了
Dialogue: 0,0:21:15.85,0:21:17.97,CHS,,0,0,0,,好久沒看到外面的天空了 感覺如何?
Dialogue: 0,0:21:20.39,0:21:21.31,CHS,,0,0,0,,嗯
Dialogue: 0,0:21:26.07,0:21:27.94,CHS,,0,0,0,,終於要開始了
Dialogue: 0,0:21:28.57,0:21:30.53,CHS,,0,0,0,,人類的新時代
Dialogue: 0,0:21:35.58,0:21:37.66,CHS,,0,0,0,,森羅 亞瑟 環
Dialogue: 0,0:21:38.41,0:21:41.00,CHS,,0,0,0,,看來在淺草進行的修行很順利嘛
Dialogue: 0,0:21:41.37,0:21:42.71,CHS,,0,0,0,,你們三個做得很好
Dialogue: 0,0:21:42.92,0:21:44.17,CHS,,0,0,0,,謝謝大隊長的誇獎
Dialogue: 0,0:21:44.84,0:21:47.59,CHS,,0,0,0,,另外在至今的作戰行動裡
Dialogue: 0,0:21:47.92,0:21:51.72,CHS,,0,0,0,,我們與各特殊消防隊建立起了互助關係
Dialogue: 0,0:21:52.22,0:21:53.76,CHS,,0,0,0,,藉由哪吒孫一事
Dialogue: 0,0:21:54.09,0:21:57.26,CHS,,0,0,0,,我們與灰島重工也統一了目標
Dialogue: 0,0:21:57.76,0:21:58.81,CHS,,0,0,0,,是啊
Dialogue: 0,0:21:59.14,0:22:01.48,CHS,,0,0,0,,第8隊最初還是單打獨鬥
Dialogue: 0,0:22:02.19,0:22:03.23,CHS,,0,0,0,,可不知不覺間
Dialogue: 0,0:22:03.81,0:22:05.65,CHS,,0,0,0,,我們已經多了這麼多的同伴
Dialogue: 2,0:22:32.05,0:22:33.22,CHS,,0,0,0,,敵人很強大
Dialogue: 2,0:22:33.68,0:22:35.01,CHS,,0,0,0,,謎團還有很多沒解開
Dialogue: 2,0:22:35.51,0:22:40.18,CHS,,0,0,0,,但我們有可以信賴的同伴和可靠的協助者
Dialogue: 2,0:22:42.89,0:22:47.52,CHS,,0,0,0,,現在正是我們凝聚所有力量剿滅白衣人之時
Dialogue: 2,0:22:49.73,0:22:51.44,CHS,,0,0,0,,等著瞧吧 傳教者
Dialogue: 2,0:22:52.03,0:22:53.49,CHS,,0,0,0,,我要揍飛你
Dialogue: 2,0:22:53.78,0:22:55.49,CHS,,0,0,0,,守衛東京皇國
Dialogue: 2,0:22:56.49,0:22:58.33,CHS,,0,0,0,,為此 我們
Dialogue: 2,0:23:00.20,0:23:03.50,CHS,,0,0,0,,特殊消防隊會團結一心
Dialogue: 0,0:23:51.25,0:23:52.34,CHS,,0,0,0,,看到了
Dialogue: 0,0:23:53.05,0:23:54.55,CHS,,0,0,0,,湧進來了
Dialogue: 0,0:23:55.51,0:23:58.22,CHS,,0,0,0,,全新的太陽世界
Dialogue: 0,0:23:59.84,0:24:04.60,CHS,,0,0,0,,皇國會變成它原本該有的樣子
Comment: 0,0:00:00.00,0:00:00.00,OPCN,,0,0,0,,====================OP====================
Dialogue: 0,0:00:59.40,0:01:04.36,OPCN,,0,0,0,,Fly & Fire 化作晴空萬里 救濟歌唱
Dialogue: 0,0:01:04.36,0:01:06.82,OPCN,,0,0,0,,昂首高歌 唱慈悲為懷
Dialogue: 0,0:01:06.99,0:01:09.33,OPCN,,0,0,0,,繼往開來 闊步向未來
Dialogue: 0,0:01:09.41,0:01:11.79,OPCN,,0,0,0,,脫胎換骨 浴火再歸來
Dialogue: 0,0:01:11.87,0:01:14.29,OPCN,,0,0,0,,四苦八苦 盡數歸塵土
Dialogue: 0,0:01:14.41,0:01:16.83,OPCN,,0,0,0,,太陽藏在陰雲後
Dialogue: 0,0:01:16.92,0:01:19.17,OPCN,,0,0,0,,風裹挾著黑暗
Dialogue: 0,0:01:20.84,0:01:24.17,OPCN,,0,0,0,,遊船別走 淒淒又戚戚
Dialogue: 0,0:01:25.93,0:01:29.64,OPCN,,0,0,0,,搖搖盪盪 夕陽未落
Dialogue: 0,0:01:29.64,0:01:34.35,OPCN,,0,0,0,,腫脹潰爛 等待是未醒的夢
Dialogue: 0,0:01:35.56,0:01:39.48,OPCN,,0,0,0,,點一盞橙燈 把天空照亮
Dialogue: 0,0:01:39.48,0:01:43.11,OPCN,,0,0,0,,啊啊 這閉塞的世界多無聊
Dialogue: 0,0:01:43.11,0:01:45.61,OPCN,,0,0,0,,讓膩味的生活迎來解放
Dialogue: 0,0:01:45.74,0:01:50.45,OPCN,,0,0,0,,管他大火還是業火 跳進去說hello
Dialogue: 0,0:01:50.49,0:01:55.66,OPCN,,0,0,0,,不見五指的車道 你已被悲傷的陰影綁架其中
Dialogue: 0,0:01:55.66,0:02:01.25,OPCN,,0,0,0,,來吧 Say Hello 站起來就往前走
Dialogue: 0,0:02:01.25,0:02:06.34,OPCN,,0,0,0,,綻放永恆光明 解放在此刻降臨
Dialogue: 0,0:02:06.34,0:02:13.76,OPCN,,0,0,0,,搖啊搖 搖啊搖 搖啊搖 火光在搖啊搖啊搖
Dialogue: 0,0:00:59.40,0:01:04.36,OPJP,,0,0,0,,Fly & Fire 帰す快晴 救済唱歌
Dialogue: 0,0:01:04.36,0:01:06.82,OPJP,,0,0,0,,あぶれだ声 慈愛を
Dialogue: 0,0:01:06.99,0:01:09.33,OPJP,,0,0,0,,はみ出したって未来を
Dialogue: 0,0:01:09.41,0:01:11.79,OPJP,,0,0,0,,グットバック 再生へ
Dialogue: 0,0:01:11.87,0:01:14.29,OPJP,,0,0,0,,四苦八苦 無い方へ
Dialogue: 0,0:01:14.41,0:01:16.83,OPJP,,0,0,0,,曇天に隠れた太陽
Dialogue: 0,0:01:16.92,0:01:19.17,OPJP,,0,0,0,,風よ闇を攫って
Dialogue: 0,0:01:20.84,0:01:24.17,OPJP,,0,0,0,,遊覧船待って 泣いて憂う
Dialogue: 0,0:01:25.93,0:01:29.64,OPJP,,0,0,0,,揺らせ まだ夕景 そう笑って
Dialogue: 0,0:01:29.64,0:01:34.35,OPJP,,0,0,0,,腫れて爛れて 待ってるがまだ夢
Dialogue: 0,0:01:35.56,0:01:39.48,OPJP,,0,0,0,,橙色のライトで空を照らせ
Dialogue: 0,0:01:39.48,0:01:43.11,OPJP,,0,0,0,,そう 閉じ込めたってつまらないぜ
Dialogue: 0,0:01:43.11,0:01:45.61,OPJP,,0,0,0,,飽きたる日々に来たる解放
Dialogue: 0,0:01:45.74,0:01:50.45,OPJP,,0,0,0,,大火でも業火でも飛び込んでハロー
Dialogue: 0,0:01:50.49,0:01:55.66,OPJP,,0,0,0,,暗い車道 悲しみの影に君が包まれても
Dialogue: 0,0:01:55.66,0:02:01.25,OPJP,,0,0,0,,さあ セイハロー 立ったのなら歩き出そう
Dialogue: 0,0:02:01.25,0:02:06.34,OPJP,,0,0,0,,輝け延々と いま訪れる解放
Dialogue: 0,0:02:06.34,0:02:13.76,OPJP,,0,0,0,,揺れる 揺れる 揺れる 火が揺れる
