Dialogue: 0,0:00:00.41,0:00:01.58,CHS,,0,0,0,,嗯嗯
Dialogue: 0,0:00:02.25,0:00:04.29,CHS,,0,0,0,,好的懂了
Dialogue: 0,0:00:04.79,0:00:06.20,CHS,,0,0,0,,還好他是個笨蛋
Dialogue: 0,0:00:07.70,0:00:08.79,CHS,,0,0,0,,可惡的大蛇
Dialogue: 0,0:02:06.95,0:02:08.08,CHS,,0,0,0,,我保護你
Dialogue: 0,0:02:08.37,0:02:09.54,CHS,,0,0,0,,上吧 火鼠
Dialogue: 0,0:02:17.29,0:02:18.04,CHS,,0,0,0,,看招
Dialogue: 0,0:02:18.16,0:02:20.79,CHS,,0,0,0,,森羅騎士飛踢
Dialogue: 0,0:02:23.20,0:02:24.70,CHS,,0,0,0,,可惡 怎麼這麼硬啊
Dialogue: 0,0:02:27.95,0:02:29.12,CHS,,0,0,0,,別過來
Dialogue: 0,0:02:30.87,0:02:32.70,CHS,,0,0,0,,放射性崩壞沒有停止
Dialogue: 0,0:02:33.29,0:02:35.25,CHS,,0,0,0,,輻射能濃度依然在上升
Dialogue: 0,0:02:35.45,0:02:37.37,CHS,,0,0,0,,再這樣下去就糟了 森羅
Dialogue: 0,0:02:37.95,0:02:39.16,CHS,,0,0,0,,冷靜點 哪吒
Dialogue: 0,0:02:41.29,0:02:43.70,CHS,,0,0,0,,不要再對我有所期待了
Dialogue: 0,0:02:46.91,0:02:48.70,CHS,,0,0,0,,放過我吧
Dialogue: 0,0:02:51.83,0:02:53.00,CHS,,0,0,0,,又是一百分
Dialogue: 0,0:02:53.33,0:02:54.75,CHS,,0,0,0,,小吒真了不起
Dialogue: 0,0:02:55.00,0:02:56.25,CHS,,0,0,0,,總是這麼用功
Dialogue: 0,0:02:57.04,0:02:58.45,CHS,,0,0,0,,小吒你會像你爸爸那樣
Dialogue: 0,0:02:58.62,0:03:00.62,CHS,,0,0,0,,成為一名了不起的醫生的
Dialogue: 0,0:03:01.12,0:03:02.37,CHS,,0,0,0,,相信你一定可以的
Dialogue: 0,0:03:02.70,0:03:04.04,CHS,,0,0,0,,媽媽期待著那一天
Dialogue: 0,0:03:04.95,0:03:06.25,CHS,,0,0,0,,不是的 媽媽
Dialogue: 0,0:03:07.12,0:03:09.00,CHS,,0,0,0,,我只是為了回應你的期許
Dialogue: 0,0:03:09.75,0:03:13.12,CHS,,0,0,0,,畢竟我一次沒考好你就
Dialogue: 0,0:03:16.08,0:03:18.25,CHS,,0,0,0,,我該怎麼向你爸爸交代啊
Dialogue: 0,0:03:18.66,0:03:20.75,CHS,,0,0,0,,都怪你沒教好哪吒
Dialogue: 0,0:03:21.08,0:03:22.66,CHS,,0,0,0,,對不起 媽媽
Dialogue: 0,0:03:23.50,0:03:25.29,CHS,,0,0,0,,下回我一定努力考好
Dialogue: 0,0:03:26.25,0:03:27.20,CHS,,0,0,0,,所以
Dialogue: 0,0:03:28.25,0:03:29.16,CHS,,0,0,0,,怎麼會?
Dialogue: 0,0:03:29.62,0:03:31.75,CHS,,0,0,0,,哪吒竟然成第三代能力者了
Dialogue: 0,0:03:32.66,0:03:34.66,CHS,,0,0,0,,要被帶去灰島接受保護
Dialogue: 0,0:03:35.50,0:03:37.70,CHS,,0,0,0,,小吒你肯定很快就能回來的
Dialogue: 0,0:03:38.33,0:03:40.54,CHS,,0,0,0,,你怎麼可能會連火焰都控制不了呢
Dialogue: 0,0:03:41.29,0:03:43.75,CHS,,0,0,0,,媽媽說的對吧 你能做到的吧
Dialogue: 0,0:03:45.25,0:03:46.16,CHS,,0,0,0,,我會的
Dialogue: 0,0:03:47.12,0:03:48.16,CHS,,0,0,0,,你能辦得到吧
Dialogue: 0,0:03:48.83,0:03:49.87,CHS,,0,0,0,,能
Dialogue: 0,0:03:51.50,0:03:53.12,CHS,,0,0,0,,那就開始實驗吧
Dialogue: 0,0:03:55.12,0:03:57.00,CHS,,0,0,0,,今天的資料可要漂亮點哦
Dialogue: 0,0:03:58.25,0:03:59.41,CHS,,0,0,0,,你能辦得到吧
Dialogue: 0,0:04:00.45,0:04:01.33,CHS,,0,0,0,,能
Dialogue: 0,0:04:01.83,0:04:06.29,CHS,,0,0,0,,能能能能能
Dialogue: 0,0:04:08.20,0:04:10.83,CHS,,0,0,0,,今天還是跟死神叔叔做測試
Dialogue: 0,0:04:12.00,0:04:13.75,CHS,,0,0,0,,雖然有喪命的風險
Dialogue: 0,0:04:14.04,0:04:15.08,CHS,,0,0,0,,不過你可以的吧
Dialogue: 0,0:04:16.12,0:04:18.12,CHS,,0,0,0,,我可以 我可以
Dialogue: 0,0:04:18.41,0:04:20.33,CHS,,0,0,0,,包在我身上 我的話
Dialogue: 0,0:04:20.45,0:04:21.33,CHS,,0,0,0,,可以
Dialogue: 0,0:04:22.62,0:04:23.62,CHS,,0,0,0,,我必須做到
Dialogue: 0,0:04:24.08,0:04:25.41,CHS,,0,0,0,,我必須聰明
Dialogue: 0,0:04:25.83,0:04:27.12,CHS,,0,0,0,,我必須變強
Dialogue: 0,0:04:27.75,0:04:28.70,CHS,,0,0,0,,哪吒
Dialogue: 0,0:04:32.37,0:04:34.20,CHS,,0,0,0,,怎麼回事? 你做了什麼?
Dialogue: 0,0:04:34.95,0:04:36.12,CHS,,0,0,0,,剛才的感覺是
Dialogue: 0,0:04:36.62,0:04:37.87,CHS,,0,0,0,,哪吒你冷靜一下
Dialogue: 0,0:04:38.08,0:04:38.95,CHS,,0,0,0,,先聽我說
Dialogue: 0,0:04:38.95,0:04:39.79,CHS,,0,0,0,,住手
Dialogue: 0,0:04:39.87,0:04:41.45,CHS,,0,0,0,,不許窺探我的內心
Dialogue: 0,0:04:42.41,0:04:44.12,CHS,,0,0,0,,不要屈服於火焰的力量
Dialogue: 0,0:04:44.54,0:04:46.29,CHS,,0,0,0,,別怕 你是個堅強的孩子
Dialogue: 0,0:04:46.29,0:04:47.58,CHS,,0,0,0,,對 你說的沒錯
Dialogue: 0,0:04:47.75,0:04:49.41,CHS,,0,0,0,,所以我要做給你們看
Dialogue: 0,0:04:49.45,0:04:50.95,CHS,,0,0,0,,我可以
Dialogue: 0,0:04:51.08,0:04:52.41,CHS,,0,0,0,,我可以
Dialogue: 0,0:04:53.08,0:04:54.58,CHS,,0,0,0,,輻射能濃度急劇上升
Dialogue: 0,0:04:54.75,0:04:55.50,CHS,,0,0,0,,危險
Dialogue: 0,0:04:55.62,0:04:56.70,CHS,,0,0,0,,立刻撤離
Dialogue: 0,0:04:57.29,0:04:58.70,CHS,,0,0,0,,不是吧喂
Dialogue: 0,0:04:59.66,0:05:01.29,CHS,,0,0,0,,這股能量也太驚人了
Dialogue: 0,0:05:01.66,0:05:02.79,CHS,,0,0,0,,不開玩笑
Dialogue: 0,0:05:08.62,0:05:10.41,CHS,,0,0,0,,我用預知能力看到了
Dialogue: 0,0:05:10.75,0:05:12.37,CHS,,0,0,0,,如果那道熱線直接爆炸
Dialogue: 0,0:05:12.62,0:05:15.29,CHS,,0,0,0,,能轟個直徑500km的大坑出來
Dialogue: 0,0:05:15.41,0:05:17.79,CHS,,0,0,0,,那我們豈不是也無處可逃了
Dialogue: 0,0:05:21.20,0:05:21.95,CHS,,0,0,0,,修女
Dialogue: 0,0:05:22.08,0:05:23.12,CHS,,0,0,0,,你躲到裡面去
Dialogue: 0,0:05:23.33,0:05:24.20,CHS,,0,0,0,,好
Dialogue: 0,0:05:25.00,0:05:26.66,CHS,,0,0,0,,不 沒用的
Dialogue: 0,0:05:27.12,0:05:28.95,CHS,,0,0,0,,不管躲到哪裡都一樣
Dialogue: 0,0:05:29.54,0:05:30.70,CHS,,0,0,0,,快找地方避難
Dialogue: 0,0:05:36.87,0:05:38.91,CHS,,0,0,0,,這是能躲到哪裡去啊
Dialogue: 0,0:05:43.29,0:05:44.16,CHS,,0,0,0,,我可以
Dialogue: 0,0:05:44.29,0:05:45.08,CHS,,0,0,0,,我可以
Dialogue: 0,0:05:45.33,0:05:46.45,CHS,,0,0,0,,我要做給你們看
Dialogue: 0,0:05:49.20,0:05:50.12,CHS,,0,0,0,,快停下
Dialogue: 0,0:05:50.12,0:05:50.95,CHS,,0,0,0,,我可以
Dialogue: 0,0:05:51.16,0:05:52.08,CHS,,0,0,0,,我可以
Dialogue: 0,0:05:52.33,0:05:54.20,CHS,,0,0,0,,我有這個能力
Dialogue: 0,0:05:54.54,0:05:57.00,CHS,,0,0,0,,炸毀一座城
Dialogue: 0,0:05:57.16,0:05:58.45,CHS,,0,0,0,,也是小事一樁
Dialogue: 0,0:05:58.87,0:06:00.33,CHS,,0,0,0,,笨蛋
Dialogue: 0,0:06:04.16,0:06:05.12,CHS,,0,0,0,,無計可施啊
Dialogue: 0,0:06:09.29,0:06:11.00,CHS,,0,0,0,,我是守護人
Dialogue: 0,0:06:11.20,0:06:11.91,CHS,,0,0,0,,卡戎
Dialogue: 0,0:06:15.91,0:06:20.33,CHS,,0,0,0,,妊神星 因果 森羅還有哪吒
Dialogue: 0,0:06:20.70,0:06:23.08,CHS,,0,0,0,,一個也不能死
Dialogue: 0,0:06:24.79,0:06:25.70,CHS,,0,0,0,,這個人
Dialogue: 0,0:06:26.04,0:06:28.12,CHS,,0,0,0,,讓你見識見識我卡戎的
Dialogue: 0,0:06:28.54,0:06:31.08,CHS,,0,0,0,,反射力
Dialogue: 0,0:06:39.70,0:06:41.37,CHS,,0,0,0,,果然有趣
Dialogue: 0,0:06:47.79,0:06:50.04,CHS,,0,0,0,,我是不是玩過火了呀
Dialogue: 0,0:06:50.70,0:06:54.08,CHS,,0,0,0,,不過柱跟守護人就要相互扶持嘛
Dialogue: 0,0:06:54.58,0:06:57.37,CHS,,0,0,0,,加油幫我收拾殘局吧 卡戎
Dialogue: 0,0:07:09.79,0:07:11.00,CHS,,0,0,0,,我說妊神星
Dialogue: 0,0:07:11.29,0:07:13.79,CHS,,0,0,0,,算我求你了 偶爾也聽我的一回吧
Dialogue: 0,0:07:14.00,0:07:16.66,CHS,,0,0,0,,煩死了煩死了 你真的煩死人了
Dialogue: 0,0:07:17.16,0:07:19.12,CHS,,0,0,0,,還有卡戎 你這傢伙
Dialogue: 0,0:07:19.25,0:07:22.41,CHS,,0,0,0,,你腦子裡在想什麼我一清二楚
Dialogue: 0,0:07:23.00,0:07:25.54,CHS,,0,0,0,,別時時刻刻老想著我
Dialogue: 0,0:07:25.62,0:07:26.54,CHS,,0,0,0,,好痛
Dialogue: 0,0:07:27.79,0:07:30.33,CHS,,0,0,0,,可惡 連跑馬燈都來了
Dialogue: 0,0:07:30.83,0:07:33.41,CHS,,0,0,0,,都這時候了竟然還在想妊神星
Dialogue: 0,0:07:34.16,0:07:37.12,CHS,,0,0,0,,我這個守護人當的也太認真了吧
Dialogue: 0,0:07:39.87,0:07:41.41,CHS,,0,0,0,,正因如此
Dialogue: 0,0:07:44.41,0:07:45.79,CHS,,0,0,0,,我絕對要
Dialogue: 0,0:07:46.16,0:07:48.16,CHS,,0,0,0,,誓死守護柱到底
Dialogue: 0,0:08:09.58,0:08:10.79,CHS,,0,0,0,,真的假的
Dialogue: 0,0:08:27.41,0:08:28.45,CHS,,0,0,0,,反彈到月球了
Dialogue: 0,0:08:29.08,0:08:30.16,CHS,,0,0,0,,這怎麼可能
Dialogue: 0,0:08:36.41,0:08:38.04,CHS,,0,0,0,,徹底動不了了
Dialogue: 0,0:08:39.75,0:08:41.83,CHS,,0,0,0,,制伏第六柱的事靠你們了
Dialogue: 0,0:08:45.95,0:08:47.12,CHS,,0,0,0,,好險
Dialogue: 0,0:08:48.41,0:08:49.66,CHS,,0,0,0,,真是好險
Dialogue: 0,0:08:51.37,0:08:53.25,CHS,,0,0,0,,這座城裡的弱雞
Dialogue: 0,0:08:53.70,0:08:55.91,CHS,,0,0,0,,差點被瞬間轟光
Dialogue: 0,0:08:57.25,0:08:58.29,CHS,,0,0,0,,我的
Dialogue: 0,0:08:59.08,0:09:00.70,CHS,,0,0,0,,差點就被奪走了
Dialogue: 0,0:09:06.00,0:09:09.62,CHS,,0,0,0,,必須向公司申請特別津貼了
Dialogue: 0,0:09:10.58,0:09:12.58,CHS,,0,0,0,,我要動手了 黑野先生
Dialogue: 0,0:09:13.37,0:09:14.91,CHS,,0,0,0,,我不這麼做不行
Dialogue: 0,0:09:27.37,0:09:28.25,CHS,,0,0,0,,黑野
Dialogue: 0,0:09:28.50,0:09:30.20,CHS,,0,0,0,,大焰人的手臂被砍掉了
Dialogue: 0,0:09:30.33,0:09:31.50,CHS,,0,0,0,,雖然比不得鬼
Dialogue: 0,0:09:31.70,0:09:33.20,CHS,,0,0,0,,但大焰人的裝甲也是相當堅硬的
Dialogue: 0,0:09:33.20,0:09:34.12,CHS,,0,0,0,,好強啊
Dialogue: 0,0:09:35.37,0:09:36.50,CHS,,0,0,0,,手臂被
Dialogue: 0,0:09:43.54,0:09:46.33,CHS,,0,0,0,,你 不可以變強
Dialogue: 0,0:09:48.29,0:09:49.91,CHS,,0,0,0,,我對你很失望 哪吒
Dialogue: 0,0:09:51.00,0:09:52.29,CHS,,0,0,0,,你是個壞孩子
Dialogue: 0,0:09:52.79,0:09:54.79,CHS,,0,0,0,,請你不要這樣說
Dialogue: 0,0:09:55.25,0:09:56.50,CHS,,0,0,0,,我可以辦到的
Dialogue: 0,0:09:57.33,0:09:59.41,CHS,,0,0,0,,我甚至可以打敗黑野先生你
Dialogue: 0,0:09:59.87,0:10:01.66,CHS,,0,0,0,,我會證明給你看的
Dialogue: 0,0:10:16.70,0:10:18.62,CHS,,0,0,0,,你能辦到的對吧 小吒
Dialogue: 0,0:10:19.08,0:10:20.54,CHS,,0,0,0,,畢竟你是我引以為傲的兒子呀
Dialogue: 0,0:10:20.83,0:10:22.79,CHS,,0,0,0,,沒錯 我會做給你看的
Dialogue: 0,0:10:24.00,0:10:26.91,CHS,,0,0,0,,沒事的 媽媽 別擔心
Dialogue: 0,0:10:26.91,0:10:28.45,CHS,,0,0,0,,交給我吧
Dialogue: 0,0:10:28.87,0:10:29.87,CHS,,0,0,0,,我可以的
Dialogue: 0,0:10:36.50,0:10:37.37,CHS2,,0,0,0,,辦得到
Dialogue: 0,0:10:37.87,0:10:39.04,CHS,,0,0,0,,我可以的
Dialogue: 0,0:10:38.83,0:10:45.08,CHS2,,0,0,0,,辦得到
Dialogue: 0,0:10:40.16,0:10:41.25,CHS,,0,0,0,,包在我身上
Dialogue: 0,0:10:42.58,0:10:43.66,CHS,,0,0,0,,交給我
Dialogue: 0,0:10:52.25,0:10:53.20,CHS,,0,0,0,,必須這麼做
Dialogue: 0,0:10:53.83,0:10:54.91,CHS,,0,0,0,,我必須這麼做
Dialogue: 0,0:10:55.20,0:10:56.25,CHS,,0,0,0,,不然媽媽她
Dialogue: 0,0:10:58.04,0:10:59.25,CHS,,0,0,0,,我要做
Dialogue: 0,0:11:02.70,0:11:03.66,CHS,,0,0,0,,慢著 黑野
Dialogue: 0,0:11:11.08,0:11:12.79,CHS,,0,0,0,,放開我 黑野先生
Dialogue: 0,0:11:13.41,0:11:15.50,CHS,,0,0,0,,這不是我的全部實力
Dialogue: 0,0:11:15.83,0:11:17.20,CHS,,0,0,0,,我還能做得更好
Dialogue: 0,0:11:17.50,0:11:18.45,CHS,,0,0,0,,我得變強
Dialogue: 0,0:11:18.66,0:11:20.62,CHS,,0,0,0,,必須做出成績才行不是嗎?
Dialogue: 0,0:11:20.83,0:11:23.66,CHS,,0,0,0,,我會做出成績的 我可以做出成績的
Dialogue: 0,0:11:24.12,0:11:25.00,CHS,,0,0,0,,不行
Dialogue: 0,0:11:25.00,0:11:25.83,CHS,,0,0,0,,為什麼?
Dialogue: 0,0:11:26.00,0:11:29.20,CHS,,0,0,0,,你們不是很期待我覺醒安德拉爆炎嗎?
Dialogue: 0,0:11:29.58,0:11:30.58,CHS,,0,0,0,,拜託你
Dialogue: 0,0:11:30.75,0:11:31.95,CHS,,0,0,0,,我可以的
Dialogue: 0,0:11:32.16,0:11:33.83,CHS,,0,0,0,,我能做得更好
Dialogue: 0,0:11:35.29,0:11:36.37,CHS,,0,0,0,,不用了
Dialogue: 0,0:11:36.37,0:11:37.54,CHS,,0,0,0,,為什麼?
Dialogue: 0,0:11:37.83,0:11:40.66,CHS,,0,0,0,,你不要再繼續變強了
Dialogue: 0,0:11:44.75,0:11:45.75,CHS,,0,0,0,,為什麼?
Dialogue: 0,0:11:46.37,0:11:48.20,CHS,,0,0,0,,為什麼你要說這種話?
Dialogue: 0,0:11:49.25,0:11:51.50,CHS,,0,0,0,,我喜歡欺負弱小
Dialogue: 0,0:11:52.66,0:11:54.29,CHS,,0,0,0,,你還小不是嗎?
Dialogue: 0,0:11:54.91,0:11:56.41,CHS,,0,0,0,,所以你不需要變強
Dialogue: 0,0:11:58.04,0:12:00.70,CHS,,0,0,0,,這代表你對我不再抱有期待了是嗎?
Dialogue: 0,0:12:01.41,0:12:02.70,CHS,,0,0,0,,想做什麼 什麼
Dialogue: 0,0:12:03.25,0:12:04.50,CHS,,0,0,0,,想要怎麼 怎麼樣
Dialogue: 0,0:12:05.00,0:12:06.41,CHS,,0,0,0,,想成為什麼 什麼
Dialogue: 0,0:12:06.75,0:12:10.58,CHS,,0,0,0,,這些想法會促使一個男人變強
Dialogue: 0,0:12:11.33,0:12:13.20,CHS,,0,0,0,,有必要這麼心急嗎?
Dialogue: 0,0:12:13.87,0:12:15.45,CHS,,0,0,0,,你應該珍惜現在
Dialogue: 0,0:12:15.45,0:12:19.25,CHS,,0,0,0,,這種令我想要欺負你的弱小
Dialogue: 0,0:12:20.54,0:12:23.91,CHS,,0,0,0,,因為它寶貴卻也短暫
Dialogue: 0,0:12:26.45,0:12:29.41,CHS,,0,0,0,,所以 保持住你的弱小吧
Dialogue: 0,0:12:31.41,0:12:35.00,CHS,,0,0,0,,第一次有人這樣對我說
Dialogue: 0,0:12:36.79,0:12:39.75,CHS,,0,0,0,,爸爸媽媽都對我抱有過度的期許
Dialogue: 0,0:12:40.50,0:12:42.08,CHS,,0,0,0,,他們總說我去做就一定可以
Dialogue: 0,0:12:43.16,0:12:46.66,CHS,,0,0,0,,可一旦我沒做到 他們就會對我大失所望
Dialogue: 0,0:12:47.70,0:12:49.45,CHS,,0,0,0,,這讓我很害怕
Dialogue: 0,0:12:50.62,0:12:53.33,CHS,,0,0,0,,我內心的瘋子總在煽動我
Dialogue: 0,0:12:54.37,0:12:56.16,CHS,,0,0,0,,無視我的心情
Dialogue: 0,0:12:57.45,0:12:59.16,CHS,,0,0,0,,你只是個孩子
Dialogue: 0,0:13:04.58,0:13:07.95,CHS,,0,0,0,,我弱小一些也沒關係嗎?
Dialogue: 0,0:13:08.58,0:13:09.58,CHS,,0,0,0,,可以
Dialogue: 0,0:13:10.33,0:13:12.62,CHS,,0,0,0,,最好弱到讓我想要欺負你
Dialogue: 0,0:13:16.29,0:13:18.00,CHS,,0,0,0,,謝謝
Dialogue: 0,0:13:23.04,0:13:25.29,CHS,,0,0,0,,輻射濃度在下降
Dialogue: 0,0:13:27.08,0:13:28.58,CHS,,0,0,0,,黑野成功阻止了他
Dialogue: 0,0:13:29.25,0:13:34.45,CHS,,0,0,0,,有些關係在99%的人看來或許是古怪的
Dialogue: 0,0:13:35.12,0:13:38.87,CHS,,0,0,0,,但對於那1%的人來說卻是最適合他們的
Dialogue: 0,0:13:42.20,0:13:45.62,CHS,,0,0,0,,第六柱的守護人就是他了吧
Dialogue: 0,0:13:47.41,0:13:48.75,CHS,,0,0,0,,我要累癱了
Dialogue: 0,0:13:49.20,0:13:51.25,CHS,,0,0,0,,第六柱就讓灰島暫時看護
Dialogue: 0,0:13:51.41,0:13:52.66,CHS,,0,0,0,,我們先撤退吧
Dialogue: 0,0:13:55.62,0:13:57.50,CHS,,0,0,0,,現在你先留在那裡就好
Dialogue: 0,0:13:58.66,0:14:00.25,CHS,,0,0,0,,反正你的未來
Dialogue: 0,0:14:01.62,0:14:03.33,CHS,,0,0,0,,我已經看到了
Dialogue: 0,0:14:13.50,0:14:14.54,CHS,,0,0,0,,他們撤走了
Dialogue: 0,0:14:27.58,0:14:30.00,CHS,,0,0,0,,第8隊 灰島以及白衣人
Dialogue: 0,0:14:30.29,0:14:33.00,CHS,,0,0,0,,三方在灰島地盤上的混戰落幕了
Dialogue: 0,0:14:34.54,0:14:36.50,CHS,,0,0,0,,有32人在此戰中喪生
Dialogue: 0,0:14:37.20,0:14:38.20,CHS,,0,0,0,,對外公佈消息時
Dialogue: 0,0:14:38.50,0:14:41.62,CHS,,0,0,0,,聲稱此事為安德拉爆炎實驗中所發生的意外
Dialogue: 0,0:14:43.20,0:14:45.29,CHS,,0,0,0,,儘管月球被轟出了一個巨大的坑洞
Dialogue: 0,0:14:46.00,0:14:49.54,CHS,,0,0,0,,但對於曾在大災害中遭受毀滅性打擊的地球人來說
Dialogue: 0,0:14:50.25,0:14:52.45,CHS,,0,0,0,,這件事並沒有引起太大的反響
Dialogue: 0,0:14:53.95,0:14:57.54,CHS,,0,0,0,,孩子們目前仍被收容在灰島的研究所裡
Dialogue: 0,0:14:58.33,0:14:59.54,CHS,,0,0,0,,第8隊向灰島進言
Dialogue: 0,0:14:59.95,0:15:03.62,CHS,,0,0,0,,希望他們終止以安德拉爆炎為目的的過度實驗
Dialogue: 0,0:15:04.70,0:15:05.58,CHS,,0,0,0,,但是
Dialogue: 0,0:15:05.87,0:15:07.62,CHS,,0,0,0,,哪吒是被黑野阻止的
Dialogue: 0,0:15:08.75,0:15:11.00,CHS,,0,0,0,,我沒有幫上任何忙 只能從旁觀靜靜看著這一切
Dialogue: 0,0:15:12.29,0:15:13.87,CHS,,0,0,0,,儘管黑野行事不按常理出牌
Dialogue: 0,0:15:14.25,0:15:17.37,CHS,,0,0,0,,但他似乎能讓哪吒維持心理狀態的平穩
Dialogue: 0,0:15:19.16,0:15:22.04,CHS,,0,0,0,,這次的調查本意在於查探灰島與傳教者的關係
Dialogue: 0,0:15:22.62,0:15:24.12,CHS,,0,0,0,,但從這次的襲擊事件來看
Dialogue: 0,0:15:24.62,0:15:26.08,CHS,,0,0,0,,他們之間的關係應該是很薄弱的
Dialogue: 0,0:15:27.25,0:15:28.25,CHS,,0,0,0,,而在今天
Dialogue: 0,0:15:28.79,0:15:30.00,CHS,,0,0,0,,就此次事件
Dialogue: 0,0:15:30.45,0:15:32.91,CHS,,0,0,0,,我 利希特先生以及大隊長三人
Dialogue: 0,0:15:33.70,0:15:35.20,CHS,,0,0,0,,被灰島叫了過去
Dialogue: 0,0:15:37.37,0:15:38.37,CHS,,0,0,0,,請進
Dialogue: 0,0:15:42.25,0:15:43.25,CHS,,0,0,0,,灰島社長
Dialogue: 0,0:15:43.75,0:15:45.70,CHS,,0,0,0,,感謝您今日能撥冗相見
Dialogue: 0,0:15:48.37,0:15:51.00,CHS,,0,0,0,,關於之前的襲擊一事
Dialogue: 0,0:15:52.54,0:15:54.58,CHS,,0,0,0,,你們做得很好
Dialogue: 0,0:15:57.95,0:16:02.00,CHS,,0,0,0,,在這個國家 與灰島為敵是沒有活路的
Dialogue: 0,0:16:02.62,0:16:04.20,CHS,,0,0,0,,我可以將這看成是威脅嗎?
Dialogue: 0,0:16:04.45,0:16:08.54,CHS,,0,0,0,,我們都不想把寶貴的時間浪費在這上面
Dialogue: 0,0:16:09.00,0:16:13.16,CHS,,0,0,0,,我的意思是我們可以建立對傳教者的共同戰線 你覺得呢?
Dialogue: 0,0:16:13.66,0:16:16.75,CHS,,0,0,0,,如果你們願意跟灰島合作
Dialogue: 0,0:16:17.16,0:16:21.50,CHS,,0,0,0,,我可以考慮不殺利希特
Dialogue: 0,0:16:21.83,0:16:23.70,CHS,,0,0,0,,那你們打算如何對待哪吒?
Dialogue: 0,0:16:24.12,0:16:26.83,CHS,,0,0,0,,你就是安德拉爆炎的擁有者吧
Dialogue: 0,0:16:27.50,0:16:30.37,CHS,,0,0,0,,若你肯協助我們進行研究
Dialogue: 0,0:16:30.75,0:16:33.70,CHS,,0,0,0,,我可以調整兒童收容所裡的實驗內容
Dialogue: 0,0:16:35.37,0:16:38.20,CHS,,0,0,0,,我的提議不是什麼壞事吧
Dialogue: 0,0:16:39.00,0:16:41.79,CHS,,0,0,0,,你和利希特的傳喚令我也可以撤銷
Dialogue: 0,0:16:41.79,0:16:44.62,CHS,,0,0,0,,說到底 這事本就是你們挑起來的吧
Dialogue: 0,0:16:45.00,0:16:47.08,CHS,,0,0,0,,不要感情用事
Dialogue: 0,0:16:47.50,0:16:49.45,CHS,,0,0,0,,我們現在探討的
Dialogue: 0,0:16:49.79,0:16:52.66,CHS,,0,0,0,,可是事關皇國未來的大事
Dialogue: 0,0:16:53.79,0:16:56.45,CHS,,0,0,0,,您應該知道第8隊是怎樣一個存在吧
Dialogue: 0,0:16:57.12,0:16:59.12,CHS,,0,0,0,,我們成立的目的
Dialogue: 0,0:16:59.12,0:17:01.70,CHS,,0,0,0,,就是針對特殊消防隊內部進行調查
Dialogue: 0,0:17:02.66,0:17:05.20,CHS,,0,0,0,,我懷疑灰島與傳教者有關聯
Dialogue: 0,0:17:05.20,0:17:08.79,CHS,,0,0,0,,並且在天照一事上有所隱瞞
Dialogue: 0,0:17:09.20,0:17:13.50,CHS,,0,0,0,,聖陽教的創立有非人類的參與
Dialogue: 0,0:17:14.20,0:17:16.87,CHS,,0,0,0,,若那人與傳教者是一伙的
Dialogue: 0,0:17:17.16,0:17:20.25,CHS,,0,0,0,,那就有理由懷疑灰島與傳教者私通
Dialogue: 0,0:17:21.75,0:17:25.50,CHS,,0,0,0,,天照是聖陽教與灰島共同建造的
Dialogue: 0,0:17:25.79,0:17:28.70,CHS,,0,0,0,,那麼灰島是否與傳教者有聯繫呢?
Dialogue: 0,0:17:29.12,0:17:32.33,CHS,,0,0,0,,您知道天照裡還關著人嗎?
Dialogue: 0,0:17:32.95,0:17:34.25,CHS,,0,0,0,,我當然知道
Dialogue: 0,0:17:35.37,0:17:40.58,CHS,,0,0,0,,天照是一名安德拉爆炎擁有者在驅動著的
Dialogue: 0,0:17:42.54,0:17:44.70,CHS,,0,0,0,,但這又如何
Dialogue: 0,0:17:45.20,0:17:47.58,CHS,,0,0,0,,不可能讓天照停止運轉
Dialogue: 0,0:17:48.04,0:17:52.54,CHS,,0,0,0,,東京皇國是建立在這一個人的犧牲之上的
Dialogue: 0,0:17:52.87,0:17:55.20,CHS,,0,0,0,,如果讓天照停止運轉
Dialogue: 0,0:17:55.37,0:17:58.29,CHS,,0,0,0,,生活在皇國裡的人又當如何
Dialogue: 0,0:17:59.00,0:18:02.62,CHS,,0,0,0,,支撐他們生活的能源突然消失
Dialogue: 0,0:18:02.79,0:18:04.45,CHS,,0,0,0,,必然會造成動盪
Dialogue: 0,0:18:05.08,0:18:07.79,CHS,,0,0,0,,我們也同樣遭受了那幫人的襲擊
Dialogue: 0,0:18:08.45,0:18:12.33,CHS,,0,0,0,,請你們相信我們與傳教者並無關聯
Dialogue: 0,0:18:13.29,0:18:16.75,CHS,,0,0,0,,第3隊是灰島旗下的 他們之前的大隊長
Dialogue: 0,0:18:16.75,0:18:20.08,CHS,,0,0,0,,Dr.喬凡尼就是傳教者的人 這又該如何解釋?
Dialogue: 0,0:18:20.41,0:18:23.04,CHS,,0,0,0,,第3隊的事我很抱歉
Dialogue: 0,0:18:23.29,0:18:27.58,CHS,,0,0,0,,但皇國之中有七成人都與灰島有關
Dialogue: 0,0:18:28.62,0:18:31.58,CHS,,0,0,0,,我們不可能掌握所有人底細
Dialogue: 0,0:18:32.58,0:18:35.91,CHS,,0,0,0,,意圖獨佔安德拉爆炎的傳教者
Dialogue: 0,0:18:36.12,0:18:38.04,CHS,,0,0,0,,對灰島而言也是個阻礙
Dialogue: 0,0:18:38.41,0:18:40.54,CHS,,0,0,0,,你們有時間調查我們
Dialogue: 0,0:18:40.54,0:18:41.87,CHS,,0,0,0,,還不如去把他們消滅了
Dialogue: 0,0:18:45.16,0:18:48.20,CHS,,0,0,0,,灰島又是為什麼想得到安德拉爆炎呢?
Dialogue: 0,0:18:49.29,0:18:52.00,CHS,,0,0,0,,是要用來做天照的第二燃料
Dialogue: 0,0:18:54.12,0:18:55.91,CHS,,0,0,0,,你把人當什麼了
Dialogue: 0,0:18:56.33,0:18:58.79,CHS,,0,0,0,,安德拉爆炎的擁有者也是人啊
Dialogue: 0,0:18:59.00,0:19:02.66,CHS,,0,0,0,,犧牲一個人就能保全一千五百萬人
Dialogue: 0,0:19:03.25,0:19:06.33,CHS,,0,0,0,,沒了天照 等待皇國的便是毀滅
Dialogue: 0,0:19:08.12,0:19:11.00,CHS,,0,0,0,,你也覺醒了安德拉爆炎對吧
Dialogue: 0,0:19:11.50,0:19:14.58,CHS,,0,0,0,,如果你的犧牲能拯救一千五百萬人
Dialogue: 0,0:19:14.58,0:19:16.91,CHS,,0,0,0,,想來你也會欣然赴死的吧
Dialogue: 0,0:19:17.33,0:19:18.95,CHS,,0,0,0,,你可是消防官
Dialogue: 0,0:19:18.95,0:19:23.20,CHS,,0,0,0,,別告訴我你連捨己救人都做不到
Dialogue: 0,0:19:23.50,0:19:25.50,CHS,,0,0,0,,不就是捨己救人嘛 我有什麼不能的
Dialogue: 0,0:19:25.54,0:19:28.50,CHS,,0,0,0,,如果犧牲我一個消防官就能拯救大家的話
Dialogue: 0,0:19:28.70,0:19:30.00,CHS,,0,0,0,,你錯了 森羅
Dialogue: 0,0:19:30.87,0:19:32.83,CHS,,0,0,0,,消防官的命也不是不值錢的
Dialogue: 0,0:19:33.41,0:19:36.91,CHS,,0,0,0,,消防官只有活著 才能去拯救更多的人
Dialogue: 0,0:19:37.37,0:19:42.25,CHS,,0,0,0,,說不定就有機會救下超過一千五百萬的人呢
Dialogue: 0,0:19:44.75,0:19:47.79,CHS,,0,0,0,,所以說我要製造出不需要任何人做出犧牲
Dialogue: 0,0:19:47.79,0:19:50.45,CHS,,0,0,0,,超越天照的發電機
Dialogue: 0,0:19:50.95,0:19:52.00,CHS,,0,0,0,,站住 你這傢伙
Dialogue: 0,0:19:52.95,0:19:54.45,CHS,,0,0,0,,放心吧 森羅
Dialogue: 0,0:19:54.70,0:19:57.33,CHS,,0,0,0,,我絕對不會讓你犧牲的
Dialogue: 0,0:19:57.45,0:19:58.29,CHS,,0,0,0,,伏爾甘
Dialogue: 0,0:19:58.62,0:20:01.66,CHS,,0,0,0,,他是喬瑟夫家的孩子 就是製造了天照的那個家族
Dialogue: 0,0:20:01.87,0:20:02.79,CHS,,0,0,0,,什麼
Dialogue: 0,0:20:02.91,0:20:04.83,CHS,,0,0,0,,沒關係 讓他進來吧
Dialogue: 0,0:20:05.37,0:20:06.33,CHS,,0,0,0,,放手
Dialogue: 0,0:20:10.20,0:20:12.29,CHS,,0,0,0,,你就是灰島的社長嗎?
Dialogue: 0,0:20:12.45,0:20:13.95,CHS,,0,0,0,,你剛才說你要造出超越天照的
Dialogue: 0,0:20:13.95,0:20:17.25,CHS,,0,0,0,,不需要祭品的發電機是嗎?
Dialogue: 0,0:20:17.45,0:20:20.29,CHS,,0,0,0,,沒錯 我的夢想是復興這個世界
Dialogue: 0,0:20:20.58,0:20:23.33,CHS,,0,0,0,,為此就需要有能超越天照的發電機不是嗎?
Dialogue: 0,0:20:24.12,0:20:26.33,CHS,,0,0,0,,不管發生什麼事 我們都不會犧牲森羅的
Dialogue: 0,0:20:27.29,0:20:29.62,CHS,,0,0,0,,我們絕對會保護好森羅的
Dialogue: 0,0:20:30.29,0:20:32.41,CHS,,0,0,0,,大隊長 伏爾甘
Dialogue: 0,0:20:34.29,0:20:35.50,CHS,,0,0,0,,卡戎曾說
Dialogue: 0,0:20:35.66,0:20:37.87,CHS,,0,0,0,,柱都有自己的守護人
Dialogue: 0,0:20:39.33,0:20:42.70,CHS,,0,0,0,,第8隊的伙伴們就是我的守護人
Dialogue: 0,0:20:44.08,0:20:45.70,CHS,,0,0,0,,有志氣
Dialogue: 0,0:20:46.12,0:20:47.87,CHS,,0,0,0,,若真能實現
Dialogue: 0,0:20:48.04,0:20:50.54,CHS,,0,0,0,,這也正合我們的心意
Dialogue: 0,0:20:52.83,0:20:54.83,CHS,,0,0,0,,那就讓灰島來提供援助吧
Dialogue: 0,0:20:55.00,0:20:56.58,CHS,,0,0,0,,也包括對第8隊的援助
Dialogue: 0,0:20:59.00,0:21:00.12,CHS,,0,0,0,,不過
Dialogue: 0,0:21:00.45,0:21:01.91,CHS,,0,0,0,,確定你們能辦到嗎?
Dialogue: 0,0:21:02.37,0:21:03.50,CHS,,0,0,0,,當然
Dialogue: 0,0:21:05.08,0:21:06.75,CHS,,0,0,0,,但我有一個條件
Dialogue: 0,0:21:07.12,0:21:10.04,CHS,,0,0,0,,我要拿到出資份額相應的權利
Dialogue: 0,0:21:10.50,0:21:13.62,CHS,,0,0,0,,只要你能提供物資上的支援 權利什麼的我可以不要
Dialogue: 0,0:21:14.16,0:21:16.29,CHS,,0,0,0,,我只求能讓世界重生
Dialogue: 0,0:21:19.00,0:21:20.08,CHS,,0,0,0,,那就這麼說定了
Dialogue: 0,0:21:20.87,0:21:23.37,CHS,,0,0,0,,灰島為的不過是利益
Dialogue: 0,0:21:24.20,0:21:27.12,CHS,,0,0,0,,但他們總歸與傳教者沒有聯繫
Dialogue: 0,0:21:28.08,0:21:29.95,CHS,,0,0,0,,今後要跟灰島聯手了嗎?
Dialogue: 0,0:21:31.41,0:21:33.00,CHS,,0,0,0,,哪吒孫現在狀況如何?
Dialogue: 0,0:21:33.95,0:21:35.04,CHS,,0,0,0,,還是老樣子
Dialogue: 0,0:21:35.37,0:21:38.41,CHS,,0,0,0,,今天依然在進行有關安德拉爆炎的實驗
Dialogue: 0,0:21:38.91,0:21:40.33,CHS,,0,0,0,,又是那種殘酷的實驗
Dialogue: 0,0:21:40.37,0:21:43.95,CHS,,0,0,0,,放心 不會讓他受苦的
Dialogue: 0,0:21:46.70,0:21:49.41,CHS,,0,0,0,,對火焰的操控力好了很多哦
Dialogue: 0,0:21:50.25,0:21:51.25,CHS,,0,0,0,,還早得很
Dialogue: 0,0:21:51.62,0:21:53.75,CHS,,0,0,0,,沒有防火服 我依然會覺得不安
Dialogue: 0,0:21:54.54,0:21:55.62,CHS,,0,0,0,,沒問題的
Dialogue: 0,0:21:55.75,0:21:56.66,CHS,,0,0,0,,你可以的
Dialogue: 0,0:21:57.58,0:21:58.70,CHS,,0,0,0,,我可以
Dialogue: 0,0:22:02.66,0:22:03.54,CHS,,0,0,0,,來吧
Dialogue: 0,0:22:04.00,0:22:06.75,CHS,,0,0,0,,又到了和死神叔叔做遊戲的時間
Dialogue: 0,0:22:08.66,0:22:09.50,CHS,,0,0,0,,是
Dialogue: 0,0:22:10.00,0:22:11.37,CHS,,0,0,0,,不用那麼拚命
Dialogue: 0,0:22:12.12,0:22:13.70,CHS,,0,0,0,,保持住你的弱小
Dialogue: 0,0:22:14.33,0:22:15.45,CHS,,0,0,0,,算我拜託你了
Dialogue: 0,0:22:21.08,0:22:22.04,CHS,,0,0,0,,是
Dialogue: 0,0:24:03.50,0:24:04.66,CHS,,0,0,0,,聖陽教
Dialogue: 0,0:24:04.79,0:24:08.33,CHS,,0,0,0,,的確是火焰恐懼下人們的救贖
Dialogue: 0,0:24:08.79,0:24:11.12,CHS,,0,0,0,,可是 太陽神
Dialogue: 0,0:24:11.54,0:24:13.96,CHS,,0,0,0,,我能夠相信你嗎?
Dialogue: 0,0:24:14.71,0:24:16.29,CHS,,0,0,0,,能和我一起祈禱嗎?
Dialogue: 0,0:24:17.50,0:24:20.46,CHS,,0,0,0,,下集 炎炎消防隊 貳之章
Dialogue: 0,0:24:20.79,0:24:23.33,CHS,,0,0,0,,第十八話 聖女的苦惱
Dialogue: 0,0:24:24.00,0:24:26.66,CHS,,0,0,0,,化為熊熊烈焰吧 拉托姆
Comment: 0,0:00:00.00,0:00:00.00,OPCN,,0,0,0,,====================OP====================
Dialogue: 0,0:00:39.40,0:00:44.36,OPCN,,0,0,0,,Fly & Fire 化作晴空萬里 救濟歌唱
Dialogue: 0,0:00:44.36,0:00:46.82,OPCN,,0,0,0,,昂首高歌 唱慈悲為懷
Dialogue: 0,0:00:46.99,0:00:49.33,OPCN,,0,0,0,,繼往開來 闊步向未來
Dialogue: 0,0:00:49.41,0:00:51.79,OPCN,,0,0,0,,脫胎換骨 浴火再歸來
Dialogue: 0,0:00:51.87,0:00:54.29,OPCN,,0,0,0,,四苦八苦 盡數歸塵土
Dialogue: 0,0:00:54.41,0:00:56.83,OPCN,,0,0,0,,太陽藏在陰雲後
Dialogue: 0,0:00:56.92,0:00:59.17,OPCN,,0,0,0,,風裹挾著黑暗
Dialogue: 0,0:01:00.84,0:01:04.17,OPCN,,0,0,0,,遊船別走 淒淒又戚戚
Dialogue: 0,0:01:05.93,0:01:09.64,OPCN,,0,0,0,,搖搖盪盪 夕陽未落
Dialogue: 0,0:01:09.64,0:01:14.35,OPCN,,0,0,0,,腫脹潰爛 等待是未醒的夢
Dialogue: 0,0:01:15.56,0:01:19.48,OPCN,,0,0,0,,點一盞橙燈 把天空照亮
Dialogue: 0,0:01:19.48,0:01:23.11,OPCN,,0,0,0,,啊啊 這閉塞的世界多無聊
Dialogue: 0,0:01:23.11,0:01:25.61,OPCN,,0,0,0,,讓膩味的生活迎來解放
Dialogue: 0,0:01:25.74,0:01:30.45,OPCN,,0,0,0,,管他大火還是業火 跳進去說hello
Dialogue: 0,0:01:30.49,0:01:35.66,OPCN,,0,0,0,,不見五指的車道 你已被悲傷的陰影綁架其中
Dialogue: 0,0:01:35.66,0:01:41.25,OPCN,,0,0,0,,來吧 Say Hello 站起來就往前走
Dialogue: 0,0:01:41.25,0:01:46.34,OPCN,,0,0,0,,綻放永恆光明 解放在此刻降臨
Dialogue: 0,0:01:46.34,0:01:53.76,OPCN,,0,0,0,,搖啊搖 搖啊搖 搖啊搖 火光在搖啊搖啊搖
Dialogue: 0,0:00:39.40,0:00:44.36,OPJP,,0,0,0,,Fly & Fire 帰す快晴 救済唱歌
Dialogue: 0,0:00:44.36,0:00:46.82,OPJP,,0,0,0,,あぶれだ声 慈愛を
Dialogue: 0,0:00:46.99,0:00:49.33,OPJP,,0,0,0,,はみ出したって未来を
Dialogue: 0,0:00:49.41,0:00:51.79,OPJP,,0,0,0,,グットバック 再生へ
Dialogue: 0,0:00:51.87,0:00:54.29,OPJP,,0,0,0,,四苦八苦 無い方へ
Dialogue: 0,0:00:54.41,0:00:56.83,OPJP,,0,0,0,,曇天に隠れた太陽
Dialogue: 0,0:00:56.92,0:00:59.17,OPJP,,0,0,0,,風よ闇を攫って
Dialogue: 0,0:01:00.84,0:01:04.17,OPJP,,0,0,0,,遊覧船待って 泣いて憂う
Dialogue: 0,0:01:05.93,0:01:09.64,OPJP,,0,0,0,,揺らせ まだ夕景 そう笑って
Dialogue: 0,0:01:09.64,0:01:14.35,OPJP,,0,0,0,,腫れて爛れて 待ってるがまだ夢
Dialogue: 0,0:01:15.56,0:01:19.48,OPJP,,0,0,0,,橙色のライトで空を照らせ
Dialogue: 0,0:01:19.48,0:01:23.11,OPJP,,0,0,0,,そう 閉じ込めたってつまらないぜ
Dialogue: 0,0:01:23.11,0:01:25.61,OPJP,,0,0,0,,飽きたる日々に来たる解放
Dialogue: 0,0:01:25.74,0:01:30.45,OPJP,,0,0,0,,大火でも業火でも飛び込んでハロー
Dialogue: 0,0:01:30.49,0:01:35.66,OPJP,,0,0,0,,暗い車道 悲しみの影に君が包まれても
Dialogue: 0,0:01:35.66,0:01:41.25,OPJP,,0,0,0,,さあ セイハロー 立ったのなら歩き出そう
Dialogue: 0,0:01:41.25,0:01:46.34,OPJP,,0,0,0,,輝け延々と いま訪れる解放
Dialogue: 0,0:01:46.34,0:01:53.76,OPJP,,0,0,0,,揺れる 揺れる 揺れる 火が揺れる
