Dialogue: 0,0:24:07.22,0:24:12.05,屏幕字背景,,0,0,0,,{\an1\c&HFFFFFF&\fs160\3c&H000000&\pos(170,697)}　　　　第貳拾貳話\N{\fs300}　滅亡的陰謀
Dialogue: 0,0:00:03.43,0:00:04.68,CHS,,0,0,0,,這傢伙是怎麼回事
Dialogue: 0,0:00:05.14,0:00:06.10,CHS,,0,0,0,,沒完沒了啊
Dialogue: 0,0:00:34.42,0:00:35.50,CHS,,0,0,0,,破壞兵器
Dialogue: 0,0:00:40.71,0:00:41.84,CHS,,0,0,0,,破壞兵器
Dialogue: 0,0:00:48.10,0:00:49.64,CHS,,0,0,0,,得趕快把血止住
Dialogue: 0,0:00:50.52,0:00:51.85,CHS,,0,0,0,,必須盡快離開這裡
Dialogue: 0,0:00:52.14,0:00:53.69,CHS,,0,0,0,,不然又會有焰人
Dialogue: 0,0:00:54.69,0:00:57.23,CHS,,0,0,0,,古達 你先走吧
Dialogue: 0,0:00:57.98,0:01:00.73,CHS,,0,0,0,,我已經站不起來了
Dialogue: 0,0:01:01.86,0:01:04.15,CHS,,0,0,0,,我左腳沒有知覺了
Dialogue: 0,0:01:05.49,0:01:07.41,CHS,,0,0,0,,腳大概也
Dialogue: 0,0:01:07.53,0:01:09.28,CHS,,0,0,0,,我怎麼可能丟下你不管
Dialogue: 0,0:01:10.03,0:01:12.37,CHS,,0,0,0,,你還是快點離開吧
Dialogue: 0,0:01:14.00,0:01:17.63,CHS,,0,0,0,,帶著我這個廢物
Dialogue: 0,0:01:18.38,0:01:19.79,CHS,,0,0,0,,會害你也逃不掉的
Dialogue: 0,0:01:24.26,0:01:25.88,CHS,,0,0,0,,我感覺自己總算…
Dialogue: 0,0:01:26.09,0:01:27.68,CHS,,0,0,0,,在最後當了一回…
Dialogue: 0,0:01:28.14,0:01:31.18,CHS,,0,0,0,,跟身材一樣頂天立地的男子漢
Dialogue: 0,0:01:33.31,0:01:35.18,CHS,,0,0,0,,嗯 你很厲害
Dialogue: 0,0:01:35.35,0:01:37.65,CHS,,0,0,0,,你獨自一人打倒了那個白衣人
Dialogue: 0,0:01:38.40,0:01:41.65,CHS,,0,0,0,,這全是託了你的福
Dialogue: 0,0:01:42.61,0:01:45.28,CHS,,0,0,0,,我能夠為彈木學長報仇
Dialogue: 0,0:01:46.40,0:01:50.28,CHS,,0,0,0,,都是因為你給了我勇氣
Dialogue: 0,0:01:51.33,0:01:53.70,CHS,,0,0,0,,是你讓我成長為了一個男子漢
Dialogue: 0,0:01:54.41,0:01:55.66,CHS,,0,0,0,,所以我…
Dialogue: 0,0:01:55.96,0:01:58.04,CHS,,0,0,0,,死而無憾了
Dialogue: 0,0:01:59.33,0:02:03.59,CHS,,0,0,0,,雖然我還想死前再看一眼老家的馬鈴薯田
Dialogue: 0,0:02:04.76,0:02:07.93,CHS,,0,0,0,,不過已經有你送我最後一程
Dialogue: 0,0:02:08.30,0:02:10.60,CHS,,0,0,0,,再多就太貪心了
Dialogue: 0,0:02:11.39,0:02:17.52,CHS,,0,0,0,,能像個馬鈴薯一樣長眠地下 我心滿意足了
Dialogue: 0,0:02:17.52,0:02:20.86,CHS,,0,0,0,,笨蛋 你不是挖馬鈴薯的嗎?
Dialogue: 0,0:02:21.02,0:02:23.19,CHS,,0,0,0,,馬鈴薯要到了地上才算圓滿啊
Dialogue: 0,0:02:27.03,0:02:28.36,CHS,,0,0,0,,破壞兵器
Dialogue: 0,0:02:39.83,0:02:43.71,CHS,,0,0,0,,我死也要把破壞兵器帶回地上
Dialogue: 0,0:04:20.22,0:04:21.14,CHS,,0,0,0,,要命啊
Dialogue: 0,0:04:21.23,0:04:21.98,CHS,,0,0,0,,見鬼
Dialogue: 0,0:04:21.98,0:04:24.52,CHS,,0,0,0,,開槍 開槍啊 他已經死了
Dialogue: 0,0:04:27.69,0:04:29.53,CHS,,0,0,0,,這又是傳教者手下的傑作嗎?
Dialogue: 0,0:04:29.94,0:04:32.86,CHS,,0,0,0,,茉希一直在跟這麼危險的傢伙戰鬥嗎?
Dialogue: 0,0:04:33.86,0:04:36.95,CHS,,0,0,0,,茉希做的肯定是像後方支援這種安穩的工作吧
Dialogue: 0,0:04:37.03,0:04:39.99,CHS,,0,0,0,,她當然是在最前線當肉盾了
Dialogue: 0,0:04:39.99,0:04:42.21,CHS,,0,0,0,,你竟然讓我妹妹當肉盾
Dialogue: 0,0:04:48.04,0:04:49.17,CHS,,0,0,0,,這裡是戰場
Dialogue: 0,0:04:49.25,0:04:50.21,CHS,,0,0,0,,請集中精神
Dialogue: 0,0:04:50.21,0:04:51.59,CHS,,0,0,0,,還不是因為你亂講話
Dialogue: 0,0:04:53.80,0:04:55.47,CHS,,0,0,0,,一個接一個的
Dialogue: 0,0:04:56.47,0:04:57.51,CHS,,0,0,0,,這回又是怎麼了?
Dialogue: 0,0:05:03.81,0:05:06.27,CHS,,0,0,0,,紫煙騎士團艾昂來也
Dialogue: 0,0:05:06.81,0:05:08.98,CHS,,0,0,0,,我要將地上來的狗屎燒成灰
Dialogue: 0,0:05:09.98,0:05:11.28,CHS,,0,0,0,,白衣人
Dialogue: 0,0:05:15.28,0:05:17.20,CHS,,0,0,0,,在戰場上還自報家門
Dialogue: 0,0:05:17.82,0:05:19.37,CHS,,0,0,0,,看來這又是個跟亞瑟一樣的笨蛋
Dialogue: 0,0:05:21.87,0:05:23.50,CHS,,0,0,0,,難道是小蚊子叮了我一下嗎?
Dialogue: 0,0:05:24.29,0:05:25.67,CHS,,0,0,0,,槍彈對他沒用
Dialogue: 0,0:05:25.83,0:05:26.79,CHS,,0,0,0,,怎麼會這樣?
Dialogue: 0,0:05:27.08,0:05:29.13,CHS,,0,0,0,,關於茉希 我還有很多事想問你
Dialogue: 0,0:05:29.46,0:05:30.71,CHS,,0,0,0,,躲到我身後去
Dialogue: 0,0:05:31.30,0:05:32.42,CHS,,0,0,0,,太弱了
Dialogue: 0,0:05:32.55,0:05:34.67,CHS,,0,0,0,,那種東西根本無法對我鋼鐵般的肉身
Dialogue: 0,0:05:34.67,0:05:36.43,CHS,,0,0,0,,造成一絲一毫的傷害
Dialogue: 0,0:05:42.81,0:05:45.02,CHS,,0,0,0,,隊伍完全陷入了恐慌
Dialogue: 0,0:05:47.40,0:05:48.69,CHS,,0,0,0,,死多少人了
Dialogue: 0,0:05:49.11,0:05:51.11,CHS,,0,0,0,,生命竟然如此輕易便消逝了
Dialogue: 0,0:05:52.07,0:05:53.23,CHS,,0,0,0,,集中精神
Dialogue: 0,0:05:53.73,0:05:55.15,CHS,,0,0,0,,感受生命
Dialogue: 0,0:06:00.91,0:06:01.70,CHS,,0,0,0,,誰?
Dialogue: 0,0:06:13.50,0:06:17.05,CHS,,0,0,0,,好久不見 森羅日下部
Dialogue: 0,0:06:17.17,0:06:18.34,CHS,,0,0,0,,Dr.喬凡尼
Dialogue: 0,0:06:18.97,0:06:20.80,CHS,,0,0,0,,你又在地下圖謀些什麼?
Dialogue: 0,0:06:21.18,0:06:24.02,CHS,,0,0,0,,尾瀨刑警發現的實驗設施也是你的嗎?
Dialogue: 0,0:06:24.35,0:06:25.52,CHS,,0,0,0,,你殺了多少人?
Dialogue: 0,0:06:25.77,0:06:27.31,CHS,,0,0,0,,你想在這裡做什麼?
Dialogue: 0,0:06:27.64,0:06:28.56,CHS,,0,0,0,,回答我
Dialogue: 0,0:06:28.98,0:06:31.73,CHS,,0,0,0,,實驗設施不過是個誘餌罷了
Dialogue: 0,0:06:32.40,0:06:37.32,CHS,,0,0,0,,輕易便讓你們消防隊落入了這個圈套
Dialogue: 0,0:06:37.57,0:06:38.40,CHS,,0,0,0,,什麼?
Dialogue: 0,0:06:38.49,0:06:40.57,CHS,,0,0,0,,而你 日下部
Dialogue: 0,0:06:41.20,0:06:45.54,CHS,,0,0,0,,你就跟你弟弟一樣 乖乖來我們這裡做事吧
Dialogue: 0,0:06:45.58,0:06:46.91,CHS,,0,0,0,,小象他在哪裡?
Dialogue: 0,0:06:47.08,0:06:49.54,CHS,,0,0,0,,我今天為了戰鬥專門改裝了
Dialogue: 0,0:06:49.75,0:06:51.54,CHS,,0,0,0,,可不能同日而語
Dialogue: 0,0:06:55.59,0:06:56.51,CHS,,0,0,0,,怎麼回事?
Dialogue: 0,0:06:59.93,0:07:02.47,CHS,,0,0,0,,我說過跟以前不一樣了
Dialogue: 0,0:07:02.93,0:07:06.77,CHS,,0,0,0,,這副身體跟焰蟲的親和性變高了
Dialogue: 0,0:07:06.89,0:07:08.02,CHS,,0,0,0,,親和性?
Dialogue: 0,0:07:09.14,0:07:10.06,CHS,,0,0,0,,你的身體
Dialogue: 0,0:07:10.69,0:07:11.81,CHS,,0,0,0,,究竟變成什麼樣了?
Dialogue: 0,0:07:15.27,0:07:16.44,CHS,,0,0,0,,聽說第2隊和第8隊在地下
Dialogue: 0,0:07:16.61,0:07:19.40,CHS,,0,0,0,,展開了大規模的聯合調查行動
Dialogue: 0,0:07:19.53,0:07:22.03,CHS,,0,0,0,,終於要揭開白衣人的面紗了嗎?
Dialogue: 0,0:07:25.87,0:07:27.20,CHS,,0,0,0,,又去了地下
Dialogue: 0,0:07:30.29,0:07:31.62,CHS,,0,0,0,,日下部隊員 你沒事吧
Dialogue: 0,0:07:33.92,0:07:35.63,CHS,,0,0,0,,別來搗亂
Dialogue: 0,0:07:35.84,0:07:37.46,CHS,,0,0,0,,你把人當什麼了?
Dialogue: 0,0:07:38.84,0:07:41.01,CHS,,0,0,0,,你那副身體到底是怎麼回事?
Dialogue: 0,0:07:48.35,0:07:49.56,CHS,,0,0,0,,焰蟲的腿
Dialogue: 0,0:07:52.23,0:07:54.40,CHS,,0,0,0,,見鬼 這回來的是個怪物
Dialogue: 0,0:07:55.02,0:07:56.40,CHS,,0,0,0,,開槍 快開槍
Dialogue: 0,0:08:06.33,0:08:07.33,CHS,,0,0,0,,請退後一些
Dialogue: 0,0:08:07.58,0:08:08.49,CHS,,0,0,0,,這傢伙交給我吧
Dialogue: 0,0:08:12.50,0:08:14.42,CHS,,0,0,0,,要優先讓傷患避難才行
Dialogue: 0,0:08:15.08,0:08:16.79,CHS,,0,0,0,,看來我得把Dr.喬凡尼引開
Dialogue: 0,0:08:17.88,0:08:20.72,CHS,,0,0,0,,你鐵了心要保護傷患嗎?
Dialogue: 0,0:08:21.34,0:08:23.51,CHS,,0,0,0,,我們的目標是你
Dialogue: 0,0:08:23.72,0:08:26.22,CHS,,0,0,0,,你是不是該先擔心自己
Dialogue: 0,0:08:27.76,0:08:28.81,CHS,,0,0,0,,如果靠我的速度
Dialogue: 0,0:08:29.02,0:08:30.81,CHS,,0,0,0,,一口氣拉近距離將他踹飛的話
Dialogue: 0,0:08:30.81,0:08:33.81,CHS,,0,0,0,,你對自己的速度再有信心
Dialogue: 0,0:08:33.85,0:08:36.11,CHS,,0,0,0,,但只靠橫衝直撞也沒用…
Dialogue: 0,0:08:37.15,0:08:38.65,CHS,,0,0,0,,他是怎麼知道我的想法
Dialogue: 0,0:08:39.98,0:08:41.86,CHS,,0,0,0,,味刷
Dialogue: 0,0:08:42.90,0:08:46.66,CHS,,0,0,0,,唯有雄蛾才有的香味器官
Dialogue: 0,0:08:47.24,0:08:50.33,CHS,,0,0,0,,它可以散發費洛蒙 也可以探測費洛蒙
Dialogue: 0,0:08:51.00,0:08:53.33,CHS,,0,0,0,,我在此基礎上又對這一機能加以進化
Dialogue: 0,0:08:53.54,0:08:57.67,CHS,,0,0,0,,開發出了感知人類感情及心理的能力
Dialogue: 0,0:08:58.38,0:09:01.51,CHS,,0,0,0,,你的想法我全一清二楚
Dialogue: 0,0:09:01.71,0:09:04.34,CHS,,0,0,0,,姑且將這稱為蟲的預知好了
Dialogue: 0,0:09:05.22,0:09:06.93,CHS,,0,0,0,,什麼蟲不蟲的
Dialogue: 0,0:09:07.60,0:09:08.93,CHS,,0,0,0,,焰蟲到底是個什麼東西?
Dialogue: 0,0:09:09.26,0:09:11.06,CHS,,0,0,0,,你應該聽說過吧
Dialogue: 0,0:09:11.35,0:09:14.27,CHS,,0,0,0,,有一種說法是焰蟲是地球外的生命體
Dialogue: 0,0:09:14.27,0:09:17.73,CHS,,0,0,0,,因蟲卵附著在隕石上而隨之飛來地球的
Dialogue: 0,0:09:17.94,0:09:19.48,CHS,,0,0,0,,這種說法是正確的
Dialogue: 0,0:09:19.69,0:09:22.49,CHS,,0,0,0,,焰蟲並非地球生物
Dialogue: 0,0:09:23.36,0:09:25.95,CHS,,0,0,0,,而是異界的生命體
Dialogue: 0,0:09:26.24,0:09:29.28,CHS,,0,0,0,,讓來自異界的焰蟲與人相融合
Dialogue: 0,0:09:29.41,0:09:31.29,CHS,,0,0,0,,便能距異界再進一步
Dialogue: 0,0:09:31.41,0:09:33.37,CHS,,0,0,0,,我所進行的就是這樣的實驗
Dialogue: 0,0:09:33.75,0:09:35.96,CHS,,0,0,0,,難道說你在用自己的身體
Dialogue: 0,0:09:36.17,0:09:38.50,CHS,,0,0,0,,做焰蟲和異界的親和性實驗嗎?
Dialogue: 0,0:09:39.13,0:09:41.42,CHS,,0,0,0,,別急 我馬上就會讓你看到了
Dialogue: 0,0:09:41.71,0:09:44.05,CHS,,0,0,0,,我的實驗成果
Dialogue: 0,0:09:47.68,0:09:50.51,CHS,,0,0,0,,這裡就由我騎士王來親自殿後吧
Dialogue: 0,0:09:50.85,0:09:53.72,CHS,,0,0,0,,你速速帶著傷患 去尋找通往地上的出口吧
Dialogue: 0,0:09:53.93,0:09:54.85,CHS,,0,0,0,,感激不盡
Dialogue: 0,0:10:07.91,0:10:10.03,CHS,,0,0,0,,在戰場上一騎當千
Dialogue: 0,0:10:10.03,0:10:12.24,CHS,,0,0,0,,吾劍似鬼神般所向披靡
Dialogue: 0,0:10:21.00,0:10:22.34,CHS,,0,0,0,,他跑走了
Dialogue: 0,0:10:22.75,0:10:24.51,CHS,,0,0,0,,說好的殿後呢
Dialogue: 0,0:10:25.80,0:10:26.97,CHS,,0,0,0,,怎麼還有漏網之魚啊
Dialogue: 0,0:10:27.47,0:10:28.59,CHS,,0,0,0,,撤退撤退
Dialogue: 0,0:10:33.03,0:10:34.77,CHS,,0,0,0,,我不會讓你們得逞的
Dialogue: 0,0:10:35.06,0:10:36.68,CHS,,0,0,0,,別說傻話了
Dialogue: 0,0:10:36.73,0:10:39.94,CHS,,0,0,0,,你們已經落入了我們的陷阱
Dialogue: 0,0:10:47.53,0:10:49.16,CHS,,0,0,0,,電漿男
Dialogue: 0,0:10:50.36,0:10:52.28,CHS,,0,0,0,,亞瑟 你怎麼在這裡?
Dialogue: 0,0:10:52.66,0:10:53.95,CHS,,0,0,0,,你那隊的人呢?
Dialogue: 0,0:10:54.41,0:10:57.58,CHS,,0,0,0,,我騎士王親自殿後 讓他們先撤了
Dialogue: 0,0:10:58.12,0:11:00.42,CHS,,0,0,0,,殿後殿到這裡來了真的好嗎?
Dialogue: 0,0:11:00.46,0:11:03.59,CHS,,0,0,0,,哼 你這種愚人懂怎麼叫殿後嗎?
Dialogue: 0,0:11:04.17,0:11:06.71,CHS,,0,0,0,,又多了一個人啊
Dialogue: 0,0:11:07.55,0:11:08.84,CHS,,0,0,0,,也罷
Dialogue: 0,0:11:09.97,0:11:12.97,CHS,,0,0,0,,我正愁腿太多沒地方用呢
Dialogue: 0,0:11:25.77,0:11:26.82,CHS,,0,0,0,,請退後一些
Dialogue: 0,0:11:27.03,0:11:28.03,CHS,,0,0,0,,這傢伙很危險
Dialogue: 0,0:11:32.91,0:11:34.70,CHS,,0,0,0,,該退後的人是你吧
Dialogue: 0,0:11:47.05,0:11:48.21,CHS,,0,0,0,,被彈開了
Dialogue: 0,0:11:48.38,0:11:50.22,CHS,,0,0,0,,軍曹 你有沒有射準
Dialogue: 0,0:11:50.55,0:11:52.76,CHS,,0,0,0,,你的槍法也很令人懷疑啊
Dialogue: 0,0:11:54.01,0:11:56.35,CHS,,0,0,0,,茉希明明不適合當消防官
Dialogue: 0,0:11:56.35,0:11:57.51,CHS,,0,0,0,,你卻還是將她拐去了
Dialogue: 0,0:11:58.06,0:12:00.56,CHS,,0,0,0,,你看人的眼光也很不準嘛
Dialogue: 0,0:12:06.36,0:12:07.73,CHS,,0,0,0,,好驚人的蒸氣
Dialogue: 0,0:12:08.32,0:12:10.82,CHS,,0,0,0,,他應該屬於能讓起火能力在體內生效的
Dialogue: 0,0:12:10.90,0:12:12.61,CHS,,0,0,0,,那類第三代能力者
Dialogue: 0,0:12:13.20,0:12:15.74,CHS,,0,0,0,,不管用 通通不管用
Dialogue: 0,0:12:16.41,0:12:20.33,CHS,,0,0,0,,我的鋼鐵之軀就是這般堅硬
Dialogue: 0,0:12:22.21,0:12:23.62,CHS,,0,0,0,,麻田散鐵
Dialogue: 0,0:12:26.25,0:12:27.17,CHS,,0,0,0,,開玩笑的吧
Dialogue: 0,0:12:27.34,0:12:28.96,CHS,,0,0,0,,那傢伙的身體到底是怎麼回事?
Dialogue: 0,0:12:34.93,0:12:37.81,CHS,,0,0,0,,能彈開槍彈 能打碎柱子的肉體
Dialogue: 0,0:12:40.06,0:12:41.89,CHS,,0,0,0,,他讓身體異常硬化了
Dialogue: 0,0:12:43.39,0:12:45.06,CHS,,0,0,0,,很可靠的推理
Dialogue: 0,0:12:45.15,0:12:46.15,CHS,,0,0,0,,回答正確
Dialogue: 0,0:12:47.11,0:12:50.28,CHS,,0,0,0,,金屬不是有淬火這一道程序嗎?
Dialogue: 0,0:12:50.90,0:12:55.41,CHS,,0,0,0,,將金屬材料高溫加熱後急速冷卻
Dialogue: 0,0:12:55.74,0:12:59.83,CHS,,0,0,0,,從而獲得更加堅硬的麻田散鐵組織
Dialogue: 0,0:13:00.58,0:13:03.04,CHS,,0,0,0,,而且是遠高於加熱之前
Dialogue: 0,0:13:04.12,0:13:08.00,CHS,,0,0,0,,我借助起火能力加熱體內的鐵分
Dialogue: 0,0:13:08.34,0:13:10.00,CHS,,0,0,0,,再急速冷卻
Dialogue: 0,0:13:10.13,0:13:12.46,CHS,,0,0,0,,以達到操控身體硬度的目的
Dialogue: 0,0:13:12.88,0:13:15.05,CHS,,0,0,0,,並不單只是硬
Dialogue: 0,0:13:15.22,0:13:16.55,CHS,,0,0,0,,而是硬邦邦的
Dialogue: 0,0:13:16.55,0:13:19.97,CHS,,0,0,0,,也就是名符其實 堅硬的鋼鐵之軀
Dialogue: 0,0:13:23.81,0:13:24.77,CHS,,0,0,0,,喂 軍曹
Dialogue: 0,0:13:24.98,0:13:27.60,CHS,,0,0,0,,茉希對付的就是這種怪物嗎?
Dialogue: 0,0:13:27.86,0:13:29.82,CHS,,0,0,0,,軍隊裡不是也有教過對人戰鬥嗎?
Dialogue: 0,0:13:29.98,0:13:31.07,CHS,,0,0,0,,對人?
Dialogue: 0,0:13:31.23,0:13:32.65,CHS,,0,0,0,,你確定那種東西也能叫人嗎?
Dialogue: 0,0:13:32.65,0:13:34.24,CHS,,0,0,0,,只要有手腳關節
Dialogue: 0,0:13:34.24,0:13:36.28,CHS,,0,0,0,,對方到底是什麼東西並不重要
Dialogue: 0,0:13:36.70,0:13:37.49,CHS,,0,0,0,,軍曹
Dialogue: 0,0:13:37.49,0:13:39.49,CHS,,0,0,0,,我現在是第8隊的中隊長
Dialogue: 0,0:13:43.29,0:13:45.75,CHS,,0,0,0,,火焰 硬
Dialogue: 0,0:13:47.42,0:13:48.96,CHS,,0,0,0,,茉希的事暫且不提
Dialogue: 0,0:13:49.29,0:13:51.38,CHS,,0,0,0,,現在先集中精力對付眼前的敵人吧
Dialogue: 0,0:13:51.80,0:13:53.13,CHS,,0,0,0,,雖然我很想這麼說
Dialogue: 0,0:13:53.30,0:13:54.88,CHS,,0,0,0,,但是不問清楚 我沒辦法集中注意力
Dialogue: 0,0:13:54.97,0:13:56.22,CHS,,0,0,0,,請集中精神
Dialogue: 0,0:13:56.51,0:13:59.09,CHS,,0,0,0,,你根本不了解茉希
Dialogue: 0,0:13:59.35,0:14:01.85,CHS,,0,0,0,,她是個性格端莊的純情少女
Dialogue: 0,0:14:01.85,0:14:03.10,CHS,,0,0,0,,不要把她牽連進奇怪的事裡
Dialogue: 0,0:14:03.10,0:14:04.10,CHS,,0,0,0,,專心點好嗎?
Dialogue: 0,0:14:04.22,0:14:06.98,CHS,,0,0,0,,特殊消防隊標榜什麼人命第一
Dialogue: 0,0:14:07.10,0:14:08.69,CHS,,0,0,0,,但看你們第8隊的所作所為
Dialogue: 0,0:14:08.85,0:14:10.52,CHS,,0,0,0,,跟戰鬥狂有什麼兩樣
Dialogue: 0,0:14:11.82,0:14:13.36,CHS,,0,0,0,,像你們這種野蠻人
Dialogue: 0,0:14:13.53,0:14:15.07,CHS,,0,0,0,,少跟我們尾瀨家的人扯上關係
Dialogue: 0,0:14:17.24,0:14:19.53,CHS,,0,0,0,,第8隊並不是什麼戰鬥狂
Dialogue: 0,0:14:20.53,0:14:22.24,CHS,,0,0,0,,我或許可以算是
Dialogue: 0,0:14:22.49,0:14:23.79,CHS,,0,0,0,,但第8隊不是
Dialogue: 0,0:14:23.99,0:14:26.62,CHS,,0,0,0,,不用暴力就無法完成任務的野蠻人
Dialogue: 0,0:14:28.12,0:14:29.58,CHS,,0,0,0,,危險 請退後
Dialogue: 0,0:14:31.29,0:14:32.84,CHS,,0,0,0,,幸好沒讓茉希跟來
Dialogue: 0,0:14:33.34,0:14:35.42,CHS,,0,0,0,,我再也不會讓她來這種地方了
Dialogue: 0,0:14:40.05,0:14:42.64,CHS,,0,0,0,,尾瀨中尉 茉希她已沒你想的那麼柔弱
Dialogue: 0,0:14:43.06,0:14:44.31,CHS,,0,0,0,,我想也是
Dialogue: 0,0:14:44.64,0:14:47.02,CHS,,0,0,0,,畢竟她跟你這種野蠻人待在一起那麼久
Dialogue: 0,0:14:49.14,0:14:51.94,CHS,,0,0,0,,火焰 堅硬
Dialogue: 0,0:15:00.20,0:15:02.57,CHS,,0,0,0,,你要射那些BB彈到什麼時候
Dialogue: 0,0:15:02.70,0:15:03.99,CHS,,0,0,0,,你該明白了吧
Dialogue: 0,0:15:04.12,0:15:05.79,CHS,,0,0,0,,要想鎖定對方的弱點
Dialogue: 0,0:15:06.08,0:15:08.29,CHS,,0,0,0,,必須趁他還沒警惕的時候一擊斃命
Dialogue: 0,0:15:08.79,0:15:12.17,CHS,,0,0,0,,火焰之堅硬拳 必殺
Dialogue: 0,0:15:12.17,0:15:14.42,CHS,,0,0,0,,我在說我妹妹的事 你怎麼這麼煩人
Dialogue: 0,0:15:14.59,0:15:17.05,CHS,,0,0,0,,礙眼的火焰 讓我來撲滅你吧
Dialogue: 0,0:15:18.72,0:15:20.22,CHS,,0,0,0,,煩人的是你才對吧
Dialogue: 0,0:15:20.47,0:15:21.34,CHS,,0,0,0,,尾瀨中尉
Dialogue: 0,0:15:26.01,0:15:27.16,CHS,,0,0,0,,跳彈控制
Dialogue: 0,0:15:33.73,0:15:35.77,CHS,,0,0,0,,不管你將軀體硬化到何種地步
Dialogue: 0,0:15:36.19,0:15:39.03,CHS,,0,0,0,,可為了行動方便 你總不可能連關節也硬化吧
Dialogue: 0,0:15:40.11,0:15:42.36,CHS,,0,0,0,,是 你說的沒錯
Dialogue: 0,0:15:42.91,0:15:45.45,CHS,,0,0,0,,所以我才沒能成為守護人
Dialogue: 0,0:15:45.91,0:15:49.96,CHS,,0,0,0,,明明我都這麼這麼堅硬了
Dialogue: 0,0:15:54.79,0:15:56.84,CHS,,0,0,0,,要是讓茉希一直待在第8隊
Dialogue: 0,0:15:57.25,0:15:59.72,CHS,,0,0,0,,說不定也會變得跟這傢伙一樣渾身肌肉
Dialogue: 0,0:16:01.09,0:16:02.47,CHS,,0,0,0,,不要再跟我們尾瀨家扯上關係了
Dialogue: 0,0:16:02.72,0:16:04.18,CHS,,0,0,0,,請你集中精神
Dialogue: 0,0:16:10.14,0:16:11.89,CHS,,0,0,0,,灰燼歸於灰燼
Dialogue: 0,0:16:12.73,0:16:14.23,CHS,,0,0,0,,靈魂啊
Dialogue: 0,0:16:16.23,0:16:18.15,CHS,,0,0,0,,化為熊熊烈焰吧
Dialogue: 0,0:16:18.86,0:16:19.86,CHS,,0,0,0,,拉托姆
Dialogue: 0,0:16:21.95,0:16:24.41,CHS,,0,0,0,,可惡 怎麼打也打不完
Dialogue: 0,0:16:26.87,0:16:27.91,CHS,,0,0,0,,破壞兵器
Dialogue: 0,0:16:29.04,0:16:30.20,CHS,,0,0,0,,我絕對要
Dialogue: 0,0:16:30.58,0:16:32.41,CHS,,0,0,0,,帶破壞兵器出去
Dialogue: 0,0:16:36.17,0:16:37.71,CHS,,0,0,0,,怎麼不見大蛇的身影
Dialogue: 0,0:16:38.25,0:16:39.13,CHS,,0,0,0,,她在哪裡?
Dialogue: 0,0:16:39.76,0:16:41.76,CHS,,0,0,0,,又來了兩個穿著尖頂連帽衫的人
Dialogue: 0,0:16:42.72,0:16:44.93,CHS,,0,0,0,,怎麼回事? 還有殘黨?
Dialogue: 0,0:16:45.30,0:16:48.26,CHS,,0,0,0,,丫頭 是你將大蛇幹掉的嗎?
Dialogue: 0,0:16:52.81,0:16:53.94,CHS,,0,0,0,,我不是對手
Dialogue: 0,0:17:00.61,0:17:02.53,CHS,,0,0,0,,我這種半吊子怎麼可能打得贏
Dialogue: 0,0:17:03.45,0:17:04.99,CHS,,0,0,0,,這下只能逃走了
Dialogue: 0,0:17:07.11,0:17:09.37,CHS,,0,0,0,,我一個人逃跑?
Dialogue: 0,0:17:11.33,0:17:14.12,CHS,,0,0,0,,不行 我不能丟下破壞兵器不管
Dialogue: 0,0:17:24.93,0:17:26.68,CHS,,0,0,0,,像你這樣的雜魚
Dialogue: 0,0:17:26.97,0:17:29.43,CHS,,0,0,0,,能在這種情況下保住一命也是難得
Dialogue: 0,0:17:29.85,0:17:33.10,CHS,,0,0,0,,估計是受人保護 運氣好撿回了一條命吧
Dialogue: 0,0:17:34.18,0:17:35.19,CHS,,0,0,0,,死吧
Dialogue: 0,0:17:44.70,0:17:46.07,CHS,,0,0,0,,環 你不要緊吧
Dialogue: 0,0:17:46.70,0:17:47.61,CHS,,0,0,0,,謝天謝地
Dialogue: 0,0:17:49.87,0:17:51.20,CHS,,0,0,0,,破壞兵器
Dialogue: 0,0:17:54.08,0:17:55.29,CHS,,0,0,0,,你堅持的很好
Dialogue: 0,0:17:55.54,0:17:56.50,CHS,,0,0,0,,了不起
Dialogue: 0,0:17:57.17,0:17:58.71,CHS,,0,0,0,,先退到後面去吧
Dialogue: 0,0:17:59.29,0:18:00.34,CHS,,0,0,0,,大隊長
Dialogue: 0,0:18:02.46,0:18:03.80,CHS,,0,0,0,,大隊長?
Dialogue: 0,0:18:05.72,0:18:09.59,CHS,,0,0,0,,這下省事了 我們正打算去獵殺你們呢
Dialogue: 0,0:18:10.39,0:18:11.60,CHS,,0,0,0,,正合我意
Dialogue: 0,0:18:11.93,0:18:13.60,CHS,,0,0,0,,第8隊的大隊長
Dialogue: 0,0:18:14.31,0:18:18.27,CHS,,0,0,0,,你一個無能力者 想怎麼對付能操控火焰的我們?
Dialogue: 0,0:18:18.35,0:18:19.60,CHS,,0,0,0,,櫻備大隊長
Dialogue: 0,0:18:19.81,0:18:20.98,CHS,,0,0,0,,你退到後面去
Dialogue: 0,0:18:22.36,0:18:25.78,CHS,,0,0,0,,等你能生出火柴大小的火焰後 再來地下吧
Dialogue: 0,0:18:41.59,0:18:43.59,CHS,,0,0,0,,我可是每天都在鍛鍊
Dialogue: 0,0:18:44.05,0:18:46.09,CHS,,0,0,0,,鍛鍊到快要噴出火來了
Dialogue: 0,0:18:46.63,0:18:48.68,CHS,,0,0,0,,一擊便將蠍子擊倒了
Dialogue: 0,0:18:49.59,0:18:50.72,CHS,,0,0,0,,失禮了
Dialogue: 0,0:18:51.09,0:18:52.30,CHS,,0,0,0,,即便沒有起火能力
Dialogue: 0,0:18:52.30,0:18:54.60,CHS,,0,0,0,,依然扛起了第8隊的大隊長啊
Dialogue: 0,0:18:55.27,0:18:56.31,CHS,,0,0,0,,不錯
Dialogue: 0,0:18:56.43,0:18:58.31,CHS,,0,0,0,,但我可沒那麼容易對付
Dialogue: 0,0:19:03.94,0:19:04.90,CHS,,0,0,0,,放馬過來
Dialogue: 0,0:19:08.57,0:19:10.07,CHS,,0,0,0,,好 好強
Dialogue: 0,0:19:10.78,0:19:12.95,CHS,,0,0,0,,大隊長果然不是蓋的
Dialogue: 0,0:19:14.87,0:19:18.25,CHS,,0,0,0,,影梨中隊失聯 讓我非常擔心
Dialogue: 0,0:19:19.00,0:19:20.17,CHS,,0,0,0,,你沒事就好
Dialogue: 0,0:19:21.29,0:19:22.54,CHS,,0,0,0,,我真丟臉
Dialogue: 0,0:19:23.09,0:19:26.00,CHS,,0,0,0,,我總是被別人保護著
Dialogue: 0,0:19:26.84,0:19:29.67,CHS,,0,0,0,,就連剛才 要不是大隊長你們及時趕到…
Dialogue: 0,0:19:31.80,0:19:35.14,CHS,,0,0,0,,幸運被救也是本事嘛 環
Dialogue: 0,0:19:37.97,0:19:41.14,CHS,,0,0,0,,嗚 哇 我 我
Dialogue: 0,0:19:40.00,0:19:40.82,CHS2,,0,0,0,,抱歉
Dialogue: 0,0:19:41.14,0:19:43.40,CHS,,0,0,0,,伏爾甘 玩笑開錯時機了
Dialogue: 0,0:19:43.98,0:19:45.73,CHS,,0,0,0,,現在不是說那種話的時候
Dialogue: 0,0:19:46.27,0:19:49.49,CHS,,0,0,0,,不 消防官只有活著才能創造價值
Dialogue: 0,0:19:51.49,0:19:53.53,CHS,,0,0,0,,環你是個當之無愧的消防官
Dialogue: 0,0:19:54.20,0:19:56.45,CHS,,0,0,0,,活下去 然後阻止敵人的陰謀
Dialogue: 0,0:19:59.20,0:20:00.12,CHS,,0,0,0,,是
Dialogue: 0,0:20:03.46,0:20:06.21,CHS,,0,0,0,,第2特殊消防隊各隊聽令
Dialogue: 0,0:20:07.30,0:20:09.30,CHS,,0,0,0,,所有部隊集合
Dialogue: 0,0:20:12.80,0:20:15.72,CHS,,0,0,0,,以前常有人吐槽我跑起來的樣子很怪
Dialogue: 0,0:20:16.26,0:20:17.60,CHS,,0,0,0,,也不時被人嘲笑
Dialogue: 0,0:20:18.06,0:20:20.10,CHS,,0,0,0,,所以我才不喜歡跑步的
Dialogue: 0,0:20:20.73,0:20:22.77,CHS,,0,0,0,,可是不跑就會沒命
Dialogue: 0,0:20:23.52,0:20:24.86,CHS,,0,0,0,,會被焰人殺死
Dialogue: 0,0:20:25.73,0:20:28.19,CHS,,0,0,0,,在弄清楚世界的真相前我還不想死
Dialogue: 0,0:20:29.28,0:20:30.61,CHS,,0,0,0,,所以我必須逃跑
Dialogue: 0,0:20:30.99,0:20:32.65,CHS,,0,0,0,,哪怕姿勢再奇怪也要跑
Dialogue: 0,0:20:41.29,0:20:42.25,CHS,,0,0,0,,環隊員
Dialogue: 0,0:20:42.37,0:20:43.33,CHS,,0,0,0,,利希特
Dialogue: 0,0:20:43.62,0:20:45.38,CHS2,,0,0,0,,喂 你在摸哪裡啊
Dialogue: 0,0:20:43.96,0:20:47.09,CHS,,0,0,0,,一會被幸騷擾 一會被救的
Dialogue: 0,0:20:45.46,0:20:48.04,CHS2,,0,0,0,,不要在意這些細節 重要的是我得救了
Dialogue: 0,0:20:47.59,0:20:48.92,CHS,,0,0,0,,真是一刻也閒不下來
Dialogue: 0,0:20:48.09,0:20:50.01,CHS2,,0,0,0,,對我幸騷擾好歹要表現出感激吧
Dialogue: 0,0:20:50.88,0:20:53.22,CHS,,0,0,0,,利希特 大華中隊怎麼樣了?
Dialogue: 0,0:20:54.76,0:20:56.43,CHS,,0,0,0,,中隊全軍覆沒了
Dialogue: 0,0:20:56.85,0:20:59.14,CHS,,0,0,0,,死裡逃生的就我一個
Dialogue: 0,0:21:00.68,0:21:01.81,CHS,,0,0,0,,這樣啊
Dialogue: 0,0:21:02.93,0:21:04.48,CHS,,0,0,0,,你來的正好
Dialogue: 0,0:21:05.06,0:21:06.02,CHS,,0,0,0,,看看這個
Dialogue: 0,0:21:06.27,0:21:07.90,CHS,,0,0,0,,連喘口氣的時間都沒有啊
Dialogue: 0,0:21:08.44,0:21:11.82,CHS,,0,0,0,,這是各中隊裝置的熱能感應器的反應圖
Dialogue: 0,0:21:12.65,0:21:16.16,CHS,,0,0,0,,疑似焰人的熱源 等間隔分布著
Dialogue: 0,0:21:17.09,0:21:18.62,CHS,,0,0,0,,沒有意識的焰人
Dialogue: 0,0:21:18.87,0:21:20.91,CHS,,0,0,0,,會做出這麼規律的行動嗎?
Dialogue: 0,0:21:21.45,0:21:23.50,CHS,,0,0,0,,雖然僅憑這個無法準確推斷
Dialogue: 0,0:21:23.66,0:21:24.71,CHS,,0,0,0,,但確實很詭異啊
Dialogue: 0,0:21:25.17,0:21:28.54,CHS,,0,0,0,,焰人的攻擊也突然停止 四周一片寂靜了
Dialogue: 0,0:21:31.80,0:21:35.05,CHS,,0,0,0,,焰人這一熱源以等間隔分佈
Dialogue: 0,0:21:36.64,0:21:38.72,CHS,,0,0,0,,敵人想要炸掉這個地下設施
Dialogue: 0,0:21:38.72,0:21:39.55,CHS,,0,0,0,,你說什麼?
Dialogue: 0,0:21:39.55,0:21:40.68,CHS,,0,0,0,,不妙啊
Dialogue: 0,0:21:40.68,0:21:42.81,CHS,,0,0,0,,再不快點想想辦法 會出大事的
Dialogue: 0,0:21:48.15,0:21:49.61,CHS,,0,0,0,,一群蠢貨
Dialogue: 0,0:21:50.44,0:21:53.61,CHS,,0,0,0,,還不知自己是中了圈套被引入地下
Dialogue: 0,0:21:54.19,0:21:57.16,CHS,,0,0,0,,就用我的能力死屍烈焰
Dialogue: 0,0:21:57.66,0:22:00.45,CHS,,0,0,0,,讓東京沉入地底吧
Dialogue: 0,0:22:01.49,0:22:03.04,CHS,,0,0,0,,火力不足的話
Dialogue: 0,0:22:03.29,0:22:06.29,CHS,,0,0,0,,還可以用變成焰人的消防隊員來補足
Dialogue: 0,0:22:07.00,0:22:08.96,CHS,,0,0,0,,連自己是被引來的都不知道
Dialogue: 0,0:22:09.88,0:22:14.88,CHS,,0,0,0,,特地為我帶來了這麼多名為人類的炸彈
Dialogue: 0,0:22:15.17,0:22:16.76,CHS,,0,0,0,,真是感激不盡呢
Dialogue: 0,0:22:17.55,0:22:23.18,CHS,,0,0,0,,接下來只要抓住第四柱森羅日下部就行了
Dialogue: 0,0:23:58.94,0:24:01.45,CHS,,0,0,0,,東京皇國要完蛋了
Dialogue: 0,0:24:02.32,0:24:05.12,CHS,,0,0,0,,下集 炎炎消防隊 貳之章
Dialogue: 0,0:24:05.53,0:24:08.33,CHS,,0,0,0,,第二十二話 滅亡的陰謀
Dialogue: 0,0:24:09.20,0:24:13.54,CHS,,0,0,0,,化為熊熊烈焰吧 拉托姆
Comment: 0,0:00:00.00,0:00:00.00,OPCN,,0,0,0,,====================OP====================
Dialogue: 0,0:02:57.40,0:03:02.36,OPCN,,0,0,0,,Fly & Fire 化作晴空萬里 救濟歌唱
Dialogue: 0,0:03:02.36,0:03:04.82,OPCN,,0,0,0,,昂首高歌 唱慈悲為懷
Dialogue: 0,0:03:04.99,0:03:07.33,OPCN,,0,0,0,,繼往開來 闊步向未來
Dialogue: 0,0:03:07.41,0:03:09.79,OPCN,,0,0,0,,脫胎換骨 浴火再歸來
Dialogue: 0,0:03:09.87,0:03:12.29,OPCN,,0,0,0,,四苦八苦 盡數歸塵土
Dialogue: 0,0:03:12.41,0:03:14.83,OPCN,,0,0,0,,太陽藏在陰雲後
Dialogue: 0,0:03:14.92,0:03:17.17,OPCN,,0,0,0,,風裹挾著黑暗
Dialogue: 0,0:03:18.84,0:03:22.17,OPCN,,0,0,0,,遊船別走 淒淒又戚戚
Dialogue: 0,0:03:23.93,0:03:27.64,OPCN,,0,0,0,,搖搖盪盪 夕陽未落
Dialogue: 0,0:03:27.64,0:03:32.35,OPCN,,0,0,0,,腫脹潰爛 等待是未醒的夢
Dialogue: 0,0:03:33.56,0:03:37.48,OPCN,,0,0,0,,點一盞橙燈 把天空照亮
Dialogue: 0,0:03:37.48,0:03:41.11,OPCN,,0,0,0,,啊啊 這閉塞的世界多無聊
Dialogue: 0,0:03:41.11,0:03:43.61,OPCN,,0,0,0,,讓膩味的生活迎來解放
Dialogue: 0,0:03:43.74,0:03:48.45,OPCN,,0,0,0,,管他大火還是業火 跳進去說hello
Dialogue: 0,0:03:48.49,0:03:53.66,OPCN,,0,0,0,,不見五指的車道 你已被悲傷的陰影綁架其中
Dialogue: 0,0:03:53.66,0:03:59.25,OPCN,,0,0,0,,來吧 Say Hello 站起來就往前走
Dialogue: 0,0:03:59.25,0:04:04.34,OPCN,,0,0,0,,綻放永恆光明 解放在此刻降臨
Dialogue: 0,0:04:04.34,0:04:11.76,OPCN,,0,0,0,,搖啊搖 搖啊搖 搖啊搖 火光在搖啊搖啊搖
Dialogue: 0,0:02:57.40,0:03:02.36,OPJP,,0,0,0,,Fly & Fire 帰す快晴 救済唱歌
Dialogue: 0,0:03:02.36,0:03:04.82,OPJP,,0,0,0,,あぶれだ声 慈愛を
Dialogue: 0,0:03:04.99,0:03:07.33,OPJP,,0,0,0,,はみ出したって未来を
Dialogue: 0,0:03:07.41,0:03:09.79,OPJP,,0,0,0,,グットバック 再生へ
Dialogue: 0,0:03:09.87,0:03:12.29,OPJP,,0,0,0,,四苦八苦 無い方へ
Dialogue: 0,0:03:12.41,0:03:14.83,OPJP,,0,0,0,,曇天に隠れた太陽
Dialogue: 0,0:03:14.92,0:03:17.17,OPJP,,0,0,0,,風よ闇を攫って
Dialogue: 0,0:03:18.84,0:03:22.17,OPJP,,0,0,0,,遊覧船待って 泣いて憂う
Dialogue: 0,0:03:23.93,0:03:27.64,OPJP,,0,0,0,,揺らせ まだ夕景 そう笑って
Dialogue: 0,0:03:27.64,0:03:32.35,OPJP,,0,0,0,,腫れて爛れて 待ってるがまだ夢
Dialogue: 0,0:03:33.56,0:03:37.48,OPJP,,0,0,0,,橙色のライトで空を照らせ
Dialogue: 0,0:03:37.48,0:03:41.11,OPJP,,0,0,0,,そう 閉じ込めたってつまらないぜ
Dialogue: 0,0:03:41.11,0:03:43.61,OPJP,,0,0,0,,飽きたる日々に来たる解放
Dialogue: 0,0:03:43.74,0:03:48.45,OPJP,,0,0,0,,大火でも業火でも飛び込んでハロー
Dialogue: 0,0:03:48.49,0:03:53.66,OPJP,,0,0,0,,暗い車道 悲しみの影に君が包まれても
Dialogue: 0,0:03:53.66,0:03:59.25,OPJP,,0,0,0,,さあ セイハロー 立ったのなら歩き出そう
Dialogue: 0,0:03:59.25,0:04:04.34,OPJP,,0,0,0,,輝け延々と いま訪れる解放
Dialogue: 0,0:04:04.34,0:04:11.76,OPJP,,0,0,0,,揺れる 揺れる 揺れる 火が揺れる
