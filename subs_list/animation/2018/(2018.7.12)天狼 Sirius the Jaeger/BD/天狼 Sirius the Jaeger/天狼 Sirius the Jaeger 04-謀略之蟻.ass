Dialogue: 0,0:23:38.34,0:23:40.01,Title,,0,0,0,,{\fad(378,0)\frz270\bord0\pos(460,585)\c&H284D84&}巨獸肆虐』
Comment: 0,0:00:00.02,0:00:00.02,Comment,,0,0,0,,——Text——
Dialogue: 0,0:00:05.61,0:00:06.98,Default,,0,0,0,,這是什麼意思
Dialogue: 0,0:00:07.27,0:00:09.86,Default,,0,0,0,,您要是不明白 讓我解釋幾遍都行
Dialogue: 0,0:00:10.69,0:00:13.91,Default,,0,0,0,,你們製造了太多不經大腦的事件
Dialogue: 0,0:00:14.61,0:00:17.62,Default,,0,0,0,,警方查明背後的全貌只是早晚問題
Dialogue: 0,0:00:18.37,0:00:23.46,Default,,0,0,0,,所以克什納大人將提前中止對你們提供資金
Dialogue: 0,0:00:30.59,0:00:35.93,Default,,0,0,0,,鳥盡弓藏兔死狗烹 就是你們這幫人的做派嗎
Dialogue: 0,0:00:36.80,0:00:41.27,Default,,0,0,0,,你們宣稱抵制外國人 又私下和我等合作
Dialogue: 0,0:00:41.27,0:00:42.48,Default,,0,0,0,,沒有資格說我們…
Dialogue: 0,0:00:42.48,0:00:48.27,Default,,0,0,0,,別誤會了 我們不記得受過蠻夷的幫助
Dialogue: 0,0:00:53.36,0:00:56.91,Default,,0,0,0,,只是陪你們這些怪物鬧一鬧罷了
Dialogue: 0,0:00:59.16,0:01:01.95,Default,,0,0,0,,昭和維新前 我們先解決手頭的麻煩吧
Dialogue: 0,0:01:03.29,0:01:05.16,Default,,0,0,0,,該收拾怪物了
Dialogue: 0,0:02:37.27,0:02:38.11,Default,,0,0,0,,好重
Dialogue: 0,0:02:40.36,0:02:41.07,Default,,0,0,0,,辛苦了
Dialogue: 0,0:02:41.24,0:02:42.99,Default,,0,0,0,,你也去做事啊
Dialogue: 0,0:02:43.20,0:02:44.91,Default,,0,0,0,,我是用腦子做事的
Dialogue: 0,0:02:44.91,0:02:45.82,Default,,0,0,0,,真奇怪
Dialogue: 0,0:02:46.95,0:02:47.95,Default,,0,0,0,,我是說百虎黨
Dialogue: 0,0:02:48.37,0:02:51.29,Default,,0,0,0,,他們最近沒有襲擊學者和醫生
Dialogue: 0,0:02:51.66,0:02:55.25,Default,,0,0,0,,而且就是在襲擊華田博士後
Dialogue: 0,0:02:55.71,0:02:59.38,Default,,0,0,0,,就是說他們已經收集齊了所有的零件
Dialogue: 0,0:02:59.84,0:03:02.84,Default,,0,0,0,,菲力浦 把昨天借來的搜查資料拿來
Dialogue: 0,0:03:04.13,0:03:05.30,Default,,0,0,0,,你還叫我跑腿？
Dialogue: 0,0:03:05.51,0:03:06.51,Default,,0,0,0,,我去拿吧
Dialogue: 0,0:03:12.10,0:03:14.19,Default,,0,0,0,,尤里怎麼突然積極起來了
Dialogue: 0,0:03:14.69,0:03:16.77,Default,,0,0,0,,大概是身體養好了吧
Dialogue: 0,0:03:17.06,0:03:19.57,Default,,0,0,0,,無論如何這是好事
Dialogue: 0,0:03:21.40,0:03:22.15,Default,,0,0,0,,打擾
Dialogue: 0,0:03:23.11,0:03:24.07,Default,,0,0,0,,小姐
Dialogue: 0,0:03:24.61,0:03:28.41,Default,,0,0,0,,請問今晚能和家父一道用餐嗎
Dialogue: 0,0:03:29.70,0:03:31.33,Default,,0,0,0,,怎麼這麼拘謹啊
Dialogue: 0,0:03:31.79,0:03:34.33,Default,,0,0,0,,畢竟小鬼頭還不懂什麼是禮儀
Dialogue: 0,0:03:34.54,0:03:38.59,Default,,0,0,0,,我知道啊 讓你瞧瞧我優雅的餐桌禮儀吧
Dialogue: 0,0:03:39.17,0:03:42.63,Default,,0,0,0,,我們包括教授都很樂意共進晚餐
Dialogue: 0,0:03:43.30,0:03:45.59,Default,,0,0,0,,好的 我會轉告父親的
Dialogue: 0,0:03:48.01,0:03:49.26,Default,,0,0,0,,怎麼了 小姐
Dialogue: 0,0:03:50.81,0:03:53.81,Default,,0,0,0,,沒事 我會很期待晚餐的
Dialogue: 0,0:03:56.14,0:03:56.90,Default,,0,0,0,,是這些嗎
Dialogue: 0,0:03:58.10,0:03:59.02,Default,,0,0,0,,嗯 謝謝你
Dialogue: 0,0:03:59.61,0:04:00.90,Default,,0,0,0,,還要別的資料嗎
Dialogue: 0,0:04:01.69,0:04:03.11,Default,,0,0,0,,現在這些就夠了
Dialogue: 0,0:04:04.19,0:04:04.53,Default,,0,0,0,,是嗎
Dialogue: 0,0:04:06.11,0:04:07.07,Default,,0,0,0,,剛剛看見了嗎
Dialogue: 0,0:04:07.74,0:04:08.49,Default,,0,0,0,,看見了
Dialogue: 0,0:04:09.87,0:04:10.28,Default,,0,0,0,,怎麼了
Dialogue: 0,0:04:13.29,0:04:17.79,Default,,0,0,0,,沒想到生意對手V海運居然會來拜訪
Dialogue: 0,0:04:18.17,0:04:19.17,Default,,0,0,0,,哪有
Dialogue: 0,0:04:19.83,0:04:22.25,Default,,0,0,0,,都是在異國他鄉做生意的商人
Dialogue: 0,0:04:22.59,0:04:24.13,Default,,0,0,0,,合作共贏不好嗎
Dialogue: 0,0:04:25.47,0:04:26.17,Default,,0,0,0,,很樂意
Dialogue: 0,0:04:26.72,0:04:29.05,Default,,0,0,0,,不過我司經營的商品
Dialogue: 0,0:04:29.22,0:04:31.80,Default,,0,0,0,,與貴公司的專業大相徑庭吧
Dialogue: 0,0:04:32.31,0:04:34.89,Default,,0,0,0,,兵器與開發技術的出口 對吧
Dialogue: 0,0:04:36.81,0:04:40.44,Default,,0,0,0,,阿爾瑪商會有著10年20年的前瞻性
Dialogue: 0,0:04:40.69,0:04:41.56,Default,,0,0,0,,憑藉這獨到的眼光
Dialogue: 0,0:04:41.77,0:04:45.40,Default,,0,0,0,,才和這個國家的軍隊不斷加深著聯繫
Dialogue: 0,0:04:45.78,0:04:47.28,Default,,0,0,0,,的確叫人羨慕
Dialogue: 0,0:04:47.28,0:04:50.28,Default,,0,0,0,,哪裡哪裡 V海運才是業績一路高歌…
Dialogue: 0,0:05:03.21,0:05:04.30,Default,,0,0,0,,打擾了
Dialogue: 0,0:05:05.51,0:05:06.26,Default,,0,0,0,,趕上了
Dialogue: 0,0:05:09.09,0:05:10.47,Default,,0,0,0,,你是…
Dialogue: 0,0:05:15.18,0:05:19.39,Default,,0,0,0,,之前在您準備出門時搭話 實在冒昧
Dialogue: 0,0:05:20.06,0:05:21.52,Default,,0,0,0,,話說還真巧啊
Dialogue: 0,0:05:22.36,0:05:24.44,Default,,0,0,0,,您真是熱愛工作 還來視察敵情
Dialogue: 0,0:05:25.11,0:05:26.86,Default,,0,0,0,,感覺阿爾瑪商會怎麼樣
Dialogue: 0,0:05:27.61,0:05:31.99,Default,,0,0,0,,我只是來和生意伙伴探討海運界的未來而已
Dialogue: 0,0:05:32.41,0:05:33.45,Default,,0,0,0,,又是這些嗎
Dialogue: 0,0:05:34.58,0:05:37.29,Default,,0,0,0,,對了 華田喜助博士失蹤事件
Dialogue: 0,0:05:38.16,0:05:42.67,Default,,0,0,0,,沒事吧 聽說你們的員工也被牽扯進去了
Dialogue: 0,0:05:43.42,0:05:44.29,Default,,0,0,0,,不勞您費心
Dialogue: 0,0:05:45.13,0:05:48.09,Default,,0,0,0,,話說您這雜誌記者真是消息靈通啊
Dialogue: 0,0:05:48.55,0:05:50.97,Default,,0,0,0,,不不 這可是我的專業
Dialogue: 0,0:05:51.76,0:05:54.93,Default,,0,0,0,,就算不想聽 也會有各種傳聞飄進耳朵裡
Dialogue: 0,0:05:55.68,0:06:00.27,Default,,0,0,0,,比如華田博士並非失蹤 而是被殺害的
Dialogue: 0,0:06:04.69,0:06:08.65,Default,,0,0,0,,你們當時就是急著去博士家吧
Dialogue: 0,0:06:13.45,0:06:17.45,Default,,0,0,0,,表面工作還請做得像點樣子 威拉德先生
Dialogue: 0,0:06:18.41,0:06:19.41,Default,,0,0,0,,彼此彼此
Dialogue: 0,0:06:28.71,0:06:30.38,Default,,0,0,0,,阿爾瑪商會和V海運
Dialogue: 0,0:06:31.72,0:06:33.43,Default,,0,0,0,,還是後者更加可疑
Dialogue: 0,0:06:39.39,0:06:41.02,Default,,0,0,0,,看到本該在哈爾濱的男人
Dialogue: 0,0:06:41.02,0:06:43.39,Default,,0,0,0,,居然穿著便服在銀座閒晃
Dialogue: 0,0:06:43.94,0:06:45.69,Default,,0,0,0,,就下意識地打招呼了
Dialogue: 0,0:06:46.44,0:06:47.11,Default,,0,0,0,,不敢當
Dialogue: 0,0:06:47.48,0:06:49.98,Default,,0,0,0,,居然召您回來 事情肯定很棘手
Dialogue: 0,0:06:50.40,0:06:52.20,Default,,0,0,0,,是啊 給使喚得團團轉
Dialogue: 0,0:06:53.24,0:06:58.45,Default,,0,0,0,,話說恭喜您當上武器局局長 柿崎少將閣下
Dialogue: 0,0:06:59.20,0:07:01.08,Default,,0,0,0,,你的消息真是靈通
Dialogue: 0,0:07:01.79,0:07:06.25,Default,,0,0,0,,我剛才還在市谷台鼓勵了下一任校長
Dialogue: 0,0:07:06.83,0:07:11.09,Default,,0,0,0,,能在閣下執教期間在校學習是我的運氣
Dialogue: 0,0:07:12.09,0:07:13.93,Default,,0,0,0,,又要去哪下動員令呢
Dialogue: 0,0:07:14.34,0:07:16.84,Default,,0,0,0,,不 現在去視察御殿場
Dialogue: 0,0:07:18.14,0:07:19.72,Default,,0,0,0,,閣下親自去視察？
Dialogue: 0,0:07:20.68,0:07:23.52,Default,,0,0,0,,是有演習要實驗新武器嗎
Dialogue: 0,0:07:24.06,0:07:26.60,Default,,0,0,0,,軍機不可洩 抱歉
Dialogue: 0,0:07:27.19,0:07:27.56,Default,,0,0,0,,不敢
Dialogue: 0,0:07:28.23,0:07:34.28,Default,,0,0,0,,不過伊庭 那或許是能讓戰爭大不一樣的貨物
Dialogue: 0,0:07:35.07,0:07:38.70,Default,,0,0,0,,只靠我們國家的力量 是不可能完成的
Dialogue: 0,0:07:39.83,0:07:41.04,Default,,0,0,0,,阿爾瑪商會嗎
Dialogue: 0,0:07:42.95,0:07:46.17,Default,,0,0,0,,推薦你去情報部門真是正確的決定
Dialogue: 0,0:07:49.17,0:07:51.80,Default,,0,0,0,,遲早會發生另一場大型戰爭
Dialogue: 0,0:07:52.34,0:07:53.72,Default,,0,0,0,,如果那東西能實用化的話
Dialogue: 0,0:07:54.13,0:07:56.55,Default,,0,0,0,,{\fs32\pos(520,660)}甲午
Dialogue: 0,0:07:54.13,0:07:56.55,Default,,0,0,0,,就不必像日清日俄和歐洲大戰那樣
Dialogue: 0,0:07:56.55,0:07:59.22,Default,,0,0,0,,讓士兵白白送死了
Dialogue: 0,0:07:59.97,0:08:03.52,Default,,0,0,0,,這次的演習一定要成功
Dialogue: 0,0:08:05.31,0:08:08.98,Default,,0,0,0,,今早警察衝進百虎黨大本營
Dialogue: 0,0:08:09.31,0:08:11.07,Default,,0,0,0,,卻已經是人去樓空
Dialogue: 0,0:08:11.65,0:08:12.36,Default,,0,0,0,,有留下什麼東西嗎
Dialogue: 0,0:08:12.78,0:08:16.11,Default,,0,0,0,,沒有 但是那裡有爭鬥的痕跡
Dialogue: 0,0:08:16.57,0:08:18.49,Default,,0,0,0,,還有四處散亂的「灰」
Dialogue: 0,0:08:19.03,0:08:21.41,Default,,0,0,0,,他們以前果然與吸血鬼共事
Dialogue: 0,0:08:21.74,0:08:24.29,Default,,0,0,0,,但怎麼突然起內訌了
Dialogue: 0,0:08:25.12,0:08:28.83,Default,,0,0,0,,他們利用百虎黨收集完零件後 就拋棄了吧
Dialogue: 0,0:08:29.58,0:08:32.38,Default,,0,0,0,,問題在於 他們用這些東西做了什麼
Dialogue: 0,0:08:33.67,0:08:34.84,Default,,0,0,0,,阿爾瑪商會嗎
Dialogue: 0,0:08:36.13,0:08:37.80,Default,,0,0,0,,收集的零件在那邊嗎
Dialogue: 0,0:08:38.38,0:08:38.97,Default,,0,0,0,,調查得如何
Dialogue: 0,0:08:39.84,0:08:41.68,Default,,0,0,0,,是個熱情又善良的公司
Dialogue: 0,0:08:42.76,0:08:44.68,Default,,0,0,0,,現在正向軍方販賣新武器
Dialogue: 0,0:08:45.10,0:08:48.35,Default,,0,0,0,,還客氣地告訴我在靜岡有演習
Dialogue: 0,0:08:48.77,0:08:51.94,Default,,0,0,0,,新武器說不定已經沾滿了鮮血
Dialogue: 0,0:08:52.23,0:08:54.82,Default,,0,0,0,,不知道善良的員工們是否知道
Dialogue: 0,0:08:55.28,0:08:59.95,Default,,0,0,0,,應該不知道吧 但是暗中一定有那些傢伙在
Dialogue: 0,0:09:00.66,0:09:02.45,Default,,0,0,0,,說不定還參加了軍方的演習
Dialogue: 0,0:09:02.95,0:09:04.99,Default,,0,0,0,,也許是狩獵貴族種的機會
Dialogue: 0,0:09:05.37,0:09:06.79,Default,,0,0,0,,又可以大幹一場了
Dialogue: 0,0:09:07.04,0:09:09.25,Default,,0,0,0,,那百虎黨要怎麼辦？
Dialogue: 0,0:09:09.92,0:09:12.34,Default,,0,0,0,,我不認為他們會放過背叛的吸血鬼
Dialogue: 0,0:09:12.88,0:09:14.00,Default,,0,0,0,,兵分兩路吧？
Dialogue: 0,0:09:16.38,0:09:16.84,Default,,0,0,0,,教授
Dialogue: 0,0:09:23.60,0:09:24.10,Default,,0,0,0,,望月
Dialogue: 0,0:09:25.01,0:09:26.81,Default,,0,0,0,,立刻準備去御殿場的車票
Dialogue: 0,0:09:27.52,0:09:30.06,Default,,0,0,0,,御殿場？你要離開帝都嗎？
Dialogue: 0,0:09:30.52,0:09:32.31,Default,,0,0,0,,我去查清阿爾瑪商會的動向
Dialogue: 0,0:09:32.90,0:09:36.28,Default,,0,0,0,,阿爾瑪？那V海運怎麼辦？
Dialogue: 0,0:09:36.90,0:09:39.65,Default,,0,0,0,,兩邊都要添添麻煩才公平啊
Dialogue: 0,0:09:40.86,0:09:42.57,Default,,0,0,0,,V海運和阿爾瑪商會
Dialogue: 0,0:09:43.57,0:09:46.66,Default,,0,0,0,,他們到底打算在這個國家做什麼
Dialogue: 0,0:09:50.12,0:09:53.33,Default,,0,0,0,,真是優雅的餐桌禮儀呢 小少爺
Dialogue: 0,0:09:53.54,0:09:56.46,Default,,0,0,0,,我又不會用筷子 話說
Dialogue: 0,0:09:57.00,0:09:58.17,Default,,0,0,0,,這不是還活著嗎
Dialogue: 0,0:10:00.84,0:10:03.39,Default,,0,0,0,,和食不合各位的胃口嗎
Dialogue: 0,0:10:03.76,0:10:04.76,Default,,0,0,0,,哪裡的話
Dialogue: 0,0:10:05.26,0:10:08.52,Default,,0,0,0,,我甚至覺得只有日本 才能享用如此新鮮的魚
Dialogue: 0,0:10:09.23,0:10:12.65,Default,,0,0,0,,我們也很高興能有這麼多人共進晚餐
Dialogue: 0,0:10:13.52,0:10:18.11,Default,,0,0,0,,拙荊去世的早 平時只有我和女兒
Dialogue: 0,0:10:19.32,0:10:20.36,Default,,0,0,0,,真少見啊 涼子
Dialogue: 0,0:10:20.70,0:10:22.86,Default,,0,0,0,,平時都是吃夠3碗飯的
Dialogue: 0,0:10:24.37,0:10:25.24,Default,,0,0,0,,爸爸！
Dialogue: 0,0:10:26.24,0:10:27.12,Default,,0,0,0,,抱歉抱歉
Dialogue: 0,0:10:27.62,0:10:29.75,Default,,0,0,0,,對了教授 工作進展如何
Dialogue: 0,0:10:30.41,0:10:32.33,Default,,0,0,0,,感覺你們每天都很忙
Dialogue: 0,0:10:32.87,0:10:35.38,Default,,0,0,0,,得感謝您把府上給我們當做據點
Dialogue: 0,0:10:36.25,0:10:37.59,Default,,0,0,0,,另外還有一事向您匯報
Dialogue: 0,0:10:38.25,0:10:40.17,Default,,0,0,0,,明天開始有部下將出差幾天
Dialogue: 0,0:10:41.47,0:10:41.92,Default,,0,0,0,,去哪裡？
Dialogue: 0,0:10:42.68,0:10:47.10,Default,,0,0,0,,靜岡的御殿場 那裡有我們的熟客
Dialogue: 0,0:10:47.35,0:10:50.39,Default,,0,0,0,,請問會派誰去呢
Dialogue: 0,0:10:51.10,0:10:51.77,Default,,0,0,0,,是我
Dialogue: 0,0:10:52.98,0:10:53.85,Default,,0,0,0,,怎麼了 涼子
Dialogue: 0,0:10:54.19,0:10:54.60,Default,,0,0,0,,沒事
Dialogue: 0,0:10:55.48,0:10:57.15,Default,,0,0,0,,沒關係的 大小姐
Dialogue: 0,0:10:57.86,0:11:00.57,Default,,0,0,0,,我會保護好尤里的
Dialogue: 0,0:11:01.15,0:11:03.40,Default,,0,0,0,,對啊 尤里跑不掉的
Dialogue: 0,0:11:03.78,0:11:04.82,Default,,0,0,0,,你看他這樣子
Dialogue: 0,0:11:06.62,0:11:08.95,Default,,0,0,0,,那個 我們繼續吃飯吧
Dialogue: 0,0:11:10.62,0:11:11.79,Default,,0,0,0,,這孩子真奇怪
Dialogue: 0,0:11:14.00,0:11:16.21,Default,,0,0,0,,不要再接近我了
Dialogue: 0,0:11:34.69,0:11:38.11,Default,,0,0,0,,這是…怎麼會這樣…
Dialogue: 0,0:11:38.86,0:11:43.65,Default,,0,0,0,,柿崎少將閣下 您滿意敝社的新商品嗎
Dialogue: 0,0:11:44.65,0:11:48.45,Default,,0,0,0,,今後阿爾瑪商會還請您多多關照
Dialogue: 0,0:11:52.71,0:11:54.46,Default,,0,0,0,,天狼之匣？
Dialogue: 0,0:11:55.00,0:11:57.55,Default,,0,0,0,,你怎麼還相信這種胡話
Dialogue: 0,0:11:57.55,0:12:00.22,Default,,0,0,0,,這並非是空穴來風
Dialogue: 0,0:12:00.80,0:12:04.85,Default,,0,0,0,,那是賜予我等繁榮的基石
Dialogue: 0,0:12:05.18,0:12:10.06,Default,,0,0,0,,仰仗汙穢的狼族的寶物 還敢大放厥詞
Dialogue: 0,0:12:10.73,0:12:17.15,Default,,0,0,0,,各位的意思是 我應該對同族走向滅亡袖手旁觀嗎
Dialogue: 0,0:12:17.44,0:12:20.82,Default,,0,0,0,,如果這就是宿命 也只有接受
Dialogue: 0,0:12:22.28,0:12:23.83,Default,,0,0,0,,站住 葉夫格拉夫
Dialogue: 0,0:12:24.49,0:12:25.66,Default,,0,0,0,,你這無禮之徒
Dialogue: 0,0:12:26.54,0:12:27.70,Default,,0,0,0,,根本談不下去
Dialogue: 0,0:12:31.54,0:12:32.58,Default,,0,0,0,,葉夫大人
Dialogue: 0,0:12:33.42,0:12:34.92,Default,,0,0,0,,葉夫大人 葉夫大人
Dialogue: 0,0:12:35.00,0:12:36.30,Default,,0,0,0,,聽我說聽我說
Dialogue: 0,0:12:40.59,0:12:42.22,Default,,0,0,0,,這真是個好消息
Dialogue: 0,0:12:44.30,0:12:48.14,Default,,0,0,0,,那些丟棄了吸血鬼的驕傲的老不死
Dialogue: 0,0:12:48.73,0:12:52.35,Default,,0,0,0,,他們想滅亡就老老實實等死吧
Dialogue: 0,0:13:12.54,0:13:13.92,Default,,0,0,0,,還是跟過來了
Dialogue: 0,0:13:22.88,0:13:23.38,Default,,0,0,0,,怎麼了
Dialogue: 0,0:13:24.59,0:13:25.43,Default,,0,0,0,,別在意
Dialogue: 0,0:13:26.35,0:13:27.43,Default,,0,0,0,,但我很在意
Dialogue: 0,0:13:28.14,0:13:31.89,Default,,0,0,0,,那我問你 為什麼你這次這麼主動
Dialogue: 0,0:13:33.44,0:13:37.57,Default,,0,0,0,,沒什麼 只是覺得能親手殺很多吸血鬼
Dialogue: 0,0:13:39.40,0:13:40.94,Default,,0,0,0,,不用這麼急嘛
Dialogue: 0,0:13:40.94,0:13:42.24,Default,,0,0,0,,怎麼能不急
Dialogue: 0,0:13:43.61,0:13:46.70,Default,,0,0,0,,我實在坐不住 而且…
Dialogue: 0,0:13:47.66,0:13:48.16,Default,,0,0,0,,而且？
Dialogue: 0,0:13:49.29,0:13:50.75,Default,,0,0,0,,不 沒什麼
Dialogue: 0,0:13:53.00,0:13:57.38,Default,,0,0,0,,而且 去了說不定能見到哥哥
Dialogue: 0,0:13:59.59,0:14:02.72,Default,,0,0,0,,白天也開門的話 就會有更多客人了吧
Dialogue: 0,0:14:03.59,0:14:06.72,Default,,0,0,0,,生意太好的話 其他工作就不方便了
Dialogue: 0,0:14:08.30,0:14:10.22,Default,,0,0,0,,我其實很高興
Dialogue: 0,0:14:11.39,0:14:12.98,Default,,0,0,0,,終於能為組織做貢獻了
Dialogue: 0,0:14:15.27,0:14:16.85,Default,,0,0,0,,別太專注在這事上了
Dialogue: 0,0:14:18.15,0:14:20.53,Default,,0,0,0,,他們跟人類的惡棍可不一樣
Dialogue: 0,0:14:29.28,0:14:30.45,Default,,0,0,0,,那真是太好了
Dialogue: 0,0:14:31.04,0:14:31.54,Default,,0,0,0,,真的嗎
Dialogue: 0,0:14:40.67,0:14:41.92,Default,,0,0,0,,你們是什麼人
Dialogue: 0,0:14:47.80,0:14:48.89,Default,,0,0,0,,天誅
Dialogue: 0,0:14:50.05,0:14:51.56,Default,,0,0,0,,吸血鬼分兩種
Dialogue: 0,0:14:52.31,0:14:55.35,Default,,0,0,0,,貴族種 和他們奴役的下等種
Dialogue: 0,0:14:56.44,0:14:57.44,Default,,0,0,0,,我們是這麼稱呼的
Dialogue: 0,0:14:58.81,0:15:02.36,Default,,0,0,0,,下等種會偽裝成人類 用特殊的鏡片保護眼睛
Dialogue: 0,0:15:03.23,0:15:06.78,Default,,0,0,0,,如果沒有鏡片 馬上就會被太陽光燒成灰燼
Dialogue: 0,0:15:07.41,0:15:08.16,Default,,0,0,0,,貴族種呢
Dialogue: 0,0:15:08.87,0:15:12.62,Default,,0,0,0,,即使不變回原本的怪物形態也有很強戰鬥力
Dialogue: 0,0:15:13.08,0:15:15.37,Default,,0,0,0,,在太陽光下也能自由行動
Dialogue: 0,0:15:16.25,0:15:19.88,Default,,0,0,0,,而且還神不知鬼不覺地混在人類之中
Dialogue: 0,0:15:20.54,0:15:21.71,Default,,0,0,0,,真叫人恐懼
Dialogue: 0,0:15:22.96,0:15:24.55,Default,,0,0,0,,所以查出來了嗎
Dialogue: 0,0:15:25.01,0:15:28.47,Default,,0,0,0,,嗯 聽說在帝都失去藏身之所的百虎黨
Dialogue: 0,0:15:28.47,0:15:32.31,Default,,0,0,0,,最近資助方也停止了資金援助
Dialogue: 0,0:15:32.89,0:15:34.52,Default,,0,0,0,,那個資助方是？
Dialogue: 0,0:15:35.47,0:15:36.68,Default,,0,0,0,,正如你所料
Dialogue: 0,0:15:37.85,0:15:38.90,Default,,0,0,0,,阿爾瑪商會
Dialogue: 0,0:15:43.02,0:15:43.82,Default,,0,0,0,,借用一下電話
Dialogue: 0,0:15:45.90,0:15:47.32,Default,,0,0,0,,真奇怪
Dialogue: 0,0:15:47.78,0:15:51.12,Default,,0,0,0,,頭兒 這幫人死了也沒變成灰啊
Dialogue: 0,0:15:51.37,0:15:53.20,Default,,0,0,0,,是不是還沒死透啊
Dialogue: 0,0:15:55.24,0:15:59.75,Default,,0,0,0,,一群怪物又花錢僱人工作 跟打發我們一樣嗎
Dialogue: 0,0:16:04.71,0:16:06.30,Default,,0,0,0,,克什納在哪裡
Dialogue: 0,0:16:06.30,0:16:07.26,Default,,0,0,0,,我不知道
Dialogue: 0,0:16:11.09,0:16:12.14,Default,,0,0,0,,克什納呢？
Dialogue: 0,0:16:12.14,0:16:15.06,Default,,0,0,0,,老闆去御殿場看新武器實驗
Dialogue: 0,0:16:15.51,0:16:16.64,Default,,0,0,0,,新武器？
Dialogue: 0,0:16:17.85,0:16:19.73,Default,,0,0,0,,跟我好好說說
Dialogue: 0,0:16:20.94,0:16:24.07,Default,,0,0,0,,爬山路前要停下車 連接輔助火車頭
Dialogue: 0,0:16:24.57,0:16:24.94,Default,,0,0,0,,這樣啊
Dialogue: 0,0:16:27.44,0:16:30.49,Default,,0,0,0,,兩位真巧啊 能在一列車裡碰上
Dialogue: 0,0:16:30.70,0:16:32.78,Default,,0,0,0,,我也正在去箱根的路上
Dialogue: 0,0:16:34.74,0:16:35.91,Default,,0,0,0,,不對啊
Dialogue: 0,0:16:35.91,0:16:37.66,Default,,0,0,0,,看起來好好吃
Dialogue: 0,0:16:37.66,0:16:39.08,Default,,0,0,0,,可不能吃得太猛啊
Dialogue: 0,0:16:39.41,0:16:41.08,Default,,0,0,0,,臉上沾了多少飯粒呀
Dialogue: 0,0:16:41.75,0:16:46.21,Default,,0,0,0,,我剛剛買了便當 尤里你們要不要一起…
Dialogue: 0,0:16:47.09,0:16:47.84,Default,,0,0,0,,就是這個
Dialogue: 0,0:16:50.34,0:16:51.01,Default,,0,0,0,,幫我接通電話
Dialogue: 0,0:16:51.47,0:16:52.43,Default,,0,0,0,,是少佐閣下嗎
Dialogue: 0,0:16:52.68,0:16:55.10,Default,,0,0,0,,嗯 是我 帝都情況有異嗎
Dialogue: 0,0:16:55.11,0:16:56.85,Default,,0,0,0,,富士那裡演習出大事故了
Dialogue: 0,0:16:57.68,0:16:59.27,Default,,0,0,0,,望月 冷靜下來仔細說
Dialogue: 0,0:16:59.48,0:17:02.81,Default,,0,0,0,,反正富士的一個步兵大隊已經被摧毀了
Dialogue: 0,0:17:03.27,0:17:03.73,Default,,0,0,0,,什麼
Dialogue: 0,0:17:04.27,0:17:07.32,Default,,0,0,0,,我們剛剛偵聽到了御殿場發往首府的無線電
Dialogue: 0,0:17:07.98,0:17:09.40,Default,,0,0,0,,昨晚20點30分左右
Dialogue: 0,0:17:09.74,0:17:12.99,Default,,0,0,0,,富士裾野進行的演習發生了某些意外
Dialogue: 0,0:17:13.36,0:17:15.83,Default,,0,0,0,,參加的士兵士官全部死亡
Dialogue: 0,0:17:16.87,0:17:18.12,Default,,0,0,0,,柿崎少將沒事吧？
Dialogue: 0,0:17:18.62,0:17:19.54,Default,,0,0,0,,少將閣下平安
Dialogue: 0,0:17:20.12,0:17:21.25,Default,,0,0,0,,聽說為了今天上奏
Dialogue: 0,0:17:21.62,0:17:23.54,Default,,0,0,0,,早已搭乘臨時列車上京了
Dialogue: 0,0:17:28.63,0:17:29.30,Default,,0,0,0,,列車？
Dialogue: 0,0:17:32.76,0:17:35.01,Default,,0,0,0,,少佐閣下 伊庭少佐閣下
Dialogue: 0,0:17:37.22,0:17:38.22,Default,,0,0,0,,怎麼了 尤里
Dialogue: 0,0:17:42.27,0:17:43.44,Default,,0,0,0,,我聞到了血腥味
Dialogue: 0,0:17:45.69,0:17:47.11,Default,,0,0,0,,等我一下 尤里
Dialogue: 0,0:17:47.65,0:17:48.86,Default,,0,0,0,,謝謝惠顧
Dialogue: 0,0:17:51.99,0:17:52.95,Default,,0,0,0,,尤里 等我
Dialogue: 0,0:18:21.18,0:18:22.56,Default,,0,0,0,,聽說人給殺光了
Dialogue: 0,0:18:22.56,0:18:23.18,Default,,0,0,0,,教授
Dialogue: 0,0:18:23.39,0:18:24.44,Default,,0,0,0,,抱歉我們遲到了
Dialogue: 0,0:18:25.06,0:18:26.35,Default,,0,0,0,,這才是百虎黨的作風
Dialogue: 0,0:18:26.44,0:18:27.27,Default,,0,0,0,,真是心狠手辣
Dialogue: 0,0:18:27.52,0:18:29.11,Default,,0,0,0,,光天化日下也敢這樣
Dialogue: 0,0:18:29.44,0:18:32.36,Default,,0,0,0,,感覺是來要錢卻被拒絕了吧
Dialogue: 0,0:18:33.03,0:18:34.78,Default,,0,0,0,,如果錢要不到的話怎麼辦
Dialogue: 0,0:18:35.20,0:18:36.78,Default,,0,0,0,,要貨 要零件…
Dialogue: 0,0:18:38.16,0:18:38.45,Default,,0,0,0,,教授
Dialogue: 0,0:18:39.74,0:18:41.37,Default,,0,0,0,,趕快和尤里他們會合
Dialogue: 0,0:18:47.29,0:18:50.54,Default,,0,0,0,,尤里是不是有東西落在東京了啊
Dialogue: 0,0:18:50.25,0:18:54.09,Comment,,0,0,0,,打擾 請讓我檢查下車票
Dialogue: 0,0:18:54.97,0:18:57.30,Default,,0,0,0,,對不起 我是換乘上來的
Dialogue: 0,0:18:57.93,0:18:59.47,Default,,0,0,0,,可不可以現在買新票？
Dialogue: 0,0:19:05.23,0:19:06.81,Default,,0,0,0,,我記得包裡還有…
Dialogue: 0,0:19:14.32,0:19:15.86,Default,,0,0,0,,想來一份便當嗎
Dialogue: 0,0:19:24.58,0:19:26.21,Default,,0,0,0,,站住 什麼人
Dialogue: 0,0:19:27.08,0:19:28.25,Default,,0,0,0,,我是參謀本部的伊庭
Dialogue: 0,0:19:28.79,0:19:30.67,Default,,0,0,0,,從國府津站上車執行特殊任務
Dialogue: 0,0:19:31.71,0:19:32.04,Default,,0,0,0,,是
Dialogue: 0,0:19:32.88,0:19:35.38,Default,,0,0,0,,柿崎少將閣下在哪裡
Dialogue: 0,0:19:47.60,0:19:49.69,Default,,0,0,0,,接著 新車票
Dialogue: 0,0:19:50.48,0:19:51.02,Default,,0,0,0,,謝謝
Dialogue: 0,0:19:51.52,0:19:56.32,Default,,0,0,0,,我該怎麼跟教授解釋 突然放棄任務的原因呢
Dialogue: 0,0:19:57.32,0:19:59.66,Default,,0,0,0,,這列列車裡有吸血鬼
Dialogue: 0,0:20:01.07,0:20:03.16,Default,,0,0,0,,剛剛的煙氣讓我無法繼續追查
Dialogue: 0,0:20:03.95,0:20:04.74,Default,,0,0,0,,但我不會判斷錯
Dialogue: 0,0:20:09.00,0:20:10.71,Default,,0,0,0,,在這裡發生戰鬥會很不方便
Dialogue: 0,0:20:11.46,0:20:13.38,Default,,0,0,0,,我去檢查一下乘客的數量和位置
Dialogue: 0,0:20:13.88,0:20:14.92,Default,,0,0,0,,尤里 你就待在這裡
Dialogue: 0,0:20:15.42,0:20:16.46,Default,,0,0,0,,不 我跟你去…
Dialogue: 0,0:20:16.46,0:20:17.30,Default,,0,0,0,,你待在這裡
Dialogue: 0,0:20:17.84,0:20:20.55,Default,,0,0,0,,要是你又跳進別的列車 我可受不了
Dialogue: 0,0:20:22.14,0:20:22.68,Default,,0,0,0,,知道了
Dialogue: 0,0:20:23.35,0:20:23.89,Default,,0,0,0,,真乖
Dialogue: 0,0:20:32.94,0:20:37.40,Default,,0,0,0,,實驗一眨眼結束 我還沒來得及細細採集數據
Dialogue: 0,0:20:37.82,0:20:39.99,Default,,0,0,0,,但結果就是最無可辯駁的答案
Dialogue: 0,0:20:41.78,0:20:43.66,Default,,0,0,0,,克什納大人給口頭保證了
Dialogue: 0,0:20:43.99,0:20:49.12,Default,,0,0,0,,那我一回東京就能開始量產了吧
Dialogue: 0,0:20:52.17,0:20:54.63,Default,,0,0,0,,想不到居然要指望這種男人
Dialogue: 0,0:20:55.67,0:20:57.59,Default,,0,0,0,,不過葉夫格拉夫大人
Dialogue: 0,0:20:58.21,0:21:02.38,Default,,0,0,0,,為什麼總對不明所以的匣子念念不忘
Dialogue: 0,0:21:03.93,0:21:09.43,Default,,0,0,0,,我更喜歡眼見為憑 而非無法確定的東西
Dialogue: 0,0:21:41.59,0:21:42.80,Default,,0,0,0,,謝謝你 哥哥
Dialogue: 0,0:23:31.37,0:23:32.96,Default,,0,0,0,,原來是之前的麻煩鬼
Dialogue: 0,0:23:31.92,0:23:33.25,Comment,,0,0,0,,不是吸血鬼嗎
Dialogue: 0,0:23:33.25,0:23:37.34,Default,,0,0,0,,十年了 找了我好久
Dialogue: 0,0:23:35.50,0:23:38.34,Comment,,0,0,0,,那就來亮相吧
Dialogue: 0,0:23:38.34,0:23:39.92,Default,,0,0,0,,我這就讓你解脫
