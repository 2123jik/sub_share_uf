1 end    c_t = 0 n = #c_point_x if n ~= 0 then  while c_t <= 1 do m = m + 1  pos_x[m], pos_y[m] = Bezier(n,c_point_x,c_point_y,c_t)   n_x, n_y = Bezier(n,c_point_x,c_point_y,c_t+0.1) dist = math.sqrt(math.abs(n_x-pos_x[m])^2+math.abs(n_y-pos_y[m])^2) c_t = c_t + max_space/dist*0.1 end end end maxloop(m) end retime("preline",s_time+dur*(t^accel),600) t = t + 1/m adjust_x = -(max_x - min_x) / 2 - min_x adjust_y = -(max_y - min_y) / 2 - min_y  return  string.format("\\pos(%0.2f,%0.2f)",pos_x[j],pos_y[j]) end
Comment: 0,0:00:00.00,0:00:00.00,JOJO5-op1-ch-2,,0,0,0,code syl noblank,style=line.styleref shape=_G.Yutils.decode.create_font(style.fontname, style.bold, style.italic, style.underline, style.strikeout,style.fontsize).text_to_shape(syl.text_stripped,1)  shape=_G.Yutils.shape.move(shape,line.left+syl.left,line.top) shape=string.gsub(shape,"c","")
