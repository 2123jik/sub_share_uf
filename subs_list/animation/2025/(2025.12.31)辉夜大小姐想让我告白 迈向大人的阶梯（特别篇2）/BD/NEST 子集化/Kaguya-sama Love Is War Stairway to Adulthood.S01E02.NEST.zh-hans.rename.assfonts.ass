Dialogue: 1,0:26:55.01,0:27:01.77,Title,,0,0,0,,{\bord3\fs290\3c&H2408E0&\fscx115\fscy105\c&H000000&\1a&HFF&\pos(1478.67,442.66)}♥
Comment: 0,0:00:00.76,0:00:02.96,Dial-CN,,0,0,0,,========Dialog========
Dialogue: 1,0:00:00.84,0:00:03.05,Dial-CN,,0,0,0,,我今天要和燕学姐…
Dialogue: 1,0:00:03.05,0:00:05.22,Dial-CN,,0,0,0,,和应援团的成员一起唱卡拉OK
Dialogue: 1,0:00:05.22,0:00:06.59,Dial-CN,,0,0,0,,所以要先走了
Dialogue: 1,0:00:08.89,0:00:10.89,Dial-CN,,0,0,0,,这周是巡逻强化周
Dialogue: 1,0:00:10.89,0:00:12.26,Dial-CN,,0,0,0,,今天就先告辞了
Dialogue: 1,0:00:13.99,0:00:17.39,Dial-CN,,0,0,0,,我要和TG社的大家一起玩太空狼人杀
Dialogue: 1,0:00:20.00,0:00:21.06,Dial-CN,,0,0,0,,下周见
Dialogue: 1,0:00:24.28,0:00:25.53,Dial-CN,,0,0,0,,剩我们两个了
Dialogue: 1,0:00:25.53,0:00:26.90,Dial-CN,,0,0,0,,剩我们两个
Dialogue: 1,0:00:26.90,0:00:27.53,Dial-CN,,0,0,0,,怎么了
Dialogue: 1,0:00:28.20,0:00:30.01,Dial-CN,,0,0,0,,不…那个…
Dialogue: 1,0:00:33.33,0:00:35.41,Dial-CN,,0,0,0,,我实在太傻了
Dialogue: 1,0:00:35.66,0:00:36.50,Dial-CN,,0,0,0,,四宫
Dialogue: 1,0:00:37.00,0:00:40.30,Dial-CN,,0,0,0,,没什么 我只是有点想太多了
Dialogue: 1,0:00:41.17,0:00:42.21,Dial-CN,,0,0,0,,会长
Dialogue: 1,0:00:42.75,0:00:44.67,Dial-CN,,0,0,0,,就我们两人一起回去吧
Dialogue: 1,0:00:49.09,0:00:50.03,Dial-CN,,0,0,0,,对了
Dialogue: 1,0:00:50.03,0:00:52.63,Dial-CN,,0,0,0,,早坂现在不在你家了 不要紧吧
Dialogue: 1,0:00:53.10,0:00:56.04,Dial-CN,,0,0,0,,虽然有派新的随从过来了
Dialogue: 1,0:00:56.04,0:00:59.23,Dial-CN,,0,0,0,,但八成也是兄长那边的人吧
Dialogue: 1,0:00:59.60,0:01:01.48,Dial-CN,,0,0,0,,连喘口气的时间都没有
Dialogue: 1,0:01:05.36,0:01:06.54,Dial-CN,,0,0,0,,要是
Dialogue: 1,0:01:07.82,0:01:10.49,Dial-CN,,0,0,0,,这条回家路能永远继续下去就好了
Dialogue: 1,0:01:15.33,0:01:18.29,Dial-CN,,0,0,0,,那今天要不要来我家吃顿饭再走
Dialogue: 1,0:01:18.71,0:01:20.62,Dial-CN,,0,0,0,,你还没来我的新家看过吧
Dialogue: 1,0:01:21.00,0:01:23.39,Dial-CN,,0,0,0,,我老爸今晚有酒局 天亮才会回来
Dialogue: 1,0:01:23.39,0:01:26.07,Dial-CN,,0,0,0,,可以吃圭的料理吗 真不错呢
Dialogue: 1,0:01:28.46,0:01:29.75,Dial-CN,,0,0,0,,你看 四宫
Dialogue: 1,0:01:30.07,0:01:31.38,Dial-CN,,0,0,0,,是自动锁哦
Dialogue: 1,0:01:31.38,0:01:32.64,Dial-CN,,0,0,0,,这样就能放心了呢
Dialogue: 1,0:01:32.64,0:01:34.55,Dial-CN,,0,0,0,,还有电梯哦
Dialogue: 1,0:01:34.55,0:01:35.76,Dial-CN,,0,0,0,,这样真轻松呢
Dialogue: 1,0:01:36.08,0:01:39.43,Dial-CN,,0,0,0,,然后是我的房间
Dialogue: 1,0:01:40.48,0:01:42.77,Dial-CN,,0,0,0,,之前都和圭睡同个房间
Dialogue: 1,0:01:43.61,0:01:46.52,Dial-CN,,0,0,0,,能感情融洽地共处一室也很好就是了
Dialogue: 1,0:01:48.09,0:01:49.23,Dial-CN,,0,0,0,,还换了张新床
Dialogue: 1,0:01:49.23,0:01:50.58,Dial-CN,,0,0,0,,睡起来很舒服哦
Dialogue: 1,0:01:52.95,0:01:53.80,Dial-CN,,0,0,0,,糟糕
Dialogue: 1,0:01:53.80,0:01:56.10,Dial-CN,,0,0,0,,刚才那句话感觉会让人想歪
Dialogue: 1,0:01:56.10,0:01:57.91,Dial-CN,,0,0,0,,得想办法蒙混过去
Dialogue: 1,0:01:58.33,0:02:00.37,Dial-CN,,0,0,0,,抱歉 我没有其他意思
Dialogue: 1,0:02:00.37,0:02:02.46,Dial-CN,,0,0,0,,我知道 我知道
Dialogue: 1,0:02:02.46,0:02:05.04,Dial-CN,,0,0,0,,话说回来 小圭怎么还没回来啊
Dialogue: 1,0:02:05.04,0:02:06.88,Dial-CN,,0,0,0,,这样会拖延到晚餐时间的
Dialogue: 1,0:02:12.87,0:02:15.76,Dial-CN,,0,0,0,,圭说要在藤原家过夜
Dialogue: 1,0:02:16.93,0:02:19.05,Dial-CN,,0,0,0,,我老爸今晚也不会回家
Dialogue: 1,0:02:24.56,0:02:26.44,Dial-CN,,0,0,0,,我看今天就先算了吧
Dialogue: 1,0:02:26.44,0:02:27.57,Dial-CN,,0,0,0,,改天再找个时间…
Dialogue: 1,0:02:27.57,0:02:28.58,Dial-CN,,0,0,0,,这样啊
Dialogue: 1,0:02:30.49,0:02:33.20,Dial-CN,,0,0,0,,我回去会比较好吗
Dialogue: 1,0:02:35.37,0:02:39.75,Dial-CN,,0,0,0,,我完全不晓得这种时候该怎么做才好
Dialogue: 1,0:02:40.14,0:02:43.46,Dial-CN,,0,0,0,,其实 这方面我也没经验
Dialogue: 1,0:02:45.29,0:02:46.15,Dial-CN,,0,0,0,,那我看
Dialogue: 1,0:02:51.88,0:02:52.84,Dial-CN,,0,0,0,,要住一晚吗
Dialogue: 1,0:02:52.84,0:02:54.88,Dial-CN,,0,0,0,,对孤男寡女来说
Dialogue: 1,0:02:54.88,0:02:59.18,Dial-CN,,0,0,0,,这正是恋爱头脑战的关键局面之开端
Dialogue: 1,0:04:51.83,0:04:53.04,Dial-CN,,0,0,0,,洗澡水加热完毕
Dialogue: 1,0:04:58.80,0:05:00.03,Dial-CN,,0,0,0,,你先去洗吧
Dialogue: 1,0:05:00.28,0:05:02.01,Dial-CN,,0,0,0,,我先替你准备换洗衣物和牙刷
Dialogue: 1,0:05:02.43,0:05:04.28,Dial-CN,,0,0,0,,睡衣穿圭的可以吧
Dialogue: 1,0:05:04.28,0:05:06.81,Dial-CN,,0,0,0,,穿我的可能有点太大了
Dialogue: 1,0:05:09.14,0:05:10.29,Dial-CN,,0,0,0,,会长的睡衣…
Dialogue: 1,0:05:13.44,0:05:15.11,Dial-CN,,0,0,0,,会长的睡衣
Dialogue: 1,0:05:15.53,0:05:17.30,Dial-CN,,0,0,0,,比较好
Dialogue: 1,0:05:20.78,0:05:22.30,Dial-CN,,0,0,0,,知道了 那我去准备
Dialogue: 1,0:05:25.28,0:05:26.31,Dial-CN,,0,0,0,,老爸 你在哪
Dialogue: 1,0:05:27.37,0:05:30.50,Dial-CN,,0,0,0,,我正在跟直播者们在六本木喝酒
Dialogue: 1,0:05:30.86,0:05:33.63,Dial-CN,,0,0,0,,每10分钟就有人来灌我龙舌兰
Dialogue: 1,0:05:33.63,0:05:35.96,Dial-CN,,0,0,0,,我对年轻人的调调没辙 想回家去了
Dialogue: 1,0:05:36.80,0:05:37.96,Dial-CN,,0,0,0,,你要回来吗
Dialogue: 1,0:05:40.32,0:05:41.18,Dial-CN,,0,0,0,,是这么回事啊
Dialogue: 1,0:05:41.18,0:05:42.32,Dial-CN,,0,0,0,,知道了知道了
Dialogue: 1,0:05:42.32,0:05:43.68,Dial-CN,,0,0,0,,那我今晚绝对不会回家
Dialogue: 1,0:05:43.68,0:05:46.33,Dial-CN,,0,0,0,,大不了我找地方消磨时间到天亮 你们慢慢来吧
Dialogue: 1,0:05:46.33,0:05:48.14,Dial-CN,,0,0,0,,替我向辉夜问好啊
Dialogue: 1,0:05:48.14,0:05:51.52,Dial-CN,,0,0,0,,不是啦 事情不是你想的那样
Dialogue: 1,0:05:51.52,0:05:54.33,Dial-CN,,0,0,0,,感谢我这个明事理的父亲吧
Dialogue: 1,0:05:55.90,0:05:58.11,Dial-CN,,0,0,0,,跟萌叶和小圭会合了
Dialogue: 1,0:05:58.11,0:05:59.94,Dial-CN,,0,0,0,,我们要一起玩太空杀手
Dialogue: 1,0:06:00.70,0:06:03.41,Dial-CN,,0,0,0,,圭好像也真的在藤原家
Dialogue: 1,0:06:03.41,0:06:04.91,Dial-CN,,0,0,0,,不会有人来碍事
Dialogue: 1,0:06:05.28,0:06:06.35,Dial-CN,,0,0,0,,怎么办
Dialogue: 1,0:06:06.70,0:06:08.16,Dial-CN,,0,0,0,,这样下去会怎么样
Dialogue: 1,0:06:08.16,0:06:10.35,Dial-CN,,0,0,0,,现在选择冲一波会不会太操之过急
Dialogue: 1,0:06:11.83,0:06:14.35,Dial-CN,,0,0,0,,不 别给自己太大的压力
Dialogue: 1,0:06:14.77,0:06:17.81,Dial-CN,,0,0,0,,只要接受自然发生的结果就行了
Dialogue: 1,0:06:18.05,0:06:19.99,Dial-CN,,0,0,0,,万一发生了就让它发生吧
Dialogue: 1,0:06:21.97,0:06:24.95,Dial-CN,,0,0,0,,不过 姑且先做好准备吧
Dialogue: 1,0:06:27.14,0:06:28.81,Dial-CN,,0,0,0,,味道OK
Dialogue: 1,0:06:29.35,0:06:32.19,Dial-CN,,0,0,0,,床单才刚换好 OK
Dialogue: 1,0:06:32.77,0:06:33.46,Dial-CN,,0,0,0,,套子
Dialogue: 1,0:06:33.46,0:06:34.81,Dial-CN,,0,0,0,,是大约一年前买的
Dialogue: 1,0:06:34.81,0:06:37.17,Dial-CN,,0,0,0,,结果只有吹着玩过一阵子
Dialogue: 1,0:06:37.17,0:06:38.18,Dial-CN,,0,0,0,,OK
Dialogue: 1,0:06:38.65,0:06:41.33,Dial-CN,,0,0,0,,这是九成男孩的必经之路
Dialogue: 1,0:06:42.38,0:06:44.86,Dial-CN,,0,0,0,,四宫快洗完澡走出来了
Dialogue: 1,0:06:44.86,0:06:48.59,Dial-CN,,0,0,0,,怎么办 还需要准备什么
Dialogue: 1,0:06:49.20,0:06:49.87,Dial-CN,,0,0,0,,会长
Dialogue: 1,0:06:51.07,0:06:53.46,Dial-CN,,0,0,0,,四宫穿着我的衬衫
Dialogue: 1,0:06:54.62,0:06:56.93,Dial-CN,,0,0,0,,会长也去洗吧
Dialogue: 1,0:06:58.21,0:06:58.96,Dial-CN,,0,0,0,,好
Dialogue: 1,0:07:08.68,0:07:10.00,Dial-CN,,0,0,0,,现在的情况…
Dialogue: 1,0:07:10.41,0:07:12.62,Dial-CN,,0,0,0,,是那种发展没错吧
Dialogue: 1,0:07:12.81,0:07:14.58,Dial-CN,,0,0,0,,终于要变成那样了
Dialogue: 1,0:07:14.89,0:07:17.94,Dial-CN,,0,0,0,,我姑且有先预习过整个流程了
Dialogue: 1,0:07:17.94,0:07:19.79,Dial-CN,,0,0,0,,应该不会出糗才对
Dialogue: 1,0:07:20.13,0:07:21.92,Dial-CN,,0,0,0,,第一次的实际进行
Dialogue: 1,0:07:22.73,0:07:24.11,Dial-CN,,0,0,0,,好可怕
Dialogue: 1,0:07:24.42,0:07:26.91,Dial-CN,,0,0,0,,话说回来 突然决定要留下来过夜
Dialogue: 1,0:07:26.91,0:07:29.34,Dial-CN,,0,0,0,,不晓得会长有没有做好准备
Dialogue: 1,0:07:31.33,0:07:35.87,Dial-CN,,0,0,0,,不过 早坂姑且有让我带这个过来当护身符了
Dialogue: 1,0:07:36.83,0:07:38.63,Dial-CN,,0,0,0,,到时候该怎么办
Dialogue: 1,0:07:38.63,0:07:40.44,Dial-CN,,0,0,0,,要对他说「这个请拿去用」吗
Dialogue: 1,0:07:40.44,0:07:44.44,Dial-CN,,0,0,0,,他会不会觉得我是随身携带防护措施的下流女人啊
Dialogue: 1,0:07:45.17,0:07:49.32,Dial-CN,,0,0,0,,有没有…有没有其他需要准备的事啊
Dialogue: 1,0:07:49.32,0:07:52.45,Dial-CN,,0,0,0,,这是九成女孩的必经之路
Dialogue: 1,0:07:57.10,0:07:58.03,Dial-CN,,0,0,0,,洗好了
Dialogue: 1,0:08:06.99,0:08:09.07,Dial-CN,,0,0,0,,对了 可能是因为放连假
Dialogue: 1,0:08:09.07,0:08:11.16,Dial-CN,,0,0,0,,大家都有事提前回去了呢
Dialogue: 1,0:08:11.16,0:08:13.70,Dial-CN,,0,0,0,,石上今天也和子安学姐他们有约
Dialogue: 1,0:08:14.66,0:08:16.29,Dial-CN,,0,0,0,,这件事我有听说
Dialogue: 1,0:08:16.48,0:08:18.67,Dial-CN,,0,0,0,,他们好像还有在连络 让我放心了
Dialogue: 1,0:08:18.67,0:08:19.83,Dial-CN,,0,0,0,,保持平常心
Dialogue: 1,0:08:19.83,0:08:22.99,Dial-CN,,0,0,0,,他还被藤原跟伊井野调侃了一番呢
Dialogue: 1,0:08:22.99,0:08:24.48,Dial-CN,,0,0,0,,是啊
Dialogue: 1,0:08:24.48,0:08:27.30,Dial-CN,,0,0,0,,看石上同学那样故作坚强…
Dialogue: 1,0:08:25.09,0:08:26.34,Dial-CN-Top,,0,0,0,,保持平常心
Dialogue: 1,0:08:31.26,0:08:32.72,Dial-CN,,0,0,0,,保持平常心
Dialogue: 1,0:08:35.93,0:08:37.35,Dial-CN,,0,0,0,,保持平常心
Dialogue: 1,0:08:40.50,0:08:41.90,Dial-CN,,0,0,0,,保持平常心
Dialogue: 1,0:08:43.82,0:08:45.04,Dial-CN,,0,0,0,,是啊
Dialogue: 1,0:08:45.04,0:08:46.69,Dial-CN,,0,0,0,,然后是…
Dialogue: 1,0:08:46.69,0:08:49.03,Dial-CN,,0,0,0,,根本没有那种气氛啊
Dialogue: 1,0:08:49.03,0:08:50.88,Dial-CN,,0,0,0,,可以跟风纪委员合作…
Dialogue: 1,0:08:50.88,0:08:53.17,Dial-CN,,0,0,0,,怎么办 该怎么办
Dialogue: 1,0:08:54.99,0:08:56.00,Dial-CN,,0,0,0,,四宫
Dialogue: 1,0:08:56.52,0:08:57.31,Dial-CN,,0,0,0,,你想睡了吗
Dialogue: 1,0:08:58.21,0:08:59.25,Dial-CN,,0,0,0,,有一点
Dialogue: 1,0:08:59.25,0:09:01.92,Dial-CN,,0,0,0,,平常这个时间我已经上床睡觉了
Dialogue: 1,0:09:05.38,0:09:09.51,Dial-CN,,0,0,0,,四宫应该 也不是抱着那种打算过来的
Dialogue: 1,0:09:10.84,0:09:12.72,Dial-CN,,0,0,0,,我们只要慢慢来就行了
Dialogue: 1,0:09:15.85,0:09:17.48,Dial-CN,,0,0,0,,也差不多该睡了
Dialogue: 1,0:09:18.18,0:09:19.77,Dial-CN,,0,0,0,,我去客厅铺床
Dialogue: 1,0:09:20.35,0:09:21.60,Dial-CN,,0,0,0,,客厅
Dialogue: 1,0:09:23.36,0:09:26.32,Dial-CN,,0,0,0,,真该庆幸我是个胆小鬼呢 四宫
Dialogue: 1,0:09:27.19,0:09:30.36,Dial-CN,,0,0,0,,今天我们一起吃披萨 一起看电影
Dialogue: 1,0:09:30.36,0:09:31.63,Dial-CN,,0,0,0,,开心地谈天说地
Dialogue: 1,0:09:32.41,0:09:33.66,Dial-CN,,0,0,0,,这样就很好了
Dialogue: 1,0:09:53.64,0:09:56.58,Dial-CN,,0,0,0,,我还想再跟你讲讲话
Dialogue: 1,0:09:57.22,0:09:59.89,Dial-CN,,0,0,0,,可以来你这边睡吗
Dialogue: 1,0:10:09.86,0:10:11.13,Dial-CN,,0,0,0,,会很挤吗
Dialogue: 1,0:10:11.28,0:10:12.99,Dial-CN,,0,0,0,,不 不要紧…
Dialogue: 1,0:10:16.41,0:10:18.17,Dial-CN,,0,0,0,,是有一点点挤
Dialogue: 1,0:10:20.91,0:10:23.62,Dial-CN,,0,0,0,,那么 要再靠过来一点吗
Dialogue: 1,0:10:26.17,0:10:26.88,Dial-CN,,0,0,0,,好
Dialogue: 1,0:10:41.06,0:10:42.18,Dial-CN,,0,0,0,,四宫
Dialogue: 1,0:11:17.72,0:11:18.43,Dial-CN,,0,0,0,,抱歉
Dialogue: 1,0:11:18.80,0:11:20.66,Dial-CN,,0,0,0,,不 不是的
Dialogue: 1,0:11:22.14,0:11:23.89,Dial-CN,,0,0,0,,我看还是算了吧
Dialogue: 1,0:11:25.19,0:11:28.02,Dial-CN,,0,0,0,,可是 会长你想要吧
Dialogue: 1,0:11:28.48,0:11:29.27,Dial-CN,,0,0,0,,不
Dialogue: 1,0:11:30.15,0:11:33.32,Dial-CN,,0,0,0,,虽然也不是不想要
Dialogue: 1,0:11:34.03,0:11:36.45,Dial-CN,,0,0,0,,但如果你不愿意的话…
Dialogue: 1,0:11:40.68,0:11:42.68,Dial-CN,,0,0,0,,这种事本来就没必要焦急
Dialogue: 1,0:11:43.08,0:11:43.91,Dial-CN,,0,0,0,,下次再找机会…
Dialogue: 1,0:11:43.91,0:11:45.41,Dial-CN,,0,0,0,,下次是什么时候
Dialogue: 1,0:11:47.04,0:11:49.21,Dial-CN,,0,0,0,,不焦急真的好吗
Dialogue: 1,0:11:50.25,0:11:52.69,Dial-CN,,0,0,0,,你很快就要去美国了
Dialogue: 1,0:11:53.34,0:11:56.70,Dial-CN,,0,0,0,,我们已经没有太多时间了
Dialogue: 1,0:11:57.18,0:11:59.05,Dial-CN,,0,0,0,,感到焦急会很奇怪吗
Dialogue: 1,0:12:01.10,0:12:03.52,Dial-CN,,0,0,0,,四宫 把衣服穿好
Dialogue: 1,0:12:03.85,0:12:04.70,Dial-CN,,0,0,0,,坐好听我说
Dialogue: 1,0:12:08.90,0:12:10.04,Dial-CN,,0,0,0,,我跟你说 四宫
Dialogue: 1,0:12:10.90,0:12:12.38,Dial-CN,,0,0,0,,就算我去了美国
Dialogue: 1,0:12:12.38,0:12:14.00,Dial-CN,,0,0,0,,我们也一样是情侣
Dialogue: 1,0:12:14.00,0:12:16.11,Dial-CN,,0,0,0,,而且我时不时就会回来
Dialogue: 1,0:12:16.57,0:12:17.41,Dial-CN,,0,0,0,,等我回来后
Dialogue: 1,0:12:17.41,0:12:19.28,Dial-CN,,0,0,0,,时间就真的要多少有多少了
Dialogue: 1,0:12:19.62,0:12:20.41,Dial-CN,,0,0,0,,我有说错吗
Dialogue: 1,0:12:21.12,0:12:22.72,Dial-CN,,0,0,0,,但一去就是四年啊
Dialogue: 1,0:12:23.41,0:12:25.14,Dial-CN,,0,0,0,,你在那段期间
Dialogue: 1,0:12:25.62,0:12:28.50,Dial-CN,,0,0,0,,说不定会在那里遇见喜欢的对象
Dialogue: 1,0:12:29.79,0:12:32.13,Dial-CN,,0,0,0,,我当然会感到焦急啊
Dialogue: 1,0:12:33.05,0:12:36.74,Dial-CN,,0,0,0,,所以我才希望能和你建立起某种连系
Dialogue: 1,0:12:37.34,0:12:38.38,Dial-CN,,0,0,0,,四宫
Dialogue: 1,0:12:39.01,0:12:41.01,Dial-CN,,0,0,0,,因为讲出来会对我不利
Dialogue: 1,0:12:41.01,0:12:42.74,Dial-CN,,0,0,0,,所以我本来不想说的
Dialogue: 1,0:12:43.60,0:12:45.81,Dial-CN,,0,0,0,,不让男人尝到女人的滋味
Dialogue: 1,0:12:45.81,0:12:47.52,Dial-CN,,0,0,0,,反而更不会外遇哦
Dialogue: 1,0:12:48.89,0:12:50.75,Dial-CN,,0,0,0,,是这样吗
Dialogue: 1,0:12:50.75,0:12:52.02,Dial-CN,,0,0,0,,就是这么回事
Dialogue: 1,0:12:52.75,0:12:55.03,Dial-CN,,0,0,0,,不管做不做结果都一样
Dialogue: 1,0:12:55.65,0:12:56.76,Dial-CN,,0,0,0,,这种事
Dialogue: 1,0:12:56.76,0:12:59.36,Dial-CN,,0,0,0,,等你有那个意思时再说就行了
Dialogue: 1,0:13:00.76,0:13:02.20,Dial-CN,,0,0,0,,没有焦急的必要
Dialogue: 1,0:13:03.91,0:13:05.12,Dial-CN,,0,0,0,,会长
Dialogue: 1,0:13:08.77,0:13:10.50,Dial-CN,,0,0,0,,既然你都这么说了
Dialogue: 1,0:13:10.92,0:13:14.17,Dial-CN,,0,0,0,,就请再给我一点时间做心理准备吧
Dialogue: 1,0:13:15.13,0:13:15.71,Dial-CN,,0,0,0,,好
Dialogue: 1,0:13:17.09,0:13:18.22,Dial-CN,,0,0,0,,今天就先睡吧
Dialogue: 1,0:13:19.26,0:13:21.55,Dial-CN,,0,0,0,,起床后再一起去吃点好吃的东西吧
Dialogue: 1,0:13:30.10,0:13:31.34,Dial-CN,,0,0,0,,我好喜欢会长
Dialogue: 1,0:13:31.94,0:13:34.13,Dial-CN,,0,0,0,,我也喜欢你 四宫
Dialogue: 1,0:13:35.94,0:13:36.80,Dial-CN,,0,0,0,,喜欢
Dialogue: 1,0:13:38.80,0:13:39.53,Dial-CN,,0,0,0,,喜欢
Dialogue: 1,0:13:40.80,0:13:41.57,Dial-CN,,0,0,0,,喜欢
Dialogue: 1,0:13:41.99,0:13:42.80,Dial-CN,,0,0,0,,喜欢
Dialogue: 1,0:13:43.32,0:13:44.07,Dial-CN,,0,0,0,,喜欢
Dialogue: 1,0:13:44.62,0:13:45.43,Dial-CN,,0,0,0,,喜欢
Dialogue: 1,0:13:55.79,0:13:56.82,Dial-CN,,0,0,0,,结果
Dialogue: 1,0:13:56.82,0:13:58.82,Dial-CN,,0,0,0,,还是顺着气氛做下去了
Dialogue: 1,0:14:01.01,0:14:02.30,Dial-CN,,0,0,0,,我回来了
Dialogue: 1,0:14:03.39,0:14:04.82,Dial-CN,,0,0,0,,咦 是披萨啊
Dialogue: 1,0:14:04.97,0:14:07.30,Dial-CN,,0,0,0,,难得看到哥会叫披萨耶
Dialogue: 1,0:14:07.56,0:14:09.26,Dial-CN,,0,0,0,,昨天有谁来家里吗
Dialogue: 1,0:14:10.83,0:14:11.60,Dial-CN,,0,0,0,,没有啊
Dialogue: 1,0:14:20.28,0:14:23.20,Dial-CN,,0,0,0,,几个小时前我还在那里和四宫…
Dialogue: 1,0:14:23.74,0:14:24.84,Dial-CN,,0,0,0,,虽然是理所当然的事
Dialogue: 1,0:14:24.84,0:14:27.45,Dial-CN,,0,0,0,,不过四宫的裸体是真实存在的啊
Dialogue: 1,0:14:28.99,0:14:31.75,Dial-CN,,0,0,0,,他人的肌肤触感真不得了
Dialogue: 1,0:14:32.08,0:14:34.85,Dial-CN,,0,0,0,,不敢相信列祖列宗都做过那档子事
Dialogue: 1,0:14:35.29,0:14:36.86,Dial-CN,,0,0,0,,我们真的…
Dialogue: 1,0:14:37.42,0:14:39.09,Dial-CN,,0,0,0,,没有焦急的必要
Dialogue: 1,0:14:40.86,0:14:42.86,Dial-CN,,0,0,0,,我的自制力啊
Dialogue: 1,0:14:43.47,0:14:45.34,Dial-CN,,0,0,0,,最初的20分钟我还有忍住
Dialogue: 1,0:14:45.34,0:14:47.26,Dial-CN,,0,0,0,,但被她边说喜欢边狂吻
Dialogue: 1,0:14:47.26,0:14:48.64,Dial-CN,,0,0,0,,我的刹车当然会坏掉啊
Dialogue: 1,0:14:48.64,0:14:49.72,Dial-CN,,0,0,0,,这也没办法吧
Dialogue: 1,0:14:49.72,0:14:51.43,Dial-CN,,0,0,0,,我可是光是牵手走在一起
Dialogue: 1,0:14:51.43,0:14:54.04,Dial-CN,,0,0,0,,下面就会立起来的青春期男生啊
Dialogue: 1,0:14:54.04,0:14:55.81,Dial-CN,,0,0,0,,我哪坚持得住啊
Dialogue: 1,0:14:55.81,0:14:58.09,Dial-CN,,0,0,0,,才刚对她说没必要焦急结果就…
Dialogue: 1,0:14:58.88,0:15:01.28,Dial-CN,,0,0,0,,我是个差劲透顶的男人
Dialogue: 1,0:15:03.20,0:15:04.88,Dial-CN,,0,0,0,,有四宫的味道
Dialogue: 1,0:15:10.54,0:15:11.79,Dial-CN,,0,0,0,,结果真的
Dialogue: 1,0:15:12.12,0:15:13.46,Dial-CN,,0,0,0,,做到最后了
Dialogue: 1,0:15:16.90,0:15:18.63,Dial-CN,,0,0,0,,可以跟您借一下枕头吗
Dialogue: 1,0:15:21.71,0:15:22.30,Dial-CN,,0,0,0,,不过
Dialogue: 1,0:15:22.30,0:15:25.26,Dial-CN,,0,0,0,,他当时才刚表示「没有焦急的必要」吧
Dialogue: 1,0:15:25.51,0:15:27.34,Dial-CN,,0,0,0,,是这样没错
Dialogue: 1,0:15:27.72,0:15:29.47,Dial-CN,,0,0,0,,但我也没办法啊
Dialogue: 1,0:15:29.47,0:15:32.62,Dial-CN,,0,0,0,,会长对我说「没有焦急的必要」的样子真的好迷人
Dialogue: 1,0:15:32.62,0:15:33.71,Dial-CN,,0,0,0,,让我觉得…
Dialogue: 1,0:15:34.77,0:15:37.23,Dial-CN,,0,0,0,,对他的喜欢程度都破百了
Dialogue: 1,0:15:37.23,0:15:38.92,Dial-CN,,0,0,0,,喜欢程度破百…
Dialogue: 1,0:15:38.92,0:15:42.11,Dial-CN,,0,0,0,,在那之后 就觉得怎么样都无所谓了
Dialogue: 1,0:15:42.11,0:15:44.70,Dial-CN,,0,0,0,,接吻的魔力果然很惊人
Dialogue: 1,0:15:44.70,0:15:46.61,Dial-CN,,0,0,0,,害我整个人都不对劲了
Dialogue: 1,0:15:46.93,0:15:48.28,Dial-CN,,0,0,0,,因为到后来
Dialogue: 1,0:15:48.28,0:15:51.54,Dial-CN,,0,0,0,,反而像是我在主动诱惑他的感觉
Dialogue: 1,0:15:52.54,0:15:55.43,Dial-CN,,0,0,0,,姑且可以请教您一下感想吗
Dialogue: 1,0:15:56.50,0:15:57.60,Dial-CN,,0,0,0,,您觉得怎么样
Dialogue: 1,0:16:00.29,0:16:02.13,Dial-CN,,0,0,0,,感觉很不得了
Dialogue: 1,0:16:02.94,0:16:04.76,Dial-CN,,0,0,0,,感觉很厉害啊
Dialogue: 1,0:16:05.22,0:16:06.95,Dial-CN,,0,0,0,,虽然行为本身好在哪
Dialogue: 1,0:16:06.95,0:16:08.64,Dial-CN,,0,0,0,,我还是搞不太清楚
Dialogue: 1,0:16:08.64,0:16:11.50,Dial-CN,,0,0,0,,总之接触他人肌肤很有安心感
Dialogue: 1,0:16:11.89,0:16:14.52,Dial-CN,,0,0,0,,感觉有一点让人上瘾
Dialogue: 1,0:16:16.39,0:16:17.23,Dial-CN,,0,0,0,,但是
Dialogue: 1,0:16:18.23,0:16:20.96,Dial-CN,,0,0,0,,一想到世间的人们都是做那种事
Dialogue: 1,0:16:20.96,0:16:23.90,Dial-CN,,0,0,0,,生命才得以这样一路延续至今
Dialogue: 1,0:16:23.90,0:16:24.96,Dial-CN,,0,0,0,,就觉得很奇妙
Dialogue: 1,0:16:25.94,0:16:29.28,Dial-CN,,0,0,0,,怕寂寞的人们编织出了人类的历史
Dialogue: 1,0:16:29.28,0:16:31.95,Dial-CN,,0,0,0,,竟然开始讲些仿佛看破红尘的话了
Dialogue: 1,0:16:33.33,0:16:34.12,Dial-CN,,0,0,0,,不过
Dialogue: 1,0:16:34.12,0:16:36.98,Dial-CN,,0,0,0,,没想到竟然会这么轻易就达阵了
Dialogue: 1,0:16:37.62,0:16:39.29,Dial-CN,,0,0,0,,我以为两位还要等更久才会…
Dialogue: 1,0:16:39.75,0:16:41.21,Dial-CN,,0,0,0,,其实都是如此的吧
Dialogue: 1,0:16:41.92,0:16:45.67,Dial-CN,,0,0,0,,我不追求什么特别的日子或特别的夜晚
Dialogue: 1,0:16:46.09,0:16:47.91,Dial-CN,,0,0,0,,平凡的情境就足够了
Dialogue: 1,0:16:48.47,0:16:50.76,Dial-CN,,0,0,0,,恍恍惚惚地被气氛带着走
Dialogue: 1,0:16:50.99,0:16:54.66,Dial-CN,,0,0,0,,事后回想又觉得当时实在有点傻
Dialogue: 1,0:16:54.99,0:16:55.81,Dial-CN,,0,0,0,,这种平凡
Dialogue: 1,0:16:56.81,0:17:00.40,Dial-CN,,0,0,0,,又随处可见的高中情侣的感觉
Dialogue: 1,0:17:01.27,0:17:02.65,Dial-CN,,0,0,0,,平凡是吗
Dialogue: 1,0:17:04.44,0:17:05.86,Dial-CN,,0,0,0,,自从坠入情网后
Dialogue: 1,0:17:06.32,0:17:07.90,Dial-CN,,0,0,0,,四宫辉夜一步一步
Dialogue: 1,0:17:08.36,0:17:11.32,Dial-CN,,0,0,0,,慢慢地变成了一个平凡的少女
Dialogue: 1,0:17:12.78,0:17:15.49,Dial-CN,,0,0,0,,既不高贵也不洁癖
Dialogue: 1,0:17:16.29,0:17:19.41,Dial-CN,,0,0,0,,能毫无牵挂地享受眼前的快乐
Dialogue: 1,0:17:20.83,0:17:22.21,Dial-CN,,0,0,0,,如此平凡的女孩
Dialogue: 1,0:17:22.71,0:17:24.34,Dial-CN,,0,0,0,,你在笑什么
Dialogue: 1,0:17:24.34,0:17:25.33,Dial-CN,,0,0,0,,没什么
Dialogue: 1,0:17:25.55,0:17:26.59,Dial-CN,,0,0,0,,只是想到
Dialogue: 1,0:17:26.59,0:17:28.76,Dial-CN,,0,0,0,,辉夜你变成单纯嘴巴有点坏
Dialogue: 1,0:17:28.76,0:17:30.34,Dial-CN,,0,0,0,,头脑有点灵光的
Dialogue: 1,0:17:30.34,0:17:32.59,Dial-CN,,0,0,0,,平凡女性的那天可能会到来
Dialogue: 1,0:17:32.59,0:17:34.43,Dial-CN,,0,0,0,,就让我忍不住笑出来了
Dialogue: 1,0:17:34.43,0:17:38.16,Dial-CN,,0,0,0,,什么啊 我完全不懂这有什么好笑的
Dialogue: 1,0:17:38.39,0:17:39.04,Dial-CN,,0,0,0,,不
Dialogue: 1,0:17:41.35,0:17:43.31,Dial-CN,,0,0,0,,只是戳到了我个人的笑点
Dialogue: 1,0:17:47.40,0:17:48.74,Dial-CN,,0,0,0,,我下定决心了
Dialogue: 1,0:17:49.36,0:17:52.45,Dial-CN,,0,0,0,,我都将自己的一切彻底展现给会长了
Dialogue: 1,0:17:52.74,0:17:54.49,Dial-CN,,0,0,0,,已经没有什么好怕的了
Dialogue: 1,0:17:55.05,0:17:57.06,Dial-CN,,0,0,0,,在会长离开这个学园前
Dialogue: 1,0:17:57.06,0:17:58.83,Dial-CN,,0,0,0,,我要尽全力好好享受这段时光
Dialogue: 1,0:17:59.62,0:18:01.06,Dial-CN,,0,0,0,,我各方面都看开了
Dialogue: 1,0:18:01.62,0:18:03.06,Dial-CN,,0,0,0,,从今以后我要随心所欲
Dialogue: 1,0:18:03.50,0:18:05.06,Dial-CN,,0,0,0,,没什么不好啊
Dialogue: 1,0:18:05.06,0:18:06.46,Dial-CN,,0,0,0,,反正你们之前八成都在
Dialogue: 1,0:18:06.46,0:18:08.38,Dial-CN,,0,0,0,,顾虑他人的眼光偷偷交往
Dialogue: 1,0:18:08.38,0:18:09.51,Dial-CN,,0,0,0,,就是说啊
Dialogue: 1,0:18:09.72,0:18:12.38,Dial-CN,,0,0,0,,其实我想天天跟会长一起上学
Dialogue: 1,0:18:12.38,0:18:14.60,Dial-CN,,0,0,0,,想多和他一起单独出去玩
Dialogue: 1,0:18:14.60,0:18:17.08,Dial-CN,,0,0,0,,午餐时间也想和他一起吃便当
Dialogue: 1,0:18:20.02,0:18:22.77,Dial-CN,,0,0,0,,这一定会成为全秀知院的话题吧
Dialogue: 1,0:18:24.44,0:18:25.94,Dial-CN,,0,0,0,,我才不在乎呢
Dialogue: 1,0:18:26.48,0:18:27.69,Dial-CN,,0,0,0,,那就好
Dialogue: 1,0:18:29.69,0:18:31.09,Dial-CN,,0,0,0,,你们终于达阵了呢
Dialogue: 1,0:18:31.28,0:18:32.20,Dial-CN,,0,0,0,,和会长做…
Dialogue: 1,0:18:32.20,0:18:34.62,Dial-CN,,0,0,0,,当时气氛太好了 我也没办法啊
Dialogue: 1,0:18:34.62,0:18:38.74,Dial-CN,,0,0,0,,我也没办法啊…
Dialogue: 1,0:18:38.74,0:18:41.63,Dial-CN,,0,0,0,,当时气氛太好了 我也没办法啊
Dialogue: 1,0:18:43.58,0:18:45.10,Dial-CN,,0,0,0,,后来经过一波三折
Dialogue: 1,0:18:45.10,0:18:47.67,Dial-CN,,0,0,0,,时间一转眼就过去了
Dialogue: 1,0:18:47.67,0:18:50.13,Dial-CN,,0,0,0,,终于来到会长踏上旅程的那天
Dialogue: 1,0:18:53.93,0:18:57.12,Dial-CN,,0,0,0,,为什么我会在众目睽睽下出那种包啊
Dialogue: 1,0:18:57.12,0:18:58.64,Dial-CN,,0,0,0,,真想把那段记忆消除掉
Dialogue: 1,0:18:58.64,0:19:00.43,Dial-CN,,0,0,0,,黑历史
Dialogue: 1,0:19:00.60,0:19:03.12,Dial-CN,,0,0,0,,就算是辉夜也曾经历过
Dialogue: 1,0:19:06.44,0:19:07.13,Dial-CN,,0,0,0,,到了明天
Dialogue: 1,0:19:07.65,0:19:10.28,Dial-CN,,0,0,0,,会长就要搭飞机踏上旅程了
Dialogue: 1,0:19:11.49,0:19:13.13,Dial-CN,,0,0,0,,留下我离开
Dialogue: 1,0:19:14.82,0:19:16.91,Dial-CN,,0,0,0,,这是电影很常见的桥段呢
Dialogue: 1,0:19:16.91,0:19:17.91,Dial-CN,,0,0,0,,四宫
Dialogue: 1,0:19:18.24,0:19:19.52,Dial-CN,,0,0,0,,是 会长
Dialogue: 1,0:19:19.83,0:19:22.12,Dial-CN,,0,0,0,,等到我回来以后
Dialogue: 1,0:19:23.54,0:19:24.47,Dial-CN,,0,0,0,,我们就结婚吧
Dialogue: 1,0:19:26.00,0:19:28.56,Dial-CN,,0,0,0,,他也许会对我这样讲
Dialogue: 1,0:19:28.56,0:19:30.35,Dial-CN,,0,0,0,,怎么办怎么办
Dialogue: 1,0:19:30.35,0:19:35.15,Dial-CN,,0,0,0,,辉夜直到深夜满脑子都想着这些事
Dialogue: 1,0:19:35.15,0:19:36.47,Dial-CN,,0,0,0,,没有啦 不可能吧
Dialogue: 1,0:19:36.47,0:19:37.16,Dial-CN,,0,0,0,,不过…
Dialogue: 1,0:19:39.16,0:19:40.18,Dial-CN,,0,0,0,,早坂
Dialogue: 1,0:19:40.72,0:19:41.97,Dial-CN,,0,0,0,,现在几点了
Dialogue: 1,0:19:42.35,0:19:45.16,Dial-CN,,0,0,0,,她在白银要踏上旅程的重要日子
Dialogue: 1,0:19:45.16,0:19:47.17,Dial-CN,,0,0,0,,华丽地睡过头了
Dialogue: 1,0:19:47.94,0:19:49.36,Dial-CN,,0,0,0,,那个白痴
Dialogue: 1,0:19:49.69,0:19:51.78,Dial-CN,,0,0,0,,真不愧是四宫学姐
Dialogue: 1,0:19:52.40,0:19:55.17,Dial-CN,,0,0,0,,为什么会在这种日子睡过头啊
Dialogue: 1,0:19:55.74,0:19:57.57,Dial-CN,,0,0,0,,请你再开快一点
Dialogue: 1,0:20:09.54,0:20:11.19,Dial-CN,,0,0,0,,时间差不多了
Dialogue: 1,0:20:12.42,0:20:15.02,Dial-CN,,0,0,0,,各位 谢谢你们为我送行
Dialogue: 1,0:20:15.84,0:20:18.37,Dial-CN,,0,0,0,,早坂 辉夜就拜托你了
Dialogue: 1,0:20:20.01,0:20:22.22,Dial-CN,,0,0,0,,我会再用LINE连络的
Dialogue: 1,0:20:22.60,0:20:23.20,Dial-CN,,0,0,0,,好
Dialogue: 1,0:20:23.43,0:20:25.02,Dial-CN,,0,0,0,,别过去那里就见一个爱一个
Dialogue: 1,0:20:25.02,0:20:27.48,Dial-CN,,0,0,0,,让辉夜同学吃醋哦
Dialogue: 1,0:20:28.02,0:20:29.21,Dial-CN,,0,0,0,,那当然
Dialogue: 1,0:20:29.21,0:20:30.61,Dial-CN,,0,0,0,,你不在的期间
Dialogue: 1,0:20:30.61,0:20:32.19,Dial-CN,,0,0,0,,学校就交给我们吧
Dialogue: 1,0:20:32.19,0:20:34.15,Dial-CN,,0,0,0,,你走了我们会寂寞的
Dialogue: 1,0:20:34.15,0:20:35.22,Dial-CN,,0,0,0,,对吧 真妃
Dialogue: 1,0:20:35.51,0:20:37.63,Dial-CN,,0,0,0,,我并不会觉得寂寞
Dialogue: 1,0:20:38.28,0:20:41.22,Dial-CN,,0,0,0,,人总有一天都会各奔东西的
Dialogue: 1,0:20:41.45,0:20:43.58,Dial-CN,,0,0,0,,要是每次都为此感到寂寞
Dialogue: 1,0:20:43.58,0:20:44.70,Dial-CN,,0,0,0,,不是就没完没了了吗
Dialogue: 1,0:20:45.08,0:20:46.18,Dial-CN,,0,0,0,,那真心话呢
Dialogue: 1,0:20:47.23,0:20:50.38,Dial-CN,,0,0,0,,我觉得超寂寞的啦 笨蛋
Dialogue: 1,0:20:50.38,0:20:51.75,Dial-CN,,0,0,0,,还真坦率
Dialogue: 1,0:20:51.75,0:20:52.71,Dial-CN,,0,0,0,,谢谢你们
Dialogue: 1,0:20:53.09,0:20:54.38,Dial-CN,,0,0,0,,我还会再连络的
Dialogue: 1,0:20:54.38,0:20:55.84,Dial-CN,,0,0,0,,大家都要保重哦
Dialogue: 1,0:20:57.47,0:21:00.51,Dial-CN,,0,0,0,,为什么你能表现得这么冷静呢
Dialogue: 1,0:21:01.24,0:21:04.85,Dial-CN,,0,0,0,,你就要和辉夜同学分开好一阵子了
Dialogue: 1,0:21:06.52,0:21:07.60,Dial-CN,,0,0,0,,看来藤原你
Dialogue: 1,0:21:07.60,0:21:09.81,Dial-CN,,0,0,0,,也还不太了解四宫这个人呢
Dialogue: 1,0:21:10.94,0:21:12.23,Dial-CN,,0,0,0,,那家伙没问题的
Dialogue: 1,0:21:12.48,0:21:13.65,Dial-CN,,0,0,0,,不用担心
Dialogue: 1,0:21:14.23,0:21:15.48,Dial-CN,,0,0,0,,这点我可以保证
Dialogue: 1,0:21:16.40,0:21:17.57,Dial-CN,,0,0,0,,这样啊
Dialogue: 1,0:21:18.70,0:21:20.11,Dial-CN,,0,0,0,,会长都这么说了
Dialogue: 1,0:21:20.11,0:21:21.44,Dial-CN,,0,0,0,,那应该就是这样了吧
Dialogue: 1,0:21:25.41,0:21:26.41,Dial-CN,,0,0,0,,会长
Dialogue: 1,0:21:27.62,0:21:29.81,Dial-CN,,0,0,0,,和你相处的这两年
Dialogue: 1,0:21:29.81,0:21:31.85,Dial-CN,,0,0,0,,我过得非常开心哦
Dialogue: 1,0:21:32.21,0:21:34.21,Dial-CN,,0,0,0,,好像多了个没出息的儿子
Dialogue: 1,0:21:34.21,0:21:36.19,Dial-CN,,0,0,0,,这种感觉其实还不坏呢
Dialogue: 1,0:21:36.19,0:21:37.28,Dial-CN,,0,0,0,,我觉得
Dialogue: 1,0:21:37.28,0:21:39.88,Dial-CN,,0,0,0,,自己多了个奇怪的哥哥
Dialogue: 1,0:21:40.34,0:21:41.80,Dial-CN,,0,0,0,,你教了我很多事情
Dialogue: 1,0:21:41.80,0:21:43.79,Dial-CN,,0,0,0,,在各方面一直很支持着我
Dialogue: 1,0:21:44.18,0:21:47.01,Dial-CN,,0,0,0,,你是我最喜欢最尊敬的会长
Dialogue: 1,0:21:47.29,0:21:48.60,Dial-CN,,0,0,0,,请多保重
Dialogue: 1,0:21:49.10,0:21:49.94,Dial-CN,,0,0,0,,会长
Dialogue: 1,0:21:50.35,0:21:52.40,Dial-CN,,0,0,0,,要是出了什么事记得来找我们哦
Dialogue: 1,0:21:53.29,0:21:54.55,Dial-CN,,0,0,0,,就算你人在国外
Dialogue: 1,0:21:54.94,0:21:56.52,Dial-CN,,0,0,0,,我们也会立刻赶过去的
Dialogue: 1,0:22:01.99,0:22:03.57,Dial-CN,,0,0,0,,那就再见咯
Dialogue: 1,0:22:05.31,0:22:06.14,Dial-CN,,0,0,0,,再见
Dialogue: 1,0:22:21.05,0:22:22.34,Dial-CN,,0,0,0,,会长人呢
Dialogue: 1,0:22:23.55,0:22:25.33,Dial-CN,,0,0,0,,他已经走了
Dialogue: 1,0:22:44.36,0:22:45.88,Dial-CN,,0,0,0,,会长
Dialogue: 1,0:22:45.88,0:22:46.89,Dial-CN,,0,0,0,,四宫
Dialogue: 1,0:22:46.89,0:22:49.35,Dial-CN,,0,0,0,,我也来向你道别了
Dialogue: 1,0:22:49.35,0:22:50.87,Dial-CN,,0,0,0,,这不是道别会走的距离吧
Dialogue: 1,0:22:50.87,0:22:52.51,Dial-CN,,0,0,0,,都跑来另一个国家了耶
Dialogue: 1,0:22:52.83,0:22:56.25,Dial-CN,,0,0,0,,你这个人做事真的很乱来耶
Dialogue: 1,0:22:56.54,0:22:57.91,Dial-CN,,0,0,0,,这样讲太夸张了
Dialogue: 1,0:22:57.91,0:23:00.19,Dial-CN,,0,0,0,,就只是搭架飞机过来而已啊
Dialogue: 1,0:23:01.36,0:23:04.89,Dial-CN,,0,0,0,,不过 东京和加州的距离其实意外地近呢
Dialogue: 1,0:23:04.89,0:23:06.80,Dial-CN,,0,0,0,,这样的话感觉每周都可以过去了
Dialogue: 1,0:23:07.97,0:23:09.81,Dial-CN,,0,0,0,,星期五晚上在飞机上睡觉
Dialogue: 1,0:23:09.81,0:23:11.73,Dial-CN,,0,0,0,,星期天搭晚上的航班回来
Dialogue: 1,0:23:11.73,0:23:13.37,Dial-CN,,0,0,0,,就能赶得及上学了
Dialogue: 1,0:23:13.37,0:23:15.38,Dial-CN,,0,0,0,,这样可能有点…
Dialogue: 1,0:23:15.52,0:23:18.40,Dial-CN,,0,0,0,,会长你不想和我在一起吗
Dialogue: 1,0:23:18.40,0:23:20.94,Dial-CN,,0,0,0,,不 我也很想一直跟你在一起
Dialogue: 1,0:23:20.94,0:23:23.03,Dial-CN,,0,0,0,,就是说嘛
Dialogue: 1,0:23:25.39,0:23:26.66,Dial-CN,,0,0,0,,不得不说
Dialogue: 1,0:23:26.66,0:23:29.74,Dial-CN,,0,0,0,,会长真的很了解辉夜同学呢
Dialogue: 1,0:23:30.12,0:23:32.75,Dial-CN,,0,0,0,,道别时明明就那么感动
Dialogue: 1,0:23:32.75,0:23:35.71,Dial-CN,,0,0,0,,却完全没有会长离我们远去的感觉
Dialogue: 1,0:23:36.42,0:23:37.40,Dial-CN,,0,0,0,,我也这么觉得
Dialogue: 1,0:23:37.65,0:23:39.69,Dial-CN,,0,0,0,,这也算是文明的进步吧
Dialogue: 1,0:23:40.00,0:23:42.00,Dial-CN,,0,0,0,,这是四宫学姐的点子
Dialogue: 1,0:23:42.30,0:23:45.18,Dial-CN,,0,0,0,,这样一来距离就几乎等同于不存在了
Dialogue: 1,0:23:45.41,0:23:48.58,Dial-CN,,0,0,0,,凡事只要不断思考都能得到解决的
Dialogue: 1,0:23:49.01,0:23:51.68,Dial-CN,,0,0,0,,恋爱是要靠头脑取胜的哦
Dialogue: 1,0:23:52.10,0:23:53.41,Dial-CN,,0,0,0,,对吧 会长
Dialogue: 1,0:24:00.15,0:24:01.42,Dial-CN,,0,0,0,,我回来了 辉夜
Dialogue: 1,0:24:02.19,0:24:03.42,Dial-CN,,0,0,0,,欢迎你回来
Dialogue: 1,0:24:03.57,0:24:04.49,Dial-CN,,0,0,0,,会长
Dialogue: 1,0:24:05.86,0:24:07.43,Dial-CN,,0,0,0,,今天很晚才回来呢
Dialogue: 1,0:24:07.43,0:24:09.01,Dial-CN,,0,0,0,,不少事撞在一起了
Dialogue: 1,0:24:09.82,0:24:12.01,Dial-CN,,0,0,0,,请不要太勉强自己哦
Dialogue: 1,0:24:14.16,0:24:15.99,Dial-CN,,0,0,0,,小圭今天有来哦
Dialogue: 1,0:24:15.99,0:24:17.08,Dial-CN,,0,0,0,,她来做什么
Dialogue: 1,0:24:17.08,0:24:19.18,Dial-CN,,0,0,0,,她说只是过来打个照面的
Dialogue: 1,0:24:19.83,0:24:21.26,Dial-CN,,0,0,0,,是来见你的吧
Dialogue: 1,0:24:21.59,0:24:23.05,Dial-CN,,0,0,0,,或许是吧
Dialogue: 1,0:24:23.80,0:24:26.13,Dial-CN,,0,0,0,,来 我把相簿整理好了
Dialogue: 1,0:24:26.76,0:24:27.65,Dial-CN,,0,0,0,,谢谢
Dialogue: 1,0:24:28.39,0:24:29.45,Dial-CN,,0,0,0,,还真不少呢
Dialogue: 1,0:24:29.80,0:24:31.45,Dial-CN,,0,0,0,,因为拍了很多照片
Dialogue: 1,0:24:31.93,0:24:34.75,Dial-CN,,0,0,0,,不过你拿这些相簿要做什么呢
Dialogue: 1,0:24:35.85,0:24:37.46,Dial-CN,,0,0,0,,我们公司的开发者说
Dialogue: 1,0:24:37.46,0:24:40.65,Dial-CN,,0,0,0,,想拿来当目前在制作的系统样本档案
Dialogue: 1,0:24:41.82,0:24:43.28,Dial-CN,,0,0,0,,就是以前TG社的…
Dialogue: 1,0:24:43.28,0:24:44.40,Dial-CN,,0,0,0,,没错没错
Dialogue: 1,0:24:44.40,0:24:47.78,Dial-CN,,0,0,0,,虽然很不甘心 但那家伙真的是个天才呢
Dialogue: 1,0:24:49.47,0:24:52.35,Dial-CN,,0,0,0,,学生时代明明就只是个问题儿童
Dialogue: 1,0:24:53.20,0:24:54.70,Dial-CN,,0,0,0,,真是世事难料呢
Dialogue: 1,0:24:56.29,0:24:57.48,Dial-CN,,0,0,0,,我们也是啊
Dialogue: 1,0:24:58.62,0:24:59.75,Dial-CN,,0,0,0,,是啊
Dialogue: 1,0:26:36.30,0:26:39.58,Dial-CN,,0,0,0,,福祸有如相互纠缠的绳索
Dialogue: 1,0:26:40.14,0:26:42.73,Dial-CN,,0,0,0,,然后在机械的齿轮
Dialogue: 1,0:26:42.73,0:26:45.59,Dial-CN,,0,0,0,,亦或是命运的恶作剧的引导下
Dialogue: 1,0:26:45.59,0:26:48.73,Dial-CN,,0,0,0,,一段围绕于回忆的多彩故事
Dialogue: 1,0:26:49.59,0:26:51.59,Dial-CN,,0,0,0,,此刻即将开始
Dialogue: 1,0:26:52.20,0:26:56.13,Dial-CN,,0,0,0,,以长大成人的少年少女们为主角
Dialogue: 0,0:00:00.84,0:00:03.05,Dial-JP,,0,0,0,,今日 つばめ先輩…
Dialogue: 0,0:00:03.05,0:00:05.22,Dial-JP,,0,0,0,,応援団メンバーでカラオケ行くので
Dialogue: 0,0:00:05.22,0:00:06.59,Dial-JP,,0,0,0,,先に帰りますね
Dialogue: 0,0:00:08.89,0:00:10.89,Dial-JP,,0,0,0,,見回り強化週間なので
Dialogue: 0,0:00:10.89,0:00:12.26,Dial-JP,,0,0,0,,本日は これで
Dialogue: 0,0:00:13.99,0:00:17.39,Dial-JP,,0,0,0,,ＴＧ部のみんなで 宇宙人狼やるので
Dialogue: 0,0:00:20.00,0:00:21.06,Dial-JP,,0,0,0,,また来週な
Dialogue: 0,0:00:24.28,0:00:25.53,Dial-JP,,0,0,0,,２人っきりだな
Dialogue: 0,0:00:25.53,0:00:26.90,Dial-JP,,0,0,0,,２人っき
Dialogue: 0,0:00:26.90,0:00:27.53,Dial-JP,,0,0,0,,どうした
Dialogue: 0,0:00:28.20,0:00:30.01,Dial-JP,,0,0,0,,いえ… その…
Dialogue: 0,0:00:33.33,0:00:35.41,Dial-JP,,0,0,0,,バカらしいわ 本当
Dialogue: 0,0:00:35.66,0:00:36.50,Dial-JP,,0,0,0,,四宮
Dialogue: 0,0:00:37.00,0:00:40.30,Dial-JP,,0,0,0,,いえ いろいろ考え過ぎていて
Dialogue: 0,0:00:41.17,0:00:42.21,Dial-JP,,0,0,0,,会長
Dialogue: 0,0:00:42.75,0:00:44.67,Dial-JP,,0,0,0,,２人きりで帰りましょう
Dialogue: 0,0:00:49.09,0:00:50.03,Dial-JP,,0,0,0,,そういえば
Dialogue: 0,0:00:50.03,0:00:52.63,Dial-JP,,0,0,0,,早坂が家からいなくなって 大丈夫なのか
Dialogue: 0,0:00:53.10,0:00:56.04,Dial-JP,,0,0,0,,新しいお付きの人が 入ったのですが
Dialogue: 0,0:00:56.04,0:00:59.23,Dial-JP,,0,0,0,,恐らく 兄の息がかかった人間でしょうし
Dialogue: 0,0:00:59.60,0:01:01.48,Dial-JP,,0,0,0,,気の休まる暇がありません
Dialogue: 0,0:01:05.36,0:01:06.54,Dial-JP,,0,0,0,,ずっと
Dialogue: 0,0:01:07.82,0:01:10.49,Dial-JP,,0,0,0,,このまま 帰り道が続けばいいのに
Dialogue: 0,0:01:15.33,0:01:18.29,Dial-JP,,0,0,0,,じゃあ 今日はうちでメシでも食っていくか
Dialogue: 0,0:01:18.71,0:01:20.62,Dial-JP,,0,0,0,,まだ新居来たことないだろ
Dialogue: 0,0:01:21.00,0:01:23.39,Dial-JP,,0,0,0,,今日は親父 朝まで飲み会でいないし
Dialogue: 0,0:01:23.39,0:01:26.07,Dial-JP,,0,0,0,,圭の食事ですか すてきですね
Dialogue: 0,0:01:28.46,0:01:29.75,Dial-JP,,0,0,0,,見ろ 四宮
Dialogue: 0,0:01:30.07,0:01:31.38,Dial-JP,,0,0,0,,オートロックだぞ
Dialogue: 0,0:01:31.38,0:01:32.64,Dial-JP,,0,0,0,,安心ですね
Dialogue: 0,0:01:32.64,0:01:34.55,Dial-JP,,0,0,0,,エレベーターも あるんだぞ
Dialogue: 0,0:01:34.55,0:01:35.76,Dial-JP,,0,0,0,,楽ですね
Dialogue: 0,0:01:36.08,0:01:39.43,Dial-JP,,0,0,0,,んで 俺の部屋
Dialogue: 0,0:01:40.48,0:01:42.77,Dial-JP,,0,0,0,,今まで圭と同室だったからな
Dialogue: 0,0:01:43.61,0:01:46.52,Dial-JP,,0,0,0,,あれも仲むつまじくて すてきでしたけれど
Dialogue: 0,0:01:48.09,0:01:49.23,Dial-JP,,0,0,0,,ベッドも新調して
Dialogue: 0,0:01:49.23,0:01:50.58,Dial-JP,,0,0,0,,寝心地がいいぞ
Dialogue: 0,0:01:52.95,0:01:53.80,Dial-JP,,0,0,0,,しまった
Dialogue: 0,0:01:53.80,0:01:56.10,Dial-JP,,0,0,0,,なんか今のは意味が出る発言だった
Dialogue: 0,0:01:56.10,0:01:57.91,Dial-JP,,0,0,0,,なんとか ごまかさないと
Dialogue: 0,0:01:58.33,0:02:00.37,Dial-JP,,0,0,0,,ごめん 変な意味じゃなく
Dialogue: 0,0:02:00.37,0:02:02.46,Dial-JP,,0,0,0,,分かってます 分かってます
Dialogue: 0,0:02:02.46,0:02:05.04,Dial-JP,,0,0,0,,つか 圭ちゃん帰ってくるの遅
Dialogue: 0,0:02:05.04,0:02:06.88,Dial-JP,,0,0,0,,晩メシ遅くなるぞん
Dialogue: 0,0:02:12.87,0:02:15.76,Dial-JP,,0,0,0,,圭 藤原んちにお泊まりだって
Dialogue: 0,0:02:16.93,0:02:19.05,Dial-JP,,0,0,0,,親父も今日は帰ってこない
Dialogue: 0,0:02:24.56,0:02:26.44,Dial-JP,,0,0,0,,今日のところは やめとくか
Dialogue: 0,0:02:26.44,0:02:27.57,Dial-JP,,0,0,0,,また日を改めて…
Dialogue: 0,0:02:27.57,0:02:28.58,Dial-JP,,0,0,0,,そうなんですか
Dialogue: 0,0:02:30.49,0:02:33.20,Dial-JP,,0,0,0,,帰ったほうが いいんですか
Dialogue: 0,0:02:35.37,0:02:39.75,Dial-JP,,0,0,0,,私 こういうとき どうしたらいいのか 何も分からないので
Dialogue: 0,0:02:40.14,0:02:43.46,Dial-JP,,0,0,0,,いや 俺もこんなの経験ないし
Dialogue: 0,0:02:45.29,0:02:46.15,Dial-JP,,0,0,0,,じゃあ
Dialogue: 0,0:02:51.88,0:02:52.84,Dial-JP,,0,0,0,,泊まってく
Dialogue: 0,0:02:52.84,0:02:54.88,Dial-JP,,0,0,0,,男と女にとって
Dialogue: 0,0:02:54.88,0:02:59.18,Dial-JP,,0,0,0,,最も山場となる 恋愛頭脳戦の始まりである
Dialogue: 0,0:04:51.83,0:04:53.04,Dial-JP,,0,0,0,,お風呂が沸きました
Dialogue: 0,0:04:58.80,0:05:00.03,Dial-JP,,0,0,0,,先に入ってくれ
Dialogue: 0,0:05:00.28,0:05:02.01,Dial-JP,,0,0,0,,着替えと歯ブラシ 用意しとく
Dialogue: 0,0:05:02.43,0:05:04.28,Dial-JP,,0,0,0,,寝巻きは圭のがいいかな
Dialogue: 0,0:05:04.28,0:05:06.81,Dial-JP,,0,0,0,,俺のだと少し大きいかもしれんし
Dialogue: 0,0:05:09.14,0:05:10.29,Dial-JP,,0,0,0,,会長の服…
Dialogue: 0,0:05:13.44,0:05:15.11,Dial-JP,,0,0,0,,会長の服
Dialogue: 0,0:05:15.53,0:05:17.30,Dial-JP,,0,0,0,,が いいです
Dialogue: 0,0:05:20.78,0:05:22.30,Dial-JP,,0,0,0,,分かった 用意しとく
Dialogue: 0,0:05:25.28,0:05:26.31,Dial-JP,,0,0,0,,親父今どこ
Dialogue: 0,0:05:27.37,0:05:30.50,Dial-JP,,0,0,0,,今 配信者たちの飲み会で六本木
Dialogue: 0,0:05:30.86,0:05:33.63,Dial-JP,,0,0,0,,10分に１回のペースで テキーラ飲まされてる
Dialogue: 0,0:05:33.63,0:05:35.96,Dial-JP,,0,0,0,,ノリが若すぎて帰りたいんだが
Dialogue: 0,0:05:36.80,0:05:37.96,Dial-JP,,0,0,0,,帰ってくるの
Dialogue: 0,0:05:40.32,0:05:41.18,Dial-JP,,0,0,0,,そういうことか
Dialogue: 0,0:05:41.18,0:05:42.32,Dial-JP,,0,0,0,,分かった 分かった
Dialogue: 0,0:05:42.32,0:05:43.68,Dial-JP,,0,0,0,,今夜は絶対に帰らない
Dialogue: 0,0:05:43.68,0:05:46.33,Dial-JP,,0,0,0,,なんなら 昼までどっかで 時間を潰すからゆっくりしてろ
Dialogue: 0,0:05:46.33,0:05:48.14,Dial-JP,,0,0,0,,かぐやちゃんに よろしくな
Dialogue: 0,0:05:48.14,0:05:51.52,Dial-JP,,0,0,0,,違えから そういうのじゃないから
Dialogue: 0,0:05:51.52,0:05:54.33,Dial-JP,,0,0,0,,物分かりのいい父親に感謝しろ
Dialogue: 0,0:05:55.90,0:05:58.11,Dial-JP,,0,0,0,,萌葉 と圭ちゃんと合流
Dialogue: 0,0:05:58.11,0:05:59.94,Dial-JP,,0,0,0,,みんなでアマガス
Dialogue: 0,0:06:00.70,0:06:03.41,Dial-JP,,0,0,0,,圭も 本当に藤原んちにいるみたいだし
Dialogue: 0,0:06:03.41,0:06:04.91,Dial-JP,,0,0,0,,邪魔は入らない
Dialogue: 0,0:06:05.28,0:06:06.35,Dial-JP,,0,0,0,,どうする
Dialogue: 0,0:06:06.70,0:06:08.16,Dial-JP,,0,0,0,,これは どうなる
Dialogue: 0,0:06:08.16,0:06:10.35,Dial-JP,,0,0,0,,ここでガツガツいくのは 時期尚早か
Dialogue: 0,0:06:11.83,0:06:14.35,Dial-JP,,0,0,0,,いや 気負わなくていい
Dialogue: 0,0:06:14.77,0:06:17.81,Dial-JP,,0,0,0,,自然なことを 自然なまま受け入れればいい
Dialogue: 0,0:06:18.05,0:06:19.99,Dial-JP,,0,0,0,,もしそうなるならなればいい
Dialogue: 0,0:06:21.97,0:06:24.95,Dial-JP,,0,0,0,,だが 一応準備は済ませておくか
Dialogue: 0,0:06:27.14,0:06:28.81,Dial-JP,,0,0,0,,におい ＯＫ
Dialogue: 0,0:06:29.35,0:06:32.19,Dial-JP,,0,0,0,,ベッドのシーツは替えたばかり ＯＫ
Dialogue: 0,0:06:32.77,0:06:33.46,Dial-JP,,0,0,0,,ゴム
Dialogue: 0,0:06:33.46,0:06:34.81,Dial-JP,,0,0,0,,１年くらい前に買って
Dialogue: 0,0:06:34.81,0:06:37.17,Dial-JP,,0,0,0,,結局膨らませて遊んだだけのがある
Dialogue: 0,0:06:37.17,0:06:38.18,Dial-JP,,0,0,0,,ＯＫ
Dialogue: 0,0:06:38.65,0:06:41.33,Dial-JP,,0,0,0,,男子の９割が通る道である
Dialogue: 0,0:06:42.38,0:06:44.86,Dial-JP,,0,0,0,,四宮が風呂から上がる
Dialogue: 0,0:06:44.86,0:06:48.59,Dial-JP,,0,0,0,,どうすれば あと何を準備すれば
Dialogue: 0,0:06:49.20,0:06:49.87,Dial-JP,,0,0,0,,会長
Dialogue: 0,0:06:51.07,0:06:53.46,Dial-JP,,0,0,0,,四宮が 俺のシャツを
Dialogue: 0,0:06:54.62,0:06:56.93,Dial-JP,,0,0,0,,会長も どうぞお風呂に
Dialogue: 0,0:06:58.21,0:06:58.96,Dial-JP,,0,0,0,,ああ
Dialogue: 0,0:07:08.68,0:07:10.00,Dial-JP,,0,0,0,,これは…
Dialogue: 0,0:07:10.41,0:07:12.62,Dial-JP,,0,0,0,,そういう流れよね
Dialogue: 0,0:07:12.81,0:07:14.58,Dial-JP,,0,0,0,,とうとう そうなんだわ
Dialogue: 0,0:07:14.89,0:07:17.94,Dial-JP,,0,0,0,,一応 ひととおり流れの予習は済ませてある
Dialogue: 0,0:07:17.94,0:07:19.79,Dial-JP,,0,0,0,,粗相はないはずですが
Dialogue: 0,0:07:20.13,0:07:21.92,Dial-JP,,0,0,0,,実地は初
Dialogue: 0,0:07:22.73,0:07:24.11,Dial-JP,,0,0,0,,怖い
Dialogue: 0,0:07:24.42,0:07:26.91,Dial-JP,,0,0,0,,というか こんな唐突にお泊まりで
Dialogue: 0,0:07:26.91,0:07:29.34,Dial-JP,,0,0,0,,会長のほうは 準備できてるのかしら
Dialogue: 0,0:07:31.33,0:07:35.87,Dial-JP,,0,0,0,,ただ 一応早坂にお守りとして持たされているのよね
Dialogue: 0,0:07:36.83,0:07:38.63,Dial-JP,,0,0,0,,その場合 どうすれば
Dialogue: 0,0:07:38.63,0:07:40.44,Dial-JP,,0,0,0,,「これ使ってください」って言うの
Dialogue: 0,0:07:40.44,0:07:44.44,Dial-JP,,0,0,0,,ふだんからスキンを持ち歩く やらしい女と思われないかしら
Dialogue: 0,0:07:45.17,0:07:49.32,Dial-JP,,0,0,0,,何か…何か注意することはないかしら
Dialogue: 0,0:07:49.32,0:07:52.45,Dial-JP,,0,0,0,,女子の９割が通る道である
Dialogue: 0,0:07:57.10,0:07:58.03,Dial-JP,,0,0,0,,おっす
Dialogue: 0,0:08:06.99,0:08:09.07,Dial-JP,,0,0,0,,そういえば みんな連休だからか
Dialogue: 0,0:08:09.07,0:08:11.16,Dial-JP,,0,0,0,,用事で早く帰ってたな
Dialogue: 0,0:08:11.16,0:08:13.70,Dial-JP,,0,0,0,,石上も今日は子安 先輩たちと
Dialogue: 0,0:08:14.66,0:08:16.29,Dial-JP,,0,0,0,,その話聞きましたよ
Dialogue: 0,0:08:16.48,0:08:18.67,Dial-JP,,0,0,0,,まだつながりがあるようで なんだか安心しました
Dialogue: 0,0:08:18.67,0:08:19.83,Dial-JP,,0,0,0,,いつもどおり
Dialogue: 0,0:08:19.83,0:08:22.99,Dial-JP,,0,0,0,,したら 藤原と伊井野が からかいだしてな
Dialogue: 0,0:08:22.99,0:08:24.48,Dial-JP,,0,0,0,,そうでしたね
Dialogue: 0,0:08:24.48,0:08:27.30,Dial-JP,,0,0,0,,気丈に振る舞う石上君が…
Dialogue: 0,0:08:25.09,0:08:26.34,Dial-JP-Top,,0,0,0,,いつもどおり
Dialogue: 0,0:08:31.26,0:08:32.72,Dial-JP,,0,0,0,,いつもどおり
Dialogue: 0,0:08:35.93,0:08:37.35,Dial-JP,,0,0,0,,いつもどおり
Dialogue: 0,0:08:40.50,0:08:41.90,Dial-JP,,0,0,0,,いつもどおり
Dialogue: 0,0:08:43.82,0:08:45.04,Dial-JP,,0,0,0,,そうですね
Dialogue: 0,0:08:45.04,0:08:46.69,Dial-JP,,0,0,0,,からの…
Dialogue: 0,0:08:46.69,0:08:49.03,Dial-JP,,0,0,0,,いや なんねえな そういう雰囲気
Dialogue: 0,0:08:49.03,0:08:50.88,Dial-JP,,0,0,0,,風紀委員とも連携を取って…
Dialogue: 0,0:08:50.88,0:08:53.17,Dial-JP,,0,0,0,,どうする どうする
Dialogue: 0,0:08:54.99,0:08:56.00,Dial-JP,,0,0,0,,四宮
Dialogue: 0,0:08:56.52,0:08:57.31,Dial-JP,,0,0,0,,眠いか
Dialogue: 0,0:08:58.21,0:08:59.25,Dial-JP,,0,0,0,,ちょっと
Dialogue: 0,0:08:59.25,0:09:01.92,Dial-JP,,0,0,0,,ふだんは もう寝てる時間なもので
Dialogue: 0,0:09:05.38,0:09:09.51,Dial-JP,,0,0,0,,四宮は そういうつもりで来たわけじゃないんだろうしな
Dialogue: 0,0:09:10.84,0:09:12.72,Dial-JP,,0,0,0,,俺たちは ゆっくりいけばいい
Dialogue: 0,0:09:15.85,0:09:17.48,Dial-JP,,0,0,0,,そろそろ寝るとしよう
Dialogue: 0,0:09:18.18,0:09:19.77,Dial-JP,,0,0,0,,リビングに布団を敷く
Dialogue: 0,0:09:20.35,0:09:21.60,Dial-JP,,0,0,0,,リビング
Dialogue: 0,0:09:23.36,0:09:26.32,Dial-JP,,0,0,0,,俺が気弱でよかったな 四宮
Dialogue: 0,0:09:27.19,0:09:30.36,Dial-JP,,0,0,0,,今日は２人でピザを食べて 映画見て
Dialogue: 0,0:09:30.36,0:09:31.63,Dial-JP,,0,0,0,,楽しく話した
Dialogue: 0,0:09:32.41,0:09:33.66,Dial-JP,,0,0,0,,それでいいんさ
Dialogue: 0,0:09:53.64,0:09:56.58,Dial-JP,,0,0,0,,もう少し お話ししたいです
Dialogue: 0,0:09:57.22,0:09:59.89,Dial-JP,,0,0,0,,そっち行って いいですか
Dialogue: 0,0:10:09.86,0:10:11.13,Dial-JP,,0,0,0,,狭くないか
Dialogue: 0,0:10:11.28,0:10:12.99,Dial-JP,,0,0,0,,いえ 大丈夫…
Dialogue: 0,0:10:16.41,0:10:18.17,Dial-JP,,0,0,0,,ちょっとだけ 狭いです
Dialogue: 0,0:10:20.91,0:10:23.62,Dial-JP,,0,0,0,,じゃあ もうちょいこっち寄るか
Dialogue: 0,0:10:26.17,0:10:26.88,Dial-JP,,0,0,0,,はい
Dialogue: 0,0:10:41.06,0:10:42.18,Dial-JP,,0,0,0,,四宮
Dialogue: 0,0:11:17.72,0:11:18.43,Dial-JP,,0,0,0,,あっ ごめ
Dialogue: 0,0:11:18.80,0:11:20.66,Dial-JP,,0,0,0,,いえ 違うんです
Dialogue: 0,0:11:22.14,0:11:23.89,Dial-JP,,0,0,0,,やっぱ やめとくか
Dialogue: 0,0:11:25.19,0:11:28.02,Dial-JP,,0,0,0,,でも 会長はしたいんですよね
Dialogue: 0,0:11:28.48,0:11:29.27,Dial-JP,,0,0,0,,いや
Dialogue: 0,0:11:30.15,0:11:33.32,Dial-JP,,0,0,0,,したくない わけではないんだけど
Dialogue: 0,0:11:34.03,0:11:36.45,Dial-JP,,0,0,0,,四宮が嫌なら…
Dialogue: 0,0:11:40.68,0:11:42.68,Dial-JP,,0,0,0,,別に焦ることでもないしな
Dialogue: 0,0:11:43.08,0:11:43.91,Dial-JP,,0,0,0,,次の機会に…
Dialogue: 0,0:11:43.91,0:11:45.41,Dial-JP,,0,0,0,,次って いつですか
Dialogue: 0,0:11:47.04,0:11:49.21,Dial-JP,,0,0,0,,焦らなくていいんですか
Dialogue: 0,0:11:50.25,0:11:52.69,Dial-JP,,0,0,0,,会長は アメリカに行ってしまうのに
Dialogue: 0,0:11:53.34,0:11:56.70,Dial-JP,,0,0,0,,私たちには そんなに時間は残ってないのに
Dialogue: 0,0:11:57.18,0:11:59.05,Dial-JP,,0,0,0,,焦るのは おかしいですか
Dialogue: 0,0:12:01.10,0:12:03.52,Dial-JP,,0,0,0,,四宮 服を整えろ
Dialogue: 0,0:12:03.85,0:12:04.70,Dial-JP,,0,0,0,,そこに座れ
Dialogue: 0,0:12:08.90,0:12:10.04,Dial-JP,,0,0,0,,あのな 四宮
Dialogue: 0,0:12:10.90,0:12:12.38,Dial-JP,,0,0,0,,俺がアメリカに行っても
Dialogue: 0,0:12:12.38,0:12:14.00,Dial-JP,,0,0,0,,俺たちは恋人だし
Dialogue: 0,0:12:14.00,0:12:16.11,Dial-JP,,0,0,0,,ちょくちょく帰ってくるつもりだ
Dialogue: 0,0:12:16.57,0:12:17.41,Dial-JP,,0,0,0,,帰ってきたら
Dialogue: 0,0:12:17.41,0:12:19.28,Dial-JP,,0,0,0,,それこそ時間はいくらでもある
Dialogue: 0,0:12:19.62,0:12:20.41,Dial-JP,,0,0,0,,違うか
Dialogue: 0,0:12:21.12,0:12:22.72,Dial-JP,,0,0,0,,でも ４年ですよ
Dialogue: 0,0:12:23.41,0:12:25.14,Dial-JP,,0,0,0,,その間に 会長
Dialogue: 0,0:12:25.62,0:12:28.50,Dial-JP,,0,0,0,,向こうで 好きな人が出来るかもしれない
Dialogue: 0,0:12:29.79,0:12:32.13,Dial-JP,,0,0,0,,焦るに決まってる じゃないですか
Dialogue: 0,0:12:33.05,0:12:36.74,Dial-JP,,0,0,0,,ならせめて 何かの形でつながって
Dialogue: 0,0:12:37.34,0:12:38.38,Dial-JP,,0,0,0,,四宮
Dialogue: 0,0:12:39.01,0:12:41.01,Dial-JP,,0,0,0,,これは俺の不利になることだから
Dialogue: 0,0:12:41.01,0:12:42.74,Dial-JP,,0,0,0,,言いたくないんだけどな
Dialogue: 0,0:12:43.60,0:12:45.81,Dial-JP,,0,0,0,,男に女を覚えさせないほうが
Dialogue: 0,0:12:45.81,0:12:47.52,Dial-JP,,0,0,0,,浮気は しないものだぞ
Dialogue: 0,0:12:48.89,0:12:50.75,Dial-JP,,0,0,0,,そうなんですか
Dialogue: 0,0:12:50.75,0:12:52.02,Dial-JP,,0,0,0,,そういうもんだ
Dialogue: 0,0:12:52.75,0:12:55.03,Dial-JP,,0,0,0,,してもしなくても どっちもどっち
Dialogue: 0,0:12:55.65,0:12:56.76,Dial-JP,,0,0,0,,こういうのは
Dialogue: 0,0:12:56.76,0:12:59.36,Dial-JP,,0,0,0,,四宮がしたいと思ったときに していいんだ
Dialogue: 0,0:13:00.76,0:13:02.20,Dial-JP,,0,0,0,,焦らなくていいんだよ
Dialogue: 0,0:13:03.91,0:13:05.12,Dial-JP,,0,0,0,,会長
Dialogue: 0,0:13:08.77,0:13:10.50,Dial-JP,,0,0,0,,そう言ってくれるなら
Dialogue: 0,0:13:10.92,0:13:14.17,Dial-JP,,0,0,0,,もう少し 心を整理する時間を下さい
Dialogue: 0,0:13:15.13,0:13:15.71,Dial-JP,,0,0,0,,ああ
Dialogue: 0,0:13:17.09,0:13:18.22,Dial-JP,,0,0,0,,今日は寝るぞ
Dialogue: 0,0:13:19.26,0:13:21.55,Dial-JP,,0,0,0,,起きたらなんかうまいもん 食いに行こう
Dialogue: 0,0:13:30.10,0:13:31.34,Dial-JP,,0,0,0,,会長 好き
Dialogue: 0,0:13:31.94,0:13:34.13,Dial-JP,,0,0,0,,俺も好きだぞ 四宮
Dialogue: 0,0:13:35.94,0:13:36.80,Dial-JP,,0,0,0,,好き
Dialogue: 0,0:13:38.80,0:13:39.53,Dial-JP,,0,0,0,,好き
Dialogue: 0,0:13:40.80,0:13:41.57,Dial-JP,,0,0,0,,好き
Dialogue: 0,0:13:41.99,0:13:42.80,Dial-JP,,0,0,0,,好き
Dialogue: 0,0:13:43.32,0:13:44.07,Dial-JP,,0,0,0,,好き
Dialogue: 0,0:13:44.62,0:13:45.43,Dial-JP,,0,0,0,,好き
Dialogue: 0,0:13:55.79,0:13:56.82,Dial-JP,,0,0,0,,結局
Dialogue: 0,0:13:56.82,0:13:58.82,Dial-JP,,0,0,0,,盛り上がって しちゃった
Dialogue: 0,0:14:01.01,0:14:02.30,Dial-JP,,0,0,0,,ただいま
Dialogue: 0,0:14:03.39,0:14:04.82,Dial-JP,,0,0,0,,あれ ピザだ
Dialogue: 0,0:14:04.97,0:14:07.30,Dial-JP,,0,0,0,,おにいがピザだなんて珍しい
Dialogue: 0,0:14:07.56,0:14:09.26,Dial-JP,,0,0,0,,昨日 誰か来てたの
Dialogue: 0,0:14:10.83,0:14:11.60,Dial-JP,,0,0,0,,いや
Dialogue: 0,0:14:20.28,0:14:23.20,Dial-JP,,0,0,0,,数時間前まで あそこに四宮と…
Dialogue: 0,0:14:23.74,0:14:24.84,Dial-JP,,0,0,0,,当たり前だけど
Dialogue: 0,0:14:24.84,0:14:27.45,Dial-JP,,0,0,0,,四宮の裸体って実在したんだな
Dialogue: 0,0:14:28.99,0:14:31.75,Dial-JP,,0,0,0,,人の肌の感触って ヤバ
Dialogue: 0,0:14:32.08,0:14:34.85,Dial-JP,,0,0,0,,先祖全員 あんなことしてたとかウソだろ
Dialogue: 0,0:14:35.29,0:14:36.86,Dial-JP,,0,0,0,,俺たち 本当に…
Dialogue: 0,0:14:37.42,0:14:39.09,Dial-JP,,0,0,0,,焦らなくていいんだよ
Dialogue: 0,0:14:40.86,0:14:42.86,Dial-JP,,0,0,0,,俺意志弱
Dialogue: 0,0:14:43.47,0:14:45.34,Dial-JP,,0,0,0,,最初の20分は耐えられた
Dialogue: 0,0:14:45.34,0:14:47.26,Dial-JP,,0,0,0,,「好き好き」言いながらキスされまくったら
Dialogue: 0,0:14:47.26,0:14:48.64,Dial-JP,,0,0,0,,ブレーキ壊れるって
Dialogue: 0,0:14:48.64,0:14:49.72,Dial-JP,,0,0,0,,これ しょうがなくない
Dialogue: 0,0:14:49.72,0:14:51.43,Dial-JP,,0,0,0,,こちとら 手をつないで歩くだけで
Dialogue: 0,0:14:51.43,0:14:54.04,Dial-JP,,0,0,0,,下半身にくる年頃の男子だぞ
Dialogue: 0,0:14:54.04,0:14:55.81,Dial-JP,,0,0,0,,ありゃ無理だから
Dialogue: 0,0:14:55.81,0:14:58.09,Dial-JP,,0,0,0,,焦らないでいこうって言った その口で…
Dialogue: 0,0:14:58.88,0:15:01.28,Dial-JP,,0,0,0,,俺最低男じゃん
Dialogue: 0,0:15:03.20,0:15:04.88,Dial-JP,,0,0,0,,四宮の香りがする
Dialogue: 0,0:15:10.54,0:15:11.79,Dial-JP,,0,0,0,,本当に
Dialogue: 0,0:15:12.12,0:15:13.46,Dial-JP,,0,0,0,,最後まで
Dialogue: 0,0:15:16.90,0:15:18.63,Dial-JP,,0,0,0,,ちょっと枕借りていいですか
Dialogue: 0,0:15:21.71,0:15:22.30,Dial-JP,,0,0,0,,でも
Dialogue: 0,0:15:22.30,0:15:25.26,Dial-JP,,0,0,0,,「焦らないでいこう」って 話をしたばかりなんですよね
Dialogue: 0,0:15:25.51,0:15:27.34,Dial-JP,,0,0,0,,そうなんですけどね
Dialogue: 0,0:15:27.72,0:15:29.47,Dial-JP,,0,0,0,,しょうがないじゃない
Dialogue: 0,0:15:29.47,0:15:32.62,Dial-JP,,0,0,0,,「焦らなくていい」と言ってくれた会長がすてきで
Dialogue: 0,0:15:32.62,0:15:33.71,Dial-JP,,0,0,0,,なんだか…
Dialogue: 0,0:15:34.77,0:15:37.23,Dial-JP,,0,0,0,,好きが 100になっちゃったんだもの
Dialogue: 0,0:15:37.23,0:15:38.92,Dial-JP,,0,0,0,,好きが100…
Dialogue: 0,0:15:38.92,0:15:42.11,Dial-JP,,0,0,0,,そうなったら 何もかもがどうでもよくなったの
Dialogue: 0,0:15:42.11,0:15:44.70,Dial-JP,,0,0,0,,やっぱり キッスの魔力はすごいわ
Dialogue: 0,0:15:44.70,0:15:46.61,Dial-JP,,0,0,0,,変なスイッチが入るの
Dialogue: 0,0:15:46.93,0:15:48.28,Dial-JP,,0,0,0,,最後のほうなんて
Dialogue: 0,0:15:48.28,0:15:51.54,Dial-JP,,0,0,0,,むしろ こっちから誘惑してる感じになっちゃったもの
Dialogue: 0,0:15:52.54,0:15:55.43,Dial-JP,,0,0,0,,一応 感想を聞いてもいいですか
Dialogue: 0,0:15:56.50,0:15:57.60,Dial-JP,,0,0,0,,どうでした
Dialogue: 0,0:16:00.29,0:16:02.13,Dial-JP,,0,0,0,,なんか すごかった
Dialogue: 0,0:16:02.94,0:16:04.76,Dial-JP,,0,0,0,,なんか すごいんだ
Dialogue: 0,0:16:05.22,0:16:06.95,Dial-JP,,0,0,0,,行為そのものの良さは
Dialogue: 0,0:16:06.95,0:16:08.64,Dial-JP,,0,0,0,,いまいち分からなかったけれど
Dialogue: 0,0:16:08.64,0:16:11.50,Dial-JP,,0,0,0,,とにかく人肌の安心感が すごくて
Dialogue: 0,0:16:11.89,0:16:14.52,Dial-JP,,0,0,0,,あれは ちょっと病みつきになりそう
Dialogue: 0,0:16:16.39,0:16:17.23,Dial-JP,,0,0,0,,でも
Dialogue: 0,0:16:18.23,0:16:20.96,Dial-JP,,0,0,0,,世の中の人が ああいうことしてて
Dialogue: 0,0:16:20.96,0:16:23.90,Dial-JP,,0,0,0,,そうやって 命はつながってきたと考えると
Dialogue: 0,0:16:23.90,0:16:24.96,Dial-JP,,0,0,0,,変な感じ
Dialogue: 0,0:16:25.94,0:16:29.28,Dial-JP,,0,0,0,,寂しがり屋が 人類の歴史を紡いできたのよ
Dialogue: 0,0:16:29.28,0:16:31.95,Dial-JP,,0,0,0,,なんか悟ったようなこと言い始めた
Dialogue: 0,0:16:33.33,0:16:34.12,Dial-JP,,0,0,0,,でも
Dialogue: 0,0:16:34.12,0:16:36.98,Dial-JP,,0,0,0,,こんなにあっさり済ませるとは思ってなかった
Dialogue: 0,0:16:37.62,0:16:39.29,Dial-JP,,0,0,0,,てっきり２人はもっと…
Dialogue: 0,0:16:39.75,0:16:41.21,Dial-JP,,0,0,0,,そんなものでしょう
Dialogue: 0,0:16:41.92,0:16:45.67,Dial-JP,,0,0,0,,特別な日の特別な夜になんて別に求めてない
Dialogue: 0,0:16:46.09,0:16:47.91,Dial-JP,,0,0,0,,もっと ありふれてるものでいい
Dialogue: 0,0:16:48.47,0:16:50.76,Dial-JP,,0,0,0,,なんとなく雰囲気に流されて
Dialogue: 0,0:16:50.99,0:16:54.66,Dial-JP,,0,0,0,,後々考えれば「少し愚かだったかも」くらいが
Dialogue: 0,0:16:54.99,0:16:55.81,Dial-JP,,0,0,0,,普通の
Dialogue: 0,0:16:56.81,0:17:00.40,Dial-JP,,0,0,0,,どこにでもいる 高校生カップルって感じがするの
Dialogue: 0,0:17:01.27,0:17:02.65,Dial-JP,,0,0,0,,普通ですか
Dialogue: 0,0:17:04.44,0:17:05.86,Dial-JP,,0,0,0,,恋をしてから
Dialogue: 0,0:17:06.32,0:17:07.90,Dial-JP,,0,0,0,,本当に少しずつ
Dialogue: 0,0:17:08.36,0:17:11.32,Dial-JP,,0,0,0,,四宮かぐやは 普通の少女になっていく
Dialogue: 0,0:17:12.78,0:17:15.49,Dial-JP,,0,0,0,,高貴でも潔癖でもなく
Dialogue: 0,0:17:16.29,0:17:19.41,Dial-JP,,0,0,0,,目の前の楽しいことを 気兼ねなく楽しむ
Dialogue: 0,0:17:20.83,0:17:22.21,Dial-JP,,0,0,0,,そんな普通に
Dialogue: 0,0:17:22.71,0:17:24.34,Dial-JP,,0,0,0,,何 笑ってるの
Dialogue: 0,0:17:24.34,0:17:25.33,Dial-JP,,0,0,0,,いえ
Dialogue: 0,0:17:25.55,0:17:26.59,Dial-JP,,0,0,0,,いつかは
Dialogue: 0,0:17:26.59,0:17:28.76,Dial-JP,,0,0,0,,かぐやは若干 口が悪くて
Dialogue: 0,0:17:28.76,0:17:30.34,Dial-JP,,0,0,0,,ちょっと頭がいいだけの
Dialogue: 0,0:17:30.34,0:17:32.59,Dial-JP,,0,0,0,,普通の女性に なっていくのかな
Dialogue: 0,0:17:32.59,0:17:34.43,Dial-JP,,0,0,0,,って思ったらつい 笑いが
Dialogue: 0,0:17:34.43,0:17:38.16,Dial-JP,,0,0,0,,何それ 全然笑いどころが分からないわ
Dialogue: 0,0:17:38.39,0:17:39.04,Dial-JP,,0,0,0,,いえ
Dialogue: 0,0:17:41.35,0:17:43.31,Dial-JP,,0,0,0,,個人的にツボなだけで
Dialogue: 0,0:17:47.40,0:17:48.74,Dial-JP,,0,0,0,,私 決めたの
Dialogue: 0,0:17:49.36,0:17:52.45,Dial-JP,,0,0,0,,文字どおり 会長には私の全てをさらした
Dialogue: 0,0:17:52.74,0:17:54.49,Dial-JP,,0,0,0,,もう怖いものなんてないわ
Dialogue: 0,0:17:55.05,0:17:57.06,Dial-JP,,0,0,0,,会長が この学園を去るまで
Dialogue: 0,0:17:57.06,0:17:58.83,Dial-JP,,0,0,0,,目いっぱい楽しもうと思うの
Dialogue: 0,0:17:59.62,0:18:01.06,Dial-JP,,0,0,0,,いろいろ吹っ切れた
Dialogue: 0,0:18:01.62,0:18:03.06,Dial-JP,,0,0,0,,したいことを してやるわ
Dialogue: 0,0:18:03.50,0:18:05.06,Dial-JP,,0,0,0,,いいんじゃない
Dialogue: 0,0:18:05.06,0:18:06.46,Dial-JP,,0,0,0,,今まで 人目を気にして
Dialogue: 0,0:18:06.46,0:18:08.38,Dial-JP,,0,0,0,,コソコソ交際してきたでしょうし
Dialogue: 0,0:18:08.38,0:18:09.51,Dial-JP,,0,0,0,,そうなのよ
Dialogue: 0,0:18:09.72,0:18:12.38,Dial-JP,,0,0,0,,本当は毎日会長と学校に行きたいし
Dialogue: 0,0:18:12.38,0:18:14.60,Dial-JP,,0,0,0,,もっと２人で遊びに出たい
Dialogue: 0,0:18:14.60,0:18:17.08,Dial-JP,,0,0,0,,お昼は２人でお弁当食べたいわ
Dialogue: 0,0:18:20.02,0:18:22.77,Dial-JP,,0,0,0,,秀知院 中のうわさになるでしょうね
Dialogue: 0,0:18:24.44,0:18:25.94,Dial-JP,,0,0,0,,知ったことじゃないのよ
Dialogue: 0,0:18:26.48,0:18:27.69,Dial-JP,,0,0,0,,なら いいけど
Dialogue: 0,0:18:29.69,0:18:31.09,Dial-JP,,0,0,0,,とうとうしたのね
Dialogue: 0,0:18:31.28,0:18:32.20,Dial-JP,,0,0,0,,会長とセッ…
Dialogue: 0,0:18:32.20,0:18:34.62,Dial-JP,,0,0,0,,盛り上がっちゃったんだから しかたないじゃない
Dialogue: 0,0:18:34.62,0:18:38.74,Dial-JP,,0,0,0,,しかたないじゃない…
Dialogue: 0,0:18:38.74,0:18:41.63,Dial-JP,,0,0,0,,盛り上がっちゃったんだから しかたないじゃない
Dialogue: 0,0:18:43.58,0:18:45.10,Dial-JP,,0,0,0,,そんなこんなで
Dialogue: 0,0:18:45.10,0:18:47.67,Dial-JP,,0,0,0,,あっというまに日々は過ぎてゆき
Dialogue: 0,0:18:47.67,0:18:50.13,Dial-JP,,0,0,0,,会長が旅立つ日が やって来て
Dialogue: 0,0:18:53.93,0:18:57.12,Dial-JP,,0,0,0,,なんで私は大勢の前であんな失態を
Dialogue: 0,0:18:57.12,0:18:58.64,Dial-JP,,0,0,0,,あの記憶だけは なくしたい
Dialogue: 0,0:18:58.64,0:19:00.43,Dial-JP,,0,0,0,,黑歴史
Dialogue: 0,0:19:00.60,0:19:03.12,Dial-JP,,0,0,0,,黒歴史 それはかぐやにもあった
Dialogue: 0,0:19:06.44,0:19:07.13,Dial-JP,,0,0,0,,明日
Dialogue: 0,0:19:07.65,0:19:10.28,Dial-JP,,0,0,0,,会長は空港から旅立ってしまう
Dialogue: 0,0:19:11.49,0:19:13.13,Dial-JP,,0,0,0,,私を残して
Dialogue: 0,0:19:14.82,0:19:16.91,Dial-JP,,0,0,0,,よく映画とかで見るやつだわ
Dialogue: 0,0:19:16.91,0:19:17.91,Dial-JP,,0,0,0,,四宮
Dialogue: 0,0:19:18.24,0:19:19.52,Dial-JP,,0,0,0,,はい 会長
Dialogue: 0,0:19:19.83,0:19:22.12,Dial-JP,,0,0,0,,俺が帰ってきたら そのときは
Dialogue: 0,0:19:23.54,0:19:24.47,Dial-JP,,0,0,0,,結婚しよう
Dialogue: 0,0:19:26.00,0:19:28.56,Dial-JP,,0,0,0,,なんてことを 言われるかもしれない
Dialogue: 0,0:19:28.56,0:19:30.35,Dial-JP,,0,0,0,,どうしましょう
Dialogue: 0,0:19:30.35,0:19:35.15,Dial-JP,,0,0,0,,そんなことを 深夜遅くまで考えていたかぐやは
Dialogue: 0,0:19:35.15,0:19:36.47,Dial-JP,,0,0,0,,なんて まさかね
Dialogue: 0,0:19:36.47,0:19:37.16,Dial-JP,,0,0,0,,でも…
Dialogue: 0,0:19:39.16,0:19:40.18,Dial-JP,,0,0,0,,早坂
Dialogue: 0,0:19:40.72,0:19:41.97,Dial-JP,,0,0,0,,今 何時
Dialogue: 0,0:19:42.35,0:19:45.16,Dial-JP,,0,0,0,,白銀が旅立つ大事な日に
Dialogue: 0,0:19:45.16,0:19:47.17,Dial-JP,,0,0,0,,盛大に寝坊した
Dialogue: 0,0:19:47.94,0:19:49.36,Dial-JP,,0,0,0,,あのアホ
Dialogue: 0,0:19:49.69,0:19:51.78,Dial-JP,,0,0,0,,さすが四宮先輩ですね
Dialogue: 0,0:19:52.40,0:19:55.17,Dial-JP,,0,0,0,,なんで こんな日に大寝坊かますのよ
Dialogue: 0,0:19:55.74,0:19:57.57,Dial-JP,,0,0,0,,急いで飛ばして
Dialogue: 0,0:20:09.54,0:20:11.19,Dial-JP,,0,0,0,,そろそろ時間か
Dialogue: 0,0:20:12.42,0:20:15.02,Dial-JP,,0,0,0,,みんな 見送りありがとな
Dialogue: 0,0:20:15.84,0:20:18.37,Dial-JP,,0,0,0,,早坂 かぐやのことは頼んだ
Dialogue: 0,0:20:20.01,0:20:22.22,Dial-JP,,0,0,0,,あとでラインするから
Dialogue: 0,0:20:22.60,0:20:23.20,Dial-JP,,0,0,0,,ああ
Dialogue: 0,0:20:23.43,0:20:25.02,Dial-JP,,0,0,0,,向こうで目移りして
Dialogue: 0,0:20:25.02,0:20:27.48,Dial-JP,,0,0,0,,かぐやさんを ヤキモキさせないでくださいね
Dialogue: 0,0:20:28.02,0:20:29.21,Dial-JP,,0,0,0,,もちろん
Dialogue: 0,0:20:29.21,0:20:30.61,Dial-JP,,0,0,0,,お前がいない間は
Dialogue: 0,0:20:30.61,0:20:32.19,Dial-JP,,0,0,0,,俺たちに任せとけ
Dialogue: 0,0:20:32.19,0:20:34.15,Dial-JP,,0,0,0,,寂しくなっちゃうな
Dialogue: 0,0:20:34.15,0:20:35.22,Dial-JP,,0,0,0,,ねえ 眞妃ちゃん
Dialogue: 0,0:20:35.51,0:20:37.63,Dial-JP,,0,0,0,,別に寂しくはないわよ
Dialogue: 0,0:20:38.28,0:20:41.22,Dial-JP,,0,0,0,,人は誰しも いつかは離れ離れになるんだから
Dialogue: 0,0:20:41.45,0:20:43.58,Dial-JP,,0,0,0,,こんなことで いちいち寂しがってたら
Dialogue: 0,0:20:43.58,0:20:44.70,Dial-JP,,0,0,0,,キリがないでしょ
Dialogue: 0,0:20:45.08,0:20:46.18,Dial-JP,,0,0,0,,で 本当は
Dialogue: 0,0:20:47.23,0:20:50.38,Dial-JP,,0,0,0,,めっちゃ寂しいわよ バカ
Dialogue: 0,0:20:50.38,0:20:51.75,Dial-JP,,0,0,0,,素直だな
Dialogue: 0,0:20:51.75,0:20:52.71,Dial-JP,,0,0,0,,ありがとな
Dialogue: 0,0:20:53.09,0:20:54.38,Dial-JP,,0,0,0,,また連絡するから
Dialogue: 0,0:20:54.38,0:20:55.84,Dial-JP,,0,0,0,,みんな 元気で過ごせよ
Dialogue: 0,0:20:57.47,0:21:00.51,Dial-JP,,0,0,0,,会長はどうしてそんなに冷静なんですか
Dialogue: 0,0:21:01.24,0:21:04.85,Dial-JP,,0,0,0,,もう かぐやさんとはしばらくお別れなのに
Dialogue: 0,0:21:06.52,0:21:07.60,Dial-JP,,0,0,0,,藤原も
Dialogue: 0,0:21:07.60,0:21:09.81,Dial-JP,,0,0,0,,まだまだ 四宮のことを分かってないな
Dialogue: 0,0:21:10.94,0:21:12.23,Dial-JP,,0,0,0,,あいつは大丈夫だよ
Dialogue: 0,0:21:12.48,0:21:13.65,Dial-JP,,0,0,0,,心配いらない
Dialogue: 0,0:21:14.23,0:21:15.48,Dial-JP,,0,0,0,,俺が保証する
Dialogue: 0,0:21:16.40,0:21:17.57,Dial-JP,,0,0,0,,そうですか
Dialogue: 0,0:21:18.70,0:21:20.11,Dial-JP,,0,0,0,,会長が そう言うなら
Dialogue: 0,0:21:20.11,0:21:21.44,Dial-JP,,0,0,0,,そうなんでしょうね
Dialogue: 0,0:21:25.41,0:21:26.41,Dial-JP,,0,0,0,,会長
Dialogue: 0,0:21:27.62,0:21:29.81,Dial-JP,,0,0,0,,会長と過ごした２年間
Dialogue: 0,0:21:29.81,0:21:31.85,Dial-JP,,0,0,0,,すっごく楽しかったですよ
Dialogue: 0,0:21:32.21,0:21:34.21,Dial-JP,,0,0,0,,ダメな息子を持った気分で
Dialogue: 0,0:21:34.21,0:21:36.19,Dial-JP,,0,0,0,,意外と悪くなかったです
Dialogue: 0,0:21:36.19,0:21:37.28,Dial-JP,,0,0,0,,私は
Dialogue: 0,0:21:37.28,0:21:39.88,Dial-JP,,0,0,0,,変なお兄ちゃんを持ったような 気分でした
Dialogue: 0,0:21:40.34,0:21:41.80,Dial-JP,,0,0,0,,いろいろ教わって
Dialogue: 0,0:21:41.80,0:21:43.79,Dial-JP,,0,0,0,,たくさん支えてもらいました
Dialogue: 0,0:21:44.18,0:21:47.01,Dial-JP,,0,0,0,,尊敬できて 大好きな会長でした
Dialogue: 0,0:21:47.29,0:21:48.60,Dial-JP,,0,0,0,,お達者で
Dialogue: 0,0:21:49.10,0:21:49.94,Dial-JP,,0,0,0,,会長
Dialogue: 0,0:21:50.35,0:21:52.40,Dial-JP,,0,0,0,,なんかあったら頼ってくださいよ
Dialogue: 0,0:21:53.29,0:21:54.55,Dial-JP,,0,0,0,,海外だろうと
Dialogue: 0,0:21:54.94,0:21:56.52,Dial-JP,,0,0,0,,すぐ飛んでいきますから
Dialogue: 0,0:22:01.99,0:22:03.57,Dial-JP,,0,0,0,,じゃ また
Dialogue: 0,0:22:05.31,0:22:06.14,Dial-JP,,0,0,0,,またな
Dialogue: 0,0:22:21.05,0:22:22.34,Dial-JP,,0,0,0,,会長は
Dialogue: 0,0:22:23.55,0:22:25.33,Dial-JP,,0,0,0,,もう行っちゃいましたよ
Dialogue: 0,0:22:44.36,0:22:45.88,Dial-JP,,0,0,0,,会長
Dialogue: 0,0:22:45.88,0:22:46.89,Dial-JP,,0,0,0,,四宮
Dialogue: 0,0:22:46.89,0:22:49.35,Dial-JP,,0,0,0,,私もお別れを言いにきました
Dialogue: 0,0:22:49.35,0:22:50.87,Dial-JP,,0,0,0,,そういう距離じゃないけどな
Dialogue: 0,0:22:50.87,0:22:52.51,Dial-JP,,0,0,0,,国またいでるけどな
Dialogue: 0,0:22:52.83,0:22:56.25,Dial-JP,,0,0,0,,本当にお前は やることなすことむちゃくちゃだな
Dialogue: 0,0:22:56.54,0:22:57.91,Dial-JP,,0,0,0,,大げさです
Dialogue: 0,0:22:57.91,0:23:00.19,Dial-JP,,0,0,0,,飛行機１本 乗るだけですよ
Dialogue: 0,0:23:01.36,0:23:04.89,Dial-JP,,0,0,0,,でも 案外東京とカリフォルニアって近いですね
Dialogue: 0,0:23:04.89,0:23:06.80,Dial-JP,,0,0,0,,これなら毎週末来れそうです
Dialogue: 0,0:23:07.97,0:23:09.81,Dial-JP,,0,0,0,,金曜夜に寝ながら来て
Dialogue: 0,0:23:09.81,0:23:11.73,Dial-JP,,0,0,0,,日曜夜の便に 乗って帰れば
Dialogue: 0,0:23:11.73,0:23:13.37,Dial-JP,,0,0,0,,学校にも間に合うし
Dialogue: 0,0:23:13.37,0:23:15.38,Dial-JP,,0,0,0,,え それはさすがに…
Dialogue: 0,0:23:15.52,0:23:18.40,Dial-JP,,0,0,0,,会長は私と一緒に いたくないんですか
Dialogue: 0,0:23:18.40,0:23:20.94,Dial-JP,,0,0,0,,あっいや ずっと一緒にいたいけど
Dialogue: 0,0:23:20.94,0:23:23.03,Dial-JP,,0,0,0,,ですよね
Dialogue: 0,0:23:25.39,0:23:26.66,Dial-JP,,0,0,0,,いや 本当に
Dialogue: 0,0:23:26.66,0:23:29.74,Dial-JP,,0,0,0,,会長はかぐやさんのことよく分かってますね
Dialogue: 0,0:23:30.12,0:23:32.75,Dial-JP,,0,0,0,,あれだけ感動的な お別れしたのに
Dialogue: 0,0:23:32.75,0:23:35.71,Dial-JP,,0,0,0,,全然 会長が 遠くに行った感じしないんですが
Dialogue: 0,0:23:36.42,0:23:37.40,Dial-JP,,0,0,0,,俺もだよ
Dialogue: 0,0:23:37.65,0:23:39.69,Dial-JP,,0,0,0,,これも文明の進歩ですかね
Dialogue: 0,0:23:40.00,0:23:42.00,Dial-JP,,0,0,0,,四宮先輩のアイデアです
Dialogue: 0,0:23:42.30,0:23:45.18,Dial-JP,,0,0,0,,これなら 距離なんて あってないようなものですからね
Dialogue: 0,0:23:45.41,0:23:48.58,Dial-JP,,0,0,0,,何事も考え続ければ 解は出るんです
Dialogue: 0,0:23:49.01,0:23:51.68,Dial-JP,,0,0,0,,恋愛は頭脳でするものなんですよ
Dialogue: 0,0:23:52.10,0:23:53.41,Dial-JP,,0,0,0,,ね 会長
Dialogue: 0,0:24:00.15,0:24:01.42,Dial-JP,,0,0,0,,ただいま かぐや
Dialogue: 0,0:24:02.19,0:24:03.42,Dial-JP,,0,0,0,,おかえりなさい
Dialogue: 0,0:24:03.57,0:24:04.49,Dial-JP,,0,0,0,,会長
Dialogue: 0,0:24:05.86,0:24:07.43,Dial-JP,,0,0,0,,遅かったですね
Dialogue: 0,0:24:07.43,0:24:09.01,Dial-JP,,0,0,0,,いろいろ重なってな
Dialogue: 0,0:24:09.82,0:24:12.01,Dial-JP,,0,0,0,,あまり無理はしないでくださいね
Dialogue: 0,0:24:14.16,0:24:15.99,Dial-JP,,0,0,0,,今日 圭さんが来たんですよ
Dialogue: 0,0:24:15.99,0:24:17.08,Dial-JP,,0,0,0,,なんの用
Dialogue: 0,0:24:17.08,0:24:19.18,Dial-JP,,0,0,0,,顔が見たかっただけだって
Dialogue: 0,0:24:19.83,0:24:21.26,Dial-JP,,0,0,0,,かぐやのを だろ
Dialogue: 0,0:24:21.59,0:24:23.05,Dial-JP,,0,0,0,,かもしれませんね
Dialogue: 0,0:24:23.80,0:24:26.13,Dial-JP,,0,0,0,,はい アルバム集めておきました
Dialogue: 0,0:24:26.76,0:24:27.65,Dial-JP,,0,0,0,,ありがとな
Dialogue: 0,0:24:28.39,0:24:29.45,Dial-JP,,0,0,0,,結構 多いな
Dialogue: 0,0:24:29.80,0:24:31.45,Dial-JP,,0,0,0,,たくさん撮りましたから
Dialogue: 0,0:24:31.93,0:24:34.75,Dial-JP,,0,0,0,,でも アルバムなんて 何に使うんですか
Dialogue: 0,0:24:35.85,0:24:37.46,Dial-JP,,0,0,0,,今 うちの会社で作ってる
Dialogue: 0,0:24:37.46,0:24:40.65,Dial-JP,,0,0,0,,システムサンプルデータに使いたいって 開発者がな
Dialogue: 0,0:24:41.82,0:24:43.28,Dial-JP,,0,0,0,,元ＴＧ部の…
Dialogue: 0,0:24:43.28,0:24:44.40,Dial-JP,,0,0,0,,そうそう
Dialogue: 0,0:24:44.40,0:24:47.78,Dial-JP,,0,0,0,,悔しいことに マジの天才なんだよな あいつ
Dialogue: 0,0:24:49.47,0:24:52.35,Dial-JP,,0,0,0,,学生時代は ただの問題児でしたのに
Dialogue: 0,0:24:53.20,0:24:54.70,Dial-JP,,0,0,0,,分からないものですね
Dialogue: 0,0:24:56.29,0:24:57.48,Dial-JP,,0,0,0,,フッ 俺たちだって
Dialogue: 0,0:24:58.62,0:24:59.75,Dial-JP,,0,0,0,,そうですね
Dialogue: 0,0:26:36.30,0:26:39.58,Dial-JP,,0,0,0,,禍福 は糾える縄のごとし
Dialogue: 0,0:26:40.14,0:26:42.73,Dial-JP,,0,0,0,,そして 機械の歯車か
Dialogue: 0,0:26:42.73,0:26:45.59,Dial-JP,,0,0,0,,あるいは運命のいたずらによって
Dialogue: 0,0:26:45.59,0:26:48.73,Dial-JP,,0,0,0,,思い出を巡る色とりどりの物語が
Dialogue: 0,0:26:49.59,0:26:51.59,Dial-JP,,0,0,0,,今 動き出す
Dialogue: 0,0:26:52.20,0:26:56.13,Dial-JP,,0,0,0,,大人になった彼ら彼女らを主役にして
Comment: 0,0:22:22.11,0:22:22.28,Dial-CN,,0,0,0,,=========IN=========
Dialogue: 1,0:22:21.32,0:22:26.42,IN - JP,,0,0,0,,{\blur4\fad(200,200)}ごめんね なにもかも
Dialogue: 1,0:22:26.91,0:22:31.33,IN - JP,,0,0,0,,{\blur4\fad(200,200)}やさしい君のせいにして
Dialogue: 1,0:22:33.86,0:22:38.98,IN - JP,,0,0,0,,{\blur4\fad(200,200)}困った その横顔
Dialogue: 1,0:22:38.98,0:22:44.93,IN - JP,,0,0,0,,{\blur4\fad(200,200)}きっと私にしかもうほどけない
Dialogue: 1,0:22:45.16,0:22:46.86,IN - JP,,0,0,0,,{\blur4\fad(200,200)}君のとなり
Dialogue: 1,0:22:46.86,0:22:50.89,IN - JP,,0,0,0,,{\blur4\fad(200,200)}かじかんでしまいそうな
Dialogue: 1,0:22:51.35,0:22:54.25,IN - JP,,0,0,0,,{\blur4\fad(200,200)}この想いをまっすぐに
Dialogue: 1,0:22:54.25,0:23:00.74,IN - JP,,0,0,0,,{\blur4\fad(200,200)}今日こそちゃんと君に伝えたい
Dialogue: 1,0:23:00.74,0:23:04.99,IN - JP,,0,0,0,,{\blur4\fad(200,200)}いつも迷いながら
Dialogue: 1,0:23:04.99,0:23:07.89,IN - JP,,0,0,0,,{\blur4\fad(200,200)}めぐりあえた
Dialogue: 1,0:23:07.89,0:23:13.10,IN - JP,,0,0,0,,{\blur4\fad(200,200)}そのすべてが私だけのきもち
Dialogue: 1,0:23:13.10,0:23:17.53,IN - JP,,0,0,0,,{\blur4\fad(200,200)}私のハートノート
Dialogue: 1,0:23:17.53,0:23:26.97,IN - JP,,0,0,0,,{\blur4\fad(200,200)}甘さも苦さも抱きしめて 全部
Dialogue: 0,0:22:21.32,0:22:26.42,IN - CN,,0,0,0,,{\blur4\fad(200,200)}抱歉啊 是我将一切
Dialogue: 0,0:22:26.91,0:22:31.33,IN - CN,,0,0,0,,{\blur4\fad(200,200)}全都归咎于温柔的你
Dialogue: 0,0:22:33.86,0:22:38.98,IN - CN,,0,0,0,,{\blur4\fad(200,200)}你眉间紧锁 有些困扰的表情
Dialogue: 0,0:22:38.98,0:22:44.93,IN - CN,,0,0,0,,{\blur4\fad(200,200)}一定只有我 才能将其消解
Dialogue: 0,0:22:45.16,0:22:46.86,IN - CN,,0,0,0,,{\blur4\fad(200,200)}在你身旁 与你并肩
Dialogue: 0,0:22:46.86,0:22:50.89,IN - CN,,0,0,0,,{\blur4\fad(200,200)}今天一定要 将这近乎麻木的心意
Dialogue: 0,0:22:51.35,0:22:54.25,IN - CN,,0,0,0,,{\blur4\fad(200,200)}鼓起勇气 坦诚直率
Dialogue: 0,0:22:54.25,0:23:00.74,IN - CN,,0,0,0,,{\blur4\fad(200,200)}毫无保留地传达给你
Dialogue: 0,0:23:00.74,0:23:04.99,IN - CN,,0,0,0,,{\blur4\fad(200,200)}总是犹豫不决
Dialogue: 0,0:23:04.99,0:23:07.89,IN - CN,,0,0,0,,{\blur4\fad(200,200)}而命运让我们邂逅
Dialogue: 0,0:23:07.89,0:23:13.10,IN - CN,,0,0,0,,{\blur4\fad(200,200)}这所有的一切 就是我的心意
Dialogue: 0,0:23:13.10,0:23:17.53,IN - CN,,0,0,0,,{\blur4\fad(200,200)}我的心之笔记
Dialogue: 0,0:23:17.53,0:23:26.97,IN - CN,,0,0,0,,{\blur4\fad(200,200)}无论甜蜜苦涩 一并拥入怀中
Comment: 0,0:03:00.62,0:26:58.80,OP - CN,,0,0,0,,=========OP=========
Dialogue: 0,0:03:00.62,0:03:05.39,OP - JP,,0,0,0,,美しいままで 想い出にしましょう
Dialogue: 0,0:03:05.39,0:03:08.17,OP - JP,,0,0,0,,なんてふたりじゃないよね
Dialogue: 0,0:03:08.17,0:03:10.39,OP - JP,,0,0,0,,Re-dance re-dance re-dance
Dialogue: 0,0:03:10.39,0:03:12.93,OP - JP,,0,0,0,,さぁ 踊れ
Dialogue: 0,0:03:23.94,0:03:27.10,OP - JP,,0,0,0,,どうして 妬いてしまうんだ
Dialogue: 0,0:03:27.10,0:03:31.78,OP - JP,,0,0,0,,あなたの声が 誰かのものになる
Dialogue: 0,0:03:32.18,0:03:35.13,OP - JP,,0,0,0,,ずっと 首筋に
Dialogue: 0,0:03:35.13,0:03:40.18,OP - JP,,0,0,0,,ひりつくような 余韻が消えなくて
Dialogue: 0,0:03:40.18,0:03:47.33,OP - JP,,0,0,0,,完璧な記憶 お洒落に閉じたのに
Dialogue: 0,0:03:47.69,0:03:50.09,OP - JP,,0,0,0,,開けたらいけないと
Dialogue: 0,0:03:50.09,0:03:55.71,OP - JP,,0,0,0,,ふたり知ってる だけど鳴るのさ
Dialogue: 0,0:03:56.08,0:04:00.36,OP - JP,,0,0,0,,止まれない うるさく愛が
Dialogue: 0,0:04:01.07,0:04:03.87,OP - JP,,0,0,0,,美しいままで
Dialogue: 0,0:04:03.87,0:04:05.95,OP - JP,,0,0,0,,さよならにしましょう
Dialogue: 0,0:04:05.95,0:04:10.09,OP - JP,,0,0,0,,はぐらかす素振りがもうアブナイ
Dialogue: 0,0:04:10.09,0:04:12.29,OP - JP,,0,0,0,,魅惑のメロディ
Dialogue: 0,0:04:12.29,0:04:14.23,OP - JP,,0,0,0,,リフレインするなら
Dialogue: 0,0:04:14.23,0:04:16.99,OP - JP,,0,0,0,,想い出も燃やしましょう
Dialogue: 0,0:03:00.62,0:03:05.39,OP - CN,,0,0,0,,让一切永葆美好 留存在回忆中吧
Dialogue: 0,0:03:05.39,0:03:08.17,OP - CN,,0,0,0,,但这并非我们该有的结局吧
Dialogue: 0,0:03:08.17,0:03:10.39,OP - CN,,0,0,0,,再度起舞 再度起舞 再度起舞
Dialogue: 0,0:03:10.39,0:03:12.93,OP - CN,,0,0,0,,来吧 恣意舞动
Dialogue: 0,0:03:23.94,0:03:27.10,OP - CN,,0,0,0,,为何我会感到嫉妒呢
Dialogue: 0,0:03:27.10,0:03:31.78,OP - CN,,0,0,0,,你的声音竟然会归他人所有
Dialogue: 0,0:03:32.18,0:03:35.13,OP - CN,,0,0,0,,令我的脖颈
Dialogue: 0,0:03:35.13,0:03:40.18,OP - CN,,0,0,0,,感到刺痛的余韵一直难以消散
Dialogue: 0,0:03:40.18,0:03:47.33,OP - CN,,0,0,0,,明明已将完美的记忆精心封存
Dialogue: 0,0:03:47.69,0:03:50.09,OP - CN,,0,0,0,,绝对不可以轻易打开
Dialogue: 0,0:03:50.09,0:03:55.71,OP - CN,,0,0,0,,尽管我们彼此清楚 但喧嚣的爱
Dialogue: 0,0:03:56.08,0:04:00.36,OP - CN,,0,0,0,,根本无法抑制 却发出鸣响
Dialogue: 0,0:04:01.07,0:04:03.87,OP - CN,,0,0,0,,让一切永葆美好
Dialogue: 0,0:04:03.87,0:04:05.95,OP - CN,,0,0,0,,然后便就此与彼此道别
Dialogue: 0,0:04:05.95,0:04:10.09,OP - CN,,0,0,0,,你那逃避敷衍的态度实在危险至极
Dialogue: 0,0:04:10.09,0:04:12.29,OP - CN,,0,0,0,,若是魅惑的旋律
Dialogue: 0,0:04:12.29,0:04:14.23,OP - CN,,0,0,0,,将再次响彻起来的话
Dialogue: 0,0:04:14.23,0:04:16.99,OP - CN,,0,0,0,,那就将回忆也付之一炬吧
Dialogue: 0,0:04:16.99,0:04:17.22,OP - CN,,0,0,0,,{\bord0\fs150\fnEPKNWTRO\c&HFFFFFF&\pos(960,781)}再度起舞
