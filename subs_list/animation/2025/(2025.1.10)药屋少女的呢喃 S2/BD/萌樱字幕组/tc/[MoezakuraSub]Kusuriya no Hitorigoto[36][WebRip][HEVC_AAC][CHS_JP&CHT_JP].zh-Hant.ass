Dialogue: 0,0:02:39.10,0:02:43.10,标题,,1300,0,170,,{\fad(484,472)\pos(1549,910)}第36話 華瑞月
Dialogue: 0,0:01:35.68,0:01:38.45,jp,,0,0,0,,事態を察した　数名の高官たちは
Dialogue: 1,0:01:35.68,0:01:38.45,zh,,0,0,0,,察覺異樣的幾名官員
Dialogue: 0,0:01:38.45,0:01:40.95,jp,,0,0,0,,すでに捜索に出ているが
Dialogue: 1,0:01:38.45,0:01:40.95,zh,,0,0,0,,已經出去搜查了
Dialogue: 0,0:01:41.63,0:01:43.75,jp,,0,0,0,,一体どこへ行かれたのでしょう
Dialogue: 1,0:01:41.63,0:01:43.75,zh,,0,0,0,,他到底去哪裡了?
Dialogue: 0,0:01:43.75,0:01:46.60,jp,,0,0,0,,侍女と２人で消えたとか
Dialogue: 1,0:01:43.75,0:01:46.60,zh,,0,0,0,,和侍女一起離開了吧
Dialogue: 0,0:01:46.60,0:01:48.15,jp,,0,0,0,,逢い引きでは?
Dialogue: 1,0:01:46.60,0:01:48.15,zh,,0,0,0,,去幽會去了嗎
Dialogue: 0,0:01:49.52,0:01:52.14,jp,,0,0,0,,そんなわけがあるか　ばからしい
Dialogue: 1,0:01:49.52,0:01:52.14,zh,,0,0,0,,說什麼蠢話 荒唐至極
Dialogue: 0,0:01:52.91,0:01:53.51,jp,,0,0,0,,しかし
Dialogue: 1,0:01:52.91,0:01:53.51,zh,,0,0,0,,但是
Dialogue: 0,0:01:54.17,0:01:56.49,jp,,0,0,0,,あの方が席を外されて２時間
Dialogue: 1,0:01:54.17,0:01:56.49,zh,,0,0,0,,大人已經出去一個時辰了
Dialogue: 0,0:01:57.07,0:02:00.81,jp,,0,0,0,,部下を捜索に向かわせてはいるが　進展はない
Dialogue: 1,0:01:57.07,0:02:00.81,zh,,0,0,0,,派了屬下去找 也沒有找到
Dialogue: 0,0:02:01.81,0:02:04.90,jp,,0,0,0,,今は父上を頼るわけにもいかん
Dialogue: 1,0:02:01.81,0:02:04.90,zh,,0,0,0,,現在也不能依靠父親
Dialogue: 0,0:02:05.53,0:02:08.65,jp,,0,0,0,,先ほどあの下女に　何かを命じたようだが
Dialogue: 1,0:02:05.53,0:02:08.65,zh,,0,0,0,,父親剛才好像對那個侍女說了些什麼
Dialogue: 0,0:02:10.15,0:02:11.99,jp,,0,0,0,,やはり　あるじに何を言われようと
Dialogue: 1,0:02:10.15,0:02:11.99,zh,,0,0,0,,果然 不管大人說什麼
Dialogue: 0,0:02:11.99,0:02:13.40,jp,,0,0,0,,ついていくべきだった
Dialogue: 1,0:02:11.99,0:02:13.40,zh,,0,0,0,,我都該跟著去的
Dialogue: 0,0:02:14.26,0:02:16.91,jp,,0,0,0,,形だけの役割などうんざりだ
Dialogue: 1,0:02:14.26,0:02:16.91,zh,,0,0,0,,我已經受夠了只是做做樣子
Dialogue: 0,0:02:17.66,0:02:18.83,jp,,0,0,0,,せめて主催が
Dialogue: 1,0:02:17.66,0:02:18.83,zh,,0,0,0,,至少主辦者
Dialogue: 0,0:02:18.83,0:02:21.23,jp,,0,0,0,,この場をお開きにしてくれたら
Dialogue: 1,0:02:18.83,0:02:21.23,zh,,0,0,0,,可以先結束這場宴會吧
Dialogue: 0,0:02:22.91,0:02:23.72,jp,,0,0,0,,子昌
Dialogue: 1,0:02:22.91,0:02:23.72,zh,,0,0,0,,子昌
Dialogue: 0,0:02:24.67,0:02:28.97,jp,,0,0,0,,相変わらず　何を考えているのかわからない男だ
Dialogue: 1,0:02:24.67,0:02:28.97,zh,,0,0,0,,還是老樣子 完全猜不透他的想法
Dialogue: 0,0:02:29.65,0:02:32.46,jp,,0,0,0,,だが　自分が主催のうたげで
Dialogue: 1,0:02:29.65,0:02:32.46,zh,,0,0,0,,不過 這是他自己舉辦的宴會
Dialogue: 0,0:02:32.46,0:02:34.54,jp,,0,0,0,,やっかい事を起こしたくはないはず
Dialogue: 1,0:02:32.46,0:02:34.54,zh,,0,0,0,,應該也不想生什麼事端吧
Dialogue: 0,0:02:35.04,0:02:38.60,jp,,0,0,0,,とすると　子昌には関わりのない案件か?
Dialogue: 1,0:02:35.04,0:02:38.60,zh,,0,0,0,,這樣看來 子昌應該也不知情吧
Dialogue: 0,0:02:53.01,0:02:54.41,jp,,0,0,0,,温かい
Dialogue: 1,0:02:53.01,0:02:54.41,zh,,0,0,0,,好溫暖
Dialogue: 0,0:02:54.41,0:02:57.46,jp,,0,0,0,,それにかすかな香の匂いも
Dialogue: 1,0:02:54.41,0:02:57.46,zh,,0,0,0,,還有微弱的香氣
Dialogue: 0,0:02:57.46,0:02:59.71,jp,,0,0,0,,しかし　そんなことよりも
Dialogue: 1,0:02:57.46,0:02:59.71,zh,,0,0,0,,不過 比起這個
Dialogue: 0,0:02:59.71,0:03:00.71,jp,,0,0,0,,これ
Dialogue: 1,0:02:59.71,0:03:00.71,zh,,0,0,0,,這...
Dialogue: 0,0:03:03.80,0:03:04.87,jp,,0,0,0,,なんだ?
Dialogue: 1,0:03:03.80,0:03:04.87,zh,,0,0,0,,這是什麼?
Dialogue: 0,0:03:05.88,0:03:07.46,jp,,0,0,0,,さっきのかえるか?
Dialogue: 1,0:03:05.88,0:03:07.46,zh,,0,0,0,,是剛才的青蛙嗎?
Dialogue: 0,0:03:07.46,0:03:09.45,jp,,0,0,0,,にしては大きいような
Dialogue: 1,0:03:07.46,0:03:09.45,zh,,0,0,0,,不過感覺要比剛才的大一些
Dialogue: 0,0:03:10.18,0:03:11.82,jp,,0,0,0,,すまないが
Dialogue: 1,0:03:10.18,0:03:11.82,zh,,0,0,0,,不好意思
Dialogue: 0,0:03:11.82,0:03:14.25,jp,,0,0,0,,その手をどかしてくれないか?
Dialogue: 1,0:03:11.82,0:03:14.25,zh,,0,0,0,,可以把手拿開嗎?
Dialogue: 0,0:03:14.25,0:03:15.94,jp,,0,0,0,,障りがあるんだが
Dialogue: 1,0:03:14.25,0:03:15.94,zh,,0,0,0,,這樣我會有感覺
Dialogue: 0,0:03:17.34,0:03:18.68,jp,,0,0,0,,障り?
Dialogue: 1,0:03:17.34,0:03:18.68,zh,,0,0,0,,有感覺?
Dialogue: 0,0:03:24.20,0:03:26.06,jp,,0,0,0,,あるわけない
Dialogue: 1,0:03:24.20,0:03:26.06,zh,,0,0,0,,不可能
Dialogue: 0,0:03:26.06,0:03:30.19,jp,,0,0,0,,後宮に立ち入る宦官に　あってはいけないものだ
Dialogue: 1,0:03:26.06,0:03:30.19,zh,,0,0,0,,後宮裡的宦官 怎麼可能
Dialogue: 0,0:03:31.40,0:03:33.19,jp,,0,0,0,,だが　ある
Dialogue: 1,0:03:31.40,0:03:33.19,zh,,0,0,0,,但是 他有
Dialogue: 0,0:03:37.25,0:03:39.03,jp,,0,0,0,,宦官らしくない体
Dialogue: 1,0:03:37.25,0:03:39.03,zh,,0,0,0,,他的身材也不像是宦官該有的
Dialogue: 0,0:03:39.47,0:03:42.08,jp,,0,0,0,,思い当たることは　いくらでもあった
Dialogue: 1,0:03:39.47,0:03:42.08,zh,,0,0,0,,這樣想來 也確實有很多細節證實
Dialogue: 0,0:03:42.08,0:03:46.24,jp,,0,0,0,,でも　考えるのを無意識に避けていたのかもしれない
Dialogue: 1,0:03:42.08,0:03:46.24,zh,,0,0,0,,但是 或許我下意識迴避了
Dialogue: 0,0:03:46.83,0:03:49.29,jp,,0,0,0,,天女のような顔をしているが
Dialogue: 1,0:03:46.83,0:03:49.29,zh,,0,0,0,,他雖然長得像仙女
Dialogue: 0,0:03:49.29,0:03:50.87,jp,,0,0,0,,壬氏様は
Dialogue: 1,0:03:49.29,0:03:50.87,zh,,0,0,0,,但壬氏大人...
Dialogue: 0,0:03:52.26,0:03:54.60,jp,,0,0,0,,ある意味説明する手間が
Dialogue: 1,0:03:52.26,0:03:54.60,zh,,0,0,0,,某種意義來說
Dialogue: 0,0:03:54.60,0:03:56.30,jp,,0,0,0,,省けたということか
Dialogue: 1,0:03:54.60,0:03:56.30,zh,,0,0,0,,這樣也省得我去解釋了吧
Dialogue: 0,0:04:01.49,0:04:03.26,jp,,0,0,0,,お前に伝えたいことがある
Dialogue: 1,0:04:01.49,0:04:03.26,zh,,0,0,0,,我有話想對你說
Dialogue: 0,0:04:03.26,0:04:06.10,jp,,0,0,0,,だめだ　これ以上聞いてはいけない
Dialogue: 1,0:04:03.26,0:04:06.10,zh,,0,0,0,,不行 我不能再繼續聽下去了
Dialogue: 0,0:04:06.58,0:04:09.35,jp,,0,0,0,,今回ついてきてもらったのも　そのためだ
Dialogue: 1,0:04:06.58,0:04:09.35,zh,,0,0,0,,這次帶你來也是為了此事
Dialogue: 0,0:04:09.35,0:04:12.52,jp,,0,0,0,,知ってしまえば　墓まで持っていくことになる
Dialogue: 1,0:04:09.35,0:04:12.52,zh,,0,0,0,,如果我知道 就必須要帶進墳墓了
Dialogue: 0,0:04:12.52,0:04:14.19,jp,,0,0,0,,薬屋　俺は
Dialogue: 1,0:04:12.52,0:04:14.19,zh,,0,0,0,,藥師 我...
Dialogue: 0,0:04:14.19,0:04:16.13,jp,,0,0,0,,申し訳ありません
Dialogue: 1,0:04:14.19,0:04:16.13,zh,,0,0,0,,十分抱歉
Dialogue: 0,0:04:16.13,0:04:18.65,jp,,0,0,0,,かえるを　潰してしまったかもしれません
Dialogue: 1,0:04:16.13,0:04:18.65,zh,,0,0,0,,我好像壓到了一隻青蛙
Dialogue: 0,0:04:20.32,0:04:21.46,jp,,0,0,0,,かえる?
Dialogue: 1,0:04:20.32,0:04:21.46,zh,,0,0,0,,青蛙?
Dialogue: 0,0:04:22.82,0:04:24.84,jp,,0,0,0,,突然上から降ってきて
Dialogue: 1,0:04:22.82,0:04:24.84,zh,,0,0,0,,它突然從上面蹦下來
Dialogue: 0,0:04:24.84,0:04:27.30,jp,,0,0,0,,姿勢を崩してしまったんです
Dialogue: 1,0:04:24.84,0:04:27.30,zh,,0,0,0,,害我失去平衡
Dialogue: 0,0:04:27.30,0:04:29.04,jp,,0,0,0,,おけがはありませんでしたか
Dialogue: 1,0:04:27.30,0:04:29.04,zh,,0,0,0,,你沒有受傷吧
Dialogue: 0,0:04:29.75,0:04:30.96,jp,,0,0,0,,いいや　かえるでは
Dialogue: 1,0:04:29.75,0:04:30.96,zh,,0,0,0,,那不是青蛙
Dialogue: 0,0:04:30.96,0:04:32.23,jp,,0,0,0,,かえるです
Dialogue: 1,0:04:30.96,0:04:32.23,zh,,0,0,0,,不 就是青蛙
Dialogue: 0,0:04:32.23,0:04:35.05,jp,,0,0,0,,かえる　あれはかえるだ
Dialogue: 1,0:04:32.23,0:04:35.05,zh,,0,0,0,,就是青蛙
Dialogue: 0,0:04:35.53,0:04:37.84,jp,,0,0,0,,さあ　早くここから出ましょう
Dialogue: 1,0:04:35.53,0:04:37.84,zh,,0,0,0,,我們快離開這裡吧
Dialogue: 0,0:04:41.30,0:04:42.93,jp,,0,0,0,,誰がかえるだと
Dialogue: 1,0:04:41.30,0:04:42.93,zh,,0,0,0,,你說什麼東西是青蛙
Dialogue: 0,0:04:45.90,0:04:48.73,jp,,0,0,0,,かえるでなかったら　なんなんでしょう
Dialogue: 1,0:04:45.90,0:04:48.73,zh,,0,0,0,,你說不是青蛙 那是什麼
Dialogue: 0,0:04:48.73,0:04:50.98,jp,,0,0,0,,かえるはもっと小さいだろう
Dialogue: 1,0:04:48.73,0:04:50.98,zh,,0,0,0,,青蛙不是更小嗎
Dialogue: 0,0:04:50.98,0:04:55.26,jp,,0,0,0,,この季節　そこそこ大きいかえるなどたくさんいます
Dialogue: 1,0:04:50.98,0:04:55.26,zh,,0,0,0,,這個季節也有很多不大的青蛙
Dialogue: 0,0:04:55.26,0:04:56.48,jp,,0,0,0,,そこそこ?
Dialogue: 1,0:04:55.26,0:04:56.48,zh,,0,0,0,,不大?
Dialogue: 0,0:04:56.48,0:04:58.24,jp,,0,0,0,,ええ　そこそこです
Dialogue: 1,0:04:56.48,0:04:58.24,zh,,0,0,0,,對 不大
Dialogue: 0,0:04:58.24,0:05:00.23,jp,,0,0,0,,そこそこのかえるでなかったら
Dialogue: 1,0:04:58.24,0:05:00.23,zh,,0,0,0,,如果不是不大的青蛙的話
Dialogue: 0,0:05:00.23,0:05:02.37,jp,,0,0,0,,そこそこのなんですか
Dialogue: 1,0:05:00.23,0:05:02.37,zh,,0,0,0,,那又是什麼
Dialogue: 0,0:05:02.37,0:05:04.45,jp,,0,0,0,,おい　何手を拭っている
Dialogue: 1,0:05:02.37,0:05:04.45,zh,,0,0,0,,喂 你在擦什麼手
Dialogue: 0,0:05:04.45,0:05:07.17,jp,,0,0,0,,いや　かえるって気持ち悪いでしょう
Dialogue: 1,0:05:04.45,0:05:07.17,zh,,0,0,0,,哎呀 青蛙有點噁心
Dialogue: 0,0:05:07.17,0:05:08.95,jp,,0,0,0,,粘液を出しますし
Dialogue: 1,0:05:07.17,0:05:08.95,zh,,0,0,0,,會分泌黏液 黏糊糊的
Dialogue: 0,0:05:08.95,0:05:10.24,jp,,0,0,0,,きもっ
Dialogue: 1,0:05:08.95,0:05:10.24,zh,,0,0,0,,噁心?
Dialogue: 0,0:05:10.24,0:05:11.58,jp,,0,0,0,,誰が粘液だ
Dialogue: 1,0:05:10.24,0:05:11.58,zh,,0,0,0,,誰會分泌黏液啊
Dialogue: 0,0:05:11.58,0:05:13.08,jp,,0,0,0,,とにかく
Dialogue: 1,0:05:11.58,0:05:13.08,zh,,0,0,0,,總之
Dialogue: 0,0:05:13.55,0:05:15.74,jp,,0,0,0,,私は何も知りません
Dialogue: 1,0:05:13.55,0:05:15.74,zh,,0,0,0,,我什麼也不知道
Dialogue: 0,0:05:16.75,0:05:19.38,jp,,0,0,0,,何事も知り過ぎてはよくない
Dialogue: 1,0:05:16.75,0:05:19.38,zh,,0,0,0,,凡事還是少知道為好
Dialogue: 0,0:05:19.38,0:05:22.37,jp,,0,0,0,,壬氏様と私は高官と下女
Dialogue: 1,0:05:19.38,0:05:22.37,zh,,0,0,0,,壬氏大人與我是高官和侍女
Dialogue: 0,0:05:22.37,0:05:24.67,jp,,0,0,0,,それ以上でもそれ以下でもない
Dialogue: 1,0:05:22.37,0:05:24.67,zh,,0,0,0,,僅此而已
Dialogue: 0,0:05:24.67,0:05:27.43,jp,,0,0,0,,必要以上の秘密なんていらな
Dialogue: 1,0:05:24.67,0:05:27.43,zh,,0,0,0,,其餘的什麼秘密我也不需要知道
Dialogue: 0,0:05:35.40,0:05:36.96,jp,,0,0,0,,確認してみるか
Dialogue: 1,0:05:35.40,0:05:36.96,zh,,0,0,0,,要不你試試看?
Dialogue: 0,0:05:46.38,0:05:48.30,jp,,0,0,0,,挑発が過ぎた
Dialogue: 1,0:05:46.38,0:05:48.30,zh,,0,0,0,,我說得太過了
Dialogue: 0,0:05:53.07,0:05:54.50,jp,,0,0,0,,どっどうする
Dialogue: 1,0:05:53.07,0:05:54.50,zh,,0,0,0,,怎...怎麼辦
Dialogue: 0,0:05:54.50,0:05:56.78,jp,,0,0,0,,蹴りを入れるべきか
Dialogue: 1,0:05:54.50,0:05:56.78,zh,,0,0,0,,我應該踢他嗎
Dialogue: 0,0:06:12.34,0:06:13.69,jp,,0,0,0,,なんだ
Dialogue: 1,0:06:12.34,0:06:13.69,zh,,0,0,0,,什麼
Dialogue: 0,0:06:23.65,0:06:25.06,jp,,0,0,0,,よくやった
Dialogue: 1,0:06:23.65,0:06:25.06,zh,,0,0,0,,幹得好
Dialogue: 0,0:06:26.14,0:06:27.40,jp,,0,0,0,,どうしたんだ
Dialogue: 1,0:06:26.14,0:06:27.40,zh,,0,0,0,,怎麼了
Dialogue: 0,0:06:27.40,0:06:29.60,jp,,0,0,0,,いきなり走りやがってよ
Dialogue: 1,0:06:27.40,0:06:29.60,zh,,0,0,0,,怎麼突然跑走了
Dialogue: 0,0:06:29.60,0:06:30.37,jp,,0,0,0,,この声
Dialogue: 1,0:06:29.60,0:06:30.37,zh,,0,0,0,,這個聲音
Dialogue: 0,0:06:32.86,0:06:35.96,jp,,0,0,0,,李白様　引き上げていただけませんか
Dialogue: 1,0:06:32.86,0:06:35.96,zh,,0,0,0,,李白大人 可以把我們拉上去嗎
Dialogue: 0,0:06:36.70,0:06:37.58,jp,,0,0,0,,嬢ちゃん?
Dialogue: 1,0:06:36.70,0:06:37.58,zh,,0,0,0,,小姑娘?
Dialogue: 0,0:06:38.12,0:06:40.93,jp,,0,0,0,,どうしたんだ　そんな所で
Dialogue: 1,0:06:38.12,0:06:40.93,zh,,0,0,0,,怎麼啦 怎麼會在這個地方
Dialogue: 0,0:06:43.69,0:06:44.80,jp,,0,0,0,,なるほど
Dialogue: 1,0:06:43.69,0:06:44.80,zh,,0,0,0,,原來如此
Dialogue: 0,0:06:45.27,0:06:48.18,jp,,0,0,0,,飛発で狙われて　滝に飛び込まれたと
Dialogue: 1,0:06:45.27,0:06:48.18,zh,,0,0,0,,你們被槍械襲擊 跳下瀑布
Dialogue: 0,0:06:48.72,0:06:51.35,jp,,0,0,0,,撃った者の顔までは見えなかったが
Dialogue: 1,0:06:48.72,0:06:51.35,zh,,0,0,0,,我沒看到襲擊者
Dialogue: 0,0:06:52.60,0:06:54.21,jp,,0,0,0,,ご無事で何よりです
Dialogue: 1,0:06:52.60,0:06:54.21,zh,,0,0,0,,沒受傷就已經很好了
Dialogue: 0,0:06:55.19,0:06:58.52,jp,,0,0,0,,で　なんで嬢ちゃんが　この方といるんだよ?
Dialogue: 1,0:06:55.19,0:06:58.52,zh,,0,0,0,,所以 你怎麼會跟這位大人在一起
Dialogue: 0,0:06:58.52,0:07:00.98,jp,,0,0,0,,説明しづらいとしか
Dialogue: 1,0:06:58.52,0:07:00.98,zh,,0,0,0,,一句話解釋不清
Dialogue: 0,0:07:02.34,0:07:03.95,jp,,0,0,0,,まあいいけどよ
Dialogue: 1,0:07:02.34,0:07:03.95,zh,,0,0,0,,算了
Dialogue: 0,0:07:04.59,0:07:05.99,jp,,0,0,0,,このたびの狩り
Dialogue: 1,0:07:04.59,0:07:05.99,zh,,0,0,0,,這次狩獵
Dialogue: 0,0:07:05.99,0:07:08.32,jp,,0,0,0,,飛発を持ってきている者は
Dialogue: 1,0:07:05.99,0:07:08.32,zh,,0,0,0,,有人帶槍械來嗎
Dialogue: 0,0:07:08.32,0:07:09.24,jp,,0,0,0,,いえ
Dialogue: 1,0:07:08.32,0:07:09.24,zh,,0,0,0,,沒有
Dialogue: 0,0:07:09.80,0:07:12.03,jp,,0,0,0,,森の狩りには不向きですので
Dialogue: 1,0:07:09.80,0:07:12.03,zh,,0,0,0,,森林狩獵不適合槍械
Dialogue: 0,0:07:12.03,0:07:14.01,jp,,0,0,0,,暗殺のために隠し持ってきたと
Dialogue: 1,0:07:12.03,0:07:14.01,zh,,0,0,0,,我更傾向於有人想要刺殺大人
Dialogue: 0,0:07:14.01,0:07:15.84,jp,,0,0,0,,考えるのが妥当でしょう
Dialogue: 1,0:07:14.01,0:07:15.84,zh,,0,0,0,,偷偷帶了進來
Dialogue: 0,0:07:16.67,0:07:18.22,jp,,0,0,0,,荷をあらためるか
Dialogue: 1,0:07:16.67,0:07:18.22,zh,,0,0,0,,要檢查大家的物品嗎
Dialogue: 0,0:07:18.77,0:07:19.91,jp,,0,0,0,,しかし
Dialogue: 1,0:07:18.77,0:07:19.91,zh,,0,0,0,,但是
Dialogue: 0,0:07:19.91,0:07:23.56,jp,,0,0,0,,客は子昌様に招待された　高官ばかりです
Dialogue: 1,0:07:19.91,0:07:23.56,zh,,0,0,0,,客人全都是子昌大人邀請的高官
Dialogue: 0,0:07:23.56,0:07:27.46,jp,,0,0,0,,暗殺の道具を手元に置くようなまねはしないかと
Dialogue: 1,0:07:23.56,0:07:27.46,zh,,0,0,0,,不會把刺殺的工具放在身邊
Dialogue: 0,0:07:29.28,0:07:31.60,jp,,0,0,0,,李白様　その犬は
Dialogue: 1,0:07:29.28,0:07:31.60,zh,,0,0,0,,李白大人 這隻小狗
Dialogue: 0,0:07:31.60,0:07:32.83,jp,,0,0,0,,笛で呼ぶ以外に
Dialogue: 1,0:07:31.60,0:07:32.83,zh,,0,0,0,,除了會聽哨聲之外
Dialogue: 0,0:07:32.83,0:07:34.82,jp,,0,0,0,,何かしつけをしていますか
Dialogue: 1,0:07:32.83,0:07:34.82,zh,,0,0,0,,還會什麼嗎
Dialogue: 0,0:07:36.71,0:07:40.56,jp,,0,0,0,,うさぎの穴を探すくらいはできるみたいだが
Dialogue: 1,0:07:36.71,0:07:40.56,zh,,0,0,0,,好像還會找兔子洞
Dialogue: 0,0:07:40.56,0:07:42.56,jp,,0,0,0,,愛嬌はあるが
Dialogue: 1,0:07:40.56,0:07:42.56,zh,,0,0,0,,這狗狗倒是討喜
Dialogue: 0,0:07:43.12,0:07:44.94,jp,,0,0,0,,ジッ　香泉様
Dialogue: 1,0:07:43.12,0:07:44.94,zh,,0,0,0,,壬...香泉大人
Dialogue: 0,0:07:45.26,0:07:46.45,jp,,0,0,0,,なんだ
Dialogue: 1,0:07:45.26,0:07:46.45,zh,,0,0,0,,幹什麼
Dialogue: 0,0:07:46.76,0:07:48.53,jp,,0,0,0,,怒ってる
Dialogue: 1,0:07:46.76,0:07:48.53,zh,,0,0,0,,他好像在生氣
Dialogue: 0,0:07:48.53,0:07:50.38,jp,,0,0,0,,まあ　当然か
Dialogue: 1,0:07:48.53,0:07:50.38,zh,,0,0,0,,好吧 他也該生氣
Dialogue: 0,0:07:50.38,0:07:52.00,jp,,0,0,0,,あんな行動に出られて
Dialogue: 1,0:07:50.38,0:07:52.00,zh,,0,0,0,,發生了那樣的事
Dialogue: 0,0:07:52.00,0:07:53.88,jp,,0,0,0,,ついあおってしまったが
Dialogue: 1,0:07:52.00,0:07:53.88,zh,,0,0,0,,我還火上澆油
Dialogue: 0,0:07:53.88,0:07:56.58,jp,,0,0,0,,壬氏様は何かを伝えようとしていた
Dialogue: 1,0:07:53.88,0:07:56.58,zh,,0,0,0,,壬氏大人原本要跟我說些什麼
Dialogue: 0,0:07:57.23,0:07:59.21,jp,,0,0,0,,なのに　知りたくないからと
Dialogue: 1,0:07:57.23,0:07:59.21,zh,,0,0,0,,但是我不想聽
Dialogue: 0,0:07:59.21,0:08:01.34,jp,,0,0,0,,めちゃくちゃな言い逃れをした
Dialogue: 1,0:07:59.21,0:08:01.34,zh,,0,0,0,,還亂說一通
Dialogue: 0,0:08:01.92,0:08:05.59,jp,,0,0,0,,ご自分の姿に大層な自信を持つお方だ
Dialogue: 1,0:08:01.92,0:08:05.59,zh,,0,0,0,,壬氏大人本就對自己的外貌十分自信
Dialogue: 0,0:08:06.07,0:08:08.42,jp,,0,0,0,,かえるもさぞやご立派であろうに
Dialogue: 1,0:08:06.07,0:08:08.42,zh,,0,0,0,,那裡也確實很雄偉
Dialogue: 0,0:08:08.42,0:08:10.30,jp,,0,0,0,,そこそこなどと
Dialogue: 1,0:08:08.42,0:08:10.30,zh,,0,0,0,,我竟然說不大
Dialogue: 0,0:08:11.87,0:08:13.35,jp,,0,0,0,,気まずいが
Dialogue: 1,0:08:11.87,0:08:13.35,zh,,0,0,0,,真尷尬啊
Dialogue: 0,0:08:13.35,0:08:15.26,jp,,0,0,0,,言うべきことは言わねば
Dialogue: 1,0:08:13.35,0:08:15.26,zh,,0,0,0,,但該說的還得說
Dialogue: 0,0:08:16.27,0:08:17.62,jp,,0,0,0,,もしかしたら
Dialogue: 1,0:08:16.27,0:08:17.62,zh,,0,0,0,,或許
Dialogue: 0,0:08:17.62,0:08:21.61,jp,,0,0,0,,先ほど発砲した人物を特定できるかもしれません
Dialogue: 1,0:08:17.62,0:08:21.61,zh,,0,0,0,,我們可以找到剛才開槍的人
Dialogue: 0,0:08:28.46,0:08:29.38,jp,,0,0,0,,失礼します
Dialogue: 1,0:08:28.46,0:08:29.38,zh,,0,0,0,,失禮了
Dialogue: 0,0:08:30.08,0:08:30.95,jp,,0,0,0,,なんだ
Dialogue: 1,0:08:30.08,0:08:30.95,zh,,0,0,0,,說吧
Dialogue: 0,0:08:31.66,0:08:32.47,jp,,0,0,0,,こちらを
Dialogue: 1,0:08:31.66,0:08:32.47,zh,,0,0,0,,我們找到了這個
Dialogue: 0,0:08:38.86,0:08:39.58,jp,,0,0,0,,それは
Dialogue: 1,0:08:38.86,0:08:39.58,zh,,0,0,0,,那是什麼
Dialogue: 0,0:08:41.57,0:08:43.09,jp,,0,0,0,,あるじの衣です
Dialogue: 1,0:08:41.57,0:08:43.09,zh,,0,0,0,,是我家大人的衣服
Dialogue: 0,0:08:45.56,0:08:48.26,jp,,0,0,0,,川の岩場に引っ掛かっているのを発見しました
Dialogue: 1,0:08:45.56,0:08:48.26,zh,,0,0,0,,是在河邊石縫裡發現的
Dialogue: 0,0:08:48.91,0:08:52.14,jp,,0,0,0,,近くには誰もおらず　その先は急流
Dialogue: 1,0:08:48.91,0:08:52.14,zh,,0,0,0,,附近沒有人 而且前面就是急流
Dialogue: 0,0:08:52.14,0:08:54.72,jp,,0,0,0,,昨夜の雨で増水もしています
Dialogue: 1,0:08:52.14,0:08:54.72,zh,,0,0,0,,昨晚下雨 河水也上漲了
Dialogue: 0,0:08:54.72,0:08:55.31,jp,,0,0,0,,もし
Dialogue: 1,0:08:54.72,0:08:55.31,zh,,0,0,0,,有可能
Dialogue: 0,0:08:55.31,0:08:57.08,jp,,0,0,0,,流されていたら
Dialogue: 1,0:08:55.31,0:08:57.08,zh,,0,0,0,,被河水沖走了
Dialogue: 0,0:08:57.08,0:08:59.06,jp,,0,0,0,,はっ　早く捜索しろ
Dialogue: 1,0:08:57.08,0:08:59.06,zh,,0,0,0,,快去找
Dialogue: 0,0:08:59.06,0:08:59.73,jp,,0,0,0,,はっ
Dialogue: 1,0:08:59.06,0:08:59.73,zh,,0,0,0,,遵命
Dialogue: 0,0:08:59.73,0:09:00.88,jp,,0,0,0,,急げ
Dialogue: 1,0:08:59.73,0:09:00.88,zh,,0,0,0,,動作快點
Dialogue: 0,0:09:01.62,0:09:04.37,jp,,0,0,0,,今更慌てたところで遅い
Dialogue: 1,0:09:01.62,0:09:04.37,zh,,0,0,0,,現在才著急是不是有點晚了
Dialogue: 0,0:09:05.40,0:09:08.82,jp,,0,0,0,,では　私も捜索に加わってまいります
Dialogue: 1,0:09:05.40,0:09:08.82,zh,,0,0,0,,那我也加入搜查
Dialogue: 0,0:09:17.87,0:09:19.71,jp,,0,0,0,,どういうおつもりです
Dialogue: 1,0:09:17.87,0:09:19.71,zh,,0,0,0,,你到底想做什麼
Dialogue: 0,0:09:19.71,0:09:20.78,jp,,0,0,0,,壬氏様
Dialogue: 1,0:09:19.71,0:09:20.78,zh,,0,0,0,,壬氏大人
Dialogue: 0,0:09:29.72,0:09:31.66,jp,,0,0,0,,なっなんだ
Dialogue: 1,0:09:29.72,0:09:31.66,zh,,0,0,0,,怎麼回事
Dialogue: 0,0:09:33.00,0:09:34.60,jp,,0,0,0,,申し訳ありません
Dialogue: 1,0:09:33.00,0:09:34.60,zh,,0,0,0,,真的很抱歉
Dialogue: 0,0:09:35.37,0:09:37.49,jp,,0,0,0,,しつけのなってない犬だ
Dialogue: 1,0:09:35.37,0:09:37.49,zh,,0,0,0,,真是沒教養的狗
Dialogue: 0,0:09:39.89,0:09:41.52,jp,,0,0,0,,よしよし
Dialogue: 1,0:09:39.89,0:09:41.52,zh,,0,0,0,,好狗好狗
Dialogue: 0,0:09:52.01,0:09:52.80,jp,,0,0,0,,どうした
Dialogue: 1,0:09:52.01,0:09:52.80,zh,,0,0,0,,怎麼了
Dialogue: 0,0:09:53.49,0:09:54.58,jp,,0,0,0,,馬閃様
Dialogue: 1,0:09:53.49,0:09:54.58,zh,,0,0,0,,馬閃大人
Dialogue: 0,0:09:54.58,0:09:55.41,jp,,0,0,0,,それが
Dialogue: 1,0:09:54.58,0:09:55.41,zh,,0,0,0,,這個...
Dialogue: 0,0:09:58.81,0:10:00.39,jp,,0,0,0,,これは血か
Dialogue: 1,0:09:58.81,0:10:00.39,zh,,0,0,0,,是大人的衣服
Dialogue: 0,0:10:00.39,0:10:01.41,jp,,0,0,0,,これは血か
Dialogue: 1,0:10:00.39,0:10:01.41,zh,,0,0,0,,這是血嗎
Dialogue: 0,0:10:02.14,0:10:03.08,jp,,0,0,0,,辺りに人は
Dialogue: 1,0:10:02.14,0:10:03.08,zh,,0,0,0,,附近有人嗎
Dialogue: 0,0:10:03.49,0:10:05.42,jp,,0,0,0,,河原がぬれていないので
Dialogue: 1,0:10:03.49,0:10:05.42,zh,,0,0,0,,岸上是乾的
Dialogue: 0,0:10:05.42,0:10:07.60,jp,,0,0,0,,周辺にはおられないかと
Dialogue: 1,0:10:05.42,0:10:07.60,zh,,0,0,0,,所以我想不在附近
Dialogue: 0,0:10:08.13,0:10:09.01,jp,,0,0,0,,そうか
Dialogue: 1,0:10:08.13,0:10:09.01,zh,,0,0,0,,好吧
Dialogue: 0,0:10:09.53,0:10:12.59,jp,,0,0,0,,ですが　こちらも衣と一緒に
Dialogue: 1,0:10:09.53,0:10:12.59,zh,,0,0,0,,不過 還找到了這個
Dialogue: 0,0:10:12.59,0:10:14.42,jp,,0,0,0,,たかの羽根
Dialogue: 1,0:10:12.59,0:10:14.42,zh,,0,0,0,,老鷹的羽毛
Dialogue: 0,0:10:14.42,0:10:17.67,jp,,0,0,0,,たか狩りの験担ぎに　こしらえた物でしょうか
Dialogue: 1,0:10:14.42,0:10:17.67,zh,,0,0,0,,是為了獵鷹討彩頭準備的嗎
Dialogue: 0,0:10:18.64,0:10:20.18,jp,,0,0,0,,ああ
Dialogue: 1,0:10:18.64,0:10:20.18,zh,,0,0,0,,或許吧
Dialogue: 0,0:10:20.61,0:10:21.94,jp,,0,0,0,,申し訳ないが
Dialogue: 1,0:10:20.61,0:10:21.94,zh,,0,0,0,,不好意思
Dialogue: 0,0:10:21.94,0:10:24.43,jp,,0,0,0,,皆の荷を確かめさせてもらえないか
Dialogue: 1,0:10:21.94,0:10:24.43,zh,,0,0,0,,可以檢查一下大家的隨身物品嗎
Dialogue: 0,0:10:27.27,0:10:28.98,jp,,0,0,0,,見つけました
Dialogue: 1,0:10:27.27,0:10:28.98,zh,,0,0,0,,找到了
Dialogue: 0,0:10:31.08,0:10:33.70,jp,,0,0,0,,川辺で発見した物と同じ矢です
Dialogue: 1,0:10:31.08,0:10:33.70,zh,,0,0,0,,跟河邊找到的箭一樣
Dialogue: 0,0:10:33.70,0:10:36.82,jp,,0,0,0,,しっ　知らない　何かの間違いだ
Dialogue: 1,0:10:33.70,0:10:36.82,zh,,0,0,0,,我...我不知道 一定有什麼誤會
Dialogue: 0,0:10:36.82,0:10:39.36,jp,,0,0,0,,ではなぜあなたの矢が
Dialogue: 1,0:10:36.82,0:10:39.36,zh,,0,0,0,,那為什麼你的箭
Dialogue: 0,0:10:39.36,0:10:40.85,jp,,0,0,0,,あるじの衣と共に
Dialogue: 1,0:10:39.36,0:10:40.85,zh,,0,0,0,,會跟我家大人的衣服
Dialogue: 0,0:10:40.85,0:10:43.29,jp,,0,0,0,,川辺にあったのですか　魯袁殿
Dialogue: 1,0:10:40.85,0:10:43.29,zh,,0,0,0,,一起出現在河邊呢 魯袁大人
Dialogue: 0,0:10:43.29,0:10:46.96,jp,,0,0,0,,だっ誰かが　私の矢と入れ替えたんだ
Dialogue: 1,0:10:43.29,0:10:46.96,zh,,0,0,0,,肯定有人換了我的箭
Dialogue: 0,0:10:46.96,0:10:48.84,jp,,0,0,0,,私を陥れるために
Dialogue: 1,0:10:46.96,0:10:48.84,zh,,0,0,0,,有人想陷害我
Dialogue: 0,0:10:48.84,0:10:49.86,jp,,0,0,0,,どういうことだ
Dialogue: 1,0:10:48.84,0:10:49.86,zh,,0,0,0,,發生了什麼 難道
Dialogue: 0,0:10:49.86,0:10:51.80,jp,,0,0,0,,私は知らん知らんぞ
Dialogue: 1,0:10:49.86,0:10:51.80,zh,,0,0,0,,我不知道
Dialogue: 0,0:10:50.21,0:10:51.80,jp,,0,0,0,,{\an8}まさか
Dialogue: 1,0:10:50.21,0:10:51.80,zh,,0,0,0,,{\an8}難道
Dialogue: 0,0:10:52.22,0:10:55.05,jp,,0,0,0,,魯袁の動揺は本物に見える
Dialogue: 1,0:10:52.22,0:10:55.05,zh,,0,0,0,,魯袁大人看起來不像是裝的
Dialogue: 0,0:10:55.05,0:10:58.05,jp,,0,0,0,,部下たちの様子にも　違和感はない
Dialogue: 1,0:10:55.05,0:10:58.05,zh,,0,0,0,,他的部下也不可疑
Dialogue: 0,0:10:58.72,0:11:01.64,jp,,0,0,0,,では　他に落ちている矢がないかを
Dialogue: 1,0:10:58.72,0:11:01.64,zh,,0,0,0,,那要不我們去看看
Dialogue: 0,0:11:01.64,0:11:04.13,jp,,0,0,0,,調べてみてはいかがでしょう
Dialogue: 1,0:11:01.64,0:11:04.13,zh,,0,0,0,,其他地方還有沒有掉落的箭
Dialogue: 0,0:11:04.13,0:11:05.35,jp,,0,0,0,,川辺以外の
Dialogue: 1,0:11:04.13,0:11:05.35,zh,,0,0,0,,去河邊以外的
Dialogue: 0,0:11:05.87,0:11:08.23,jp,,0,0,0,,森の中も　しっかりと
Dialogue: 1,0:11:05.87,0:11:08.23,zh,,0,0,0,,森林裡也好好檢查一遍
Dialogue: 0,0:11:10.44,0:11:11.71,jp,,0,0,0,,わかった
Dialogue: 1,0:11:10.44,0:11:11.71,zh,,0,0,0,,明白了
Dialogue: 0,0:11:11.71,0:11:14.26,jp,,0,0,0,,しっかりと　森の中を捜せ
Dialogue: 1,0:11:11.71,0:11:14.26,zh,,0,0,0,,森林裡面也給我好好搜查
Dialogue: 0,0:11:14.26,0:11:15.27,jp,,0,0,0,,はっ
Dialogue: 1,0:11:14.26,0:11:15.27,zh,,0,0,0,,明白
Dialogue: 0,0:11:24.54,0:11:26.93,jp,,0,0,0,,うまく　食いついてくれるといいが
Dialogue: 1,0:11:24.54,0:11:26.93,zh,,0,0,0,,希望他們能上鈎
Dialogue: 0,0:11:34.08,0:11:36.01,jp,,0,0,0,,くそ　どういうことだ
Dialogue: 1,0:11:34.08,0:11:36.01,zh,,0,0,0,,可惡 到底怎麼回事
Dialogue: 0,0:11:36.01,0:11:37.93,jp,,0,0,0,,矢なんて知らんぞ
Dialogue: 1,0:11:36.01,0:11:37.93,zh,,0,0,0,,怎麼會出現箭
Dialogue: 0,0:11:40.09,0:11:42.38,jp,,0,0,0,,そこに何かあるのでしょうか
Dialogue: 1,0:11:40.09,0:11:42.38,zh,,0,0,0,,那裡藏著什麼
Dialogue: 0,0:11:45.49,0:11:46.52,jp,,0,0,0,,それは
Dialogue: 1,0:11:45.49,0:11:46.52,zh,,0,0,0,,那是
Dialogue: 0,0:11:51.38,0:11:52.69,jp,,0,0,0,,返せ
Dialogue: 1,0:11:51.38,0:11:52.69,zh,,0,0,0,,還給我
Dialogue: 0,0:11:57.71,0:11:59.28,jp,,0,0,0,,貴様　さっきの
Dialogue: 1,0:11:57.71,0:11:59.28,zh,,0,0,0,,你是剛才那個
Dialogue: 0,0:12:02.08,0:12:04.83,jp,,0,0,0,,ずいぶん犬に嫌われているようですね
Dialogue: 1,0:12:02.08,0:12:04.83,zh,,0,0,0,,看來狗狗非常討厭你啊
Dialogue: 0,0:12:16.90,0:12:18.23,jp,,0,0,0,,この臭い
Dialogue: 1,0:12:16.90,0:12:18.23,zh,,0,0,0,,這股味道
Dialogue: 0,0:12:18.23,0:12:21.85,jp,,0,0,0,,鼻のいい犬ならすぐ反応します
Dialogue: 1,0:12:18.23,0:12:21.85,zh,,0,0,0,,以狗靈敏的嗅覺 會立馬被察覺
Dialogue: 0,0:12:23.33,0:12:25.76,jp,,0,0,0,,狩りに犬を連れていかなかったのは
Dialogue: 1,0:12:23.33,0:12:25.76,zh,,0,0,0,,你之所以沒有帶著狗參加狩獵
Dialogue: 0,0:12:26.40,0:12:27.70,jp,,0,0,0,,このためですね
Dialogue: 1,0:12:26.40,0:12:27.70,zh,,0,0,0,,就是這個原因吧
Dialogue: 0,0:12:29.89,0:12:31.69,jp,,0,0,0,,中身は押収済みです
Dialogue: 1,0:12:29.89,0:12:31.69,zh,,0,0,0,,裡面的東西已經沒收了
Dialogue: 0,0:12:32.16,0:12:34.46,jp,,0,0,0,,飛発が３丁入っていました
Dialogue: 1,0:12:32.16,0:12:34.46,zh,,0,0,0,,有三把火銃
Dialogue: 0,0:12:34.97,0:12:36.20,jp,,0,0,0,,異国の物だ
Dialogue: 1,0:12:34.97,0:12:36.20,zh,,0,0,0,,是外國的東西
Dialogue: 0,0:12:36.70,0:12:39.24,jp,,0,0,0,,恐らく　西方の最新型だろう
Dialogue: 1,0:12:36.70,0:12:39.24,zh,,0,0,0,,若我沒猜錯 這是西方的最新型號
Dialogue: 0,0:12:40.59,0:12:42.53,jp,,0,0,0,,まだ煙の臭いがする
Dialogue: 1,0:12:40.59,0:12:42.53,zh,,0,0,0,,還能聞到火藥味
Dialogue: 0,0:12:42.53,0:12:44.91,jp,,0,0,0,,ずいぶん小型ですね
Dialogue: 1,0:12:42.53,0:12:44.91,zh,,0,0,0,,好小型的火銃啊
Dialogue: 0,0:12:44.91,0:12:47.29,jp,,0,0,0,,私もこの型は初めて見た
Dialogue: 1,0:12:44.91,0:12:47.29,zh,,0,0,0,,我也沒見過這種形制的
Dialogue: 0,0:12:51.28,0:12:54.88,jp,,0,0,0,,なるほど　金属の部分で火花を起こすのか
Dialogue: 1,0:12:51.28,0:12:54.88,zh,,0,0,0,,原來如此 它是通過金屬部件摩擦產生火花的
Dialogue: 0,0:12:54.88,0:12:59.63,jp,,0,0,0,,炭と硝石と硫黄を混ぜて作った　火薬が爆発すると
Dialogue: 1,0:12:54.88,0:12:59.63,zh,,0,0,0,,炭 硝石 硫黃混合製成的火藥爆炸時
Dialogue: 0,0:12:59.63,0:13:03.19,jp,,0,0,0,,思わず鼻を押さえたくなるような臭いを発します
Dialogue: 1,0:12:59.63,0:13:03.19,zh,,0,0,0,,會散發出一種難聞的味道
Dialogue: 0,0:13:03.66,0:13:05.88,jp,,0,0,0,,まるで卵が腐ったような
Dialogue: 1,0:13:03.66,0:13:05.88,zh,,0,0,0,,就像腐爛的臭雞蛋
Dialogue: 0,0:13:07.28,0:13:08.02,jp,,0,0,0,,そう
Dialogue: 1,0:13:07.28,0:13:08.02,zh,,0,0,0,,沒錯
Dialogue: 0,0:13:08.50,0:13:11.25,jp,,0,0,0,,崖の上で撃たれたときと同じ臭いです
Dialogue: 1,0:13:08.50,0:13:11.25,zh,,0,0,0,,和我們在懸崖上遇襲時聞到的味道一致
Dialogue: 0,0:13:11.85,0:13:14.38,jp,,0,0,0,,猟犬に火薬の臭いを嗅がせたら
Dialogue: 1,0:13:11.85,0:13:14.38,zh,,0,0,0,,我讓獵犬聞了火藥的味道
Dialogue: 0,0:13:14.38,0:13:17.69,jp,,0,0,0,,すぐにこの飛発を捜し当ててくれました
Dialogue: 1,0:13:14.38,0:13:17.69,zh,,0,0,0,,它很快就找到了這些火銃
Dialogue: 0,0:13:17.69,0:13:22.45,jp,,0,0,0,,それを撃った人間に付いた火薬の臭いも嗅ぎ当てるのですから
Dialogue: 1,0:13:17.69,0:13:22.45,zh,,0,0,0,,當然也能聞出開槍者身上附著的火藥味
Dialogue: 0,0:13:22.45,0:13:23.95,jp,,0,0,0,,賢い犬です
Dialogue: 1,0:13:22.45,0:13:23.95,zh,,0,0,0,,它很聰明
Dialogue: 0,0:13:25.28,0:13:27.58,jp,,0,0,0,,お前は偉いな
Dialogue: 1,0:13:25.28,0:13:27.58,zh,,0,0,0,,你真厲害啊
Dialogue: 0,0:13:28.03,0:13:30.07,jp,,0,0,0,,鎌をかけるためとはいえ
Dialogue: 1,0:13:28.03,0:13:30.07,zh,,0,0,0,,這是一招引蛇出洞的計策
Dialogue: 0,0:13:30.07,0:13:33.08,jp,,0,0,0,,だしに使われたおっさんたちには悪いことしたな
Dialogue: 1,0:13:30.07,0:13:33.08,zh,,0,0,0,,就是有點對不住那些被當成誘餌的老頭們了
Dialogue: 0,0:13:34.86,0:13:36.42,jp,,0,0,0,,香泉様
Dialogue: 1,0:13:34.86,0:13:36.42,zh,,0,0,0,,香泉大人
Dialogue: 0,0:13:36.85,0:13:37.89,jp,,0,0,0,,馬閃
Dialogue: 1,0:13:36.85,0:13:37.89,zh,,0,0,0,,馬閃
Dialogue: 0,0:13:37.89,0:13:39.27,jp,,0,0,0,,先ほどの銃声は
Dialogue: 1,0:13:37.89,0:13:39.27,zh,,0,0,0,,剛才的槍聲是怎麼回事
Dialogue: 0,0:13:39.27,0:13:40.05,jp,,0,0,0,,おけがは
Dialogue: 1,0:13:39.27,0:13:40.05,zh,,0,0,0,,您沒受傷吧
Dialogue: 0,0:13:40.56,0:13:42.97,jp,,0,0,0,,姿を消したかと思えば突然
Dialogue: 1,0:13:40.56,0:13:42.97,zh,,0,0,0,,我還在想您去哪了
Dialogue: 0,0:13:42.97,0:13:44.91,jp,,0,0,0,,衣の切れ端を見せられて
Dialogue: 1,0:13:42.97,0:13:44.91,zh,,0,0,0,,結果他突然拿來那片衣角
Dialogue: 0,0:13:44.91,0:13:47.10,jp,,0,0,0,,「この男に合わせろ」などと
Dialogue: 1,0:13:44.91,0:13:47.10,zh,,0,0,0,,還要我配合他行動
Dialogue: 0,0:13:47.10,0:13:49.31,jp,,0,0,0,,私は一体どうしたことかと
Dialogue: 1,0:13:47.10,0:13:49.31,zh,,0,0,0,,我簡直是一頭霧水
Dialogue: 0,0:13:49.31,0:13:50.40,jp,,0,0,0,,すまない
Dialogue: 1,0:13:49.31,0:13:50.40,zh,,0,0,0,,抱歉了
Dialogue: 0,0:13:50.74,0:13:51.70,jp,,0,0,0,,状況は
Dialogue: 1,0:13:50.74,0:13:51.70,zh,,0,0,0,,外面情況如何?
Dialogue: 0,0:13:55.48,0:13:57.52,jp,,0,0,0,,この者の関係者たちは
Dialogue: 1,0:13:55.48,0:13:57.52,zh,,0,0,0,,與此人有牽連者
Dialogue: 0,0:13:57.52,0:14:00.08,jp,,0,0,0,,いつでも捕縛できるよう　見張っております
Dialogue: 1,0:13:57.52,0:14:00.08,zh,,0,0,0,,都在我們監視下 隨時可以逮捕
Dialogue: 0,0:14:00.59,0:14:04.20,jp,,0,0,0,,では　あとは罪状を明確にするだけだな
Dialogue: 1,0:14:00.59,0:14:04.20,zh,,0,0,0,,那麼 接下來只需明確罪名了
Dialogue: 0,0:14:04.20,0:14:04.99,jp,,0,0,0,,はっ
Dialogue: 1,0:14:04.20,0:14:04.99,zh,,0,0,0,,是
Dialogue: 0,0:14:19.94,0:14:20.80,jp,,0,0,0,,その後
Dialogue: 1,0:14:19.94,0:14:20.80,zh,,0,0,0,,在這之後
Dialogue: 0,0:14:21.18,0:14:23.66,jp,,0,0,0,,覆面の主賓は山荘に戻り
Dialogue: 1,0:14:21.18,0:14:23.66,zh,,0,0,0,,蒙面的上賓回到了山莊
Dialogue: 0,0:14:24.17,0:14:26.60,jp,,0,0,0,,狩りのうたげは散会となった
Dialogue: 1,0:14:24.17,0:14:26.60,zh,,0,0,0,,狩獵宴也結束了
Dialogue: 0,0:14:36.22,0:14:38.11,jp,,0,0,0,,昼の失踪事件は
Dialogue: 1,0:14:36.22,0:14:38.11,zh,,0,0,0,,白天的失蹤事件
Dialogue: 0,0:14:38.68,0:14:43.01,jp,,0,0,0,,表向きは覆面のお方の気まぐれということで処理された
Dialogue: 1,0:14:38.68,0:14:43.01,zh,,0,0,0,,對外只宣稱是蒙面上賓的隨性出遊 草草了結了
Dialogue: 0,0:14:43.74,0:14:45.34,jp,,0,0,0,,そのうたげで
Dialogue: 1,0:14:43.74,0:14:45.34,zh,,0,0,0,,而在這場宴會上
Dialogue: 0,0:14:45.34,0:14:49.04,jp,,0,0,0,,とある官の一派が消えたことは周知の事実だ
Dialogue: 1,0:14:45.34,0:14:49.04,zh,,0,0,0,,有一派官員悄然消失一事已經成為公開的秘密
Dialogue: 0,0:14:49.71,0:14:51.56,jp,,0,0,0,,今後あの者たちが
Dialogue: 1,0:14:49.71,0:14:51.56,zh,,0,0,0,,從今往後那些人
Dialogue: 0,0:14:51.56,0:14:53.83,jp,,0,0,0,,表舞台に出ることはあるまい
Dialogue: 1,0:14:51.56,0:14:53.83,zh,,0,0,0,,不會再大搖大擺地出現了
Dialogue: 0,0:14:55.73,0:14:59.09,jp,,0,0,0,,何があったのか　お疲れのご様子だった
Dialogue: 1,0:14:55.73,0:14:59.09,zh,,0,0,0,,不知發生了什麼 他看起來很疲憊
Dialogue: 0,0:14:59.80,0:15:03.11,jp,,0,0,0,,だが壬氏様の代理としてここにいる自分は
Dialogue: 1,0:14:59.80,0:15:03.11,zh,,0,0,0,,但我作為壬氏大人的代表出席
Dialogue: 0,0:15:03.74,0:15:06.21,jp,,0,0,0,,それを気にする立場にない
Dialogue: 1,0:15:03.74,0:15:06.21,zh,,0,0,0,,沒有立場摻和這件事
Dialogue: 0,0:15:10.47,0:15:12.10,jp,,0,0,0,,まだまだだな
Dialogue: 1,0:15:10.47,0:15:12.10,zh,,0,0,0,,路還很長啊
Dialogue: 0,0:15:12.54,0:15:13.91,jp,,0,0,0,,宦官には
Dialogue: 1,0:15:12.54,0:15:13.91,zh,,0,0,0,,對宦官來說
Dialogue: 0,0:15:13.91,0:15:16.14,jp,,0,0,0,,つまらない趣向だったかな
Dialogue: 1,0:15:13.91,0:15:16.14,zh,,0,0,0,,這種場合會不會太無聊了啊
Dialogue: 0,0:15:16.14,0:15:19.17,jp,,0,0,0,,いえ　楽しませていただいております
Dialogue: 1,0:15:16.14,0:15:19.17,zh,,0,0,0,,哪裡 我很享受晚宴
Dialogue: 0,0:15:19.81,0:15:22.25,jp,,0,0,0,,しかし大変ですな
Dialogue: 1,0:15:19.81,0:15:22.25,zh,,0,0,0,,說起來也是世事無常啊
Dialogue: 0,0:15:22.25,0:15:24.44,jp,,0,0,0,,女帝の怒りを買ったばかりに
Dialogue: 1,0:15:22.25,0:15:24.44,zh,,0,0,0,,只因女帝一怒
Dialogue: 0,0:15:24.44,0:15:26.37,jp,,0,0,0,,宦官になど
Dialogue: 1,0:15:24.44,0:15:26.37,zh,,0,0,0,,結果就成了宦官
Dialogue: 0,0:15:26.37,0:15:28.25,jp,,0,0,0,,終わった話ですから
Dialogue: 1,0:15:26.37,0:15:28.25,zh,,0,0,0,,都是過去的事了
Dialogue: 0,0:15:28.72,0:15:29.59,jp,,0,0,0,,それに
Dialogue: 1,0:15:28.72,0:15:29.59,zh,,0,0,0,,話說
Dialogue: 0,0:15:30.17,0:15:31.87,jp,,0,0,0,,いい月見酒ですよ
Dialogue: 1,0:15:30.17,0:15:31.87,zh,,0,0,0,,這賞月酒真是不錯啊
Dialogue: 0,0:15:32.74,0:15:35.82,jp,,0,0,0,,宦官となり　馬の名を捨て
Dialogue: 1,0:15:32.74,0:15:35.82,zh,,0,0,0,,我成為宦官 捨棄了馬姓
Dialogue: 0,0:15:35.82,0:15:37.90,jp,,0,0,0,,高順と名を改めた
Dialogue: 1,0:15:35.82,0:15:37.90,zh,,0,0,0,,改名為高順
Dialogue: 0,0:15:38.63,0:15:40.70,jp,,0,0,0,,だがうたげの折には
Dialogue: 1,0:15:38.63,0:15:40.70,zh,,0,0,0,,但在宴會上
Dialogue: 0,0:15:40.70,0:15:43.33,jp,,0,0,0,,馬の家の者として扱われる
Dialogue: 1,0:15:40.70,0:15:43.33,zh,,0,0,0,,還依然被當作馬氏族人對待
Dialogue: 0,0:15:44.32,0:15:46.05,jp,,0,0,0,,そういうことになっている
Dialogue: 1,0:15:44.32,0:15:46.05,zh,,0,0,0,,這就是眼下的情況
Dialogue: 0,0:15:46.92,0:15:50.25,jp,,0,0,0,,それにしても　麗しの宦官殿が
Dialogue: 1,0:15:46.92,0:15:50.25,zh,,0,0,0,,說起來 那位一表人才的宦官大人
Dialogue: 0,0:15:50.25,0:15:54.46,jp,,0,0,0,,今回の狩りに参加されなかったのはちと残念だ
Dialogue: 1,0:15:50.25,0:15:54.46,zh,,0,0,0,,沒有參加這次狩獵 真是憾事一件啊
Dialogue: 0,0:15:54.46,0:15:57.77,jp,,0,0,0,,こたびは覆面のお方が来ていらっしゃいますから
Dialogue: 1,0:15:54.46,0:15:57.77,zh,,0,0,0,,畢竟此次那位蒙面的大人也在席
Dialogue: 0,0:15:57.77,0:16:01.25,jp,,0,0,0,,あれだけ美しいお顔が参加されたら
Dialogue: 1,0:15:57.77,0:16:01.25,zh,,0,0,0,,要是頂著那般出眾的面孔前來赴宴
Dialogue: 0,0:16:01.25,0:16:05.23,jp,,0,0,0,,それだけで　嫌みになってしまいますからな
Dialogue: 1,0:16:01.25,0:16:05.23,zh,,0,0,0,,恐怕會因此惹人嫌了
Dialogue: 0,0:16:05.81,0:16:07.39,jp,,0,0,0,,覆面のお方は
Dialogue: 1,0:16:05.81,0:16:07.39,zh,,0,0,0,,傳聞那位蒙面的上賓
Dialogue: 0,0:16:07.39,0:16:11.55,jp,,0,0,0,,ご尊顔にひどいやけどの痕があるとのうわさ
Dialogue: 1,0:16:07.39,0:16:11.55,zh,,0,0,0,,臉上有嚴重的燒傷疤痕
Dialogue: 0,0:16:11.55,0:16:15.18,jp,,0,0,0,,こよいも部屋に引きこもっていると聞きますし
Dialogue: 1,0:16:11.55,0:16:15.18,zh,,0,0,0,,聽說他今晚也待在房間裡沒出來
Dialogue: 0,0:16:15.18,0:16:17.41,jp,,0,0,0,,帝も心配でしょう
Dialogue: 1,0:16:15.18,0:16:17.41,zh,,0,0,0,,皇上想必也很擔心吧
Dialogue: 0,0:16:17.75,0:16:20.13,jp,,0,0,0,,あれが東宮とは
Dialogue: 1,0:16:17.75,0:16:20.13,zh,,0,0,0,,那小子可是儲君啊
Dialogue: 0,0:16:20.72,0:16:21.49,jp,,0,0,0,,ええ
Dialogue: 1,0:16:20.72,0:16:21.49,zh,,0,0,0,,嗯
Dialogue: 0,0:16:22.21,0:16:23.50,jp,,0,0,0,,「あれ」か
Dialogue: 1,0:16:22.21,0:16:23.50,zh,,0,0,0,,那小子?
Dialogue: 0,0:16:24.18,0:16:26.63,jp,,0,0,0,,東宮への敬いはどこにもない
Dialogue: 1,0:16:24.18,0:16:26.63,zh,,0,0,0,,對儲君真是毫無敬意
Dialogue: 0,0:16:27.70,0:16:29.59,jp,,0,0,0,,してどうなのです
Dialogue: 1,0:16:27.70,0:16:29.59,zh,,0,0,0,,我冒昧打聽一下啊
Dialogue: 0,0:16:30.15,0:16:32.74,jp,,0,0,0,,先の皇子様の薨御以来
Dialogue: 1,0:16:30.15,0:16:32.74,zh,,0,0,0,,自從上一位皇子殿下夭折以來
Dialogue: 0,0:16:32.74,0:16:35.09,jp,,0,0,0,,誰かみごもった妃などは
Dialogue: 1,0:16:32.74,0:16:35.09,zh,,0,0,0,,是否有哪位妃子再結珠胎呢
Dialogue: 0,0:16:35.55,0:16:37.98,jp,,0,0,0,,さあ　私はあいにく
Dialogue: 1,0:16:35.55,0:16:37.98,zh,,0,0,0,,我不太清楚
Dialogue: 0,0:16:39.16,0:16:41.60,jp,,0,0,0,,失礼　少し酔いました
Dialogue: 1,0:16:39.16,0:16:41.60,zh,,0,0,0,,不好意思 我有些不勝酒力
Dialogue: 0,0:16:47.23,0:16:49.60,jp,,0,0,0,,皆見定めようとしている
Dialogue: 1,0:16:47.23,0:16:49.60,zh,,0,0,0,,這幫人都在暗中觀察
Dialogue: 0,0:16:50.25,0:16:52.36,jp,,0,0,0,,こたびの狩りの主賓
Dialogue: 1,0:16:50.25,0:16:52.36,zh,,0,0,0,,此次狩獵宴的上賓
Dialogue: 0,0:16:52.36,0:16:55.34,jp,,0,0,0,,すなわち　帝の弟君が
Dialogue: 1,0:16:52.36,0:16:55.34,zh,,0,0,0,,也就是當今的皇弟
Dialogue: 0,0:16:55.83,0:16:59.59,jp,,0,0,0,,皇位を継ぐにふさわしい人物であるかどうか
Dialogue: 1,0:16:55.83,0:16:59.59,zh,,0,0,0,,究竟有沒有繼承皇位的本事
Dialogue: 0,0:17:03.24,0:17:04.87,jp,,0,0,0,,壬氏様は
Dialogue: 1,0:17:03.24,0:17:04.87,zh,,0,0,0,,不知道壬氏大人
Dialogue: 0,0:17:04.87,0:17:08.17,jp,,0,0,0,,小猫に真実を伝えられたのだろうか
Dialogue: 1,0:17:04.87,0:17:08.17,zh,,0,0,0,,有沒有告訴小貓真相
Dialogue: 0,0:17:09.95,0:17:12.98,jp,,0,0,0,,今後起こりうる問題に対処するためにも
Dialogue: 1,0:17:09.95,0:17:12.98,zh,,0,0,0,,為了應對今後可能出現的問題
Dialogue: 0,0:17:12.98,0:17:14.89,jp,,0,0,0,,知らせておく必要がある
Dialogue: 1,0:17:12.98,0:17:14.89,zh,,0,0,0,,有必要讓她知道一些事
Dialogue: 0,0:17:15.56,0:17:19.48,jp,,0,0,0,,それだけ　利用価値のある娘だ
Dialogue: 1,0:17:15.56,0:17:19.48,zh,,0,0,0,,她是個有利用價值的小姑娘
Dialogue: 0,0:17:20.62,0:17:22.19,jp,,0,0,0,,非情な言い方だが
Dialogue: 1,0:17:20.62,0:17:22.19,zh,,0,0,0,,雖然說來無情
Dialogue: 0,0:17:23.18,0:17:25.75,jp,,0,0,0,,使える手は多いほうがいい
Dialogue: 1,0:17:23.18,0:17:25.75,zh,,0,0,0,,但能用的棋子越多越好
Dialogue: 0,0:17:29.15,0:17:32.70,jp,,0,0,0,,今回もまた気持ちの悪い幕引きだ
Dialogue: 1,0:17:29.15,0:17:32.70,zh,,0,0,0,,又是這般令人不快的收場
Dialogue: 0,0:17:33.44,0:17:35.20,jp,,0,0,0,,あのときみたいに
Dialogue: 1,0:17:33.44,0:17:35.20,zh,,0,0,0,,就像那時一樣
Dialogue: 0,0:17:35.73,0:17:37.23,jp,,0,0,0,,飛発の出どころ
Dialogue: 1,0:17:35.73,0:17:37.23,zh,,0,0,0,,火銃的來源
Dialogue: 0,0:17:37.23,0:17:38.96,jp,,0,0,0,,連中の目的
Dialogue: 1,0:17:37.23,0:17:38.96,zh,,0,0,0,,那幫人的目的
Dialogue: 0,0:17:38.96,0:17:41.21,jp,,0,0,0,,わかっていないことが多すぎる
Dialogue: 1,0:17:38.96,0:17:41.21,zh,,0,0,0,,未知的東西太多了
Dialogue: 0,0:17:42.00,0:17:43.77,jp,,0,0,0,,異国の物だ
Dialogue: 1,0:17:42.00,0:17:43.77,zh,,0,0,0,,是外國的東西
Dialogue: 0,0:17:43.77,0:17:46.30,jp,,0,0,0,,恐らく西方の最新型だろう
Dialogue: 1,0:17:43.77,0:17:46.30,zh,,0,0,0,,若我沒猜錯 這是西方的最新型號
Dialogue: 0,0:17:47.01,0:17:48.59,jp,,0,0,0,,西方か
Dialogue: 1,0:17:47.01,0:17:48.59,zh,,0,0,0,,西方啊
Dialogue: 0,0:17:49.46,0:17:52.93,jp,,0,0,0,,鏡合わせのように　うり二つの特使たち
Dialogue: 1,0:17:49.46,0:17:52.93,zh,,0,0,0,,如照鏡子般 長相一模一樣的兩位特使
Dialogue: 0,0:17:53.35,0:17:57.49,jp,,0,0,0,,監視の目をかいくぐって　部屋を抜け出したという話も
Dialogue: 1,0:17:53.35,0:17:57.49,zh,,0,0,0,,先前那個躲避監視 逃出房間的故事
Dialogue: 0,0:17:57.49,0:18:00.10,jp,,0,0,0,,恐らく特使たちのことだろう
Dialogue: 1,0:17:57.49,0:18:00.10,zh,,0,0,0,,恐怕說的就是這兩位特使
Dialogue: 0,0:18:00.78,0:18:04.49,jp,,0,0,0,,部屋を抜け出して　一体何をしていたのか
Dialogue: 1,0:18:00.78,0:18:04.49,zh,,0,0,0,,她們逃出房間後 究竟做了什麼
Dialogue: 0,0:18:05.06,0:18:08.36,jp,,0,0,0,,子をはらんだ　例え話の妹のように
Dialogue: 1,0:18:05.06,0:18:08.36,zh,,0,0,0,,像故事裡懷孕的妹妹一樣
Dialogue: 0,0:18:08.36,0:18:11.00,jp,,0,0,0,,姦計をもくろんでいたか
Dialogue: 1,0:18:08.36,0:18:11.00,zh,,0,0,0,,謀劃著什麼奸計嗎
Dialogue: 0,0:18:11.00,0:18:12.13,jp,,0,0,0,,それとも
Dialogue: 1,0:18:11.00,0:18:12.13,zh,,0,0,0,,還是說
Dialogue: 0,0:18:15.04,0:18:18.44,jp,,0,0,0,,今日の連中が　何か吐いてくれたらいいけど
Dialogue: 1,0:18:15.04,0:18:18.44,zh,,0,0,0,,希望今天抓的那幫人能吐露點什麼吧
Dialogue: 0,0:18:19.57,0:18:21.54,jp,,0,0,0,,少しいいか
Dialogue: 1,0:18:19.57,0:18:21.54,zh,,0,0,0,,可以借用一點時間嗎
Dialogue: 0,0:18:21.54,0:18:23.30,jp,,0,0,0,,なぜここに
Dialogue: 1,0:18:21.54,0:18:23.30,zh,,0,0,0,,他怎麼在這裡
Dialogue: 0,0:18:23.30,0:18:26.00,jp,,0,0,0,,うたげに出てたんじゃないのか
Dialogue: 1,0:18:23.30,0:18:26.00,zh,,0,0,0,,他不是去參加宴會了嗎
Dialogue: 0,0:18:32.53,0:18:33.51,jp,,0,0,0,,開けなくていい
Dialogue: 1,0:18:32.53,0:18:33.51,zh,,0,0,0,,你不用開門
Dialogue: 0,0:18:34.35,0:18:37.94,jp,,0,0,0,,ずいぶんと驚かせてしまって　悪かった
Dialogue: 1,0:18:34.35,0:18:37.94,zh,,0,0,0,,今天嚇到你了 很抱歉
Dialogue: 0,0:18:41.50,0:18:45.40,jp,,0,0,0,,どんな顔をしているのか　見なくてもわかる
Dialogue: 1,0:18:41.50,0:18:45.40,zh,,0,0,0,,不看也知道他現在是什麼表情
Dialogue: 0,0:18:45.90,0:18:47.51,jp,,0,0,0,,気にしておりません
Dialogue: 1,0:18:45.90,0:18:47.51,zh,,0,0,0,,我沒放在心上
Dialogue: 0,0:18:48.07,0:18:50.59,jp,,0,0,0,,こちらこそ　申し訳ありませんでした
Dialogue: 1,0:18:48.07,0:18:50.59,zh,,0,0,0,,是我該向你道歉
Dialogue: 0,0:18:51.37,0:18:53.29,jp,,0,0,0,,そこそこなんて言って
Dialogue: 1,0:18:51.37,0:18:53.29,zh,,0,0,0,,對於說你不大這件事
Dialogue: 0,0:18:55.15,0:18:58.48,jp,,0,0,0,,壬氏様は　何を考えているんだろう
Dialogue: 1,0:18:55.15,0:18:58.48,zh,,0,0,0,,壬氏大人到底在想什麼呢
Dialogue: 0,0:18:59.23,0:19:03.66,jp,,0,0,0,,私は昔から　人の心の機微には疎い
Dialogue: 1,0:18:59.23,0:19:03.66,zh,,0,0,0,,我從小就對他人的感受不太敏感
Dialogue: 0,0:19:04.42,0:19:06.51,jp,,0,0,0,,育ててくれた姉ちゃんたちは
Dialogue: 1,0:19:04.42,0:19:06.51,zh,,0,0,0,,把我養大的姐姐們
Dialogue: 0,0:19:06.51,0:19:08.72,jp,,0,0,0,,仕事第一の妓女だ
Dialogue: 1,0:19:06.51,0:19:08.72,zh,,0,0,0,,都把工作放在首位
Dialogue: 0,0:19:09.24,0:19:13.01,jp,,0,0,0,,いくら泣こうが　仕事が終わるまで放置された
Dialogue: 1,0:19:09.24,0:19:13.01,zh,,0,0,0,,我再怎麼哭 在工作時間內她們都不會理會
Dialogue: 0,0:19:15.54,0:19:17.18,jp,,0,0,0,,そのうち悟ったのか
Dialogue: 1,0:19:15.54,0:19:17.18,zh,,0,0,0,,我逐漸明白了這一點
Dialogue: 0,0:19:17.72,0:19:20.04,jp,,0,0,0,,泣かない赤子になったらしい
Dialogue: 1,0:19:17.72,0:19:20.04,zh,,0,0,0,,就不再哭了
Dialogue: 0,0:19:21.18,0:19:22.70,jp,,0,0,0,,だからなのか
Dialogue: 1,0:19:21.18,0:19:22.70,zh,,0,0,0,,或許是這個緣故吧
Dialogue: 0,0:19:22.70,0:19:25.60,jp,,0,0,0,,人の好意にも悪意にも鈍感だ
Dialogue: 1,0:19:22.70,0:19:25.60,zh,,0,0,0,,我對他人的好意和惡意都有些遲鈍
Dialogue: 0,0:19:26.56,0:19:27.71,jp,,0,0,0,,こんなときに
Dialogue: 1,0:19:26.56,0:19:27.71,zh,,0,0,0,,像這種時候
Dialogue: 0,0:19:28.13,0:19:30.51,jp,,0,0,0,,何を言ったらいいかもわからない
Dialogue: 1,0:19:28.13,0:19:30.51,zh,,0,0,0,,也不知道該說些什麼
Dialogue: 0,0:19:31.90,0:19:34.11,jp,,0,0,0,,私は何も口にしません
Dialogue: 1,0:19:31.90,0:19:34.11,zh,,0,0,0,,我什麼都不會說的
Dialogue: 0,0:19:37.72,0:19:39.32,jp,,0,0,0,,私にとって
Dialogue: 1,0:19:37.72,0:19:39.32,zh,,0,0,0,,對我來說
Dialogue: 0,0:19:39.84,0:19:41.95,jp,,0,0,0,,壬氏様は壬氏様です
Dialogue: 1,0:19:39.84,0:19:41.95,zh,,0,0,0,,您還是那個壬氏大人
Dialogue: 0,0:19:45.67,0:19:47.92,jp,,0,0,0,,これが正直な気持ちだ
Dialogue: 1,0:19:45.67,0:19:47.92,zh,,0,0,0,,這是我的真心話
Dialogue: 0,0:19:48.42,0:19:51.22,jp,,0,0,0,,タマがあるかないかの違いなんて
Dialogue: 1,0:19:48.42,0:19:51.22,zh,,0,0,0,,他有沒有那玩意兒
Dialogue: 0,0:19:51.22,0:19:53.62,jp,,0,0,0,,別に見るわけでもないし
Dialogue: 1,0:19:51.22,0:19:53.62,zh,,0,0,0,,我又不是非要探究
Dialogue: 0,0:19:53.62,0:19:55.59,jp,,0,0,0,,私には関係ない
Dialogue: 1,0:19:53.62,0:19:55.59,zh,,0,0,0,,這事和我沒關係
Dialogue: 0,0:19:57.29,0:19:59.70,jp,,0,0,0,,お前にとって俺は俺か
Dialogue: 1,0:19:57.29,0:19:59.70,zh,,0,0,0,,對你來說 我仍舊是我嗎
Dialogue: 0,0:20:04.89,0:20:06.09,jp,,0,0,0,,警戒するな
Dialogue: 1,0:20:04.89,0:20:06.09,zh,,0,0,0,,別緊張
Dialogue: 0,0:20:06.93,0:20:08.60,jp,,0,0,0,,これを渡したいだけだ
Dialogue: 1,0:20:06.93,0:20:08.60,zh,,0,0,0,,我只是想把這個給你
Dialogue: 0,0:20:17.66,0:20:19.66,jp,,0,0,0,,これを渡すとともに
Dialogue: 1,0:20:17.66,0:20:19.66,zh,,0,0,0,,與此同時
Dialogue: 0,0:20:19.66,0:20:21.66,jp,,0,0,0,,ずっと伝えようと思っていた
Dialogue: 1,0:20:19.66,0:20:21.66,zh,,0,0,0,,我還有些事一直想告訴你
Dialogue: 0,0:20:23.49,0:20:25.59,jp,,0,0,0,,お前には　迷惑をかけるかもしれないが
Dialogue: 1,0:20:23.49,0:20:25.59,zh,,0,0,0,,這可能會給你帶來些麻煩
Dialogue: 0,0:20:25.59,0:20:26.61,jp,,0,0,0,,これは
Dialogue: 1,0:20:25.59,0:20:26.61,zh,,0,0,0,,這是
Dialogue: 0,0:20:27.58,0:20:29.79,jp,,0,0,0,,今回の旅に来てもらったのも
Dialogue: 1,0:20:27.58,0:20:29.79,zh,,0,0,0,,這次之所以讓你同行
Dialogue: 0,0:20:29.79,0:20:31.46,jp,,0,0,0,,ごっ　ごっ　ごっ
Dialogue: 1,0:20:29.79,0:20:31.46,zh,,0,0,0,,牛 牛 牛...
Dialogue: 0,0:20:31.46,0:20:32.38,jp,,0,0,0,,そのためだ
Dialogue: 1,0:20:31.46,0:20:32.38,zh,,0,0,0,,也正是為此
Dialogue: 0,0:20:32.82,0:20:35.03,jp,,0,0,0,,牛黄
Dialogue: 1,0:20:32.82,0:20:35.03,zh,,0,0,0,,牛黃
Dialogue: 0,0:20:35.03,0:20:37.38,jp,,0,0,0,,非常に貴重とされる牛の胆石
Dialogue: 1,0:20:35.03,0:20:37.38,zh,,0,0,0,,珍貴無比的牛膽結石
Dialogue: 0,0:20:37.38,0:20:39.80,jp,,0,0,0,,夢にまで見た秘薬が今
Dialogue: 1,0:20:37.38,0:20:39.80,zh,,0,0,0,,我夢寐以求的秘藥 如今竟然
Dialogue: 0,0:20:39.80,0:20:41.80,jp,,0,0,0,,手の中に
Dialogue: 1,0:20:39.80,0:20:41.80,zh,,0,0,0,,真的擺在我手上
Dialogue: 0,0:20:42.14,0:20:43.10,jp,,0,0,0,,ああ
Dialogue: 1,0:20:42.14,0:20:43.10,zh,,0,0,0,,是啊
Dialogue: 0,0:20:43.10,0:20:46.33,jp,,0,0,0,,待たせてすまなかった　ようやく手に入った
Dialogue: 1,0:20:43.10,0:20:46.33,zh,,0,0,0,,抱歉讓你等這麼久 終於到手...
Dialogue: 0,0:20:46.33,0:20:48.25,jp,,0,0,0,,って　そうではなく
Dialogue: 1,0:20:46.33,0:20:48.25,zh,,0,0,0,,不對 我不是說這個
Dialogue: 0,0:20:48.25,0:20:49.98,jp,,0,0,0,,ありがとうございます
Dialogue: 1,0:20:48.25,0:20:49.98,zh,,0,0,0,,非常感謝您
Dialogue: 0,0:20:58.78,0:21:00.57,jp,,0,0,0,,ではおやすみなさいませ
Dialogue: 1,0:20:58.78,0:21:00.57,zh,,0,0,0,,那麼祝您晚安好夢
Dialogue: 0,0:21:04.08,0:21:05.90,jp,,0,0,0,,おい　勝手に閉めるな
Dialogue: 1,0:21:04.08,0:21:05.90,zh,,0,0,0,,喂 別關門啊
Dialogue: 0,0:21:05.90,0:21:08.21,jp,,0,0,0,,話はまだ終わってないぞ
Dialogue: 1,0:21:05.90,0:21:08.21,zh,,0,0,0,,我話還沒說完呢
Dialogue: 0,0:21:10.69,0:21:14.17,jp,,0,0,0,,誰にも邪魔されたくない
Dialogue: 1,0:21:10.69,0:21:14.17,zh,,0,0,0,,誰都別想打擾我
Dialogue: 0,0:21:19.12,0:21:22.53,jp,,0,0,0,,壬氏様が宦官かどうかなんて　どうでもいい
Dialogue: 1,0:21:19.12,0:21:22.53,zh,,0,0,0,,壬氏大人是不是宦官跟我有什麼關係
Dialogue: 0,0:21:22.53,0:21:25.01,jp,,0,0,0,,ただ　牛黄分の恩はある
Dialogue: 1,0:21:22.53,0:21:25.01,zh,,0,0,0,,不過 這牛黃算我欠他一個人情
Dialogue: 0,0:21:25.66,0:21:29.04,jp,,0,0,0,,もし秘密がばれて　窮地に立たされたら
Dialogue: 1,0:21:25.66,0:21:29.04,zh,,0,0,0,,要是他秘密暴露 走投無路的話
Dialogue: 0,0:21:29.04,0:21:30.94,jp,,0,0,0,,そのときは
Dialogue: 1,0:21:29.04,0:21:30.94,zh,,0,0,0,,到那時
Dialogue: 0,0:21:31.81,0:21:34.85,jp,,0,0,0,,ちゃんと本物の宦官にしてあげよう
Dialogue: 1,0:21:31.81,0:21:34.85,zh,,0,0,0,,我就讓他當上真正的宦官吧
Dialogue: 0,0:21:36.28,0:21:39.24,jp,,0,0,0,,おい　聞いているのか
Dialogue: 1,0:21:36.28,0:21:39.24,zh,,0,0,0,,喂 你在聽嗎
Dialogue: 0,0:21:39.24,0:21:42.63,jp,,0,0,0,,おい　人の話は最後まで聞け
Dialogue: 1,0:21:39.24,0:21:42.63,zh,,0,0,0,,喂 聽人把話說完啊
Dialogue: 0,0:21:43.45,0:21:44.69,jp,,0,0,0,,この国で
Dialogue: 1,0:21:43.45,0:21:44.69,zh,,0,0,0,,在這個國家
Dialogue: 0,0:21:44.69,0:21:47.02,jp,,0,0,0,,「華」の文字を冠する者は
Dialogue: 1,0:21:44.69,0:21:47.02,zh,,0,0,0,,冠以華字為姓者
Dialogue: 0,0:21:47.02,0:21:49.32,jp,,0,0,0,,今現在２人のみ
Dialogue: 1,0:21:47.02,0:21:49.32,zh,,0,0,0,,如今唯有兩人
Dialogue: 0,0:21:51.30,0:21:53.75,jp,,0,0,0,,国の頂点に立つ帝
Dialogue: 1,0:21:51.30,0:21:53.75,zh,,0,0,0,,一位是立於萬萬人之上的國君
Dialogue: 0,0:21:54.21,0:21:55.47,jp,,0,0,0,,そして
Dialogue: 1,0:21:54.21,0:21:55.47,zh,,0,0,0,,而另一位
Dialogue: 0,0:21:56.62,0:21:57.94,jp,,0,0,0,,壬氏様
Dialogue: 1,0:21:56.62,0:21:57.94,zh,,0,0,0,,壬氏大人
Dialogue: 0,0:21:58.38,0:21:59.17,jp,,0,0,0,,いえ
Dialogue: 1,0:21:58.38,0:21:59.17,zh,,0,0,0,,不
Dialogue: 0,0:21:59.58,0:22:00.88,jp,,0,0,0,,月の君
Dialogue: 1,0:21:59.58,0:22:00.88,zh,,0,0,0,,月之君
Dialogue: 0,0:22:02.70,0:22:06.24,jp,,0,0,0,,いつまでもかりそめの立場ではいられませんよ
Dialogue: 1,0:22:02.70,0:22:06.24,zh,,0,0,0,,你的假身份瞞得了一時 卻瞞不過一世啊
Dialogue: 0,0:22:07.96,0:22:11.25,jp,,0,0,0,,あなたはこの国の帝の弟君
Dialogue: 1,0:22:07.96,0:22:11.25,zh,,0,0,0,,因為你可是當今的皇弟
Dialogue: 0,0:22:13.03,0:22:15.14,jp,,0,0,0,,華瑞月なのだから
Dialogue: 1,0:22:13.03,0:22:15.14,zh,,0,0,0,,華瑞月
