Comment: 0,0:00:00.00,0:00:00.00,*Default,NTP,0,0,0,,{\fad(500,0)\pos(590,422)}
Dialogue: 0,0:03:39.31,0:03:44.81,Title,NTP,0,0,0,,{\pos(590,498)\fad(500,0)}廣\N告
Dialogue: 0,0:00:00.00,0:00:00.00,*Default,NTP,0,0,0,,
Dialogue: 0,0:00:05.89,0:00:08.36,Aside,NTP,0,0,0,,(村莊振興會議)
Dialogue: 0,0:00:11.35,0:00:13.19,*Default,NTP,0,0,0,,熊在嗎 熊
Dialogue: 0,0:00:16.77,0:00:18.19,*Default,NTP,0,0,0,,啊 是響
Dialogue: 0,0:00:18.69,0:00:20.56,*Default,NTP,0,0,0,,我來還向你借的書了
Dialogue: 0,0:00:21.01,0:00:22.18,*Default,NTP,0,0,0,,已經看完了嗎
Dialogue: 0,0:00:22.47,0:00:23.67,*Default,NTP,0,0,0,,好看嗎
Dialogue: 0,0:00:24.00,0:00:26.33,*Default,NTP,0,0,0,,好看是好看 不過別再借我了
Dialogue: 0,0:00:26.41,0:00:27.31,*Default,NTP,0,0,0,,為什麼
Dialogue: 0,0:00:27.98,0:00:30.56,*Default,NTP,0,0,0,,不然我還要再來這裡還書
Dialogue: 0,0:00:32.65,0:00:34.76,*Default,NTP,0,0,0,,啊 我們現在在開會
Dialogue: 0,0:00:35.21,0:00:36.01,*Default,NTP,0,0,0,,什麼會
Dialogue: 0,0:00:36.36,0:00:37.71,*Default,NTP,0,0,0,,村莊振興會議
Dialogue: 0,0:00:37.94,0:00:39.49,*Default,NTP,0,0,0,,響也來參加吧
Dialogue: 0,0:00:39.70,0:00:41.51,*Default,NTP,0,0,0,,誰要參加啊 這麼麻煩
Dialogue: 0,0:00:41.95,0:00:43.64,*Default,NTP,0,0,0,,良夫也很有幹勁喔
Dialogue: 0,0:00:44.94,0:00:46.39,*Default,NTP,0,0,0,,我不是說我不參加嗎
Dialogue: 0,0:00:49.31,0:00:51.91,*Default,NTP,0,0,0,,大家都出過意見了
Dialogue: 0,0:00:52.65,0:00:55.56,*Default,NTP,0,0,0,,我推薦這個提案
Dialogue: 0,0:00:57.20,0:00:58.63,*Default,NTP,0,0,0,,廣告?
Dialogue: 0,0:00:59.25,0:01:00.69,*Default,NTP,0,0,0,,有說過這個嗎
Dialogue: 0,0:01:00.97,0:01:02.06,*Default,NTP,0,0,0,,有嗎
Dialogue: 0,0:01:02.10,0:01:04.14,*Default,NTP,0,0,0,,廣告是說電視那個嗎
Dialogue: 0,0:01:04.41,0:01:05.11,*Default,NTP,0,0,0,,沒錯
Dialogue: 0,0:01:05.26,0:01:07.09,*Default,NTP,0,0,0,,廣告的效果是很大的
Dialogue: 0,0:01:07.37,0:01:08.30,*Default,NTP,0,0,0,,對吧 響子
Dialogue: 0,0:01:09.29,0:01:13.33,*Default,NTP,0,0,0,,妳工作的柏青哥店 會看廣告的人很多吧
Dialogue: 0,0:01:09.33,0:01:10.88,Remark,NTP,0,0,0,,柏青哥: 即 彈珠店
Dialogue: 0,0:01:14.10,0:01:17.88,*Default,NTP,0,0,0,,這個嘛 的確是有這種人
Dialogue: 0,0:01:18.10,0:01:21.67,*Default,NTP,0,0,0,,說不定會有一堆看過電視的觀光客跑來我們村子
Dialogue: 0,0:01:21.92,0:01:22.79,*Default,NTP,0,0,0,,是啊
Dialogue: 0,0:01:23.43,0:01:28.18,*Default,NTP,0,0,0,,不過要拍廣告的話 就要找廣告公司了
Dialogue: 0,0:01:28.21,0:01:30.40,*Default,NTP,0,0,0,,放心吧 不用找專業的
Dialogue: 0,0:01:30.65,0:01:32.40,*Default,NTP,0,0,0,,我們村莊自己做
Dialogue: 0,0:01:33.65,0:01:38.15,*Default,NTP,0,0,0,,廣告有這麼簡單就能在電視播嗎
Dialogue: 0,0:01:39.50,0:01:40.74,*Default,NTP,0,0,0,,不用擔心
Dialogue: 0,0:01:40.85,0:01:43.56,*Default,NTP,0,0,0,,我已經跟電視局的人說好了
Dialogue: 0,0:01:44.00,0:01:45.41,*Default,NTP,0,0,0,,已經說好了嗎
Dialogue: 0,0:01:45.44,0:01:46.76,*Default,NTP,0,0,0,,{\an8}做的好 良夫
Dialogue: 0,0:01:46.16,0:01:51.05,*Default,NTP,0,0,0,,說什麼會議 那傢伙一開始就打算拍廣告了吧
Dialogue: 0,0:01:51.51,0:01:53.86,*Default,NTP,0,0,0,,拍廣告來振興村莊吧
Dialogue: 0,0:01:53.97,0:01:55.13,*Default,NTP,0,0,0,,振興
Dialogue: 0,0:01:55.17,0:01:57.40,*Default,NTP,0,0,0,,大家一起來拍廣告吧
Dialogue: 0,0:01:57.55,0:01:58.71,*Default,NTP,0,0,0,,拍廣告
Dialogue: 0,0:01:58.74,0:02:00.86,*Default,NTP,0,0,0,,來聚集觀光客
Dialogue: 0,0:02:00.89,0:02:02.22,*Default,NTP,0,0,0,,聚集
Dialogue: 0,0:02:02.25,0:02:05.32,*Default,NTP,0,0,0,,來衝「最想住的村子」的前幾名吧
Dialogue: 0,0:02:05.41,0:02:07.21,*Default,NTP,0,0,0,,來衝
Comment: 0,0:00:00.00,0:00:00.00,*Default,NTP,0,0,0,,-OP-
Dialogue: 0,0:03:46.36,0:03:47.97,*Default,NTP,0,0,0,,和電視局談過之後
Dialogue: 0,0:03:48.15,0:03:50.63,*Default,NTP,0,0,0,,會在中午的節目中播
Dialogue: 0,0:03:50.69,0:03:52.06,*Default,NTP,0,0,0,,喔 中午嗎
Dialogue: 0,0:03:52.10,0:03:54.68,*Default,NTP,0,0,0,,在一個叫「下午{\fn华康少女字体\fs50}Happy{\fn萝莉体 第二版\fs50}」的節目中播 大概30秒
Dialogue: 0,0:03:54.72,0:03:56.26,*Default,NTP,0,0,0,,我知道 我知道 「下午{\fn华康少女字体\fs50}Happy{\fn萝莉体 第二版\fs50}」
Dialogue: 0,0:03:56.31,0:03:57.83,*Default,NTP,0,0,0,,一個月後播
Dialogue: 0,0:03:57.99,0:03:59.70,*Default,NTP,0,0,0,,得馬上拍攝才行
Dialogue: 0,0:03:59.87,0:04:01.53,*Default,NTP,0,0,0,,誰要當導演啊
Dialogue: 0,0:04:01.62,0:04:03.95,*Default,NTP,0,0,0,,啊 導演的話我今天叫來了
Dialogue: 0,0:04:04.07,0:04:06.21,*Default,NTP,0,0,0,,導演 請進
Dialogue: 0,0:04:17.27,0:04:19.21,*Default,NTP,0,0,0,,這不是臼井爺爺嗎
Dialogue: 0,0:04:19.80,0:04:23.08,*Default,NTP,0,0,0,,雖然戴著太陽眼鏡 的確是臼井爺爺
Dialogue: 0,0:04:23.19,0:04:27.08,*Default,NTP,0,0,0,,我記得他不是搞壞身子去住院了嗎
Dialogue: 0,0:04:29.62,0:04:33.55,*Default,NTP,0,0,0,,聽說臼井爺爺年輕時曾經想當電影導演
Dialogue: 0,0:04:33.75,0:04:36.22,*Default,NTP,0,0,0,,跟他聊過之後 他說請務必讓他拍
Dialogue: 0,0:04:36.29,0:04:39.60,*Default,NTP,0,0,0,,就這樣帶病來參加了
Dialogue: 0,0:04:39.87,0:04:40.89,*Default,NTP,0,0,0,,不要緊嗎
Dialogue: 0,0:04:41.02,0:04:42.88,*Default,NTP,0,0,0,,真的能當導演嗎
Dialogue: 0,0:04:42.93,0:04:45.25,*Default,NTP,0,0,0,,反正也沒別人了
Dialogue: 0,0:04:46.48,0:04:47.66,*Default,NTP,0,0,0,,沒問題吧
Dialogue: 0,0:04:51.45,0:04:54.83,*Default,NTP,0,0,0,,那就由臼井爺爺當導演
Dialogue: 0,0:04:55.21,0:04:57.20,*Default,NTP,0,0,0,,要從什麼開始
Dialogue: 0,0:04:57.50,0:05:01.71,*Default,NTP,0,0,0,,這個嘛 要先決定要拍什麼廣告
Dialogue: 0,0:05:01.95,0:05:04.44,*Default,NTP,0,0,0,,果然還是宣傳名產吧
Dialogue: 0,0:05:04.97,0:05:06.76,*Default,NTP,0,0,0,,名產 就是這個
Dialogue: 0,0:05:07.31,0:05:08.81,*Default,NTP,0,0,0,,滑菇嗎
Dialogue: 0,0:05:09.31,0:05:10.12,*Default,NTP,0,0,0,,番薯
Dialogue: 0,0:05:10.24,0:05:10.96,*Default,NTP,0,0,0,,蘋果
Dialogue: 0,0:05:11.39,0:05:12.71,*Default,NTP,0,0,0,,蘋果
Dialogue: 0,0:05:13.11,0:05:14.65,*Default,NTP,0,0,0,,保田小姐有什麼意見
Dialogue: 0,0:05:15.34,0:05:17.74,*Default,NTP,0,0,0,,這村莊就只有大自然了
Dialogue: 0,0:05:17.95,0:05:19.41,*Default,NTP,0,0,0,,大自然 就是這個
Dialogue: 0,0:05:19.76,0:05:21.82,*Default,NTP,0,0,0,,向都市的傢伙宣傳這個吧
Dialogue: 0,0:05:22.15,0:05:23.17,*Default,NTP,0,0,0,,大自然
Dialogue: 0,0:05:24.18,0:05:25.07,*Default,NTP,0,0,0,,響子呢
Dialogue: 0,0:05:26.89,0:05:28.83,*Default,NTP,0,0,0,,一下子想不出來啦
Dialogue: 0,0:05:29.33,0:05:31.05,*Default,NTP,0,0,0,,真不合作啊
Dialogue: 0,0:05:31.25,0:05:33.37,*Default,NTP,0,0,0,,響子也是村子的一員
Dialogue: 0,0:05:33.51,0:05:35.32,*Default,NTP,0,0,0,,再多認真一點吧
Dialogue: 0,0:05:37.08,0:05:38.77,*Default,NTP,0,0,0,,真麻煩
Dialogue: 0,0:05:47.16,0:05:50.45,*Default,NTP,0,0,0,,這傢伙的巫女裝束在別人看來是很稀奇的吧
Dialogue: 0,0:05:50.61,0:05:52.89,*Default,NTP,0,0,0,,這不是個很好的宣傳嗎
Dialogue: 0,0:05:55.03,0:05:57.41,*Default,NTP,0,0,0,,對啊 小町 就是這個
Dialogue: 0,0:05:57.79,0:05:59.79,*Default,NTP,0,0,0,,明透的巫女服比較好
Dialogue: 0,0:05:59.88,0:06:00.82,*Default,NTP,0,0,0,,是透明
Dialogue: 0,0:06:01.46,0:06:04.54,*Default,NTP,0,0,0,,等等 妳說什麼啊 小響
Dialogue: 0,0:06:05.17,0:06:07.12,*Default,NTP,0,0,0,,真是個好主意 響子
Dialogue: 0,0:06:07.26,0:06:08.39,*Default,NTP,0,0,0,,村莊的形象女孩
Dialogue: 0,0:06:08.45,0:06:10.72,*Default,NTP,0,0,0,,小町手持村子的名產跳舞
Dialogue: 0,0:06:10.77,0:06:12.56,*Default,NTP,0,0,0,,不要不要不要...
Dialogue: 0,0:06:12.62,0:06:15.01,*Default,NTP,0,0,0,,絕對會大受歡迎的 這廣告
Dialogue: 0,0:06:15.10,0:06:17.38,*Default,NTP,0,0,0,,我不要
Dialogue: 0,0:06:17.91,0:06:20.37,*Default,NTP,0,0,0,,導演 怎麼樣
Dialogue: 0,0:06:22.33,0:06:24.02,*Default,NTP,0,0,0,,就這麼決定了
Dialogue: 0,0:06:26.10,0:06:28.27,*Default,NTP,0,0,0,,那就萬事拜託了
Dialogue: 0,0:06:36.84,0:06:38.02,*Default,NTP,0,0,0,,吶 小町
Dialogue: 0,0:06:38.05,0:06:38.66,*Default,NTP,0,0,0,,不要
Dialogue: 0,0:06:39.70,0:06:42.06,*Default,NTP,0,0,0,,我絕對不幹
Dialogue: 0,0:06:42.24,0:06:43.78,*Default,NTP,0,0,0,,拍那津不就好了
Dialogue: 0,0:06:43.85,0:06:46.80,*Default,NTP,0,0,0,,那津更能替熊出村宣傳吧
Dialogue: 0,0:06:47.22,0:06:50.87,*Default,NTP,0,0,0,,我不行啦 是攝影師 又是熊
Dialogue: 0,0:06:51.27,0:06:52.50,*Default,NTP,0,0,0,,是啊
Dialogue: 0,0:06:52.74,0:06:55.54,*Default,NTP,0,0,0,,也不能暴露村莊的秘密
Dialogue: 0,0:06:56.16,0:07:00.07,*Default,NTP,0,0,0,,既然不能出場 我就當攝影師為村莊做貢獻
Dialogue: 0,0:07:00.42,0:07:03.06,*Default,NTP,0,0,0,,再說了 宣傳有熊出沒的村子
Dialogue: 0,0:07:03.12,0:07:05.46,*Default,NTP,0,0,0,,反而會使印象變差吧
Dialogue: 0,0:07:07.57,0:07:08.75,*Default,NTP,0,0,0,,求求妳 小町
Dialogue: 0,0:07:10.69,0:07:12.29,*Default,NTP,0,0,0,,已經不能回頭了
Dialogue: 0,0:07:12.77,0:07:14.97,*Default,NTP,0,0,0,,能拯救這村莊的只有小町了
Dialogue: 0,0:07:15.58,0:07:17.95,*Default,NTP,0,0,0,,小町 妳是熊出村的巫女
Dialogue: 0,0:07:18.16,0:07:21.21,*Default,NTP,0,0,0,,不對 是熊出村的女神
Dialogue: 0,0:07:25.10,0:07:28.81,*Default,NTP,0,0,0,,老實說剛剛只是為了應付 隨口說說的
Dialogue: 0,0:07:29.34,0:07:32.55,*Default,NTP,0,0,0,,不過妳的巫女裝束...很不錯喔
Dialogue: 0,0:07:33.07,0:07:37.65,*Default,NTP,0,0,0,,還有 其實臼井爺爺生病 好一段時間沒有精神了
Dialogue: 0,0:07:37.84,0:07:42.00,*Default,NTP,0,0,0,,我想拍了這個之後他會回想起從前 變得有精力一點
Dialogue: 0,0:07:45.02,0:07:49.19,*Default,NTP,0,0,0,,說是臼井爺爺的恢復與否就繫在小町身上也不為過
Dialogue: 0,0:07:53.87,0:07:57.01,*Default,NTP,0,0,0,,我知道了 只有一次喔
Dialogue: 0,0:07:59.21,0:08:01.28,*Default,NTP,0,0,0,,太好了 響子
Dialogue: 0,0:08:14.01,0:08:17.16,*Default,NTP,0,0,0,,主角決定之後 剩下的就是那個了呢
Dialogue: 0,0:08:20.00,0:08:22.31,*Default,NTP,0,0,0,,只要能解決那個問題...
Dialogue: 0,0:08:22.80,0:08:23.85,*Default,NTP,0,0,0,,那個問題?
Dialogue: 0,0:08:24.73,0:08:29.30,*Default,NTP,0,0,0,,這個嘛 要播30秒的廣告是要花錢的
Dialogue: 0,0:08:32.21,0:08:34.50,*Default,NTP,0,0,0,,你剛才完全沒說到這件事
Dialogue: 0,0:08:34.57,0:08:35.95,*Default,NTP,0,0,0,,這筆錢要...
Dialogue: 0,0:08:38.42,0:08:39.61,*Default,NTP,0,0,0,,咦
Dialogue: 0,0:08:39.85,0:08:41.68,*Default,NTP,0,0,0,,這麼多錢你要怎麼搞啊
Dialogue: 0,0:08:42.02,0:08:45.06,*Default,NTP,0,0,0,,村公所再怎麼說也沒有那麼多錢
Dialogue: 0,0:08:45.37,0:08:47.12,*Default,NTP,0,0,0,,我在想要怎麼辦
Dialogue: 0,0:08:47.36,0:08:52.31,*Default,NTP,0,0,0,,虧你這樣還真敢說能在電視上播了
Dialogue: 0,0:08:52.35,0:08:54.43,*Default,NTP,0,0,0,,贊助商啊 贊助商
Dialogue: 0,0:08:54.73,0:08:56.55,*Default,NTP,0,0,0,,有沒有啊 贊助商
Dialogue: 0,0:08:59.37,0:09:01.63,*Default,NTP,0,0,0,,那德山婆婆怎麼樣
Dialogue: 0,0:09:02.69,0:09:04.05,*Default,NTP,0,0,0,,鐘錶眼鏡店的?
Dialogue: 0,0:09:04.40,0:09:05.21,*Default,NTP,0,0,0,,為什麼
Dialogue: 0,0:09:05.77,0:09:08.06,*Default,NTP,0,0,0,,聽說她存了一筆小錢
Dialogue: 0,0:09:08.25,0:09:10.35,*Default,NTP,0,0,0,,就藏在佛壇後面
Dialogue: 0,0:09:11.05,0:09:12.37,*Default,NTP,0,0,0,,這是哪來的情報
Dialogue: 0,0:09:12.79,0:09:16.00,*Default,NTP,0,0,0,,好 就找德山婆婆問問吧
Dialogue: 0,0:09:20.32,0:09:23.02,*Default,NTP,0,0,0,,這還真是一筆大錢啊
Dialogue: 0,0:09:23.09,0:09:28.43,*Default,NTP,0,0,0,,沒錯 我認為正是深愛這個村莊的德山婆婆才會懂我
Dialogue: 0,0:09:29.51,0:09:31.43,*Default,NTP,0,0,0,,有很多人來這個村莊的話
Dialogue: 0,0:09:31.63,0:09:33.76,*Default,NTP,0,0,0,,這家店也會有一堆客人
Dialogue: 0,0:09:35.16,0:09:38.27,*Default,NTP,0,0,0,,時鐘和眼鏡都會越賣越好 生意大興隆
Dialogue: 0,0:09:39.73,0:09:41.30,*Default,NTP,0,0,0,,拜託妳了
Dialogue: 0,0:09:43.81,0:09:45.21,*Default,NTP,0,0,0,,這個嘛...
Dialogue: 0,0:09:48.19,0:09:49.68,*Default,NTP,0,0,0,,拜託妳了
Dialogue: 0,0:09:51.83,0:09:53.15,*Default,NTP,0,0,0,,好吧
Dialogue: 0,0:09:53.77,0:09:55.56,*Default,NTP,0,0,0,,我來出這筆錢
Dialogue: 0,0:09:56.27,0:09:57.56,*Default,NTP,0,0,0,,真的嗎
Dialogue: 0,0:09:57.75,0:09:58.87,*Default,NTP,0,0,0,,只不過
Dialogue: 0,0:09:59.49,0:10:03.15,*Default,NTP,0,0,0,,我有一個條件
Dialogue: 0,0:10:03.65,0:10:05.70,*Default,NTP,0,0,0,,條…條件嗎
Dialogue: 0,0:10:06.17,0:10:07.79,*Default,NTP,0,0,0,,沒錯
Dialogue: 0,0:10:11.25,0:10:13.14,*Default,NTP,0,0,0,,條件是?
Dialogue: 0,0:10:31.37,0:10:33.89,*Default,NTP,0,0,0,,彷彿被深綠色的群山擁抱一般
Dialogue: 0,0:10:33.96,0:10:35.71,*Default,NTP,0,0,0,,靜靜潛藏於此的祕湯
Dialogue: 0,0:10:35.99,0:10:38.79,*Default,NTP,0,0,0,,真是美妙的外景地啊 導演
Dialogue: 0,0:10:40.03,0:10:41.07,*Default,NTP,0,0,0,,好 大家
Dialogue: 0,0:10:41.29,0:10:43.07,*Default,NTP,0,0,0,,來拍個好廣告吧
Dialogue: 0,0:10:48.45,0:10:49.15,*Default,NTP,0,0,0,,什麼
Dialogue: 0,0:10:49.59,0:10:52.52,*Default,NTP,0,0,0,,「這樣會拍不到好畫面 把那屋頂拆掉」
Dialogue: 0,0:10:52.72,0:10:54.70,*Default,NTP,0,0,0,,…這怎麼可能做得到啊
Dialogue: 0,0:10:56.36,0:10:58.09,*Default,NTP,0,0,0,,真有導演樣
Dialogue: 0,0:11:00.09,0:11:01.49,*Default,NTP,0,0,0,,怎麼了 小町
Dialogue: 0,0:11:01.96,0:11:06.34,*Default,NTP,0,0,0,,溫泉...難道說我要進去泡嗎
Dialogue: 0,0:11:06.82,0:11:09.37,*Default,NTP,0,0,0,,放心吧 說穿泳裝就可以了
Dialogue: 0,0:11:10.20,0:11:11.40,*Default,NTP,0,0,0,,給妳 我帶來了
Dialogue: 0,0:11:13.29,0:11:14.57,*Default,NTP,0,0,0,,我果然還是不要
Dialogue: 0,0:11:14.88,0:11:18.68,*Default,NTP,0,0,0,,我沒辦法將我的泳裝姿態給全國的人看
Dialogue: 0,0:11:19.27,0:11:20.78,*Default,NTP,0,0,0,,只是地區的啦
Dialogue: 0,0:11:21.12,0:11:24.04,*Default,NTP,0,0,0,,不管是全國還是地區 不要就是不要啦
Dialogue: 0,0:11:24.63,0:11:26.90,*Default,NTP,0,0,0,,真是不到黃河心不死啊 小町
Dialogue: 0,0:11:27.25,0:11:30.19,*Default,NTP,0,0,0,,妳都接下來了 就做到最後吧
Dialogue: 0,0:11:32.19,0:11:33.56,*Default,NTP,0,0,0,,那津這個笨蛋
Dialogue: 0,0:11:34.23,0:11:38.31,*Default,NTP,0,0,0,,呃...首先小町拿著滑菇和番薯和蘋果
Dialogue: 0,0:11:38.36,0:11:39.82,*Default,NTP,0,0,0,,跳著舞出場
Dialogue: 0,0:11:39.98,0:11:41.68,*Default,NTP,0,0,0,,然後跳進溫泉
Dialogue: 0,0:11:41.88,0:11:44.88,*Default,NTP,0,0,0,,然後 村民{\fn华康少女字体\fs50}A{\fn萝莉体 第二版\fs50}說「滑菇光滑好吃」
Dialogue: 0,0:11:45.12,0:11:47.61,*Default,NTP,0,0,0,,村民{\fn华康少女字体\fs50}B{\fn萝莉体 第二版\fs50}說「番薯熱騰騰」
Dialogue: 0,0:11:48.25,0:11:49.88,*Default,NTP,0,0,0,,這是臼井爺爺的畫嗎
Dialogue: 0,0:11:50.22,0:11:51.64,*Default,NTP,0,0,0,,畫得真好
Dialogue: 0,0:11:51.73,0:11:54.06,*Default,NTP,0,0,0,,村民{\fn华康少女字体\fs50}C{\fn萝莉体 第二版\fs50}說「蘋果清脆香甜」
Dialogue: 0,0:11:54.11,0:11:58.85,*Default,NTP,0,0,0,,最後小町咬一口蘋果說「熊出村真棒」
Dialogue: 0,0:11:59.42,0:12:01.72,*Default,NTP,0,0,0,,喔 不是很不錯嗎
Dialogue: 0,0:12:02.11,0:12:04.59,*Default,NTP,0,0,0,,那村民{\fn华康少女字体\fs50}A{\fn萝莉体 第二版\fs50}誰要演
Dialogue: 0,0:12:04.62,0:12:07.13,*Default,NTP,0,0,0,,我我我...
Dialogue: 0,0:12:07.91,0:12:10.13,*Default,NTP,0,0,0,,那開始徵選會
Dialogue: 0,0:12:10.53,0:12:13.29,*Default,NTP,0,0,0,,1號 59歲 小松龜次
Dialogue: 0,0:12:13.40,0:12:15.26,*Default,NTP,0,0,0,,興趣是釀造濁酒
Dialogue: 0,0:12:15.52,0:12:16.66,*Default,NTP,0,0,0,,這些不用說了
Dialogue: 0,0:12:17.24,0:12:18.12,*Default,NTP,0,0,0,,那麼...
Dialogue: 0,0:12:18.60,0:12:20.81,*Default,NTP,0,0,0,,滑菇光滑好吃
Dialogue: 0,0:12:24.74,0:12:26.74,*Default,NTP,0,0,0,,再多點光滑感
Dialogue: 0,0:12:27.34,0:12:28.56,*Default,NTP,0,0,0,,光滑感...
Dialogue: 0,0:12:29.28,0:12:30.42,*Default,NTP,0,0,0,,我知道了
Dialogue: 0,0:12:30.81,0:12:34.99,*Default,NTP,0,0,0,,滑菇光滑好吃 光滑好吃
Dialogue: 0,0:12:35.03,0:12:36.10,*Default,NTP,0,0,0,,再激烈點
Dialogue: 0,0:12:36.15,0:12:37.68,*Default,NTP,0,0,0,,光滑好吃光滑好吃
Dialogue: 0,0:12:37.85,0:12:39.66,*Default,NTP,0,0,0,,番薯熱騰騰
Dialogue: 0,0:12:41.77,0:12:43.84,*Default,NTP,0,0,0,,老媽 再更像番薯一點
Dialogue: 0,0:12:44.11,0:12:45.80,*Default,NTP,0,0,0,,番薯熱騰騰
Dialogue: 0,0:12:46.31,0:12:49.62,*Default,NTP,0,0,0,,老媽從頭頂到腳趾都是番薯
Dialogue: 0,0:12:49.72,0:12:51.66,*Default,NTP,0,0,0,,番薯熱騰騰 熱騰騰
Dialogue: 0,0:12:52.31,0:12:54.28,*Default,NTP,0,0,0,,蘋果清脆香甜
Dialogue: 0,0:12:54.83,0:12:56.09,*Default,NTP,0,0,0,,好 下一個
Dialogue: 0,0:12:56.40,0:12:59.72,*Default,NTP,0,0,0,,完了? 這是好 還是壞
Dialogue: 0,0:13:00.91,0:13:02.25,*Default,NTP,0,0,0,,那我發表了
Dialogue: 0,0:13:02.49,0:13:04.21,*Default,NTP,0,0,0,,村民{\fn华康少女字体\fs50}A{\fn萝莉体 第二版\fs50}是響
Dialogue: 0,0:13:04.45,0:13:05.57,*Default,NTP,0,0,0,,為什麼啊
Dialogue: 0,0:13:04.45,0:13:05.57,*Default,NTP,0,0,0,,為什麼啊
Dialogue: 0,0:13:05.78,0:13:08.00,*Default,NTP,0,0,0,,我根本沒參加徵選會
Dialogue: 0,0:13:08.20,0:13:09.91,*Default,NTP,0,0,0,,因為是導演指名的
Dialogue: 0,0:13:11.79,0:13:13.99,*Default,NTP,0,0,0,,讓想演的去演吧
Dialogue: 0,0:13:14.67,0:13:16.27,*Default,NTP,0,0,0,,接下來村民{\fn华康少女字体\fs50}B{\fn萝莉体 第二版\fs50}是...
Dialogue: 0,0:13:16.53,0:13:17.34,*Default,NTP,0,0,0,,老媽
Dialogue: 0,0:13:17.76,0:13:19.05,*Default,NTP,0,0,0,,太好了
Dialogue: 0,0:13:19.09,0:13:22.26,*Default,NTP,0,0,0,,說妳非常像番薯 得到了很高的評價
Dialogue: 0,0:13:22.44,0:13:23.98,*Default,NTP,0,0,0,,然後村民{\fn华康少女字体\fs50}C{\fn萝莉体 第二版\fs50}是...
Dialogue: 0,0:13:24.20,0:13:25.22,*Default,NTP,0,0,0,,將太
Dialogue: 0,0:13:25.27,0:13:26.23,*Default,NTP,0,0,0,,耶
Dialogue: 0,0:13:26.33,0:13:27.29,*Default,NTP,0,0,0,,以上
Dialogue: 0,0:13:27.80,0:13:30.75,*Default,NTP,0,0,0,,好 那差不多可以開始拍了吧
Dialogue: 0,0:13:31.29,0:13:33.24,*Default,NTP,0,0,0,,小町 準備好了嗎
Dialogue: 0,0:13:38.44,0:13:40.39,*Default,NTP,0,0,0,,拿著滑菇和番薯和蘋果吧
Dialogue: 0,0:13:41.02,0:13:41.76,*Default,NTP,0,0,0,,嗯
Dialogue: 0,0:13:42.57,0:13:46.20,*Default,NTP,0,0,0,,還有這個和這個
Dialogue: 0,0:13:47.08,0:13:48.12,*Default,NTP,0,0,0,,這什麼
Dialogue: 0,0:13:48.23,0:13:50.66,*Default,NTP,0,0,0,,嘛 就是一種畫面效果啦
Dialogue: 0,0:13:51.56,0:13:54.19,*Default,NTP,0,0,0,,千萬別讓手錶泡水了
Dialogue: 0,0:13:56.62,0:14:00.34,*Default,NTP,0,0,0,,那津 能用特寫拍那個手錶和眼鏡嗎
Dialogue: 0,0:14:00.66,0:14:01.45,*Default,NTP,0,0,0,,為什麼
Dialogue: 0,0:14:01.75,0:14:03.33,*Default,NTP,0,0,0,,一下子就行了 拜託你
Dialogue: 0,0:14:04.78,0:14:05.68,*Default,NTP,0,0,0,,我知道了
Dialogue: 0,0:14:06.16,0:14:07.48,*Default,NTP,0,0,0,,準備{\fn华康少女字体\fs50}OK{\fn萝莉体 第二版\fs50}了
Dialogue: 0,0:14:07.56,0:14:09.18,*Default,NTP,0,0,0,,導演 開始吧
Dialogue: 0,0:14:10.29,0:14:13.31,*Default,NTP,0,0,0,,場景1 手持名產跳舞的小町
Dialogue: 0,0:14:13.40,0:14:14.31,*Default,NTP,0,0,0,,{\fn华康少女字体\fs50}Take1
Dialogue: 0,0:14:14.79,0:14:16.29,*Default,NTP,0,0,0,,準備...
Dialogue: 0,0:14:15.22,0:14:19.96,*Default,NTP,0,0,0,,{\an8}準...備...
Dialogue: 0,0:14:20.37,0:14:22.79,*Default,NTP,0,0,0,,開始
Dialogue: 0,0:14:25.88,0:14:27.64,*Default,NTP,0,0,0,,動作大一點 小町
Dialogue: 0,0:14:29.22,0:14:31.70,*Default,NTP,0,0,0,,對對 很好 很好
Dialogue: 0,0:14:31.95,0:14:33.50,*Default,NTP,0,0,0,,很可愛喔 小町
Dialogue: 0,0:14:34.35,0:14:35.70,*Default,NTP,0,0,0,,用臉蹭蹭滑菇
Dialogue: 0,0:14:36.71,0:14:37.69,*Default,NTP,0,0,0,,真棒
Dialogue: 0,0:14:38.67,0:14:39.99,*Default,NTP,0,0,0,,真棒
Dialogue: 0,0:14:40.55,0:14:41.93,*Default,NTP,0,0,0,,真棒
Dialogue: 0,0:14:42.20,0:14:43.30,*Default,NTP,0,0,0,,真棒
Dialogue: 0,0:14:43.33,0:14:44.66,*Default,NTP,0,0,0,,給我等一下
Dialogue: 0,0:14:45.08,0:14:46.43,*Default,NTP,0,0,0,,{\fn华康少女字体\fs50}cut
Dialogue: 0,0:14:46.53,0:14:47.95,*Default,NTP,0,0,0,,怎麼了 小町
Dialogue: 0,0:14:48.57,0:14:51.30,*Default,NTP,0,0,0,,不覺得我這樣就只是一個傻孩子嗎
Dialogue: 0,0:14:54.48,0:14:56.83,*Default,NTP,0,0,0,,你那停頓是什麼意思
Dialogue: 0,0:14:57.16,0:14:59.00,*Default,NTP,0,0,0,,才沒這回事啦
Dialogue: 0,0:14:59.03,0:15:00.39,*Default,NTP,0,0,0,,很可愛喔
Dialogue: 0,0:15:00.61,0:15:01.97,*Default,NTP,0,0,0,,對吧 導演
Dialogue: 0,0:15:05.06,0:15:07.72,*Default,NTP,0,0,0,,真的能相信嗎
Dialogue: 0,0:15:08.77,0:15:09.79,*Default,NTP,0,0,0,,場景2
Dialogue: 0,0:15:09.86,0:15:11.66,*Default,NTP,0,0,0,,滑菇光滑好吃 {\fn华康少女字体\fs50}Take1
Dialogue: 0,0:15:11.95,0:15:14.04,*Default,NTP,0,0,0,,準備
Dialogue: 0,0:15:14.06,0:15:16.14,*Default,NTP,0,0,0,,開始
Dialogue: 0,0:15:17.39,0:15:19.28,*Default,NTP,0,0,0,,滑菇光滑好吃
Dialogue: 0,0:15:19.43,0:15:20.85,*Default,NTP,0,0,0,,番薯熱騰...
Dialogue: 0,0:15:19.47,0:15:20.98,*Default,NTP,0,0,0,,{\an8}蘋果清脆...
Dialogue: 0,0:15:22.22,0:15:23.64,*Default,NTP,0,0,0,,{\fn华康少女字体\fs50}cut
