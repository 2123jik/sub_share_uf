Dialogue: 0,0:00:01.00,0:00:09.00,zhu,,0,0,0,,{\fad(500,500)}本字幕由豌豆字幕组制作 仅供学习交流 禁止用于商业用途
Comment: 0,0:02:58.03,0:02:58.08,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:03:12.22,0:03:14.59,op-jp,,0,0,0,,緊急事態みたいだレスキュー
Dialogue: 0,0:03:14.59,0:03:17.30,op-jp,,0,0,0,,僕ら彷徨うわバッドサイレンス
Dialogue: 0,0:03:17.30,0:03:19.64,op-jp,,0,0,0,,会いたい人がいる天国
Dialogue: 0,0:03:19.64,0:03:22.35,op-jp,,0,0,0,,そっから僕たちはどう見える
Dialogue: 0,0:03:22.35,0:03:24.77,op-jp,,0,0,0,,何もかもおかしい時代で
Dialogue: 0,0:03:24.77,0:03:27.31,op-jp,,0,0,0,,ぎりぎりを踏み外さないで
Dialogue: 0,0:03:27.31,0:03:30.07,op-jp,,0,0,0,,しっかり手を繋いでいて
Dialogue: 0,0:03:30.07,0:03:32.57,op-jp,,0,0,0,,抱きしめる心許ない形を
Dialogue: 0,0:03:32.57,0:03:35.07,op-jp,,0,0,0,,青く燃やす炎は蜃気楼
Dialogue: 0,0:03:35.07,0:03:37.57,op-jp,,0,0,0,,手に増やす土産話を
Dialogue: 0,0:03:37.57,0:03:41.95,op-jp,,0,0,0,,君を思えば僕は
Dialogue: 0,0:03:41.95,0:03:42.58,op-jp,,0,0,0,,飛べ！
Dialogue: 0,0:03:42.58,0:03:46.17,op-jp,,0,0,0,,はじまりはそうだ　あくまでもいいからベイベー
Dialogue: 0,0:03:46.17,0:03:47.58,op-jp,,0,0,0,,手を貸して
Dialogue: 0,0:03:47.58,0:03:50.13,op-jp,,0,0,0,,責めるほど増えるヘイト
Dialogue: 0,0:03:50.13,0:03:52.45,op-jp,,0,0,0,,終われないんだよここで　
Dialogue: 0,0:03:52.45,0:03:57.43,op-jp,,0,0,0,,今僕が選ぶのはいつかで終わらぬ証明　venez m'aider
Dialogue: 0,0:03:57.43,0:04:00.21,op-jp,,0,0,0,,守りたい　見てみたいのは
Dialogue: 0,0:04:00.21,0:04:04.77,op-jp,,0,0,0,,絶やさない鼓動　未来への応答
Dialogue: 0,0:04:17.95,0:04:20.37,op-jp,,0,0,0,,緊急事態みたいだレスキュー
Dialogue: 0,0:04:20.37,0:04:22.95,op-jp,,0,0,0,,僕ら彷徨うわバッドサイレンス
Dialogue: 0,0:04:22.95,0:04:25.25,op-jp,,0,0,0,,会いたい君がいる現在地
Dialogue: 0,0:04:25.25,0:04:27.30,op-jp,,0,0,0,,今も聞こえるミュージック
Dialogue: 0,0:03:12.22,0:03:14.59,op-cn,,0,0,0,,求救信号宣告情况紧急
Dialogue: 0,0:03:14.59,0:03:17.30,op-cn,,0,0,0,,警告鸣响令人彷徨无措
Dialogue: 0,0:03:17.30,0:03:19.64,op-cn,,0,0,0,,思念之人远在天国
Dialogue: 0,0:03:19.64,0:03:22.35,op-cn,,0,0,0,,眼中的我们是何模样
Dialogue: 0,0:03:22.35,0:03:24.77,op-cn,,0,0,0,,在脱离常轨的时代
Dialogue: 0,0:03:24.77,0:03:27.31,op-cn,,0,0,0,,小心翼翼稳住脚步
Dialogue: 0,0:03:27.31,0:03:30.07,op-cn,,0,0,0,,我们紧紧牵着手
Dialogue: 0,0:03:30.07,0:03:32.57,op-cn,,0,0,0,,抱作一团瑟瑟发抖
Dialogue: 0,0:03:32.57,0:03:35.07,op-cn,,0,0,0,,燃烧的青焰如海市蜃楼
Dialogue: 0,0:03:35.07,0:03:37.57,op-cn,,0,0,0,,回忆越来越多
Dialogue: 0,0:03:37.57,0:03:41.95,op-cn,,0,0,0,,只要为了你 我便无所不能
Dialogue: 0,0:03:41.95,0:03:42.58,op-cn,,0,0,0,,飞吧！
Dialogue: 0,0:03:42.58,0:03:46.17,op-cn,,0,0,0,,起初都是这样 是恶魔也无妨 宝贝
Dialogue: 0,0:03:46.17,0:03:47.58,op-cn,,0,0,0,,把手给我
Dialogue: 0,0:03:47.58,0:03:50.13,op-cn,,0,0,0,,越是苛责 越是憎恨
Dialogue: 0,0:03:50.13,0:03:52.45,op-cn,,0,0,0,,不能止步于此
Dialogue: 0,0:03:52.45,0:03:57.43,op-cn,,0,0,0,,我们要选择的是永恒的证明 救救我
Dialogue: 0,0:03:57.43,0:04:00.21,op-cn,,0,0,0,,想要尝试去保护的是
Dialogue: 0,0:04:00.21,0:04:04.77,op-cn,,0,0,0,,不停歇的鼓动 给未来的回应
Dialogue: 0,0:04:17.95,0:04:20.37,op-cn,,0,0,0,,求救信号宣告情况紧急
Dialogue: 0,0:04:20.37,0:04:22.95,op-cn,,0,0,0,,警告鸣响令人彷徨无措
Dialogue: 0,0:04:22.95,0:04:25.25,op-cn,,0,0,0,,思念的你就在此处
Dialogue: 0,0:04:25.25,0:04:27.30,op-cn,,0,0,0,,音乐依旧回响不止
Comment: 0,0:22:05.01,0:22:05.01,ed-jp,,0,0,0,,==========ED==========
Dialogue: 0,0:22:15.97,0:22:19.58,ed-jp,,0,0,0,,{\blur5\fad(200,200)}描き出したストーリーが2人
Dialogue: 0,0:22:19.58,0:22:26.32,ed-jp,,0,0,0,,{\blur5\fad(200,200)}交わらせた意味は 未だにわからない
Dialogue: 0,0:22:26.89,0:22:30.63,ed-jp,,0,0,0,,{\blur5\fad(200,200)}そばにいてもひとりみたい
Dialogue: 0,0:22:30.63,0:22:37.17,ed-jp,,0,0,0,,{\blur5\fad(200,200)}いつの間に僕らは 離れてしまったの
Dialogue: 0,0:22:38.54,0:22:45.02,ed-jp,,0,0,0,,{\blur5\fad(200,200)}誰にも 見せぬまま 言えぬまま
Dialogue: 0,0:22:45.14,0:22:47.78,ed-jp,,0,0,0,,{\blur5\fad(200,200)}心は荒れ模様
Dialogue: 0,0:22:52.31,0:22:57.82,ed-jp,,0,0,0,,{\blur5\fad(200,200)}君の綺麗な 声が 祈りが
Dialogue: 0,0:22:57.82,0:23:03.32,ed-jp,,0,0,0,,{\blur5\fad(200,200)}僕の胸暴いて しまうからさ
Dialogue: 0,0:23:03.32,0:23:08.85,ed-jp,,0,0,0,,{\blur5\fad(200,200)}君の綺麗な 愛が 命が
Dialogue: 0,0:23:08.85,0:23:14.34,ed-jp,,0,0,0,,{\blur5\fad(200,200)}僕の目貫いて しまえばいい
Dialogue: 0,0:23:14.34,0:23:20.35,ed-jp,,0,0,0,,{\blur5\fad(200,200)}ただ生きてていいんだって 笑うから
Dialogue: 0,0:22:15.97,0:22:19.58,ed-cn,,0,0,0,,{\blur5\fad(200,200)}故事之中 是两个人
Dialogue: 0,0:22:19.58,0:22:26.32,ed-cn,,0,0,0,,{\blur5\fad(200,200)}至今仍不明白 为何会相识
Dialogue: 0,0:22:26.89,0:22:30.63,ed-cn,,0,0,0,,{\blur5\fad(200,200)}即使相伴 依旧孤独
Dialogue: 0,0:22:30.63,0:22:37.17,ed-cn,,0,0,0,,{\blur5\fad(200,200)}不知不觉中 我们渐行渐远
Dialogue: 0,0:22:38.54,0:22:45.02,ed-cn,,0,0,0,,{\blur5\fad(200,200)}不愿向人展露 不愿对人倾诉
Dialogue: 0,0:22:45.14,0:22:47.78,ed-cn,,0,0,0,,{\blur5\fad(200,200)}内心乱作一团
Dialogue: 0,0:22:52.31,0:22:57.82,ed-cn,,0,0,0,,{\blur5\fad(200,200)}你那柔美的声音与祈祷
Dialogue: 0,0:22:57.82,0:23:03.32,ed-cn,,0,0,0,,{\blur5\fad(200,200)}将我的内心 揭露无遗
Dialogue: 0,0:23:03.32,0:23:08.85,ed-cn,,0,0,0,,{\blur5\fad(200,200)}你那绚丽的爱与生命
Dialogue: 0,0:23:08.85,0:23:14.34,ed-cn,,0,0,0,,{\blur5\fad(200,200)}只希望它们 贯穿我的眼
Dialogue: 0,0:23:14.34,0:23:20.35,ed-cn,,0,0,0,,{\blur5\fad(200,200)}我会笑着说 你只要活着就好
