Dialogue: 0,0:00:01.00,0:00:09.00,zhu,,0,0,0,,{\fad(500,500)}本字幕由豌豆字幕組製作 僅供學習交流 禁止用於商業用途
Comment: 0,0:00:14.99,0:00:15.04,op-jp,,0,0,0,,==========OP==========
Dialogue: 0,0:00:29.18,0:00:31.55,op-jp,,0,0,0,,緊急事態みたいだレスキュー
Dialogue: 0,0:00:31.55,0:00:34.26,op-jp,,0,0,0,,僕ら彷徨うわバッドサイレンス
Dialogue: 0,0:00:34.26,0:00:36.60,op-jp,,0,0,0,,会いたい人がいる天国
Dialogue: 0,0:00:36.60,0:00:39.31,op-jp,,0,0,0,,そっから僕たちはどう見える
Dialogue: 0,0:00:39.31,0:00:41.73,op-jp,,0,0,0,,何もかもおかしい時代で
Dialogue: 0,0:00:41.73,0:00:44.27,op-jp,,0,0,0,,ぎりぎりを踏み外さないで
Dialogue: 0,0:00:44.27,0:00:47.03,op-jp,,0,0,0,,しっかり手を繋いでいて
Dialogue: 0,0:00:47.03,0:00:49.53,op-jp,,0,0,0,,抱きしめる心許ない形を
Dialogue: 0,0:00:49.53,0:00:52.03,op-jp,,0,0,0,,青く燃やす炎は蜃気楼
Dialogue: 0,0:00:52.03,0:00:54.53,op-jp,,0,0,0,,手に増やす土産話を
Dialogue: 0,0:00:54.53,0:00:58.91,op-jp,,0,0,0,,君を思えば僕は
Dialogue: 0,0:00:58.91,0:00:59.54,op-jp,,0,0,0,,飛べ！
Dialogue: 0,0:00:59.54,0:01:03.13,op-jp,,0,0,0,,はじまりはそうだ　あくまでもいいからベイベー
Dialogue: 0,0:01:03.13,0:01:04.54,op-jp,,0,0,0,,手を貸して
Dialogue: 0,0:01:04.54,0:01:07.09,op-jp,,0,0,0,,責めるほど増えるヘイト
Dialogue: 0,0:01:07.09,0:01:09.41,op-jp,,0,0,0,,終われないんだよここで　
Dialogue: 0,0:01:09.41,0:01:14.39,op-jp,,0,0,0,,今僕が選ぶのはいつかで終わらぬ証明　venez m'aider
Dialogue: 0,0:01:14.39,0:01:17.17,op-jp,,0,0,0,,守りたい　見てみたいのは
Dialogue: 0,0:01:17.17,0:01:21.73,op-jp,,0,0,0,,絶やさない鼓動　未来への応答
Dialogue: 0,0:01:34.91,0:01:37.33,op-jp,,0,0,0,,緊急事態みたいだレスキュー
Dialogue: 0,0:01:37.33,0:01:39.91,op-jp,,0,0,0,,僕ら彷徨うわバッドサイレンス
Dialogue: 0,0:01:39.91,0:01:42.21,op-jp,,0,0,0,,会いたい君がいる現在地
Dialogue: 0,0:01:42.21,0:01:44.26,op-jp,,0,0,0,,今も聞こえるミュージック
Dialogue: 0,0:00:29.18,0:00:31.55,op-cn,,0,0,0,,求救信號宣告情況緊急
Dialogue: 0,0:00:31.55,0:00:34.26,op-cn,,0,0,0,,警告鳴響令人彷徨無措
Dialogue: 0,0:00:34.26,0:00:36.60,op-cn,,0,0,0,,思念之人遠在天國
Dialogue: 0,0:00:36.60,0:00:39.31,op-cn,,0,0,0,,眼中的我們是何模樣
Dialogue: 0,0:00:39.31,0:00:41.73,op-cn,,0,0,0,,在脫離常軌的時代
Dialogue: 0,0:00:41.73,0:00:44.27,op-cn,,0,0,0,,小心翼翼穩住腳步
Dialogue: 0,0:00:44.27,0:00:47.03,op-cn,,0,0,0,,我們緊緊牽著手
Dialogue: 0,0:00:47.03,0:00:49.53,op-cn,,0,0,0,,抱作一團瑟瑟發抖
Dialogue: 0,0:00:49.53,0:00:52.03,op-cn,,0,0,0,,燃燒的青焰如海市蜃樓
Dialogue: 0,0:00:52.03,0:00:54.53,op-cn,,0,0,0,,回憶越來越多
Dialogue: 0,0:00:54.53,0:00:58.91,op-cn,,0,0,0,,只要為了你 我便無所不能
Dialogue: 0,0:00:58.91,0:00:59.54,op-cn,,0,0,0,,飛吧！
Dialogue: 0,0:00:59.54,0:01:03.13,op-cn,,0,0,0,,起初都是這樣 是惡魔也無妨 寶貝
Dialogue: 0,0:01:03.13,0:01:04.54,op-cn,,0,0,0,,把手給我
Dialogue: 0,0:01:04.54,0:01:07.09,op-cn,,0,0,0,,越是苛責 越是憎恨
Dialogue: 0,0:01:07.09,0:01:09.41,op-cn,,0,0,0,,不能止步於此
Dialogue: 0,0:01:09.41,0:01:14.39,op-cn,,0,0,0,,我們要選擇的是永恆的證明 救救我
Dialogue: 0,0:01:14.39,0:01:17.17,op-cn,,0,0,0,,想要嘗試去保護的是
Dialogue: 0,0:01:17.17,0:01:21.73,op-cn,,0,0,0,,不停歇的鼓動 給未來的回應
Dialogue: 0,0:01:34.91,0:01:37.33,op-cn,,0,0,0,,求救信號宣告情況緊急
Dialogue: 0,0:01:37.33,0:01:39.91,op-cn,,0,0,0,,警告鳴響令人彷徨無措
Dialogue: 0,0:01:39.91,0:01:42.21,op-cn,,0,0,0,,思念的你就在此處
Dialogue: 0,0:01:42.21,0:01:44.26,op-cn,,0,0,0,,音樂依舊迴響不止
