Dialogue: 0,0:02:32.13,0:02:36.64,Title_CHS,,0,0,0,,{\fad(200,350)\blur5\pos(80,511)}第2话\N雪屋里边贼拉可爱
Dialogue: 4,0:00:01.67,0:00:03.23,Dial_JP,,0,0,0,,めんこいのできた
Dialogue: 4,0:00:03.39,0:00:04.86,Dial_JP,,0,0,0,,ストーリーあげよ
Dialogue: 4,0:00:11.31,0:00:12.88,Dial_JP,,0,0,0,,イイ感じに盛れて
Dialogue: 4,0:00:17.53,0:00:19.08,Dial_JP,,0,0,0,,なぁに見てんの
Dialogue: 4,0:00:20.26,0:00:23.35,Dial_JP,,0,0,0,,ちょっ　耳　不意打ちはダメだって
Dialogue: 4,0:00:25.24,0:00:27.80,Dial_JP,,0,0,0,,なっつ　冬まつりじゃん
Dialogue: 4,0:00:28.63,0:00:31.12,Dial_JP,,0,0,0,,何　翼　興味あんの
Dialogue: 4,0:00:31.12,0:00:35.16,Dial_JP,,0,0,0,,今週末だし　いい機会だから　行ってみようかなって
Dialogue: 4,0:00:36.16,0:00:37.81,Dial_JP,,0,0,0,,今週末
Dialogue: 4,0:00:38.92,0:00:41.59,Dial_JP,,0,0,0,,まったく　しようがないなぁ　翼は
Dialogue: 4,0:00:42.37,0:00:43.82,Dial_JP,,0,0,0,,そこまで言うなら
Dialogue: 4,0:00:44.23,0:00:46.13,Dial_JP,,0,0,0,,ウチが一緒に行ったげる
Dialogue: 4,0:00:46.58,0:00:48.64,Dial_JP,,0,0,0,,俺そこまで言ったかな
Dialogue: 4,0:00:51.50,0:00:52.60,Dial_JP,,0,0,0,,これって
Dialogue: 4,0:00:53.30,0:00:54.60,Dial_JP,,0,0,0,,デート？
Dialogue: 4,0:02:30.36,0:02:31.67,Dial_JP,,0,0,0,,うまー
Dialogue: 4,0:02:31.94,0:02:33.69,Dial_JP,,500,0,0,,ワチ　この餅好き
Dialogue: 4,0:02:33.69,0:02:36.65,Dial_JP,,500,0,0,,芋餅ね　こっちはチーズ入りだよ
Dialogue: 4,0:02:36.65,0:02:39.51,Dial_JP,,0,0,0,,やった　チーズ　チーズ
Dialogue: 4,0:02:41.52,0:02:43.00,Dial_JP,,0,0,0,,はい　カツゲン
Dialogue: 4,0:02:43.00,0:02:44.06,Dial_JP,,0,0,0,,あんがと
Dialogue: 4,0:02:46.95,0:02:48.52,Dial_JP,,0,0,0,,パパ遅いね
Dialogue: 4,0:02:48.74,0:02:50.56,Dial_JP,,0,0,0,,週末だからね
Dialogue: 4,0:02:51.13,0:02:54.94,Dial_JP,,0,0,0,,でも明日はお休みだし　みんなでお出かけしよっか
Dialogue: 4,0:02:54.94,0:02:56.48,Dial_JP,,0,0,0,,ワチ　スケート行きたい
Dialogue: 4,0:02:56.48,0:02:58.13,Dial_JP,,0,0,0,,おけおけー
Dialogue: 4,0:02:58.13,0:02:59.45,Dial_JP,,0,0,0,,みーも行かない
Dialogue: 4,0:03:03.16,0:03:04.68,Dial_JP,,0,0,0,,ウチはパス
Dialogue: 4,0:03:04.68,0:03:07.25,Dial_JP,,0,0,0,,明日は友達と冬まつり行くんだ
Dialogue: 4,0:03:08.07,0:03:10.54,Dial_JP,,0,0,0,,みー姉　明日行けないの
Dialogue: 4,0:03:10.54,0:03:11.92,Dial_JP,,0,0,0,,ごめんね　もも
Dialogue: 4,0:03:11.92,0:03:13.66,Dial_JP,,0,0,0,,冬まつりかぁ
Dialogue: 4,0:03:13.66,0:03:16.93,Dial_JP,,0,0,0,,たしかみーが小学生のときよく行ってたっけ
Dialogue: 4,0:03:19.06,0:03:21.15,Dial_JP,,0,0,0,,みおちゃんたちも行くって言ってた
Dialogue: 4,0:03:21.81,0:03:22.91,Dial_JP,,0,0,0,,ただいま
Dialogue: 4,0:03:23.65,0:03:25.36,Dial_JP,,0,0,0,,おかえり
Dialogue: 4,0:03:37.33,0:03:39.60,Dial_JP,,0,0,0,,今日も一段と寒いなぁ
Dialogue: 4,0:03:41.11,0:03:44.23,Dial_JP,,0,0,0,,明日は11時北見駅前に集合ね
Dialogue: 4,0:03:44.23,0:03:45.37,Dial_JP,,0,0,0,,したっけおやすみ
Dialogue: 4,0:03:45.79,0:03:48.94,Dial_JP,,0,0,0,,まさかホントに一緒に行くことになるとは
Dialogue: 4,0:03:49.23,0:03:52.77,Dial_JP,,0,0,0,,２人で祭りって　完全にデートなのでは
Dialogue: 4,0:03:53.16,0:03:55.26,Dial_JP,,0,0,0,,だってこんな顔文字ついてるし
Dialogue: 4,0:03:55.82,0:03:56.85,Dial_JP,,0,0,0,,おまけに
Dialogue: 4,0:04:00.59,0:04:01.41,Dial_JP,,0,0,0,,ダメだ
Dialogue: 4,0:04:01.66,0:04:05.02,Dial_JP,,0,0,0,,会う前からこんな調子じゃ生きて帰れる気がしない
Dialogue: 4,0:04:05.66,0:04:10.19,Dial_JP,,0,0,0,,よしっ　今日は　純粋に北海道の初イベントを満喫しよう
Dialogue: 4,0:04:10.77,0:04:12.61,Dial_JP,,0,0,0,,それに冬木さんだって
Dialogue: 4,0:04:13.06,0:04:17.42,Dial_JP,,0,0,0,,友達の少ない俺を気遣って誘ってくれただけかもしれないんだし
Dialogue: 4,0:04:24.01,0:04:25.89,Dial_JP,,0,0,0,,お待たせ　翼
Dialogue: 4,0:04:36.39,0:04:37.59,Dial_JP,,0,0,0,,やほ
Dialogue: 4,0:04:37.59,0:04:39.98,Dial_JP,,0,0,0,,なんて攻撃力してるんだ
Dialogue: 4,0:04:39.98,0:04:43.57,Dial_JP,,0,0,0,,冬木さん　外だと私服そんな感じなんだね
Dialogue: 4,0:04:43.57,0:04:46.92,Dial_JP,,0,0,0,,ふだんラフだから露出の低さが逆にヤバい
Dialogue: 4,0:04:47.41,0:04:50.90,Dial_JP,,0,0,0,,そっか　オフに外で会うの初めてだもんね
Dialogue: 4,0:04:51.42,0:04:52.73,Dial_JP,,0,0,0,,かわいいでしょ
Dialogue: 4,0:04:54.70,0:04:56.74,Dial_JP,,0,0,0,,はい　とっても
Dialogue: 4,0:04:58.03,0:05:00.15,Dial_JP,,0,0,0,,何その　言わされた感
Dialogue: 4,0:05:00.15,0:05:01.44,Dial_JP,,0,0,0,,ショック
Dialogue: 4,0:05:02.57,0:05:05.96,Dial_JP,,0,0,0,,そ　そういえば冬木さんは冬まつり来るの
Dialogue: 4,0:05:05.96,0:05:07.74,Dial_JP,,0,0,0,,小学生以来なんだよね
Dialogue: 4,0:05:07.74,0:05:10.03,Dial_JP,,0,0,0,,そだよー　なまら久々
Dialogue: 4,0:05:10.70,0:05:13.90,Dial_JP,,0,0,0,,雪像とか　氷の彫刻もあるんでしょ
Dialogue: 4,0:05:13.90,0:05:16.50,Dial_JP,,0,0,0,,北海道ならではって感じだよね
Dialogue: 4,0:05:16.50,0:05:19.70,Dial_JP,,0,0,0,,あとは名物の屋台もいろいろと調べてきて
Dialogue: 4,0:05:20.14,0:05:21.68,Dial_JP,,0,0,0,,楽しみだなぁ
Dialogue: 4,0:05:21.99,0:05:25.14,Dial_JP,,0,0,0,,そんなに期待しないほうがいいかもよ
Dialogue: 4,0:05:25.99,0:05:27.04,Dial_JP,,0,0,0,,何か言った
Dialogue: 4,0:05:27.46,0:05:28.61,Dial_JP,,0,0,0,,なんも
Dialogue: 4,0:05:28.81,0:05:30.17,Dial_JP,,0,0,0,,したっけ行こ
Dialogue: 4,0:05:52.22,0:05:54.50,Dial_JP,,0,0,0,,こんな感じだけど　どうか…
Dialogue: 4,0:05:55.18,0:05:56.88,Dial_JP,,0,0,0,,すごいよ　冬木さん
Dialogue: 4,0:05:56.88,0:05:58.26,Dial_JP,,0,0,0,,早く見に行こう
Dialogue: 4,0:05:59.82,0:06:01.08,Dial_JP,,0,0,0,,オッケー
Dialogue: 4,0:06:05.44,0:06:07.08,Dial_JP,,0,0,0,,雪像　でっか
Dialogue: 4,0:06:07.08,0:06:09.37,Dial_JP,,0,0,0,,昔はもっと大きかったような
Dialogue: 4,0:06:09.37,0:06:11.55,Dial_JP,,0,0,0,,冬木さんが成長したんじゃない
Dialogue: 4,0:06:11.55,0:06:12.97,Dial_JP,,0,0,0,,写真撮ろっと
Dialogue: 4,0:06:13.20,0:06:13.98,Dial_JP,,0,0,0,,いいね
Dialogue: 4,0:06:14.22,0:06:15.15,Dial_JP,,0,0,0,,したっけさ
Dialogue: 4,0:06:15.97,0:06:18.19,Dial_JP,,0,0,0,,こうすればもっとよきじゃん
Dialogue: 4,0:06:18.54,0:06:18.86,Dial_JP,,0,0,0,,ちょ
Dialogue: 4,0:06:21.64,0:06:23.11,Dial_JP,,0,0,0,,めっちゃいい匂い
Dialogue: 4,0:06:25.84,0:06:28.86,Dial_JP,,0,0,0,,翼の目　半開きなんだけど　ウケる
Dialogue: 4,0:06:29.87,0:06:32.19,Dial_JP,,0,0,0,,はずいって　消してよ
Dialogue: 4,0:06:32.63,0:06:33.78,Dial_JP,,0,0,0,,この匂い
Dialogue: 4,0:06:33.78,0:06:35.18,Dial_JP,,0,0,0,,ちょっと聞いてる
Dialogue: 4,0:06:35.56,0:06:37.39,Dial_JP,,0,0,0,,翼　おなかすいてない
Dialogue: 4,0:06:38.38,0:06:39.46,Dial_JP,,0,0,0,,まぁ　うん
Dialogue: 4,0:06:43.28,0:06:44.56,Dial_JP,,0,0,0,,何かけますか
Dialogue: 4,0:06:44.56,0:06:45.71,Dial_JP,,0,0,0,,お砂糖
Dialogue: 4,0:06:45.71,0:06:46.55,Dial_JP,,0,0,0,,私も
Dialogue: 4,0:06:50.52,0:06:52.91,Dial_JP,,0,0,0,,フ…　フレンチドッグを１つ
Dialogue: 4,0:06:52.91,0:06:54.76,Dial_JP,,0,0,0,,はいよ　何かけます
Dialogue: 4,0:06:55.98,0:06:57.03,Dial_JP,,0,0,0,,砂糖で
Dialogue: 4,0:06:59.81,0:07:01.89,Dial_JP,,0,0,0,,焼き鳥おいひぃ
Dialogue: 4,0:07:02.37,0:07:04.44,Dial_JP,,0,0,0,,次は何食べよっかなぁ
Dialogue: 4,0:07:04.44,0:07:06.23,Dial_JP,,0,0,0,,ごめん　お待たせ
Dialogue: 4,0:07:06.23,0:07:07.43,Dial_JP,,0,0,0,,おかえり
Dialogue: 4,0:07:12.27,0:07:15.58,Dial_JP,,0,0,0,,ねぇ　翼のフレンチドッグも一口ちょうだい
Dialogue: 4,0:07:16.49,0:07:17.53,Dial_JP,,0,0,0,,いいけど
Dialogue: 4,0:07:29.18,0:07:30.64,Dial_JP,,0,0,0,,おいひぃ
Dialogue: 4,0:07:30.64,0:07:32.59,Dial_JP,,0,0,0,,よ…　よかったよ
Dialogue: 4,0:07:33.02,0:07:35.53,Dial_JP,,0,0,0,,なんだろ　この背徳感は
Dialogue: 4,0:07:36.05,0:07:39.84,Dial_JP,,0,0,0,,しかも　冬木さんの食べかけを俺が…
Dialogue: 4,0:07:40.10,0:07:41.09,Dial_JP,,0,0,0,,これって
Dialogue: 4,0:07:42.06,0:07:43.40,Dial_JP,,0,0,0,,間接キ…
Dialogue: 4,0:07:44.54,0:07:46.00,Dial_JP,,0,0,0,,いやいや　意識すんな
Dialogue: 4,0:07:46.00,0:07:47.62,Dial_JP,,0,0,0,,もう高校生だぞ
Dialogue: 4,0:07:47.88,0:07:49.91,Dial_JP,,0,0,0,,ふだんどおりに食えばいい
Dialogue: 4,0:07:51.87,0:07:53.70,Dial_JP,,0,0,0,,よっ　よし　食えた
Dialogue: 4,0:07:56.70,0:07:58.33,Dial_JP,,0,0,0,,なっ　なに
Dialogue: 4,0:07:58.33,0:08:00.20,Dial_JP,,0,0,0,,いやぁ　別に
Dialogue: 4,0:08:00.49,0:08:03.92,Dial_JP,,0,0,0,,みんな翼くらいわかりやすかったらかわいいのにね
Dialogue: 4,0:08:04.60,0:08:06.39,Dial_JP,,0,0,0,,絶対からかってるじゃん
Dialogue: 4,0:08:06.59,0:08:08.29,Dial_JP,,0,0,0,,したっけ　次行こう
Dialogue: 4,0:08:08.93,0:08:10.27,Dial_JP,,0,0,0,,待って　冬木さん
Dialogue: 4,0:08:23.98,0:08:24.54,Dial_JP,,0,0,0,,はい
Dialogue: 4,0:08:25.23,0:08:27.20,Dial_JP,,0,0,0,,温かい甘酒配ってた
Dialogue: 4,0:08:27.69,0:08:28.86,Dial_JP,,0,0,0,,あんがと
Dialogue: 4,0:08:30.09,0:08:31.46,Dial_JP,,0,0,0,,冬まつりはどお
Dialogue: 4,0:08:31.79,0:08:34.49,Dial_JP,,0,0,0,,こんなに雪とか氷があるってすごい
Dialogue: 4,0:08:34.49,0:08:37.16,Dial_JP,,0,0,0,,なまら語彙力なくて　ウケる
Dialogue: 4,0:08:40.79,0:08:43.15,Dial_JP,,0,0,0,,俺はずっと東京に住んでたから
Dialogue: 4,0:08:43.40,0:08:44.88,Dial_JP,,0,0,0,,余計感じるんだ
Dialogue: 4,0:08:45.98,0:08:50.10,Dial_JP,,0,0,0,,同じ日本でも　こんなに景色が違うんだなって
Dialogue: 4,0:08:53.34,0:08:56.10,Dial_JP,,0,0,0,,今日はありがとう　すごい楽しかったよ
Dialogue: 4,0:08:56.49,0:08:58.37,Dial_JP,,0,0,0,,冬木さんと来れてよかった
Dialogue: 4,0:09:06.74,0:09:09.53,Dial_JP,,0,0,0,,実は今日ちょっと心配だったんだぁ
Dialogue: 4,0:09:10.24,0:09:10.91,Dial_JP,,0,0,0,,どうして
Dialogue: 4,0:09:11.10,0:09:14.33,Dial_JP,,0,0,0,,いやぁ　ウチが最後に冬まつり行ったの
Dialogue: 4,0:09:14.33,0:09:16.17,Dial_JP,,0,0,0,,小学生のころだからさ
Dialogue: 4,0:09:16.49,0:09:20.25,Dial_JP,,0,0,0,,あんときは楽しめたけど　今は楽しめるかなぁとか
Dialogue: 4,0:09:20.91,0:09:24.74,Dial_JP,,0,0,0,,翼にこんなもんかってガッカリされないかなとかさ
Dialogue: 4,0:09:27.83,0:09:30.92,Dial_JP,,0,0,0,,だけどぜんぜん要らない心配だったし
Dialogue: 4,0:09:31.61,0:09:36.68,Dial_JP,,0,0,0,,翼と一緒にいたら　北海道がもっと好きになった
Dialogue: 4,0:09:37.32,0:09:40.10,Dial_JP,,0,0,0,,ここはちゃんといい街なんだなって
Dialogue: 4,0:09:40.84,0:09:44.25,Dial_JP,,0,0,0,,翼が楽しそうだとなんかうれしくなるんだよね
Dialogue: 4,0:09:44.63,0:09:47.46,Dial_JP,,0,0,0,,ウチも翼と冬まつりに来てよかった
Dialogue: 4,0:09:50.80,0:09:53.32,Dial_JP,,0,0,0,,あんまり自覚してなかったけど
Dialogue: 4,0:09:53.57,0:09:56.82,Dial_JP,,0,0,0,,ウチって地元愛なまら強いかも
Dialogue: 4,0:10:00.04,0:10:00.73,Dial_JP,,0,0,0,,あぶねっ
Dialogue: 4,0:10:16.50,0:10:17.28,Dial_JP,,0,0,0,,えっと
Dialogue: 4,0:10:17.28,0:10:19.15,Dial_JP,,0,0,0,,ごごごごめん
Dialogue: 4,0:10:19.15,0:10:21.19,Dial_JP,,0,0,0,,とっさに　いや　うん
Dialogue: 4,0:10:21.48,0:10:23.37,Dial_JP,,0,0,0,,だっ　大丈夫
Dialogue: 4,0:10:24.91,0:10:26.03,Dial_JP,,0,0,0,,あんがと
Dialogue: 4,0:10:30.51,0:10:31.50,Dial_JP,,0,0,0,,冬木さん
Dialogue: 4,0:10:33.01,0:10:34.69,Dial_JP,,0,0,0,,もしよかったらだけど
Dialogue: 4,0:10:34.99,0:10:37.60,Dial_JP,,0,0,0,,また今度２人でどっか行こっか
Dialogue: 4,0:10:43.36,0:10:47.17,Dial_JP,,0,0,0,,何　そんなにウチと２人っきりで遊びたいのぉ
Dialogue: 4,0:10:47.34,0:10:48.46,Dial_JP,,0,0,0,,いっ　いや
Dialogue: 4,0:10:48.92,0:10:51.38,Dial_JP,,0,0,0,,別に２人じゃなくてもいいけど
Dialogue: 4,0:10:52.89,0:10:56.20,Dial_JP,,0,0,0,,いつか札幌の雪まつりとか行きたいね
Dialogue: 4,0:10:57.73,0:10:58.38,Dial_JP,,0,0,0,,うん
Dialogue: 4,0:11:12.48,0:11:14.42,Dial_JP,,0,0,0,,お弁当一緒に食べよ
Dialogue: 4,0:11:15.70,0:11:19.22,Dial_JP,,0,0,0,,今日は翼に食べさせたいもの持ってきたからね
Dialogue: 4,0:11:19.42,0:11:20.16,Dial_JP,,0,0,0,,俺に？
Dialogue: 4,0:11:20.40,0:11:21.64,Dial_JP,,0,0,0,,ジャーン
Dialogue: 4,0:11:23.24,0:11:24.79,Dial_JP,,0,0,0,,何これ　カップ麺
Dialogue: 4,0:11:25.00,0:11:27.97,Dial_JP,,0,0,0,,たまぁにカップ麺　学校で食べるとさぁ
Dialogue: 4,0:11:28.19,0:11:31.02,Dial_JP,,0,0,0,,なんでかいつもよりうまいんだよねぇ
Dialogue: 4,0:11:32.04,0:11:34.93,Dial_JP,,0,0,0,,東京のほうにはあんまりやき弁ってないっしょ
Dialogue: 4,0:11:35.90,0:11:39.15,Dial_JP,,0,0,0,,もしかしてこれ　俺のために買ってきてくれたの
Dialogue: 4,0:11:39.15,0:11:41.79,Dial_JP,,0,0,0,,だってこの前の翼の反応見てたら
Dialogue: 4,0:11:41.79,0:11:45.10,Dial_JP,,0,0,0,,もっと北海道グルメ食べさせたいってなったんだもん
Dialogue: 4,0:11:46.52,0:11:48.98,Dial_JP,,0,0,0,,形容し難い恥ずかしさが…
Dialogue: 4,0:11:50.09,0:11:52.39,Dial_JP,,0,0,0,,魔法瓶に熱湯を入れてきたんだね
Dialogue: 4,0:11:52.39,0:11:54.93,Dial_JP,,0,0,0,,そそ　あとは３分待つだけ
Dialogue: 4,0:11:55.70,0:11:57.61,Dial_JP,,0,0,0,,はーい　オッケー
Dialogue: 4,0:11:57.80,0:12:00.07,Dial_JP,,0,0,0,,あっという間に出来ちゃうんだね
Dialogue: 4,0:12:00.07,0:12:02.13,Dial_JP,,0,0,0,,こっからがミソなんだよ
Dialogue: 4,0:12:03.45,0:12:07.33,Dial_JP,,0,0,0,,やき弁には中華スープの粉も一緒に入ってて
Dialogue: 4,0:12:07.73,0:12:11.30,Dial_JP,,0,0,0,,捨てるお湯をそのままスープにするんだよぉ
Dialogue: 4,0:12:11.74,0:12:13.38,Dial_JP,,0,0,0,,おもしろい発想だね
Dialogue: 4,0:12:14.06,0:12:15.87,Dial_JP,,0,0,0,,完成
Dialogue: 4,0:12:16.56,0:12:18.47,Dial_JP,,0,0,0,,なんというジャンク感
Dialogue: 4,0:12:18.76,0:12:24.01,Dial_JP,,0,0,0,,だがしかし　食欲に訴えかけてくるこの暴力的な見た目と香り
Dialogue: 4,0:12:27.01,0:12:28.68,Dial_JP,,0,0,0,,はい　あ～ん
Dialogue: 4,0:12:30.05,0:12:31.56,Dial_JP,,0,0,0,,急なあ～ん
Dialogue: 4,0:12:35.63,0:12:36.56,Dial_JP,,0,0,0,,おいしい
Dialogue: 4,0:12:38.64,0:12:40.38,Dial_JP,,0,0,0,,メチャクチャおいしい
Dialogue: 4,0:12:40.38,0:12:42.53,Dial_JP,,0,0,0,,でしょお　よかったぁ
Dialogue: 4,0:12:42.69,0:12:44.59,Dial_JP,,0,0,0,,麺の歯応えがしっかりしてて
Dialogue: 4,0:12:44.59,0:12:48.03,Dial_JP,,0,0,0,,キャベツとかの具もソースに絡んでて　すごいおいしいよ
Dialogue: 4,0:12:49.84,0:12:52.23,Dial_JP,,0,0,0,,これで冬まつりのお返しできたね
Dialogue: 4,0:12:53.56,0:12:54.71,Dial_JP,,0,0,0,,あのときの
Dialogue: 4,0:12:56.08,0:12:59.12,Dial_JP,,0,0,0,,ちょっと翼　顔赤くなってんだけど
Dialogue: 4,0:12:59.12,0:13:01.06,Dial_JP,,0,0,0,,思い出して興奮したの
Dialogue: 4,0:13:01.06,0:13:01.68,Dial_JP,,0,0,0,,ちがっ
Dialogue: 4,0:13:01.90,0:13:03.92,Dial_JP,,0,0,0,,これはやきそばが熱くて
Dialogue: 4,0:13:03.92,0:13:05.91,Dial_JP,,0,0,0,,ってか　翼のお弁当は
Dialogue: 4,0:13:05.91,0:13:07.41,Dial_JP,,0,0,0,,見たい　見して
Dialogue: 4,0:13:08.30,0:13:10.19,Dial_JP,,0,0,0,,普通の弁当だけど
Dialogue: 4,0:13:10.51,0:13:11.75,Dial_JP,,0,0,0,,こんな感じの
Dialogue: 4,0:13:14.54,0:13:16.53,Dial_JP,,0,0,0,,お…　お正月
Dialogue: 4,0:13:17.25,0:13:19.31,Dial_JP,,0,0,0,,ヤバ　写真撮っていい
Dialogue: 4,0:13:19.31,0:13:20.51,Dial_JP,,0,0,0,,いいけど
Dialogue: 4,0:13:20.51,0:13:23.51,Dial_JP,,0,0,0,,俺の弁当ってそんなに変なのか
Dialogue: 4,0:13:23.80,0:13:25.31,Dial_JP,,0,0,0,,冬木さんも食べる
Dialogue: 4,0:13:25.82,0:13:28.25,Dial_JP,,0,0,0,,マジいいの　食べたい食べたい
Dialogue: 4,0:13:28.63,0:13:31.67,Dial_JP,,0,0,0,,したっけ　このお肉いただきまーす
Dialogue: 4,0:13:34.58,0:13:36.71,Dial_JP,,0,0,0,,なまらうまいんだけど
Dialogue: 4,0:13:37.40,0:13:40.39,Dial_JP,,0,0,0,,何このお肉　トロトロのフワフワ
Dialogue: 4,0:13:40.39,0:13:41.46,Dial_JP,,0,0,0,,誰が作ったの
Dialogue: 4,0:13:41.46,0:13:43.38,Dial_JP,,0,0,0,,神　神の肉
Dialogue: 4,0:13:43.38,0:13:46.37,Dial_JP,,0,0,0,,俺のおばあちゃんが作った豚の角煮だよ
Dialogue: 4,0:13:46.81,0:13:48.61,Dial_JP,,0,0,0,,すご　どうしよう
Dialogue: 4,0:13:48.61,0:13:50.79,Dial_JP,,0,0,0,,翼のおばあちゃまと結婚したい
Dialogue: 4,0:13:50.79,0:13:51.98,Dial_JP,,0,0,0,,どゆこと
Dialogue: 4,0:13:52.76,0:13:55.65,Dial_JP,,0,0,0,,いやぁ　ホントに最高
Dialogue: 4,0:13:55.65,0:13:56.73,Dial_JP,,0,0,0,,ありがとね
Dialogue: 4,0:13:56.93,0:14:00.01,Dial_JP,,0,0,0,,こちらこそ　焼きそば弁当おいしかったよ
Dialogue: 4,0:14:00.01,0:14:01.22,Dial_JP,,0,0,0,,ごちそうさまでした
Dialogue: 4,0:14:01.78,0:14:04.33,Dial_JP,,0,0,0,,生まれて初めてカップ麵食べたけど
Dialogue: 4,0:14:04.33,0:14:06.36,Dial_JP,,0,0,0,,こんなにおいしいものなんだね
Dialogue: 4,0:14:06.75,0:14:09.27,Dial_JP,,0,0,0,,冬木さんといると初めてだらけだよ
Dialogue: 4,0:14:10.87,0:14:13.80,Dial_JP,,0,0,0,,今　カップ麺食べたことないってゆった？
Dialogue: 4,0:14:14.97,0:14:16.56,Dial_JP,,0,0,0,,ちょ　ちょっと待って待って
Dialogue: 4,0:14:16.56,0:14:19.38,Dial_JP,,0,0,0,,あと何　初めてのことだらけってゆったよね
Dialogue: 4,0:14:19.83,0:14:24.46,Dial_JP,,0,0,0,,えっと　じょ　女子の家に行ったのも初めてだし
Dialogue: 4,0:14:24.79,0:14:26.44,Dial_JP,,0,0,0,,コンビニで買い食いとか
Dialogue: 4,0:14:27.13,0:14:30.78,Dial_JP,,0,0,0,,あと　友達とお祭りに行ったことも今までなかったけど
Dialogue: 4,0:14:32.10,0:14:33.01,Dial_JP,,0,0,0,,マジ
Dialogue: 4,0:14:34.06,0:14:37.17,Dial_JP,,0,0,0,,今の話といい　さっきのお弁当といい
Dialogue: 4,0:14:37.17,0:14:38.76,Dial_JP,,0,0,0,,もしかして　翼って
Dialogue: 4,0:14:39.44,0:14:42.09,Dial_JP,,0,0,0,,超お金持ちのお坊ちゃまなの
Dialogue: 4,0:14:42.69,0:14:46.14,Dial_JP,,0,0,0,,やっぱウチらとは空気が違うってゆうかさぁ
Dialogue: 4,0:14:46.14,0:14:48.76,Dial_JP,,0,0,0,,いやぁ　東京の人って感じだよね
Dialogue: 4,0:14:48.76,0:14:52.12,Dial_JP,,0,0,0,,東京に対して大きな誤解をしているよ　冬木さん
Dialogue: 4,0:14:52.81,0:14:56.20,Dial_JP,,0,0,0,,というかうち　全然お金持ちじゃないと思うけど
Dialogue: 4,0:14:56.89,0:14:58.63,Dial_JP,,0,0,0,,絶対そうでしょや
Dialogue: 4,0:14:58.63,0:15:00.80,Dial_JP,,0,0,0,,だって他に説明できんくない
Dialogue: 4,0:15:01.36,0:15:03.09,Dial_JP,,0,0,0,,説明かぁ
Dialogue: 4,0:15:03.43,0:15:04.43,Dial_JP,,0,0,0,,したっけさぁ
Dialogue: 4,0:15:04.78,0:15:07.00,Dial_JP,,0,0,0,,今日さ　翼んち行っていい
Dialogue: 4,0:15:13.22,0:15:15.52,Dial_JP,,0,0,0,,結局　押し切られてしまった
Dialogue: 4,0:15:15.94,0:15:17.31,Dial_JP,,0,0,0,,だってあんな…
Dialogue: 4,0:15:17.52,0:15:19.74,Dial_JP,,0,0,0,,今日さ　翼んち行っていい
Dialogue: 4,0:15:20.72,0:15:23.99,Dial_JP,,0,0,0,,なんて殺傷能力の高い角度なんだ
Dialogue: 4,0:15:25.58,0:15:28.47,Dial_JP,,0,0,0,,どうしよう　うちにはおばあちゃんがいるのに
Dialogue: 4,0:15:28.47,0:15:30.65,Dial_JP,,0,0,0,,翼　こっち来て
Dialogue: 4,0:15:31.56,0:15:34.20,Dial_JP,,0,0,0,,こんなとこかまくらあったさぁ
Dialogue: 4,0:15:34.63,0:15:38.23,Dial_JP,,0,0,0,,きっと子どもが作ってそのまま放置したんだろうね
Dialogue: 4,0:15:39.24,0:15:41.63,Dial_JP,,0,0,0,,ふ　冬木さん　あの…
Dialogue: 4,0:15:43.91,0:15:45.55,Dial_JP,,0,0,0,,一緒にはーいろ
Dialogue: 4,0:15:52.92,0:15:54.47,Dial_JP,,0,0,0,,も初体験
Dialogue: 4,0:15:56.29,0:15:57.39,Dial_JP,,0,0,0,,そうだけど…
Dialogue: 4,0:15:57.60,0:15:58.48,Dial_JP,,0,0,0,,ちょっと
Dialogue: 4,0:15:59.00,0:16:01.40,Dial_JP,,0,0,0,,中　あったかいでしょ
Dialogue: 4,0:16:01.60,0:16:04.71,Dial_JP,,0,0,0,,せっ　狭いよ　冬木さん
Dialogue: 4,0:16:05.41,0:16:07.82,Dial_JP,,0,0,0,,もっとくっついて　ほら
Dialogue: 4,0:16:09.20,0:16:11.45,Dial_JP,,0,0,0,,キツ…　もう俺　出るよ
Dialogue: 4,0:16:11.45,0:16:13.96,Dial_JP,,0,0,0,,待ってよ　まだ入ったばっかじゃん
Dialogue: 4,0:16:14.48,0:16:17.50,Dial_JP,,0,0,0,,あんま変な声出さないでよ　冬木さん
Dialogue: 4,0:16:17.71,0:16:21.28,Dial_JP,,0,0,0,,なぜだ　意図してないのに会話が卑わいに
Dialogue: 4,0:16:21.54,0:16:22.76,Dial_JP,,0,0,0,,翼ちゃん
Dialogue: 4,0:16:22.76,0:16:24.23,Dial_JP,,0,0,0,,幻聴まで
Dialogue: 4,0:16:24.99,0:16:27.28,Dial_JP,,0,0,0,,冬木さん　俺もう行くから…
Dialogue: 4,0:16:29.34,0:16:30.78,Dial_JP,,0,0,0,,翼ちゃん
Dialogue: 4,0:16:36.72,0:16:39.39,Dial_JP,,0,0,0,,そんな所で　何をしているの
Dialogue: 4,0:16:39.39,0:16:41.19,Dial_JP,,0,0,0,,おばあちゃん
Dialogue: 4,0:16:41.48,0:16:43.60,Dial_JP,,0,0,0,,私の聞き間違いかしら
Dialogue: 4,0:16:43.60,0:16:44.61,Dial_JP,,0,0,0,,いつからそこに
Dialogue: 4,0:16:44.61,0:16:47.77,Dial_JP,,0,0,0,,非常にはしたない会話が聞こえましたけど
Dialogue: 4,0:16:47.77,0:16:51.16,Dial_JP,,0,0,0,,いちばん聞かれたくないところまるまる聞かれてた
Dialogue: 4,0:16:51.38,0:16:53.06,Dial_JP,,0,0,0,,早く弁明しないと
Dialogue: 4,0:16:53.69,0:16:55.24,Dial_JP,,0,0,0,,おばあちゃん　これは…
Dialogue: 4,0:16:55.24,0:16:57.75,Dial_JP,,0,0,0,,もう翼　出るの早い
Dialogue: 4,0:16:58.24,0:17:00.96,Dial_JP,,0,0,0,,初体験はもっと大事にしな
Dialogue: 4,0:17:04.92,0:17:06.98,Dial_JP,,0,0,0,,このおばあちゃん　翼の知り合い
Dialogue: 4,0:17:10.76,0:17:12.97,Dial_JP,,0,0,0,,翼のおばあちゃま
Dialogue: 4,0:17:12.97,0:17:15.78,Dial_JP,,0,0,0,,はじめまして　冬木っていいます
Dialogue: 4,0:17:15.78,0:17:18.76,Dial_JP,,0,0,0,,こんなとこでエンカすると思わなかったぁ
Dialogue: 4,0:17:18.76,0:17:19.72,Dial_JP,,0,0,0,,エンカ？
Dialogue: 4,0:17:19.96,0:17:24.73,Dial_JP,,0,0,0,,そういえば　おばあちゃまが作った翼のお弁当ちょこっともらったんですけど
Dialogue: 4,0:17:26.35,0:17:28.74,Dial_JP,,0,0,0,,私の料理をあなたが…
Dialogue: 4,0:17:29.61,0:17:30.90,Dial_JP,,0,0,0,,いったんストップ　冬木さ…
Dialogue: 4,0:17:30.90,0:17:33.30,Dial_JP,,0,0,0,,なっんまらおいしかったです
Dialogue: 4,0:17:33.30,0:17:35.66,Dial_JP,,0,0,0,,ホントマジ神って感じで
Dialogue: 4,0:17:37.00,0:17:41.32,Dial_JP,,0,0,0,,毎日そんな手料理が食べられる翼がマジ羨ましい
Dialogue: 4,0:17:41.32,0:17:43.17,Dial_JP,,0,0,0,,ウチもまた食べたぁい
Dialogue: 4,0:17:43.40,0:17:44.68,Dial_JP,,0,0,0,,いやぁ
Dialogue: 4,0:17:46.07,0:17:48.99,Dial_JP,,0,0,0,,すてきな感想　どうもありがとう
Dialogue: 4,0:17:48.99,0:17:50.51,Dial_JP,,0,0,0,,ところで冬木さん
Dialogue: 4,0:17:50.51,0:17:53.68,Dial_JP,,0,0,0,,翼とは　どういうご関係なのかしら
Dialogue: 4,0:17:55.49,0:17:55.97,Dial_JP,,0,0,0,,友だ…
Dialogue: 4,0:17:55.97,0:17:57.37,Dial_JP,,0,0,0,,ただのクラスメート
Dialogue: 4,0:17:58.01,0:17:59.54,Dial_JP,,0,0,0,,ねっ　冬木さん
Dialogue: 4,0:18:04.04,0:18:04.70,Dial_JP,,0,0,0,,うん
Dialogue: 4,0:18:05.57,0:18:06.66,Dial_JP,,0,0,0,,そだね
Dialogue: 4,0:18:11.11,0:18:13.47,Dial_JP,,0,0,0,,雪　降ってきたわね
Dialogue: 4,0:18:14.18,0:18:16.11,Dial_JP,,0,0,0,,ごめんなさいね　冬木さん
Dialogue: 4,0:18:16.11,0:18:18.44,Dial_JP,,0,0,0,,雪も降ってきたことですし
Dialogue: 4,0:18:19.20,0:18:23.13,Dial_JP,,0,0,0,,実は私と翼　このあと大事な用があるので
Dialogue: 4,0:18:23.13,0:18:25.14,Dial_JP,,0,0,0,,ここで失礼するわね
Dialogue: 4,0:18:25.84,0:18:27.62,Dial_JP,,0,0,0,,行くわよ　翼
Dialogue: 4,0:18:27.89,0:18:29.15,Dial_JP,,0,0,0,,あ　あの…
Dialogue: 4,0:18:29.15,0:18:30.59,Dial_JP,,0,0,0,,冬木さん　ごめん
Dialogue: 4,0:18:31.63,0:18:32.42,Dial_JP,,0,0,0,,じゃあね
Dialogue: 4,0:18:35.15,0:18:37.12,Dial_JP,,0,0,0,,やっぱりダメだったか
Dialogue: 4,0:18:37.76,0:18:39.69,Dial_JP,,0,0,0,,俺はなんて無力なんだ
Dialogue: 4,0:18:40.21,0:18:43.78,Dial_JP,,0,0,0,,おばあちゃんは派手な交友関係を嫌う人だし
Dialogue: 4,0:18:44.98,0:18:48.23,Dial_JP,,0,0,0,,これでもう終わりかも
Dialogue: 4,0:18:48.95,0:18:51.09,Dial_JP,,0,0,0,,俺の北海道生活
Dialogue: 4,0:18:51.47,0:18:53.99,Dial_JP,,0,0,0,,いや　普通に待ってなんだけど
Dialogue: 4,0:18:53.99,0:18:55.42,Dial_JP,,0,0,0,,あれ　なんで
Dialogue: 4,0:18:55.42,0:18:58.10,Dial_JP,,0,0,0,,だっておばあちゃまが傘差してるんだもん
Dialogue: 4,0:18:58.55,0:19:01.41,Dial_JP,,0,0,0,,雪が降っているのだから当然でしょう
Dialogue: 4,0:19:01.41,0:19:02.54,Dial_JP,,0,0,0,,ダメです
Dialogue: 4,0:19:03.11,0:19:06.08,Dial_JP,,0,0,0,,もし滑って転んじゃったとき手が塞がってたら
Dialogue: 4,0:19:06.08,0:19:08.34,Dial_JP,,0,0,0,,大ケガしちゃうかもなんですよ
Dialogue: 4,0:19:08.56,0:19:12.57,Dial_JP,,0,0,0,,うちのおばあちゃん　昔それで骨折したことあるから
Dialogue: 4,0:19:12.57,0:19:13.55,Dial_JP,,0,0,0,,冬木さん
Dialogue: 4,0:19:13.88,0:19:16.84,Dial_JP,,0,0,0,,それに雪は手でほろえば落ちるんで
Dialogue: 4,0:19:19.71,0:19:21.66,Dial_JP,,0,0,0,,翼んちってどっち方面
Dialogue: 4,0:19:22.13,0:19:23.47,Dial_JP,,0,0,0,,向こうのほうだよ
Dialogue: 4,0:19:23.72,0:19:26.52,Dial_JP,,0,0,0,,その先に横断歩道があるんだけど
Dialogue: 4,0:19:26.97,0:19:29.42,Dial_JP,,0,0,0,,そこ今日アイスバーンでなまら滑るから
Dialogue: 4,0:19:29.42,0:19:30.94,Dial_JP,,0,0,0,,通らないほうがよき
Dialogue: 4,0:19:31.65,0:19:34.14,Dial_JP,,0,0,0,,こっちのルートは安全だし　近道
Dialogue: 4,0:19:34.61,0:19:36.91,Dial_JP,,0,0,0,,ウチがガイドするからついてきなよ
Dialogue: 4,0:19:37.11,0:19:40.08,Dial_JP,,0,0,0,,おばあちゃまの荷物は　ウチが持ちますね
Dialogue: 4,0:19:40.31,0:19:41.03,Dial_JP,,0,0,0,,ちょっと
Dialogue: 4,0:19:41.19,0:19:43.80,Dial_JP,,0,0,0,,あんなにおいしい料理が作れるんだもん
Dialogue: 4,0:19:44.03,0:19:46.51,Dial_JP,,0,0,0,,おばあちゃまの手は大事にしなくっちゃ
Dialogue: 4,0:19:49.11,0:19:52.24,Dial_JP,,0,0,0,,待って冬木さん　その荷物は俺が持つよ
Dialogue: 4,0:19:52.70,0:19:53.53,Dial_JP,,0,0,0,,どうぞ
Dialogue: 4,0:19:55.07,0:19:56.53,Dial_JP,,0,0,0,,なんか怒ってる
Dialogue: 4,0:19:56.92,0:19:58.08,Dial_JP,,0,0,0,,別に
Dialogue: 4,0:19:58.08,0:20:01.35,Dial_JP,,0,0,0,,ただのクラスメートに怒ることなんかないし
Dialogue: 4,0:20:01.35,0:20:02.35,Dial_JP,,0,0,0,,いや　あれは…
Dialogue: 4,0:20:03.30,0:20:05.83,Dial_JP,,0,0,0,,おばあちゃんの前では言いづらかったというか
Dialogue: 4,0:20:06.15,0:20:07.56,Dial_JP,,0,0,0,,なんていうか　その
Dialogue: 4,0:20:08.39,0:20:10.69,Dial_JP,,0,0,0,,大切な友達だと思ってるから
Dialogue: 4,0:20:13.22,0:20:16.38,Dial_JP,,0,0,0,,ナニナニ　翼　ウチのこと大切なの
Dialogue: 4,0:20:16.38,0:20:18.48,Dial_JP,,0,0,0,,ちょっ　冬木さん　声でかい
Dialogue: 4,0:20:18.70,0:20:20.24,Dial_JP,,0,600,0,,そうなんだ
Dialogue: 4,0:20:19.45,0:20:22.36,Dial_JP,,600,0,0,,もう　メッチャ恥ずかしいな
Dialogue: 4,0:20:29.84,0:20:31.67,Dial_JP,,0,0,0,,わや…
Dialogue: 4,0:20:31.87,0:20:33.00,Dial_JP,,0,0,0,,冬木さん？
Dialogue: 4,0:20:34.39,0:20:36.58,Dial_JP,,0,0,0,,おけおけ　用事あるんだもんね
Dialogue: 4,0:20:36.58,0:20:38.37,Dial_JP,,0,0,0,,したっけウチは帰るから
Dialogue: 4,0:20:38.37,0:20:39.41,Dial_JP,,0,0,0,,お待ちを
Dialogue: 4,0:20:40.23,0:20:42.67,Dial_JP,,0,0,0,,あなたのおかげで早く着いたから
Dialogue: 4,0:20:42.67,0:20:45.37,Dial_JP,,0,0,0,,少し時間に余裕ができましたわ
Dialogue: 4,0:20:45.64,0:20:47.93,Dial_JP,,0,0,0,,温かいお茶でもいかが
Dialogue: 4,0:20:48.11,0:20:51.08,Dial_JP,,0,0,0,,いいんですかぁ　やったぁ
Dialogue: 4,0:20:52.05,0:20:54.83,Dial_JP,,0,0,0,,私も丸くなったものね
Dialogue: 4,0:20:55.81,0:20:58.07,Dial_JP,,0,0,0,,年を取った証拠かしら
Dialogue: 4,0:20:59.36,0:21:02.41,Dial_JP,,0,0,0,,でも　翼ちゃんが選んだ子だもの
Dialogue: 4,0:21:02.59,0:21:06.10,Dial_JP,,0,0,0,,冬木さんだって　ホントはいい子のはずよね
Dialogue: 4,0:21:06.10,0:21:07.66,Dial_JP,,0,0,0,,ちょっと　わやぁ
Dialogue: 4,0:21:08.02,0:21:10.24,Dial_JP,,0,0,0,,どこ撮っても映えるんだけど
Dialogue: 4,0:21:10.24,0:21:12.25,Dial_JP,,0,0,0,,あんまり撮らないでよ　冬木さん
Dialogue: 4,0:21:12.25,0:21:16.96,Dial_JP,,0,0,0,,すごい　ってか　やっぱウチの言ったとおりお金持ちじゃん
Dialogue: 4,0:21:19.62,0:21:20.68,Dial_JP,,0,0,0,,これも
Dialogue: 4,0:21:16.96,0:21:19.47,Dial_JP,,0,0,0,,やっぱりこの子は要注意
Dialogue: 4,0:21:26.29,0:21:28.35,Dial_JP,,0,0,0,,おばあちゃん
Dialogue: 4,0:21:29.01,0:21:31.60,Dial_JP,,0,0,0,,あら　どうしたの　翼ちゃん
Dialogue: 4,0:21:31.84,0:21:34.74,Dial_JP,,0,0,0,,僕ね　たくさんお勉強と習い事して
Dialogue: 4,0:21:34.74,0:21:38.64,Dial_JP,,0,0,0,,将来偉くなって　おばあちゃんたちに楽させてあげたいんだ
Dialogue: 4,0:21:38.64,0:21:39.86,Dial_JP,,0,0,0,,あらあら
Dialogue: 4,0:21:39.86,0:21:43.73,Dial_JP,,0,0,0,,翼ちゃんは本当に　真面目でいい子だねぇ
Dialogue: 4,0:21:46.74,0:21:50.48,Dial_JP,,0,0,0,,翼ちゃんのあんな笑顔　久しぶりに見た
Dialogue: 4,0:21:51.36,0:21:55.12,Dial_JP,,0,0,0,,孫の笑顔を信じてみましょうか
Dialogue: 4,0:21:55.94,0:21:58.73,Dial_JP,,0,0,0,,２人とも　お茶が入りましたよ
Dialogue: 4,0:21:59.40,0:22:00.81,Dial_JP,,0,0,0,,ありがとう　おばあちゃん
Dialogue: 4,0:22:01.48,0:22:03.03,Dial_JP,,0,0,0,,ありがとですぅ
Dialogue: 4,0:23:35.10,0:23:38.98,Dial_JP,,0,0,0,,来週行うスキー授業のしおりを配るから
Dialogue: 4,0:23:38.98,0:23:41.51,Dial_JP,,0,0,0,,各自　座席を確認しておくように
Dialogue: 4,0:23:44.40,0:23:46.11,Dial_JP,,0,0,0,,冬木さんの後ろだ
Dialogue: 4,0:23:46.69,0:23:47.81,Dial_JP,,0,0,0,,隣は
Dialogue: 4,0:23:48.49,0:23:50.12,Dial_JP,,0,0,0,,「秋野」さん
Dialogue: 5,0:00:01.67,0:00:03.23,Dial_CH,,0,0,0,,可爱的雪人做好啦
Dialogue: 5,0:00:03.39,0:00:04.86,Dial_CH,,0,0,0,,拍张照发story吧
Dialogue: 5,0:00:11.31,0:00:12.88,Dial_CH,,0,0,0,,拍得挺好
Dialogue: 5,0:00:17.53,0:00:19.08,Dial_CH,,0,0,0,,看啥呢
Dialogue: 5,0:00:20.26,0:00:23.35,Dial_CH,,0,0,0,,你干嘛吹人耳朵 不能搞突然袭击
Dialogue: 5,0:00:25.24,0:00:27.80,Dial_CH,,0,0,0,,好怀念 这不是冰雪节吗
Dialogue: 5,0:00:28.63,0:00:31.12,Dial_CH,,0,0,0,,怎么了 翼 想去吗
Dialogue: 5,0:00:31.12,0:00:35.16,Dial_CH,,0,0,0,,我想着反正就在这周末 正好趁这次机会去看看
Dialogue: 5,0:00:36.16,0:00:37.81,Dial_CH,,0,0,0,,这周末
Dialogue: 5,0:00:38.92,0:00:41.59,Dial_CH,,0,0,0,,拿你没辙
Dialogue: 5,0:00:42.37,0:00:43.82,Dial_CH,,0,0,0,,既然你都这么说了
Dialogue: 5,0:00:44.23,0:00:46.13,Dial_CH,,0,0,0,,那我陪你一起去吧
Dialogue: 5,0:00:46.58,0:00:48.64,Dial_CH,,0,0,0,,我还没说到这份上呢
Dialogue: 5,0:00:51.50,0:00:52.60,Dial_CH,,0,0,0,,这不就是
Dialogue: 5,0:00:53.30,0:00:54.60,Dial_CH,,0,0,0,,约会？
Dialogue: 5,0:02:30.36,0:02:31.67,Dial_CH,,0,0,0,,好好吃
Dialogue: 5,0:02:31.94,0:02:33.69,Dial_CH,,500,0,0,,我喜欢这年糕
Dialogue: 5,0:02:33.69,0:02:36.65,Dial_CH,,500,0,0,,土豆的是吧 另外一盘还加了芝士
Dialogue: 5,0:02:36.65,0:02:39.51,Dial_CH,,0,0,0,,好耶 芝士 芝士
Dialogue: 5,0:02:41.52,0:02:43.00,Dial_CH,,0,0,0,,给 活源
Dialogue: 5,0:02:43.00,0:02:44.06,Dial_CH,,0,0,0,,谢谢
Dialogue: 5,0:02:46.95,0:02:48.52,Dial_CH,,0,0,0,,爸爸还没回家啊
Dialogue: 5,0:02:48.74,0:02:50.56,Dial_CH,,0,0,0,,毕竟周末
Dialogue: 5,0:02:51.13,0:02:54.94,Dial_CH,,0,0,0,,不过明天他休息 不如全家一起出去玩吧
Dialogue: 5,0:02:54.94,0:02:56.48,Dial_CH,,0,0,0,,我想去滑雪
Dialogue: 5,0:02:56.48,0:02:58.13,Dial_CH,,0,0,0,,好啊好啊
Dialogue: 5,0:02:58.13,0:02:59.45,Dial_CH,,0,0,0,,小美去不去
Dialogue: 5,0:03:03.16,0:03:04.68,Dial_CH,,0,0,0,,我就算了
Dialogue: 5,0:03:04.68,0:03:07.25,Dial_CH,,0,0,0,,明天要和朋友去冰雪节
Dialogue: 5,0:03:08.07,0:03:10.54,Dial_CH,,0,0,0,,美姐明天不一起去吗
Dialogue: 5,0:03:10.54,0:03:11.92,Dial_CH,,0,0,0,,抱歉啦 桃桃
Dialogue: 5,0:03:11.92,0:03:13.66,Dial_CH,,0,0,0,,冰雪节啊
Dialogue: 5,0:03:13.66,0:03:16.93,Dial_CH,,0,0,0,,确实小美上小学时还经常去来着
Dialogue: 5,0:03:19.06,0:03:21.15,Dial_CH,,0,0,0,,小澪她们也说要去
Dialogue: 5,0:03:21.81,0:03:22.91,Dial_CH,,0,0,0,,我回来了
Dialogue: 5,0:03:23.65,0:03:25.36,Dial_CH,,0,0,0,,欢迎回来
Dialogue: 5,0:03:37.33,0:03:39.60,Dial_CH,,0,0,0,,今天冷了好多啊
Dialogue: 5,0:03:41.11,0:03:44.23,Dial_CH,,0,0,0,,明天11点在北见站前集合哦
Dialogue: 5,0:03:44.23,0:03:45.37,Dial_CH,,0,0,0,,那就晚安啦
Dialogue: 5,0:03:45.79,0:03:48.94,Dial_CH,,0,0,0,,没想到真的要一起去了
Dialogue: 5,0:03:49.23,0:03:52.77,Dial_CH,,0,0,0,,2个人一起逛庆典 这不完全就是约会吗
Dialogue: 5,0:03:53.16,0:03:55.26,Dial_CH,,0,0,0,,而且还加了个这样的表情
Dialogue: 5,0:03:55.82,0:03:56.85,Dial_CH,,0,0,0,,还附带了这张
Dialogue: 5,0:04:00.59,0:04:01.41,Dial_CH,,0,0,0,,不行
Dialogue: 5,0:04:01.66,0:04:05.02,Dial_CH,,0,0,0,,见面之前就这样的话可就没法活着回来了
Dialogue: 5,0:04:05.66,0:04:10.19,Dial_CH,,0,0,0,,决定了 今天就单纯去享受在北海道的初次活动吧
Dialogue: 5,0:04:10.77,0:04:12.61,Dial_CH,,0,0,0,,而且冬木同学没准也只是
Dialogue: 5,0:04:13.06,0:04:17.42,Dial_CH,,0,0,0,,照顾我刚过来还没有交到朋友才邀请我的
Dialogue: 5,0:04:24.01,0:04:25.89,Dial_CH,,0,0,0,,久等了 翼
Dialogue: 5,0:04:36.39,0:04:37.59,Dial_CH,,0,0,0,,嗨
Dialogue: 5,0:04:37.59,0:04:39.98,Dial_CH,,0,0,0,,这是多么强大的攻击力啊
Dialogue: 5,0:04:39.98,0:04:43.57,Dial_CH,,0,0,0,,冬木同学出门穿的是这种感觉啊
Dialogue: 5,0:04:43.57,0:04:46.92,Dial_CH,,0,0,0,,她平时露得那么多 今天这样穿反而觉得好顶
Dialogue: 5,0:04:47.41,0:04:50.90,Dial_CH,,0,0,0,,哦 确实还是第一次不穿校服在外边见面
Dialogue: 5,0:04:51.42,0:04:52.73,Dial_CH,,0,0,0,,好看吧
Dialogue: 5,0:04:54.70,0:04:56.74,Dial_CH,,0,0,0,,嗯 特别好看
Dialogue: 5,0:04:58.03,0:05:00.15,Dial_CH,,0,0,0,,咋这么不情愿
Dialogue: 5,0:05:00.15,0:05:01.44,Dial_CH,,0,0,0,,伤心了
Dialogue: 5,0:05:02.57,0:05:05.96,Dial_CH,,0,0,0,,说 说起来 你说上次来冰雪节
Dialogue: 5,0:05:05.96,0:05:07.74,Dial_CH,,0,0,0,,还是小学的时候对吧
Dialogue: 5,0:05:07.74,0:05:10.03,Dial_CH,,0,0,0,,是啊 贼怀念
Dialogue: 5,0:05:10.70,0:05:13.90,Dial_CH,,0,0,0,,听说那里还有雪雕 冰雕什么的
Dialogue: 5,0:05:13.90,0:05:16.50,Dial_CH,,0,0,0,,都是只在北海道才能见到的东西吧
Dialogue: 5,0:05:16.50,0:05:19.70,Dial_CH,,0,0,0,,我还查了查庆典上有名的小吃摊
Dialogue: 5,0:05:20.14,0:05:21.68,Dial_CH,,0,0,0,,真期待
Dialogue: 5,0:05:21.99,0:05:25.14,Dial_CH,,0,0,0,,还是不要那么期待比较好
Dialogue: 5,0:05:25.99,0:05:27.04,Dial_CH,,0,0,0,,你说了什么
Dialogue: 5,0:05:27.46,0:05:28.61,Dial_CH,,0,0,0,,啥也没有
Dialogue: 5,0:05:28.81,0:05:30.17,Dial_CH,,0,0,0,,走吧
Dialogue: 5,0:05:52.22,0:05:54.50,Dial_CH,,0,0,0,,差不多就是这样吧 感觉咋样…
Dialogue: 5,0:05:55.18,0:05:56.88,Dial_CH,,0,0,0,,好棒啊 冬木同学
Dialogue: 5,0:05:56.88,0:05:58.26,Dial_CH,,0,0,0,,赶紧逛起来吧
Dialogue: 5,0:05:59.82,0:06:01.08,Dial_CH,,0,0,0,,OK
Dialogue: 5,0:06:05.44,0:06:07.08,Dial_CH,,0,0,0,,好大的雪雕
Dialogue: 5,0:06:07.08,0:06:09.37,Dial_CH,,0,0,0,,感觉以前的好像更大一点儿
Dialogue: 5,0:06:09.37,0:06:11.55,Dial_CH,,0,0,0,,因为冬木同学长大了吧
Dialogue: 5,0:06:11.55,0:06:12.97,Dial_CH,,0,0,0,,我拍个照
Dialogue: 5,0:06:13.20,0:06:13.98,Dial_CH,,0,0,0,,好呀
Dialogue: 5,0:06:14.22,0:06:15.15,Dial_CH,,0,0,0,,那
Dialogue: 5,0:06:15.97,0:06:18.19,Dial_CH,,0,0,0,,这样拍不是更好吗
Dialogue: 5,0:06:18.54,0:06:18.86,Dial_CH,,0,0,0,,等
Dialogue: 5,0:06:21.64,0:06:23.11,Dial_CH,,0,0,0,,她好香
Dialogue: 5,0:06:25.84,0:06:28.86,Dial_CH,,0,0,0,,你这眼睛跟没睡醒似的 逗死我了
Dialogue: 5,0:06:29.87,0:06:32.19,Dial_CH,,0,0,0,,太丢人了 快帮我删了
Dialogue: 5,0:06:32.63,0:06:33.78,Dial_CH,,0,0,0,,这个味儿
Dialogue: 5,0:06:33.78,0:06:35.18,Dial_CH,,0,0,0,,你倒是听我说话呀
Dialogue: 5,0:06:35.56,0:06:37.39,Dial_CH,,0,0,0,,翼 你饿了没
Dialogue: 5,0:06:38.38,0:06:39.46,Dial_CH,,0,0,0,,有点吧
Dialogue: 5,0:06:43.28,0:06:44.56,Dial_CH,,0,0,0,,要加点啥
Dialogue: 5,0:06:44.56,0:06:45.71,Dial_CH,,0,0,0,,糖
Dialogue: 5,0:06:45.71,0:06:46.55,Dial_CH,,0,0,0,,我的也
Dialogue: 5,0:06:50.52,0:06:52.91,Dial_CH,,0,0,0,,来… 来一个炸肠
Dialogue: 5,0:06:52.91,0:06:54.76,Dial_CH,,0,0,0,,好嘞 您加点儿啥
Dialogue: 5,0:06:55.98,0:06:57.03,Dial_CH,,0,0,0,,加糖
Dialogue: 5,0:06:59.81,0:07:01.89,Dial_CH,,0,0,0,,这串儿真香
Dialogue: 5,0:07:02.37,0:07:04.44,Dial_CH,,0,0,0,,再吃点儿啥呢
Dialogue: 5,0:07:04.44,0:07:06.23,Dial_CH,,0,0,0,,抱歉 久等啦
Dialogue: 5,0:07:06.23,0:07:07.43,Dial_CH,,0,0,0,,你回来啦
Dialogue: 5,0:07:12.27,0:07:15.58,Dial_CH,,0,0,0,,你的炸肠给我吃一口呗
Dialogue: 5,0:07:16.49,0:07:17.53,Dial_CH,,0,0,0,,可以啊
Dialogue: 5,0:07:29.18,0:07:30.64,Dial_CH,,0,0,0,,香
Dialogue: 5,0:07:30.64,0:07:32.59,Dial_CH,,0,0,0,,那… 那就好
Dialogue: 5,0:07:33.02,0:07:35.53,Dial_CH,,0,0,0,,这莫名的罪恶感是怎么回事
Dialogue: 5,0:07:36.05,0:07:39.84,Dial_CH,,0,0,0,,而且我还得把她咬过的吃完…
Dialogue: 5,0:07:40.10,0:07:41.09,Dial_CH,,0,0,0,,这不就是
Dialogue: 5,0:07:42.06,0:07:43.40,Dial_CH,,0,0,0,,间接接…
Dialogue: 5,0:07:44.54,0:07:46.00,Dial_CH,,0,0,0,,不行不行 不能往那边想
Dialogue: 5,0:07:46.00,0:07:47.62,Dial_CH,,0,0,0,,都高中生了
Dialogue: 5,0:07:47.88,0:07:49.91,Dial_CH,,0,0,0,,面不改色地吃下去就行
Dialogue: 5,0:07:51.87,0:07:53.70,Dial_CH,,0,0,0,,好 好了 吃下去了
Dialogue: 5,0:07:56.70,0:07:58.33,Dial_CH,,0,0,0,,怎 怎么了
Dialogue: 5,0:07:58.33,0:08:00.20,Dial_CH,,0,0,0,,没啥
Dialogue: 5,0:08:00.49,0:08:03.92,Dial_CH,,0,0,0,,都像翼这样好懂就好了 多可爱呀
Dialogue: 5,0:08:04.60,0:08:06.39,Dial_CH,,0,0,0,,你就是故意调戏我吧
Dialogue: 5,0:08:06.59,0:08:08.29,Dial_CH,,0,0,0,,好啦好啦 接着逛
Dialogue: 5,0:08:08.93,0:08:10.27,Dial_CH,,0,0,0,,慢点啊 冬木同学
Dialogue: 5,0:08:23.98,0:08:24.54,Dial_CH,,0,0,0,,给
Dialogue: 5,0:08:25.23,0:08:27.20,Dial_CH,,0,0,0,,从那边拿的热甜米酒
Dialogue: 5,0:08:27.69,0:08:28.86,Dial_CH,,0,0,0,,谢啦
Dialogue: 5,0:08:30.09,0:08:31.46,Dial_CH,,0,0,0,,冰雪节如何
Dialogue: 5,0:08:31.79,0:08:34.49,Dial_CH,,0,0,0,,又是冰又是雪的 太牛了
Dialogue: 5,0:08:34.49,0:08:37.16,Dial_CH,,0,0,0,,笑死 你这词汇也忒贫乏了
Dialogue: 5,0:08:40.79,0:08:43.15,Dial_CH,,0,0,0,,我从小就住东京
Dialogue: 5,0:08:43.40,0:08:44.88,Dial_CH,,0,0,0,,所以感觉特别明显
Dialogue: 5,0:08:45.98,0:08:50.10,Dial_CH,,0,0,0,,都是日本 景色竟然这么不一样
Dialogue: 5,0:08:53.34,0:08:56.10,Dial_CH,,0,0,0,,谢谢你 今天我真的很开心
Dialogue: 5,0:08:56.49,0:08:58.37,Dial_CH,,0,0,0,,和冬木同学一起来真是太好了
Dialogue: 5,0:09:06.74,0:09:09.53,Dial_CH,,0,0,0,,其实我今天本来挺担心的
Dialogue: 5,0:09:10.24,0:09:10.91,Dial_CH,,0,0,0,,为什么
Dialogue: 5,0:09:11.10,0:09:14.33,Dial_CH,,0,0,0,,也没啥 我最后一次来冰雪节的时候
Dialogue: 5,0:09:14.33,0:09:16.17,Dial_CH,,0,0,0,,不还是小学生吗
Dialogue: 5,0:09:16.49,0:09:20.25,Dial_CH,,0,0,0,,那会儿觉得还挺有意思的 但不确定现在还是不是这样
Dialogue: 5,0:09:20.91,0:09:24.74,Dial_CH,,0,0,0,,万一你觉得没意思失望了啥的
Dialogue: 5,0:09:27.83,0:09:30.92,Dial_CH,,0,0,0,,结果白担心了
Dialogue: 5,0:09:31.61,0:09:36.68,Dial_CH,,0,0,0,,和你在一起 我更喜欢北海道了
Dialogue: 5,0:09:37.32,0:09:40.10,Dial_CH,,0,0,0,,感觉到了这儿确实是个好地方
Dialogue: 5,0:09:40.84,0:09:44.25,Dial_CH,,0,0,0,,看着你玩得开心 我也就高兴了
Dialogue: 5,0:09:44.63,0:09:47.46,Dial_CH,,0,0,0,,我也觉得和你一起来冰雪节真是来对了
Dialogue: 5,0:09:50.80,0:09:53.32,Dial_CH,,0,0,0,,平时倒是没咋寻思
Dialogue: 5,0:09:53.57,0:09:56.82,Dial_CH,,0,0,0,,我好像还挺热爱咱家乡的
Dialogue: 5,0:10:00.04,0:10:00.73,Dial_CH,,0,0,0,,小心
Dialogue: 5,0:10:16.50,0:10:17.28,Dial_CH,,0,0,0,,那个
Dialogue: 5,0:10:17.28,0:10:19.15,Dial_CH,,0,0,0,,对对对对不起
Dialogue: 5,0:10:19.15,0:10:21.19,Dial_CH,,0,0,0,,我下意识 就 嗯
Dialogue: 5,0:10:21.48,0:10:23.37,Dial_CH,,0,0,0,,没 没事儿
Dialogue: 5,0:10:24.91,0:10:26.03,Dial_CH,,0,0,0,,谢谢你
Dialogue: 5,0:10:30.51,0:10:31.50,Dial_CH,,0,0,0,,冬木同学
Dialogue: 5,0:10:33.01,0:10:34.69,Dial_CH,,0,0,0,,要是你没事的话
Dialogue: 5,0:10:34.99,0:10:37.60,Dial_CH,,0,0,0,,有机会我们俩再去哪一起玩吧
Dialogue: 5,0:10:43.36,0:10:47.17,Dial_CH,,0,0,0,,咋啦 那么想和我过二人世界呀
Dialogue: 5,0:10:47.34,0:10:48.46,Dial_CH,,0,0,0,,没 没有
Dialogue: 5,0:10:48.92,0:10:51.38,Dial_CH,,0,0,0,,不是两个人也行
Dialogue: 5,0:10:52.89,0:10:56.20,Dial_CH,,0,0,0,,有机会还想去札幌的冰雪节看看
Dialogue: 5,0:10:57.73,0:10:58.38,Dial_CH,,0,0,0,,嗯
Dialogue: 5,0:11:12.48,0:11:14.42,Dial_CH,,0,0,0,,一起吃午饭吧
Dialogue: 5,0:11:15.70,0:11:19.22,Dial_CH,,0,0,0,,因为今天带了点东西想给你尝尝
Dialogue: 5,0:11:19.42,0:11:20.16,Dial_CH,,0,0,0,,给我？
Dialogue: 5,0:11:20.40,0:11:21.64,Dial_CH,,0,0,0,,锵锵
Dialogue: 5,0:11:23.24,0:11:24.79,Dial_CH,,0,0,0,,这是什么 方便面吗
Dialogue: 5,0:11:25.00,0:11:27.97,Dial_CH,,0,0,0,,偶尔在学校里吃个方便面
Dialogue: 5,0:11:28.19,0:11:31.02,Dial_CH,,0,0,0,,就是会觉得比平时好吃一点儿
Dialogue: 5,0:11:32.04,0:11:34.93,Dial_CH,,0,0,0,,东京那块儿炒面便当不多吧
Dialogue: 5,0:11:35.90,0:11:39.15,Dial_CH,,0,0,0,,这是特意买给我的吗
Dialogue: 5,0:11:39.15,0:11:41.79,Dial_CH,,0,0,0,,这不是之前看了你那样儿
Dialogue: 5,0:11:41.79,0:11:45.10,Dial_CH,,0,0,0,,就想着可得多让你尝尝咱北海道美食呀
Dialogue: 5,0:11:46.52,0:11:48.98,Dial_CH,,0,0,0,,这难以形容的羞耻…
Dialogue: 5,0:11:50.09,0:11:52.39,Dial_CH,,0,0,0,,你用保温瓶带了热水啊
Dialogue: 5,0:11:52.39,0:11:54.93,Dial_CH,,0,0,0,,嗯 再等3分钟就好了
Dialogue: 5,0:11:55.70,0:11:57.61,Dial_CH,,0,0,0,,到点儿 泡好啦
Dialogue: 5,0:11:57.80,0:12:00.07,Dial_CH,,0,0,0,,这么快就好了啊
Dialogue: 5,0:12:00.07,0:12:02.13,Dial_CH,,0,0,0,,接下来是我的秘方
Dialogue: 5,0:12:03.45,0:12:07.33,Dial_CH,,0,0,0,,炒面便当里有包中华汤料
Dialogue: 5,0:12:07.73,0:12:11.30,Dial_CH,,0,0,0,,要是用泡完的水冲 就成一碗汤了
Dialogue: 5,0:12:11.74,0:12:13.38,Dial_CH,,0,0,0,,好有创意
Dialogue: 5,0:12:14.06,0:12:15.87,Dial_CH,,0,0,0,,完成
Dialogue: 5,0:12:16.56,0:12:18.47,Dial_CH,,0,0,0,,何等的垃圾食品
Dialogue: 5,0:12:18.76,0:12:24.01,Dial_CH,,0,0,0,,但这股香气所带来的诱惑却直冲我的脑门
Dialogue: 5,0:12:27.01,0:12:28.68,Dial_CH,,0,0,0,,来 张嘴
Dialogue: 5,0:12:30.05,0:12:31.56,Dial_CH,,0,0,0,,怎么突然喂我
Dialogue: 5,0:12:35.63,0:12:36.56,Dial_CH,,0,0,0,,好吃吗
Dialogue: 5,0:12:38.64,0:12:40.38,Dial_CH,,0,0,0,,特别好吃
Dialogue: 5,0:12:40.38,0:12:42.53,Dial_CH,,0,0,0,,对吧 那就好
Dialogue: 5,0:12:42.69,0:12:44.59,Dial_CH,,0,0,0,,面很有嚼劲
Dialogue: 5,0:12:44.59,0:12:48.03,Dial_CH,,0,0,0,,卷心菜这些配料也非常搭 真的很好吃
Dialogue: 5,0:12:49.84,0:12:52.23,Dial_CH,,0,0,0,,这下就还给你了
Dialogue: 5,0:12:53.56,0:12:54.71,Dial_CH,,0,0,0,,是那时候的
Dialogue: 5,0:12:56.08,0:12:59.12,Dial_CH,,0,0,0,,翼 你咋脸红了
Dialogue: 5,0:12:59.12,0:13:01.06,Dial_CH,,0,0,0,,回忆起来就兴奋了吗
Dialogue: 5,0:13:01.06,0:13:01.68,Dial_CH,,0,0,0,,不是
Dialogue: 5,0:13:01.90,0:13:03.92,Dial_CH,,0,0,0,,是炒面太烫了
Dialogue: 5,0:13:03.92,0:13:05.91,Dial_CH,,0,0,0,,你的便当呢
Dialogue: 5,0:13:05.91,0:13:07.41,Dial_CH,,0,0,0,,想看 给我看看
Dialogue: 5,0:13:08.30,0:13:10.19,Dial_CH,,0,0,0,,就是普通的便当
Dialogue: 5,0:13:10.51,0:13:11.75,Dial_CH,,0,0,0,,这样的
Dialogue: 5,0:13:14.54,0:13:16.53,Dial_CH,,0,0,0,,这… 这是过年了吗
Dialogue: 5,0:13:17.25,0:13:19.31,Dial_CH,,0,0,0,,好绝啊 能拍个照吗
Dialogue: 5,0:13:19.31,0:13:20.51,Dial_CH,,0,0,0,,行是行
Dialogue: 5,0:13:20.51,0:13:23.51,Dial_CH,,0,0,0,,我的便当有那么稀奇吗
Dialogue: 5,0:13:23.80,0:13:25.31,Dial_CH,,0,0,0,,冬木同学也尝一尝吧
Dialogue: 5,0:13:25.82,0:13:28.25,Dial_CH,,0,0,0,,真可以吃吗 那我动筷子了
Dialogue: 5,0:13:28.63,0:13:31.67,Dial_CH,,0,0,0,,就尝这块肉了
Dialogue: 5,0:13:34.58,0:13:36.71,Dial_CH,,0,0,0,,贼好吃
Dialogue: 5,0:13:37.40,0:13:40.39,Dial_CH,,0,0,0,,简直了 又软又嫩
Dialogue: 5,0:13:40.39,0:13:41.46,Dial_CH,,0,0,0,,是谁做的
Dialogue: 5,0:13:41.46,0:13:43.38,Dial_CH,,0,0,0,,厨神吗 神做的吗
Dialogue: 5,0:13:43.38,0:13:46.37,Dial_CH,,0,0,0,,是我奶奶做的炖肉
Dialogue: 5,0:13:46.81,0:13:48.61,Dial_CH,,0,0,0,,无敌了
Dialogue: 5,0:13:48.61,0:13:50.79,Dial_CH,,0,0,0,,想和你奶奶结婚了
Dialogue: 5,0:13:50.79,0:13:51.98,Dial_CH,,0,0,0,,什么情况
Dialogue: 5,0:13:52.76,0:13:55.65,Dial_CH,,0,0,0,,讲真的 太好吃了
Dialogue: 5,0:13:55.65,0:13:56.73,Dial_CH,,0,0,0,,谢谢
Dialogue: 5,0:13:56.93,0:14:00.01,Dial_CH,,0,0,0,,我才要谢谢你 炒面便当也很棒
Dialogue: 5,0:14:00.01,0:14:01.22,Dial_CH,,0,0,0,,感谢款待
Dialogue: 5,0:14:01.78,0:14:04.33,Dial_CH,,0,0,0,,我有生以来第一次吃泡面
Dialogue: 5,0:14:04.33,0:14:06.36,Dial_CH,,0,0,0,,没想过居然这么好吃
Dialogue: 5,0:14:06.75,0:14:09.27,Dial_CH,,0,0,0,,跟冬木同学一起总能体验新东西
Dialogue: 5,0:14:10.87,0:14:13.80,Dial_CH,,0,0,0,,你刚刚说没吃过泡面？
Dialogue: 5,0:14:14.97,0:14:16.56,Dial_CH,,0,0,0,,等等 等等
Dialogue: 5,0:14:16.56,0:14:19.38,Dial_CH,,0,0,0,,你还说总能体验新东西
Dialogue: 5,0:14:19.83,0:14:24.46,Dial_CH,,0,0,0,,对 对的 进女生家里我也是第一次
Dialogue: 5,0:14:24.79,0:14:26.44,Dial_CH,,0,0,0,,也没在便利店买过现成的东西吃
Dialogue: 5,0:14:27.13,0:14:30.78,Dial_CH,,0,0,0,,也没跟朋友去过庆典
Dialogue: 5,0:14:32.10,0:14:33.01,Dial_CH,,0,0,0,,真的吗
Dialogue: 5,0:14:34.06,0:14:37.17,Dial_CH,,0,0,0,,就从你刚才说的这些看来
Dialogue: 5,0:14:37.17,0:14:38.76,Dial_CH,,0,0,0,,难不成你
Dialogue: 5,0:14:39.44,0:14:42.09,Dial_CH,,0,0,0,,是超级富二代吗
Dialogue: 5,0:14:42.69,0:14:46.14,Dial_CH,,0,0,0,,果然跟咱们乡下人气质就不一样啊
Dialogue: 5,0:14:46.14,0:14:48.76,Dial_CH,,0,0,0,,一眼就是东京人
Dialogue: 5,0:14:48.76,0:14:52.12,Dial_CH,,0,0,0,,你对东京误会很大啊 冬木同学
Dialogue: 5,0:14:52.81,0:14:56.20,Dial_CH,,0,0,0,,而且我觉得我家完全算不上富
Dialogue: 5,0:14:56.89,0:14:58.63,Dial_CH,,0,0,0,,这还不算富吗
Dialogue: 5,0:14:58.63,0:15:00.80,Dial_CH,,0,0,0,,要不然咋解释
Dialogue: 5,0:15:01.36,0:15:03.09,Dial_CH,,0,0,0,,解释吗
Dialogue: 5,0:15:03.43,0:15:04.43,Dial_CH,,0,0,0,,那这样吧
Dialogue: 5,0:15:04.78,0:15:07.00,Dial_CH,,0,0,0,,今天咱能去你家不
Dialogue: 5,0:15:13.22,0:15:15.52,Dial_CH,,0,0,0,,还是没法拒绝她
Dialogue: 5,0:15:15.94,0:15:17.31,Dial_CH,,0,0,0,,她那样求我…
Dialogue: 5,0:15:17.52,0:15:19.74,Dial_CH,,0,0,0,,今天咱能去你家不
Dialogue: 5,0:15:20.72,0:15:23.99,Dial_CH,,0,0,0,,这谁看了能顶得住啊
Dialogue: 5,0:15:25.58,0:15:28.47,Dial_CH,,0,0,0,,怎么办 奶奶还在家里
Dialogue: 5,0:15:28.47,0:15:30.65,Dial_CH,,0,0,0,,翼 来这边
Dialogue: 5,0:15:31.56,0:15:34.20,Dial_CH,,0,0,0,,这儿有个雪屋呢
Dialogue: 5,0:15:34.63,0:15:38.23,Dial_CH,,0,0,0,,肯定是小孩儿做的 做完放这儿就走了
Dialogue: 5,0:15:39.24,0:15:41.63,Dial_CH,,0,0,0,,冬 冬木同学 那个…
Dialogue: 5,0:15:43.91,0:15:45.55,Dial_CH,,0,0,0,,一起进来吧
Dialogue: 5,0:15:52.92,0:15:54.47,Dial_CH,,0,0,0,,这也是第一次吗
Dialogue: 5,0:15:56.29,0:15:57.39,Dial_CH,,0,0,0,,是的…
Dialogue: 5,0:15:57.60,0:15:58.48,Dial_CH,,0,0,0,,等下
Dialogue: 5,0:15:59.00,0:16:01.40,Dial_CH,,0,0,0,,里面很暖和吧
Dialogue: 5,0:16:01.60,0:16:04.71,Dial_CH,,0,0,0,,里 里面太窄了 冬木同学
Dialogue: 5,0:16:05.41,0:16:07.82,Dial_CH,,0,0,0,,再贴紧一点
Dialogue: 5,0:16:09.20,0:16:11.45,Dial_CH,,0,0,0,,太挤了… 我先出去
Dialogue: 5,0:16:11.45,0:16:13.96,Dial_CH,,0,0,0,,别急啊 这才刚进来
Dialogue: 5,0:16:14.48,0:16:17.50,Dial_CH,,0,0,0,,你别发出怪声啊 冬木同学
Dialogue: 5,0:16:17.71,0:16:21.28,Dial_CH,,0,0,0,,为何 分明没那个意思但对话却如此下流
Dialogue: 5,0:16:21.54,0:16:22.76,Dial_CH,,0,0,0,,小翼
Dialogue: 5,0:16:22.76,0:16:24.23,Dial_CH,,0,0,0,,我甚至幻听了
Dialogue: 5,0:16:24.99,0:16:27.28,Dial_CH,,0,0,0,,冬木同学 我先出来了…
Dialogue: 5,0:16:29.34,0:16:30.78,Dial_CH,,0,0,0,,小翼
Dialogue: 5,0:16:36.72,0:16:39.39,Dial_CH,,0,0,0,,你在那里面做什么呢
Dialogue: 5,0:16:39.39,0:16:41.19,Dial_CH,,0,0,0,,奶奶
Dialogue: 5,0:16:41.48,0:16:43.60,Dial_CH,,0,0,0,,是我听错了吗
Dialogue: 5,0:16:43.60,0:16:44.61,Dial_CH,,0,0,0,,什么时候在的
Dialogue: 5,0:16:44.61,0:16:47.77,Dial_CH,,0,0,0,,我还听见了非常下流的对话
Dialogue: 5,0:16:47.77,0:16:51.16,Dial_CH,,0,0,0,,最不该被听见的全给她听到了
Dialogue: 5,0:16:51.38,0:16:53.06,Dial_CH,,0,0,0,,得赶紧解释
Dialogue: 5,0:16:53.69,0:16:55.24,Dial_CH,,0,0,0,,奶奶 听我说…
Dialogue: 5,0:16:55.24,0:16:57.75,Dial_CH,,0,0,0,,真是的 你怎么这么快就出来了
Dialogue: 5,0:16:58.24,0:17:00.96,Dial_CH,,0,0,0,,第一次就应该细细品味啊
Dialogue: 5,0:17:04.92,0:17:06.98,Dial_CH,,0,0,0,,这老奶奶是你的熟人吗
Dialogue: 5,0:17:10.76,0:17:12.97,Dial_CH,,0,0,0,,是翼的奶奶啊
Dialogue: 5,0:17:12.97,0:17:15.78,Dial_CH,,0,0,0,,初次见面 我叫冬木
Dialogue: 5,0:17:15.78,0:17:18.76,Dial_CH,,0,0,0,,想不到会在这里碰着你
Dialogue: 5,0:17:18.76,0:17:19.72,Dial_CH,,0,0,0,,演歌？
Dialogue: 5,0:17:19.96,0:17:24.73,Dial_CH,,0,0,0,,对了 我还尝了尝奶奶给翼做的便当
Dialogue: 5,0:17:26.35,0:17:28.74,Dial_CH,,0,0,0,,他还让你吃了我做的…
Dialogue: 5,0:17:29.61,0:17:30.90,Dial_CH,,0,0,0,,先别说了 冬木同…
Dialogue: 5,0:17:30.90,0:17:33.30,Dial_CH,,0,0,0,,贼好吃
Dialogue: 5,0:17:33.30,0:17:35.66,Dial_CH,,0,0,0,,您的手艺简直厨神下凡
Dialogue: 5,0:17:37.00,0:17:41.32,Dial_CH,,0,0,0,,都羡慕死翼了 每天都能吃这些
Dialogue: 5,0:17:41.32,0:17:43.17,Dial_CH,,0,0,0,,我也还想再尝尝
Dialogue: 5,0:17:43.40,0:17:44.68,Dial_CH,,0,0,0,,过奖了
Dialogue: 5,0:17:46.07,0:17:48.99,Dial_CH,,0,0,0,,谢谢你的赞美
Dialogue: 5,0:17:48.99,0:17:50.51,Dial_CH,,0,0,0,,不过冬木同学
Dialogue: 5,0:17:50.51,0:17:53.68,Dial_CH,,0,0,0,,你和翼是什么关系
Dialogue: 5,0:17:55.49,0:17:55.97,Dial_CH,,0,0,0,,是朋友…
Dialogue: 5,0:17:55.97,0:17:57.37,Dial_CH,,0,0,0,,只是同班同学
Dialogue: 5,0:17:58.01,0:17:59.54,Dial_CH,,0,0,0,,对吧 冬木同学
Dialogue: 5,0:18:04.04,0:18:04.70,Dial_CH,,0,0,0,,嗯
Dialogue: 5,0:18:05.57,0:18:06.66,Dial_CH,,0,0,0,,对
Dialogue: 5,0:18:11.11,0:18:13.47,Dial_CH,,0,0,0,,雪下起来了
Dialogue: 5,0:18:14.18,0:18:16.11,Dial_CH,,0,0,0,,抱歉了 冬木同学
Dialogue: 5,0:18:16.11,0:18:18.44,Dial_CH,,0,0,0,,你看雪渐渐大起来了
Dialogue: 5,0:18:19.20,0:18:23.13,Dial_CH,,0,0,0,,而且稍后我和翼有要事要处理
Dialogue: 5,0:18:23.13,0:18:25.14,Dial_CH,,0,0,0,,就先告辞了
Dialogue: 5,0:18:25.84,0:18:27.62,Dial_CH,,0,0,0,,走吧 翼
Dialogue: 5,0:18:27.89,0:18:29.15,Dial_CH,,0,0,0,,那 那个…
Dialogue: 5,0:18:29.15,0:18:30.59,Dial_CH,,0,0,0,,冬木同学 抱歉
Dialogue: 5,0:18:31.63,0:18:32.42,Dial_CH,,0,0,0,,再见
Dialogue: 5,0:18:35.15,0:18:37.12,Dial_CH,,0,0,0,,还是不行啊
Dialogue: 5,0:18:37.76,0:18:39.69,Dial_CH,,0,0,0,,我居然如此的无力
Dialogue: 5,0:18:40.21,0:18:43.78,Dial_CH,,0,0,0,,奶奶不喜欢杂乱的朋友关系
Dialogue: 5,0:18:44.98,0:18:48.23,Dial_CH,,0,0,0,,或许我的北海道生活
Dialogue: 5,0:18:48.95,0:18:51.09,Dial_CH,,0,0,0,,就要结束了
Dialogue: 5,0:18:51.47,0:18:53.99,Dial_CH,,0,0,0,,不是 你们真别急着走
Dialogue: 5,0:18:53.99,0:18:55.42,Dial_CH,,0,0,0,,你怎么跟上来了
Dialogue: 5,0:18:55.42,0:18:58.10,Dial_CH,,0,0,0,,因为我看奶奶还撑着伞啊
Dialogue: 5,0:18:58.55,0:19:01.41,Dial_CH,,0,0,0,,下着雪 打伞不是应该的吗
Dialogue: 5,0:19:01.41,0:19:02.54,Dial_CH,,0,0,0,,这怎么行
Dialogue: 5,0:19:03.11,0:19:06.08,Dial_CH,,0,0,0,,您万一不小心摔了也没手撑着
Dialogue: 5,0:19:06.08,0:19:08.34,Dial_CH,,0,0,0,,有可能受重伤的
Dialogue: 5,0:19:08.56,0:19:12.57,Dial_CH,,0,0,0,,我奶奶有次骨折了 就因为她撑着伞
Dialogue: 5,0:19:12.57,0:19:13.55,Dial_CH,,0,0,0,,冬木同学
Dialogue: 5,0:19:13.88,0:19:16.84,Dial_CH,,0,0,0,,而且下雪其实没啥 拍拍就掉了
Dialogue: 5,0:19:19.71,0:19:21.66,Dial_CH,,0,0,0,,你家在哪边
Dialogue: 5,0:19:22.13,0:19:23.47,Dial_CH,,0,0,0,,往前走就到了
Dialogue: 5,0:19:23.72,0:19:26.52,Dial_CH,,0,0,0,,那你们要经过人行横道
Dialogue: 5,0:19:26.97,0:19:29.42,Dial_CH,,0,0,0,,但今天路面结冰 贼滑
Dialogue: 5,0:19:29.42,0:19:30.94,Dial_CH,,0,0,0,,走其他路好一点
Dialogue: 5,0:19:31.65,0:19:34.14,Dial_CH,,0,0,0,,往这边走就安全多了 还近
Dialogue: 5,0:19:34.61,0:19:36.91,Dial_CH,,0,0,0,,我带路 跟我走吧
Dialogue: 5,0:19:37.11,0:19:40.08,Dial_CH,,0,0,0,,奶奶的包我来提吧
Dialogue: 5,0:19:40.31,0:19:41.03,Dial_CH,,0,0,0,,等一等
Dialogue: 5,0:19:41.19,0:19:43.80,Dial_CH,,0,0,0,,您的手能做出那么好吃的菜
Dialogue: 5,0:19:44.03,0:19:46.51,Dial_CH,,0,0,0,,可得保护好了
Dialogue: 5,0:19:49.11,0:19:52.24,Dial_CH,,0,0,0,,冬木同学 东西还是我来拿吧
Dialogue: 5,0:19:52.70,0:19:53.53,Dial_CH,,0,0,0,,那给你
Dialogue: 5,0:19:55.07,0:19:56.53,Dial_CH,,0,0,0,,你是不是生气了
Dialogue: 5,0:19:56.92,0:19:58.08,Dial_CH,,0,0,0,,没有
Dialogue: 5,0:19:58.08,0:20:01.35,Dial_CH,,0,0,0,,你不就一同班同学 我跟你生什么气
Dialogue: 5,0:20:01.35,0:20:02.35,Dial_CH,,0,0,0,,不是 我那是…
Dialogue: 5,0:20:03.30,0:20:05.83,Dial_CH,,0,0,0,,是因为在奶奶面前就不好意思说
Dialogue: 5,0:20:06.15,0:20:07.56,Dial_CH,,0,0,0,,就 那啥
Dialogue: 5,0:20:08.39,0:20:10.69,Dial_CH,,0,0,0,,我觉得你是我珍贵的朋友
Dialogue: 5,0:20:13.22,0:20:16.38,Dial_CH,,0,0,0,,啥呀 我这么宝贵啊
Dialogue: 5,0:20:16.38,0:20:18.48,Dial_CH,,0,0,0,,哎 冬木同学 太大声了
Dialogue: 5,0:20:18.70,0:20:20.24,Dial_CH,,0,600,0,,这样啊
Dialogue: 5,0:20:19.45,0:20:22.36,Dial_CH,,600,0,0,,哎哟 太羞耻了
Dialogue: 5,0:20:29.84,0:20:31.67,Dial_CH,,0,0,0,,我的天…
Dialogue: 5,0:20:31.87,0:20:33.00,Dial_CH,,0,0,0,,冬木同学？
Dialogue: 5,0:20:34.39,0:20:36.58,Dial_CH,,0,0,0,,OKOK 你们还有事吧
Dialogue: 5,0:20:36.58,0:20:38.37,Dial_CH,,0,0,0,,那我先走啦
Dialogue: 5,0:20:38.37,0:20:39.41,Dial_CH,,0,0,0,,稍等
Dialogue: 5,0:20:40.23,0:20:42.67,Dial_CH,,0,0,0,,多亏有你带路 我们更早到家了
Dialogue: 5,0:20:42.67,0:20:45.37,Dial_CH,,0,0,0,,时间就多出来了
Dialogue: 5,0:20:45.64,0:20:47.93,Dial_CH,,0,0,0,,进屋来一杯热茶如何
Dialogue: 5,0:20:48.11,0:20:51.08,Dial_CH,,0,0,0,,可以吗 太好了
Dialogue: 5,0:20:52.05,0:20:54.83,Dial_CH,,0,0,0,,我的棱角也逐渐磨平了啊
Dialogue: 5,0:20:55.81,0:20:58.07,Dial_CH,,0,0,0,,没准说明我老了
Dialogue: 5,0:20:59.36,0:21:02.41,Dial_CH,,0,0,0,,不过她是小翼选的女孩
Dialogue: 5,0:21:02.59,0:21:06.10,Dial_CH,,0,0,0,,冬木同学应当是个好孩子
Dialogue: 5,0:21:06.10,0:21:07.66,Dial_CH,,0,0,0,,天哪
Dialogue: 5,0:21:08.02,0:21:10.24,Dial_CH,,0,0,0,,咋拍都好看
Dialogue: 5,0:21:10.24,0:21:12.25,Dial_CH,,0,0,0,,别到处拍了 冬木同学
Dialogue: 5,0:21:12.25,0:21:16.96,Dial_CH,,0,0,0,,你看 这不是就跟我说的那样 你就是富二代啊
Dialogue: 5,0:21:19.62,0:21:20.68,Dial_CH,,0,0,0,,这张也
Dialogue: 5,0:21:16.96,0:21:19.47,Dial_CH,,0,0,0,,果然还是得留个心眼
Dialogue: 5,0:21:26.29,0:21:28.35,Dial_CH,,0,0,0,,奶奶
Dialogue: 5,0:21:29.01,0:21:31.60,Dial_CH,,0,0,0,,怎么了 小翼
Dialogue: 5,0:21:31.84,0:21:34.74,Dial_CH,,0,0,0,,我一定会努力学习
Dialogue: 5,0:21:34.74,0:21:38.64,Dial_CH,,0,0,0,,长大后出人头地 让奶奶享天伦之乐
Dialogue: 5,0:21:38.64,0:21:39.86,Dial_CH,,0,0,0,,是吗
Dialogue: 5,0:21:39.86,0:21:43.73,Dial_CH,,0,0,0,,小翼真是个认真的好孩子
Dialogue: 5,0:21:46.74,0:21:50.48,Dial_CH,,0,0,0,,好久没看到小翼这样笑了
Dialogue: 5,0:21:51.36,0:21:55.12,Dial_CH,,0,0,0,,就试着相信孙子的笑容吧
Dialogue: 5,0:21:55.94,0:21:58.73,Dial_CH,,0,0,0,,茶泡好了
Dialogue: 5,0:21:59.40,0:22:00.81,Dial_CH,,0,0,0,,谢谢奶奶
Dialogue: 5,0:22:01.48,0:22:03.03,Dial_CH,,0,0,0,,谢谢您
Dialogue: 5,0:23:35.10,0:23:38.98,Dial_CH,,0,0,0,,下面发一下下周滑雪课的指南
Dialogue: 5,0:23:38.98,0:23:41.51,Dial_CH,,0,0,0,,都确认一下自己的座位安排
Dialogue: 5,0:23:44.40,0:23:46.11,Dial_CH,,0,0,0,,我座位在冬木同学后面
Dialogue: 5,0:23:46.69,0:23:47.81,Dial_CH,,0,0,0,,旁边的是
Dialogue: 5,0:23:48.49,0:23:50.12,Dial_CH,,0,0,0,,「秋野」
