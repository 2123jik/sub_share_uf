Dialogue: 0,0:02:11.57,0:02:15.91,Title_CHS,,0,0,0,,{\fad(100,320)\blur5\pos(80,511)}第1话\N北海道辣妹贼拉可爱
Dialogue: 0,0:00:13.09,0:00:15.94,Dial_JP,,0,0,0,,うわ　雪スゲー
Dialogue: 0,0:00:22.65,0:00:24.15,Dial_JP,,0,0,0,,わかったよ　父さん
Dialogue: 0,0:00:27.63,0:00:29.71,Dial_JP,,0,0,0,,ちょっと早く着いちゃったかな
Dialogue: 0,0:00:30.43,0:00:31.43,Dial_JP,,0,0,0,,どうしよ
Dialogue: 0,0:00:36.59,0:00:37.37,Dial_JP,,0,0,0,,あの
Dialogue: 0,0:00:43.29,0:00:45.04,Dial_JP,,0,0,0,,本当にここでいいんかい
Dialogue: 0,0:00:45.44,0:00:47.95,Dial_JP,,0,0,0,,はい　多分もう近いんで
Dialogue: 0,0:00:59.14,0:01:01.42,Dial_JP,,0,0,0,,すごい開放感だな
Dialogue: 0,0:01:02.04,0:01:03.36,Dial_JP,,0,0,0,,誰もいないし
Dialogue: 0,0:01:03.36,0:01:05.56,Dial_JP,,0,0,0,,車も走ってなくて　静かだ
Dialogue: 0,0:01:06.15,0:01:08.99,Dial_JP,,0,0,0,,やっぱ東京とは全然違うよな
Dialogue: 0,0:01:09.76,0:01:12.34,Dial_JP,,0,0,0,,そして　この新鮮な空気
Dialogue: 0,0:01:12.71,0:01:14.85,Dial_JP,,0,0,0,,凍る　肺が凍る
Dialogue: 0,0:01:15.08,0:01:18.41,Dial_JP,,0,0,0,,そっ　それに改めて気付いたけど　寒い
Dialogue: 0,0:01:18.71,0:01:20.48,Dial_JP,,0,0,0,,なんなんだ　この寒さは
Dialogue: 0,0:01:20.80,0:01:23.29,Dial_JP,,0,0,0,,ヤバいぞ　冬の北海道
Dialogue: 0,0:01:27.39,0:01:29.63,Dial_JP,,0,0,0,,さっ　最悪だ
Dialogue: 0,0:01:35.49,0:01:37.70,Dial_JP,,0,0,0,,この時期の北海道に引っ越しは
Dialogue: 0,0:01:37.70,0:01:40.82,Dial_JP,,0,0,0,,失敗だったんじゃないか　父さん
Dialogue: 0,0:01:48.31,0:01:49.61,Dial_JP,,0,0,0,,ヤバいよ
Dialogue: 0,0:01:49.88,0:01:51.87,Dial_JP,,0,0,0,,充電もなくなりそうだ
Dialogue: 0,0:02:06.64,0:02:10.27,Dial_JP,,0,0,0,,ギャルだ　北海道のギャルだ
Dialogue: 0,0:02:14.42,0:02:16.24,Dial_JP,,450,0,0,,ギャ　ギャルだ
Dialogue: 0,0:02:16.97,0:02:18.75,Dial_JP,,0,0,0,,って　こんな死ぬほど寒いのに
Dialogue: 0,0:02:18.75,0:02:19.92,Dial_JP,,0,0,0,,生足だと
Dialogue: 0,0:02:19.92,0:02:22.27,Dial_JP,,0,0,0,,しかも大して厚着もしてないし
Dialogue: 0,0:02:23.41,0:02:26.94,Dial_JP,,0,0,0,,俺なんて結構な重装備でも凍え死にそうなのに
Dialogue: 0,0:02:30.46,0:02:31.28,Dial_JP,,0,0,0,,何
Dialogue: 0,0:02:32.56,0:02:33.12,Dial_JP,,0,0,0,,いや…
Dialogue: 0,0:02:35.68,0:02:36.44,Dial_JP,,0,0,0,,そうだ
Dialogue: 0,0:02:36.68,0:02:39.72,Dial_JP,,0,0,0,,あの　俺　ここに行きたいんですけど
Dialogue: 0,0:02:39.99,0:02:41.36,Dial_JP,,0,0,0,,道わかります
Dialogue: 0,0:02:48.26,0:02:49.46,Dial_JP,,0,0,0,,すごい
Dialogue: 0,0:02:50.24,0:02:51.86,Dial_JP,,0,0,0,,鼻が赤くなってて
Dialogue: 0,0:02:52.11,0:02:53.81,Dial_JP,,0,0,0,,なんかかわいい
Dialogue: 0,0:02:54.08,0:02:55.74,Dial_JP,,0,0,0,,ずうっとあっち
Dialogue: 0,0:02:56.93,0:02:57.95,Dial_JP,,0,0,0,,そうですか
Dialogue: 0,0:02:57.95,0:02:59.37,Dial_JP,,0,0,0,,ありがとうございます
Dialogue: 0,0:03:04.02,0:03:05.53,Dial_JP,,0,0,0,,ヤバかった
Dialogue: 0,0:03:05.53,0:03:07.36,Dial_JP,,0,0,0,,つい見とれてしまった
Dialogue: 0,0:03:07.36,0:03:08.91,Dial_JP,,0,0,0,,ねえ　ちょっと
Dialogue: 0,0:03:09.97,0:03:10.86,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:03:10.86,0:03:12.23,Dial_JP,,0,0,0,,歩いて行く気
Dialogue: 0,0:03:13.01,0:03:14.27,Dial_JP,,0,0,0,,まぁ　はい
Dialogue: 0,0:03:14.27,0:03:16.34,Dial_JP,,0,0,0,,たぶん　３時間はかかるよ
Dialogue: 0,0:03:16.34,0:03:17.72,Dial_JP,,0,0,0,,雪降ってるし
Dialogue: 0,0:03:19.25,0:03:21.36,Dial_JP,,0,0,0,,いや　でも　市内ですよね
Dialogue: 0,0:03:21.63,0:03:23.85,Dial_JP,,0,0,0,,隣町でそんなにかかりますか
Dialogue: 0,0:03:24.06,0:03:24.69,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:03:24.95,0:03:27.15,Dial_JP,,0,0,0,,だって北見なまら広いもん
Dialogue: 0,0:03:31.30,0:03:34.72,Dial_JP,,0,0,0,,完全にタクシー降りる所間違えた
Dialogue: 0,0:03:35.16,0:03:37.98,Dial_JP,,0,0,0,,隣町なら散策しながら行こうとか
Dialogue: 0,0:03:37.98,0:03:40.20,Dial_JP,,0,0,0,,なんて考えだったんだ　俺は
Dialogue: 0,0:03:40.90,0:03:44.14,Dial_JP,,0,0,0,,そうだ　またタクシーを拾えばいいだけじゃないか
Dialogue: 0,0:03:44.14,0:03:46.15,Dial_JP,,0,0,0,,この辺タクシー通らないよ
Dialogue: 0,0:03:51.54,0:03:55.16,Dial_JP,,0,0,0,,でっ　電話で呼んだら　すぐ来ますかね
Dialogue: 0,0:03:55.16,0:03:57.47,Dial_JP,,0,0,0,,運がよければ30分かな
Dialogue: 0,0:03:59.15,0:04:01.95,Dial_JP,,0,0,0,,かっ　完全に詰んだ
Dialogue: 0,0:04:01.95,0:04:03.24,Dial_JP,,0,0,0,,したっけさ
Dialogue: 0,0:04:04.25,0:04:07.08,Dial_JP,,0,0,0,,一緒に待つ　バス
Dialogue: 0,0:04:08.06,0:04:08.78,Dial_JP,,0,0,0,,バス？
Dialogue: 0,0:04:09.02,0:04:11.77,Dial_JP,,0,0,0,,うん　君の行きたい町も回るし
Dialogue: 0,0:04:11.97,0:04:13.53,Dial_JP,,0,0,0,,あと５分で来るよ
Dialogue: 0,0:04:13.53,0:04:14.95,Dial_JP,,0,0,0,,本当ですか
Dialogue: 0,0:04:14.95,0:04:16.40,Dial_JP,,0,0,0,,待ちます　待ちます
Dialogue: 0,0:04:16.66,0:04:18.42,Dial_JP,,0,0,0,,いやぁ　助かった
Dialogue: 0,0:04:18.42,0:04:19.83,Dial_JP,,0,0,0,,あなたがいなかったら
Dialogue: 0,0:04:19.83,0:04:21.95,Dial_JP,,0,0,0,,本気で死んでたかもしれません
Dialogue: 0,0:04:22.18,0:04:23.53,Dial_JP,,0,0,0,,ありがとうございます
Dialogue: 0,0:04:23.95,0:04:26.33,Dial_JP,,0,0,0,,べっ　別になんもだけど
Dialogue: 0,0:04:26.70,0:04:28.62,Dial_JP,,0,0,0,,ねえ　君どっから来たの
Dialogue: 0,0:04:28.94,0:04:30.28,Dial_JP,,0,0,0,,道民じゃないしょ
Dialogue: 0,0:04:30.51,0:04:31.15,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:04:31.42,0:04:33.50,Dial_JP,,0,0,0,,今日　東京から引っ越してきたんです
Dialogue: 0,0:04:33.50,0:04:35.13,Dial_JP,,0,0,0,,とっ　東京
Dialogue: 0,0:04:36.03,0:04:37.03,Dial_JP,,0,0,0,,ええ
Dialogue: 0,0:04:37.03,0:04:38.63,Dial_JP,,0,0,0,,どうしたんだろ　急に
Dialogue: 0,0:04:40.78,0:04:44.04,Dial_JP,,0,0,0,,なんでわざわざ東京からこんなへき地に
Dialogue: 0,0:04:44.04,0:04:45.51,Dial_JP,,0,0,0,,家庭の事情で
Dialogue: 0,0:04:45.81,0:04:47.08,Dial_JP,,0,0,0,,そうなんだ
Dialogue: 0,0:04:47.64,0:04:52.02,Dial_JP,,0,0,0,,したっけ　東京に比べたらなまらわやでしょや　北見なんてさ
Dialogue: 0,0:04:54.18,0:04:55.92,Dial_JP,,0,0,0,,方言がわからん
Dialogue: 0,0:04:57.93,0:05:01.28,Dial_JP,,0,0,0,,ウチらのこと　ダサいとか思ってるしょ
Dialogue: 0,0:05:01.28,0:05:03.54,Dial_JP,,0,0,0,,いや　そんなことないですよ
Dialogue: 0,0:05:05.11,0:05:06.30,Dial_JP,,0,0,0,,むしろ好きです
Dialogue: 0,0:05:07.83,0:05:09.48,Dial_JP,,0,0,0,,というか　落ち着きます
Dialogue: 0,0:05:11.50,0:05:14.49,Dial_JP,,0,0,0,,俺昔からダサいっていじられてて
Dialogue: 0,0:05:14.49,0:05:16.46,Dial_JP,,0,0,0,,モテた試しないしなあ
Dialogue: 0,0:05:16.74,0:05:20.33,Dial_JP,,0,0,0,,東京に住んでてもダサいヤツはダサいんだよなあ
Dialogue: 0,0:05:20.93,0:05:24.08,Dial_JP,,0,0,0,,まだ俺のダサさが知られていないことも含めて
Dialogue: 0,0:05:24.08,0:05:25.44,Dial_JP,,0,0,0,,安心するよ
Dialogue: 0,0:05:29.23,0:05:31.37,Dial_JP,,0,0,0,,なんか君　いいね
Dialogue: 0,0:05:33.04,0:05:34.87,Dial_JP,,0,0,0,,そういえば何歳なの
Dialogue: 0,0:05:34.87,0:05:36.08,Dial_JP,,0,0,0,,16歳です
Dialogue: 0,0:05:37.19,0:05:38.48,Dial_JP,,0,0,0,,ウチと一緒だぁ
Dialogue: 0,0:05:39.08,0:05:40.52,Dial_JP,,0,0,0,,学校ははどこ来るの
Dialogue: 0,0:05:40.52,0:05:42.15,Dial_JP,,0,0,0,,ほっ　北陵高校です
Dialogue: 0,0:05:43.13,0:05:44.08,Dial_JP,,0,0,0,,ウッソォ
Dialogue: 0,0:05:44.08,0:05:44.61,Dial_JP,,0,0,0,,近い
Dialogue: 0,0:05:44.61,0:05:46.33,Dial_JP,,0,0,0,,ウチも北陵高校
Dialogue: 0,0:05:47.55,0:05:49.40,Dial_JP,,0,0,0,,こんなこともあんだねえ
Dialogue: 0,0:05:49.40,0:05:51.46,Dial_JP,,0,0,0,,なまらウケんだけど
Dialogue: 0,0:05:51.66,0:05:52.71,Dial_JP,,0,0,0,,いやっ　何これ
Dialogue: 0,0:05:52.71,0:05:54.01,Dial_JP,,0,0,0,,距離の詰め方
Dialogue: 0,0:05:54.01,0:05:55.92,Dial_JP,,0,0,0,,急　緩急
Dialogue: 0,0:05:55.92,0:05:58.50,Dial_JP,,0,0,0,,あっ　あの　この腕は…
Dialogue: 0,0:05:59.63,0:06:01.29,Dial_JP,,0,0,0,,だって寒いんだもん
Dialogue: 0,0:06:01.88,0:06:02.47,Dial_JP,,0,0,0,,イヤ？
Dialogue: 0,0:06:02.47,0:06:03.80,Dial_JP,,0,0,0,,いやいや　いやいや
Dialogue: 0,0:06:03.80,0:06:06.80,Dial_JP,,0,0,0,,ぜぜ全然嫌じゃないですけど　その…
Dialogue: 0,0:06:07.05,0:06:10.06,Dial_JP,,0,0,0,,柔らかいものが当たっておる
Dialogue: 0,0:06:10.62,0:06:13.01,Dial_JP,,0,0,0,,ねえ　ってかいつまで敬語なの
Dialogue: 0,0:06:13.01,0:06:14.67,Dial_JP,,0,0,0,,もうため口でいいしょや
Dialogue: 0,0:06:14.67,0:06:16.10,Dial_JP,,0,0,0,,いや　まあ…
Dialogue: 0,0:06:16.46,0:06:17.07,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:06:18.11,0:06:19.84,Dial_JP,,0,0,0,,寒いって言うわりに
Dialogue: 0,0:06:19.84,0:06:21.46,Dial_JP,,0,0,0,,手袋しないんだな
Dialogue: 0,0:06:23.14,0:06:23.96,Dial_JP,,0,0,0,,大丈夫
Dialogue: 0,0:06:25.67,0:06:26.62,Dial_JP,,0,0,0,,どうしよ
Dialogue: 0,0:06:27.11,0:06:28.62,Dial_JP,,0,0,0,,はだびずでだ
Dialogue: 0,0:06:31.01,0:06:32.19,Dial_JP,,0,0,0,,なんだこれ
Dialogue: 0,0:06:35.13,0:06:36.19,Dial_JP,,0,0,0,,これ　ティッシュ
Dialogue: 0,0:06:36.65,0:06:37.73,Dial_JP,,0,0,0,,ありがと
Dialogue: 0,0:06:39.54,0:06:41.51,Dial_JP,,0,0,0,,なんかたまんねえっす
Dialogue: 0,0:06:42.30,0:06:47.04,Dial_JP,,0,0,0,,ああ　東京でははこんなふうに女子と話したことなかったなあ
Dialogue: 0,0:06:47.04,0:06:49.53,Dial_JP,,0,0,0,,北海道の女子はみんなこうなのかなあ
Dialogue: 0,0:06:49.29,0:06:51.66,Dial_JP2,,0,0,0,,ねえねえ　おーい
Dialogue: 0,0:06:49.88,0:06:53.17,Dial_JP,,0,0,0,,もしかしたら　北海道なら俺も…
Dialogue: 0,0:06:53.17,0:06:53.85,Dial_JP,,0,0,0,,コラッ
Dialogue: 0,0:06:54.94,0:06:56.54,Dial_JP,,0,0,0,,冷た　冷た　冷たぁ
Dialogue: 0,0:06:56.54,0:06:58.15,Dial_JP,,0,0,0,,何何何したの
Dialogue: 0,0:06:59.37,0:07:00.71,Dial_JP,,0,0,0,,しゃっこいでしょ
Dialogue: 0,0:07:00.71,0:07:02.56,Dial_JP,,0,0,0,,スルーするからだよ
Dialogue: 0,0:07:03.03,0:07:04.49,Dial_JP,,0,0,0,,なんだ　雪か
Dialogue: 0,0:07:04.67,0:07:08.08,Dial_JP,,0,0,0,,いやぁ　いい反応すんね君
Dialogue: 0,0:07:21.04,0:07:21.97,Dial_JP,,0,0,0,,きれいだ
Dialogue: 0,0:07:24.62,0:07:25.76,Dial_JP,,0,0,0,,今のはその…
Dialogue: 0,0:07:26.70,0:07:29.54,Dial_JP,,0,0,0,,ちょっと　やめれよ　そういうの
Dialogue: 0,0:07:30.98,0:07:32.48,Dial_JP,,0,0,0,,わやなんだけど
Dialogue: 0,0:07:41.24,0:07:42.76,Dial_JP,,0,0,0,,ウチもう行くね
Dialogue: 0,0:07:44.92,0:07:45.59,Dial_JP,,0,0,0,,あの
Dialogue: 0,0:07:46.63,0:07:48.53,Dial_JP,,0,0,0,,君　名前は
Dialogue: 0,0:07:54.82,0:07:56.04,Dial_JP,,0,0,0,,冬木美波
Dialogue: 0,0:07:59.47,0:08:01.13,Dial_JP,,0,0,0,,したっけ　学校でね
Dialogue: 0,0:08:16.65,0:08:19.62,Dial_JP,,0,0,0,,冬木　美波　か
Dialogue: 0,0:08:22.33,0:08:24.92,Dial_JP,,0,0,0,,北海道に来てよかったぁ
Dialogue: 0,0:08:31.65,0:08:35.77,Dial_JP,,0,0,0,,しまった　バスに乗るの忘れたぁ
Dialogue: 0,0:08:46.80,0:08:49.12,Dial_JP,,0,0,0,,同じクラスだといいなあ
Dialogue: 0,0:08:55.32,0:08:57.59,Dial_JP,,0,0,0,,みんなに転校生紹介する
Dialogue: 0,0:08:58.11,0:09:00.63,Dial_JP,,0,0,0,,はじめまして　四季翼です
Dialogue: 0,0:09:01.03,0:09:03.44,Dial_JP,,0,0,0,,昨日東京から引っ越してきました
Dialogue: 0,0:09:04.60,0:09:05.94,Dial_JP,,0,0,0,,よろしくお願いします
Dialogue: 0,0:09:08.07,0:09:11.25,Dial_JP,,0,0,0,,では　四季は廊下側のいちばん後ろの席な
Dialogue: 0,0:09:11.77,0:09:12.73,Dial_JP,,0,0,0,,わかりました
Dialogue: 0,0:09:16.68,0:09:18.54,Dial_JP,,0,0,0,,じゃあ　出席とるぞ
Dialogue: 0,0:09:19.76,0:09:23.29,Dial_JP,,0,0,0,,そういえば　あの子　同じクラスじゃないんだ
Dialogue: 0,0:09:25.27,0:09:27.23,Dial_JP,,0,0,0,,まあ　別にいいんだけど
Dialogue: 0,0:09:29.47,0:09:34.18,Dial_JP,,0,0,0,,って　そもそも俺は黒髪清楚で真面目な女の子が好きなんだ
Dialogue: 0,0:09:34.50,0:09:37.49,Dial_JP,,0,0,0,,今まで周りにああいう子がいなかったから刺激的で
Dialogue: 0,0:09:37.49,0:09:40.51,Dial_JP,,0,0,0,,道産子ギャル最高って思っちゃったけど
Dialogue: 0,0:09:43.99,0:09:45.19,Dial_JP,,0,0,0,,さむさむ
Dialogue: 0,0:09:48.19,0:09:49.58,Dial_JP,,0,0,0,,昨日の人じゃん
Dialogue: 0,0:09:49.58,0:09:50.82,Dial_JP,,0,0,0,,超ウケんだけど
Dialogue: 0,0:09:50.82,0:09:52.20,Dial_JP,,0,0,0,,コラ　冬木
Dialogue: 0,0:09:52.20,0:09:54.00,Dial_JP,,0,0,0,,お前はまた遅刻か
Dialogue: 0,0:09:52.65,0:09:55.36,Dial_JP2,,0,0,0,,しかも隣の席とか超ベタじゃん
Dialogue: 0,0:09:56.29,0:09:57.79,Dial_JP,,0,0,0,,同じクラスだったね
Dialogue: 0,0:09:57.79,0:09:59.42,Dial_JP,,0,0,0,,いやいや　ウソだろ
Dialogue: 0,0:09:59.42,0:10:01.89,Dial_JP,,0,0,0,,こんなありきたりな偶然　起きるか
Dialogue: 0,0:10:06.39,0:10:08.40,Dial_JP,,0,0,0,,四季翼っていうんだ
Dialogue: 0,0:10:08.40,0:10:09.80,Dial_JP,,0,0,0,,きれいな名前だね
Dialogue: 0,0:10:09.80,0:10:11.55,Dial_JP,,0,0,0,,そっ　そうかな
Dialogue: 0,0:10:11.55,0:10:12.22,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:10:12.59,0:10:14.17,Dial_JP,,0,0,0,,したっけ　よろしくね
Dialogue: 0,0:10:15.21,0:10:16.64,Dial_JP,,0,0,0,,つばさ
Dialogue: 0,0:10:18.18,0:10:19.74,Dial_JP,,0,0,0,,なっ　名前を
Dialogue: 0,0:10:19.74,0:10:21.61,Dial_JP,,0,0,0,,エグい　エグすぎる
Dialogue: 0,0:10:21.61,0:10:23.10,Dial_JP,,0,0,0,,なんて破壊力なんだ
Dialogue: 0,0:10:23.10,0:10:26.69,Dial_JP,,0,0,0,,名前なんて家族か男友達くらいにしか呼ばれたことないよ
Dialogue: 0,0:10:28.75,0:10:31.53,Dial_JP,,0,0,0,,よっ　よろしく　冬木さん
Dialogue: 0,0:10:35.75,0:10:37.53,Dial_JP,,0,0,0,,三角形の頂点を…
Dialogue: 0,0:10:37.80,0:10:39.38,Dial_JP,,0,0,0,,さっ　寒い
Dialogue: 0,0:10:39.38,0:10:41.29,Dial_JP,,0,0,0,,すんごい寒いんですけど
Dialogue: 0,0:10:41.50,0:10:44.04,Dial_JP,,0,0,0,,なに　ここは冷凍庫なの
Dialogue: 0,0:10:44.04,0:10:46.46,Dial_JP,,0,0,0,,なんでみんな平気で授業受けられるの
Dialogue: 0,0:10:46.46,0:10:50.59,Dial_JP,,0,0,0,,ってよく見たら　みんな上着とかブランケット装備してるじゃん
Dialogue: 0,0:10:50.59,0:10:53.19,Dial_JP,,0,0,0,,完全ににリサーチ不足だった
Dialogue: 0,0:10:53.19,0:10:55.65,Dial_JP,,0,0,0,,このままじゃ風邪ひいてしまうよ
Dialogue: 0,0:10:55.65,0:10:57.56,Dial_JP,,0,0,0,,せめてコートがあれば
Dialogue: 0,0:11:05.06,0:11:06.70,Dial_JP,,0,0,0,,これ　いいの
Dialogue: 0,0:11:06.94,0:11:10.98,Dial_JP,,0,0,0,,うん　ウチ冷え性で２枚重ねて使ってるんだ
Dialogue: 0,0:11:11.58,0:11:12.32,Dial_JP,,0,0,0,,じゃあ…
Dialogue: 0,0:11:12.60,0:11:13.88,Dial_JP,,0,0,0,,大丈夫　大丈夫
Dialogue: 0,0:11:13.88,0:11:16.08,Dial_JP,,0,0,0,,１枚でもも十分ぬくいし
Dialogue: 0,0:11:16.38,0:11:18.28,Dial_JP,,0,0,0,,今日一日　貸したげるよ
Dialogue: 0,0:11:24.53,0:11:26.09,Dial_JP,,0,0,0,,メッチャあったかい
Dialogue: 0,0:11:27.13,0:11:29.67,Dial_JP,,0,0,0,,冬木さんののぬくもりが残ってる
Dialogue: 0,0:11:29.88,0:11:31.95,Dial_JP,,0,0,0,,しかももいい匂いもするし
Dialogue: 0,0:11:32.27,0:11:35.38,Dial_JP,,0,0,0,,まるで冬木さんに包み込まれているような
Dialogue: 0,0:11:37.43,0:11:41.43,Dial_JP,,0,0,0,,だめだ　これ以上は思春期を暴走させることに
Dialogue: 0,0:11:47.35,0:11:48.96,Dial_JP,,0,0,0,,じゃあな　ふゆみな
Dialogue: 0,0:11:50.10,0:11:51.05,Dial_JP,,0,0,0,,冬木さん
Dialogue: 0,0:11:51.99,0:11:53.48,Dial_JP,,0,0,0,,ブランケット　ありがとう
Dialogue: 0,0:11:53.48,0:11:54.53,Dial_JP,,0,0,0,,助かったよ
Dialogue: 0,0:11:59.17,0:12:00.43,Dial_JP,,0,0,0,,匂い嗅ぐの
Dialogue: 0,0:12:00.71,0:12:02.28,Dial_JP,,0,0,0,,そりゃ嗅ぐしょや
Dialogue: 0,0:12:02.56,0:12:03.54,Dial_JP,,0,0,0,,ごめん
Dialogue: 0,0:12:03.54,0:12:05.87,Dial_JP,,0,0,0,,臭かったら洗濯して返すよ
Dialogue: 0,0:12:05.87,0:12:08.18,Dial_JP,,0,0,0,,うんん　そんなことないよ
Dialogue: 0,0:12:08.70,0:12:10.27,Dial_JP,,0,0,0,,ってか　これの匂い
Dialogue: 0,0:12:10.27,0:12:12.48,Dial_JP,,0,0,0,,ウチと翼のが混ざっちゃったね
Dialogue: 0,0:12:12.48,0:12:13.46,Dial_JP,,0,0,0,,まっ　混ざっ
Dialogue: 0,0:12:13.96,0:12:17.33,Dial_JP,,0,0,0,,こっ　この人　狙って言ってるでしょ
Dialogue: 0,0:12:17.33,0:12:19.40,Dial_JP,,0,0,0,,そうだ　ね　翼
Dialogue: 0,0:12:19.79,0:12:21.25,Dial_JP,,0,0,0,,ブランケット貸した
Dialogue: 0,0:12:21.25,0:12:23.37,Dial_JP,,0,0,0,,お礼してもらおっかなあ
Dialogue: 0,0:12:27.17,0:12:29.31,Dial_JP,,0,0,0,,いやぁ　助かったよ
Dialogue: 0,0:12:29.31,0:12:31.87,Dial_JP,,0,0,0,,今日一緒に帰れる人いなかったからさあ
Dialogue: 0,0:12:31.87,0:12:34.43,Dial_JP,,0,0,0,,ちょちょちょっと冬木さん　腕
Dialogue: 0,0:12:34.82,0:12:36.82,Dial_JP,,0,0,0,,ウチと翼の仲じゃん
Dialogue: 0,0:12:36.82,0:12:40.05,Dial_JP,,0,0,0,,いやいや　まだまだ知り合って２日目だけど
Dialogue: 0,0:12:40.44,0:12:43.37,Dial_JP,,0,0,0,,で　冬木さん　家どこなの
Dialogue: 0,0:12:44.77,0:12:47.64,Dial_JP,,0,0,0,,ウチ汽車で帰るから　駅前まででいいよ
Dialogue: 0,0:12:47.88,0:12:48.75,Dial_JP,,0,0,0,,汽車？
Dialogue: 0,0:12:49.16,0:12:51.27,Dial_JP,,0,0,0,,もしかして　電車のこと
Dialogue: 0,0:12:51.27,0:12:54.19,Dial_JP,,0,0,0,,そそ　うちは汽車で呼んでるんだ
Dialogue: 0,0:12:55.52,0:12:58.34,Dial_JP,,0,0,0,,ってかさあ　翼って彼女いるの
Dialogue: 0,0:12:58.34,0:13:00.76,Dial_JP,,0,0,0,,いっ　いないよ
Dialogue: 0,0:13:01.64,0:13:04.31,Dial_JP,,0,0,0,,そんな丸否定するじゃん　ウケる
Dialogue: 0,0:13:04.72,0:13:06.74,Dial_JP,,0,0,0,,東京ではどこにデート行くの
Dialogue: 0,0:13:07.12,0:13:11.77,Dial_JP,,0,0,0,,まあ　原宿とか新大久保とかじゃない
Dialogue: 0,0:13:12.42,0:13:14.01,Dial_JP,,0,0,0,,したことないけど
Dialogue: 0,0:13:14.41,0:13:16.09,Dial_JP,,0,0,0,,渋谷とかは行かないの
Dialogue: 0,0:13:16.09,0:13:17.30,Dial_JP,,0,0,0,,マルキュウとか
Dialogue: 0,0:13:17.30,0:13:19.77,Dial_JP,,0,0,0,,服買いに行く人はいると思うけど
Dialogue: 0,0:13:19.77,0:13:23.57,Dial_JP,,0,0,0,,でも食べ歩きできるとこがいいらしいよ
Dialogue: 0,0:13:23.87,0:13:25.00,Dial_JP,,0,0,0,,行ったことないし
Dialogue: 0,0:13:25.00,0:13:26.68,Dial_JP,,0,0,0,,ネットで見ただけだけど
Dialogue: 0,0:13:26.68,0:13:30.57,Dial_JP,,0,0,0,,いいなあ　東京は遊べる所がいっぱいあって
Dialogue: 0,0:13:30.57,0:13:32.07,Dial_JP,,0,0,0,,そうかなあ
Dialogue: 0,0:13:32.07,0:13:34.13,Dial_JP,,0,0,0,,じゃあ北見ではどこで遊ぶの
Dialogue: 0,0:13:34.48,0:13:38.09,Dial_JP,,0,0,0,,家　特に冬は寒いから外出たくないし
Dialogue: 0,0:13:38.39,0:13:41.02,Dial_JP,,0,0,0,,お互いの家行ったり来たりみたいな
Dialogue: 0,0:13:43.59,0:13:45.30,Dial_JP,,0,0,0,,マ　マジですか
Dialogue: 0,0:13:45.53,0:13:47.24,Dial_JP,,0,0,0,,いきなり家にって
Dialogue: 0,0:13:49.48,0:13:51.49,Dial_JP,,0,0,0,,何考えてるんだ　俺は
Dialogue: 0,0:13:52.11,0:13:53.22,Dial_JP,,0,0,0,,ここでいいよ
Dialogue: 0,0:13:55.27,0:13:57.16,Dial_JP,,0,0,0,,ああ　そうだった
Dialogue: 0,0:13:57.16,0:13:58.61,Dial_JP,,0,0,0,,ありがとね　翼
Dialogue: 0,0:13:59.31,0:14:00.01,Dial_JP,,0,0,0,,いや
Dialogue: 0,0:14:00.37,0:14:01.65,Dial_JP,,0,0,0,,どういたしまして
Dialogue: 0,0:14:02.74,0:14:03.94,Dial_JP,,0,0,0,,それじゃあ　またね
Dialogue: 0,0:14:04.96,0:14:05.77,Dial_JP,,0,0,0,,翼
Dialogue: 0,0:14:06.26,0:14:07.91,Dial_JP,,0,0,0,,明日　うち来る
Dialogue: 0,0:14:10.91,0:14:12.62,Dial_JP,,0,0,0,,明日休みなんだし
Dialogue: 0,0:14:12.62,0:14:13.62,Dial_JP,,0,0,0,,いいしょ
Dialogue: 0,0:14:13.62,0:14:16.49,Dial_JP,,0,0,0,,ほら　東京のこととかもっと聞きたいし
Dialogue: 0,0:14:16.49,0:14:18.34,Dial_JP,,0,0,0,,いやいや　あのう
Dialogue: 0,0:14:18.34,0:14:21.29,Dial_JP,,0,0,0,,ななななんだなんだ　この展開は
Dialogue: 0,0:14:21.29,0:14:22.20,Dial_JP,,0,0,0,,どしたん
Dialogue: 0,0:14:22.64,0:14:23.28,Dial_JP,,0,0,0,,別に
Dialogue: 0,0:14:23.56,0:14:25.55,Dial_JP,,0,0,0,,そんな　でも…
Dialogue: 0,0:14:25.80,0:14:28.53,Dial_JP,,0,0,0,,いきなり女の子の部屋にって…
Dialogue: 0,0:14:29.64,0:14:32.06,Dial_JP,,0,0,0,,うち　来たくない
Dialogue: 0,0:14:32.06,0:14:33.07,Dial_JP,,0,0,0,,行きます
Dialogue: 0,0:14:33.27,0:14:34.84,Dial_JP,,0,0,0,,やったぁ
Dialogue: 0,0:14:34.84,0:14:37.03,Dial_JP,,0,0,0,,ねえねえ　連絡先交換しよ
Dialogue: 0,0:14:43.40,0:14:44.99,Dial_JP,,0,0,0,,それじゃあ　またね
Dialogue: 0,0:14:46.79,0:14:47.84,Dial_JP,,0,0,0,,じゃあね
Dialogue: 0,0:14:54.39,0:14:55.78,Dial_JP,,0,0,0,,来てしまった
Dialogue: 0,0:14:56.66,0:14:58.74,Dial_JP,,0,0,0,,女の子の家に遊びに来たの
Dialogue: 0,0:14:58.74,0:15:00.05,Dial_JP,,0,0,0,,人生初だ
Dialogue: 0,0:15:01.05,0:15:03.72,Dial_JP,,0,0,0,,というかまだ北海道に来て３日目だぞ
Dialogue: 0,0:15:07.16,0:15:10.35,Dial_JP,,0,0,0,,今日のこと家族ににバレたらまずいよな
Dialogue: 0,0:15:11.06,0:15:14.84,Dial_JP,,0,0,0,,でも　誘惑が強すぎた
Dialogue: 0,0:15:16.14,0:15:18.17,Dial_JP,,0,0,0,,道産子ギャル　恐るべし
Dialogue: 0,0:15:18.43,0:15:19.36,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:15:20.44,0:15:21.00,Dial_JP,,0,0,0,,あの…
Dialogue: 0,0:15:21.00,0:15:22.52,Dial_JP,,0,0,0,,四季と申しますが
Dialogue: 0,0:15:22.52,0:15:23.58,Dial_JP,,0,0,0,,美波さんは
Dialogue: 0,0:15:23.91,0:15:25.77,Dial_JP,,0,0,0,,ああ　翼　うちだよ
Dialogue: 0,0:15:25.77,0:15:27.46,Dial_JP,,0,0,0,,開いてるから入っていいよー
Dialogue: 0,0:15:28.79,0:15:29.44,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:15:30.39,0:15:32.55,Dial_JP,,0,0,0,,セキュリティー甘すぎでは
Dialogue: 0,0:15:35.10,0:15:36.62,Dial_JP,,0,0,0,,いらっしゃい
Dialogue: 0,0:15:36.80,0:15:38.50,Dial_JP,,0,0,0,,どっ　どうも
Dialogue: 0,0:15:38.50,0:15:40.05,Dial_JP,,0,0,0,,上がって　上がって
Dialogue: 0,0:15:40.74,0:15:41.93,Dial_JP,,0,0,0,,おじゃまします
Dialogue: 0,0:15:42.39,0:15:45.01,Dial_JP,,0,0,0,,なんて悪魔的な格好なんだ
Dialogue: 0,0:15:45.59,0:15:47.30,Dial_JP,,0,0,0,,翼　ラッキーだね
Dialogue: 0,0:15:48.69,0:15:51.14,Dial_JP,,0,0,0,,今日　ウチの親いないんだ
Dialogue: 0,0:15:53.02,0:15:54.39,Dial_JP,,0,0,0,,こっ　これって
Dialogue: 0,0:15:54.39,0:15:55.74,Dial_JP,,0,0,0,,もっ　もしかして
Dialogue: 0,0:15:55.74,0:15:57.88,Dial_JP,,0,0,0,,いやいや　まさか　そんな
Dialogue: 0,0:15:58.70,0:16:00.92,Dial_JP,,0,0,0,,翼　こっちこっち
Dialogue: 0,0:16:03.52,0:16:04.99,Dial_JP,,0,0,0,,さー　どうぞ
Dialogue: 0,0:16:09.33,0:16:10.49,Dial_JP,,0,0,0,,暖かい
Dialogue: 0,0:16:10.49,0:16:11.69,Dial_JP,,0,0,0,,でしょ
Dialogue: 0,0:16:11.69,0:16:15.29,Dial_JP,,0,0,0,,リビングは床暖だし大きいストーブもあるからね
Dialogue: 0,0:16:15.29,0:16:19.29,Dial_JP,,0,0,0,,ウチの部屋は小さいストーブだけだから寒くてさあ
Dialogue: 0,0:16:19.48,0:16:20.79,Dial_JP,,0,0,0,,なるほど
Dialogue: 0,0:16:20.79,0:16:23.71,Dial_JP,,0,0,0,,親がいなくてラッキーってそういう意味か
Dialogue: 0,0:16:26.32,0:16:28.40,Dial_JP,,0,0,0,,とりあえず　少し安心した
Dialogue: 0,0:16:28.83,0:16:31.92,Dial_JP,,0,0,0,,リビングならそうそう変なことは起きないと思うし
Dialogue: 0,0:16:34.59,0:16:35.68,Dial_JP,,0,0,0,,ウケる
Dialogue: 0,0:16:35.68,0:16:38.07,Dial_JP,,0,0,0,,だだだって今足で
Dialogue: 0,0:16:38.07,0:16:40.07,Dial_JP,,0,0,0,,「ひゃあ」ってかわいい
Dialogue: 0,0:16:41.08,0:16:42.92,Dial_JP,,0,0,0,,さてさて翼
Dialogue: 0,0:16:44.34,0:16:45.69,Dial_JP,,0,0,0,,何しよっか
Dialogue: 0,0:16:47.04,0:16:48.45,Dial_JP,,0,0,0,,何って
Dialogue: 0,0:16:48.45,0:16:50.88,Dial_JP,,0,0,0,,そうだ　飲み物出さなきゃね
Dialogue: 0,0:16:51.73,0:16:52.49,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:16:53.22,0:16:55.47,Dial_JP,,0,0,0,,どれがいいかなあ
Dialogue: 0,0:16:56.31,0:16:58.22,Dial_JP,,0,0,0,,ねえ　翼　カツゲンでいい
Dialogue: 0,0:16:58.83,0:16:59.75,Dial_JP,,0,0,0,,任せるよ
Dialogue: 0,0:17:02.57,0:17:04.42,Dial_JP,,0,0,0,,これがカツゲン
Dialogue: 0,0:17:05.23,0:17:08.68,Dial_JP,,0,0,0,,ウチちゃんこいときからカツゲン大好きなんだよねえ
Dialogue: 0,0:17:09.35,0:17:10.65,Dial_JP,,0,0,0,,そうなんだ
Dialogue: 0,0:17:15.86,0:17:16.79,Dial_JP,,0,0,0,,うまい
Dialogue: 0,0:17:18.05,0:17:20.96,Dial_JP,,0,0,0,,なんか乳酸菌の濃いやつみたいな味だ
Dialogue: 0,0:17:21.80,0:17:23.13,Dial_JP,,0,0,0,,どどどうしたの
Dialogue: 0,0:17:24.24,0:17:28.28,Dial_JP,,0,0,0,,残り少なかったから全部入れちゃえってやったらさあ
Dialogue: 0,0:17:28.47,0:17:31.70,Dial_JP,,0,0,0,,勢いよすぎていっぱいかかったんだけど
Dialogue: 0,0:17:32.70,0:17:35.09,Dial_JP,,0,0,0,,ベットベトでで超最悪
Dialogue: 0,0:17:35.32,0:17:37.12,Dial_JP,,0,0,0,,ちょっと着替えてくる
Dialogue: 0,0:17:40.17,0:17:44.61,Dial_JP,,0,0,0,,危なかった　危うく心がチリと化すところだった
Dialogue: 0,0:17:45.49,0:17:46.39,Dial_JP,,0,0,0,,落ち着け
Dialogue: 0,0:17:46.73,0:17:48.05,Dial_JP,,0,0,0,,落ち着くんだ俺
Dialogue: 0,0:17:51.42,0:17:53.92,Dial_JP,,0,0,0,,やっぱ服選ぶのめんどくさいし
Dialogue: 0,0:17:53.92,0:17:55.55,Dial_JP,,0,0,0,,もうこれでいいや
Dialogue: 0,0:17:55.55,0:17:57.60,Dial_JP,,0,0,0,,魔王降臨
Dialogue: 0,0:17:59.18,0:18:00.25,Dial_JP,,0,0,0,,どしたの
Dialogue: 0,0:18:00.25,0:18:02.22,Dial_JP,,0,0,0,,そっ　その格好は…
Dialogue: 0,0:18:03.95,0:18:05.40,Dial_JP,,0,0,0,,家の中あったかいし
Dialogue: 0,0:18:05.40,0:18:07.36,Dial_JP,,0,0,0,,ふだんもだいたいこんなんだよ
Dialogue: 0,0:18:09.16,0:18:13.18,Dial_JP,,0,0,0,,かっ　買ってまだ見てない映画持ってきたんだけど
Dialogue: 0,0:18:14.35,0:18:16.69,Dial_JP,,0,0,0,,これ　ウチもまだ見てないやつだ
Dialogue: 0,0:18:16.69,0:18:17.79,Dial_JP,,0,0,0,,見よ見よー
Dialogue: 0,0:18:18.52,0:18:20.41,Dial_JP,,0,0,0,,これつけて
Dialogue: 0,0:18:20.41,0:18:22.33,Dial_JP,,0,0,0,,そんでもってこれ入れて
Dialogue: 0,0:18:24.70,0:18:26.12,Dial_JP,,0,0,0,,準備できたよー
Dialogue: 0,0:18:27.39,0:18:28.89,Dial_JP,,0,0,0,,どったの翼
Dialogue: 0,0:18:29.36,0:18:31.89,Dial_JP,,0,0,0,,ううん　なんでももない
Dialogue: 0,0:18:33.30,0:18:35.04,Dial_JP,,0,0,0,,知ってると思うけど
Dialogue: 0,0:18:35.04,0:18:36.93,Dial_JP,,0,0,0,,俺はかなりしつこいぞ
Dialogue: 0,0:18:38.62,0:18:40.56,Dial_JP,,0,0,0,,なんか気まずさが半端ない
Dialogue: 0,0:18:41.25,0:18:42.76,Dial_JP,,0,0,0,,かといってスキップするのも
Dialogue: 0,0:18:42.76,0:18:45.05,Dial_JP,,0,0,0,,変に意識してるみたいで嫌だし
Dialogue: 0,0:18:48.52,0:18:51.15,Dial_JP,,0,0,0,,ちょっと待って　何この声
Dialogue: 0,0:18:51.62,0:18:54.32,Dial_JP,,0,0,0,,まっ　まさか　冬木さん
Dialogue: 0,0:18:54.70,0:18:56.20,Dial_JP,,0,0,0,,そんなウソでしょ
Dialogue: 0,0:18:56.46,0:18:57.66,Dial_JP,,0,0,0,,もしかして　これ見て
Dialogue: 0,0:18:58.28,0:18:59.03,Dial_JP,,0,0,0,,一人で…
Dialogue: 0,0:18:59.28,0:19:01.04,Dial_JP,,0,0,0,,ちょっ　ちょっと待ってえ
Dialogue: 0,0:19:01.40,0:19:03.32,Dial_JP,,0,0,0,,ヤ　ヤバいって　冬木さん
Dialogue: 0,0:19:03.32,0:19:05.93,Dial_JP,,0,0,0,,そんな声出しながら触られたら…
Dialogue: 0,0:19:05.93,0:19:07.13,Dial_JP,,0,0,0,,ダメ
Dialogue: 0,0:19:07.93,0:19:09.73,Dial_JP,,0,0,0,,冬木さん　俺…
Dialogue: 0,0:19:12.34,0:19:13.64,Dial_JP,,0,0,0,,もうダメ
Dialogue: 0,0:19:13.94,0:19:15.96,Dial_JP,,0,0,0,,おなかいっぱい
Dialogue: 0,0:19:21.66,0:19:24.43,Dial_JP,,0,0,0,,それにしても無防備すぎないか
Dialogue: 0,0:19:24.75,0:19:26.26,Dial_JP,,0,0,0,,男子と一緒にいるのに
Dialogue: 0,0:19:26.26,0:19:28.52,Dial_JP,,0,0,0,,そんな格好で寝ちゃうかな　普通
Dialogue: 0,0:19:30.26,0:19:31.99,Dial_JP,,0,0,0,,ああ　そっか
Dialogue: 0,0:19:32.39,0:19:35.78,Dial_JP,,0,0,0,,俺って　男として見られてないのか
Dialogue: 0,0:19:43.09,0:19:43.82,Dial_JP,,0,0,0,,起きた
Dialogue: 0,0:19:44.49,0:19:46.51,Dial_JP,,0,0,0,,あれ　映画は
Dialogue: 0,0:19:46.51,0:19:48.54,Dial_JP,,0,0,0,,ごめん　もう終わっちゃった
Dialogue: 0,0:19:50.05,0:19:52.04,Dial_JP,,0,0,0,,気持ちよさそうに寝てたから
Dialogue: 0,0:19:52.04,0:19:53.64,Dial_JP,,0,0,0,,起こすの悪いかなって
Dialogue: 0,0:19:54.46,0:19:55.86,Dial_JP,,0,0,0,,ブルーレイは置いてくね
Dialogue: 0,0:19:56.34,0:19:58.51,Dial_JP,,0,0,0,,返すのはいつでも大丈夫だから
Dialogue: 0,0:20:01.73,0:20:03.35,Dial_JP,,0,0,0,,あれ　これは
Dialogue: 0,0:20:03.76,0:20:05.53,Dial_JP,,0,0,0,,部屋　暖かいけど
Dialogue: 0,0:20:05.53,0:20:08.13,Dial_JP,,0,0,0,,その格好だと風邪ひいちゃうと思ってさ
Dialogue: 0,0:20:13.45,0:20:14.09,Dial_JP,,0,0,0,,それじゃあ
Dialogue: 0,0:20:14.09,0:20:16.68,Dial_JP,,0,0,0,,暗くなってきたし　俺帰るよ
Dialogue: 0,0:20:17.90,0:20:18.99,Dial_JP,,0,0,0,,おじゃましました
Dialogue: 0,0:20:32.20,0:20:34.30,Dial_JP,,0,0,0,,翼　ちょっと待って
Dialogue: 0,0:20:40.13,0:20:41.34,Dial_JP,,0,0,0,,ごめん　その…
Dialogue: 0,0:20:41.59,0:20:43.81,Dial_JP,,0,0,0,,ウチ　気付いたら寝ちゃってた
Dialogue: 0,0:20:44.18,0:20:47.88,Dial_JP,,0,0,0,,マジ最悪　こんなつもりじゃなかったんだよ
Dialogue: 0,0:20:47.88,0:20:49.72,Dial_JP,,0,0,0,,だから　えっと　またさ
Dialogue: 0,0:20:49.72,0:20:52.03,Dial_JP,,0,0,0,,なんつう格好で外出てんの
Dialogue: 0,0:20:52.03,0:20:53.48,Dial_JP,,0,0,0,,風邪ひくって
Dialogue: 0,0:20:55.80,0:20:56.91,Dial_JP,,400,0,0,,ありがと
Dialogue: 0,0:20:57.85,0:20:59.30,Dial_JP,,0,550,0,,上着も着る
Dialogue: 0,0:20:59.56,0:21:01.29,Dial_JP,,0,550,0,,いや　大丈夫
Dialogue: 0,0:21:01.29,0:21:04.46,Dial_JP,,0,550,0,,いつも軽く外出るくらいならこんなんだし
Dialogue: 0,0:21:04.46,0:21:05.29,Dial_JP,,0,550,0,,それに
Dialogue: 0,0:21:06.38,0:21:08.20,Dial_JP,,0,0,0,,なまらあったかいし
Dialogue: 0,0:21:09.29,0:21:11.68,Dial_JP,,0,0,0,,そっか　よかった
Dialogue: 0,0:21:18.82,0:21:21.64,Dial_JP,,550,0,0,,ねえ翼　おなかすいちゃった
Dialogue: 0,0:21:21.64,0:21:22.92,Dial_JP,,550,0,0,,セコマ行こうよ
Dialogue: 0,0:21:23.35,0:21:24.36,Dial_JP,,0,0,0,,セコマ？
Dialogue: 0,0:21:25.43,0:21:27.61,Dial_JP,,0,0,0,,ウチがおわびにおごってあげるから
Dialogue: 0,0:21:28.00,0:21:28.42,Dial_JP,,0,0,0,,ちょ
Dialogue: 0,0:23:18.08,0:23:18.88,Dial_JP,,0,0,0,,おいしい
Dialogue: 0,0:23:19.19,0:23:21.92,Dial_JP,,0,0,0,,でしょ　ウチこれ大好きなんだ
Dialogue: 0,0:23:27.46,0:23:28.26,Dial_JP,,0,0,0,,ねえねえ
Dialogue: 0,0:23:28.26,0:23:31.01,Dial_JP,,0,0,0,,ここのおにぎり　お店で作ってるんだよ
Dialogue: 0,0:23:31.45,0:23:32.65,Dial_JP,,0,0,0,,ごはん炊いてるの
Dialogue: 0,0:23:32.65,0:23:34.02,Dial_JP,,0,0,0,,すごいっしょ
Dialogue: 0,0:23:44.88,0:23:46.04,Dial_JP,,0,0,0,,こっちもおいし
Dialogue: 0,0:23:47.95,0:23:50.70,Dial_JP,,0,0,0,,つばちゃ　米粒つけちゃって
Dialogue: 0,0:23:50.70,0:23:51.77,Dial_JP,,0,0,0,,子どもみたい
Dialogue: 1,0:00:13.09,0:00:15.94,Dial_CH,,0,0,0,,哇 雪好壮观
Dialogue: 1,0:00:22.65,0:00:24.15,Dial_CH,,0,0,0,,明白了 爸
Dialogue: 1,0:00:27.63,0:00:29.71,Dial_CH,,0,0,0,,是不是到得有点早了
Dialogue: 1,0:00:30.43,0:00:31.43,Dial_CH,,0,0,0,,该怎么办呢
Dialogue: 1,0:00:36.59,0:00:37.37,Dial_CH,,0,0,0,,不好意思
Dialogue: 1,0:00:43.29,0:00:45.04,Dial_CH,,0,0,0,,就停这里真的没问题吗
Dialogue: 1,0:00:45.44,0:00:47.95,Dial_CH,,0,0,0,,嗯 应该很近了
Dialogue: 1,0:00:59.14,0:01:01.42,Dial_CH,,0,0,0,,真的好开阔啊
Dialogue: 1,0:01:02.04,0:01:03.36,Dial_CH,,0,0,0,,附近都没什么人
Dialogue: 1,0:01:03.36,0:01:05.56,Dial_CH,,0,0,0,,也没有什么车经过 真安静
Dialogue: 1,0:01:06.15,0:01:08.99,Dial_CH,,0,0,0,,和东京相比完全不一样啊
Dialogue: 1,0:01:09.76,0:01:12.34,Dial_CH,,0,0,0,,还有这新鲜的空气
Dialogue: 1,0:01:12.71,0:01:14.85,Dial_CH,,0,0,0,,要冻住了 肺要冻住了
Dialogue: 1,0:01:15.08,0:01:18.41,Dial_CH,,0,0,0,,而 而且下了车才感觉到 这里好冷
Dialogue: 1,0:01:18.71,0:01:20.48,Dial_CH,,0,0,0,,怎么会这么冷啊
Dialogue: 1,0:01:20.80,0:01:23.29,Dial_CH,,0,0,0,,冬天的北海道太可怕了
Dialogue: 1,0:01:27.39,0:01:29.63,Dial_CH,,0,0,0,,完 完蛋了
Dialogue: 1,0:01:35.49,0:01:37.70,Dial_CH,,0,0,0,,这个季节搬来北海道
Dialogue: 1,0:01:37.70,0:01:40.82,Dial_CH,,0,0,0,,是不是不太对啊 爸爸
Dialogue: 1,0:01:48.31,0:01:49.61,Dial_CH,,0,0,0,,坏了
Dialogue: 1,0:01:49.88,0:01:51.87,Dial_CH,,0,0,0,,手机也快没电了
Dialogue: 1,0:02:06.64,0:02:10.27,Dial_CH,,0,0,0,,是辣妹 北海道的辣妹
Dialogue: 1,0:02:14.42,0:02:16.24,Dial_CH,,450,0,0,,辣 辣妹
Dialogue: 1,0:02:16.97,0:02:18.75,Dial_CH,,0,0,0,,这种能冻死人的天气里
Dialogue: 1,0:02:18.75,0:02:19.92,Dial_CH,,0,0,0,,竟然裸足
Dialogue: 1,0:02:19.92,0:02:22.27,Dial_CH,,0,0,0,,而且还穿这么少
Dialogue: 1,0:02:23.41,0:02:26.94,Dial_CH,,0,0,0,,我穿得这么多都感觉快要被冻死了
Dialogue: 1,0:02:30.46,0:02:31.28,Dial_CH,,0,0,0,,咋了
Dialogue: 1,0:02:32.56,0:02:33.12,Dial_CH,,0,0,0,,没…
Dialogue: 1,0:02:35.68,0:02:36.44,Dial_CH,,0,0,0,,对了
Dialogue: 1,0:02:36.68,0:02:39.72,Dial_CH,,0,0,0,,那个 我想去这个地方来着
Dialogue: 1,0:02:39.99,0:02:41.36,Dial_CH,,0,0,0,,你知道路吗
Dialogue: 1,0:02:48.26,0:02:49.46,Dial_CH,,0,0,0,,好厉害
Dialogue: 1,0:02:50.24,0:02:51.86,Dial_CH,,0,0,0,,鼻子通红通红
Dialogue: 1,0:02:52.11,0:02:53.81,Dial_CH,,0,0,0,,还挺可爱的
Dialogue: 1,0:02:54.08,0:02:55.74,Dial_CH,,0,0,0,,一直往那边走
Dialogue: 1,0:02:56.93,0:02:57.95,Dial_CH,,0,0,0,,是吗
Dialogue: 1,0:02:57.95,0:02:59.37,Dial_CH,,0,0,0,,谢谢你
Dialogue: 1,0:03:04.02,0:03:05.53,Dial_CH,,0,0,0,,坏了
Dialogue: 1,0:03:05.53,0:03:07.36,Dial_CH,,0,0,0,,一不小心就看呆了
Dialogue: 1,0:03:07.36,0:03:08.91,Dial_CH,,0,0,0,,喂 你等一下
Dialogue: 1,0:03:09.97,0:03:10.86,Dial_CH,,0,0,0,,怎么了
Dialogue: 1,0:03:10.86,0:03:12.23,Dial_CH,,0,0,0,,你准备走过去吗
Dialogue: 1,0:03:13.01,0:03:14.27,Dial_CH,,0,0,0,,嗯 是吧
Dialogue: 1,0:03:14.27,0:03:16.34,Dial_CH,,0,0,0,,估计要走3个小时哦
Dialogue: 1,0:03:16.34,0:03:17.72,Dial_CH,,0,0,0,,而且还下着雪
Dialogue: 1,0:03:19.25,0:03:21.36,Dial_CH,,0,0,0,,不过那里不是也在市内吗
Dialogue: 1,0:03:21.63,0:03:23.85,Dial_CH,,0,0,0,,到隔壁镇子需要这么久吗
Dialogue: 1,0:03:24.06,0:03:24.69,Dial_CH,,0,0,0,,嗯
Dialogue: 1,0:03:24.95,0:03:27.15,Dial_CH,,0,0,0,,因为北见贼大
Dialogue: 1,0:03:31.30,0:03:34.72,Dial_CH,,0,0,0,,完全搞错了下车位置
Dialogue: 1,0:03:35.16,0:03:37.98,Dial_CH,,0,0,0,,既然就在隔壁镇子 不如散散步走过去
Dialogue: 1,0:03:37.98,0:03:40.20,Dial_CH,,0,0,0,,为什么我会有这种想法啊
Dialogue: 1,0:03:40.90,0:03:44.14,Dial_CH,,0,0,0,,对啊 再叫一辆出租车就行了啊
Dialogue: 1,0:03:44.14,0:03:46.15,Dial_CH,,0,0,0,,这附近出租车都不经过的
Dialogue: 1,0:03:51.54,0:03:55.16,Dial_CH,,0,0,0,,打 打电话叫车的话 应该很快就来了吧
Dialogue: 1,0:03:55.16,0:03:57.47,Dial_CH,,0,0,0,,运气好的话大概半小时吧
Dialogue: 1,0:03:59.15,0:04:01.95,Dial_CH,,0,0,0,,没 没辙了
Dialogue: 1,0:04:01.95,0:04:03.24,Dial_CH,,0,0,0,,那
Dialogue: 1,0:04:04.25,0:04:07.08,Dial_CH,,0,0,0,,一起等公交吗
Dialogue: 1,0:04:08.06,0:04:08.78,Dial_CH,,0,0,0,,公交？
Dialogue: 1,0:04:09.02,0:04:11.77,Dial_CH,,0,0,0,,嗯 也经过你要到的镇子
Dialogue: 1,0:04:11.97,0:04:13.53,Dial_CH,,0,0,0,,再等5分钟就来了
Dialogue: 1,0:04:13.53,0:04:14.95,Dial_CH,,0,0,0,,真的吗
Dialogue: 1,0:04:14.95,0:04:16.40,Dial_CH,,0,0,0,,好好好
Dialogue: 1,0:04:16.66,0:04:18.42,Dial_CH,,0,0,0,,得救了
Dialogue: 1,0:04:18.42,0:04:19.83,Dial_CH,,0,0,0,,要不是遇到了你
Dialogue: 1,0:04:19.83,0:04:21.95,Dial_CH,,0,0,0,,我没准真的要死了
Dialogue: 1,0:04:22.18,0:04:23.53,Dial_CH,,0,0,0,,谢谢你
Dialogue: 1,0:04:23.95,0:04:26.33,Dial_CH,,0,0,0,,我 我倒也没做啥
Dialogue: 1,0:04:26.70,0:04:28.62,Dial_CH,,0,0,0,,你从哪来的
Dialogue: 1,0:04:28.94,0:04:30.28,Dial_CH,,0,0,0,,不是北海道的吧
Dialogue: 1,0:04:30.51,0:04:31.15,Dial_CH,,0,0,0,,对
Dialogue: 1,0:04:31.42,0:04:33.50,Dial_CH,,0,0,0,,我今天刚从东京搬过来
Dialogue: 1,0:04:33.50,0:04:35.13,Dial_CH,,0,0,0,,东 东京
Dialogue: 1,0:04:36.03,0:04:37.03,Dial_CH,,0,0,0,,是的
Dialogue: 1,0:04:37.03,0:04:38.63,Dial_CH,,0,0,0,,她这是怎么了
Dialogue: 1,0:04:40.78,0:04:44.04,Dial_CH,,0,0,0,,为什么要大老远从东京搬到这种偏僻的地儿呢
Dialogue: 1,0:04:44.04,0:04:45.51,Dial_CH,,0,0,0,,因为一些家里的原因
Dialogue: 1,0:04:45.81,0:04:47.08,Dial_CH,,0,0,0,,哦
Dialogue: 1,0:04:47.64,0:04:52.02,Dial_CH,,0,0,0,,咱们北见这地儿可比东京差远了
Dialogue: 1,0:04:54.18,0:04:55.92,Dial_CH,,0,0,0,,方言听不懂
Dialogue: 1,0:04:57.93,0:05:01.28,Dial_CH,,0,0,0,,你是不是觉得咱们这儿很土
Dialogue: 1,0:05:01.28,0:05:03.54,Dial_CH,,0,0,0,,没有啊
Dialogue: 1,0:05:05.11,0:05:06.30,Dial_CH,,0,0,0,,我倒还挺喜欢的
Dialogue: 1,0:05:07.83,0:05:09.48,Dial_CH,,0,0,0,,应该说这里的环境令人平静
Dialogue: 1,0:05:11.50,0:05:14.49,Dial_CH,,0,0,0,,我以前一直被别人欺负 都说我土
Dialogue: 1,0:05:14.49,0:05:16.46,Dial_CH,,0,0,0,,从没尝过受人欢迎的滋味
Dialogue: 1,0:05:16.74,0:05:20.33,Dial_CH,,0,0,0,,就算住在东京 土的人就是土
Dialogue: 1,0:05:20.93,0:05:24.08,Dial_CH,,0,0,0,,还好她还没认识到我的土气
Dialogue: 1,0:05:24.08,0:05:25.44,Dial_CH,,0,0,0,,算是安心了
Dialogue: 1,0:05:29.23,0:05:31.37,Dial_CH,,0,0,0,,感觉你人还挺好
Dialogue: 1,0:05:33.04,0:05:34.87,Dial_CH,,0,0,0,,你今年几岁
Dialogue: 1,0:05:34.87,0:05:36.08,Dial_CH,,0,0,0,,16岁
Dialogue: 1,0:05:37.19,0:05:38.48,Dial_CH,,0,0,0,,那不是和我同岁吗
Dialogue: 1,0:05:39.08,0:05:40.52,Dial_CH,,0,0,0,,转学到哪
Dialogue: 1,0:05:40.52,0:05:42.15,Dial_CH,,0,0,0,,北 北陵高中
Dialogue: 1,0:05:43.13,0:05:44.08,Dial_CH,,0,0,0,,不是吧
Dialogue: 1,0:05:44.08,0:05:44.61,Dial_CH,,0,0,0,,好近
Dialogue: 1,0:05:44.61,0:05:46.33,Dial_CH,,0,0,0,,我也是北陵高中的
Dialogue: 1,0:05:47.55,0:05:49.40,Dial_CH,,0,0,0,,真有这种事啊
Dialogue: 1,0:05:49.40,0:05:51.46,Dial_CH,,0,0,0,,贼有意思
Dialogue: 1,0:05:51.66,0:05:52.71,Dial_CH,,0,0,0,,这什么情况
Dialogue: 1,0:05:52.71,0:05:54.01,Dial_CH,,0,0,0,,她怎么这样拉近距离啊
Dialogue: 1,0:05:54.01,0:05:55.92,Dial_CH,,0,0,0,,太快 太快了
Dialogue: 1,0:05:55.92,0:05:58.50,Dial_CH,,0,0,0,,那 那个 你这胳膊是…
Dialogue: 1,0:05:59.63,0:06:01.29,Dial_CH,,0,0,0,,因为冷啊
Dialogue: 1,0:06:01.88,0:06:02.47,Dial_CH,,0,0,0,,不行？
Dialogue: 1,0:06:02.47,0:06:03.80,Dial_CH,,0,0,0,,不不不不
Dialogue: 1,0:06:03.80,0:06:06.80,Dial_CH,,0,0,0,,倒不是不行 就是…
Dialogue: 1,0:06:07.05,0:06:10.06,Dial_CH,,0,0,0,,碰到了软软的东西啊
Dialogue: 1,0:06:10.62,0:06:13.01,Dial_CH,,0,0,0,,还说啥敬语
Dialogue: 1,0:06:13.01,0:06:14.67,Dial_CH,,0,0,0,,随意点呗
Dialogue: 1,0:06:14.67,0:06:16.10,Dial_CH,,0,0,0,,不是 这…
Dialogue: 1,0:06:16.46,0:06:17.07,Dial_CH,,0,0,0,,那好吧
Dialogue: 1,0:06:18.11,0:06:19.84,Dial_CH,,0,0,0,,嘴上说冷
Dialogue: 1,0:06:19.84,0:06:21.46,Dial_CH,,0,0,0,,却连手套都没戴
Dialogue: 1,0:06:23.14,0:06:23.96,Dial_CH,,0,0,0,,没事吧
Dialogue: 1,0:06:25.67,0:06:26.62,Dial_CH,,0,0,0,,咋办呀
Dialogue: 1,0:06:27.11,0:06:28.62,Dial_CH,,0,0,0,,流鼻涕了
Dialogue: 1,0:06:31.01,0:06:32.19,Dial_CH,,0,0,0,,这是什么
Dialogue: 1,0:06:35.13,0:06:36.19,Dial_CH,,0,0,0,,给 纸巾
Dialogue: 1,0:06:36.65,0:06:37.73,Dial_CH,,0,0,0,,谢啦
Dialogue: 1,0:06:39.54,0:06:41.51,Dial_CH,,0,0,0,,想再多看几次
Dialogue: 1,0:06:42.30,0:06:47.04,Dial_CH,,0,0,0,,唉 在东京从来没像这样和女生说过话
Dialogue: 1,0:06:47.04,0:06:49.53,Dial_CH,,0,0,0,,北海道女生都是这样的吗
Dialogue: 1,0:06:49.29,0:06:51.66,Dial_CH2,,0,0,0,,喂喂 在听吗
Dialogue: 1,0:06:49.88,0:06:53.17,Dial_CH,,0,0,0,,难不成 在北海道我也能…
Dialogue: 1,0:06:53.17,0:06:53.85,Dial_CH,,0,0,0,,看招
Dialogue: 1,0:06:54.94,0:06:56.54,Dial_CH,,0,0,0,,好冰好冰好冰
Dialogue: 1,0:06:56.54,0:06:58.15,Dial_CH,,0,0,0,,你你你做了什么
Dialogue: 1,0:06:59.37,0:07:00.71,Dial_CH,,0,0,0,,凉快儿不
Dialogue: 1,0:07:00.71,0:07:02.56,Dial_CH,,0,0,0,,让你不理我
Dialogue: 1,0:07:03.03,0:07:04.49,Dial_CH,,0,0,0,,原来只是雪啊
Dialogue: 1,0:07:04.67,0:07:08.08,Dial_CH,,0,0,0,,哎呀 你这反应真逗
Dialogue: 1,0:07:21.04,0:07:21.97,Dial_CH,,0,0,0,,好美
Dialogue: 1,0:07:24.62,0:07:25.76,Dial_CH,,0,0,0,,我这话意思是…
Dialogue: 1,0:07:26.70,0:07:29.54,Dial_CH,,0,0,0,,能别说这种话不
Dialogue: 1,0:07:30.98,0:07:32.48,Dial_CH,,0,0,0,,胡说八道
Dialogue: 1,0:07:41.24,0:07:42.76,Dial_CH,,0,0,0,,那我先走啦
Dialogue: 1,0:07:44.92,0:07:45.59,Dial_CH,,0,0,0,,那个
Dialogue: 1,0:07:46.63,0:07:48.53,Dial_CH,,0,0,0,,你叫什么名字
Dialogue: 1,0:07:54.82,0:07:56.04,Dial_CH,,0,0,0,,冬木美波
Dialogue: 1,0:07:59.47,0:08:01.13,Dial_CH,,0,0,0,,回头学校见
Dialogue: 1,0:08:16.65,0:08:19.62,Dial_CH,,0,0,0,,叫冬木美波吗
Dialogue: 1,0:08:22.33,0:08:24.92,Dial_CH,,0,0,0,,北海道真是来对了
Dialogue: 1,0:08:31.65,0:08:35.77,Dial_CH,,0,0,0,,坏了 忘了上公交了
Dialogue: 1,0:08:46.80,0:08:49.12,Dial_CH,,0,0,0,,要是同班就好了
Dialogue: 1,0:08:55.32,0:08:57.59,Dial_CH,,0,0,0,,给大家介绍一下新来的同学
Dialogue: 1,0:08:58.11,0:09:00.63,Dial_CH,,0,0,0,,大家好 我叫四季翼
Dialogue: 1,0:09:01.03,0:09:03.44,Dial_CH,,0,0,0,,昨天刚从东京搬家过来
Dialogue: 1,0:09:04.60,0:09:05.94,Dial_CH,,0,0,0,,请大家多多关照
Dialogue: 1,0:09:08.07,0:09:11.25,Dial_CH,,0,0,0,,四季同学就坐走廊边最后一排吧
Dialogue: 1,0:09:11.77,0:09:12.73,Dial_CH,,0,0,0,,好的
Dialogue: 1,0:09:16.68,0:09:18.54,Dial_CH,,0,0,0,,好了 开始点名
Dialogue: 1,0:09:19.76,0:09:23.29,Dial_CH,,0,0,0,,那看来那个女生跟我不是一个班了
Dialogue: 1,0:09:25.27,0:09:27.23,Dial_CH,,0,0,0,,倒也没什么
Dialogue: 1,0:09:29.47,0:09:34.18,Dial_CH,,0,0,0,,再说了 本来我喜欢的就是清纯且做事认真的黑发女孩
Dialogue: 1,0:09:34.50,0:09:37.49,Dial_CH,,0,0,0,,不过只是第一次遇到她那种女生
Dialogue: 1,0:09:37.49,0:09:40.51,Dial_CH,,0,0,0,,有新鲜感 才会觉得北海道辣妹最棒而已
Dialogue: 1,0:09:43.99,0:09:45.19,Dial_CH,,0,0,0,,好冷好冷
Dialogue: 1,0:09:48.19,0:09:49.58,Dial_CH,,0,0,0,,这不昨天那人吗
Dialogue: 1,0:09:49.58,0:09:50.82,Dial_CH,,0,0,0,,逗死我了
Dialogue: 1,0:09:50.82,0:09:52.20,Dial_CH,,0,0,0,,好你个冬木
Dialogue: 1,0:09:52.20,0:09:54.00,Dial_CH,,0,0,0,,你又迟到
Dialogue: 1,0:09:52.65,0:09:55.36,Dial_CH2,,0,0,0,,而且还是邻桌 这也太经典了
Dialogue: 1,0:09:56.29,0:09:57.79,Dial_CH,,0,0,0,,我们同班呢
Dialogue: 1,0:09:57.79,0:09:59.42,Dial_CH,,0,0,0,,不是 这假的吧
Dialogue: 1,0:09:59.42,0:10:01.89,Dial_CH,,0,0,0,,真能这么巧啊
Dialogue: 1,0:10:06.39,0:10:08.40,Dial_CH,,0,0,0,,原来你叫四季翼呀
Dialogue: 1,0:10:08.40,0:10:09.80,Dial_CH,,0,0,0,,名字真好听
Dialogue: 1,0:10:09.80,0:10:11.55,Dial_CH,,0,0,0,,是 是吗
Dialogue: 1,0:10:11.55,0:10:12.22,Dial_CH,,0,0,0,,是哦
Dialogue: 1,0:10:12.59,0:10:14.17,Dial_CH,,0,0,0,,那就请你多多关照啦
Dialogue: 1,0:10:15.21,0:10:16.64,Dial_CH,,0,0,0,,翼
Dialogue: 1,0:10:18.18,0:10:19.74,Dial_CH,,0,0,0,,直 直呼大名
Dialogue: 1,0:10:19.74,0:10:21.61,Dial_CH,,0,0,0,,太猛了 这太猛了
Dialogue: 1,0:10:21.61,0:10:23.10,Dial_CH,,0,0,0,,好强的破坏力
Dialogue: 1,0:10:23.10,0:10:26.69,Dial_CH,,0,0,0,,我这辈子就只被家里人和好兄弟们叫过名字啊
Dialogue: 1,0:10:28.75,0:10:31.53,Dial_CH,,0,0,0,,请 请多关照 冬木同学
Dialogue: 1,0:10:35.75,0:10:37.53,Dial_CH,,0,0,0,,三角形的顶点…
Dialogue: 1,0:10:37.80,0:10:39.38,Dial_CH,,0,0,0,,好 好冷
Dialogue: 1,0:10:39.38,0:10:41.29,Dial_CH,,0,0,0,,怎么会这么冷
Dialogue: 1,0:10:41.50,0:10:44.04,Dial_CH,,0,0,0,,这里是冰柜吗
Dialogue: 1,0:10:44.04,0:10:46.46,Dial_CH,,0,0,0,,为什么大家都能若无其事地听课
Dialogue: 1,0:10:46.46,0:10:50.59,Dial_CH,,0,0,0,,仔细一看 大家要么披着外衣要么搭着毯子
Dialogue: 1,0:10:50.59,0:10:53.19,Dial_CH,,0,0,0,,是我大意了
Dialogue: 1,0:10:53.19,0:10:55.65,Dial_CH,,0,0,0,,这样下去会冻感冒的
Dialogue: 1,0:10:55.65,0:10:57.56,Dial_CH,,0,0,0,,哪怕有件大衣也好
Dialogue: 1,0:11:05.06,0:11:06.70,Dial_CH,,0,0,0,,你不用吗
Dialogue: 1,0:11:06.94,0:11:10.98,Dial_CH,,0,0,0,,没事 我怕冷所以平时都盖两层
Dialogue: 1,0:11:11.58,0:11:12.32,Dial_CH,,0,0,0,,那你…
Dialogue: 1,0:11:12.60,0:11:13.88,Dial_CH,,0,0,0,,没事没事
Dialogue: 1,0:11:13.88,0:11:16.08,Dial_CH,,0,0,0,,一块就够暖和了
Dialogue: 1,0:11:16.38,0:11:18.28,Dial_CH,,0,0,0,,那块就先借你一天
Dialogue: 1,0:11:24.53,0:11:26.09,Dial_CH,,0,0,0,,巨暖和
Dialogue: 1,0:11:27.13,0:11:29.67,Dial_CH,,0,0,0,,上面还有冬木同学的余温
Dialogue: 1,0:11:29.88,0:11:31.95,Dial_CH,,0,0,0,,还有好闻的味道
Dialogue: 1,0:11:32.27,0:11:35.38,Dial_CH,,0,0,0,,就像被冬木同学包围了一样
Dialogue: 1,0:11:37.43,0:11:41.43,Dial_CH,,0,0,0,,不行 再想下去就要青春期勃发了
Dialogue: 1,0:11:47.35,0:11:48.96,Dial_CH,,0,0,0,,拜拜冬美
Dialogue: 1,0:11:50.10,0:11:51.05,Dial_CH,,0,0,0,,冬木同学
Dialogue: 1,0:11:51.99,0:11:53.48,Dial_CH,,0,0,0,,谢谢你借我毯子
Dialogue: 1,0:11:53.48,0:11:54.53,Dial_CH,,0,0,0,,真是雪中送炭
Dialogue: 1,0:11:59.17,0:12:00.43,Dial_CH,,0,0,0,,怎么还闻
Dialogue: 1,0:12:00.71,0:12:02.28,Dial_CH,,0,0,0,,那肯定要闻的呀
Dialogue: 1,0:12:02.56,0:12:03.54,Dial_CH,,0,0,0,,抱歉
Dialogue: 1,0:12:03.54,0:12:05.87,Dial_CH,,0,0,0,,你觉得难闻的话我洗洗再还你
Dialogue: 1,0:12:05.87,0:12:08.18,Dial_CH,,0,0,0,,不会不会 没那回事儿
Dialogue: 1,0:12:08.70,0:12:10.27,Dial_CH,,0,0,0,,它闻起来
Dialogue: 1,0:12:10.27,0:12:12.48,Dial_CH,,0,0,0,,混了你和我的味儿
Dialogue: 1,0:12:12.48,0:12:13.46,Dial_CH,,0,0,0,,混 混…
Dialogue: 1,0:12:13.96,0:12:17.33,Dial_CH,,0,0,0,,这 这人 故意这么说的吧
Dialogue: 1,0:12:17.33,0:12:19.40,Dial_CH,,0,0,0,,哦对了 翼
Dialogue: 1,0:12:19.79,0:12:21.25,Dial_CH,,0,0,0,,我借了你毯子
Dialogue: 1,0:12:21.25,0:12:23.37,Dial_CH,,0,0,0,,你得给我回个礼吧
Dialogue: 1,0:12:27.17,0:12:29.31,Dial_CH,,0,0,0,,太好了
Dialogue: 1,0:12:29.31,0:12:31.87,Dial_CH,,0,0,0,,本来今天都没人陪我回家了
Dialogue: 1,0:12:31.87,0:12:34.43,Dial_CH,,0,0,0,,那那那个 冬木同学 胳膊
Dialogue: 1,0:12:34.82,0:12:36.82,Dial_CH,,0,0,0,,咱俩谁跟谁呀
Dialogue: 1,0:12:36.82,0:12:40.05,Dial_CH,,0,0,0,,不是 我们不才认识两天不到吗
Dialogue: 1,0:12:40.44,0:12:43.37,Dial_CH,,0,0,0,,话说 冬木同学家住在哪
Dialogue: 1,0:12:44.77,0:12:47.64,Dial_CH,,0,0,0,,我坐火车回 你陪到车站就行
Dialogue: 1,0:12:47.88,0:12:48.75,Dial_CH,,0,0,0,,火车？
Dialogue: 1,0:12:49.16,0:12:51.27,Dial_CH,,0,0,0,,你说的难道是电车吗
Dialogue: 1,0:12:51.27,0:12:54.19,Dial_CH,,0,0,0,,对对 我都把那玩意叫成火车
Dialogue: 1,0:12:55.52,0:12:58.34,Dial_CH,,0,0,0,,话说你有女朋友吗
Dialogue: 1,0:12:58.34,0:13:00.76,Dial_CH,,0,0,0,,没 没有啊
Dialogue: 1,0:13:01.64,0:13:04.31,Dial_CH,,0,0,0,,否定得好彻底 真逗
Dialogue: 1,0:13:04.72,0:13:06.74,Dial_CH,,0,0,0,,东京人一般会去哪儿约会呢
Dialogue: 1,0:13:07.12,0:13:11.77,Dial_CH,,0,0,0,,原宿 新大久保这些地方吧
Dialogue: 1,0:13:12.42,0:13:14.01,Dial_CH,,0,0,0,,虽然我没约会过
Dialogue: 1,0:13:14.41,0:13:16.09,Dial_CH,,0,0,0,,不去涩谷之类的吗
Dialogue: 1,0:13:16.09,0:13:17.30,Dial_CH,,0,0,0,,像09这种
Dialogue: 1,0:13:17.30,0:13:19.77,Dial_CH,,0,0,0,,去那里应该都是去买衣服的
Dialogue: 1,0:13:19.77,0:13:23.57,Dial_CH,,0,0,0,,但约会应该都会去能边逛边吃的地方吧
Dialogue: 1,0:13:23.87,0:13:25.00,Dial_CH,,0,0,0,,虽然我没去过
Dialogue: 1,0:13:25.00,0:13:26.68,Dial_CH,,0,0,0,,只是网上看到的
Dialogue: 1,0:13:26.68,0:13:30.57,Dial_CH,,0,0,0,,真好啊 东京能玩儿的地方多
Dialogue: 1,0:13:30.57,0:13:32.07,Dial_CH,,0,0,0,,是吗
Dialogue: 1,0:13:32.07,0:13:34.13,Dial_CH,,0,0,0,,那北见有好玩的地方吗
Dialogue: 1,0:13:34.48,0:13:38.09,Dial_CH,,0,0,0,,家里 而且冬天太冷不想出门
Dialogue: 1,0:13:38.39,0:13:41.02,Dial_CH,,0,0,0,,都是去朋友家 要不就请朋友来家里
Dialogue: 1,0:13:43.59,0:13:45.30,Dial_CH,,0,0,0,,真 真的假的
Dialogue: 1,0:13:45.53,0:13:47.24,Dial_CH,,0,0,0,,直接进家门吗
Dialogue: 1,0:13:49.48,0:13:51.49,Dial_CH,,0,0,0,,我在想些什么
Dialogue: 1,0:13:52.11,0:13:53.22,Dial_CH,,0,0,0,,到这儿就好了
Dialogue: 1,0:13:55.27,0:13:57.16,Dial_CH,,0,0,0,,哦 到了啊
Dialogue: 1,0:13:57.16,0:13:58.61,Dial_CH,,0,0,0,,谢谢你 翼
Dialogue: 1,0:13:59.31,0:14:00.01,Dial_CH,,0,0,0,,没事
Dialogue: 1,0:14:00.37,0:14:01.65,Dial_CH,,0,0,0,,不用客气
Dialogue: 1,0:14:02.74,0:14:03.94,Dial_CH,,0,0,0,,再见
Dialogue: 1,0:14:04.96,0:14:05.77,Dial_CH,,0,0,0,,翼
Dialogue: 1,0:14:06.26,0:14:07.91,Dial_CH,,0,0,0,,明天来我家不
Dialogue: 1,0:14:10.91,0:14:12.62,Dial_CH,,0,0,0,,明天不上课啊
Dialogue: 1,0:14:12.62,0:14:13.62,Dial_CH,,0,0,0,,不是正好吗
Dialogue: 1,0:14:13.62,0:14:16.49,Dial_CH,,0,0,0,,我还想多听你唠唠东京的事儿
Dialogue: 1,0:14:16.49,0:14:18.34,Dial_CH,,0,0,0,,不不不不 等一等
Dialogue: 1,0:14:18.34,0:14:21.29,Dial_CH,,0,0,0,,这这这是什么情况
Dialogue: 1,0:14:21.29,0:14:22.20,Dial_CH,,0,0,0,,咋了
Dialogue: 1,0:14:22.64,0:14:23.28,Dial_CH,,0,0,0,,没什么
Dialogue: 1,0:14:23.56,0:14:25.55,Dial_CH,,0,0,0,,就是 但是…
Dialogue: 1,0:14:25.80,0:14:28.53,Dial_CH,,0,0,0,,突然叫我去女生房间也太…
Dialogue: 1,0:14:29.64,0:14:32.06,Dial_CH,,0,0,0,,你不乐意来吗
Dialogue: 1,0:14:32.06,0:14:33.07,Dial_CH,,0,0,0,,我去
Dialogue: 1,0:14:33.27,0:14:34.84,Dial_CH,,0,0,0,,好
Dialogue: 1,0:14:34.84,0:14:37.03,Dial_CH,,0,0,0,,留个联系方式呗
Dialogue: 1,0:14:43.40,0:14:44.99,Dial_CH,,0,0,0,,明天见咯
Dialogue: 1,0:14:46.79,0:14:47.84,Dial_CH,,0,0,0,,再见
Dialogue: 1,0:14:54.39,0:14:55.78,Dial_CH,,0,0,0,,真的来了
Dialogue: 1,0:14:56.66,0:14:58.74,Dial_CH,,0,0,0,,我要进女生家里玩了
Dialogue: 1,0:14:58.74,0:15:00.05,Dial_CH,,0,0,0,,此生第一回
Dialogue: 1,0:15:01.05,0:15:03.72,Dial_CH,,0,0,0,,而且这还是刚搬来北海道第三天
Dialogue: 1,0:15:07.16,0:15:10.35,Dial_CH,,0,0,0,,这事让家里知道了我就完了
Dialogue: 1,0:15:11.06,0:15:14.84,Dial_CH,,0,0,0,,可这诱惑力太大了
Dialogue: 1,0:15:16.14,0:15:18.17,Dial_CH,,0,0,0,,北海道辣妹恐怖如斯
Dialogue: 1,0:15:18.43,0:15:19.36,Dial_CH,,0,0,0,,你好
Dialogue: 1,0:15:20.44,0:15:21.00,Dial_CH,,0,0,0,,那个…
Dialogue: 1,0:15:21.00,0:15:22.52,Dial_CH,,0,0,0,,我叫四季
Dialogue: 1,0:15:22.52,0:15:23.58,Dial_CH,,0,0,0,,请问美波同学在吗
Dialogue: 1,0:15:23.91,0:15:25.77,Dial_CH,,0,0,0,,哦 翼啊 是我
Dialogue: 1,0:15:25.77,0:15:27.46,Dial_CH,,0,0,0,,门开着的 直接进吧
Dialogue: 1,0:15:28.79,0:15:29.44,Dial_CH,,0,0,0,,好
Dialogue: 1,0:15:30.39,0:15:32.55,Dial_CH,,0,0,0,,太不安全了吧
Dialogue: 1,0:15:35.10,0:15:36.62,Dial_CH,,0,0,0,,欢迎欢迎
Dialogue: 1,0:15:36.80,0:15:38.50,Dial_CH,,0,0,0,,你 你好
Dialogue: 1,0:15:38.50,0:15:40.05,Dial_CH,,0,0,0,,快进来吧
Dialogue: 1,0:15:40.74,0:15:41.93,Dial_CH,,0,0,0,,打扰了
Dialogue: 1,0:15:42.39,0:15:45.01,Dial_CH,,0,0,0,,她这身打扮 太恶魔了
Dialogue: 1,0:15:45.59,0:15:47.30,Dial_CH,,0,0,0,,你运气挺好
Dialogue: 1,0:15:48.69,0:15:51.14,Dial_CH,,0,0,0,,咱爸妈今天不在家
Dialogue: 1,0:15:53.02,0:15:54.39,Dial_CH,,0,0,0,,这 这
Dialogue: 1,0:15:54.39,0:15:55.74,Dial_CH,,0,0,0,,难 难道就是
Dialogue: 1,0:15:55.74,0:15:57.88,Dial_CH,,0,0,0,,不不不 怎么可能呢
Dialogue: 1,0:15:58.70,0:16:00.92,Dial_CH,,0,0,0,,翼 快来
Dialogue: 1,0:16:03.52,0:16:04.99,Dial_CH,,0,0,0,,请进吧
Dialogue: 1,0:16:09.33,0:16:10.49,Dial_CH,,0,0,0,,好暖和
Dialogue: 1,0:16:10.49,0:16:11.69,Dial_CH,,0,0,0,,对吧
Dialogue: 1,0:16:11.69,0:16:15.29,Dial_CH,,0,0,0,,客厅有地暖 而且还有大暖炉
Dialogue: 1,0:16:15.29,0:16:19.29,Dial_CH,,0,0,0,,咱自己房间里就一个小暖炉 冷得不行
Dialogue: 1,0:16:19.48,0:16:20.79,Dial_CH,,0,0,0,,这样啊
Dialogue: 1,0:16:20.79,0:16:23.71,Dial_CH,,0,0,0,,说我运气好是这个意思啊
Dialogue: 1,0:16:26.32,0:16:28.40,Dial_CH,,0,0,0,,这下多少是安心了
Dialogue: 1,0:16:28.83,0:16:31.92,Dial_CH,,0,0,0,,在客厅里应该不会发生什么奇怪的事
Dialogue: 1,0:16:34.59,0:16:35.68,Dial_CH,,0,0,0,,真逗
Dialogue: 1,0:16:35.68,0:16:38.07,Dial_CH,,0,0,0,,因因因为你用脚碰我
Dialogue: 1,0:16:38.07,0:16:40.07,Dial_CH,,0,0,0,,尖叫声好可爱
Dialogue: 1,0:16:41.08,0:16:42.92,Dial_CH,,0,0,0,,翼啊
Dialogue: 1,0:16:44.34,0:16:45.69,Dial_CH,,0,0,0,,咱们做点什么呢
Dialogue: 1,0:16:47.04,0:16:48.45,Dial_CH,,0,0,0,,做什么
Dialogue: 1,0:16:48.45,0:16:50.88,Dial_CH,,0,0,0,,对了 得拿点饮料给你
Dialogue: 1,0:16:51.73,0:16:52.49,Dial_CH,,0,0,0,,嗯
Dialogue: 1,0:16:53.22,0:16:55.47,Dial_CH,,0,0,0,,拿点什么好呢
Dialogue: 1,0:16:56.31,0:16:58.22,Dial_CH,,0,0,0,,翼 活源行不
Dialogue: 1,0:16:58.83,0:16:59.75,Dial_CH,,0,0,0,,我都行
Dialogue: 1,0:17:02.57,0:17:04.42,Dial_CH,,0,0,0,,这就是活源
Dialogue: 1,0:17:05.23,0:17:08.68,Dial_CH,,0,0,0,,咱打小就老爱喝活源了
Dialogue: 1,0:17:09.35,0:17:10.65,Dial_CH,,0,0,0,,这样啊
Dialogue: 1,0:17:15.86,0:17:16.79,Dial_CH,,0,0,0,,好喝
Dialogue: 1,0:17:18.05,0:17:20.96,Dial_CH,,0,0,0,,感觉有股浓浓的乳酸菌味
Dialogue: 1,0:17:21.80,0:17:23.13,Dial_CH,,0,0,0,,怎怎怎么了
Dialogue: 1,0:17:24.24,0:17:28.28,Dial_CH,,0,0,0,,咱想着没多少了 就全都倒完的
Dialogue: 1,0:17:28.47,0:17:31.70,Dial_CH,,0,0,0,,结果倒太猛全撒出来了
Dialogue: 1,0:17:32.70,0:17:35.09,Dial_CH,,0,0,0,,黏答答的 贼难受
Dialogue: 1,0:17:35.32,0:17:37.12,Dial_CH,,0,0,0,,我先去换身衣服
Dialogue: 1,0:17:40.17,0:17:44.61,Dial_CH,,0,0,0,,好险 差点心脏都碎成渣了
Dialogue: 1,0:17:45.49,0:17:46.39,Dial_CH,,0,0,0,,冷静
Dialogue: 1,0:17:46.73,0:17:48.05,Dial_CH,,0,0,0,,快冷静
Dialogue: 1,0:17:51.42,0:17:53.92,Dial_CH,,0,0,0,,挑衣服太麻烦了
Dialogue: 1,0:17:53.92,0:17:55.55,Dial_CH,,0,0,0,,就这样吧
Dialogue: 1,0:17:55.55,0:17:57.60,Dial_CH,,0,0,0,,魔王降世啊
Dialogue: 1,0:17:59.18,0:18:00.25,Dial_CH,,0,0,0,,咋了这是
Dialogue: 1,0:18:00.25,0:18:02.22,Dial_CH,,0,0,0,,你 你这样穿…
Dialogue: 1,0:18:03.95,0:18:05.40,Dial_CH,,0,0,0,,家里又不冷
Dialogue: 1,0:18:05.40,0:18:07.36,Dial_CH,,0,0,0,,而且平时在家就这样穿的
Dialogue: 1,0:18:09.16,0:18:13.18,Dial_CH,,0,0,0,,我 我带了部电影 还没看过的
Dialogue: 1,0:18:14.35,0:18:16.69,Dial_CH,,0,0,0,,这部我也还没看过
Dialogue: 1,0:18:16.69,0:18:17.79,Dial_CH,,0,0,0,,一起看吧
Dialogue: 1,0:18:18.52,0:18:20.41,Dial_CH,,0,0,0,,先把这个打开
Dialogue: 1,0:18:20.41,0:18:22.33,Dial_CH,,0,0,0,,再把碟放进去
Dialogue: 1,0:18:24.70,0:18:26.12,Dial_CH,,0,0,0,,搞定了
Dialogue: 1,0:18:27.39,0:18:28.89,Dial_CH,,0,0,0,,你又咋了 翼
Dialogue: 1,0:18:29.36,0:18:31.89,Dial_CH,,0,0,0,,没 没事
Dialogue: 1,0:18:33.30,0:18:35.04,Dial_CH,,0,0,0,,想必你也知道
Dialogue: 1,0:18:35.04,0:18:36.93,Dial_CH,,0,0,0,,我这人不轻易放手的
Dialogue: 1,0:18:38.62,0:18:40.56,Dial_CH,,0,0,0,,看这个也太尴尬了
Dialogue: 1,0:18:41.25,0:18:42.76,Dial_CH,,0,0,0,,不过现在按快进
Dialogue: 1,0:18:42.76,0:18:45.05,Dial_CH,,0,0,0,,就给人感觉是我想歪了 也不行
Dialogue: 1,0:18:48.52,0:18:51.15,Dial_CH,,0,0,0,,等等 这是什么声音
Dialogue: 1,0:18:51.62,0:18:54.32,Dial_CH,,0,0,0,,难 难道说 冬木同学她
Dialogue: 1,0:18:54.70,0:18:56.20,Dial_CH,,0,0,0,,不会吧
Dialogue: 1,0:18:56.46,0:18:57.66,Dial_CH,,0,0,0,,别是看着看着
Dialogue: 1,0:18:58.28,0:18:59.03,Dial_CH,,0,0,0,,就自己…
Dialogue: 1,0:18:59.28,0:19:01.04,Dial_CH,,0,0,0,,不 不是 停一停
Dialogue: 1,0:19:01.40,0:19:03.32,Dial_CH,,0,0,0,,这 这可不行 冬木同学
Dialogue: 1,0:19:03.32,0:19:05.93,Dial_CH,,0,0,0,,边发出这种声音边摸我的话…
Dialogue: 1,0:19:05.93,0:19:07.13,Dial_CH,,0,0,0,,不行
Dialogue: 1,0:19:07.93,0:19:09.73,Dial_CH,,0,0,0,,冬木同学 我…
Dialogue: 1,0:19:12.34,0:19:13.64,Dial_CH,,0,0,0,,吃不下了
Dialogue: 1,0:19:13.94,0:19:15.96,Dial_CH,,0,0,0,,太撑了
Dialogue: 1,0:19:21.66,0:19:24.43,Dial_CH,,0,0,0,,你也太没有防人之心了吧
Dialogue: 1,0:19:24.75,0:19:26.26,Dial_CH,,0,0,0,,正常来说和男生共处一室
Dialogue: 1,0:19:26.26,0:19:28.52,Dial_CH,,0,0,0,,真有人会穿成这样睡着吗
Dialogue: 1,0:19:30.26,0:19:31.99,Dial_CH,,0,0,0,,哦 懂了
Dialogue: 1,0:19:32.39,0:19:35.78,Dial_CH,,0,0,0,,她可能根本就没把我当成男生
Dialogue: 1,0:19:43.09,0:19:43.82,Dial_CH,,0,0,0,,你醒了
Dialogue: 1,0:19:44.49,0:19:46.51,Dial_CH,,0,0,0,,咦 电影呢
Dialogue: 1,0:19:46.51,0:19:48.54,Dial_CH,,0,0,0,,抱歉 已经放完了
Dialogue: 1,0:19:50.05,0:19:52.04,Dial_CH,,0,0,0,,看你睡得这么香
Dialogue: 1,0:19:52.04,0:19:53.64,Dial_CH,,0,0,0,,也不好意思叫醒你
Dialogue: 1,0:19:54.46,0:19:55.86,Dial_CH,,0,0,0,,光碟就放你家了
Dialogue: 1,0:19:56.34,0:19:58.51,Dial_CH,,0,0,0,,之后再还给我就行
Dialogue: 1,0:20:01.73,0:20:03.35,Dial_CH,,0,0,0,,这是啥
Dialogue: 1,0:20:03.76,0:20:05.53,Dial_CH,,0,0,0,,虽然屋子里很暖和
Dialogue: 1,0:20:05.53,0:20:08.13,Dial_CH,,0,0,0,,但是穿那么少也还是会感冒的
Dialogue: 1,0:20:13.45,0:20:14.09,Dial_CH,,0,0,0,,拜拜
Dialogue: 1,0:20:14.09,0:20:16.68,Dial_CH,,0,0,0,,天也快黑了 我先回去了
Dialogue: 1,0:20:17.90,0:20:18.99,Dial_CH,,0,0,0,,谢谢你的招待
Dialogue: 1,0:20:32.20,0:20:34.30,Dial_CH,,0,0,0,,翼 先别走
Dialogue: 1,0:20:40.13,0:20:41.34,Dial_CH,,0,0,0,,对不起 我…
Dialogue: 1,0:20:41.59,0:20:43.81,Dial_CH,,0,0,0,,我一个不留神就睡着了
Dialogue: 1,0:20:44.18,0:20:47.88,Dial_CH,,0,0,0,,我也不想的 烦死了 但真不是故意的
Dialogue: 1,0:20:47.88,0:20:49.72,Dial_CH,,0,0,0,,所以那个 下回
Dialogue: 1,0:20:49.72,0:20:52.03,Dial_CH,,0,0,0,,你怎么穿成这样就跑出来了
Dialogue: 1,0:20:52.03,0:20:53.48,Dial_CH,,0,0,0,,说了会感冒的
Dialogue: 1,0:20:55.80,0:20:56.91,Dial_CH,,400,0,0,,谢 谢谢
Dialogue: 1,0:20:57.85,0:20:59.30,Dial_CH,,0,550,0,,不然外套也给你吧
Dialogue: 1,0:20:59.56,0:21:01.29,Dial_CH,,0,550,0,,不了吧
Dialogue: 1,0:21:01.29,0:21:04.46,Dial_CH,,0,550,0,,平时临时出门也是这样穿的
Dialogue: 1,0:21:04.46,0:21:05.29,Dial_CH,,0,550,0,,而且
Dialogue: 1,0:21:06.38,0:21:08.20,Dial_CH,,0,0,0,,我现在贼暖和
Dialogue: 1,0:21:09.29,0:21:11.68,Dial_CH,,0,0,0,,是吗 那就好
Dialogue: 1,0:21:18.82,0:21:21.64,Dial_CH,,550,0,0,,翼 我肚子饿了
Dialogue: 1,0:21:21.64,0:21:22.92,Dial_CH,,550,0,0,,去趟Seicomart吧
Dialogue: 1,0:21:23.35,0:21:24.36,Dial_CH,,0,0,0,,Seicomart？
Dialogue: 1,0:21:25.43,0:21:27.61,Dial_CH,,0,0,0,,请你吃点东西当赔罪吧
Dialogue: 1,0:21:28.00,0:21:28.42,Dial_CH,,0,0,0,,等
Dialogue: 1,0:23:18.08,0:23:18.88,Dial_CH,,0,0,0,,好吃
Dialogue: 1,0:23:19.19,0:23:21.92,Dial_CH,,0,0,0,,是吧 我最喜欢这个了
Dialogue: 1,0:23:27.46,0:23:28.26,Dial_CH,,0,0,0,,对了
Dialogue: 1,0:23:28.26,0:23:31.01,Dial_CH,,0,0,0,,这里的饭团可是现做的
Dialogue: 1,0:23:31.45,0:23:32.65,Dial_CH,,0,0,0,,店里还煮饭吗
Dialogue: 1,0:23:32.65,0:23:34.02,Dial_CH,,0,0,0,,想不到吧
Dialogue: 1,0:23:44.88,0:23:46.04,Dial_CH,,0,0,0,,这个也好吃
Dialogue: 1,0:23:47.95,0:23:50.70,Dial_CH,,0,0,0,,翼 饭粒都粘嘴边了
Dialogue: 1,0:23:50.70,0:23:51.77,Dial_CH,,0,0,0,,跟个小孩儿似的
Dialogue: 2,0:21:42.15,0:21:45.91,OP_JP,,0,0,0,,{\fad(120,120)}君の笑顔はまるで太陽
Dialogue: 2,0:21:45.91,0:21:49.16,OP_JP,,0,0,0,,{\fad(120,120)}氷点下の街も溶けてく
Dialogue: 2,0:21:49.16,0:21:51.68,OP_JP,,0,0,0,,{\fad(120,120)}もうどうにも止まらない
Dialogue: 2,0:21:51.68,0:21:53.24,OP_JP,,0,0,0,,{\fad(120,120)}なまらめんこいギャル
