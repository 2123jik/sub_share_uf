Dialogue: 0,0:00:44.90,0:00:49.45,Title_CHS,,0,0,0,,{\fad(250,300)\blur5\3c&HCC87DD&\pos(860,510)}第10话\N青春年华贼百感交集
Dialogue: 0,0:00:47.45,0:00:49.74,Dial_JP,,0,400,0,,全然　眠れなかった
Dialogue: 0,0:00:50.19,0:00:51.73,Dial_JP,,0,0,0,,伝えたいことがあるの
Dialogue: 0,0:00:53.64,0:00:56.10,Dial_JP,,0,0,0,,冬木さんが伝えたいことって
Dialogue: 0,0:00:56.40,0:00:57.36,Dial_JP,,0,0,0,,なんだろう
Dialogue: 0,0:00:59.16,0:01:01.62,Dial_JP,,0,0,0,,まさか　こくは…
Dialogue: 0,0:01:01.62,0:01:03.15,Dial_JP,,0,0,0,,いやいや　ないか
Dialogue: 0,0:01:03.15,0:01:04.60,Dial_JP,,0,0,0,,それは　さすがに
Dialogue: 0,0:01:05.95,0:01:06.70,Dial_JP,,0,0,0,,でも
Dialogue: 0,0:01:08.56,0:01:11.03,Dial_JP,,0,0,0,,すげ緊張してきた
Dialogue: 0,0:01:17.75,0:01:19.03,Dial_JP,,0,0,0,,じゃあ　行ってくる
Dialogue: 0,0:01:20.33,0:01:22.90,Dial_JP,,0,0,0,,なんかあったら　すぐママに連絡しなね
Dialogue: 0,0:01:23.07,0:01:23.98,Dial_JP,,0,0,0,,わかった
Dialogue: 0,0:01:24.36,0:01:25.02,Dial_JP,,0,0,0,,みー
Dialogue: 0,0:01:27.84,0:01:30.93,Dial_JP,,0,0,0,,今日のみー　なまらめんこいよ
Dialogue: 0,0:01:37.74,0:01:38.57,Dial_JP,,0,0,0,,ファイト
Dialogue: 0,0:01:44.58,0:01:45.63,Dial_JP,,0,0,0,,ごめんね
Dialogue: 0,0:01:45.63,0:01:48.42,Dial_JP,,0,0,0,,こんな朝早くから集合になっちゃってさ
Dialogue: 0,0:01:48.42,0:01:50.72,Dial_JP,,0,0,0,,いや　全然大丈夫だよ
Dialogue: 0,0:01:51.21,0:01:54.22,Dial_JP,,0,0,0,,むしろ眠れなかったから　早くて助かった
Dialogue: 0,0:01:54.22,0:01:56.54,Dial_JP,,0,0,0,,ちょびっと目的地が遠くて
Dialogue: 0,0:01:56.54,0:01:57.58,Dial_JP,,0,0,0,,そういえば
Dialogue: 0,0:01:57.58,0:02:00.72,Dial_JP,,0,0,0,,目的地を聞いてなかったけど　どれくらいかかるの
Dialogue: 0,0:02:01.97,0:02:03.09,Dial_JP,,0,0,0,,３時間くらい？
Dialogue: 0,0:02:03.09,0:02:04.02,Dial_JP,,0,0,0,,３？
Dialogue: 0,0:02:04.22,0:02:06.91,Dial_JP,,0,0,0,,東京から　３時間電車に乗ったら
Dialogue: 0,0:02:06.91,0:02:09.05,Dial_JP,,0,0,0,,軽く県またげちゃうなあ
Dialogue: 0,0:02:09.78,0:02:12.28,Dial_JP,,0,0,0,,しゃべってたらすぐ着くよ
Dialogue: 0,0:02:12.28,0:02:13.20,Dial_JP,,0,0,0,,それに
Dialogue: 0,0:02:13.43,0:02:16.79,Dial_JP,,0,0,0,,翼は絶対　気に入ってくれる場所だと思うし
Dialogue: 0,0:02:17.08,0:02:18.95,Dial_JP,,0,0,0,,なまら期待してていいよ
Dialogue: 0,0:02:20.18,0:02:22.08,Dial_JP,,0,0,0,,でも　着くまで秘密ね
Dialogue: 0,0:02:23.15,0:02:24.59,Dial_JP,,0,0,0,,楽しみにしてるよ
Dialogue: 0,0:02:33.86,0:02:35.15,Dial_JP,,0,0,0,,見て　冬木さん
Dialogue: 0,0:02:35.15,0:02:36.43,Dial_JP,,0,0,0,,外に馬が…
Dialogue: 0,0:02:42.39,0:02:43.91,Dial_JP,,0,0,0,,眠っちゃった
Dialogue: 0,0:02:45.19,0:02:48.59,Dial_JP,,0,0,0,,そういえば　冬木さんと知り合ったころにも
Dialogue: 0,0:02:48.59,0:02:50.19,Dial_JP,,0,0,0,,こんなことあったな
Dialogue: 0,0:02:50.84,0:02:53.08,Dial_JP,,0,0,0,,あのときはさすがに驚いた
Dialogue: 0,0:02:56.80,0:02:59.90,Dial_JP,,0,0,0,,あれから　いろんなことがあったよな
Dialogue: 0,0:03:00.53,0:03:03.58,Dial_JP,,0,0,0,,北海道に来てから　まだ数か月なのに
Dialogue: 0,0:03:04.27,0:03:07.78,Dial_JP,,0,0,0,,もうずいぶんと長い間　一緒にいる気がする
Dialogue: 0,0:03:08.37,0:03:12.15,Dial_JP,,0,0,0,,冬木さんから　たくさん影響を受けてるのは間違いない
Dialogue: 0,0:03:12.71,0:03:13.43,Dial_JP,,0,0,0,,けど
Dialogue: 0,0:03:13.95,0:03:18.65,Dial_JP,,0,0,0,,俺は少しでも　冬木さんに何か与えられてるのだろうか
Dialogue: 0,0:03:24.54,0:03:26.22,Dial_JP,,0,0,0,,つばちゃ
Dialogue: 0,0:03:30.92,0:03:31.85,Dial_JP,,0,0,0,,きれいだ
Dialogue: 0,0:03:35.79,0:03:36.40,Dial_JP,,0,0,0,,いや
Dialogue: 0,0:03:36.58,0:03:38.36,Dial_JP,,0,0,0,,冬木さんが太陽に反射して
Dialogue: 0,0:03:38.36,0:03:40.86,Dial_JP,,0,0,0,,すごくキラキラしててきれいだなって
Dialogue: 0,0:03:40.86,0:03:43.33,Dial_JP,,0,0,0,,あれ　むしろ　こっちのがヤバい
Dialogue: 0,0:03:47.08,0:03:48.54,Dial_JP,,0,0,0,,わやなんだけど
Dialogue: 0,0:03:52.05,0:03:54.02,Dial_JP,,0,0,0,,ご乗車　おつかれさまでした
Dialogue: 0,0:03:54.38,0:03:56.64,Dial_JP,,0,0,0,,まもなく終着　網走　網走です
Dialogue: 0,0:03:56.64,0:03:57.80,Dial_JP,,0,0,0,,もうすぐ着く
Dialogue: 0,0:03:58.31,0:03:59.69,Dial_JP,,0,0,0,,次はバスね
Dialogue: 0,0:03:59.69,0:04:01.55,Dial_JP,,0,0,0,,と　その前に
Dialogue: 0,0:04:02.58,0:04:04.52,Dial_JP,,0,0,0,,ねえ　翼　おなかすいてる
Dialogue: 0,0:04:06.49,0:04:08.06,Dial_JP,,0,0,0,,すいてるかな
Dialogue: 0,0:04:08.06,0:04:10.58,Dial_JP,,0,0,0,,したっけ　少し寄り道しよ
Dialogue: 0,0:04:12.53,0:04:14.32,Dial_JP,,0,0,0,,風が気持ちいい
Dialogue: 0,0:04:14.83,0:04:18.82,Dial_JP,,0,0,0,,ちょい歩かないと行けない所だからさ　ラッキーだったね
Dialogue: 0,0:04:18.82,0:04:21.82,Dial_JP,,0,0,0,,まさかここにきて　自転車に乗るとは
Dialogue: 0,0:04:22.76,0:04:23.64,Dial_JP,,0,0,0,,でも…
Dialogue: 0,0:04:25.01,0:04:26.61,Dial_JP,,0,0,0,,翼　早く
Dialogue: 0,0:04:37.04,0:04:38.93,Dial_JP,,0,0,0,,いただきまーす
Dialogue: 0,0:04:45.31,0:04:48.23,Dial_JP,,0,0,0,,動いたあとの糖分　しみる
Dialogue: 0,0:04:48.23,0:04:52.56,Dial_JP,,0,0,0,,外の生地もサクサクして　特に中のあんこは絶品だね
Dialogue: 0,0:04:52.81,0:04:55.62,Dial_JP,,0,0,0,,北海道はあんこ最強だからね
Dialogue: 0,0:04:56.05,0:04:58.81,Dial_JP,,0,0,0,,さすが冬木さん　詳しいね
Dialogue: 0,0:04:59.26,0:05:01.41,Dial_JP,,0,0,0,,うちってか　パパが言ってた
Dialogue: 0,0:05:07.07,0:05:08.99,Dial_JP,,0,0,0,,ど…　どうかした
Dialogue: 0,0:05:08.99,0:05:10.42,Dial_JP,,0,0,0,,視線が
Dialogue: 0,0:05:10.42,0:05:11.25,Dial_JP,,0,0,0,,いや
Dialogue: 0,0:05:11.92,0:05:15.18,Dial_JP,,0,0,0,,翼って　いつも幸せそうに食べるよね
Dialogue: 0,0:05:15.45,0:05:18.76,Dial_JP,,0,0,0,,見てるとうちまで幸せになれるっていうか
Dialogue: 0,0:05:19.04,0:05:21.08,Dial_JP,,0,0,0,,ずっと見てたくなるんだよね
Dialogue: 0,0:05:25.67,0:05:27.52,Dial_JP,,0,0,0,,なしてそっち向くの
Dialogue: 0,0:05:27.89,0:05:30.52,Dial_JP,,0,0,0,,からかってるのか　ガチなのか
Dialogue: 0,0:05:31.21,0:05:33.77,Dial_JP,,0,0,0,,よ…　よし　俺だって
Dialogue: 0,0:05:34.14,0:05:38.61,Dial_JP,,0,0,0,,お　俺は　冬木さんのがいつもおいしそうに食べてて
Dialogue: 0,0:05:39.03,0:05:40.49,Dial_JP,,0,0,0,,いいなって思うよ
Dialogue: 0,0:05:41.45,0:05:42.41,Dial_JP,,0,0,0,,いや　ホント
Dialogue: 0,0:05:46.26,0:05:48.99,Dial_JP,,0,0,0,,ほら　つばちゃ　こっち向きなよ
Dialogue: 0,0:05:49.26,0:05:51.46,Dial_JP,,0,0,0,,うちのクリームもあげるからさあ
Dialogue: 0,0:05:59.31,0:06:00.13,Dial_JP,,0,0,0,,おいしい
Dialogue: 0,0:06:02.18,0:06:03.72,Dial_JP,,0,0,0,,今日の冬木さんは
Dialogue: 0,0:06:04.33,0:06:05.90,Dial_JP,,0,0,0,,一段と強い
Dialogue: 0,0:06:09.41,0:06:13.02,Dial_JP,,0,0,0,,ねえ翼　こっちとこっちなら　どっちがいいと思う
Dialogue: 0,0:06:15.05,0:06:16.66,Dial_JP,,0,0,0,,どっちも似合うけど
Dialogue: 0,0:06:16.91,0:06:20.07,Dial_JP,,0,0,0,,俺は　こっちのほうが冬木さんのイメージに合うかな
Dialogue: 0,0:06:21.77,0:06:23.87,Dial_JP,,0,0,0,,したっけ　うちこれ買ってくる
Dialogue: 0,0:06:24.11,0:06:25.27,Dial_JP,,0,0,0,,即決？
Dialogue: 0,0:07:01.23,0:07:03.36,Dial_JP,,0,0,0,,ホントに見えてないよね
Dialogue: 0,0:07:03.54,0:07:05.49,Dial_JP,,0,0,0,,みっ　見えてないよ
Dialogue: 0,0:07:05.82,0:07:09.15,Dial_JP,,0,0,0,,まさか直前まで目隠しして連れてこられるとは
Dialogue: 0,0:07:09.39,0:07:11.06,Dial_JP,,0,0,0,,なんという徹底ぶり
Dialogue: 0,0:07:11.50,0:07:12.45,Dial_JP,,0,0,0,,あと
Dialogue: 0,0:07:12.79,0:07:14.59,Dial_JP,,0,0,0,,背中に当たってる
Dialogue: 0,0:07:16.21,0:07:19.70,Dial_JP,,0,0,0,,したっけ　手ぇ離すけど　まだ目つむっててね
Dialogue: 0,0:07:19.70,0:07:21.43,Dial_JP,,0,0,0,,わ…　わかったよ
Dialogue: 0,0:07:24.71,0:07:25.94,Dial_JP,,0,0,0,,開けていいよ
Dialogue: 0,0:07:26.74,0:07:28.40,Dial_JP,,0,0,0,,いったい　どんな
Dialogue: 0,0:07:39.22,0:07:42.35,Dial_JP,,0,0,0,,ここ　東藻琴芝桜公園
Dialogue: 0,0:07:46.55,0:07:49.28,Dial_JP,,0,0,0,,翼が桜見たいって言ってたから
Dialogue: 0,0:07:49.52,0:07:53.29,Dial_JP,,0,0,0,,北海道にはこんな桜もあるんだよって見せたくて
Dialogue: 0,0:07:58.02,0:07:59.04,Dial_JP,,0,0,0,,あのとき
Dialogue: 0,0:07:59.86,0:08:02.98,Dial_JP,,0,0,0,,北海道の桜も早く見たいけどね
Dialogue: 0,0:08:08.67,0:08:09.90,Dial_JP,,0,0,0,,あ…　あれ
Dialogue: 0,0:08:09.90,0:08:11.36,Dial_JP,,0,0,0,,翼　どうしたの
Dialogue: 0,0:08:11.84,0:08:14.18,Dial_JP,,0,0,0,,もしかして　そうでもなかった？
Dialogue: 0,0:08:18.08,0:08:20.08,Dial_JP,,0,0,0,,最高だよ　冬木さん
Dialogue: 0,0:08:20.82,0:08:23.62,Dial_JP,,0,0,0,,こんなにきれいな桜　初めて見た
Dialogue: 0,0:08:25.78,0:08:28.66,Dial_JP,,0,0,0,,今まで　雪で真っ白だった北海道が
Dialogue: 0,0:08:28.66,0:08:32.83,Dial_JP,,0,0,0,,色づき始めたみたいで　あんまりうまく言えないけど
Dialogue: 0,0:08:33.34,0:08:36.07,Dial_JP,,0,0,0,,俺　今メチャクチャ感動してる
Dialogue: 0,0:08:39.62,0:08:43.56,Dial_JP,,0,0,0,,やったあ　サプライズ大成功
Dialogue: 0,0:08:43.83,0:08:44.38,Dial_JP,,0,0,0,,だけど…
Dialogue: 0,0:08:44.38,0:08:45.84,Dial_JP,,0,0,0,,したっけ　翼　ほら
Dialogue: 0,0:08:46.21,0:08:46.99,Dial_JP,,0,0,0,,行こ
Dialogue: 0,0:08:53.39,0:08:57.11,Dial_JP,,0,0,0,,どうして　こんなにすごいサプライズをしてくれたの
Dialogue: 0,0:08:58.74,0:09:00.81,Dial_JP,,0,0,0,,そう聞こうとしたけどやめた
Dialogue: 0,0:09:01.75,0:09:03.14,Dial_JP,,0,0,0,,なぜだか今は
Dialogue: 0,0:09:03.58,0:09:07.52,Dial_JP,,0,0,0,,冬木さんの思いに水を差すような気がしたから
Dialogue: 0,0:09:18.88,0:09:21.64,Dial_JP,,0,0,0,,東藻琴　映えスポットすぎん
Dialogue: 0,0:09:21.87,0:09:24.57,Dial_JP,,0,0,0,,どこ撮っても映えまくるんだけど
Dialogue: 0,0:09:25.58,0:09:28.28,Dial_JP,,0,0,0,,ファンタジー映画の中にいるみたいだ
Dialogue: 0,0:09:29.46,0:09:31.56,Dial_JP,,0,0,0,,上から見ると更にすごいね
Dialogue: 0,0:09:31.82,0:09:34.34,Dial_JP,,0,0,0,,ホントに何枚でも写真が撮れるよ
Dialogue: 0,0:09:34.96,0:09:39.06,Dial_JP,,0,0,0,,うち　ここ　昔　１回だけ家族で来たんだよね
Dialogue: 0,0:09:39.06,0:09:40.15,Dial_JP,,0,0,0,,そうなんだ
Dialogue: 0,0:09:40.44,0:09:44.26,Dial_JP,,0,0,0,,翼が見たいって言ったときに　急に思い出してさ
Dialogue: 0,0:09:44.68,0:09:48.82,Dial_JP,,0,0,0,,前に来たときは　エモいとか思ったことなかったのに
Dialogue: 0,0:09:49.12,0:09:51.97,Dial_JP,,0,0,0,,今来たら　エモエモじゃんね　ここ
Dialogue: 0,0:09:53.62,0:09:57.52,Dial_JP,,0,0,0,,きっと　この先　何十年かたったら
Dialogue: 0,0:09:57.81,0:10:00.08,Dial_JP,,0,0,0,,もっと違う景色に見えるんだろうね
Dialogue: 0,0:10:02.49,0:10:04.37,Dial_JP,,0,0,0,,この場所は変わらなくても
Dialogue: 0,0:10:08.80,0:10:11.56,Dial_JP,,0,0,0,,そのころには翼もおじいちゃんだねえ
Dialogue: 0,0:10:13.37,0:10:14.97,Dial_JP,,0,0,0,,冬木さんだって同い年じゃん
Dialogue: 0,0:10:14.97,0:10:19.04,Dial_JP,,0,0,0,,うちは美容に力を入れて　美魔女になるんだも～ん
Dialogue: 0,0:10:19.89,0:10:20.81,Dial_JP,,0,0,0,,なりそう
Dialogue: 0,0:10:21.06,0:10:23.31,Dial_JP,,0,0,0,,冬木さんのお母さんもきれいだし
Dialogue: 0,0:10:26.08,0:10:28.44,Dial_JP,,0,0,0,,ねえ　翼　一緒に写真撮ろ
Dialogue: 0,0:10:30.40,0:10:32.87,Dial_JP,,0,0,0,,それじゅあ　撮りますよ
Dialogue: 0,0:10:32.87,0:10:34.83,Dial_JP,,0,0,0,,もうちょっと左　左
Dialogue: 0,0:10:34.83,0:10:35.66,Dial_JP,,0,0,0,,こっち？
Dialogue: 0,0:10:36.10,0:10:37.43,Dial_JP,,0,0,0,,逆　逆
Dialogue: 0,0:10:37.43,0:10:38.69,Dial_JP,,0,0,0,,こっちね
Dialogue: 0,0:10:38.69,0:10:40.88,Dial_JP,,0,0,0,,それじゅあ　撮りますよ
Dialogue: 0,0:10:41.18,0:10:43.16,Dial_JP,,0,0,0,,はい　チーズ
Dialogue: 0,0:10:46.13,0:10:48.73,Dial_JP,,0,0,0,,写真ありがとうございました
Dialogue: 0,0:10:48.73,0:10:50.23,Dial_JP,,0,0,0,,ありがとうございました
Dialogue: 0,0:10:50.89,0:10:53.57,Dial_JP,,0,0,0,,撮ってもらった写真　翼にも送るね
Dialogue: 0,0:10:54.21,0:10:55.10,Dial_JP,,0,0,0,,ありがとう
Dialogue: 0,0:10:56.54,0:10:59.58,Dial_JP,,0,0,0,,でも　改めて考えるとすごいよね
Dialogue: 0,0:11:00.28,0:11:02.01,Dial_JP,,0,0,0,,丘の上の神社
Dialogue: 0,0:11:02.01,0:11:06.02,Dial_JP,,0,0,0,,ここ　ご利益があるって女性客に人気らしいよ
Dialogue: 0,0:11:07.75,0:11:08.61,Dial_JP,,0,0,0,,どんな
Dialogue: 0,0:11:10.22,0:11:11.32,Dial_JP,,0,0,0,,子宝
Dialogue: 0,0:11:11.50,0:11:12.00,Dial_JP,,0,0,0,,こっ…
Dialogue: 0,0:11:13.51,0:11:15.80,Dial_JP,,0,0,0,,顔真っ赤　ウケる
Dialogue: 0,0:11:17.74,0:11:20.02,Dial_JP,,0,0,0,,何十年後も一緒に来ようね
Dialogue: 0,0:11:22.88,0:11:26.58,Dial_JP,,0,0,0,,そんでさ　この神社でまた並んで写真撮るの
Dialogue: 0,0:11:27.43,0:11:28.67,Dial_JP,,0,0,0,,したっけさ
Dialogue: 0,0:11:32.15,0:11:33.68,Dial_JP,,0,0,0,,なまらエモくない
Dialogue: 0,0:11:36.42,0:11:37.64,Dial_JP,,0,0,0,,そうだね
Dialogue: 0,0:11:38.25,0:11:40.49,Dial_JP,,0,0,0,,もしできたら　エモいね
Dialogue: 0,0:11:43.89,0:11:47.91,Dial_JP,,0,0,0,,この冬木さんの言葉には　どんな意味があったんだろう
Dialogue: 0,0:11:48.36,0:11:50.37,Dial_JP,,0,0,0,,せっかくだし　お参りしよ
Dialogue: 0,0:11:51.84,0:11:54.79,Dial_JP,,0,0,0,,別に　深い意味なんてないのかもしれない
Dialogue: 0,0:11:55.40,0:11:58.02,Dial_JP,,0,0,0,,だけど　考えずにはいられなかった
Dialogue: 0,0:11:59.07,0:12:02.15,Dial_JP,,0,0,0,,大人になっても一緒にいられる関係って
Dialogue: 0,0:12:02.41,0:12:04.45,Dial_JP,,0,0,0,,今のような友達？
Dialogue: 0,0:12:06.60,0:12:07.71,Dial_JP,,0,0,0,,それとも…
Dialogue: 0,0:12:24.61,0:12:26.39,Dial_JP,,0,0,0,,35分
Dialogue: 0,0:12:27.25,0:12:29.85,Dial_JP,,0,0,0,,あと　５分は縮めないと
Dialogue: 0,0:12:33.62,0:12:36.82,Dial_JP,,0,0,0,,四季くん　今何してるんだろう
Dialogue: 0,0:12:39.29,0:12:40.59,Dial_JP,,0,0,0,,怜奈さん
Dialogue: 0,0:12:40.59,0:12:43.32,Dial_JP,,0,0,0,,お母さん　買い物に行ってきますね
Dialogue: 0,0:12:43.56,0:12:44.87,Dial_JP,,0,0,0,,はーい
Dialogue: 0,0:12:53.51,0:12:55.30,Dial_JP,,0,0,0,,天才丸
Dialogue: 0,0:12:56.06,0:12:58.26,Dial_JP,,0,0,0,,もぉ　くすぐったいよぉ
Dialogue: 0,0:12:59.24,0:13:02.21,Dial_JP,,0,0,0,,ストップストップ　天ちゃん
Dialogue: 0,0:13:06.46,0:13:07.22,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:13:07.64,0:13:09.26,Dial_JP,,0,0,0,,あら　怜奈ちゃん
Dialogue: 0,0:13:09.26,0:13:12.22,Dial_JP,,0,0,0,,これ　回覧板なんだけど　頼めるかしら
Dialogue: 0,0:13:12.22,0:13:13.61,Dial_JP,,0,0,0,,わかりました
Dialogue: 0,0:13:13.61,0:13:15.04,Dial_JP,,0,0,0,,ありがとうございます
Dialogue: 0,0:13:15.04,0:13:16.33,Dial_JP,,0,0,0,,よろしくね
Dialogue: 0,0:13:29.05,0:13:30.00,Dial_JP,,0,0,0,,はーい
Dialogue: 0,0:13:31.06,0:13:34.09,Dial_JP,,0,0,0,,四季くん　喉の調子が悪いのかな
Dialogue: 0,0:13:34.33,0:13:35.78,Dial_JP,,0,0,0,,なんだか声が…
Dialogue: 0,0:13:37.80,0:13:39.47,Dial_JP,,0,0,0,,こんにちは　四季くん…
Dialogue: 0,0:13:40.95,0:13:42.34,Dial_JP,,0,0,0,,どちら様ですか
Dialogue: 0,0:13:43.14,0:13:44.46,Dial_JP,,0,0,0,,あ…　あの
Dialogue: 0,0:13:45.23,0:13:46.65,Dial_JP,,0,0,0,,翼の友達？
Dialogue: 0,0:13:47.29,0:13:48.52,Dial_JP,,0,0,0,,ごめんね
Dialogue: 0,0:13:48.52,0:13:50.57,Dial_JP,,0,0,0,,アイツ今　出かけてるんだよ
Dialogue: 0,0:14:00.22,0:14:01.41,Dial_JP,,0,0,0,,ねえ翼
Dialogue: 0,0:14:02.06,0:14:03.82,Dial_JP,,0,0,0,,うち　あれ乗りたい
Dialogue: 0,0:14:04.28,0:14:06.17,Dial_JP,,0,0,0,,い…　いいね
Dialogue: 0,0:14:06.17,0:14:09.88,Dial_JP,,0,0,0,,翼　もしかしてゴーカートも初めてだったり？
Dialogue: 0,0:14:10.53,0:14:16.44,Dial_JP,,0,0,0,,よーし　うちのドライビングテクニック　みささっちゃうね
Dialogue: 0,0:15:53.97,0:15:56.75,Dial_JP,,0,0,0,,芝桜ソフト　うまあ
Dialogue: 0,0:15:57.01,0:15:59.65,Dial_JP,,0,0,0,,桜色でこことマッチしてるね
Dialogue: 0,0:16:04.83,0:16:05.77,Dial_JP,,0,0,0,,冬木さん
Dialogue: 0,0:16:07.07,0:16:08.62,Dial_JP,,0,0,0,,はい　チーズ
Dialogue: 0,0:16:12.52,0:16:14.10,Dial_JP,,0,0,0,,フォトジェニック
Dialogue: 0,0:16:14.99,0:16:16.28,Dial_JP,,0,0,0,,溶けてるよ
Dialogue: 0,0:16:22.41,0:16:24.30,Dial_JP,,0,0,0,,おいしかったあ
Dialogue: 0,0:16:28.24,0:16:30.25,Dial_JP,,0,0,0,,したっけ　そろそろ帰ろっか
Dialogue: 0,0:16:30.51,0:16:33.08,Dial_JP,,0,0,0,,そうだね　名残惜しいけど
Dialogue: 0,0:16:33.08,0:16:34.81,Dial_JP,,0,0,0,,日も傾いてきたし
Dialogue: 0,0:16:37.54,0:16:38.63,Dial_JP,,0,0,0,,ねえ　翼
Dialogue: 0,0:16:39.86,0:16:42.29,Dial_JP,,0,0,0,,さっきの写真　めんこく撮ってくれた
Dialogue: 0,0:16:42.29,0:16:43.66,Dial_JP,,0,0,0,,バッチリだよ
Dialogue: 0,0:16:43.66,0:16:44.86,Dial_JP,,0,0,0,,今送るね
Dialogue: 0,0:16:47.80,0:16:48.58,Dial_JP,,0,0,0,,これ
Dialogue: 0,0:16:48.89,0:16:51.10,Dial_JP,,0,0,0,,ああ　２人で撮った写真
Dialogue: 0,0:16:51.10,0:16:52.61,Dial_JP,,0,0,0,,アイコンにしたさあ
Dialogue: 0,0:16:52.61,0:16:54.28,Dial_JP,,0,0,0,,アイコンにしちゃうの
Dialogue: 0,0:16:54.28,0:16:56.23,Dial_JP,,0,0,0,,俺と２人で撮ったやつを
Dialogue: 0,0:16:56.23,0:16:59.62,Dial_JP,,0,0,0,,それって　他の人たちにも見られるってことで
Dialogue: 0,0:17:00.87,0:17:03.70,Dial_JP,,0,0,0,,はたから見たら　カップルなのでは
Dialogue: 0,0:17:07.33,0:17:11.22,Dial_JP,,0,0,0,,いやいや　冬木さん的に通常運転の可能性も
Dialogue: 0,0:17:17.27,0:17:18.37,Dial_JP,,0,0,0,,冬木さん
Dialogue: 0,0:17:19.80,0:17:23.81,Dial_JP,,0,0,0,,これ　いつ渡そうか　迷ったんだけど
Dialogue: 0,0:17:24.73,0:17:25.68,Dial_JP,,0,0,0,,うちに？
Dialogue: 0,0:17:29.98,0:17:31.18,Dial_JP,,0,0,0,,開けてもいい
Dialogue: 0,0:17:37.01,0:17:38.19,Dial_JP,,0,0,0,,ミサンガ
Dialogue: 0,0:17:39.62,0:17:41.81,Dial_JP,,0,0,0,,カフェの雑貨コーナーで　見つけて
Dialogue: 0,0:17:42.90,0:17:45.29,Dial_JP,,0,0,0,,冬木さんに　似合いそうだなって
Dialogue: 0,0:17:47.61,0:17:48.70,Dial_JP,,0,0,0,,ねえ　翼
Dialogue: 0,0:17:50.91,0:17:51.76,Dial_JP,,0,0,0,,つけて
Dialogue: 0,0:18:33.95,0:18:35.23,Dial_JP,,0,0,0,,うちらってさ
Dialogue: 0,0:18:36.00,0:18:38.65,Dial_JP,,0,0,0,,周りから見たらどう見えてるんだろうね
Dialogue: 0,0:18:43.07,0:18:44.95,Dial_JP,,0,0,0,,なんて答えたらいいんだ
Dialogue: 0,0:18:46.14,0:18:49.47,Dial_JP,,0,0,0,,今考えてることを　そのまま言ったら
Dialogue: 0,0:18:50.64,0:18:53.10,Dial_JP,,0,0,0,,それって　もう…
Dialogue: 0,0:18:57.67,0:19:01.99,Dial_JP,,0,0,0,,きっと仲のいい友達に見えるんじゃないかな
Dialogue: 0,0:19:11.34,0:19:13.27,Dial_JP,,0,0,0,,俺今　声震えてた
Dialogue: 0,0:19:14.17,0:19:16.43,Dial_JP,,0,0,0,,いや　それより　なんだ
Dialogue: 0,0:19:17.00,0:19:18.64,Dial_JP,,0,0,0,,メチャクチャざわざわする
Dialogue: 0,0:19:19.16,0:19:21.20,Dial_JP,,0,0,0,,言っちゃいけないことを言ったような
Dialogue: 0,0:19:23.89,0:19:24.75,Dial_JP,,0,0,0,,そっか
Dialogue: 0,0:19:28.04,0:19:29.17,Dial_JP,,0,0,0,,そうだよね
Dialogue: 0,0:19:34.95,0:19:37.61,Dial_JP,,0,0,0,,ああ　俺は臆病だ
Dialogue: 0,0:19:41.36,0:19:43.96,Dial_JP,,0,0,0,,核心的なところに触れるのが怖くて
Dialogue: 0,0:19:45.12,0:19:46.60,Dial_JP,,0,0,0,,ビビって逃げたんだ
Dialogue: 0,0:19:48.10,0:19:51.20,Dial_JP,,0,0,0,,さっきまで　近くにいた冬木さんが
Dialogue: 0,0:19:52.04,0:19:56.35,Dial_JP,,0,0,0,,どこか　遠くへ　遠くへ行ってしまいそうな気がする
Dialogue: 0,0:19:58.23,0:20:00.11,Dial_JP,,0,0,0,,ダメだ　違う
Dialogue: 0,0:20:00.35,0:20:03.82,Dial_JP,,0,0,0,,そうじゃない　俺は冬木さんのことを…
Dialogue: 0,0:20:04.99,0:20:06.61,Dial_JP,,0,0,0,,冬木さん　俺…
Dialogue: 0,0:20:06.61,0:20:08.13,Dial_JP,,0,0,0,,翼　うちね
Dialogue: 0,0:20:09.82,0:20:11.76,Dial_JP,,0,0,0,,来週からいなくなるから
Dialogue: 0,0:20:17.54,0:20:19.94,Dial_JP,,0,0,0,,伝えたいことがあるって　言ったじゃん
Dialogue: 0,0:20:20.97,0:20:22.60,Dial_JP,,0,0,0,,遅くなってごめんね
Dialogue: 0,0:20:24.31,0:20:27.04,Dial_JP,,0,0,0,,うち　海外留学するんだ
Dialogue: 0,0:20:31.63,0:20:34.68,Dial_JP,,0,0,0,,海外　留学
Dialogue: 0,0:20:36.97,0:20:39.65,Dial_JP,,0,0,0,,将来　美容系のお仕事就くために
Dialogue: 0,0:20:39.65,0:20:42.09,Dial_JP,,0,0,0,,今のうちから勉強しておきたいんだ
Dialogue: 0,0:20:44.45,0:20:46.38,Dial_JP,,0,0,0,,翼のおかげなんだよ
Dialogue: 0,0:20:47.75,0:20:50.96,Dial_JP,,0,0,0,,翼に会うまでのうちってマジ適当っていうか
Dialogue: 0,0:20:50.96,0:20:52.71,Dial_JP,,0,0,0,,ノリだけって感じでさ
Dialogue: 0,0:20:52.96,0:20:56.70,Dial_JP,,0,0,0,,何かに一生懸命になることって　ほとんどなかったんだよね
Dialogue: 0,0:20:57.20,0:21:01.28,Dial_JP,,0,0,0,,だけど　初めての土地でテンパりながらも頑張ってる姿とか
Dialogue: 0,0:21:01.54,0:21:04.52,Dial_JP,,0,0,0,,スキーも勉強も　いつも一生懸命でさ
Dialogue: 0,0:21:04.52,0:21:07.04,Dial_JP,,0,0,0,,あんなにすごいピアノだって弾けちゃうし
Dialogue: 0,0:21:07.56,0:21:10.24,Dial_JP,,0,0,0,,誰に対しても真正面から向き合って
Dialogue: 0,0:21:10.24,0:21:12.04,Dial_JP,,0,0,0,,気持ちに寄り添ってくれる
Dialogue: 0,0:21:12.36,0:21:15.21,Dial_JP,,0,0,0,,雪まつりのときも　ゲームしてるときも
Dialogue: 0,0:21:16.53,0:21:20.98,Dial_JP,,0,0,0,,ここに来たときだって　そうやって目を輝かせて
Dialogue: 0,0:21:21.41,0:21:24.31,Dial_JP,,0,0,0,,純粋で　真面目で　まっすぐで
Dialogue: 0,0:21:25.02,0:21:26.87,Dial_JP,,0,0,0,,そんな翼を見てたら
Dialogue: 0,0:21:29.58,0:21:34.92,Dial_JP,,0,0,0,,うちも頑張らなくちゃって　変わらなきゃって思ったんだよね
Dialogue: 0,0:21:35.79,0:21:40.59,Dial_JP,,0,0,0,,だから　そんなきっかけをくれた翼には　ちゃんとお礼したくてさ
Dialogue: 0,0:21:40.59,0:21:43.83,Dial_JP,,0,0,0,,始業式の日に今日のサプライズを思いついたんだ
Dialogue: 0,0:21:44.50,0:21:46.86,Dial_JP,,0,0,0,,でも　うちが北海道から出る前に
Dialogue: 0,0:21:46.86,0:21:49.62,Dial_JP,,0,0,0,,２人でここ来れてマジよかった
Dialogue: 0,0:21:50.04,0:21:52.25,Dial_JP,,0,0,0,,翼も今日は楽しんでくれた…
Dialogue: 0,0:22:09.35,0:22:11.58,Dial_JP,,0,0,0,,つ…　つばちゃ
Dialogue: 0,0:22:24.28,0:22:25.80,Dial_JP,,0,0,0,,翼
Dialogue: 1,0:00:47.45,0:00:49.74,Dial_CH,,0,400,0,,完全没能睡着觉
Dialogue: 1,0:00:50.19,0:00:51.73,Dial_CH,,0,0,0,,我有事情想告诉你
Dialogue: 1,0:00:53.64,0:00:56.10,Dial_CH,,0,0,0,,冬木同学想告诉我的事情
Dialogue: 1,0:00:56.40,0:00:57.36,Dial_CH,,0,0,0,,到底是什么呢
Dialogue: 1,0:00:59.16,0:01:01.62,Dial_CH,,0,0,0,,难道她要表…
Dialogue: 1,0:01:01.62,0:01:03.15,Dial_CH,,0,0,0,,不对 不可能
Dialogue: 1,0:01:03.15,0:01:04.60,Dial_CH,,0,0,0,,这实在有点异想天开了
Dialogue: 1,0:01:05.95,0:01:06.70,Dial_CH,,0,0,0,,但我
Dialogue: 1,0:01:08.56,0:01:11.03,Dial_CH,,0,0,0,,我好紧张
Dialogue: 1,0:01:17.75,0:01:19.03,Dial_CH,,0,0,0,,我走咯
Dialogue: 1,0:01:20.33,0:01:22.90,Dial_CH,,0,0,0,,有事的话记得马上联系我啊
Dialogue: 1,0:01:23.07,0:01:23.98,Dial_CH,,0,0,0,,好
Dialogue: 1,0:01:24.36,0:01:25.02,Dial_CH,,0,0,0,,小美
Dialogue: 1,0:01:27.84,0:01:30.93,Dial_CH,,0,0,0,,今天的小美 贼拉可爱
Dialogue: 1,0:01:37.74,0:01:38.57,Dial_CH,,0,0,0,,加油
Dialogue: 1,0:01:44.58,0:01:45.63,Dial_CH,,0,0,0,,抱歉
Dialogue: 1,0:01:45.63,0:01:48.42,Dial_CH,,0,0,0,,把见面时间定得这么早
Dialogue: 1,0:01:48.42,0:01:50.72,Dial_CH,,0,0,0,,没关系的
Dialogue: 1,0:01:51.21,0:01:54.22,Dial_CH,,0,0,0,,倒不如说我完全睡不着 早点集合反而更好
Dialogue: 1,0:01:54.22,0:01:56.54,Dial_CH,,0,0,0,,目的地有一点远
Dialogue: 1,0:01:56.54,0:01:57.58,Dial_CH,,0,0,0,,说起来
Dialogue: 1,0:01:57.58,0:02:00.72,Dial_CH,,0,0,0,,我还不知道要去哪里呢 大约要多久呢
Dialogue: 1,0:02:01.97,0:02:03.09,Dial_CH,,0,0,0,,3个小时左右？
Dialogue: 1,0:02:03.09,0:02:04.02,Dial_CH,,0,0,0,,3？
Dialogue: 1,0:02:04.22,0:02:06.91,Dial_CH,,0,0,0,,从东京出发坐3个小时电车的话
Dialogue: 1,0:02:06.91,0:02:09.05,Dial_CH,,0,0,0,,都能穿过几个县了
Dialogue: 1,0:02:09.78,0:02:12.28,Dial_CH,,0,0,0,,唠唠嗑就到了
Dialogue: 1,0:02:12.28,0:02:13.20,Dial_CH,,0,0,0,,而且
Dialogue: 1,0:02:13.43,0:02:16.79,Dial_CH,,0,0,0,,你肯定会喜欢那地方
Dialogue: 1,0:02:17.08,0:02:18.95,Dial_CH,,0,0,0,,就只管期待着就行了
Dialogue: 1,0:02:20.18,0:02:22.08,Dial_CH,,0,0,0,,但是到地方之前我先保密
Dialogue: 1,0:02:23.15,0:02:24.59,Dial_CH,,0,0,0,,我很期待
Dialogue: 1,0:02:33.86,0:02:35.15,Dial_CH,,0,0,0,,快看 冬木同学
Dialogue: 1,0:02:35.15,0:02:36.43,Dial_CH,,0,0,0,,外面有马…
Dialogue: 1,0:02:42.39,0:02:43.91,Dial_CH,,0,0,0,,睡着了啊
Dialogue: 1,0:02:45.19,0:02:48.59,Dial_CH,,0,0,0,,说起来刚认识冬木同学的时候
Dialogue: 1,0:02:48.59,0:02:50.19,Dial_CH,,0,0,0,,也有过这种事
Dialogue: 1,0:02:50.84,0:02:53.08,Dial_CH,,0,0,0,,那时也确实是吃了一惊
Dialogue: 1,0:02:56.80,0:02:59.90,Dial_CH,,0,0,0,,后来发生了很多事情
Dialogue: 1,0:03:00.53,0:03:03.58,Dial_CH,,0,0,0,,来到北海道还只过了几个月
Dialogue: 1,0:03:04.27,0:03:07.78,Dial_CH,,0,0,0,,我却总感觉已经一起度过了好长的时光
Dialogue: 1,0:03:08.37,0:03:12.15,Dial_CH,,0,0,0,,毫无疑问 冬木同学给我带来了很多影响
Dialogue: 1,0:03:12.71,0:03:13.43,Dial_CH,,0,0,0,,不过
Dialogue: 1,0:03:13.95,0:03:18.65,Dial_CH,,0,0,0,,我不知道我是否也给予过她什么东西
Dialogue: 1,0:03:24.54,0:03:26.22,Dial_CH,,0,0,0,,翼宝
Dialogue: 1,0:03:30.92,0:03:31.85,Dial_CH,,0,0,0,,好漂亮
Dialogue: 1,0:03:35.79,0:03:36.40,Dial_CH,,0,0,0,,不是
Dialogue: 1,0:03:36.58,0:03:38.36,Dial_CH,,0,0,0,,我就是觉得太阳照在你身上
Dialogue: 1,0:03:38.36,0:03:40.86,Dial_CH,,0,0,0,,亮晶晶的 特别漂亮
Dialogue: 1,0:03:40.86,0:03:43.33,Dial_CH,,0,0,0,,哎哟 我怎么越解释越不对劲了
Dialogue: 1,0:03:47.08,0:03:48.54,Dial_CH,,0,0,0,,你这人真怪
Dialogue: 1,0:03:52.05,0:03:54.02,Dial_CH,,0,0,0,,感谢您乘坐本次列车
Dialogue: 1,0:03:54.38,0:03:56.64,Dial_CH,,0,0,0,,即将到达终点站 网走 网走站
Dialogue: 1,0:03:56.64,0:03:57.80,Dial_CH,,0,0,0,,马上就到了
Dialogue: 1,0:03:58.31,0:03:59.69,Dial_CH,,0,0,0,,然后换公交
Dialogue: 1,0:03:59.69,0:04:01.55,Dial_CH,,0,0,0,,换乘之前
Dialogue: 1,0:04:02.58,0:04:04.52,Dial_CH,,0,0,0,,翼 你饿吗
Dialogue: 1,0:04:06.49,0:04:08.06,Dial_CH,,0,0,0,,有点吧
Dialogue: 1,0:04:08.06,0:04:10.58,Dial_CH,,0,0,0,,那我们就稍微绕个路
Dialogue: 1,0:04:12.53,0:04:14.32,Dial_CH,,0,0,0,,风吹着好舒服
Dialogue: 1,0:04:14.83,0:04:18.82,Dial_CH,,0,0,0,,那是个得稍微走点路才能到的地方 不过运气还不错
Dialogue: 1,0:04:18.82,0:04:21.82,Dial_CH,,0,0,0,,没想到到站了还得骑自行车
Dialogue: 1,0:04:22.76,0:04:23.64,Dial_CH,,0,0,0,,不过…
Dialogue: 1,0:04:25.01,0:04:26.61,Dial_CH,,0,0,0,,翼 快点
Dialogue: 1,0:04:37.04,0:04:38.93,Dial_CH,,0,0,0,,我开动了
Dialogue: 1,0:04:45.31,0:04:48.23,Dial_CH,,0,0,0,,运动之后的甜点 真爽
Dialogue: 1,0:04:48.23,0:04:52.56,Dial_CH,,0,0,0,,外面很脆 特别是里面的豆沙简直绝了
Dialogue: 1,0:04:52.81,0:04:55.62,Dial_CH,,0,0,0,,北海道的豆沙可是最好吃的
Dialogue: 1,0:04:56.05,0:04:58.81,Dial_CH,,0,0,0,,不愧是本地人 懂得真多
Dialogue: 1,0:04:59.26,0:05:01.41,Dial_CH,,0,0,0,,其实也是爸爸告诉我的
Dialogue: 1,0:05:07.07,0:05:08.99,Dial_CH,,0,0,0,,怎… 怎么了
Dialogue: 1,0:05:08.99,0:05:10.42,Dial_CH,,0,0,0,,一直盯着我
Dialogue: 1,0:05:10.42,0:05:11.25,Dial_CH,,0,0,0,,没啥
Dialogue: 1,0:05:11.92,0:05:15.18,Dial_CH,,0,0,0,,就是看你吃东西时 总是满脸幸福
Dialogue: 1,0:05:15.45,0:05:18.76,Dial_CH,,0,0,0,,看着你 我就觉得自己也特别开心
Dialogue: 1,0:05:19.04,0:05:21.08,Dial_CH,,0,0,0,,不禁想多看几眼
Dialogue: 1,0:05:25.67,0:05:27.52,Dial_CH,,0,0,0,,干嘛转过去啊
Dialogue: 1,0:05:27.89,0:05:30.52,Dial_CH,,0,0,0,,她到底是在调戏我 还是认真的
Dialogue: 1,0:05:31.21,0:05:33.77,Dial_CH,,0,0,0,,好… 好 那我也
Dialogue: 1,0:05:34.14,0:05:38.61,Dial_CH,,0,0,0,,我 我也觉得你吃东西的样子特别满足
Dialogue: 1,0:05:39.03,0:05:40.49,Dial_CH,,0,0,0,,挺好的
Dialogue: 1,0:05:41.45,0:05:42.41,Dial_CH,,0,0,0,,说真的
Dialogue: 1,0:05:46.26,0:05:48.99,Dial_CH,,0,0,0,,翼宝 快转过来
Dialogue: 1,0:05:49.26,0:05:51.46,Dial_CH,,0,0,0,,给你尝一口我的奶油味的
Dialogue: 1,0:05:59.31,0:06:00.13,Dial_CH,,0,0,0,,好吃吗
Dialogue: 1,0:06:02.18,0:06:03.72,Dial_CH,,0,0,0,,今天的冬木同学
Dialogue: 1,0:06:04.33,0:06:05.90,Dial_CH,,0,0,0,,杀伤力更强了
Dialogue: 1,0:06:09.41,0:06:13.02,Dial_CH,,0,0,0,,翼 你说这两个 哪个更好看呀
Dialogue: 1,0:06:15.05,0:06:16.66,Dial_CH,,0,0,0,,都挺合适吧
Dialogue: 1,0:06:16.91,0:06:20.07,Dial_CH,,0,0,0,,不过我觉得这个更符合冬木同学的气质
Dialogue: 1,0:06:21.77,0:06:23.87,Dial_CH,,0,0,0,,那我去把这个买了
Dialogue: 1,0:06:24.11,0:06:25.27,Dial_CH,,0,0,0,,就定了？
Dialogue: 1,0:07:01.23,0:07:03.36,Dial_CH,,0,0,0,,没偷看吧
Dialogue: 1,0:07:03.54,0:07:05.49,Dial_CH,,0,0,0,,真 真看不见
Dialogue: 1,0:07:05.82,0:07:09.15,Dial_CH,,0,0,0,,竟然到地方之前都要蒙着我的眼睛
Dialogue: 1,0:07:09.39,0:07:11.06,Dial_CH,,0,0,0,,这保密工作也太到位了
Dialogue: 1,0:07:11.50,0:07:12.45,Dial_CH,,0,0,0,,而且
Dialogue: 1,0:07:12.79,0:07:14.59,Dial_CH,,0,0,0,,背后碰着了
Dialogue: 1,0:07:16.21,0:07:19.70,Dial_CH,,0,0,0,,那我要松手啦 你不许睁眼哦
Dialogue: 1,0:07:19.70,0:07:21.43,Dial_CH,,0,0,0,,明… 明白
Dialogue: 1,0:07:24.71,0:07:25.94,Dial_CH,,0,0,0,,可以睁开啦
Dialogue: 1,0:07:26.74,0:07:28.40,Dial_CH,,0,0,0,,到底是个什么地方
Dialogue: 1,0:07:39.22,0:07:42.35,Dial_CH,,0,0,0,,这儿就是东藻琴芝樱公园
Dialogue: 1,0:07:46.55,0:07:49.28,Dial_CH,,0,0,0,,你前阵子说想看樱花
Dialogue: 1,0:07:49.52,0:07:53.29,Dial_CH,,0,0,0,,我就想让你看看 北海道也有这样的樱花
Dialogue: 1,0:07:58.02,0:07:59.04,Dial_CH,,0,0,0,,是那个时候
Dialogue: 1,0:07:59.86,0:08:02.98,Dial_CH,,0,0,0,,好想早点看到北海道的樱花啊
Dialogue: 1,0:08:08.67,0:08:09.90,Dial_CH,,0,0,0,,咦… 咦
Dialogue: 1,0:08:09.90,0:08:11.36,Dial_CH,,0,0,0,,翼 你这是咋了
Dialogue: 1,0:08:11.84,0:08:14.18,Dial_CH,,0,0,0,,难道你其实也不是那么想看？
Dialogue: 1,0:08:18.08,0:08:20.08,Dial_CH,,0,0,0,,太好看了 冬木同学
Dialogue: 1,0:08:20.82,0:08:23.62,Dial_CH,,0,0,0,,我从来没见过这么漂亮的樱花
Dialogue: 1,0:08:25.78,0:08:28.66,Dial_CH,,0,0,0,,就好像是 一直白雪皑皑的北海道
Dialogue: 1,0:08:28.66,0:08:32.83,Dial_CH,,0,0,0,,一笔笔给自己勾勒出了颜色 我有点词穷了
Dialogue: 1,0:08:33.34,0:08:36.07,Dial_CH,,0,0,0,,但是我现在特别感动
Dialogue: 1,0:08:39.62,0:08:43.56,Dial_CH,,0,0,0,,好耶 惊喜大成功
Dialogue: 1,0:08:43.83,0:08:44.38,Dial_CH,,0,0,0,,可…
Dialogue: 1,0:08:44.38,0:08:45.84,Dial_CH,,0,0,0,,翼 快点儿
Dialogue: 1,0:08:46.21,0:08:46.99,Dial_CH,,0,0,0,,我们走吧
Dialogue: 1,0:08:53.39,0:08:57.11,Dial_CH,,0,0,0,,我其实想问问她 为什么为我准备了这么大的惊喜
Dialogue: 1,0:08:58.74,0:09:00.81,Dial_CH,,0,0,0,,但是我并没有问出来
Dialogue: 1,0:09:01.75,0:09:03.14,Dial_CH,,0,0,0,,因为我隐隐觉得
Dialogue: 1,0:09:03.58,0:09:07.52,Dial_CH,,0,0,0,,如果问了 就扫了冬木同学的兴致
Dialogue: 1,0:09:18.88,0:09:21.64,Dial_CH,,0,0,0,,东藻琴也太出片了
Dialogue: 1,0:09:21.87,0:09:24.57,Dial_CH,,0,0,0,,怎么拍都好看
Dialogue: 1,0:09:25.58,0:09:28.28,Dial_CH,,0,0,0,,感觉自己就像在奇幻电影里一样
Dialogue: 1,0:09:29.46,0:09:31.56,Dial_CH,,0,0,0,,在高处看更壮观了
Dialogue: 1,0:09:31.82,0:09:34.34,Dial_CH,,0,0,0,,怎么拍都拍不腻
Dialogue: 1,0:09:34.96,0:09:39.06,Dial_CH,,0,0,0,,我以前和家里人一起来过一次
Dialogue: 1,0:09:39.06,0:09:40.15,Dial_CH,,0,0,0,,哦
Dialogue: 1,0:09:40.44,0:09:44.26,Dial_CH,,0,0,0,,你说想看樱花的时候一下就想起来了
Dialogue: 1,0:09:44.68,0:09:48.82,Dial_CH,,0,0,0,,那时候根本没觉得有多好看
Dialogue: 1,0:09:49.12,0:09:51.97,Dial_CH,,0,0,0,,这次简直直击我内心
Dialogue: 1,0:09:53.62,0:09:57.52,Dial_CH,,0,0,0,,肯定 等再过个几十年
Dialogue: 1,0:09:57.81,0:10:00.08,Dial_CH,,0,0,0,,我们再看这片景 又会有不一样的感受吧
Dialogue: 1,0:10:02.49,0:10:04.37,Dial_CH,,0,0,0,,纵然景本身不曾改变
Dialogue: 1,0:10:08.80,0:10:11.56,Dial_CH,,0,0,0,,到那时你都变成老头儿了
Dialogue: 1,0:10:13.37,0:10:14.97,Dial_CH,,0,0,0,,你不也和我一样大吗
Dialogue: 1,0:10:14.97,0:10:19.04,Dial_CH,,0,0,0,,我保养得好好儿的 到时候怎么说也是个美魔女
Dialogue: 1,0:10:19.89,0:10:20.81,Dial_CH,,0,0,0,,还真有可能
Dialogue: 1,0:10:21.06,0:10:23.31,Dial_CH,,0,0,0,,毕竟冬木妈妈也那么漂亮
Dialogue: 1,0:10:26.08,0:10:28.44,Dial_CH,,0,0,0,,翼 我们一起照一张吧
Dialogue: 1,0:10:30.40,0:10:32.87,Dial_CH,,0,0,0,,我要照了啊
Dialogue: 1,0:10:32.87,0:10:34.83,Dial_CH,,0,0,0,,再往左边点儿 往左
Dialogue: 1,0:10:34.83,0:10:35.66,Dial_CH,,0,0,0,,这样？
Dialogue: 1,0:10:36.10,0:10:37.43,Dial_CH,,0,0,0,,反了反了
Dialogue: 1,0:10:37.43,0:10:38.69,Dial_CH,,0,0,0,,这边儿啊
Dialogue: 1,0:10:38.69,0:10:40.88,Dial_CH,,0,0,0,,那我照了啊
Dialogue: 1,0:10:41.18,0:10:43.16,Dial_CH,,0,0,0,,茄子
Dialogue: 1,0:10:46.13,0:10:48.73,Dial_CH,,0,0,0,,谢谢您帮忙照相儿
Dialogue: 1,0:10:48.73,0:10:50.23,Dial_CH,,0,0,0,,谢谢您
Dialogue: 1,0:10:50.89,0:10:53.57,Dial_CH,,0,0,0,,照片我发给你
Dialogue: 1,0:10:54.21,0:10:55.10,Dial_CH,,0,0,0,,谢啦
Dialogue: 1,0:10:56.54,0:10:59.58,Dial_CH,,0,0,0,,不过仔细想想 挺厉害的
Dialogue: 1,0:11:00.28,0:11:02.01,Dial_CH,,0,0,0,,神社竟在小山丘上
Dialogue: 1,0:11:02.01,0:11:06.02,Dial_CH,,0,0,0,,听说这里很灵的 在女性游客之间小有名气呢
Dialogue: 1,0:11:07.75,0:11:08.61,Dial_CH,,0,0,0,,求什么的
Dialogue: 1,0:11:10.22,0:11:11.32,Dial_CH,,0,0,0,,求子
Dialogue: 1,0:11:11.50,0:11:12.00,Dial_CH,,0,0,0,,子…
Dialogue: 1,0:11:13.51,0:11:15.80,Dial_CH,,0,0,0,,脸这么红 太好笑了
Dialogue: 1,0:11:17.74,0:11:20.02,Dial_CH,,0,0,0,,几十年后再一起来吧
Dialogue: 1,0:11:22.88,0:11:26.58,Dial_CH,,0,0,0,,到时候我们再在这个神社门前拍一张
Dialogue: 1,0:11:27.43,0:11:28.67,Dial_CH,,0,0,0,,这样一想
Dialogue: 1,0:11:32.15,0:11:33.68,Dial_CH,,0,0,0,,是不是贼有感觉
Dialogue: 1,0:11:36.42,0:11:37.64,Dial_CH,,0,0,0,,是啊
Dialogue: 1,0:11:38.25,0:11:40.49,Dial_CH,,0,0,0,,要是真能的话 确实
Dialogue: 1,0:11:43.89,0:11:47.91,Dial_CH,,0,0,0,,冬木同学的这番话 到底有什么深意呢
Dialogue: 1,0:11:48.36,0:11:50.37,Dial_CH,,0,0,0,,来都来了 拜一拜吧
Dialogue: 1,0:11:51.84,0:11:54.79,Dial_CH,,0,0,0,,可能并没有
Dialogue: 1,0:11:55.40,0:11:58.02,Dial_CH,,0,0,0,,但我还是忍不住去揣测
Dialogue: 1,0:11:59.07,0:12:02.15,Dial_CH,,0,0,0,,成人后也能相互陪伴的关系
Dialogue: 1,0:12:02.41,0:12:04.45,Dial_CH,,0,0,0,,是现在这种朋友关系吗？
Dialogue: 1,0:12:06.60,0:12:07.71,Dial_CH,,0,0,0,,又或是…
Dialogue: 1,0:12:24.61,0:12:26.39,Dial_CH,,0,0,0,,35分钟
Dialogue: 1,0:12:27.25,0:12:29.85,Dial_CH,,0,0,0,,还得再快5分钟
Dialogue: 1,0:12:33.62,0:12:36.82,Dial_CH,,0,0,0,,四季现在在干嘛呢
Dialogue: 1,0:12:39.29,0:12:40.59,Dial_CH,,0,0,0,,怜奈
Dialogue: 1,0:12:40.59,0:12:43.32,Dial_CH,,0,0,0,,妈妈去买点东西
Dialogue: 1,0:12:43.56,0:12:44.87,Dial_CH,,0,0,0,,好
Dialogue: 1,0:12:53.51,0:12:55.30,Dial_CH,,0,0,0,,天才丸
Dialogue: 1,0:12:56.06,0:12:58.26,Dial_CH,,0,0,0,,哎哟 痒死我了
Dialogue: 1,0:12:59.24,0:13:02.21,Dial_CH,,0,0,0,,停停停 小天
Dialogue: 1,0:13:06.46,0:13:07.22,Dial_CH,,0,0,0,,你好
Dialogue: 1,0:13:07.64,0:13:09.26,Dial_CH,,0,0,0,,哦 怜奈啊
Dialogue: 1,0:13:09.26,0:13:12.22,Dial_CH,,0,0,0,,我拿传阅板来了 能拜托你传给下一户吗
Dialogue: 1,0:13:12.22,0:13:13.61,Dial_CH,,0,0,0,,好的
Dialogue: 1,0:13:13.61,0:13:15.04,Dial_CH,,0,0,0,,谢谢您
Dialogue: 1,0:13:15.04,0:13:16.33,Dial_CH,,0,0,0,,麻烦你了
Dialogue: 1,0:13:29.05,0:13:30.00,Dial_CH,,0,0,0,,来了
Dialogue: 1,0:13:31.06,0:13:34.09,Dial_CH,,0,0,0,,四季嗓子不舒服吗
Dialogue: 1,0:13:34.33,0:13:35.78,Dial_CH,,0,0,0,,总觉得声音不太对…
Dialogue: 1,0:13:37.80,0:13:39.47,Dial_CH,,0,0,0,,你好 四季…
Dialogue: 1,0:13:40.95,0:13:42.34,Dial_CH,,0,0,0,,请问是哪位
Dialogue: 1,0:13:43.14,0:13:44.46,Dial_CH,,0,0,0,,那… 那个
Dialogue: 1,0:13:45.23,0:13:46.65,Dial_CH,,0,0,0,,翼的朋友？
Dialogue: 1,0:13:47.29,0:13:48.52,Dial_CH,,0,0,0,,抱歉
Dialogue: 1,0:13:48.52,0:13:50.57,Dial_CH,,0,0,0,,他出门了
Dialogue: 1,0:14:00.22,0:14:01.41,Dial_CH,,0,0,0,,翼
Dialogue: 1,0:14:02.06,0:14:03.82,Dial_CH,,0,0,0,,我想坐那个
Dialogue: 1,0:14:04.28,0:14:06.17,Dial_CH,,0,0,0,,好… 好啊
Dialogue: 1,0:14:06.17,0:14:09.88,Dial_CH,,0,0,0,,难不成你没玩过卡丁车？
Dialogue: 1,0:14:10.53,0:14:16.44,Dial_CH,,0,0,0,,好嘞 我得让你见识见识我的车技
Dialogue: 1,0:15:53.97,0:15:56.75,Dial_CH,,0,0,0,,芝樱冰淇凌太好吃啦
Dialogue: 1,0:15:57.01,0:15:59.65,Dial_CH,,0,0,0,,这樱花色也很应景呢
Dialogue: 1,0:16:04.83,0:16:05.77,Dial_CH,,0,0,0,,冬木同学
Dialogue: 1,0:16:07.07,0:16:08.62,Dial_CH,,0,0,0,,来 笑一个
Dialogue: 1,0:16:12.52,0:16:14.10,Dial_CH,,0,0,0,,太上相了
Dialogue: 1,0:16:14.99,0:16:16.28,Dial_CH,,0,0,0,,化了哦
Dialogue: 1,0:16:22.41,0:16:24.30,Dial_CH,,0,0,0,,太好吃了
Dialogue: 1,0:16:28.24,0:16:30.25,Dial_CH,,0,0,0,,咱们该回去了
Dialogue: 1,0:16:30.51,0:16:33.08,Dial_CH,,0,0,0,,是啊 虽有点不舍
Dialogue: 1,0:16:33.08,0:16:34.81,Dial_CH,,0,0,0,,但太阳也快下山了
Dialogue: 1,0:16:37.54,0:16:38.63,Dial_CH,,0,0,0,,翼
Dialogue: 1,0:16:39.86,0:16:42.29,Dial_CH,,0,0,0,,刚刚拍的那张 拍得可爱不
Dialogue: 1,0:16:42.29,0:16:43.66,Dial_CH,,0,0,0,,那必须的
Dialogue: 1,0:16:43.66,0:16:44.86,Dial_CH,,0,0,0,,现在发给你
Dialogue: 1,0:16:47.80,0:16:48.58,Dial_CH,,0,0,0,,这是
Dialogue: 1,0:16:48.89,0:16:51.10,Dial_CH,,0,0,0,,哦 今天那张合照
Dialogue: 1,0:16:51.10,0:16:52.61,Dial_CH,,0,0,0,,我给换成头像了
Dialogue: 1,0:16:52.61,0:16:54.28,Dial_CH,,0,0,0,,都换头像了吗
Dialogue: 1,0:16:54.28,0:16:56.23,Dial_CH,,0,0,0,,我俩的合照
Dialogue: 1,0:16:56.23,0:16:59.62,Dial_CH,,0,0,0,,这样别人都能看到啊
Dialogue: 1,0:17:00.87,0:17:03.70,Dial_CH,,0,0,0,,在别人看来我们不就是情侣了吗
Dialogue: 1,0:17:07.33,0:17:11.22,Dial_CH,,0,0,0,,不不不 可能这就是她和朋友相处的正常模式
Dialogue: 1,0:17:17.27,0:17:18.37,Dial_CH,,0,0,0,,冬木同学
Dialogue: 1,0:17:19.80,0:17:23.81,Dial_CH,,0,0,0,,我一直在犹豫什么时候把这个给你
Dialogue: 1,0:17:24.73,0:17:25.68,Dial_CH,,0,0,0,,给我？
Dialogue: 1,0:17:29.98,0:17:31.18,Dial_CH,,0,0,0,,能打开吗
Dialogue: 1,0:17:37.01,0:17:38.19,Dial_CH,,0,0,0,,手绳
Dialogue: 1,0:17:39.62,0:17:41.81,Dial_CH,,0,0,0,,我在咖啡厅的杂货区看见的
Dialogue: 1,0:17:42.90,0:17:45.29,Dial_CH,,0,0,0,,感觉你戴上会很好看
Dialogue: 1,0:17:47.61,0:17:48.70,Dial_CH,,0,0,0,,翼
Dialogue: 1,0:17:50.91,0:17:51.76,Dial_CH,,0,0,0,,帮我戴上
Dialogue: 1,0:18:33.95,0:18:35.23,Dial_CH,,0,0,0,,你说我们
Dialogue: 1,0:18:36.00,0:18:38.65,Dial_CH,,0,0,0,,在外人眼里会是什么关系呢
Dialogue: 1,0:18:43.07,0:18:44.95,Dial_CH,,0,0,0,,我该怎么回答
Dialogue: 1,0:18:46.14,0:18:49.47,Dial_CH,,0,0,0,,要是我如实说出我心中所想
Dialogue: 1,0:18:50.64,0:18:53.10,Dial_CH,,0,0,0,,那不就相当于是…
Dialogue: 1,0:18:57.67,0:19:01.99,Dial_CH,,0,0,0,,那肯定是关系特别好的朋友吧
Dialogue: 1,0:19:11.34,0:19:13.27,Dial_CH,,0,0,0,,嘴都不利索了
Dialogue: 1,0:19:14.17,0:19:16.43,Dial_CH,,0,0,0,,更重要的是 我为什么
Dialogue: 1,0:19:17.00,0:19:18.64,Dial_CH,,0,0,0,,觉得特别心慌
Dialogue: 1,0:19:19.16,0:19:21.20,Dial_CH,,0,0,0,,就好比说了些绝对不该说的话
Dialogue: 1,0:19:23.89,0:19:24.75,Dial_CH,,0,0,0,,这样啊
Dialogue: 1,0:19:28.04,0:19:29.17,Dial_CH,,0,0,0,,也对
Dialogue: 1,0:19:34.95,0:19:37.61,Dial_CH,,0,0,0,,我明白了 是我太胆怯了
Dialogue: 1,0:19:41.36,0:19:43.96,Dial_CH,,0,0,0,,不敢触碰核心所在
Dialogue: 1,0:19:45.12,0:19:46.60,Dial_CH,,0,0,0,,因害怕而选择了逃避
Dialogue: 1,0:19:48.10,0:19:51.20,Dial_CH,,0,0,0,,冬木同学分明就在我身边
Dialogue: 1,0:19:52.04,0:19:56.35,Dial_CH,,0,0,0,,我却感觉下一秒她就将离我远去
Dialogue: 1,0:19:58.23,0:20:00.11,Dial_CH,,0,0,0,,不行 这不对
Dialogue: 1,0:20:00.35,0:20:03.82,Dial_CH,,0,0,0,,这不是我的真心话 我应该是…
Dialogue: 1,0:20:04.99,0:20:06.61,Dial_CH,,0,0,0,,冬木同学 我…
Dialogue: 1,0:20:06.61,0:20:08.13,Dial_CH,,0,0,0,,翼 我呢
Dialogue: 1,0:20:09.82,0:20:11.76,Dial_CH,,0,0,0,,下周就要离开了
Dialogue: 1,0:20:17.54,0:20:19.94,Dial_CH,,0,0,0,,我之前不是说过有事情想告诉你吗
Dialogue: 1,0:20:20.97,0:20:22.60,Dial_CH,,0,0,0,,对不起 拖到现在才说
Dialogue: 1,0:20:24.31,0:20:27.04,Dial_CH,,0,0,0,,我要去国外留学了
Dialogue: 1,0:20:31.63,0:20:34.68,Dial_CH,,0,0,0,,去国外 留学
Dialogue: 1,0:20:36.97,0:20:39.65,Dial_CH,,0,0,0,,为了将来能进入美容行业
Dialogue: 1,0:20:39.65,0:20:42.09,Dial_CH,,0,0,0,,想提前多学些东西
Dialogue: 1,0:20:44.45,0:20:46.38,Dial_CH,,0,0,0,,这都得谢谢你
Dialogue: 1,0:20:47.75,0:20:50.96,Dial_CH,,0,0,0,,遇到你之前 我对待事情的态度可随性了
Dialogue: 1,0:20:50.96,0:20:52.71,Dial_CH,,0,0,0,,啥事都是三分钟热度
Dialogue: 1,0:20:52.96,0:20:56.70,Dial_CH,,0,0,0,,几乎从没为了一件事情拼尽全力
Dialogue: 1,0:20:57.20,0:21:01.28,Dial_CH,,0,0,0,,可当我看到你在新环境下 忐忑不安却仍努力适应
Dialogue: 1,0:21:01.54,0:21:04.52,Dial_CH,,0,0,0,,无论滑雪还是学习 每一件事都尽心尽力
Dialogue: 1,0:21:04.52,0:21:07.04,Dial_CH,,0,0,0,,还那么会弹钢琴
Dialogue: 1,0:21:07.56,0:21:10.24,Dial_CH,,0,0,0,,与每个人都能做到真心换真心
Dialogue: 1,0:21:10.24,0:21:12.04,Dial_CH,,0,0,0,,与对方共情
Dialogue: 1,0:21:12.36,0:21:15.21,Dial_CH,,0,0,0,,你冰雪节的时候 玩游戏的时候
Dialogue: 1,0:21:16.53,0:21:20.98,Dial_CH,,0,0,0,,就连刚来到这里时 你的眼里都闪耀着光芒
Dialogue: 1,0:21:21.41,0:21:24.31,Dial_CH,,0,0,0,,是那么的纯粹 率真 诚挚
Dialogue: 1,0:21:25.02,0:21:26.87,Dial_CH,,0,0,0,,看到你
Dialogue: 1,0:21:29.58,0:21:34.92,Dial_CH,,0,0,0,,我就感觉自己也得好好努力 做出改变
Dialogue: 1,0:21:35.79,0:21:40.59,Dial_CH,,0,0,0,,你给了我改变自己的契机 所以我一定要好好报答你
Dialogue: 1,0:21:40.59,0:21:43.83,Dial_CH,,0,0,0,,其实我是在开学典礼那天想到今天这个惊喜的
Dialogue: 1,0:21:44.50,0:21:46.86,Dial_CH,,0,0,0,,还好在离开北海道之前
Dialogue: 1,0:21:46.86,0:21:49.62,Dial_CH,,0,0,0,,能和你一起来这里
Dialogue: 1,0:21:50.04,0:21:52.25,Dial_CH,,0,0,0,,你今天玩得开心吗…
Dialogue: 1,0:22:09.35,0:22:11.58,Dial_CH,,0,0,0,,翼… 翼宝
Dialogue: 1,0:22:24.28,0:22:25.80,Dial_CH,,0,0,0,,翼
