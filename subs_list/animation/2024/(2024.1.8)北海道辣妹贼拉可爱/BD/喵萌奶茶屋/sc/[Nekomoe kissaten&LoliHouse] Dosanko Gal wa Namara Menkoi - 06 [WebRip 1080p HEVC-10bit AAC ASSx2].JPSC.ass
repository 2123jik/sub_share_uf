Dialogue: 0,0:02:40.52,0:02:44.81,Title_CHS,,0,0,0,,{\fad(250,270)\blur5\pos(82,509)}第6话\N夏川学姐贼漂亮
Dialogue: 0,0:00:04.18,0:00:06.67,Dial_JP,,0,0,0,,来週から期末テスト始まるから
Dialogue: 0,0:00:06.67,0:00:08.91,Dial_JP,,0,0,0,,今週で追い込みかけるんだぞ
Dialogue: 0,0:00:09.14,0:00:10.38,Dial_JP,,0,0,0,,ウエエ
Dialogue: 0,0:00:10.38,0:00:13.37,Dial_JP,,0,0,0,,ウエエじゃない　それじゃ解散
Dialogue: 0,0:00:15.00,0:00:18.26,Dial_JP,,0,0,0,,期末範囲はひととおり全科目見直しできたし
Dialogue: 0,0:00:18.26,0:00:20.73,Dial_JP,,0,0,0,,あとは苦手なところだけ復習して
Dialogue: 0,0:00:22.50,0:00:26.42,Dial_JP,,0,0,0,,こないだ中間終わったと思ったらもう期末かあ
Dialogue: 0,0:00:26.71,0:00:28.66,Dial_JP,,0,0,0,,冬木さんは　テスト嫌い
Dialogue: 0,0:00:28.66,0:00:30.51,Dial_JP,,0,0,0,,好きなわけないっしょや
Dialogue: 0,0:00:31.27,0:00:34.18,Dial_JP,,0,0,0,,ってか　その言い方　翼はテスト好きなの
Dialogue: 0,0:00:35.12,0:00:36.87,Dial_JP,,0,0,0,,好きっていうか
Dialogue: 0,0:00:37.29,0:00:40.17,Dial_JP,,0,0,0,,努力が結果につながるっていう意味では
Dialogue: 0,0:00:40.17,0:00:42.11,Dial_JP,,0,0,0,,やりがいがあるっていうか
Dialogue: 0,0:00:43.60,0:00:45.86,Dial_JP,,0,0,0,,そんなふうに言う人初めてかも
Dialogue: 0,0:00:47.26,0:00:49.65,Dial_JP,,0,0,0,,ごめんね　つまんないヤツで
Dialogue: 0,0:00:49.65,0:00:51.90,Dial_JP,,0,0,0,,違う違う　その逆
Dialogue: 0,0:00:52.23,0:00:54.33,Dial_JP,,0,0,0,,さすがつばちゃ　偉いね
Dialogue: 0,0:00:55.33,0:00:57.12,Dial_JP,,0,0,0,,いやぁ　そんなことは
Dialogue: 0,0:00:57.12,0:01:00.07,Dial_JP,,0,0,0,,よーし　なんかやる気出てきた
Dialogue: 0,0:01:00.07,0:01:02.13,Dial_JP,,0,0,0,,翼　翼　このあと暇
Dialogue: 0,0:01:03.67,0:01:05.46,Dial_JP,,0,0,0,,うちで勉強会しない
Dialogue: 0,0:02:43.25,0:02:45.35,Dial_JP,,500,0,0,,で　なんで私まで
Dialogue: 0,0:02:45.54,0:02:47.98,Dial_JP,,0,0,0,,だって多いほうが楽しいじゃん
Dialogue: 0,0:02:48.94,0:02:51.11,Dial_JP,,0,0,0,,お前　勉強する気ないだろう
Dialogue: 0,0:02:51.11,0:02:53.18,Dial_JP,,0,0,0,,そんなことないよ
Dialogue: 0,0:02:53.18,0:02:56.73,Dial_JP,,0,0,0,,今回ばかりはさすがのうちもヤバいと思ってさあ
Dialogue: 0,0:02:56.99,0:02:59.67,Dial_JP,,0,0,0,,まあ　でも四季がいれば安心だな
Dialogue: 0,0:02:59.67,0:03:01.25,Dial_JP,,0,0,0,,頭よさそうだし
Dialogue: 0,0:03:01.25,0:03:04.90,Dial_JP,,0,0,0,,翼はうちら専属の家庭教師です
Dialogue: 0,0:03:05.67,0:03:07.29,Dial_JP,,0,0,0,,家庭教師
Dialogue: 0,0:03:08.32,0:03:11.11,Dial_JP,,0,0,0,,人に教えるのは自分の身にもなるし
Dialogue: 0,0:03:11.41,0:03:12.45,Dial_JP,,0,0,0,,まあいいか
Dialogue: 0,0:03:12.99,0:03:14.13,Dial_JP,,0,0,0,,ただいま
Dialogue: 0,0:03:14.13,0:03:15.00,Dial_JP,,0,0,0,,おじゃまします
Dialogue: 0,0:03:15.00,0:03:16.35,Dial_JP,,0,0,0,,しまーす
Dialogue: 0,0:03:16.35,0:03:17.68,Dial_JP,,0,0,0,,って　誰もいないの
Dialogue: 0,0:03:18.55,0:03:20.32,Dial_JP,,0,0,0,,ママとパパは仕事で
Dialogue: 0,0:03:20.32,0:03:22.37,Dial_JP,,0,0,0,,妹はダンス教室行ってる
Dialogue: 0,0:03:23.30,0:03:24.47,Dial_JP,,0,0,0,,妹いるんだ
Dialogue: 0,0:03:24.47,0:03:25.71,Dial_JP,,0,0,0,,いるよ
Dialogue: 0,0:03:25.71,0:03:27.81,Dial_JP,,0,0,0,,どう見てもお姉ちゃんしょ
Dialogue: 0,0:03:28.02,0:03:30.32,Dial_JP,,0,0,0,,いや　どう見ても妹キャラ
Dialogue: 0,0:03:32.86,0:03:34.31,Dial_JP,,0,0,0,,飲み物持ってくから
Dialogue: 0,0:03:34.31,0:03:36.61,Dial_JP,,0,0,0,,とりまうちの部屋　先行って待ってて
Dialogue: 0,0:03:36.61,0:03:37.83,Dial_JP,,0,0,0,,２階ね
Dialogue: 0,0:03:37.83,0:03:39.53,Dial_JP,,0,0,0,,いいけど　どの部屋
Dialogue: 0,0:03:39.53,0:03:41.35,Dial_JP,,0,0,0,,いちばん奥
Dialogue: 0,0:03:41.35,0:03:42.43,Dial_JP,,0,0,0,,おけ
Dialogue: 0,0:03:44.77,0:03:46.99,Dial_JP,,0,0,0,,冬木んち来るの初めてなんだから
Dialogue: 0,0:03:46.99,0:03:48.99,Dial_JP,,0,0,0,,説明なきゃわかんないよな
Dialogue: 0,0:03:49.79,0:03:52.88,Dial_JP,,0,0,0,,俺実は　前に一回遊びに来たことあるんだ
Dialogue: 0,0:03:54.18,0:03:57.92,Dial_JP,,0,0,0,,でもそのときは　リビングで一緒に映画観ただけだから
Dialogue: 0,0:03:57.92,0:03:59.57,Dial_JP,,0,0,0,,部屋は入ってないけど
Dialogue: 0,0:04:01.69,0:04:03.43,Dial_JP,,0,0,0,,四季って　なんつうか
Dialogue: 0,0:04:03.93,0:04:05.31,Dial_JP,,0,0,0,,ちゃっかりスケベだな
Dialogue: 0,0:04:05.46,0:04:06.15,Dial_JP,,0,0,0,,スケ…
Dialogue: 0,0:04:06.53,0:04:08.94,Dial_JP,,0,0,0,,いや　別になんもないよ
Dialogue: 0,0:04:09.17,0:04:11.97,Dial_JP,,0,0,0,,なんなら　途中で冬木さん寝ちゃったし
Dialogue: 0,0:04:12.23,0:04:13.41,Dial_JP,,0,0,0,,はいはい
Dialogue: 0,0:04:14.29,0:04:15.47,Dial_JP,,0,0,0,,この部屋か
Dialogue: 0,0:04:23.97,0:04:25.50,Dial_JP,,0,0,0,,冬木みがすごい
Dialogue: 0,0:04:25.72,0:04:26.75,Dial_JP,,0,0,0,,確かに
Dialogue: 0,0:04:36.68,0:04:39.31,Dial_JP,,0,0,0,,女子の部屋に入るなんて初めてだ
Dialogue: 0,0:04:39.57,0:04:41.75,Dial_JP,,0,0,0,,すんごいいい匂いがする
Dialogue: 0,0:04:43.57,0:04:47.24,Dial_JP,,0,0,0,,ここで冬木さんは　毎日過ごしてるんだもんなあ
Dialogue: 0,0:04:47.73,0:04:49.52,Dial_JP,,0,0,0,,遊んだり　寝たり
Dialogue: 0,0:04:55.28,0:04:56.43,Dial_JP,,0,0,0,,着替えたり
Dialogue: 0,0:04:57.40,0:05:00.04,Dial_JP,,0,0,0,,って　何考えてるんだ　俺は
Dialogue: 0,0:05:03.68,0:05:05.12,Dial_JP,,0,0,0,,しっかりスケベ
Dialogue: 0,0:05:06.09,0:05:07.66,Dial_JP,,0,0,0,,お待たせ
Dialogue: 0,0:05:07.66,0:05:09.70,Dial_JP,,0,0,0,,ジュース持ってきたよ
Dialogue: 0,0:05:15.26,0:05:17.21,Dial_JP,,0,0,0,,いいね　私これ好き
Dialogue: 0,0:05:17.21,0:05:19.76,Dial_JP,,0,0,0,,うまいよね　うちも好き
Dialogue: 0,0:05:20.04,0:05:21.79,Dial_JP,,0,0,0,,「リボンナポリン」？
Dialogue: 0,0:05:25.71,0:05:27.19,Dial_JP,,0,0,0,,飲むの初めて？
Dialogue: 0,0:05:27.19,0:05:28.92,Dial_JP,,0,0,0,,したっけ感想聞かせて
Dialogue: 0,0:05:29.18,0:05:30.14,Dial_JP,,0,0,0,,ありがとう
Dialogue: 0,0:05:30.88,0:05:31.48,Dial_JP,,0,0,0,,サンキュ
Dialogue: 0,0:05:39.43,0:05:40.70,Dial_JP,,0,0,0,,おいしいね　これ
Dialogue: 0,0:05:40.70,0:05:41.84,Dial_JP,,0,0,0,,でしょ
Dialogue: 0,0:05:41.84,0:05:45.62,Dial_JP,,0,0,0,,超昔からある　北海道のソウルドリンクなんだよ
Dialogue: 0,0:05:47.66,0:05:49.67,Dial_JP,,0,0,0,,この炭酸　たまんない
Dialogue: 0,0:05:49.67,0:05:51.08,Dial_JP,,0,0,0,,頭がさえてきた
Dialogue: 0,0:05:51.08,0:05:52.32,Dial_JP,,0,0,0,,なるほど
Dialogue: 0,0:05:52.58,0:05:55.21,Dial_JP,,0,0,0,,勉強会にはもってこいのジュースってわけだね
Dialogue: 0,0:05:56.26,0:05:57.10,Dial_JP,,0,0,0,,確かに
Dialogue: 0,0:05:57.10,0:05:59.96,Dial_JP,,0,0,0,,そうだ　みんなで問題出し合おうよ
Dialogue: 0,0:05:59.96,0:06:02.34,Dial_JP,,0,0,0,,いいけど　なんの教科にする
Dialogue: 0,0:06:02.64,0:06:06.76,Dial_JP,,0,0,0,,試験１日目の教科がいいと思う　世界史とかは
Dialogue: 0,0:06:06.76,0:06:08.12,Dial_JP,,0,0,0,,オッケー
Dialogue: 0,0:06:08.12,0:06:09.89,Dial_JP,,0,0,0,,したっけ　翼から
Dialogue: 0,0:06:11.70,0:06:15.04,Dial_JP,,0,0,0,,それじゃあ　簡単なところから
Dialogue: 0,0:06:15.56,0:06:17.90,Dial_JP,,0,0,0,,神の意志は絶対的であり
Dialogue: 0,0:06:17.90,0:06:20.37,Dial_JP,,0,0,0,,個人が救済されるかどうかは
Dialogue: 0,0:06:20.37,0:06:23.30,Dial_JP,,0,0,0,,あらかじめ神によって決められているという
Dialogue: 0,0:06:23.30,0:06:26.83,Dial_JP,,0,0,0,,カルヴァンが提唱したキリスト教の神学思想を
Dialogue: 0,0:06:26.83,0:06:28.04,Dial_JP,,0,0,0,,なんというでしょう
Dialogue: 0,0:06:29.41,0:06:30.94,Dial_JP,,0,0,0,,それ　なんだっけ
Dialogue: 0,0:06:30.94,0:06:32.65,Dial_JP,,0,0,0,,ヒントは埋まると大変
Dialogue: 0,0:06:34.32,0:06:35.00,Dial_JP,,0,0,0,,予定だ
Dialogue: 0,0:06:35.00,0:06:35.92,Dial_JP,,0,0,0,,予定説
Dialogue: 0,0:06:35.92,0:06:37.26,Dial_JP,,0,0,0,,秋野さん正解
Dialogue: 0,0:06:38.94,0:06:42.03,Dial_JP,,0,0,0,,予定はね　埋まると大変だもんね
Dialogue: 0,0:06:42.03,0:06:43.30,Dial_JP,,0,0,0,,じゃあ次は　さゆりん
Dialogue: 0,0:06:43.87,0:06:46.26,Dial_JP,,0,0,0,,え…　えっと　そしたら
Dialogue: 0,0:06:46.91,0:06:52.50,Dial_JP,,0,0,0,,1559年にイギリス　テューダー朝の女王エリザベス一世が
Dialogue: 0,0:06:52.50,0:06:57.46,Dial_JP,,0,0,0,,イギリス国教会の礼拝　祈とうの基準を確立した法をなんという
Dialogue: 0,0:06:58.41,0:07:00.00,Dial_JP,,0,0,0,,統一法だよね
Dialogue: 0,0:07:00.76,0:07:03.03,Dial_JP,,0,0,0,,やっぱり四季はすぐわかるかあ
Dialogue: 0,0:07:03.32,0:07:05.72,Dial_JP,,0,0,0,,じゃあ　次は冬木が問題出す番
Dialogue: 0,0:07:06.99,0:07:08.80,Dial_JP,,0,0,0,,えっと　えっと
Dialogue: 0,0:07:12.42,0:07:17.63,Dial_JP,,0,0,0,,昔　北見は　ハッカの生産量世界の70パーセントだったんだって
Dialogue: 0,0:07:17.63,0:07:18.99,Dial_JP,,0,0,0,,なんの話
Dialogue: 0,0:07:19.34,0:07:21.56,Dial_JP,,0,0,0,,それはそれですごいけども
Dialogue: 0,0:07:21.56,0:07:25.26,Dial_JP,,0,0,0,,だからか　おばあちゃんちとかに絶対ハッカアメあるの
Dialogue: 0,0:07:25.26,0:07:28.06,Dial_JP,,0,0,0,,パパがこの前教えてくれたさあ
Dialogue: 0,0:07:28.06,0:07:30.14,Dial_JP,,0,0,0,,ヤバいよねえ　すごいしょ
Dialogue: 0,0:07:30.45,0:07:33.46,Dial_JP,,0,0,0,,すごいけど　全然テスト範囲じゃないし
Dialogue: 0,0:07:33.76,0:07:35.52,Dial_JP,,0,0,0,,問題にもなってないぞ
Dialogue: 0,0:07:36.84,0:07:39.61,Dial_JP,,0,0,0,,うちもいいとこ見せようと思って
Dialogue: 0,0:07:39.87,0:07:41.83,Dial_JP,,0,0,0,,一緒に頑張ろう　冬木さん
Dialogue: 0,0:07:42.19,0:07:44.88,Dial_JP,,0,0,0,,今からでも大丈夫　やればできるよ
Dialogue: 0,0:07:45.23,0:07:46.84,Dial_JP,,0,0,0,,つばちゃ
Dialogue: 0,0:07:46.84,0:07:49.40,Dial_JP,,0,0,0,,よーし　うちなまら頑張る
Dialogue: 0,0:07:49.40,0:07:51.87,Dial_JP,,0,0,0,,四季は冬木に甘いなあ
Dialogue: 0,0:07:52.12,0:07:54.46,Dial_JP,,0,0,0,,ってか　私にも教えてよ
Dialogue: 0,0:07:54.46,0:07:55.40,Dial_JP,,0,0,0,,もちろん
Dialogue: 0,0:07:55.63,0:07:58.62,Dial_JP,,0,0,0,,それじゃ　まずはここの問題だけど
Dialogue: 0,0:08:13.27,0:08:16.02,Dial_JP,,0,0,0,,おかずは竜田揚げにしましょうかね
Dialogue: 0,0:08:21.80,0:08:24.55,Dial_JP,,0,0,0,,1000年ぶりにちゃんと勉強したから
Dialogue: 0,0:08:24.55,0:08:26.28,Dial_JP,,0,0,0,,頭がわや
Dialogue: 0,0:08:26.48,0:08:27.56,Dial_JP,,0,0,0,,疲れた
Dialogue: 0,0:08:27.56,0:08:30.45,Dial_JP,,0,0,0,,２人とも偉いよ　よく頑張ったね
Dialogue: 0,0:08:31.01,0:08:32.70,Dial_JP,,0,0,0,,そういえば　今何時
Dialogue: 0,0:08:33.65,0:08:35.70,Dial_JP,,0,0,0,,ヤッバ　門限過ぎてる
Dialogue: 0,0:08:36.14,0:08:38.71,Dial_JP,,0,0,0,,勉強に集中しすぎて時間忘れた
Dialogue: 0,0:08:38.71,0:08:40.87,Dial_JP,,0,0,0,,ごめん　俺もう帰らないと
Dialogue: 0,0:08:42.01,0:08:43.13,Dial_JP,,0,0,0,,ちょっと　翼
Dialogue: 0,0:08:43.13,0:08:44.25,Dial_JP,,0,0,0,,おい　四季
Dialogue: 0,0:08:44.25,0:08:45.57,Dial_JP,,0,0,0,,じゃあね　２人とも
Dialogue: 0,0:08:50.56,0:08:51.91,Dial_JP,,0,0,0,,おじゃましました
Dialogue: 0,0:08:52.44,0:08:53.97,Dial_JP,,0,0,0,,たっだいまあ
Dialogue: 0,0:09:03.81,0:09:05.25,Dial_JP,,0,0,0,,つばち
Dialogue: 0,0:09:09.41,0:09:12.91,Dial_JP,,0,0,0,,そっかそっか　うちで勉強してたんだね
Dialogue: 0,0:09:13.07,0:09:13.83,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:09:14.04,0:09:16.66,Dial_JP,,0,0,0,,ホントに　何から何まですみません
Dialogue: 0,0:09:17.24,0:09:20.10,Dial_JP,,0,0,0,,まだ　顔に感触と甘い匂いが
Dialogue: 0,0:09:20.54,0:09:22.21,Dial_JP,,0,0,0,,なんもなんも
Dialogue: 0,0:09:22.21,0:09:24.64,Dial_JP,,0,0,0,,ちょうど帰ってきたタイミングだったからね
Dialogue: 0,0:09:24.64,0:09:28.19,Dial_JP,,0,0,0,,家も近いんだし　車で送るくらい気にしないで
Dialogue: 0,0:09:28.19,0:09:29.58,Dial_JP,,0,0,0,,ありがとうございます
Dialogue: 0,0:09:30.02,0:09:32.50,Dial_JP,,0,0,0,,そういえば　みーから聞いたよ
Dialogue: 0,0:09:33.60,0:09:35.74,Dial_JP,,0,0,0,,ピアノ上手なんだってねえ
Dialogue: 0,0:09:36.77,0:09:39.77,Dial_JP,,0,0,0,,小さいころから　ずっと習ってまして
Dialogue: 0,0:09:40.42,0:09:42.05,Dial_JP,,0,0,0,,そうなんだあ
Dialogue: 0,0:09:43.84,0:09:46.97,Dial_JP,,0,0,0,,もしかしたら　聞いてるかもしれないけど
Dialogue: 0,0:09:47.36,0:09:51.19,Dial_JP,,0,0,0,,バレンタインの日　あの子いろいろあって落ち込んでてさ
Dialogue: 0,0:09:51.64,0:09:55.68,Dial_JP,,0,0,0,,帰ってきたらどんな顔してるかなあって心配してたんだけどね
Dialogue: 0,0:09:56.68,0:09:58.63,Dial_JP,,0,0,0,,なまら笑顔で帰ってきて
Dialogue: 0,0:09:58.63,0:10:02.00,Dial_JP,,0,0,0,,いきなり「翼が　ピアノ上手だったあ」って言うの
Dialogue: 0,0:10:02.00,0:10:04.13,Dial_JP,,0,0,0,,マジウケるって思ってさ
Dialogue: 0,0:10:05.08,0:10:07.23,Dial_JP,,0,0,0,,なんかすんごい恥ずかしい
Dialogue: 0,0:10:07.51,0:10:08.77,Dial_JP,,0,0,0,,顔が熱い
Dialogue: 0,0:10:09.43,0:10:11.67,Dial_JP,,0,0,0,,すっごい安心した
Dialogue: 0,0:10:13.31,0:10:15.21,Dial_JP,,0,0,0,,ありがとね　つばち
Dialogue: 0,0:10:18.40,0:10:19.59,Dial_JP,,0,0,0,,こちらこそです
Dialogue: 0,0:10:30.01,0:10:32.73,Dial_JP,,0,0,0,,本当にお城みたいなおうちだね
Dialogue: 0,0:10:32.73,0:10:33.78,Dial_JP,,0,0,0,,いえいえ
Dialogue: 0,0:10:34.26,0:10:36.52,Dial_JP,,0,0,0,,送っていただいてありがとうございました
Dialogue: 0,0:10:37.01,0:10:37.83,Dial_JP,,0,0,0,,待って
Dialogue: 0,0:10:38.20,0:10:40.57,Dial_JP,,0,0,0,,これ自分用に買ったやつだけど
Dialogue: 0,0:10:40.79,0:10:42.18,Dial_JP,,0,0,0,,つばっちにあげる
Dialogue: 0,0:10:42.18,0:10:43.16,Dial_JP,,0,0,0,,冷たっ
Dialogue: 0,0:10:43.16,0:10:46.96,Dial_JP,,0,0,0,,いつも頑張ってる君に　ママからのご褒美
Dialogue: 0,0:10:50.59,0:10:52.21,Dial_JP,,0,0,0,,それ飲んで　ガンバ
Dialogue: 0,0:10:52.43,0:10:53.83,Dial_JP,,0,0,0,,したっけね
Dialogue: 0,0:10:56.30,0:10:57.42,Dial_JP,,0,0,0,,頑張ります
Dialogue: 0,0:10:57.76,0:10:58.86,Dial_JP,,0,0,0,,翼ちゃん
Dialogue: 0,0:11:04.10,0:11:06.48,Dial_JP,,0,0,0,,今何時だと思ってるの
Dialogue: 0,0:11:14.27,0:11:15.24,Dial_JP,,0,0,0,,翼ちゃん
Dialogue: 0,0:11:16.07,0:11:16.74,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:11:17.59,0:11:21.44,Dial_JP,,0,0,0,,学校に行くついてに　燃えるゴミを出してくてもらえる
Dialogue: 0,0:11:21.44,0:11:23.55,Dial_JP,,0,0,0,,わかりました　おばあちゃん
Dialogue: 0,0:11:27.39,0:11:28.58,Dial_JP,,0,0,0,,行ってきます
Dialogue: 0,0:11:33.46,0:11:36.44,Dial_JP,,0,0,0,,昨日はおばあちゃんにこっぴどく叱られたから
Dialogue: 0,0:11:36.70,0:11:38.95,Dial_JP,,0,0,0,,今日も緊張感が残ってるな
Dialogue: 0,0:11:40.32,0:11:44.46,Dial_JP,,0,0,0,,この家にいるかぎり　私のルールに従ってもらう
Dialogue: 0,0:11:44.46,0:11:48.31,Dial_JP,,0,0,0,,それが条件だと　再三伝えたはずですが
Dialogue: 0,0:11:49.10,0:11:51.33,Dial_JP,,0,0,0,,はい　そのとおりです
Dialogue: 0,0:11:54.21,0:11:57.27,Dial_JP,,0,0,0,,今回のことは私の胸にとどめておきます
Dialogue: 0,0:11:57.27,0:12:00.99,Dial_JP,,0,0,0,,ですが　また粗相をするようなことがあれば
Dialogue: 0,0:12:02.67,0:12:04.44,Dial_JP,,0,0,0,,わかっていますね
Dialogue: 0,0:12:04.93,0:12:07.94,Dial_JP,,0,0,0,,はい　本当にすみませんでした
Dialogue: 0,0:12:27.55,0:12:29.09,Dial_JP,,0,0,0,,海外の人かな
Dialogue: 0,0:12:30.36,0:12:32.39,Dial_JP,,0,0,0,,すごいきれいな人だ
Dialogue: 0,0:12:33.11,0:12:35.97,Dial_JP,,0,0,0,,凛として　雪景色が似合ってて
Dialogue: 0,0:12:36.69,0:12:38.89,Dial_JP,,0,0,0,,ゴミ捨て場の前で何してるんだろう
Dialogue: 0,0:12:40.21,0:12:42.69,Dial_JP,,0,0,0,,ゴミを持っているわけでもなさそうだし
Dialogue: 0,0:12:53.96,0:12:56.10,Dial_JP,,0,0,0,,口ほどにもないヤツらだ
Dialogue: 0,0:13:05.93,0:13:08.65,Dial_JP,,0,0,0,,やからは私が追っ払っておいたので
Dialogue: 0,0:13:08.65,0:13:11.35,Dial_JP,,0,0,0,,思う存分ゴミを投げてください
Dialogue: 0,0:13:12.38,0:13:13.19,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:13:13.19,0:13:15.82,Dial_JP,,0,0,0,,それじゃあ　私はドロンします
Dialogue: 0,0:13:17.53,0:13:19.08,Dial_JP,,0,0,0,,ド…　ドロン
Dialogue: 0,0:13:24.71,0:13:26.70,Dial_JP,,0,0,0,,それって怜奈先輩じゃない
Dialogue: 0,0:13:26.70,0:13:27.90,Dial_JP,,0,0,0,,怜奈先輩
Dialogue: 0,0:13:27.90,0:13:31.47,Dial_JP,,0,0,0,,ショートのホワイトピンクベージュで和柄のカチューシャとか
Dialogue: 0,0:13:31.47,0:13:33.44,Dial_JP,,0,0,0,,絶対　怜奈先輩じゃん
Dialogue: 0,0:13:33.92,0:13:37.09,Dial_JP,,0,0,0,,朝から怜奈先輩に会えたとか羨ましい
Dialogue: 0,0:13:37.34,0:13:38.88,Dial_JP,,0,0,0,,知ってるの　冬木さん
Dialogue: 0,0:13:38.88,0:13:41.88,Dial_JP,,0,0,0,,知ってるも何も　うちの憧れだもん
Dialogue: 0,0:13:42.55,0:13:45.42,Dial_JP,,0,0,0,,２年連続　うちのミスなんだよ
Dialogue: 0,0:13:45.42,0:13:48.59,Dial_JP,,0,0,0,,たしか親か親戚が外国の人で
Dialogue: 0,0:13:48.59,0:13:51.35,Dial_JP,,0,0,0,,この辺じゃ有名な超絶美人
Dialogue: 0,0:14:02.44,0:14:04.34,Dial_JP,,0,0,0,,いいよねえ
Dialogue: 0,0:14:04.34,0:14:07.87,Dial_JP,,0,0,0,,うちも生まれ変われるならあんなギャルに生まれ変わりたい
Dialogue: 0,0:14:10.16,0:14:13.57,Dial_JP,,0,0,0,,確かに日本人離れしたきれいさだったもんな
Dialogue: 0,0:14:14.60,0:14:15.73,Dial_JP,,0,0,0,,ってか翼
Dialogue: 0,0:14:16.62,0:14:20.51,Dial_JP,,0,0,0,,今日もうちで勉強会しない　さゆりんも誘ってさ
Dialogue: 0,0:14:21.25,0:14:22.17,Dial_JP,,0,0,0,,ごめん
Dialogue: 0,0:14:22.17,0:14:26.05,Dial_JP,,0,0,0,,俺は今日からテスト当日まで一人で勉強するよ
Dialogue: 0,0:14:27.61,0:14:28.34,Dial_JP,,0,0,0,,もちろん
Dialogue: 0,0:14:28.34,0:14:30.93,Dial_JP,,0,0,0,,２人と勉強するのが嫌とかじゃないよ
Dialogue: 0,0:14:30.93,0:14:33.60,Dial_JP,,0,0,0,,ただ　ちょっと一人で集中したいんだ
Dialogue: 0,0:14:34.12,0:14:36.84,Dial_JP,,0,0,0,,しょっかあ　かなしみ
Dialogue: 0,0:14:37.09,0:14:38.82,Dial_JP,,0,0,0,,でも　しかたないね
Dialogue: 0,0:14:40.09,0:14:42.87,Dial_JP,,0,0,0,,おばあちゃんに怒られたことは黙っとこう
Dialogue: 0,0:14:43.32,0:14:45.82,Dial_JP,,0,0,0,,２人には心配かけたくないしな
Dialogue: 0,0:14:46.00,0:14:49.59,Dial_JP,,0,0,0,,したっけ　さゆりん誘って２人で勉強しよっと
Dialogue: 0,0:14:49.87,0:14:51.54,Dial_JP,,0,0,0,,私も断る
Dialogue: 0,0:14:51.78,0:14:52.92,Dial_JP,,0,0,0,,さゆりん
Dialogue: 0,0:14:53.25,0:14:55.00,Dial_JP,,0,0,0,,ってか　断るの
Dialogue: 0,0:14:55.00,0:14:56.30,Dial_JP,,0,0,0,,だって　どうせ
Dialogue: 0,0:14:56.30,0:14:59.29,Dial_JP,,0,0,0,,昨日　四季が帰ったあとみたいにだべって終わるだろ
Dialogue: 0,0:15:00.40,0:15:01.45,Dial_JP,,0,0,0,,確かに
Dialogue: 0,0:15:01.80,0:15:05.06,Dial_JP,,0,0,0,,俺が帰ったあと勉強してたんじゃないんだ
Dialogue: 0,0:15:11.53,0:15:14.00,Dial_JP,,0,0,0,,さゆりん　一緒に食べよ
Dialogue: 0,0:15:14.00,0:15:16.79,Dial_JP,,0,0,0,,無理　ゲームの攻略調べてるから
Dialogue: 0,0:15:18.51,0:15:21.03,Dial_JP,,0,0,0,,まっ　邪魔にならなければいっか
Dialogue: 0,0:15:21.03,0:15:22.94,Dial_JP,,0,0,0,,どんだけ寂しがりやなんだよ
Dialogue: 0,0:15:23.10,0:15:26.15,Dial_JP,,0,0,0,,だって　ごはんは一人で食べるもんじゃないし
Dialogue: 0,0:15:26.15,0:15:28.12,Dial_JP,,0,0,0,,気付いたら翼もいないし
Dialogue: 0,0:15:29.50,0:15:30.53,Dial_JP,,0,0,0,,ホントだ
Dialogue: 0,0:15:31.26,0:15:32.83,Dial_JP,,0,0,0,,どこ行ったんだろうね
Dialogue: 0,0:15:33.03,0:15:35.10,Dial_JP,,0,0,0,,ねっ　翼のくせに
Dialogue: 0,0:15:35.90,0:15:38.94,Dial_JP,,0,0,0,,もしかして　勉強会　断られたの根に持って？
Dialogue: 0,0:15:38.94,0:15:40.87,Dial_JP,,0,0,0,,ち…　違うし
Dialogue: 0,0:15:40.87,0:15:44.09,Dial_JP,,0,0,0,,そんなちっちゃいことで不機嫌になったりしないも～ん
Dialogue: 0,0:15:44.32,0:15:46.82,Dial_JP,,0,0,0,,まあ　四季にもいろいろあるんでしょ
Dialogue: 0,0:15:46.82,0:15:48.34,Dial_JP,,0,0,0,,あんまり気にすんな
Dialogue: 0,0:15:51.31,0:15:54.08,Dial_JP,,0,0,0,,さゆりんって　なんかおばあちゃんみたいだね
Dialogue: 0,0:15:54.08,0:15:56.47,Dial_JP,,0,0,0,,全然褒めてないからね　それ
Dialogue: 0,0:16:02.66,0:16:05.63,Dial_JP,,0,0,0,,気分転換に初めて図書室に来たけど
Dialogue: 0,0:16:05.63,0:16:07.99,Dial_JP,,0,0,0,,集中できて勉強はかどるな
Dialogue: 0,0:16:10.02,0:16:10.91,Dial_JP,,0,0,0,,いびき？
Dialogue: 0,0:16:17.09,0:16:18.42,Dial_JP,,0,0,0,,怜奈先輩
Dialogue: 0,0:16:19.27,0:16:21.51,Dial_JP,,0,0,0,,なぜこんな所で爆睡を
Dialogue: 0,0:16:21.51,0:16:24.48,Dial_JP,,0,0,0,,というか　寝顔が美しすぎる
Dialogue: 0,0:16:24.48,0:16:27.15,Dial_JP,,0,0,0,,どんな夢見たらこんないい寝顔になるんだ
Dialogue: 0,0:16:28.90,0:16:31.14,Dial_JP,,0,0,0,,なんか　見てるだけで癒やされる
Dialogue: 0,0:16:31.53,0:16:34.59,Dial_JP,,0,0,0,,テスト勉強の疲れに会心の効き目
Dialogue: 0,0:16:37.96,0:16:38.89,Dial_JP,,0,0,0,,起きた
Dialogue: 0,0:16:41.02,0:16:42.94,Dial_JP,,0,0,0,,関ヶ原は…
Dialogue: 0,0:16:42.94,0:16:44.52,Dial_JP,,0,0,0,,戦の夢？
Dialogue: 0,0:16:44.52,0:16:46.94,Dial_JP,,0,0,0,,そんな殺伐とした夢であの顔に
Dialogue: 0,0:16:50.44,0:16:51.92,Dial_JP,,0,0,0,,目が合ってしまった
Dialogue: 0,0:16:52.23,0:16:54.21,Dial_JP,,0,0,0,,ずっと見てたの気付かれたかな
Dialogue: 0,0:16:54.62,0:16:55.75,Dial_JP,,0,0,0,,いや　待て待て
Dialogue: 0,0:16:55.75,0:16:57.65,Dial_JP,,0,0,0,,その前に集中しろ　俺
Dialogue: 0,0:16:57.65,0:16:59.75,Dial_JP,,0,0,0,,さっきから手が動いてないぞ
Dialogue: 0,0:17:00.03,0:17:02.21,Dial_JP,,0,0,0,,よし　勉強勉強
Dialogue: 0,0:17:07.28,0:17:08.71,Dial_JP,,0,0,0,,な…　なんですか
Dialogue: 0,0:17:09.85,0:17:11.69,Dial_JP,,0,0,0,,私は図書委員です
Dialogue: 0,0:17:12.66,0:17:15.87,Dial_JP,,0,0,0,,なので今図書室の権限は私にあります
Dialogue: 0,0:17:17.75,0:17:21.65,Dial_JP,,0,0,0,,つまり　私が許せば　寝てても問題ないのです
Dialogue: 0,0:17:22.22,0:17:24.04,Dial_JP,,0,0,0,,寝てたの気にしてた
Dialogue: 0,0:17:24.04,0:17:26.92,Dial_JP,,0,0,0,,いや　あの　全然僕は気にしないので
Dialogue: 0,0:17:26.92,0:17:27.99,Dial_JP,,0,0,0,,あなた
Dialogue: 0,0:17:28.40,0:17:30.63,Dial_JP,,0,0,0,,とっても姿勢いいですね
Dialogue: 0,0:17:30.86,0:17:32.47,Dial_JP,,0,0,0,,何かやってますか
Dialogue: 0,0:17:33.61,0:17:35.24,Dial_JP,,0,0,0,,いや　あの　その
Dialogue: 0,0:17:36.37,0:17:39.06,Dial_JP,,0,0,0,,勉強中でしたよね　すみません
Dialogue: 0,0:17:39.06,0:17:40.68,Dial_JP,,0,0,0,,いえいえ　全然
Dialogue: 0,0:17:40.68,0:17:41.33,Dial_JP,,0,0,0,,おや
Dialogue: 0,0:17:42.36,0:17:45.79,Dial_JP,,0,0,0,,ここの答え　丸がついてるけれど　間違ってますよ
Dialogue: 0,0:17:49.94,0:17:51.09,Dial_JP,,0,0,0,,本当だ
Dialogue: 0,0:17:51.32,0:17:55.80,Dial_JP,,0,0,0,,そのテスト範囲ってことは　１年生さんだったんですね
Dialogue: 0,0:17:55.80,0:17:57.87,Dial_JP,,0,0,0,,勉強　頑張ってください
Dialogue: 0,0:17:58.19,0:18:00.23,Dial_JP,,0,0,0,,はい　ありがとうございます
Dialogue: 0,0:18:02.84,0:18:07.23,Dial_JP,,0,0,0,,もしかして　一目見てこの問題を頭の中で解いたのか
Dialogue: 0,0:18:09.95,0:18:12.28,Dial_JP,,0,0,0,,さすがにそれは無理だよな
Dialogue: 0,0:18:12.77,0:18:15.79,Dial_JP,,0,0,0,,同じ問題集やったことがあるとかかな
Dialogue: 0,0:18:20.35,0:18:21.32,Dial_JP,,0,0,0,,ただいま
Dialogue: 0,0:18:23.76,0:18:24.58,Dial_JP,,0,0,0,,おばあちゃん
Dialogue: 0,0:18:26.13,0:18:27.84,Dial_JP,,0,0,0,,おかえりなさい
Dialogue: 0,0:18:28.06,0:18:30.53,Dial_JP,,0,0,0,,えっど…　どうしたの
Dialogue: 0,0:18:30.53,0:18:33.65,Dial_JP,,0,0,0,,今日一日　ずっと考えてました
Dialogue: 0,0:18:33.65,0:18:37.16,Dial_JP,,0,0,0,,翼ちゃんのためにできることはいったい何かと
Dialogue: 0,0:18:38.64,0:18:42.10,Dial_JP,,0,0,0,,あなたが年頃だということはわかっています
Dialogue: 0,0:18:42.10,0:18:45.05,Dial_JP,,0,0,0,,私が理解できないこともあるでしょう
Dialogue: 0,0:18:45.48,0:18:46.61,Dial_JP,,0,0,0,,おばあちゃん
Dialogue: 0,0:18:46.99,0:18:52.60,Dial_JP,,0,0,0,,ですがやはり　あなたは北海道に来てから非常に緩んでいます
Dialogue: 0,0:18:52.94,0:18:57.96,Dial_JP,,0,0,0,,今のあなたには　ゆっくり精神を整える時間が必要
Dialogue: 0,0:18:58.42,0:18:59.24,Dial_JP,,0,0,0,,つまり
Dialogue: 0,0:19:00.88,0:19:02.14,Dial_JP,,0,0,0,,お茶です
Dialogue: 0,0:19:02.70,0:19:05.49,Dial_JP,,0,0,0,,お茶は心の煩悩を消してくれます
Dialogue: 0,0:19:05.93,0:19:09.94,Dial_JP,,0,0,0,,東京にいたころは茶道教室をよく開いていたけれど
Dialogue: 0,0:19:10.15,0:19:12.65,Dial_JP,,0,0,0,,北海道に来てからは初めてね
Dialogue: 0,0:19:13.12,0:19:15.26,Dial_JP,,0,0,0,,腕前は落ちてないかしら
Dialogue: 0,0:19:15.90,0:19:17.81,Dial_JP,,0,0,0,,自転車のこぎ方と一緒です
Dialogue: 0,0:19:18.15,0:19:21.10,Dial_JP,,0,0,0,,体で覚えたことは　そう簡単に忘れません
Dialogue: 0,0:19:22.35,0:19:23.41,Dial_JP,,0,0,0,,結構
Dialogue: 0,0:19:24.28,0:19:25.28,Dial_JP,,0,0,0,,それでは
Dialogue: 0,0:19:27.46,0:19:28.36,Dial_JP,,0,0,0,,誰だろう
Dialogue: 0,0:19:28.65,0:19:30.04,Dial_JP,,0,0,0,,仕切り直しね
Dialogue: 0,0:19:30.24,0:19:32.18,Dial_JP,,0,0,0,,翼ちゃん　出てちょうだい
Dialogue: 0,0:19:34.51,0:19:36.32,Dial_JP,,0,0,0,,隣の夏川です
Dialogue: 0,0:19:36.32,0:19:37.58,Dial_JP,,0,0,0,,回覧板を届けに…
Dialogue: 0,0:19:37.58,0:19:38.52,Dial_JP,,0,0,0,,先輩
Dialogue: 0,0:19:39.57,0:19:40.86,Dial_JP,,0,0,0,,回覧板って
Dialogue: 0,0:19:41.28,0:19:43.05,Dial_JP,,0,0,0,,お隣さんだったんですね
Dialogue: 0,0:19:43.34,0:19:45.21,Dial_JP,,0,0,0,,改めて　よろしくお願いします
Dialogue: 0,0:19:46.91,0:19:49.19,Dial_JP,,0,0,0,,自己紹介が遅れましたが　四季と申し…
Dialogue: 0,0:19:49.19,0:19:50.18,Dial_JP,,0,0,0,,和服
Dialogue: 0,0:19:53.34,0:19:55.21,Dial_JP,,0,0,0,,けしからん
Dialogue: 0,0:20:05.28,0:20:08.02,Dial_JP,,0,0,0,,遅いわね　どうしたのかしら
Dialogue: 0,0:20:11.13,0:20:13.03,Dial_JP,,0,0,0,,翼ちゃん　どなた
Dialogue: 0,0:20:29.50,0:20:34.21,Dial_JP,,0,0,0,,ど…　ど…　どういう状況なんだ　これはぁ
Dialogue: 0,0:20:34.21,0:20:36.21,Dial_JP,,0,0,0,,翼　何をしているの
Dialogue: 0,0:20:37.12,0:20:37.91,Dial_JP,,0,0,0,,違うんだ
Dialogue: 0,0:20:37.91,0:20:39.09,Dial_JP,,0,0,0,,えっと　これは
Dialogue: 0,0:20:41.09,0:20:43.07,Dial_JP,,0,0,0,,大変失礼しました
Dialogue: 0,0:20:43.43,0:20:45.99,Dial_JP,,0,0,0,,私が足を滑らせてしまい
Dialogue: 0,0:20:45.99,0:20:48.60,Dial_JP,,0,0,0,,この方に支えてもらっていたのです
Dialogue: 0,0:20:49.19,0:20:51.03,Dial_JP,,0,0,0,,どうもありがとうございます
Dialogue: 0,0:20:56.10,0:20:57.74,Dial_JP,,0,0,0,,こちら　回覧板です
Dialogue: 0,0:20:58.96,0:20:59.49,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:21:00.18,0:21:00.88,Dial_JP,,0,0,0,,あれ
Dialogue: 0,0:21:01.08,0:21:03.87,Dial_JP,,0,0,0,,先輩　急に雰囲気が変わったぞ
Dialogue: 0,0:21:04.30,0:21:06.01,Dial_JP,,0,0,0,,さようでしたか
Dialogue: 0,0:21:06.01,0:21:08.61,Dial_JP,,0,0,0,,こちらこそ取り乱してごめんなさいね
Dialogue: 0,0:21:08.91,0:21:11.63,Dial_JP,,0,0,0,,回覧板　ありがとうございます
Dialogue: 0,0:21:11.63,0:21:13.87,Dial_JP,,0,0,0,,帰りは　気をつけてね
Dialogue: 0,0:21:14.34,0:21:16.20,Dial_JP,,0,0,0,,それでは失礼します
Dialogue: 0,0:21:21.10,0:21:24.28,Dial_JP,,0,0,0,,回覧板ということは　お隣の子
Dialogue: 0,0:21:25.96,0:21:26.93,Dial_JP,,0,0,0,,そうみたい
Dialogue: 0,0:21:27.11,0:21:29.17,Dial_JP,,0,0,0,,いつも旦那さんから受け取るから
Dialogue: 0,0:21:29.17,0:21:31.13,Dial_JP,,0,0,0,,初めてお会いしたけど
Dialogue: 0,0:21:31.69,0:21:33.72,Dial_JP,,0,0,0,,ずいぶんきれいな子ね
Dialogue: 0,0:21:35.13,0:21:37.87,Dial_JP,,0,0,0,,おばあちゃんがこんなこと言うの珍しい
Dialogue: 0,0:21:44.13,0:21:46.74,Dial_JP,,0,0,0,,さあ　翼ちゃん　戻りますよ
Dialogue: 0,0:21:49.88,0:21:50.74,Dial_JP,,0,0,0,,翼
Dialogue: 0,0:21:51.24,0:21:53.72,Dial_JP,,0,0,0,,はい　じゃあ　お茶の続きを
Dialogue: 0,0:21:53.72,0:21:55.39,Dial_JP,,0,0,0,,もう　お茶はいいです
Dialogue: 0,0:21:57.91,0:22:01.80,Dial_JP,,0,0,0,,よくわかりました　気の緩みの原因が
Dialogue: 0,0:22:02.61,0:22:06.83,Dial_JP,,0,0,0,,お茶で精神を整えても　また乱れたら意味はない
Dialogue: 0,0:22:07.08,0:22:11.37,Dial_JP,,0,0,0,,今のあなたに必要なのは　もっと具体的な危機感
Dialogue: 0,0:22:14.88,0:22:19.01,Dial_JP,,0,0,0,,次のテストで　学年10位以内に入りなさい
Dialogue: 0,0:22:19.01,0:22:23.82,Dial_JP,,0,0,0,,それができなければ　あなたを東京に帰します
Dialogue: 1,0:00:04.18,0:00:06.67,Dial_CH,,0,0,0,,下周就是期末考试周了
Dialogue: 1,0:00:06.67,0:00:08.91,Dial_CH,,0,0,0,,这周要开始抓紧复习了
Dialogue: 1,0:00:09.14,0:00:10.38,Dial_CH,,0,0,0,,唉
Dialogue: 1,0:00:10.38,0:00:13.37,Dial_CH,,0,0,0,,不许叹气 散会
Dialogue: 1,0:00:15.00,0:00:18.26,Dial_CH,,0,0,0,,总之所有科目的期末考试范围都复习过了
Dialogue: 1,0:00:18.26,0:00:20.73,Dial_CH,,0,0,0,,之后只要再复习一遍不擅长的地方
Dialogue: 1,0:00:22.50,0:00:26.42,Dial_CH,,0,0,0,,不是才刚考完期中考试吗 怎么就期末了
Dialogue: 1,0:00:26.71,0:00:28.66,Dial_CH,,0,0,0,,冬木同学讨厌考试吗
Dialogue: 1,0:00:28.66,0:00:30.51,Dial_CH,,0,0,0,,怎么可能喜欢啊
Dialogue: 1,0:00:31.27,0:00:34.18,Dial_CH,,0,0,0,,听你这问法 难道你喜欢考试吗
Dialogue: 1,0:00:35.12,0:00:36.87,Dial_CH,,0,0,0,,与其说是喜欢
Dialogue: 1,0:00:37.29,0:00:40.17,Dial_CH,,0,0,0,,倒不如说是看到自己的努力开花结果
Dialogue: 1,0:00:40.17,0:00:42.11,Dial_CH,,0,0,0,,会觉得值得吧
Dialogue: 1,0:00:43.60,0:00:45.86,Dial_CH,,0,0,0,,第一次听到有人这么说
Dialogue: 1,0:00:47.26,0:00:49.65,Dial_CH,,0,0,0,,抱歉 我太无趣了
Dialogue: 1,0:00:49.65,0:00:51.90,Dial_CH,,0,0,0,,不是不是 反了
Dialogue: 1,0:00:52.23,0:00:54.33,Dial_CH,,0,0,0,,不愧是翼 真了不起
Dialogue: 1,0:00:55.33,0:00:57.12,Dial_CH,,0,0,0,,也没有啦
Dialogue: 1,0:00:57.12,0:01:00.07,Dial_CH,,0,0,0,,好 感觉我也有干劲了
Dialogue: 1,0:01:00.07,0:01:02.13,Dial_CH,,0,0,0,,翼 之后有空吗
Dialogue: 1,0:01:03.67,0:01:05.46,Dial_CH,,0,0,0,,要不要来我家开学习会
Dialogue: 1,0:02:43.25,0:02:45.35,Dial_CH,,500,0,0,,所以为什么还要拉上我
Dialogue: 1,0:02:45.54,0:02:47.98,Dial_CH,,0,0,0,,人多才开心嘛
Dialogue: 1,0:02:48.94,0:02:51.11,Dial_CH,,0,0,0,,你没想着要学习吧
Dialogue: 1,0:02:51.11,0:02:53.18,Dial_CH,,0,0,0,,才不是呢
Dialogue: 1,0:02:53.18,0:02:56.73,Dial_CH,,0,0,0,,这次考试我也有危机感了
Dialogue: 1,0:02:56.99,0:02:59.67,Dial_CH,,0,0,0,,不过只要四季在的话就不用担心了
Dialogue: 1,0:02:59.67,0:03:01.25,Dial_CH,,0,0,0,,毕竟看上去就很聪明
Dialogue: 1,0:03:01.25,0:03:04.90,Dial_CH,,0,0,0,,翼是我们的专属家教
Dialogue: 1,0:03:05.67,0:03:07.29,Dial_CH,,0,0,0,,家教
Dialogue: 1,0:03:08.32,0:03:11.11,Dial_CH,,0,0,0,,教会别人对自己也有帮助
Dialogue: 1,0:03:11.41,0:03:12.45,Dial_CH,,0,0,0,,也行吧
Dialogue: 1,0:03:12.99,0:03:14.13,Dial_CH,,0,0,0,,我回来了
Dialogue: 1,0:03:14.13,0:03:15.00,Dial_CH,,0,0,0,,打扰了
Dialogue: 1,0:03:15.00,0:03:16.35,Dial_CH,,0,0,0,,打扰了
Dialogue: 1,0:03:16.35,0:03:17.68,Dial_CH,,0,0,0,,家里没人吗
Dialogue: 1,0:03:18.55,0:03:20.32,Dial_CH,,0,0,0,,妈妈和爸爸都在上班
Dialogue: 1,0:03:20.32,0:03:22.37,Dial_CH,,0,0,0,,妹妹去上舞蹈课了
Dialogue: 1,0:03:23.30,0:03:24.47,Dial_CH,,0,0,0,,你还有妹妹啊
Dialogue: 1,0:03:24.47,0:03:25.71,Dial_CH,,0,0,0,,有的哦
Dialogue: 1,0:03:25.71,0:03:27.81,Dial_CH,,0,0,0,,怎么看我都是姐姐吧
Dialogue: 1,0:03:28.02,0:03:30.32,Dial_CH,,0,0,0,,怎么看你都像个妹妹
Dialogue: 1,0:03:32.86,0:03:34.31,Dial_CH,,0,0,0,,我去拿点喝的
Dialogue: 1,0:03:34.31,0:03:36.61,Dial_CH,,0,0,0,,先去我房间等我吧
Dialogue: 1,0:03:36.61,0:03:37.83,Dial_CH,,0,0,0,,在2楼哦
Dialogue: 1,0:03:37.83,0:03:39.53,Dial_CH,,0,0,0,,行 是哪个房间
Dialogue: 1,0:03:39.53,0:03:41.35,Dial_CH,,0,0,0,,最里面的那间
Dialogue: 1,0:03:41.35,0:03:42.43,Dial_CH,,0,0,0,,OK
Dialogue: 1,0:03:44.77,0:03:46.99,Dial_CH,,0,0,0,,我第一次来冬木家
Dialogue: 1,0:03:46.99,0:03:48.99,Dial_CH,,0,0,0,,她要是不说 我真不知道是哪间
Dialogue: 1,0:03:49.79,0:03:52.88,Dial_CH,,0,0,0,,其实我之前来玩过一次
Dialogue: 1,0:03:54.18,0:03:57.92,Dial_CH,,0,0,0,,但是上次只是在客厅一起看了电影
Dialogue: 1,0:03:57.92,0:03:59.57,Dial_CH,,0,0,0,,没进过房间
Dialogue: 1,0:04:01.69,0:04:03.43,Dial_CH,,0,0,0,,看不出来啊 你
Dialogue: 1,0:04:03.93,0:04:05.31,Dial_CH,,0,0,0,,还挺闷骚的
Dialogue: 1,0:04:05.46,0:04:06.15,Dial_CH,,0,0,0,,闷…
Dialogue: 1,0:04:06.53,0:04:08.94,Dial_CH,,0,0,0,,我们什么都没发生啊
Dialogue: 1,0:04:09.17,0:04:11.97,Dial_CH,,0,0,0,,看到一半冬木同学还睡着了
Dialogue: 1,0:04:12.23,0:04:13.41,Dial_CH,,0,0,0,,好好好
Dialogue: 1,0:04:14.29,0:04:15.47,Dial_CH,,0,0,0,,这个房间吗
Dialogue: 1,0:04:23.97,0:04:25.50,Dial_CH,,0,0,0,,一看就知道是她的房间
Dialogue: 1,0:04:25.72,0:04:26.75,Dial_CH,,0,0,0,,确实
Dialogue: 1,0:04:36.68,0:04:39.31,Dial_CH,,0,0,0,,第一次进女生的房间
Dialogue: 1,0:04:39.57,0:04:41.75,Dial_CH,,0,0,0,,有股特别好闻的香气
Dialogue: 1,0:04:43.57,0:04:47.24,Dial_CH,,0,0,0,,冬木同学每天都在这里生活啊
Dialogue: 1,0:04:47.73,0:04:49.52,Dial_CH,,0,0,0,,在这里玩 在这里睡觉
Dialogue: 1,0:04:55.28,0:04:56.43,Dial_CH,,0,0,0,,还换衣服
Dialogue: 1,0:04:57.40,0:05:00.04,Dial_CH,,0,0,0,,我都在想些什么啊
Dialogue: 1,0:05:03.68,0:05:05.12,Dial_CH,,0,0,0,,明骚
Dialogue: 1,0:05:06.09,0:05:07.66,Dial_CH,,0,0,0,,久等了
Dialogue: 1,0:05:07.66,0:05:09.70,Dial_CH,,0,0,0,,我把饮料拿来了
Dialogue: 1,0:05:15.26,0:05:17.21,Dial_CH,,0,0,0,,不错 我喜欢这个
Dialogue: 1,0:05:17.21,0:05:19.76,Dial_CH,,0,0,0,,我也喜欢 好喝
Dialogue: 1,0:05:20.04,0:05:21.79,Dial_CH,,0,0,0,,「Ribbon NAPOLIN」？
Dialogue: 1,0:05:25.71,0:05:27.19,Dial_CH,,0,0,0,,第一次喝？
Dialogue: 1,0:05:27.19,0:05:28.92,Dial_CH,,0,0,0,,尝尝 说说感想
Dialogue: 1,0:05:29.18,0:05:30.14,Dial_CH,,0,0,0,,谢谢
Dialogue: 1,0:05:30.88,0:05:31.48,Dial_CH,,0,0,0,,谢啦
Dialogue: 1,0:05:39.43,0:05:40.70,Dial_CH,,0,0,0,,这个好好喝
Dialogue: 1,0:05:40.70,0:05:41.84,Dial_CH,,0,0,0,,是吧
Dialogue: 1,0:05:41.84,0:05:45.62,Dial_CH,,0,0,0,,这是很久之前就有的北海道灵魂饮料哦
Dialogue: 1,0:05:47.66,0:05:49.67,Dial_CH,,0,0,0,,这碳酸太爽了
Dialogue: 1,0:05:49.67,0:05:51.08,Dial_CH,,0,0,0,,整个人都清醒了
Dialogue: 1,0:05:51.08,0:05:52.32,Dial_CH,,0,0,0,,我理解了
Dialogue: 1,0:05:52.58,0:05:55.21,Dial_CH,,0,0,0,,这简直是专门为学习会准备的饮料
Dialogue: 1,0:05:56.26,0:05:57.10,Dial_CH,,0,0,0,,确实
Dialogue: 1,0:05:57.10,0:05:59.96,Dial_CH,,0,0,0,,对了 我们互相出题吧
Dialogue: 1,0:05:59.96,0:06:02.34,Dial_CH,,0,0,0,,我都行 要搞哪科呢
Dialogue: 1,0:06:02.64,0:06:06.76,Dial_CH,,0,0,0,,可以从考试第一天的学科开始 世界史如何
Dialogue: 1,0:06:06.76,0:06:08.12,Dial_CH,,0,0,0,,OK
Dialogue: 1,0:06:08.12,0:06:09.89,Dial_CH,,0,0,0,,那就从翼开始提问吧
Dialogue: 1,0:06:11.70,0:06:15.04,Dial_CH,,0,0,0,,那我先问个简单的
Dialogue: 1,0:06:15.56,0:06:17.90,Dial_CH,,0,0,0,,神的旨意是绝对的
Dialogue: 1,0:06:17.90,0:06:20.37,Dial_CH,,0,0,0,,一个人能否得到救赎
Dialogue: 1,0:06:20.37,0:06:23.30,Dial_CH,,0,0,0,,最终都由神来决定
Dialogue: 1,0:06:23.30,0:06:26.83,Dial_CH,,0,0,0,,这种由加尔文提出的基督教神学思想
Dialogue: 1,0:06:26.83,0:06:28.04,Dial_CH,,0,0,0,,被称作什么
Dialogue: 1,0:06:29.41,0:06:30.94,Dial_CH,,0,0,0,,叫什么来着
Dialogue: 1,0:06:30.94,0:06:32.65,Dial_CH,,0,0,0,,提示 如果满了就会很惨
Dialogue: 1,0:06:34.32,0:06:35.00,Dial_CH,,0,0,0,,日程
Dialogue: 1,0:06:35.00,0:06:35.92,Dial_CH,,0,0,0,,是宿命论
Dialogue: 1,0:06:35.92,0:06:37.26,Dial_CH,,0,0,0,,秋野同学答对了
Dialogue: 1,0:06:38.94,0:06:42.03,Dial_CH,,0,0,0,,对对对 日程满了确实难受
Dialogue: 1,0:06:42.03,0:06:43.30,Dial_CH,,0,0,0,,下一个轮到沙友友问了
Dialogue: 1,0:06:43.87,0:06:46.26,Dial_CH,,0,0,0,,嗯… 那就这个吧
Dialogue: 1,0:06:46.91,0:06:52.50,Dial_CH,,0,0,0,,1559年 英国都铎王朝的女皇伊丽莎白一世颁布的
Dialogue: 1,0:06:52.50,0:06:57.46,Dial_CH,,0,0,0,,规定了英格兰教会的通用礼拜 祈祷等仪式的法律叫什么
Dialogue: 1,0:06:58.41,0:07:00.00,Dial_CH,,0,0,0,,《统一法案》吧
Dialogue: 1,0:07:00.76,0:07:03.03,Dial_CH,,0,0,0,,果然四季一下就说出来了
Dialogue: 1,0:07:03.32,0:07:05.72,Dial_CH,,0,0,0,,该冬木出题了
Dialogue: 1,0:07:06.99,0:07:08.80,Dial_CH,,0,0,0,,这个 那个
Dialogue: 1,0:07:12.42,0:07:17.63,Dial_CH,,0,0,0,,据说 曾经北见的薄荷生产量占全球的70%呢
Dialogue: 1,0:07:17.63,0:07:18.99,Dial_CH,,0,0,0,,你在说啥
Dialogue: 1,0:07:19.34,0:07:21.56,Dial_CH,,0,0,0,,不过这确实挺厉害的
Dialogue: 1,0:07:21.56,0:07:25.26,Dial_CH,,0,0,0,,怪不得去奶奶家一定能见到薄荷糖
Dialogue: 1,0:07:25.26,0:07:28.06,Dial_CH,,0,0,0,,这是之前我爸爸告诉我的
Dialogue: 1,0:07:28.06,0:07:30.14,Dial_CH,,0,0,0,,不得了吧 是不是很牛
Dialogue: 1,0:07:30.45,0:07:33.46,Dial_CH,,0,0,0,,确实很牛 但是和考试范围根本不搭边啊
Dialogue: 1,0:07:33.76,0:07:35.52,Dial_CH,,0,0,0,,而且你也没提问
Dialogue: 1,0:07:36.84,0:07:39.61,Dial_CH,,0,0,0,,我只是想展现一下我的知识量
Dialogue: 1,0:07:39.87,0:07:41.83,Dial_CH,,0,0,0,,一起加油吧 冬木同学
Dialogue: 1,0:07:42.19,0:07:44.88,Dial_CH,,0,0,0,,现在开始也来得及 努力就能有回报
Dialogue: 1,0:07:45.23,0:07:46.84,Dial_CH,,0,0,0,,翼
Dialogue: 1,0:07:46.84,0:07:49.40,Dial_CH,,0,0,0,,好 那我可要铆足劲儿学了
Dialogue: 1,0:07:49.40,0:07:51.87,Dial_CH,,0,0,0,,四季太惯着冬木了
Dialogue: 1,0:07:52.12,0:07:54.46,Dial_CH,,0,0,0,,你最好别忘了你还得教我
Dialogue: 1,0:07:54.46,0:07:55.40,Dial_CH,,0,0,0,,没问题
Dialogue: 1,0:07:55.63,0:07:58.62,Dial_CH,,0,0,0,,那先说说这道题
Dialogue: 1,0:08:13.27,0:08:16.02,Dial_CH,,0,0,0,,就做炸鸡块当零食吧
Dialogue: 1,0:08:21.80,0:08:24.55,Dial_CH,,0,0,0,,一千年没这么认真学习过了
Dialogue: 1,0:08:24.55,0:08:26.28,Dial_CH,,0,0,0,,脑子坏掉了
Dialogue: 1,0:08:26.48,0:08:27.56,Dial_CH,,0,0,0,,好累
Dialogue: 1,0:08:27.56,0:08:30.45,Dial_CH,,0,0,0,,你俩很厉害了 辛苦了
Dialogue: 1,0:08:31.01,0:08:32.70,Dial_CH,,0,0,0,,话说现在几点了
Dialogue: 1,0:08:33.65,0:08:35.70,Dial_CH,,0,0,0,,完了 过门禁了
Dialogue: 1,0:08:36.14,0:08:38.71,Dial_CH,,0,0,0,,学习太认真忘了看表了
Dialogue: 1,0:08:38.71,0:08:40.87,Dial_CH,,0,0,0,,抱歉 我得回家了
Dialogue: 1,0:08:42.01,0:08:43.13,Dial_CH,,0,0,0,,别急啊 翼
Dialogue: 1,0:08:43.13,0:08:44.25,Dial_CH,,0,0,0,,喂 四季
Dialogue: 1,0:08:44.25,0:08:45.57,Dial_CH,,0,0,0,,二位再见
Dialogue: 1,0:08:50.56,0:08:51.91,Dial_CH,,0,0,0,,打扰了
Dialogue: 1,0:08:52.44,0:08:53.97,Dial_CH,,0,0,0,,我回来咯
Dialogue: 1,0:09:03.81,0:09:05.25,Dial_CH,,0,0,0,,翼
Dialogue: 1,0:09:09.41,0:09:12.91,Dial_CH,,0,0,0,,这样啊 在我家学习呢
Dialogue: 1,0:09:13.07,0:09:13.83,Dial_CH,,0,0,0,,是的
Dialogue: 1,0:09:14.04,0:09:16.66,Dial_CH,,0,0,0,,还麻烦您送我 太不好意思了
Dialogue: 1,0:09:17.24,0:09:20.10,Dial_CH,,0,0,0,,脸上还残留着触感和香甜
Dialogue: 1,0:09:20.54,0:09:22.21,Dial_CH,,0,0,0,,没事儿 没事儿
Dialogue: 1,0:09:22.21,0:09:24.64,Dial_CH,,0,0,0,,反正正好赶上我回家
Dialogue: 1,0:09:24.64,0:09:28.19,Dial_CH,,0,0,0,,咱两家也近 顺道送一下的事儿 不麻烦
Dialogue: 1,0:09:28.19,0:09:29.58,Dial_CH,,0,0,0,,谢谢
Dialogue: 1,0:09:30.02,0:09:32.50,Dial_CH,,0,0,0,,我听小美讲
Dialogue: 1,0:09:33.60,0:09:35.74,Dial_CH,,0,0,0,,你钢琴弹得不错啊
Dialogue: 1,0:09:36.77,0:09:39.77,Dial_CH,,0,0,0,,我从小就一直学了
Dialogue: 1,0:09:40.42,0:09:42.05,Dial_CH,,0,0,0,,这样啊
Dialogue: 1,0:09:43.84,0:09:46.97,Dial_CH,,0,0,0,,我估计你也听说了
Dialogue: 1,0:09:47.36,0:09:51.19,Dial_CH,,0,0,0,,情人节那天 那孩子因为一些事 特别不开心
Dialogue: 1,0:09:51.64,0:09:55.68,Dial_CH,,0,0,0,,我还担心她回来得是一副啥样的表情呢
Dialogue: 1,0:09:56.68,0:09:58.63,Dial_CH,,0,0,0,,结果她回家时都乐开花了
Dialogue: 1,0:09:58.63,0:10:02.00,Dial_CH,,0,0,0,,一开口就说「翼钢琴弹得可好了」
Dialogue: 1,0:10:02.00,0:10:04.13,Dial_CH,,0,0,0,,可笑死我了
Dialogue: 1,0:10:05.08,0:10:07.23,Dial_CH,,0,0,0,,感觉好难为情
Dialogue: 1,0:10:07.51,0:10:08.77,Dial_CH,,0,0,0,,脸都烫了
Dialogue: 1,0:10:09.43,0:10:11.67,Dial_CH,,0,0,0,,我看到她那样就放心了
Dialogue: 1,0:10:13.31,0:10:15.21,Dial_CH,,0,0,0,,谢谢你 翼
Dialogue: 1,0:10:18.40,0:10:19.59,Dial_CH,,0,0,0,,应该的
Dialogue: 1,0:10:30.01,0:10:32.73,Dial_CH,,0,0,0,,你家还真是像城堡一样啊
Dialogue: 1,0:10:32.73,0:10:33.78,Dial_CH,,0,0,0,,不至于不至于
Dialogue: 1,0:10:34.26,0:10:36.52,Dial_CH,,0,0,0,,谢谢您送我到家
Dialogue: 1,0:10:37.01,0:10:37.83,Dial_CH,,0,0,0,,别急
Dialogue: 1,0:10:38.20,0:10:40.57,Dial_CH,,0,0,0,,这个 我本来买来给自己的
Dialogue: 1,0:10:40.79,0:10:42.18,Dial_CH,,0,0,0,,送你吧
Dialogue: 1,0:10:42.18,0:10:43.16,Dial_CH,,0,0,0,,好凉
Dialogue: 1,0:10:43.16,0:10:46.96,Dial_CH,,0,0,0,,就当是妈妈奖励你平日的努力
Dialogue: 1,0:10:50.59,0:10:52.21,Dial_CH,,0,0,0,,喝了这个 继续加油吧
Dialogue: 1,0:10:52.43,0:10:53.83,Dial_CH,,0,0,0,,拜拜
Dialogue: 1,0:10:56.30,0:10:57.42,Dial_CH,,0,0,0,,我会加油的
Dialogue: 1,0:10:57.76,0:10:58.86,Dial_CH,,0,0,0,,小翼
Dialogue: 1,0:11:04.10,0:11:06.48,Dial_CH,,0,0,0,,你看看这都几点了
Dialogue: 1,0:11:14.27,0:11:15.24,Dial_CH,,0,0,0,,小翼啊
Dialogue: 1,0:11:16.07,0:11:16.74,Dial_CH,,0,0,0,,我在
Dialogue: 1,0:11:17.59,0:11:21.44,Dial_CH,,0,0,0,,出门上学顺便把可燃垃圾扔了吧
Dialogue: 1,0:11:21.44,0:11:23.55,Dial_CH,,0,0,0,,好的 奶奶
Dialogue: 1,0:11:27.39,0:11:28.58,Dial_CH,,0,0,0,,我出发了
Dialogue: 1,0:11:33.46,0:11:36.44,Dial_CH,,0,0,0,,昨天被奶奶狠狠训了一顿
Dialogue: 1,0:11:36.70,0:11:38.95,Dial_CH,,0,0,0,,到了今天还是有点紧张啊
Dialogue: 1,0:11:40.32,0:11:44.46,Dial_CH,,0,0,0,,你要住在这个家 就得守我的规矩
Dialogue: 1,0:11:44.46,0:11:48.31,Dial_CH,,0,0,0,,这个条件我已经再三强调过了吧
Dialogue: 1,0:11:49.10,0:11:51.33,Dial_CH,,0,0,0,,是的 您说得对
Dialogue: 1,0:11:54.21,0:11:57.27,Dial_CH,,0,0,0,,这次我就先不计较
Dialogue: 1,0:11:57.27,0:12:00.99,Dial_CH,,0,0,0,,但如果以后再有草率之举
Dialogue: 1,0:12:02.67,0:12:04.44,Dial_CH,,0,0,0,,后果你非常清楚
Dialogue: 1,0:12:04.93,0:12:07.94,Dial_CH,,0,0,0,,真的非常对不起
Dialogue: 1,0:12:27.55,0:12:29.09,Dial_CH,,0,0,0,,是外国人吗
Dialogue: 1,0:12:30.36,0:12:32.39,Dial_CH,,0,0,0,,真漂亮啊
Dialogue: 1,0:12:33.11,0:12:35.97,Dial_CH,,0,0,0,,凌若冰霜 娇柔似雪
Dialogue: 1,0:12:36.69,0:12:38.89,Dial_CH,,0,0,0,,她站在垃圾场前干嘛呢
Dialogue: 1,0:12:40.21,0:12:42.69,Dial_CH,,0,0,0,,手上也没有垃圾
Dialogue: 1,0:12:53.96,0:12:56.10,Dial_CH,,0,0,0,,也没传言说得那么厉害
Dialogue: 1,0:13:05.93,0:13:08.65,Dial_CH,,0,0,0,,小坏蛋都被我赶走了
Dialogue: 1,0:13:08.65,0:13:11.35,Dial_CH,,0,0,0,,请放心丢垃圾吧
Dialogue: 1,0:13:12.38,0:13:13.19,Dial_CH,,0,0,0,,好
Dialogue: 1,0:13:13.19,0:13:15.82,Dial_CH,,0,0,0,,那我就先溜了
Dialogue: 1,0:13:17.53,0:13:19.08,Dial_CH,,0,0,0,,溜… 溜？
Dialogue: 1,0:13:24.71,0:13:26.70,Dial_CH,,0,0,0,,那不是怜奈学姐吗
Dialogue: 1,0:13:26.70,0:13:27.90,Dial_CH,,0,0,0,,怜奈学姐
Dialogue: 1,0:13:27.90,0:13:31.47,Dial_CH,,0,0,0,,粉白短裙配上和风头箍
Dialogue: 1,0:13:31.47,0:13:33.44,Dial_CH,,0,0,0,,肯定是怜奈学姐
Dialogue: 1,0:13:33.92,0:13:37.09,Dial_CH,,0,0,0,,好羡慕你一早上就能见到怜奈学姐
Dialogue: 1,0:13:37.34,0:13:38.88,Dial_CH,,0,0,0,,你认识她啊 冬木同学
Dialogue: 1,0:13:38.88,0:13:41.88,Dial_CH,,0,0,0,,何止认识 我可崇拜她了
Dialogue: 1,0:13:42.55,0:13:45.42,Dial_CH,,0,0,0,,她蝉联了两届咱学校的选美冠军
Dialogue: 1,0:13:45.42,0:13:48.59,Dial_CH,,0,0,0,,我记得她父母还是亲戚是外国人来着
Dialogue: 1,0:13:48.59,0:13:51.35,Dial_CH,,0,0,0,,在这一带是有名的超级大美女
Dialogue: 1,0:14:02.44,0:14:04.34,Dial_CH,,0,0,0,,真好啊
Dialogue: 1,0:14:04.34,0:14:07.87,Dial_CH,,0,0,0,,我也想转生成她这样的辣妹
Dialogue: 1,0:14:10.16,0:14:13.57,Dial_CH,,0,0,0,,确实有种超脱日本人的美
Dialogue: 1,0:14:14.60,0:14:15.73,Dial_CH,,0,0,0,,话说 翼
Dialogue: 1,0:14:16.62,0:14:20.51,Dial_CH,,0,0,0,,今天也来咱家开学习会吧 叫上沙友友
Dialogue: 1,0:14:21.25,0:14:22.17,Dial_CH,,0,0,0,,抱歉
Dialogue: 1,0:14:22.17,0:14:26.05,Dial_CH,,0,0,0,,我考试前都打算自己学习
Dialogue: 1,0:14:27.61,0:14:28.34,Dial_CH,,0,0,0,,当然
Dialogue: 1,0:14:28.34,0:14:30.93,Dial_CH,,0,0,0,,不是说不想跟你们一起学
Dialogue: 1,0:14:30.93,0:14:33.60,Dial_CH,,0,0,0,,只是我想一个人集中精神
Dialogue: 1,0:14:34.12,0:14:36.84,Dial_CH,,0,0,0,,好吧 哭哭
Dialogue: 1,0:14:37.09,0:14:38.82,Dial_CH,,0,0,0,,但也没办法
Dialogue: 1,0:14:40.09,0:14:42.87,Dial_CH,,0,0,0,,奶奶对我发火的事先瞒着她吧
Dialogue: 1,0:14:43.32,0:14:45.82,Dial_CH,,0,0,0,,我也不想让她们担心
Dialogue: 1,0:14:46.00,0:14:49.59,Dial_CH,,0,0,0,,那我就跟沙友友两个人一起学
Dialogue: 1,0:14:49.87,0:14:51.54,Dial_CH,,0,0,0,,我也拒绝
Dialogue: 1,0:14:51.78,0:14:52.92,Dial_CH,,0,0,0,,沙友友
Dialogue: 1,0:14:53.25,0:14:55.00,Dial_CH,,0,0,0,,你竟然拒绝我
Dialogue: 1,0:14:55.00,0:14:56.30,Dial_CH,,0,0,0,,反正
Dialogue: 1,0:14:56.30,0:14:59.29,Dial_CH,,0,0,0,,又是像昨天一样 四季回去后就只顾着唠嗑呗
Dialogue: 1,0:15:00.40,0:15:01.45,Dial_CH,,0,0,0,,确实
Dialogue: 1,0:15:01.80,0:15:05.06,Dial_CH,,0,0,0,,原来我走后她们就没学习了
Dialogue: 1,0:15:11.53,0:15:14.00,Dial_CH,,0,0,0,,沙友友 一起吃吧
Dialogue: 1,0:15:14.00,0:15:16.79,Dial_CH,,0,0,0,,没门 我在查游戏攻略
Dialogue: 1,0:15:18.51,0:15:21.03,Dial_CH,,0,0,0,,反正我不打扰你
Dialogue: 1,0:15:21.03,0:15:22.94,Dial_CH,,0,0,0,,你是有多怕寂寞啊
Dialogue: 1,0:15:23.10,0:15:26.15,Dial_CH,,0,0,0,,午饭就不是一个人吃的呀
Dialogue: 1,0:15:26.15,0:15:28.12,Dial_CH,,0,0,0,,而且我回过神翼就不见了
Dialogue: 1,0:15:29.50,0:15:30.53,Dial_CH,,0,0,0,,还真是
Dialogue: 1,0:15:31.26,0:15:32.83,Dial_CH,,0,0,0,,他去哪了
Dialogue: 1,0:15:33.03,0:15:35.10,Dial_CH,,0,0,0,,是啊 区区一只翼
Dialogue: 1,0:15:35.90,0:15:38.94,Dial_CH,,0,0,0,,难道他不来学习会 你记仇了？
Dialogue: 1,0:15:38.94,0:15:40.87,Dial_CH,,0,0,0,,才… 才没有
Dialogue: 1,0:15:40.87,0:15:44.09,Dial_CH,,0,0,0,,我才没有这么斤斤计较
Dialogue: 1,0:15:44.32,0:15:46.82,Dial_CH,,0,0,0,,他也有很多要忙的吧
Dialogue: 1,0:15:46.82,0:15:48.34,Dial_CH,,0,0,0,,别太在意
Dialogue: 1,0:15:51.31,0:15:54.08,Dial_CH,,0,0,0,,沙友友好像老奶奶
Dialogue: 1,0:15:54.08,0:15:56.47,Dial_CH,,0,0,0,,你这根本不算是夸奖
Dialogue: 1,0:16:02.66,0:16:05.63,Dial_CH,,0,0,0,,想着换个环境 头一次来图书室
Dialogue: 1,0:16:05.63,0:16:07.99,Dial_CH,,0,0,0,,能集中精力 进度不错
Dialogue: 1,0:16:10.02,0:16:10.91,Dial_CH,,0,0,0,,打呼声？
Dialogue: 1,0:16:17.09,0:16:18.42,Dial_CH,,0,0,0,,怜奈学姐
Dialogue: 1,0:16:19.27,0:16:21.51,Dial_CH,,0,0,0,,为什么在这里睡大觉
Dialogue: 1,0:16:21.51,0:16:24.48,Dial_CH,,0,0,0,,这睡脸也太好看了
Dialogue: 1,0:16:24.48,0:16:27.15,Dial_CH,,0,0,0,,到底做什么梦才能这么美
Dialogue: 1,0:16:28.90,0:16:31.14,Dial_CH,,0,0,0,,光是看着就很治愈
Dialogue: 1,0:16:31.53,0:16:34.59,Dial_CH,,0,0,0,,复习带来的疲劳都一消而散了
Dialogue: 1,0:16:37.96,0:16:38.89,Dial_CH,,0,0,0,,醒了
Dialogue: 1,0:16:41.02,0:16:42.94,Dial_CH,,0,0,0,,关原之战…
Dialogue: 1,0:16:42.94,0:16:44.52,Dial_CH,,0,0,0,,梦到战争了？
Dialogue: 1,0:16:44.52,0:16:46.94,Dial_CH,,0,0,0,,做着厮杀的梦 表情还能如此甜美
Dialogue: 1,0:16:50.44,0:16:51.92,Dial_CH,,0,0,0,,不小心对上眼了
Dialogue: 1,0:16:52.23,0:16:54.21,Dial_CH,,0,0,0,,她不会发现我盯着她看了吧
Dialogue: 1,0:16:54.62,0:16:55.75,Dial_CH,,0,0,0,,等一下等一下
Dialogue: 1,0:16:55.75,0:16:57.65,Dial_CH,,0,0,0,,我得赶紧集中起来
Dialogue: 1,0:16:57.65,0:16:59.75,Dial_CH,,0,0,0,,有好一会儿没动过笔了
Dialogue: 1,0:17:00.03,0:17:02.21,Dial_CH,,0,0,0,,好 继续努力学习
Dialogue: 1,0:17:07.28,0:17:08.71,Dial_CH,,0,0,0,,怎… 怎么了
Dialogue: 1,0:17:09.85,0:17:11.69,Dial_CH,,0,0,0,,我是图书委员
Dialogue: 1,0:17:12.66,0:17:15.87,Dial_CH,,0,0,0,,因此现在图书馆的权限在我手中
Dialogue: 1,0:17:17.75,0:17:21.65,Dial_CH,,0,0,0,,就是说只要我允许 在这里睡觉也没问题
Dialogue: 1,0:17:22.22,0:17:24.04,Dial_CH,,0,0,0,,她很在意自己睡过去了
Dialogue: 1,0:17:24.04,0:17:26.92,Dial_CH,,0,0,0,,没事 我不介意你睡觉的
Dialogue: 1,0:17:26.92,0:17:27.99,Dial_CH,,0,0,0,,你
Dialogue: 1,0:17:28.40,0:17:30.63,Dial_CH,,0,0,0,,坐姿很端正
Dialogue: 1,0:17:30.86,0:17:32.47,Dial_CH,,0,0,0,,练过什么吗
Dialogue: 1,0:17:33.61,0:17:35.24,Dial_CH,,0,0,0,,不是 那个
Dialogue: 1,0:17:36.37,0:17:39.06,Dial_CH,,0,0,0,,对不起 打扰你学习了
Dialogue: 1,0:17:39.06,0:17:40.68,Dial_CH,,0,0,0,,不 没事
Dialogue: 1,0:17:40.68,0:17:41.33,Dial_CH,,0,0,0,,呀
Dialogue: 1,0:17:42.36,0:17:45.79,Dial_CH,,0,0,0,,这道题你虽然打了圈 但其实错了
Dialogue: 1,0:17:49.94,0:17:51.09,Dial_CH,,0,0,0,,真是错的
Dialogue: 1,0:17:51.32,0:17:55.80,Dial_CH,,0,0,0,,看这题目 你是一年级的吧
Dialogue: 1,0:17:55.80,0:17:57.87,Dial_CH,,0,0,0,,加油 好好学哦
Dialogue: 1,0:17:58.19,0:18:00.23,Dial_CH,,0,0,0,,好的 谢谢指导
Dialogue: 1,0:18:02.84,0:18:07.23,Dial_CH,,0,0,0,,她是看了一眼就在脑内解完题了吗
Dialogue: 1,0:18:09.95,0:18:12.28,Dial_CH,,0,0,0,,这还是不太可能吧
Dialogue: 1,0:18:12.77,0:18:15.79,Dial_CH,,0,0,0,,想必是之前做过这本练习册
Dialogue: 1,0:18:20.35,0:18:21.32,Dial_CH,,0,0,0,,我回来了
Dialogue: 1,0:18:23.76,0:18:24.58,Dial_CH,,0,0,0,,奶奶
Dialogue: 1,0:18:26.13,0:18:27.84,Dial_CH,,0,0,0,,回来了啊
Dialogue: 1,0:18:28.06,0:18:30.53,Dial_CH,,0,0,0,,您这… 这是做什么
Dialogue: 1,0:18:30.53,0:18:33.65,Dial_CH,,0,0,0,,我今天一直在思考
Dialogue: 1,0:18:33.65,0:18:37.16,Dial_CH,,0,0,0,,我究竟能为你做些什么
Dialogue: 1,0:18:38.64,0:18:42.10,Dial_CH,,0,0,0,,我也知道你正值青春期
Dialogue: 1,0:18:42.10,0:18:45.05,Dial_CH,,0,0,0,,有很多事是我所不能理解的
Dialogue: 1,0:18:45.48,0:18:46.61,Dial_CH,,0,0,0,,奶奶
Dialogue: 1,0:18:46.99,0:18:52.60,Dial_CH,,0,0,0,,不过自从你来到北海道 就很放纵自己
Dialogue: 1,0:18:52.94,0:18:57.96,Dial_CH,,0,0,0,,如今的你 需要调整自己状态的时间
Dialogue: 1,0:18:58.42,0:18:59.24,Dial_CH,,0,0,0,,也就是
Dialogue: 1,0:19:00.88,0:19:02.14,Dial_CH,,0,0,0,,沏茶
Dialogue: 1,0:19:02.70,0:19:05.49,Dial_CH,,0,0,0,,沏茶可以消除内心的烦恼
Dialogue: 1,0:19:05.93,0:19:09.94,Dial_CH,,0,0,0,,在东京的时候我倒是经常带着你沏茶
Dialogue: 1,0:19:10.15,0:19:12.65,Dial_CH,,0,0,0,,但是来这边后还是第一次呢
Dialogue: 1,0:19:13.12,0:19:15.26,Dial_CH,,0,0,0,,也不知你是否生疏了
Dialogue: 1,0:19:15.90,0:19:17.81,Dial_CH,,0,0,0,,这就和骑自行车一样
Dialogue: 1,0:19:18.15,0:19:21.10,Dial_CH,,0,0,0,,肌肉记忆不会背叛我
Dialogue: 1,0:19:22.35,0:19:23.41,Dial_CH,,0,0,0,,很好
Dialogue: 1,0:19:24.28,0:19:25.28,Dial_CH,,0,0,0,,那么
Dialogue: 1,0:19:27.46,0:19:28.36,Dial_CH,,0,0,0,,会是谁呢
Dialogue: 1,0:19:28.65,0:19:30.04,Dial_CH,,0,0,0,,等下再继续吧
Dialogue: 1,0:19:30.24,0:19:32.18,Dial_CH,,0,0,0,,小翼 你去开个门
Dialogue: 1,0:19:34.51,0:19:36.32,Dial_CH,,0,0,0,,我是住在隔壁的夏川
Dialogue: 1,0:19:36.32,0:19:37.58,Dial_CH,,0,0,0,,是来把传阅板报…
Dialogue: 1,0:19:37.58,0:19:38.52,Dial_CH,,0,0,0,,学姐
Dialogue: 1,0:19:39.57,0:19:40.86,Dial_CH,,0,0,0,,传阅板报
Dialogue: 1,0:19:41.28,0:19:43.05,Dial_CH,,0,0,0,,原来学姐是我邻居啊
Dialogue: 1,0:19:43.34,0:19:45.21,Dial_CH,,0,0,0,,再次向你问好
Dialogue: 1,0:19:46.91,0:19:49.19,Dial_CH,,0,0,0,,一直没向你介绍我自己 我叫四季…
Dialogue: 1,0:19:49.19,0:19:50.18,Dial_CH,,0,0,0,,和服
Dialogue: 1,0:19:53.34,0:19:55.21,Dial_CH,,0,0,0,,太不要脸了
Dialogue: 1,0:20:05.28,0:20:08.02,Dial_CH,,0,0,0,,真慢啊 发生什么了呢
Dialogue: 1,0:20:11.13,0:20:13.03,Dial_CH,,0,0,0,,小翼 是谁来了
Dialogue: 1,0:20:29.50,0:20:34.21,Dial_CH,,0,0,0,,这… 这… 这究竟是个什么情况
Dialogue: 1,0:20:34.21,0:20:36.21,Dial_CH,,0,0,0,,翼 你在做什么啊
Dialogue: 1,0:20:37.12,0:20:37.91,Dial_CH,,0,0,0,,奶奶听我解释
Dialogue: 1,0:20:37.91,0:20:39.09,Dial_CH,,0,0,0,,呃 这是
Dialogue: 1,0:20:41.09,0:20:43.07,Dial_CH,,0,0,0,,是我有失礼节了
Dialogue: 1,0:20:43.43,0:20:45.99,Dial_CH,,0,0,0,,我脚下不小心打滑
Dialogue: 1,0:20:45.99,0:20:48.60,Dial_CH,,0,0,0,,而他用身体扶住了我
Dialogue: 1,0:20:49.19,0:20:51.03,Dial_CH,,0,0,0,,非常感谢
Dialogue: 1,0:20:56.10,0:20:57.74,Dial_CH,,0,0,0,,这是给您的传阅板报
Dialogue: 1,0:20:58.96,0:20:59.49,Dial_CH,,0,0,0,,好
Dialogue: 1,0:21:00.18,0:21:00.88,Dial_CH,,0,0,0,,怎么
Dialogue: 1,0:21:01.08,0:21:03.87,Dial_CH,,0,0,0,,学姐突然就变样了
Dialogue: 1,0:21:04.30,0:21:06.01,Dial_CH,,0,0,0,,这样啊
Dialogue: 1,0:21:06.01,0:21:08.61,Dial_CH,,0,0,0,,实在不好意思 我一时间慌乱了
Dialogue: 1,0:21:08.91,0:21:11.63,Dial_CH,,0,0,0,,谢谢你把传阅板报送过来
Dialogue: 1,0:21:11.63,0:21:13.87,Dial_CH,,0,0,0,,回去路上小心
Dialogue: 1,0:21:14.34,0:21:16.20,Dial_CH,,0,0,0,,好的 我走了
Dialogue: 1,0:21:21.10,0:21:24.28,Dial_CH,,0,0,0,,传阅板报 也就是说是邻居家的孩子啊
Dialogue: 1,0:21:25.96,0:21:26.93,Dial_CH,,0,0,0,,好像是的
Dialogue: 1,0:21:27.11,0:21:29.17,Dial_CH,,0,0,0,,一直都是她父亲送过来的
Dialogue: 1,0:21:29.17,0:21:31.13,Dial_CH,,0,0,0,,还是第一次见到她呢
Dialogue: 1,0:21:31.69,0:21:33.72,Dial_CH,,0,0,0,,长得真漂亮
Dialogue: 1,0:21:35.13,0:21:37.87,Dial_CH,,0,0,0,,很少听到奶奶夸别人漂亮
Dialogue: 1,0:21:44.13,0:21:46.74,Dial_CH,,0,0,0,,好了 小翼 进屋吧
Dialogue: 1,0:21:49.88,0:21:50.74,Dial_CH,,0,0,0,,翼
Dialogue: 1,0:21:51.24,0:21:53.72,Dial_CH,,0,0,0,,好 来了 继续沏茶是吧
Dialogue: 1,0:21:53.72,0:21:55.39,Dial_CH,,0,0,0,,不沏了
Dialogue: 1,0:21:57.91,0:22:01.80,Dial_CH,,0,0,0,,我终于明白你为什么会如此松懈了
Dialogue: 1,0:22:02.61,0:22:06.83,Dial_CH,,0,0,0,,就算现在调整好了 没过多久心又乱了又有什么意义
Dialogue: 1,0:22:07.08,0:22:11.37,Dial_CH,,0,0,0,,你现在需要的是摆在眼前的危机感
Dialogue: 1,0:22:14.88,0:22:19.01,Dial_CH,,0,0,0,,这次的考试 你必须进年级前十
Dialogue: 1,0:22:19.01,0:22:23.82,Dial_CH,,0,0,0,,若是做不到 我就把你送回东京
