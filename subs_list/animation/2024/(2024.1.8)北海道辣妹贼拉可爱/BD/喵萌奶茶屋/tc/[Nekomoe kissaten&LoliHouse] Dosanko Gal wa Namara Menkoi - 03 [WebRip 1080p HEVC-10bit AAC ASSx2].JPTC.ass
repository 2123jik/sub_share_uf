Dialogue: 0,0:03:58.93,0:04:02.47,Title_CHT,,0,0,0,,{\fad(100,270)\blur5\pos(80,511)}第3話\N秋野同學超不領情
Dialogue: 0,0:00:01.08,0:00:03.61,Dial_JP,,0,0,0,,マジなまら楽しみなんだけど
Dialogue: 0,0:00:03.61,0:00:04.86,Dial_JP,,0,0,0,,今日のスキー
Dialogue: 0,0:00:05.06,0:00:09.74,Dial_JP,,0,0,0,,さすが北海道　授業で一日中スキーをするとは
Dialogue: 0,0:00:09.90,0:00:12.11,Dial_JP,,0,0,0,,翼はスキーしたことあるの
Dialogue: 0,0:00:12.61,0:00:15.18,Dial_JP,,0,0,0,,一回もないから　すごく怖いよ
Dialogue: 0,0:00:15.75,0:00:16.55,Dial_JP,,0,0,0,,何
Dialogue: 0,0:00:16.55,0:00:18.65,Dial_JP,,0,0,0,,つばちゃスキー怖いのぉ
Dialogue: 0,0:00:18.65,0:00:19.79,Dial_JP,,0,0,0,,よちよち
Dialogue: 0,0:00:20.70,0:00:22.35,Dial_JP,,0,0,0,,やめてよ　冬木さん
Dialogue: 0,0:00:23.42,0:00:26.42,Dial_JP,,0,0,0,,だって翼ちょすの楽しいんだもん
Dialogue: 0,0:00:26.61,0:00:30.80,Dial_JP,,0,0,0,,ウチはね　小学校からスキーやってたから得意なんだぁ
Dialogue: 0,0:00:31.08,0:00:34.56,Dial_JP,,0,0,0,,今日はウチのカッコいいとこ見ささっちゃうねぇ
Dialogue: 0,0:00:34.74,0:00:37.34,Dial_JP,,0,0,0,,身　刺さっちゃう？
Dialogue: 0,0:00:37.71,0:00:40.99,Dial_JP,,0,0,0,,ってか　たぶんみんな余裕で滑れると思うけど
Dialogue: 0,0:00:41.33,0:00:44.56,Dial_JP,,0,0,0,,さすが道民は雪の扱いにたけているよね
Dialogue: 0,0:00:45.16,0:00:46.96,Dial_JP,,0,0,0,,東京はほぼ降らないし
Dialogue: 0,0:00:46.96,0:00:49.07,Dial_JP,,0,0,0,,降っても積もったりしないから
Dialogue: 0,0:00:54.17,0:00:57.07,Dial_JP,,0,0,0,,ねねっ　沙友理ちゃんはスキー楽しみ
Dialogue: 0,0:01:03.25,0:01:06.36,Dial_JP,,0,0,0,,まあ　わざわざ聞くようなことじゃないよね
Dialogue: 0,0:01:08.89,0:01:12.16,Dial_JP,,0,0,0,,いつもみんなと仲のいい冬木さんが珍しいな
Dialogue: 0,0:01:12.97,0:01:15.43,Dial_JP,,0,0,0,,２人の間で何かあったんだろうか
Dialogue: 0,0:01:15.95,0:01:17.58,Dial_JP,,0,0,0,,冬木さん　大丈夫
Dialogue: 0,0:01:18.84,0:01:19.75,Dial_JP,,0,0,0,,いや
Dialogue: 0,0:01:19.75,0:01:24.39,Dial_JP,,0,0,0,,あのさ　ウチね　どうしても沙友理ちゃんと仲よくなりたいの
Dialogue: 0,0:01:24.39,0:01:26.77,Dial_JP,,0,0,0,,絶対ギャル友になれると思ってさ
Dialogue: 0,0:01:27.66,0:01:29.61,Dial_JP,,0,0,0,,なんかケンカしたとかではないんだ
Dialogue: 0,0:01:29.61,0:01:31.60,Dial_JP,,0,0,0,,するわけないしょやぁ
Dialogue: 0,0:01:31.60,0:01:33.42,Dial_JP,,0,0,0,,こんなにしゅきなのに
Dialogue: 0,0:01:33.89,0:01:36.91,Dial_JP,,0,0,0,,でもウチが話しかけるといつもあんな感じなの
Dialogue: 0,0:01:37.14,0:01:41.24,Dial_JP,,0,0,0,,それでも仲よくなりたいって　メンタル強いなあ
Dialogue: 0,0:01:41.24,0:01:43.67,Dial_JP,,0,0,0,,だってさ翼　よく見てみ
Dialogue: 0,0:01:44.10,0:01:46.09,Dial_JP,,0,0,0,,なまらめんこくない
Dialogue: 0,0:01:46.09,0:01:48.50,Dial_JP,,0,0,0,,髪とかしぐさとか雰囲気とか
Dialogue: 0,0:01:48.50,0:01:50.23,Dial_JP,,0,0,0,,顔とか　顔とか　顔が
Dialogue: 0,0:01:50.23,0:01:51.54,Dial_JP,,0,0,0,,顔面率
Dialogue: 0,0:01:51.54,0:01:55.05,Dial_JP,,0,0,0,,黒髪清楚系ギャルとかマジ推せんだけど
Dialogue: 0,0:01:57.44,0:02:00.44,Dial_JP,,0,0,0,,黒髪清楚系　ギャル
Dialogue: 0,0:02:00.92,0:02:03.65,Dial_JP,,0,0,0,,その２つは対極に位置するはずでは
Dialogue: 0,0:02:03.95,0:02:06.88,Dial_JP,,0,0,0,,そんな表裏一体が存在するのか
Dialogue: 0,0:02:11.08,0:02:12.74,Dial_JP,,0,0,0,,超見とれてんじゃん
Dialogue: 0,0:02:13.44,0:02:14.75,Dial_JP,,0,0,0,,いや　別にそんな
Dialogue: 0,0:02:16.32,0:02:17.40,Dial_JP,,0,0,0,,まあいいや
Dialogue: 0,0:02:17.64,0:02:20.04,Dial_JP,,0,0,0,,もうそろそろ着くし　またあとでね
Dialogue: 0,0:02:20.04,0:02:21.64,Dial_JP,,0,0,0,,ちょっ　冬木さん
Dialogue: 0,0:04:05.85,0:04:08.10,Dial_JP,,0,0,0,,はーい　それじゃあ　うまい順で
Dialogue: 0,0:04:08.42,0:04:10.30,Dial_JP,,0,0,0,,A B Cクラスに分かれて
Dialogue: 0,0:04:10.30,0:04:13.99,Dial_JP,,0,0,0,,各クラスの先生の指示に従って行動するように
Dialogue: 0,0:04:13.99,0:04:15.53,Dial_JP,,0,0,0,,はーい
Dialogue: 0,0:04:15.92,0:04:18.92,Dial_JP,,0,0,0,,えっと　俺はどこに
Dialogue: 0,0:04:19.81,0:04:22.18,Dial_JP,,0,0,0,,四季はスキー未経験だったな
Dialogue: 0,0:04:22.72,0:04:23.28,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:04:23.47,0:04:28.04,Dial_JP,,0,0,0,,Ｃクラスでも　一応リフトに乗って少し高い所から滑るんだが
Dialogue: 0,0:04:28.37,0:04:29.44,Dial_JP,,0,0,0,,やれそうか
Dialogue: 0,0:04:31.02,0:04:34.53,Dial_JP,,0,0,0,,できれば　平らな所で歩く練習からしたいです
Dialogue: 0,0:04:34.53,0:04:35.64,Dial_JP,,0,0,0,,だよな
Dialogue: 0,0:04:35.92,0:04:36.96,Dial_JP,,0,0,0,,そしたら
Dialogue: 0,0:04:36.96,0:04:38.30,Dial_JP,,0,0,0,,今日はアイツと２人で
Dialogue: 0,0:04:38.70,0:04:41.80,Dial_JP,,0,0,0,,特別に初心者クラスってことでやっていこうか
Dialogue: 0,0:04:42.17,0:04:44.68,Dial_JP,,0,0,0,,秋野もどうしても滑れないらしくてな
Dialogue: 0,0:04:45.40,0:04:48.72,Dial_JP,,0,0,0,,先生はＣクラスの担当であまり見られないが
Dialogue: 0,0:04:48.93,0:04:50.78,Dial_JP,,0,0,0,,ちょくちょく様子見に来るから
Dialogue: 0,0:04:54.19,0:04:56.18,Dial_JP,,0,0,0,,じゃあ　無理だけはするなよ
Dialogue: 0,0:04:56.18,0:04:56.99,Dial_JP,,0,0,0,,はい
Dialogue: 0,0:05:02.96,0:05:05.45,Dial_JP,,0,0,0,,これはもう話すチャンスでしかない
Dialogue: 0,0:05:05.70,0:05:08.33,Dial_JP,,0,0,0,,冬木さんとの懸け橋になれるかもしれないし
Dialogue: 0,0:05:11.18,0:05:12.23,Dial_JP,,0,0,0,,秋野さん
Dialogue: 0,0:05:13.07,0:05:14.34,Dial_JP,,0,0,0,,よかったら一緒に…
Dialogue: 0,0:05:17.29,0:05:18.22,Dial_JP,,0,0,0,,イヤホン
Dialogue: 0,0:05:18.89,0:05:21.22,Dial_JP,,0,0,0,,わざわざイヤホンしてるってことは
Dialogue: 0,0:05:21.22,0:05:23.51,Dial_JP,,0,0,0,,話しかけてほしくないんだろうなあ
Dialogue: 0,0:05:23.99,0:05:27.41,Dial_JP,,0,0,0,,冬木さんには悪いけど　ここはいったん引こう
Dialogue: 0,0:05:28.43,0:05:31.67,Dial_JP,,0,0,0,,というか　耳に髪の毛かけるのって
Dialogue: 0,0:05:32.01,0:05:33.27,Dial_JP,,0,0,0,,なんかヤバい
Dialogue: 0,0:05:34.09,0:05:36.54,Dial_JP,,0,0,0,,なぜそう思うかまったくわからないが
Dialogue: 0,0:05:52.51,0:05:56.87,Dial_JP,,0,0,0,,なるほど　左右交互に体重移動すると進みやすいのか
Dialogue: 0,0:05:59.36,0:06:00.43,Dial_JP,,0,0,0,,秋野さん
Dialogue: 0,0:06:00.84,0:06:01.94,Dial_JP,,0,0,0,,大丈夫
Dialogue: 0,0:06:01.94,0:06:04.51,Dial_JP,,0,0,0,,俺も集中しててすぐ気付けなかった
Dialogue: 0,0:06:04.51,0:06:05.36,Dial_JP,,0,0,0,,ごめん
Dialogue: 0,0:06:07.93,0:06:11.22,Dial_JP,,0,0,0,,こんなことできたって　なんの意味が
Dialogue: 0,0:06:11.61,0:06:13.35,Dial_JP,,0,0,0,,翼
Dialogue: 0,0:06:23.03,0:06:24.75,Dial_JP,,0,0,0,,どうだった　どうだった
Dialogue: 0,0:06:24.75,0:06:26.28,Dial_JP,,0,0,0,,ウチカッコよかった
Dialogue: 0,0:06:26.28,0:06:27.09,Dial_JP,,0,0,0,,すごっ
Dialogue: 0,0:06:28.28,0:06:29.74,Dial_JP,,0,0,0,,メッチャカッコよかった
Dialogue: 0,0:06:30.72,0:06:32.44,Dial_JP,,0,0,0,,だからゆったっしょ
Dialogue: 0,0:06:32.44,0:06:33.77,Dial_JP,,0,0,0,,冬木
Dialogue: 0,0:06:34.60,0:06:37.02,Dial_JP,,0,0,0,,ジャンプ台は使うなと言っただろ
Dialogue: 0,0:06:37.50,0:06:38.25,Dial_JP,,0,0,0,,ヤバ
Dialogue: 0,0:06:38.76,0:06:39.95,Dial_JP,,0,0,0,,したっけね
Dialogue: 0,0:06:42.93,0:06:44.62,Dial_JP,,0,0,0,,すごいなあ
Dialogue: 0,0:06:45.38,0:06:49.08,Dial_JP,,0,0,0,,四季はさ　冬木とつきあってんの
Dialogue: 0,0:06:50.26,0:06:52.29,Dial_JP,,0,0,0,,いやいや　そんなことないよ
Dialogue: 0,0:06:52.71,0:06:53.45,Dial_JP,,0,0,0,,なんで
Dialogue: 0,0:06:53.45,0:06:56.10,Dial_JP,,0,0,0,,バスん中でも仲よさそうだったし
Dialogue: 0,0:06:56.47,0:06:58.50,Dial_JP,,0,0,0,,なんというか　あれは　ただ
Dialogue: 0,0:06:58.50,0:07:00.19,Dial_JP,,0,0,0,,からかわれてるだけというか
Dialogue: 0,0:07:00.19,0:07:02.17,Dial_JP,,0,0,0,,それだけには見えないけど
Dialogue: 0,0:07:03.19,0:07:05.23,Dial_JP,,0,0,0,,始まる前に注意したよな
Dialogue: 0,0:07:05.88,0:07:07.09,Dial_JP,,0,0,0,,ケガしたらどうするんだ　お前
Dialogue: 0,0:07:07.09,0:07:10.74,Dial_JP,,0,0,0,,冬木って　これぞ人気者って感じだよね
Dialogue: 0,0:07:10.90,0:07:13.03,Dial_JP,,0,0,0,,声でかいし　パリピだし
Dialogue: 0,0:07:13.03,0:07:15.05,Dial_JP,,0,0,0,,陽キャだし　ギャルだし
Dialogue: 0,0:07:16.09,0:07:16.78,Dial_JP,,0,0,0,,あれ
Dialogue: 0,0:07:17.11,0:07:19.71,Dial_JP,,0,0,0,,なんか　すごい陰のオーラを感じる
Dialogue: 0,0:07:19.71,0:07:22.32,Dial_JP,,0,0,0,,私が持ってないもの全部持っててさ
Dialogue: 0,0:07:24.12,0:07:25.34,Dial_JP,,0,0,0,,秋野さん
Dialogue: 0,0:07:25.51,0:07:27.36,Dial_JP,,0,0,0,,はい　おしゃべり終わり
Dialogue: 0,0:07:28.12,0:07:30.02,Dial_JP,,0,0,0,,またおのおの自習ってことで
Dialogue: 0,0:07:44.83,0:07:46.43,Dial_JP,,0,0,0,,一緒に下りよっか
Dialogue: 0,0:07:47.53,0:07:50.32,Dial_JP,,0,0,0,,ここの上級者コースエグいから
Dialogue: 0,0:07:50.32,0:07:51.98,Dial_JP,,0,0,0,,ウチがエスコートしたげる
Dialogue: 0,0:07:52.67,0:07:53.64,Dial_JP,,0,0,0,,いいの
Dialogue: 0,0:07:53.86,0:07:55.20,Dial_JP,,0,0,0,,大丈夫
Dialogue: 0,0:07:55.20,0:07:57.92,Dial_JP,,0,0,0,,ウチ　雪山のお助けギャルだから
Dialogue: 0,0:07:59.58,0:08:00.98,Dial_JP,,0,0,0,,お願いします
Dialogue: 0,0:08:01.36,0:08:02.31,Dial_JP,,0,0,0,,よし
Dialogue: 0,0:08:02.31,0:08:03.64,Dial_JP,,0,0,0,,したっけ行くよ
Dialogue: 0,0:08:09.72,0:08:11.64,Dial_JP,,0,0,0,,ゴーゴー
Dialogue: 0,0:08:13.71,0:08:15.60,Dial_JP,,0,0,0,,いやぁ　すまんすまん
Dialogue: 0,0:08:15.60,0:08:16.67,Dial_JP,,0,0,0,,秋野　四季
Dialogue: 0,0:08:16.88,0:08:18.60,Dial_JP,,0,0,0,,Ｃクラスで手いっぱいで
Dialogue: 0,0:08:18.60,0:08:20.44,Dial_JP,,0,0,0,,全然相手できなかった
Dialogue: 0,0:08:21.42,0:08:22.71,Dial_JP,,0,0,0,,大丈夫ですよ
Dialogue: 0,0:08:23.15,0:08:25.99,Dial_JP,,0,0,0,,ところで　今日は昼休み何時からですか
Dialogue: 0,0:08:25.99,0:08:27.58,Dial_JP,,0,0,0,,いやぁ　それが
Dialogue: 0,0:08:28.08,0:08:31.49,Dial_JP,,0,0,0,,もう他の生徒はほとんど昼休み入ってるんだよね
Dialogue: 0,0:08:32.87,0:08:34.91,Dial_JP,,0,0,0,,絶対忘れてたな
Dialogue: 0,0:08:35.70,0:08:40.50,Dial_JP,,0,0,0,,もちろん　お前たちは今から昼休み分の時間　休憩してくれな
Dialogue: 0,0:08:49.38,0:08:53.14,Dial_JP,,0,0,0,,さすがに秋野さんと２人きりはちょっと気まずいし
Dialogue: 0,0:08:53.14,0:08:55.32,Dial_JP,,0,0,0,,施設内で弁当食べてこよう
Dialogue: 0,0:09:01.05,0:09:03.69,Dial_JP,,0,0,0,,みんなもう昼休み終わっちゃったか
Dialogue: 0,0:09:08.08,0:09:10.23,Dial_JP,,0,0,0,,箸　カバンの中だ
Dialogue: 0,0:09:11.38,0:09:12.83,Dial_JP,,0,0,0,,やっちゃった
Dialogue: 0,0:09:12.83,0:09:14.92,Dial_JP,,0,0,0,,さっと戻って　さっと帰ろう
Dialogue: 0,0:09:25.72,0:09:28.79,Dial_JP,,0,0,0,,そういえば　沙友理ちゃんは何クラスなんだろ
Dialogue: 0,0:09:35.39,0:09:36.38,Dial_JP,,0,0,0,,ごめん
Dialogue: 0,0:09:36.91,0:09:38.14,Dial_JP,,0,0,0,,ヤッバ
Dialogue: 0,0:09:38.43,0:09:39.63,Dial_JP,,0,0,0,,着替えてた
Dialogue: 0,0:09:39.63,0:09:42.67,Dial_JP,,0,0,0,,バスの中に誰もいないから大丈夫だと思ったのか
Dialogue: 0,0:09:42.91,0:09:44.26,Dial_JP,,0,0,0,,どうしよう　どうしよう
Dialogue: 0,0:09:44.26,0:09:45.73,Dial_JP,,0,0,0,,いろいろ見えてしまった
Dialogue: 0,0:09:45.73,0:09:47.87,Dial_JP,,0,0,0,,肌とか　下着とか　汗とか
Dialogue: 0,0:09:47.87,0:09:48.93,Dial_JP,,0,0,0,,落ち着け
Dialogue: 0,0:09:48.93,0:09:51.11,Dial_JP,,0,0,0,,とにかく事情を説明しないと
Dialogue: 0,0:09:51.11,0:09:53.51,Dial_JP,,0,0,0,,秋野さん　ほんとにごめんなさい
Dialogue: 0,0:09:53.51,0:09:56.47,Dial_JP,,0,0,0,,どんな状況が知らなくて　見るつもりなんてなくて
Dialogue: 0,0:09:56.47,0:09:59.47,Dial_JP,,0,0,0,,もちろん誰にも　俺も忘れるようにします
Dialogue: 0,0:09:59.47,0:10:03.31,Dial_JP,,0,0,0,,ただその　ここに来たのは弁当の箸をかばんの中に忘れたから
Dialogue: 0,0:10:03.31,0:10:04.36,Dial_JP,,0,0,0,,取りにきたから
Dialogue: 0,0:10:04.82,0:10:07.48,Dial_JP,,0,0,0,,もし大丈夫なら　持って行きたいんだけど
Dialogue: 0,0:10:07.72,0:10:08.87,Dial_JP,,0,0,0,,いいかな
Dialogue: 0,0:10:13.49,0:10:14.93,Dial_JP,,0,0,0,,そうだよね
Dialogue: 0,0:10:15.26,0:10:17.16,Dial_JP,,0,0,0,,ごめん　出直してくるよ
Dialogue: 0,0:10:25.64,0:10:28.82,Dial_JP,,0,0,0,,ごはん食べながらでいいから　とりま話そ
Dialogue: 0,0:10:39.72,0:10:42.58,Dial_JP,,0,0,0,,座ってから　黙々とごはん食べてるけど
Dialogue: 0,0:10:43.27,0:10:44.91,Dial_JP,,0,0,0,,話ってなんだろう
Dialogue: 0,0:10:46.14,0:10:48.49,Dial_JP,,0,0,0,,もしかして口止め的なやつか
Dialogue: 0,0:10:49.20,0:10:51.43,Dial_JP,,0,0,0,,秋野さんのことよく知らないけど
Dialogue: 0,0:10:51.43,0:10:52.76,Dial_JP,,0,0,0,,ちょっと怖いな
Dialogue: 0,0:10:59.88,0:11:01.50,Dial_JP,,0,0,0,,ワーッて話すから聞いて
Dialogue: 0,0:11:01.93,0:11:03.24,Dial_JP,,0,0,0,,は…　はい
Dialogue: 0,0:11:06.04,0:11:08.45,Dial_JP,,0,0,0,,私って　汗っかきなのね
Dialogue: 0,0:11:09.29,0:11:11.65,Dial_JP,,0,0,0,,昔っから汗かいてるのハズくて
Dialogue: 0,0:11:11.65,0:11:13.53,Dial_JP,,0,0,0,,運動全般避けててさ
Dialogue: 0,0:11:13.98,0:11:16.89,Dial_JP,,0,0,0,,ただまあ　それが続くと差がつくじゃん
Dialogue: 0,0:11:17.28,0:11:20.08,Dial_JP,,0,0,0,,どんどん自分だけできないことが増えてさ
Dialogue: 0,0:11:20.44,0:11:22.53,Dial_JP,,0,0,0,,自分に自信が持てなくなって
Dialogue: 0,0:11:22.53,0:11:25.19,Dial_JP,,0,0,0,,気がついたら周りを避けるようになっちゃってて
Dialogue: 0,0:11:25.55,0:11:27.46,Dial_JP,,0,0,0,,時たまヤバいなあってなるんだけど
Dialogue: 0,0:11:28.03,0:11:30.73,Dial_JP,,0,0,0,,さっきみたいにスキーの練習頑張ったら
Dialogue: 0,0:11:31.21,0:11:33.88,Dial_JP,,0,0,0,,汗拭いてるとこ見られたりするんだよね
Dialogue: 0,0:11:34.12,0:11:35.09,Dial_JP,,0,0,0,,最悪
Dialogue: 0,0:11:35.83,0:11:38.41,Dial_JP,,0,0,0,,それはもう本当にすみません
Dialogue: 0,0:11:38.41,0:11:41.56,Dial_JP,,0,0,0,,いや　無防備すぎた私が悪いけど
Dialogue: 0,0:11:42.40,0:11:44.87,Dial_JP,,0,0,0,,でも　どうして話してくれたの
Dialogue: 0,0:11:45.17,0:11:48.15,Dial_JP,,0,0,0,,俺なんて転校したてで　全然接点なかったのに
Dialogue: 0,0:11:48.63,0:11:50.18,Dial_JP,,0,0,0,,そんな大事なこと
Dialogue: 0,0:11:51.35,0:11:53.54,Dial_JP,,0,0,0,,むしろそれがよかったんだって
Dialogue: 0,0:11:54.17,0:11:56.48,Dial_JP,,0,0,0,,今までの私を知らないわけだし
Dialogue: 0,0:11:56.48,0:11:58.59,Dial_JP,,0,0,0,,逆に話しやすいっていうか
Dialogue: 0,0:11:59.93,0:12:00.91,Dial_JP,,0,0,0,,なるほど
Dialogue: 0,0:12:01.22,0:12:04.12,Dial_JP,,0,0,0,,それにほら　境遇も似てるじゃん
Dialogue: 0,0:12:05.00,0:12:07.87,Dial_JP,,0,0,0,,この座席も　友達いない私と
Dialogue: 0,0:12:07.87,0:12:10.11,Dial_JP,,0,0,0,,転校生っていう独り身同士でさ
Dialogue: 0,0:12:10.85,0:12:12.55,Dial_JP,,0,0,0,,なんか複雑だけど
Dialogue: 0,0:12:12.77,0:12:14.38,Dial_JP,,0,0,0,,俺転校生でよかったよ
Dialogue: 0,0:12:15.06,0:12:17.93,Dial_JP,,0,0,0,,あと　四季ってバカみたいに真面目だし
Dialogue: 0,0:12:17.93,0:12:18.51,Dial_JP,,0,0,0,,バッ…
Dialogue: 0,0:12:18.88,0:12:20.30,Dial_JP,,0,0,0,,そうかな
Dialogue: 0,0:12:20.78,0:12:24.80,Dial_JP,,0,0,0,,要するにちゃかしたり言いふらしたりしなさそうってこと
Dialogue: 0,0:12:28.72,0:12:32.07,Dial_JP,,0,0,0,,今の音　秋野さんのカバンの中から
Dialogue: 0,0:12:32.39,0:12:34.00,Dial_JP,,0,0,0,,スマホの通知かな
Dialogue: 0,0:12:34.67,0:12:36.32,Dial_JP,,0,0,0,,すごい気になってる
Dialogue: 0,0:12:39.35,0:12:41.65,Dial_JP,,0,0,0,,俺のこと気にしないで見てもいいよ
Dialogue: 0,0:12:42.45,0:12:43.68,Dial_JP,,0,0,0,,いや　でも…
Dialogue: 0,0:12:45.35,0:12:46.72,Dial_JP,,0,0,0,,まあいいか
Dialogue: 0,0:12:47.00,0:12:49.42,Dial_JP,,0,0,0,,ここまできたら隠す必要ないし
Dialogue: 0,0:12:52.76,0:12:54.47,Dial_JP,,0,0,0,,やっぱりアプデ通知だ
Dialogue: 0,0:12:56.53,0:12:58.36,Dial_JP,,0,0,0,,耳に髪の毛
Dialogue: 0,0:12:59.55,0:13:01.20,Dial_JP,,0,0,0,,何それ　タブレット
Dialogue: 0,0:13:01.52,0:13:06.16,Dial_JP,,0,0,0,,最近また再燃して　集英堂ウィッチの「シスプラSP」やってんだよね
Dialogue: 0,0:13:06.52,0:13:07.85,Dial_JP,,0,0,0,,シス　プラ？
Dialogue: 0,0:13:08.93,0:13:10.93,Dial_JP,,0,0,0,,「クラッシュシスターズプラス」だよ
Dialogue: 0,0:13:10.93,0:13:13.47,Dial_JP,,0,0,0,,いろんな人気キャラが出てくる対戦ゲーム
Dialogue: 0,0:13:13.47,0:13:14.57,Dial_JP,,0,0,0,,知ってるでしょ
Dialogue: 0,0:13:14.57,0:13:16.79,Dial_JP,,0,0,0,,いや　知らないけど
Dialogue: 0,0:13:17.10,0:13:19.15,Dial_JP,,0,0,0,,俺あんまりゲームやらないし
Dialogue: 0,0:13:21.30,0:13:22.56,Dial_JP,,0,0,0,,ちょっとやってみ
Dialogue: 0,0:13:22.78,0:13:24.60,Dial_JP,,0,0,0,,いやいや　わかんない
Dialogue: 0,0:13:24.90,0:13:26.89,Dial_JP,,0,0,0,,どこ　何押せばいいの
Dialogue: 0,0:13:27.09,0:13:29.00,Dial_JP,,0,0,0,,とりあえず　スティック動かして
Dialogue: 0,0:13:29.43,0:13:30.08,Dial_JP,,0,0,0,,これ？
Dialogue: 0,0:13:33.74,0:13:34.54,Dial_JP,,0,0,0,,負けた
Dialogue: 0,0:13:36.16,0:13:37.83,Dial_JP,,0,0,0,,さすがにそれは草
Dialogue: 0,0:13:37.83,0:13:39.30,Dial_JP,,0,0,0,,マジでやったことないんだね
Dialogue: 0,0:13:39.50,0:13:41.75,Dial_JP,,0,0,0,,だって　どうすればいいか
Dialogue: 0,0:13:41.75,0:13:44.98,Dial_JP,,0,0,0,,だから　まずスティックをこうして
Dialogue: 0,0:13:44.98,0:13:48.35,Dial_JP,,0,0,0,,キャラ動かして　相手に近づいて攻撃するの
Dialogue: 0,0:13:48.68,0:13:51.06,Dial_JP,,0,0,0,,攻撃はこことかここのボタンね
Dialogue: 0,0:13:51.31,0:13:54.73,Dial_JP,,0,0,0,,そんでガードとかジャンプで相手の攻撃をかわしながら
Dialogue: 0,0:13:57.27,0:13:57.78,Dial_JP,,0,0,0,,ごめん
Dialogue: 0,0:14:02.19,0:14:04.62,Dial_JP,,0,0,0,,急にこんなこられてもウザいよな
Dialogue: 0,0:14:04.62,0:14:06.45,Dial_JP,,0,0,0,,いやいや　そんなことないよ
Dialogue: 0,0:14:07.34,0:14:10.65,Dial_JP,,0,0,0,,私さ　なるべく人となじめるよう
Dialogue: 0,0:14:10.65,0:14:12.70,Dial_JP,,0,0,0,,見た目には気ぃ遣ってるんだ
Dialogue: 0,0:14:13.16,0:14:16.13,Dial_JP,,0,0,0,,でも根がこれだから　距離感つかむ前に
Dialogue: 0,0:14:16.13,0:14:18.20,Dial_JP,,0,0,0,,引かれるか怖がられんだよね
Dialogue: 0,0:14:19.54,0:14:23.58,Dial_JP,,0,0,0,,そんで結局　唯一得意なゲームに逃げるっていう
Dialogue: 0,0:14:24.48,0:14:26.13,Dial_JP,,0,0,0,,マジでダメだな私
Dialogue: 0,0:14:26.13,0:14:27.50,Dial_JP,,0,0,0,,そんなことないよ
Dialogue: 0,0:14:28.04,0:14:30.25,Dial_JP,,0,0,0,,ちゃんと努力して　偉いと思う
Dialogue: 0,0:14:30.48,0:14:32.81,Dial_JP,,0,0,0,,俺は秋野さんの内面も見た目も
Dialogue: 0,0:14:32.81,0:14:34.90,Dial_JP,,0,0,0,,個性的ですごくいいと思うし
Dialogue: 0,0:14:35.13,0:14:37.48,Dial_JP,,0,0,0,,秋野さんのことが知れてよかったよ
Dialogue: 0,0:14:38.52,0:14:40.04,Dial_JP,,0,0,0,,話してくれてありがとう
Dialogue: 0,0:14:44.94,0:14:47.28,Dial_JP,,0,0,0,,そんなハズいことよく言えるな
Dialogue: 0,0:14:47.28,0:14:49.91,Dial_JP,,0,0,0,,それにゲームが得意ってすごいことじゃん
Dialogue: 0,0:14:50.30,0:14:53.12,Dial_JP,,0,0,0,,よかったら　もっと俺にゲーム教えてよ
Dialogue: 0,0:14:53.38,0:14:55.63,Dial_JP,,0,0,0,,秋野さんと一緒にゲームしてみたい
Dialogue: 0,0:15:03.73,0:15:05.81,Dial_JP,,0,0,0,,しょ　しようがないなあ
Dialogue: 0,0:15:06.06,0:15:08.39,Dial_JP,,0,0,0,,教えてもいいけど　師匠と呼べよ
Dialogue: 0,0:15:08.84,0:15:10.34,Dial_JP,,0,0,0,,はい　師匠
Dialogue: 0,0:15:18.19,0:15:21.29,Dial_JP,,0,0,0,,何今の　すっげえ
Dialogue: 0,0:15:21.59,0:15:23.00,Dial_JP,,0,0,0,,どうやったんすか　師匠
Dialogue: 0,0:15:23.72,0:15:26.36,Dial_JP,,0,0,0,,立ち回り自体はそこまでむずくないから
Dialogue: 0,0:15:26.94,0:15:28.99,Dial_JP,,0,0,0,,四季でもやればできるようになるよ
Dialogue: 0,0:15:29.53,0:15:32.26,Dial_JP,,0,0,0,,「やればできるようになる」か
Dialogue: 0,0:15:32.81,0:15:33.97,Dial_JP,,0,0,0,,よーし
Dialogue: 0,0:15:45.29,0:15:46.36,Dial_JP,,0,0,0,,倒した
Dialogue: 0,0:15:46.57,0:15:48.18,Dial_JP,,0,0,0,,クリアしたよ師匠
Dialogue: 0,0:15:48.18,0:15:51.01,Dial_JP,,0,0,0,,いや　それ　いちばん弱いCPUだし
Dialogue: 0,0:15:51.33,0:15:52.88,Dial_JP,,0,0,0,,全然クリアじゃないけど
Dialogue: 0,0:15:53.67,0:15:55.48,Dial_JP,,0,0,0,,こんなに達成感あるのに
Dialogue: 0,0:15:55.64,0:15:56.44,Dial_JP,,0,0,0,,ってか
Dialogue: 0,0:15:56.44,0:15:58.15,Dial_JP,,0,0,0,,秋野さん　今気付いたけど
Dialogue: 0,0:15:58.15,0:15:59.85,Dial_JP,,0,0,0,,時間ヤバいよ　行かないと
Dialogue: 0,0:16:00.14,0:16:02.18,Dial_JP,,0,0,0,,マジ　ちょっと待って
Dialogue: 0,0:16:03.58,0:16:06.88,Dial_JP,,0,0,0,,先生にも私らは無理するなって言われてるし
Dialogue: 0,0:16:07.40,0:16:09.63,Dial_JP,,0,0,0,,午後はもう適当に流すかあ
Dialogue: 0,0:16:11.77,0:16:12.83,Dial_JP,,0,0,0,,秋野さん
Dialogue: 0,0:16:13.43,0:16:15.33,Dial_JP,,0,0,0,,一緒に上から滑ってみない
Dialogue: 0,0:16:16.70,0:16:18.02,Dial_JP,,0,0,0,,ゲームと同じだよ
Dialogue: 0,0:16:18.45,0:16:20.63,Dial_JP,,0,0,0,,やればできるようになるかもしれない
Dialogue: 0,0:16:24.61,0:16:28.51,Dial_JP,,0,0,0,,よーし　Ａクラスは　残り時間自由に滑っていいぞ
Dialogue: 0,0:16:28.70,0:16:29.86,Dial_JP,,0,0,0,,わい
Dialogue: 0,0:16:31.24,0:16:34.37,Dial_JP,,0,0,0,,さあてどこから滑ろうかにゃあ
Dialogue: 0,0:16:36.91,0:16:38.88,Dial_JP,,0,0,0,,あの２人ってまさか
Dialogue: 0,0:16:39.36,0:16:41.61,Dial_JP,,0,0,0,,翼と沙友理ちゃん
Dialogue: 0,0:16:42.63,0:16:44.74,Dial_JP,,0,0,0,,メッチャ高いよ　秋野さん
Dialogue: 0,0:16:44.74,0:16:46.20,Dial_JP,,0,0,0,,足ブランブランだけど
Dialogue: 0,0:16:46.20,0:16:47.78,Dial_JP,,0,0,0,,大丈夫なの　これ
Dialogue: 0,0:16:51.04,0:16:54.67,Dial_JP,,0,0,0,,上から見たらすごい広いなあ　このスキー場
Dialogue: 0,0:16:56.52,0:16:58.00,Dial_JP,,0,0,0,,ねえ　四季
Dialogue: 0,0:16:59.03,0:17:00.81,Dial_JP,,0,0,0,,四季はどうして滑るの
Dialogue: 0,0:17:01.52,0:17:04.71,Dial_JP,,0,0,0,,先生は無理に滑らなくてもいいって言ってるのにさ
Dialogue: 0,0:17:10.17,0:17:14.51,Dial_JP,,0,0,0,,俺は　北海道でいろんなことにチャレンジしようって決めてるから
Dialogue: 0,0:17:15.00,0:17:16.06,Dial_JP,,0,0,0,,チャレンジ？
Dialogue: 0,0:17:16.88,0:17:20.40,Dial_JP,,0,0,0,,まあ　でも今から行くのはいちばん簡単なコースだし
Dialogue: 0,0:17:20.61,0:17:24.35,Dial_JP,,0,0,0,,実は昼休み入る前も　先生にコツ聞いたんだよね
Dialogue: 0,0:17:26.84,0:17:28.25,Dial_JP,,0,0,0,,四季はすごいね
Dialogue: 0,0:17:29.00,0:17:30.45,Dial_JP,,0,0,0,,私とは大違いだ
Dialogue: 0,0:17:30.86,0:17:31.84,Dial_JP,,0,0,0,,とはいえ
Dialogue: 0,0:17:32.08,0:17:35.16,Dial_JP,,0,0,0,,そんなふうに思わせてくれたのは冬木さんなんだけど
Dialogue: 0,0:17:36.36,0:17:37.24,Dial_JP,,0,0,0,,冬木
Dialogue: 0,0:17:37.24,0:17:41.00,Dial_JP,,0,0,0,,冬木さんが　こっちに来て初めてできた友達なんだけど
Dialogue: 0,0:17:41.59,0:17:43.69,Dial_JP,,0,0,0,,いろんなものを食べさせてくれたり
Dialogue: 0,0:17:43.69,0:17:46.21,Dial_JP,,0,0,0,,いろんな所に連れていってくれたりしてさ
Dialogue: 0,0:17:47.41,0:17:49.56,Dial_JP,,0,0,0,,今回のスキーもすごかったよね
Dialogue: 0,0:17:50.14,0:17:53.80,Dial_JP,,0,0,0,,四季は　冬木のことが好きなんだね
Dialogue: 0,0:17:54.80,0:17:55.64,Dial_JP,,0,0,0,,いやいや
Dialogue: 0,0:17:55.64,0:17:57.07,Dial_JP,,0,0,0,,いや　別にそんな
Dialogue: 0,0:17:57.07,0:17:59.98,Dial_JP,,0,0,0,,す…　全然　普通の友達だよ
Dialogue: 0,0:18:00.22,0:18:03.07,Dial_JP,,0,0,0,,そんな必死に否定したらガチに聞こえるよ
Dialogue: 0,0:18:04.78,0:18:06.55,Dial_JP,,0,0,0,,冬木っていいヤツなんだよね
Dialogue: 0,0:18:07.56,0:18:09.37,Dial_JP,,0,0,0,,みんなから慕われてるし
Dialogue: 0,0:18:10.12,0:18:12.52,Dial_JP,,0,0,0,,私なんかにも声かけてくれるしさ
Dialogue: 0,0:18:13.01,0:18:15.63,Dial_JP,,0,0,0,,でも私みたいなヤツは
Dialogue: 0,0:18:15.63,0:18:18.58,Dial_JP,,0,0,0,,なんか裏があるんじゃないかとか疑っちゃって
Dialogue: 0,0:18:19.00,0:18:21.67,Dial_JP,,0,0,0,,うまく返事が　できないんだよね
Dialogue: 0,0:18:23.84,0:18:25.01,Dial_JP,,0,0,0,,だけど　冬木さんは…
Dialogue: 0,0:18:25.01,0:18:26.23,Dial_JP,,0,0,0,,もう着くから降りよ
Dialogue: 0,0:18:40.37,0:18:42.62,Dial_JP,,0,0,0,,秋野さんに　お願いがあるんだ
Dialogue: 0,0:18:43.56,0:18:46.51,Dial_JP,,0,0,0,,もし俺が一回も転ばずに下まで滑り切れたら
Dialogue: 0,0:18:46.92,0:18:49.78,Dial_JP,,0,0,0,,冬木さんにちゃんと返事をしてあげてほしい
Dialogue: 0,0:18:50.33,0:18:52.38,Dial_JP,,0,0,0,,別に無視したいわけじゃ
Dialogue: 0,0:18:52.38,0:18:53.38,Dial_JP,,0,0,0,,冬木さんは
Dialogue: 0,0:18:53.99,0:18:57.03,Dial_JP,,0,0,0,,本当に秋野さんと仲よくなりたいと思ってるんだ
Dialogue: 0,0:18:57.62,0:18:59.40,Dial_JP,,0,0,0,,何か裏があるわけじゃない
Dialogue: 0,0:19:01.55,0:19:04.17,Dial_JP,,0,0,0,,人のためによくそんなに体張れるね
Dialogue: 0,0:19:04.17,0:19:06.17,Dial_JP,,0,0,0,,冬木さんのためだけじゃないよ
Dialogue: 0,0:19:07.82,0:19:10.60,Dial_JP,,0,0,0,,俺も秋野さんともっと仲よくなりたいから
Dialogue: 0,0:19:13.12,0:19:15.68,Dial_JP,,0,0,0,,い…　いいけど　条件付きね
Dialogue: 0,0:19:17.19,0:19:19.09,Dial_JP,,0,0,0,,私を置いて行っちゃダメだから
Dialogue: 0,0:19:21.70,0:19:24.05,Dial_JP,,0,0,0,,もちろん　一緒に行こう
Dialogue: 0,0:19:37.50,0:19:39.96,Dial_JP,,0,0,0,,先生に聞いたゆっくり滑るコツは
Dialogue: 0,0:19:40.40,0:19:42.49,Dial_JP,,0,0,0,,重心を常に前にかけて
Dialogue: 0,0:19:42.78,0:19:43.94,Dial_JP,,0,0,0,,足はハの字
Dialogue: 0,0:19:44.74,0:19:46.99,Dial_JP,,0,0,0,,大きく蛇行しながら滑ること
Dialogue: 0,0:19:49.56,0:19:51.63,Dial_JP,,0,0,0,,私　できてる
Dialogue: 0,0:19:57.81,0:19:59.33,Dial_JP,,0,0,0,,あともう少し
Dialogue: 0,0:19:59.68,0:20:01.35,Dial_JP,,0,0,0,,最後まで気を抜くな
Dialogue: 0,0:20:01.84,0:20:04.18,Dial_JP,,0,0,0,,ブレーキは足をハの字にして
Dialogue: 0,0:20:08.22,0:20:10.01,Dial_JP,,0,0,0,,とっ　止まった
Dialogue: 0,0:20:10.80,0:20:12.39,Dial_JP,,0,0,0,,やった　滑れた
Dialogue: 0,0:20:12.39,0:20:14.44,Dial_JP,,0,0,0,,四季
Dialogue: 0,0:20:14.44,0:20:16.86,Dial_JP,,0,0,0,,これどうやって止まんの
Dialogue: 0,0:20:17.65,0:20:18.58,Dial_JP,,0,0,0,,まずい
Dialogue: 0,0:20:18.58,0:20:20.63,Dial_JP,,0,0,0,,止まり方教えるの忘れてた
Dialogue: 0,0:20:23.03,0:20:24.53,Dial_JP,,0,0,0,,秋野さん
Dialogue: 0,0:20:24.75,0:20:26.37,Dial_JP,,0,0,0,,足をハの字に
Dialogue: 0,0:20:26.37,0:20:28.07,Dial_JP,,0,0,0,,たぶん聞こえてない
Dialogue: 0,0:20:29.44,0:20:31.94,Dial_JP,,0,0,0,,こうなったら　俺が受け止めるしか
Dialogue: 0,0:20:32.93,0:20:34.20,Dial_JP,,0,0,0,,沙友理ちゃん
Dialogue: 0,0:20:34.71,0:20:37.66,Dial_JP,,0,0,0,,足をそろえてどっちかのお尻から転べば
Dialogue: 0,0:20:37.66,0:20:40.40,Dial_JP,,0,0,0,,そこまで痛くないし安全に止まれるよ
Dialogue: 0,0:20:42.24,0:20:43.44,Dial_JP,,0,0,0,,大丈夫
Dialogue: 0,0:20:43.44,0:20:45.85,Dial_JP,,0,0,0,,雪山のお助けギャルがついてるから
Dialogue: 0,0:20:47.25,0:20:49.61,Dial_JP,,0,0,0,,お手本見せるからマネしてみて
Dialogue: 0,0:20:58.70,0:21:00.75,Dial_JP,,0,0,0,,沙友理ちゃん　大丈夫
Dialogue: 0,0:21:00.75,0:21:04.05,Dial_JP,,0,0,0,,平気　ホントに全然痛くなかった
Dialogue: 0,0:21:05.01,0:21:06.55,Dial_JP,,0,0,0,,秋野さん
Dialogue: 0,0:21:06.55,0:21:08.34,Dial_JP,,0,0,0,,冬木さん
Dialogue: 0,0:21:11.82,0:21:13.60,Dial_JP,,0,0,0,,２人とも　大丈夫
Dialogue: 0,0:21:13.60,0:21:15.21,Dial_JP,,0,0,0,,大丈夫だよ
Dialogue: 0,0:21:15.71,0:21:18.09,Dial_JP,,0,0,0,,よかった　本当に
Dialogue: 0,0:21:18.09,0:21:20.91,Dial_JP,,0,0,0,,コラ　秋野　四季
Dialogue: 0,0:21:21.45,0:21:22.43,Dial_JP,,0,0,0,,先生だ
Dialogue: 0,0:21:22.74,0:21:25.31,Dial_JP,,0,0,0,,無断で何勝手に滑ってんだ
Dialogue: 0,0:21:25.57,0:21:26.95,Dial_JP,,0,0,0,,俺　行ってくる
Dialogue: 0,0:21:26.95,0:21:27.77,Dial_JP,,0,0,0,,私も
Dialogue: 0,0:21:28.20,0:21:31.07,Dial_JP,,0,0,0,,いや　秋野さんは俺が連れてったんだ
Dialogue: 0,0:21:31.35,0:21:34.12,Dial_JP,,0,0,0,,ケガまでさせそうになって　本当にごめん
Dialogue: 0,0:21:34.12,0:21:36.30,Dial_JP,,0,0,0,,俺が責任を持って怒られてくる
Dialogue: 0,0:21:37.21,0:21:40.66,Dial_JP,,0,0,0,,先生　すみませんでしたあ
Dialogue: 0,0:21:40.66,0:21:42.64,Dial_JP,,0,0,0,,なまら謝ってるし
Dialogue: 0,0:21:42.64,0:21:43.72,Dial_JP,,0,0,0,,ウケる
Dialogue: 0,0:21:49.18,0:21:50.52,Dial_JP,,0,0,0,,さっきはありがとう
Dialogue: 0,0:21:51.47,0:21:54.47,Dial_JP,,0,0,0,,あと　今までそっけなくしてごめん
Dialogue: 0,0:21:57.73,0:21:58.71,Dial_JP,,0,0,0,,冬木
Dialogue: 0,0:22:01.42,0:22:02.17,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:22:08.83,0:22:10.00,Dial_JP,,0,0,0,,なしたん
Dialogue: 0,0:22:10.38,0:22:13.56,Dial_JP,,0,0,0,,いやぁ　沙友理ちゃんと仲よくなれたし
Dialogue: 0,0:22:13.56,0:22:14.89,Dial_JP,,0,0,0,,スキーも楽しかったから
Dialogue: 0,0:22:14.89,0:22:16.93,Dial_JP,,0,0,0,,最&高なんだけど
Dialogue: 0,0:22:17.57,0:22:21.23,Dial_JP,,0,0,0,,後ろの２人が仲よくなりすぎなんだよね
Dialogue: 0,0:22:21.23,0:22:22.95,Dial_JP,,0,0,0,,あ～ん　もう
Dialogue: 0,0:22:23.13,0:22:27.76,Dial_JP,,0,0,0,,２人とももっとウチのことかまちょなのに
Dialogue: 1,0:00:01.08,0:00:03.61,Dial_CH,,0,0,0,,真的超期待
Dialogue: 1,0:00:03.61,0:00:04.86,Dial_CH,,0,0,0,,今天的滑雪課
Dialogue: 1,0:00:05.06,0:00:09.74,Dial_CH,,0,0,0,,不愧是北海道 上課竟然是滑一整天雪
Dialogue: 1,0:00:09.90,0:00:12.11,Dial_CH,,0,0,0,,翼以前滑過雪嗎
Dialogue: 1,0:00:12.61,0:00:15.18,Dial_CH,,0,0,0,,一次都沒有 特別害怕
Dialogue: 1,0:00:15.75,0:00:16.55,Dial_CH,,0,0,0,,怎麼了
Dialogue: 1,0:00:16.55,0:00:18.65,Dial_CH,,0,0,0,,翼寶寶難道還怕滑雪嗎
Dialogue: 1,0:00:18.65,0:00:19.79,Dial_CH,,0,0,0,,不怕不怕
Dialogue: 1,0:00:20.70,0:00:22.35,Dial_CH,,0,0,0,,別捉弄我了 冬木同學
Dialogue: 1,0:00:23.42,0:00:26.42,Dial_CH,,0,0,0,,可捉弄你好玩啊
Dialogue: 1,0:00:26.61,0:00:30.80,Dial_CH,,0,0,0,,我從小學就開始滑雪 已經是拿手好戲了
Dialogue: 1,0:00:31.08,0:00:34.56,Dial_CH,,0,0,0,,今天就讓你見識見識我的颯爽英姿吧
Dialogue: 1,0:00:34.74,0:00:37.34,Dial_CH,,0,0,0,,刻在 身上？
Dialogue: 1,0:00:37.71,0:00:40.99,Dial_CH,,0,0,0,,不過我估計大家應該都滑得挺好的
Dialogue: 1,0:00:41.33,0:00:44.56,Dial_CH,,0,0,0,,不愧是北海道人 對雪算是瞭如指掌了
Dialogue: 1,0:00:45.16,0:00:46.96,Dial_CH,,0,0,0,,東京基本上不會下雪
Dialogue: 1,0:00:46.96,0:00:49.07,Dial_CH,,0,0,0,,就算下雪也積不起來
Dialogue: 1,0:00:54.17,0:00:57.07,Dial_CH,,0,0,0,,沙友理 期待滑雪嗎
Dialogue: 1,0:01:03.25,0:01:06.36,Dial_CH,,0,0,0,,沒事 這問題好像也沒必要問
Dialogue: 1,0:01:08.89,0:01:12.16,Dial_CH,,0,0,0,,少見啊 冬木同學平時和誰都關係挺好的
Dialogue: 1,0:01:12.97,0:01:15.43,Dial_CH,,0,0,0,,她們之間是發生過什麼嗎
Dialogue: 1,0:01:15.95,0:01:17.58,Dial_CH,,0,0,0,,冬木同學 你沒事吧
Dialogue: 1,0:01:18.84,0:01:19.75,Dial_CH,,0,0,0,,沒事
Dialogue: 1,0:01:19.75,0:01:24.39,Dial_CH,,0,0,0,,那個 其實我超想和沙友理搞好關係的
Dialogue: 1,0:01:24.39,0:01:26.77,Dial_CH,,0,0,0,,想著肯定能成為辣妹朋友來著
Dialogue: 1,0:01:27.66,0:01:29.61,Dial_CH,,0,0,0,,還以為你們吵過架呢
Dialogue: 1,0:01:29.61,0:01:31.60,Dial_CH,,0,0,0,,怎麼可能嘛
Dialogue: 1,0:01:31.60,0:01:33.42,Dial_CH,,0,0,0,,我超喜歡她
Dialogue: 1,0:01:33.89,0:01:36.91,Dial_CH,,0,0,0,,但我每次找她說話她都不搭理我
Dialogue: 1,0:01:37.14,0:01:41.24,Dial_CH,,0,0,0,,屢屢碰壁你還想著和她搞好關係 真有毅力啊
Dialogue: 1,0:01:41.24,0:01:43.67,Dial_CH,,0,0,0,,因為啊 你好好看看她
Dialogue: 1,0:01:44.10,0:01:46.09,Dial_CH,,0,0,0,,超可愛是不是
Dialogue: 1,0:01:46.09,0:01:48.50,Dial_CH,,0,0,0,,你看她那頭秀髮 還有舉止 氣場
Dialogue: 1,0:01:48.50,0:01:50.23,Dial_CH,,0,0,0,,還有那臉蛋 臉蛋 臉蛋
Dialogue: 1,0:01:50.23,0:01:51.54,Dial_CH,,0,0,0,,臉的占比太大了
Dialogue: 1,0:01:51.54,0:01:55.05,Dial_CH,,0,0,0,,黑髮清秀辣妹誰不愛啊
Dialogue: 1,0:01:57.44,0:02:00.44,Dial_CH,,0,0,0,,黑髮清秀辣妹
Dialogue: 1,0:02:00.92,0:02:03.65,Dial_CH,,0,0,0,,這兩個屬性不應該處在對立面嗎
Dialogue: 1,0:02:03.95,0:02:06.88,Dial_CH,,0,0,0,,這種完美結合竟真的存在嗎
Dialogue: 1,0:02:11.08,0:02:12.74,Dial_CH,,0,0,0,,你都看入迷了
Dialogue: 1,0:02:13.44,0:02:14.75,Dial_CH,,0,0,0,,我 我沒啊
Dialogue: 1,0:02:16.32,0:02:17.40,Dial_CH,,0,0,0,,算了
Dialogue: 1,0:02:17.64,0:02:20.04,Dial_CH,,0,0,0,,也差不多快到了 一會再聊吧
Dialogue: 1,0:02:20.04,0:02:21.64,Dial_CH,,0,0,0,,啊 冬木同學
Dialogue: 1,0:04:05.85,0:04:08.10,Dial_CH,,0,0,0,,按照熟練度由高到低
Dialogue: 1,0:04:08.42,0:04:10.30,Dial_CH,,0,0,0,,分成ABC三個班
Dialogue: 1,0:04:10.30,0:04:13.99,Dial_CH,,0,0,0,,所有人聽從各個班老師的指示行動
Dialogue: 1,0:04:13.99,0:04:15.53,Dial_CH,,0,0,0,,好
Dialogue: 1,0:04:15.92,0:04:18.92,Dial_CH,,0,0,0,,我該去哪
Dialogue: 1,0:04:19.81,0:04:22.18,Dial_CH,,0,0,0,,四季是滑雪初學者吧
Dialogue: 1,0:04:22.72,0:04:23.28,Dial_CH,,0,0,0,,是的
Dialogue: 1,0:04:23.47,0:04:28.04,Dial_CH,,0,0,0,,C班也得坐纜車從有點高度的地方往下滑
Dialogue: 1,0:04:28.37,0:04:29.44,Dial_CH,,0,0,0,,你可以嗎
Dialogue: 1,0:04:31.02,0:04:34.53,Dial_CH,,0,0,0,,可以的話我還是希望在平地先練一下走路
Dialogue: 1,0:04:34.53,0:04:35.64,Dial_CH,,0,0,0,,也是啊
Dialogue: 1,0:04:35.92,0:04:36.96,Dial_CH,,0,0,0,,那
Dialogue: 1,0:04:36.96,0:04:38.30,Dial_CH,,0,0,0,,你今天就和她一組
Dialogue: 1,0:04:38.70,0:04:41.80,Dial_CH,,0,0,0,,給你們分個初學班出來吧
Dialogue: 1,0:04:42.17,0:04:44.68,Dial_CH,,0,0,0,,秋野也是怎麼都滑不好
Dialogue: 1,0:04:45.40,0:04:48.72,Dial_CH,,0,0,0,,我是C班負責人 可能不太能顧得上你們
Dialogue: 1,0:04:48.93,0:04:50.78,Dial_CH,,0,0,0,,但會盡量三不五時來看一眼的
Dialogue: 1,0:04:54.19,0:04:56.18,Dial_CH,,0,0,0,,那我走了 記得別太亂來
Dialogue: 1,0:04:56.18,0:04:56.99,Dial_CH,,0,0,0,,好
Dialogue: 1,0:05:02.96,0:05:05.45,Dial_CH,,0,0,0,,這正是和她說話的機會
Dialogue: 1,0:05:05.70,0:05:08.33,Dial_CH,,0,0,0,,也可能成為幫她和冬木同學搭上線的契機
Dialogue: 1,0:05:11.18,0:05:12.23,Dial_CH,,0,0,0,,秋野同學
Dialogue: 1,0:05:13.07,0:05:14.34,Dial_CH,,0,0,0,,要不要一起…
Dialogue: 1,0:05:17.29,0:05:18.22,Dial_CH,,0,0,0,,耳機
Dialogue: 1,0:05:18.89,0:05:21.22,Dial_CH,,0,0,0,,都戴上耳機了
Dialogue: 1,0:05:21.22,0:05:23.51,Dial_CH,,0,0,0,,說明她並不想和我說話
Dialogue: 1,0:05:23.99,0:05:27.41,Dial_CH,,0,0,0,,雖然對不起冬木同學 現在還是先算了吧
Dialogue: 1,0:05:28.43,0:05:31.67,Dial_CH,,0,0,0,,說起來 把頭髮撩到耳後這個舉動
Dialogue: 1,0:05:32.01,0:05:33.27,Dial_CH,,0,0,0,,莫名的好
Dialogue: 1,0:05:34.09,0:05:36.54,Dial_CH,,0,0,0,,雖然不知道自己為什麼會這樣想
Dialogue: 1,0:05:52.51,0:05:56.87,Dial_CH,,0,0,0,,原來如此 左右交替變換身體重心更便於前進
Dialogue: 1,0:05:59.36,0:06:00.43,Dial_CH,,0,0,0,,秋野同學
Dialogue: 1,0:06:00.84,0:06:01.94,Dial_CH,,0,0,0,,沒事吧
Dialogue: 1,0:06:01.94,0:06:04.51,Dial_CH,,0,0,0,,我光顧著自己了沒看到你
Dialogue: 1,0:06:04.51,0:06:05.36,Dial_CH,,0,0,0,,對不起
Dialogue: 1,0:06:07.93,0:06:11.22,Dial_CH,,0,0,0,,我就不明白了 淨整這些有什麼用
Dialogue: 1,0:06:11.61,0:06:13.35,Dial_CH,,0,0,0,,翼
Dialogue: 1,0:06:23.03,0:06:24.75,Dial_CH,,0,0,0,,怎麼樣 怎麼樣
Dialogue: 1,0:06:24.75,0:06:26.28,Dial_CH,,0,0,0,,我帥不帥
Dialogue: 1,0:06:26.28,0:06:27.09,Dial_CH,,0,0,0,,好強
Dialogue: 1,0:06:28.28,0:06:29.74,Dial_CH,,0,0,0,,太帥了
Dialogue: 1,0:06:30.72,0:06:32.44,Dial_CH,,0,0,0,,我就說吧
Dialogue: 1,0:06:32.44,0:06:33.77,Dial_CH,,0,0,0,,冬木
Dialogue: 1,0:06:34.60,0:06:37.02,Dial_CH,,0,0,0,,我說沒說過別玩跳台啊
Dialogue: 1,0:06:37.50,0:06:38.25,Dial_CH,,0,0,0,,壞了
Dialogue: 1,0:06:38.76,0:06:39.95,Dial_CH,,0,0,0,,我先溜啦
Dialogue: 1,0:06:42.93,0:06:44.62,Dial_CH,,0,0,0,,太牛了
Dialogue: 1,0:06:45.38,0:06:49.08,Dial_CH,,0,0,0,,四季 你和冬木在談對象嗎
Dialogue: 1,0:06:50.26,0:06:52.29,Dial_CH,,0,0,0,,沒沒沒 沒那回事
Dialogue: 1,0:06:52.71,0:06:53.45,Dial_CH,,0,0,0,,為什麼這樣問
Dialogue: 1,0:06:53.45,0:06:56.10,Dial_CH,,0,0,0,,看你倆在大巴里聊得那麼開心
Dialogue: 1,0:06:56.47,0:06:58.50,Dial_CH,,0,0,0,,那個 那就是 其實
Dialogue: 1,0:06:58.50,0:07:00.19,Dial_CH,,0,0,0,,她就是調戲我好玩
Dialogue: 1,0:07:00.19,0:07:02.17,Dial_CH,,0,0,0,,我看可不止
Dialogue: 1,0:07:03.19,0:07:05.23,Dial_CH,,0,0,0,,開始前都警告過了
Dialogue: 1,0:07:05.88,0:07:07.09,Dial_CH,,0,0,0,,你說你要受傷了怎麼搞啊
Dialogue: 1,0:07:07.09,0:07:10.74,Dial_CH,,0,0,0,,冬木是典型的和誰都玩得開
Dialogue: 1,0:07:10.90,0:07:13.03,Dial_CH,,0,0,0,,嗓門大 跟個人來瘋一樣
Dialogue: 1,0:07:13.03,0:07:15.05,Dial_CH,,0,0,0,,人又活潑 還是個辣妹
Dialogue: 1,0:07:16.09,0:07:16.78,Dial_CH,,0,0,0,,奇怪
Dialogue: 1,0:07:17.11,0:07:19.71,Dial_CH,,0,0,0,,怎麼感覺有一股強烈的陰氣
Dialogue: 1,0:07:19.71,0:07:22.32,Dial_CH,,0,0,0,,我沒有的東西她都有
Dialogue: 1,0:07:24.12,0:07:25.34,Dial_CH,,0,0,0,,秋野同學
Dialogue: 1,0:07:25.51,0:07:27.36,Dial_CH,,0,0,0,,行了 不說了
Dialogue: 1,0:07:28.12,0:07:30.02,Dial_CH,,0,0,0,,繼續各練各的吧
Dialogue: 1,0:07:44.83,0:07:46.43,Dial_CH,,0,0,0,,要不要我陪你滑
Dialogue: 1,0:07:47.53,0:07:50.32,Dial_CH,,0,0,0,,這裡的高級滑道可難了
Dialogue: 1,0:07:50.32,0:07:51.98,Dial_CH,,0,0,0,,我給你護航吧
Dialogue: 1,0:07:52.67,0:07:53.64,Dial_CH,,0,0,0,,可以嗎
Dialogue: 1,0:07:53.86,0:07:55.20,Dial_CH,,0,0,0,,當然啦
Dialogue: 1,0:07:55.20,0:07:57.92,Dial_CH,,0,0,0,,我可是雪山熱心腸辣妹
Dialogue: 1,0:07:59.58,0:08:00.98,Dial_CH,,0,0,0,,那就拜託您了
Dialogue: 1,0:08:01.36,0:08:02.31,Dial_CH,,0,0,0,,好
Dialogue: 1,0:08:02.31,0:08:03.64,Dial_CH,,0,0,0,,出發吧
Dialogue: 1,0:08:09.72,0:08:11.64,Dial_CH,,0,0,0,,衝衝衝
Dialogue: 1,0:08:13.71,0:08:15.60,Dial_CH,,0,0,0,,哎呀 不好意思啊
Dialogue: 1,0:08:15.60,0:08:16.67,Dial_CH,,0,0,0,,秋野 四季
Dialogue: 1,0:08:16.88,0:08:18.60,Dial_CH,,0,0,0,,C班那邊太忙了
Dialogue: 1,0:08:18.60,0:08:20.44,Dial_CH,,0,0,0,,根本沒空照顧到你們
Dialogue: 1,0:08:21.42,0:08:22.71,Dial_CH,,0,0,0,,沒關係的
Dialogue: 1,0:08:23.15,0:08:25.99,Dial_CH,,0,0,0,,話說 今天的午休什麼時候開始呢
Dialogue: 1,0:08:25.99,0:08:27.58,Dial_CH,,0,0,0,,這個嘛
Dialogue: 1,0:08:28.08,0:08:31.49,Dial_CH,,0,0,0,,其實其他的學生已經在午休了
Dialogue: 1,0:08:32.87,0:08:34.91,Dial_CH,,0,0,0,,他絕對是把我們忘了
Dialogue: 1,0:08:35.70,0:08:40.50,Dial_CH,,0,0,0,,沒事 你們就現在開始休息一個午休的時間吧
Dialogue: 1,0:08:49.38,0:08:53.14,Dial_CH,,0,0,0,,就我和秋野同學兩個人多少有點尷尬
Dialogue: 1,0:08:53.14,0:08:55.32,Dial_CH,,0,0,0,,我還是去樓裡吃吧
Dialogue: 1,0:09:01.05,0:09:03.69,Dial_CH,,0,0,0,,其他人的午休都結束了啊
Dialogue: 1,0:09:08.08,0:09:10.23,Dial_CH,,0,0,0,,筷子還在包裡
Dialogue: 1,0:09:11.38,0:09:12.83,Dial_CH,,0,0,0,,唉 我真是
Dialogue: 1,0:09:12.83,0:09:14.92,Dial_CH,,0,0,0,,趕緊拿了趕緊回吧
Dialogue: 1,0:09:25.72,0:09:28.79,Dial_CH,,0,0,0,,說起來 沙友理是哪個班的來著
Dialogue: 1,0:09:35.39,0:09:36.38,Dial_CH,,0,0,0,,抱歉
Dialogue: 1,0:09:36.91,0:09:38.14,Dial_CH,,0,0,0,,糟了
Dialogue: 1,0:09:38.43,0:09:39.63,Dial_CH,,0,0,0,,她在換衣服
Dialogue: 1,0:09:39.63,0:09:42.67,Dial_CH,,0,0,0,,是以為這裡沒人了就放心了嗎
Dialogue: 1,0:09:42.91,0:09:44.26,Dial_CH,,0,0,0,,怎麼辦 怎麼辦
Dialogue: 1,0:09:44.26,0:09:45.73,Dial_CH,,0,0,0,,看到了好多不該看的
Dialogue: 1,0:09:45.73,0:09:47.87,Dial_CH,,0,0,0,,肌膚 內衣 汗
Dialogue: 1,0:09:47.87,0:09:48.93,Dial_CH,,0,0,0,,冷靜
Dialogue: 1,0:09:48.93,0:09:51.11,Dial_CH,,0,0,0,,先解釋清楚
Dialogue: 1,0:09:51.11,0:09:53.51,Dial_CH,,0,0,0,,秋野同學 真的非常抱歉
Dialogue: 1,0:09:53.51,0:09:56.47,Dial_CH,,0,0,0,,我不知道車裡是這個狀況 不是故意看到的
Dialogue: 1,0:09:56.47,0:09:59.47,Dial_CH,,0,0,0,,我絕對不會說出去 這就都給忘掉
Dialogue: 1,0:09:59.47,0:10:03.31,Dial_CH,,0,0,0,,不過就是 我回來是因為我忘了拿筷子了
Dialogue: 1,0:10:03.31,0:10:04.36,Dial_CH,,0,0,0,,所以就回來取一下
Dialogue: 1,0:10:04.82,0:10:07.48,Dial_CH,,0,0,0,,你要是不介意的話 我拿上就走
Dialogue: 1,0:10:07.72,0:10:08.87,Dial_CH,,0,0,0,,行嗎
Dialogue: 1,0:10:13.49,0:10:14.93,Dial_CH,,0,0,0,,也是
Dialogue: 1,0:10:15.26,0:10:17.16,Dial_CH,,0,0,0,,對不起 我先出去
Dialogue: 1,0:10:25.64,0:10:28.82,Dial_CH,,0,0,0,,我們聊聊吧 邊吃邊聊就行
Dialogue: 1,0:10:39.72,0:10:42.58,Dial_CH,,0,0,0,,坐下之後就在默默吃飯
Dialogue: 1,0:10:43.27,0:10:44.91,Dial_CH,,0,0,0,,她是要說什麼呢
Dialogue: 1,0:10:46.14,0:10:48.49,Dial_CH,,0,0,0,,不會是什麼要封我口之類的吧
Dialogue: 1,0:10:49.20,0:10:51.43,Dial_CH,,0,0,0,,雖然和秋野同學不太熟
Dialogue: 1,0:10:51.43,0:10:52.76,Dial_CH,,0,0,0,,但我稍微有點害怕啊
Dialogue: 1,0:10:59.88,0:11:01.50,Dial_CH,,0,0,0,,我一口氣說完 你聽好
Dialogue: 1,0:11:01.93,0:11:03.24,Dial_CH,,0,0,0,,好… 好的
Dialogue: 1,0:11:06.04,0:11:08.45,Dial_CH,,0,0,0,,我其實很愛出汗
Dialogue: 1,0:11:09.29,0:11:11.65,Dial_CH,,0,0,0,,從小就因為愛出汗這事覺得特別害羞
Dialogue: 1,0:11:11.65,0:11:13.53,Dial_CH,,0,0,0,,所以一般都躲著不運動
Dialogue: 1,0:11:13.98,0:11:16.89,Dial_CH,,0,0,0,,但是 一直躲著不就和同學有差距了嘛
Dialogue: 1,0:11:17.28,0:11:20.08,Dial_CH,,0,0,0,,結果就是我不會的東西越來越多
Dialogue: 1,0:11:20.44,0:11:22.53,Dial_CH,,0,0,0,,所以對自己越來越沒信心
Dialogue: 1,0:11:22.53,0:11:25.19,Dial_CH,,0,0,0,,然後才意識到自己已經在刻意躲著身邊的人了
Dialogue: 1,0:11:25.55,0:11:27.46,Dial_CH,,0,0,0,,雖然三不五時也覺得這樣不行
Dialogue: 1,0:11:28.03,0:11:30.73,Dial_CH,,0,0,0,,便像剛剛那樣認真練滑雪
Dialogue: 1,0:11:31.21,0:11:33.88,Dial_CH,,0,0,0,,結果擦擦汗還被人看到了
Dialogue: 1,0:11:34.12,0:11:35.09,Dial_CH,,0,0,0,,煩死了
Dialogue: 1,0:11:35.83,0:11:38.41,Dial_CH,,0,0,0,,我真心認錯
Dialogue: 1,0:11:38.41,0:11:41.56,Dial_CH,,0,0,0,,不 是我太沒防備了
Dialogue: 1,0:11:42.40,0:11:44.87,Dial_CH,,0,0,0,,可是為什麼要和我說呢
Dialogue: 1,0:11:45.17,0:11:48.15,Dial_CH,,0,0,0,,我剛剛轉學進來 我們完全沒有接觸
Dialogue: 1,0:11:48.63,0:11:50.18,Dial_CH,,0,0,0,,你就和我說了這麼重要的事
Dialogue: 1,0:11:51.35,0:11:53.54,Dial_CH,,0,0,0,,這樣才好呢
Dialogue: 1,0:11:54.17,0:11:56.48,Dial_CH,,0,0,0,,你完全不認識過去的我
Dialogue: 1,0:11:56.48,0:11:58.59,Dial_CH,,0,0,0,,反而更好開口吧
Dialogue: 1,0:11:59.93,0:12:00.91,Dial_CH,,0,0,0,,原來如此
Dialogue: 1,0:12:01.22,0:12:04.12,Dial_CH,,0,0,0,,而且我們不是境遇相似嘛
Dialogue: 1,0:12:05.00,0:12:07.87,Dial_CH,,0,0,0,,我們座位能安排到一起
Dialogue: 1,0:12:07.87,0:12:10.11,Dial_CH,,0,0,0,,也是照顧到我沒朋友 你也差不多
Dialogue: 1,0:12:10.85,0:12:12.55,Dial_CH,,0,0,0,,你這樣說搞得我心情複雜了
Dialogue: 1,0:12:12.77,0:12:14.38,Dial_CH,,0,0,0,,不過還好我轉學進來了
Dialogue: 1,0:12:15.06,0:12:17.93,Dial_CH,,0,0,0,,以及 你這人正經得有點傻了
Dialogue: 1,0:12:17.93,0:12:18.51,Dial_CH,,0,0,0,,傻…
Dialogue: 1,0:12:18.88,0:12:20.30,Dial_CH,,0,0,0,,是嗎
Dialogue: 1,0:12:20.78,0:12:24.80,Dial_CH,,0,0,0,,意思是你不會把我的事拿出去跟別人胡說
Dialogue: 1,0:12:28.72,0:12:32.07,Dial_CH,,0,0,0,,剛才的聲音 是秋野同學包裡的
Dialogue: 1,0:12:32.39,0:12:34.00,Dial_CH,,0,0,0,,手機消息嗎
Dialogue: 1,0:12:34.67,0:12:36.32,Dial_CH,,0,0,0,,她好像很在意
Dialogue: 1,0:12:39.35,0:12:41.65,Dial_CH,,0,0,0,,沒事 你看吧
Dialogue: 1,0:12:42.45,0:12:43.68,Dial_CH,,0,0,0,,不過 可是…
Dialogue: 1,0:12:45.35,0:12:46.72,Dial_CH,,0,0,0,,算了
Dialogue: 1,0:12:47.00,0:12:49.42,Dial_CH,,0,0,0,,都這份上了 也沒必要再藏了
Dialogue: 1,0:12:52.76,0:12:54.47,Dial_CH,,0,0,0,,果然是更新通知
Dialogue: 1,0:12:56.53,0:12:58.36,Dial_CH,,0,0,0,,頭髮撩到耳後
Dialogue: 1,0:12:59.55,0:13:01.20,Dial_CH,,0,0,0,,這是什麼 平板嗎
Dialogue: 1,0:13:01.52,0:13:06.16,Dial_CH,,0,0,0,,我最近又回坑集英堂witch的「SisPlu SP」了
Dialogue: 1,0:13:06.52,0:13:07.85,Dial_CH,,0,0,0,,什麼西斯什麼普拉？
Dialogue: 1,0:13:08.93,0:13:10.93,Dial_CH,,0,0,0,,就是「Crash Sisters Plus」啊
Dialogue: 1,0:13:10.93,0:13:13.47,Dial_CH,,0,0,0,,有很多超人氣角色的對戰遊戲
Dialogue: 1,0:13:13.47,0:13:14.57,Dial_CH,,0,0,0,,這應該知道的吧
Dialogue: 1,0:13:14.57,0:13:16.79,Dial_CH,,0,0,0,,我不知道啊
Dialogue: 1,0:13:17.10,0:13:19.15,Dial_CH,,0,0,0,,我不太玩遊戲
Dialogue: 1,0:13:21.30,0:13:22.56,Dial_CH,,0,0,0,,你玩一下試試
Dialogue: 1,0:13:22.78,0:13:24.60,Dial_CH,,0,0,0,,不是不是 我不會啊
Dialogue: 1,0:13:24.90,0:13:26.89,Dial_CH,,0,0,0,,要按哪 現在按什麼
Dialogue: 1,0:13:27.09,0:13:29.00,Dial_CH,,0,0,0,,你先撥動搖杆
Dialogue: 1,0:13:29.43,0:13:30.08,Dial_CH,,0,0,0,,這個？
Dialogue: 1,0:13:33.74,0:13:34.54,Dial_CH,,0,0,0,,輸了
Dialogue: 1,0:13:36.16,0:13:37.83,Dial_CH,,0,0,0,,這可太樂了
Dialogue: 1,0:13:37.83,0:13:39.30,Dial_CH,,0,0,0,,原來你真的沒玩過
Dialogue: 1,0:13:39.50,0:13:41.75,Dial_CH,,0,0,0,,我都不知道怎麼辦
Dialogue: 1,0:13:41.75,0:13:44.98,Dial_CH,,0,0,0,,所以說先控制好搖杆
Dialogue: 1,0:13:44.98,0:13:48.35,Dial_CH,,0,0,0,,讓你的角色動起來 接近敵人 再攻擊
Dialogue: 1,0:13:48.68,0:13:51.06,Dial_CH,,0,0,0,,攻擊是這兩個鍵
Dialogue: 1,0:13:51.31,0:13:54.73,Dial_CH,,0,0,0,,然後可以格擋 或者跳躍躲開敵方攻擊
Dialogue: 1,0:13:57.27,0:13:57.78,Dial_CH,,0,0,0,,抱歉
Dialogue: 1,0:14:02.19,0:14:04.62,Dial_CH,,0,0,0,,突然講這麼多是挺煩人的吧
Dialogue: 1,0:14:04.62,0:14:06.45,Dial_CH,,0,0,0,,沒有沒有 怎麼會呢
Dialogue: 1,0:14:07.34,0:14:10.65,Dial_CH,,0,0,0,,我其實 為了和他人拉近距離
Dialogue: 1,0:14:10.65,0:14:12.70,Dial_CH,,0,0,0,,已經在打扮上下了功夫了
Dialogue: 1,0:14:13.16,0:14:16.13,Dial_CH,,0,0,0,,但我本來性格就像這樣
Dialogue: 1,0:14:16.13,0:14:18.20,Dial_CH,,0,0,0,,總會搞得別人尷尬 然後避開我
Dialogue: 1,0:14:19.54,0:14:23.58,Dial_CH,,0,0,0,,結果每次我都選擇逃避 躲進唯一擅長的遊戲世界
Dialogue: 1,0:14:24.48,0:14:26.13,Dial_CH,,0,0,0,,沒救了
Dialogue: 1,0:14:26.13,0:14:27.50,Dial_CH,,0,0,0,,沒有這回事
Dialogue: 1,0:14:28.04,0:14:30.25,Dial_CH,,0,0,0,,我能看出你的努力 很了不起
Dialogue: 1,0:14:30.48,0:14:32.81,Dial_CH,,0,0,0,,我覺得秋野同學的內在和外在
Dialogue: 1,0:14:32.81,0:14:34.90,Dial_CH,,0,0,0,,都很有個性 很有魅力
Dialogue: 1,0:14:35.13,0:14:37.48,Dial_CH,,0,0,0,,能了解你的這些真的很開心
Dialogue: 1,0:14:38.52,0:14:40.04,Dial_CH,,0,0,0,,謝謝你告訴我
Dialogue: 1,0:14:44.94,0:14:47.28,Dial_CH,,0,0,0,,虧你說得出這麼害羞的話
Dialogue: 1,0:14:47.28,0:14:49.91,Dial_CH,,0,0,0,,而且遊戲打得好不是很棒嗎
Dialogue: 1,0:14:50.30,0:14:53.12,Dial_CH,,0,0,0,,可以的話多教教我打遊戲吧
Dialogue: 1,0:14:53.38,0:14:55.63,Dial_CH,,0,0,0,,我想和你一起玩遊戲
Dialogue: 1,0:15:03.73,0:15:05.81,Dial_CH,,0,0,0,,拿 拿你沒轍
Dialogue: 1,0:15:06.06,0:15:08.39,Dial_CH,,0,0,0,,教你可以 但你要叫我師父
Dialogue: 1,0:15:08.84,0:15:10.34,Dial_CH,,0,0,0,,好 師父
Dialogue: 1,0:15:18.19,0:15:21.29,Dial_CH,,0,0,0,,這是什麼操作 好強
Dialogue: 1,0:15:21.59,0:15:23.00,Dial_CH,,0,0,0,,怎麼做到的 師父
Dialogue: 1,0:15:23.72,0:15:26.36,Dial_CH,,0,0,0,,這招本身不算難
Dialogue: 1,0:15:26.94,0:15:28.99,Dial_CH,,0,0,0,,你有那個心就能學會了
Dialogue: 1,0:15:29.53,0:15:32.26,Dial_CH,,0,0,0,,「有那個心就能學會了」
Dialogue: 1,0:15:32.81,0:15:33.97,Dial_CH,,0,0,0,,好
Dialogue: 1,0:15:45.29,0:15:46.36,Dial_CH,,0,0,0,,贏了
Dialogue: 1,0:15:46.57,0:15:48.18,Dial_CH,,0,0,0,,我通關了 師父
Dialogue: 1,0:15:48.18,0:15:51.01,Dial_CH,,0,0,0,,這才是難度最低的人機局
Dialogue: 1,0:15:51.33,0:15:52.88,Dial_CH,,0,0,0,,根本算不上打通
Dialogue: 1,0:15:53.67,0:15:55.48,Dial_CH,,0,0,0,,我感覺已經夠強了
Dialogue: 1,0:15:55.64,0:15:56.44,Dial_CH,,0,0,0,,話說
Dialogue: 1,0:15:56.44,0:15:58.15,Dial_CH,,0,0,0,,秋野同學 我剛注意到
Dialogue: 1,0:15:58.15,0:15:59.85,Dial_CH,,0,0,0,,午休時間快過了 得趕緊走了
Dialogue: 1,0:16:00.14,0:16:02.18,Dial_CH,,0,0,0,,真的嗎 等我一下
Dialogue: 1,0:16:03.58,0:16:06.88,Dial_CH,,0,0,0,,老師也告訴我們不要太勉強
Dialogue: 1,0:16:07.40,0:16:09.63,Dial_CH,,0,0,0,,下午就隨便混混吧
Dialogue: 1,0:16:11.77,0:16:12.83,Dial_CH,,0,0,0,,秋野同學
Dialogue: 1,0:16:13.43,0:16:15.33,Dial_CH,,0,0,0,,我一起去上面滑下來試試吧
Dialogue: 1,0:16:16.70,0:16:18.02,Dial_CH,,0,0,0,,和遊戲一個道理
Dialogue: 1,0:16:18.45,0:16:20.63,Dial_CH,,0,0,0,,有那個心說不定就能學會了
Dialogue: 1,0:16:24.61,0:16:28.51,Dial_CH,,0,0,0,,好 A班的人剩餘時間可以自由滑了
Dialogue: 1,0:16:28.70,0:16:29.86,Dial_CH,,0,0,0,,好
Dialogue: 1,0:16:31.24,0:16:34.37,Dial_CH,,0,0,0,,那我去哪滑呢
Dialogue: 1,0:16:36.91,0:16:38.88,Dial_CH,,0,0,0,,那兩個人難道是
Dialogue: 1,0:16:39.36,0:16:41.61,Dial_CH,,0,0,0,,翼和沙友理
Dialogue: 1,0:16:42.63,0:16:44.74,Dial_CH,,0,0,0,,這太高了 秋野同學
Dialogue: 1,0:16:44.74,0:16:46.20,Dial_CH,,0,0,0,,我的腳一直在晃
Dialogue: 1,0:16:46.20,0:16:47.78,Dial_CH,,0,0,0,,這真的安全嗎
Dialogue: 1,0:16:51.04,0:16:54.67,Dial_CH,,0,0,0,,從這裡看下面好寬闊啊 一大片滑雪場
Dialogue: 1,0:16:56.52,0:16:58.00,Dial_CH,,0,0,0,,四季
Dialogue: 1,0:16:59.03,0:17:00.81,Dial_CH,,0,0,0,,你為什麼要選擇滑呢
Dialogue: 1,0:17:01.52,0:17:04.71,Dial_CH,,0,0,0,,老師都說了不用非得嘗試的
Dialogue: 1,0:17:10.17,0:17:14.51,Dial_CH,,0,0,0,,因為我早就想要好了 要在北海道挑戰各式各樣的事情
Dialogue: 1,0:17:15.00,0:17:16.06,Dial_CH,,0,0,0,,挑戰？
Dialogue: 1,0:17:16.88,0:17:20.40,Dial_CH,,0,0,0,,雖然我們現在要去的只是最簡單的滑道
Dialogue: 1,0:17:20.61,0:17:24.35,Dial_CH,,0,0,0,,而且其實我午休前也找老師要了點竅門
Dialogue: 1,0:17:26.84,0:17:28.25,Dial_CH,,0,0,0,,你真厲害
Dialogue: 1,0:17:29.00,0:17:30.45,Dial_CH,,0,0,0,,和我完全不一樣
Dialogue: 1,0:17:30.86,0:17:31.84,Dial_CH,,0,0,0,,話是這麼說
Dialogue: 1,0:17:32.08,0:17:35.16,Dial_CH,,0,0,0,,其實是冬木同學讓我有了這種想法
Dialogue: 1,0:17:36.36,0:17:37.24,Dial_CH,,0,0,0,,冬木
Dialogue: 1,0:17:37.24,0:17:41.00,Dial_CH,,0,0,0,,她是我來這以後交的第一個朋友
Dialogue: 1,0:17:41.59,0:17:43.69,Dial_CH,,0,0,0,,給我分享了各種好吃的東西
Dialogue: 1,0:17:43.69,0:17:46.21,Dial_CH,,0,0,0,,還帶我去各種地方
Dialogue: 1,0:17:47.41,0:17:49.56,Dial_CH,,0,0,0,,今天她滑雪也厲害
Dialogue: 1,0:17:50.14,0:17:53.80,Dial_CH,,0,0,0,,看得出來 你很喜歡冬木
Dialogue: 1,0:17:54.80,0:17:55.64,Dial_CH,,0,0,0,,不不不
Dialogue: 1,0:17:55.64,0:17:57.07,Dial_CH,,0,0,0,,也沒有吧
Dialogue: 1,0:17:57.07,0:17:59.98,Dial_CH,,0,0,0,,喜… 我們就是普通朋友
Dialogue: 1,0:18:00.22,0:18:03.07,Dial_CH,,0,0,0,,反應這麼大 反而感覺是真的了
Dialogue: 1,0:18:04.78,0:18:06.55,Dial_CH,,0,0,0,,畢竟冬木是個好女孩
Dialogue: 1,0:18:07.56,0:18:09.37,Dial_CH,,0,0,0,,大家都很喜歡她
Dialogue: 1,0:18:10.12,0:18:12.52,Dial_CH,,0,0,0,,她甚至都願意找我這種人說話
Dialogue: 1,0:18:13.01,0:18:15.63,Dial_CH,,0,0,0,,不過像我這種人
Dialogue: 1,0:18:15.63,0:18:18.58,Dial_CH,,0,0,0,,總感覺對方不懷好意
Dialogue: 1,0:18:19.00,0:18:21.67,Dial_CH,,0,0,0,,就 不知道該怎麼回應對方
Dialogue: 1,0:18:23.84,0:18:25.01,Dial_CH,,0,0,0,,但冬木同學她…
Dialogue: 1,0:18:25.01,0:18:26.23,Dial_CH,,0,0,0,,快到了 準備下去吧
Dialogue: 1,0:18:40.37,0:18:42.62,Dial_CH,,0,0,0,,秋野同學 我有件事想拜託你
Dialogue: 1,0:18:43.56,0:18:46.51,Dial_CH,,0,0,0,,如果我能一次不倒滑到下面的話
Dialogue: 1,0:18:46.92,0:18:49.78,Dial_CH,,0,0,0,,希望你能別無視冬木同學
Dialogue: 1,0:18:50.33,0:18:52.38,Dial_CH,,0,0,0,,我也不是想無視她
Dialogue: 1,0:18:52.38,0:18:53.38,Dial_CH,,0,0,0,,我覺得她
Dialogue: 1,0:18:53.99,0:18:57.03,Dial_CH,,0,0,0,,是真的想和你成為好朋友的
Dialogue: 1,0:18:57.62,0:18:59.40,Dial_CH,,0,0,0,,絕沒有什麼惡意
Dialogue: 1,0:19:01.55,0:19:04.17,Dial_CH,,0,0,0,,也不知道你為什麼能為了別人這麼努力
Dialogue: 1,0:19:04.17,0:19:06.17,Dial_CH,,0,0,0,,這不只是為了她
Dialogue: 1,0:19:07.82,0:19:10.60,Dial_CH,,0,0,0,,我也想和你搞好關係
Dialogue: 1,0:19:13.12,0:19:15.68,Dial_CH,,0,0,0,,也… 也不是不行 但是有條件
Dialogue: 1,0:19:17.19,0:19:19.09,Dial_CH,,0,0,0,,你別自己下去了把我丟在後面
Dialogue: 1,0:19:21.70,0:19:24.05,Dial_CH,,0,0,0,,當然了 一起滑下去吧
Dialogue: 1,0:19:37.50,0:19:39.96,Dial_CH,,0,0,0,,老師教的慢慢滑的竅門
Dialogue: 1,0:19:40.40,0:19:42.49,Dial_CH,,0,0,0,,就是要把重心放到身前
Dialogue: 1,0:19:42.78,0:19:43.94,Dial_CH,,0,0,0,,腳成內八字
Dialogue: 1,0:19:44.74,0:19:46.99,Dial_CH,,0,0,0,,走S型路線向下滑去
Dialogue: 1,0:19:49.56,0:19:51.63,Dial_CH,,0,0,0,,我會滑了
Dialogue: 1,0:19:57.81,0:19:59.33,Dial_CH,,0,0,0,,就快到了
Dialogue: 1,0:19:59.68,0:20:01.35,Dial_CH,,0,0,0,,不到最後不能鬆懈
Dialogue: 1,0:20:01.84,0:20:04.18,Dial_CH,,0,0,0,,內八剎車
Dialogue: 1,0:20:08.22,0:20:10.01,Dial_CH,,0,0,0,,停 停下來了
Dialogue: 1,0:20:10.80,0:20:12.39,Dial_CH,,0,0,0,,太好了 我會滑雪了
Dialogue: 1,0:20:12.39,0:20:14.44,Dial_CH,,0,0,0,,四季
Dialogue: 1,0:20:14.44,0:20:16.86,Dial_CH,,0,0,0,,怎麼停下來啊
Dialogue: 1,0:20:17.65,0:20:18.58,Dial_CH,,0,0,0,,糟了
Dialogue: 1,0:20:18.58,0:20:20.63,Dial_CH,,0,0,0,,忘記教她怎麼剎車了
Dialogue: 1,0:20:23.03,0:20:24.53,Dial_CH,,0,0,0,,秋野同學
Dialogue: 1,0:20:24.75,0:20:26.37,Dial_CH,,0,0,0,,內八
Dialogue: 1,0:20:26.37,0:20:28.07,Dial_CH,,0,0,0,,估計是聽不到
Dialogue: 1,0:20:29.44,0:20:31.94,Dial_CH,,0,0,0,,只能我接住她了
Dialogue: 1,0:20:32.93,0:20:34.20,Dial_CH,,0,0,0,,沙友理
Dialogue: 1,0:20:34.71,0:20:37.66,Dial_CH,,0,0,0,,雙腳併攏 用任意一邊屁股瓣著地
Dialogue: 1,0:20:37.66,0:20:40.40,Dial_CH,,0,0,0,,就能安全地停下了 摔了也沒那麼痛
Dialogue: 1,0:20:42.24,0:20:43.44,Dial_CH,,0,0,0,,沒事
Dialogue: 1,0:20:43.44,0:20:45.85,Dial_CH,,0,0,0,,有咱這個雪山熱心腸辣妹看著呢
Dialogue: 1,0:20:47.25,0:20:49.61,Dial_CH,,0,0,0,,給你露一手 你瞧好了
Dialogue: 1,0:20:58.70,0:21:00.75,Dial_CH,,0,0,0,,沙友理 還好嗎
Dialogue: 1,0:21:00.75,0:21:04.05,Dial_CH,,0,0,0,,沒事 真的一點都不痛
Dialogue: 1,0:21:05.01,0:21:06.55,Dial_CH,,0,0,0,,秋野同學
Dialogue: 1,0:21:06.55,0:21:08.34,Dial_CH,,0,0,0,,冬木同學
Dialogue: 1,0:21:11.82,0:21:13.60,Dial_CH,,0,0,0,,你們倆沒事吧
Dialogue: 1,0:21:13.60,0:21:15.21,Dial_CH,,0,0,0,,沒事沒事
Dialogue: 1,0:21:15.71,0:21:18.09,Dial_CH,,0,0,0,,幸好
Dialogue: 1,0:21:18.09,0:21:20.91,Dial_CH,,0,0,0,,秋野 四季 搞什麼呢
Dialogue: 1,0:21:21.45,0:21:22.43,Dial_CH,,0,0,0,,老師叫我們了
Dialogue: 1,0:21:22.74,0:21:25.31,Dial_CH,,0,0,0,,誰讓你們自己瞎滑了
Dialogue: 1,0:21:25.57,0:21:26.95,Dial_CH,,0,0,0,,我去去就回
Dialogue: 1,0:21:26.95,0:21:27.77,Dial_CH,,0,0,0,,我也
Dialogue: 1,0:21:28.20,0:21:31.07,Dial_CH,,0,0,0,,不用 是我拉著你去滑的
Dialogue: 1,0:21:31.35,0:21:34.12,Dial_CH,,0,0,0,,甚至差點害你受傷了 對不起
Dialogue: 1,0:21:34.12,0:21:36.30,Dial_CH,,0,0,0,,這鍋我全背了 讓老師訓一頓
Dialogue: 1,0:21:37.21,0:21:40.66,Dial_CH,,0,0,0,,老師 對不起
Dialogue: 1,0:21:40.66,0:21:42.64,Dial_CH,,0,0,0,,認錯認得超誠懇
Dialogue: 1,0:21:42.64,0:21:43.72,Dial_CH,,0,0,0,,樂死我了
Dialogue: 1,0:21:49.18,0:21:50.52,Dial_CH,,0,0,0,,謝謝你
Dialogue: 1,0:21:51.47,0:21:54.47,Dial_CH,,0,0,0,,還有 以前總是愛答不理的 對不起
Dialogue: 1,0:21:57.73,0:21:58.71,Dial_CH,,0,0,0,,冬木
Dialogue: 1,0:22:01.42,0:22:02.17,Dial_CH,,0,0,0,,嗯
Dialogue: 1,0:22:08.83,0:22:10.00,Dial_CH,,0,0,0,,你怎麼了
Dialogue: 1,0:22:10.38,0:22:13.56,Dial_CH,,0,0,0,,沒 和沙友理關係變好了
Dialogue: 1,0:22:13.56,0:22:14.89,Dial_CH,,0,0,0,,還滑了一天雪
Dialogue: 1,0:22:14.89,0:22:16.93,Dial_CH,,0,0,0,,是挺開心的
Dialogue: 1,0:22:17.57,0:22:21.23,Dial_CH,,0,0,0,,可背後這兩個人關係也好得有點太超過了吧
Dialogue: 1,0:22:21.23,0:22:22.95,Dial_CH,,0,0,0,,哇 受不了了
Dialogue: 1,0:22:23.13,0:22:27.76,Dial_CH,,0,0,0,,你倆能不能多和我互動一下啊
Dialogue: 2,0:02:29.13,0:02:32.88,OP_JP,,0,0,0,,{\fad(120,120)}君の笑顔はまるで太陽
Dialogue: 2,0:02:32.88,0:02:36.14,OP_JP,,0,0,0,,{\fad(120,120)}氷点下の街も溶けてく
Dialogue: 2,0:02:36.14,0:02:38.64,OP_JP,,0,0,0,,{\fad(120,120)}もうどうにも止まらない
Dialogue: 2,0:02:38.64,0:02:40.22,OP_JP,,0,0,0,,{\fad(120,120)}なまらめんこいギャル
