Dialogue: 0,0:02:10.69,0:02:15.24,Title_CHT,,0,0,0,,{\fad(300,270)\blur5\pos(832,485)\3c&HC576D2&}第5話\N超苦又超甜
Dialogue: 0,0:00:00.97,0:00:05.74,Dial_JP,,0,0,0,,太陽みたいな　君の笑顔を
Dialogue: 0,0:00:05.74,0:00:10.84,Dial_JP,,0,0,0,,探しに行くよ
Dialogue: 0,0:00:10.84,0:00:15.20,Dial_JP,,0,0,0,,揺れながらひまわり
Dialogue: 0,0:00:15.37,0:00:20.00,Dial_JP,,0,0,0,,隠しきれない思いを
Dialogue: 0,0:00:20.45,0:00:22.57,Dial_JP,,0,0,0,,大丈夫
Dialogue: 0,0:00:22.57,0:00:27.67,Dial_JP,,0,0,0,,等身大の勇気でいいから
Dialogue: 0,0:00:27.67,0:00:32.51,Dial_JP,,0,0,0,,伝えよう
Dialogue: 0,0:00:33.35,0:00:35.38,Dial_JP,,0,0,0,,大好きだよ
Dialogue: 0,0:02:12.32,0:02:13.49,Dial_JP,,0,500,0,,ども
Dialogue: 0,0:02:16.51,0:02:18.67,Dial_JP,,0,0,0,,冬木さん　歌うまいね
Dialogue: 0,0:02:18.67,0:02:21.24,Dial_JP,,0,0,0,,あぁ　パリピのオーラがすげぇ
Dialogue: 0,0:02:21.65,0:02:25.67,Dial_JP,,0,0,0,,ふゆみな　この曲　カラオケ来たっけいつも歌うよね
Dialogue: 0,0:02:25.67,0:02:28.45,Dial_JP,,0,0,0,,うん　この曲　大好きなんだぁ
Dialogue: 0,0:02:28.45,0:02:30.29,Dial_JP,,0,0,0,,聴くと元気出るじゃん
Dialogue: 0,0:02:31.74,0:02:33.11,Dial_JP,,0,0,0,,そういえばさ
Dialogue: 0,0:02:34.28,0:02:35.69,Dial_JP,,0,0,0,,ごめん　なに
Dialogue: 0,0:02:35.69,0:02:39.27,Dial_JP,,0,0,0,,いや　四季はカラオケとかよく来たりするのか
Dialogue: 0,0:02:39.27,0:02:43.23,Dial_JP,,0,0,0,,ううん　俺は家族と数回しか行ったことないんだ
Dialogue: 0,0:02:43.23,0:02:45.83,Dial_JP,,0,0,0,,だから今日は冬木さんに誘ってもらったけど
Dialogue: 0,0:02:45.83,0:02:47.23,Dial_JP,,0,0,0,,結構緊張してる
Dialogue: 0,0:02:47.48,0:02:48.55,Dial_JP,,0,0,0,,秋野さんは
Dialogue: 0,0:02:50.67,0:02:53.16,Dial_JP,,0,0,0,,まぁね　一人でだけど
Dialogue: 0,0:02:55.70,0:02:58.25,Dial_JP,,0,0,0,,ヒ…　ヒトカラってやつだよね
Dialogue: 0,0:02:58.78,0:03:00.39,Dial_JP,,0,0,0,,楽しみ方は人それぞれだし
Dialogue: 0,0:03:00.39,0:03:02.00,Dial_JP,,0,0,0,,すごくいいと思う
Dialogue: 0,0:03:02.00,0:03:05.46,Dial_JP,,0,0,0,,四季　わかりやすさがあだになってる
Dialogue: 0,0:03:05.79,0:03:08.18,Dial_JP,,0,0,0,,ほら　四季くんも次曲入れなよぉ
Dialogue: 0,0:03:09.24,0:03:10.58,Dial_JP,,700,0,0,,ほら　これとか
Dialogue: 0,0:03:08.18,0:03:10.58,Dial_JP,,0,600,0,,秋野さんは　何歌う
Dialogue: 0,0:03:10.58,0:03:11.83,Dial_JP,,700,0,0,,え　えーと
Dialogue: 0,0:03:12.32,0:03:14.92,Dial_JP,,0,0,0,,私　メジャーな曲はあんまり
Dialogue: 0,0:03:17.98,0:03:20.66,Dial_JP,,0,0,0,,うちも一緒に曲探す
Dialogue: 0,0:03:22.09,0:03:23.87,Dial_JP,,0,0,0,,ふゆみなは今歌ったべ
Dialogue: 0,0:03:23.87,0:03:27.59,Dial_JP,,0,0,0,,翼とさゆりんの歌う曲一緒に探すだけだも～ん
Dialogue: 0,0:03:27.81,0:03:29.15,Dial_JP,,0,0,0,,２人ともいいよね
Dialogue: 0,0:03:30.82,0:03:31.64,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:03:31.64,0:03:33.21,Dial_JP,,0,800,0,,グッジョブ　冬木
Dialogue: 0,0:03:31.64,0:03:33.21,Dial_JP,,800,0,0,,グッジョブ　冬木さん
Dialogue: 0,0:03:33.45,0:03:35.07,Dial_JP,,0,0,0,,ふゆみな　順番
Dialogue: 0,0:03:38.08,0:03:39.45,Dial_JP,,0,0,0,,一緒に歌お
Dialogue: 0,0:03:47.04,0:03:48.95,Dial_JP,,0,0,0,,もうすぐ期末テストか
Dialogue: 0,0:03:49.15,0:03:51.88,Dial_JP,,0,0,0,,マジ今回範囲の広さ　エグすぎ
Dialogue: 0,0:03:52.29,0:03:53.33,Dial_JP,,0,0,0,,ねぇ　四季くん
Dialogue: 0,0:03:54.75,0:03:55.63,Dial_JP,,0,0,0,,そうだね
Dialogue: 0,0:03:55.63,0:03:58.53,Dial_JP,,0,0,0,,なぁ　今度みんなで勉強会やろうぜ
Dialogue: 0,0:03:58.90,0:04:00.60,Dial_JP,,0,0,0,,いいね　やろうぜ
Dialogue: 0,0:04:00.77,0:04:03.16,Dial_JP,,0,0,0,,秋野さんのネイル　かわいい
Dialogue: 0,0:04:03.16,0:04:04.71,Dial_JP,,0,0,0,,あ　ありがと
Dialogue: 0,0:04:04.71,0:04:06.27,Dial_JP,,0,0,0,,気に入ってるんだ　これ
Dialogue: 0,0:04:12.41,0:04:16.24,Dial_JP,,0,0,0,,そういえばさ　もうすぐバレンタインだよねぇ
Dialogue: 0,0:04:19.32,0:04:22.24,Dial_JP,,0,0,0,,いや　俺　チョコとかまったく興味ないわ
Dialogue: 0,0:04:22.24,0:04:23.74,Dial_JP,,0,0,0,,そっ　それな
Dialogue: 0,0:04:23.95,0:04:26.03,Dial_JP,,0,0,0,,あえて棒読みにすんなし
Dialogue: 0,0:04:26.03,0:04:28.37,Dial_JP,,0,0,0,,義理チョコくらいならあげてもいいよぉ
Dialogue: 0,0:04:28.37,0:04:30.88,Dial_JP,,0,0,0,,マジで　言ってみるもんだわ
Dialogue: 0,0:04:30.88,0:04:31.88,Dial_JP,,0,0,0,,しゃっ
Dialogue: 0,0:04:32.77,0:04:34.80,Dial_JP,,0,0,0,,バレンタインかぁ
Dialogue: 0,0:04:35.95,0:04:39.29,Dial_JP,,0,0,0,,冬木さんも　誰かにあげたりするのかな
Dialogue: 0,0:04:39.84,0:04:43.26,Dial_JP,,0,0,0,,ふゆみなぁ　俺にチョコくれよぉ
Dialogue: 0,0:04:44.42,0:04:45.47,Dial_JP,,0,0,0,,いいよぉ
Dialogue: 0,0:04:47.43,0:04:50.34,Dial_JP,,0,0,0,,今年もなまらチョコ作るからね
Dialogue: 0,0:04:50.34,0:04:52.80,Dial_JP,,0,0,0,,去年は何個作ったんだっけ
Dialogue: 0,0:04:53.83,0:04:55.27,Dial_JP,,0,0,0,,60個くらい
Dialogue: 0,0:04:55.27,0:04:58.02,Dial_JP,,0,0,0,,給食みたいに配ってたもんね
Dialogue: 0,0:04:59.15,0:05:00.36,Dial_JP,,0,0,0,,そっか
Dialogue: 0,0:05:00.66,0:05:03.43,Dial_JP,,0,0,0,,冬木さんはみんなに配ってるのか
Dialogue: 0,0:05:03.43,0:05:06.80,Dial_JP,,0,0,0,,あれ　なんで俺　安心して
Dialogue: 0,0:05:08.80,0:05:11.29,Dial_JP,,0,0,0,,秋野さんはチョコ作ったりするの
Dialogue: 0,0:05:12.13,0:05:16.13,Dial_JP,,0,0,0,,いや　チョコにお金かけるくらいなら　趣味に回す
Dialogue: 0,0:05:16.13,0:05:17.20,Dial_JP,,0,0,0,,ウケる
Dialogue: 0,0:05:17.43,0:05:20.23,Dial_JP,,0,0,0,,秋野さん　きっぱりしててカッコいいんだけど
Dialogue: 0,0:05:21.43,0:05:23.21,Dial_JP,,0,0,0,,秋野さんらしいな
Dialogue: 0,0:05:23.21,0:05:26.19,Dial_JP,,0,0,0,,四季くんは　東京にいたころチョコもらってた
Dialogue: 0,0:05:26.47,0:05:28.25,Dial_JP,,0,0,0,,家族からしかないよ
Dialogue: 0,0:05:28.25,0:05:29.81,Dial_JP,,0,0,0,,よくあるやつ
Dialogue: 0,0:05:29.81,0:05:31.97,Dial_JP,,0,0,0,,それもうカウントしないやつっしょ
Dialogue: 0,0:05:31.97,0:05:33.81,Dial_JP,,0,0,0,,四季くん　そっち側か
Dialogue: 0,0:05:33.81,0:05:35.19,Dial_JP,,0,0,0,,意外だなぁ
Dialogue: 0,0:05:37.06,0:05:38.41,Dial_JP,,0,0,0,,したっけ解散
Dialogue: 0,0:05:38.41,0:05:39.32,Dial_JP,,0,0,0,,バイバーイ
Dialogue: 0,0:05:39.32,0:05:40.65,Dial_JP,,0,0,0,,じゃあね
Dialogue: 0,0:05:40.85,0:05:43.81,Dial_JP,,0,0,0,,今日はいろんな人と話せて楽しかったな
Dialogue: 0,0:05:43.81,0:05:45.12,Dial_JP,,0,0,0,,来てよかった
Dialogue: 0,0:05:45.87,0:05:46.86,Dial_JP,,600,0,0,,翼
Dialogue: 0,0:05:45.87,0:05:46.53,Dial_JP,,0,600,0,,四季
Dialogue: 0,0:05:48.65,0:05:51.84,Dial_JP,,0,0,0,,えっとさ　どうだった今日　大丈夫だった
Dialogue: 0,0:05:51.84,0:05:53.50,Dial_JP,,0,0,0,,うん　楽しかったよ
Dialogue: 0,0:05:53.50,0:05:54.76,Dial_JP,,0,0,0,,さゆりんは
Dialogue: 0,0:05:55.16,0:05:56.09,Dial_JP,,0,0,0,,私も
Dialogue: 0,0:05:56.32,0:05:58.52,Dial_JP,,0,0,0,,そっかぁ　よかった
Dialogue: 0,0:05:58.52,0:06:00.09,Dial_JP,,0,0,0,,またこういうとき誘うね
Dialogue: 0,0:06:01.89,0:06:05.28,Dial_JP,,0,0,0,,秋野さんはどうしたの　俺のこと呼んでたけど
Dialogue: 0,0:06:06.46,0:06:08.64,Dial_JP,,0,0,0,,いや　別になんでもない
Dialogue: 0,0:06:10.47,0:06:12.10,Dial_JP,,0,0,0,,じゃあ　帰ろっか
Dialogue: 0,0:06:12.10,0:06:15.19,Dial_JP,,0,0,0,,ってか　翼って　歌うまいんだね
Dialogue: 0,0:06:15.76,0:06:17.06,Dial_JP,,0,0,0,,そうかな
Dialogue: 0,0:06:24.10,0:06:25.55,Dial_JP,,0,0,0,,さゆりん
Dialogue: 0,0:06:29.91,0:06:30.78,Dial_JP,,0,0,0,,悪い
Dialogue: 0,0:06:50.14,0:06:51.50,Dial_JP,,0,0,0,,何がチョコだ
Dialogue: 0,0:06:51.97,0:06:53.96,Dial_JP,,0,0,0,,そんなことより　イベント　イベント
Dialogue: 0,0:07:09.88,0:07:11.05,Dial_JP,,0,0,0,,さゆりん
Dialogue: 0,0:07:12.60,0:07:13.78,Dial_JP,,0,0,0,,やほ
Dialogue: 0,0:07:13.78,0:07:17.08,Dial_JP,,0,0,0,,ふ　冬木　なんでこんなとこに
Dialogue: 0,0:07:17.45,0:07:19.96,Dial_JP,,0,0,0,,うちはチョコの材料を買いに来たんだよぉ
Dialogue: 0,0:07:21.68,0:07:23.08,Dial_JP,,0,0,0,,そ　そうなんだ
Dialogue: 0,0:07:23.78,0:07:26.02,Dial_JP,,0,0,0,,さゆりんもなんか買いに来たの
Dialogue: 0,0:07:27.41,0:07:30.57,Dial_JP,,0,0,0,,えっと　マニキュア　ネイル剥がれちゃって
Dialogue: 0,0:07:31.05,0:07:32.26,Dial_JP,,0,0,0,,ついてるよ
Dialogue: 0,0:07:32.84,0:07:34.51,Dial_JP,,0,0,0,,あ　あれ　ホントだ
Dialogue: 0,0:07:38.36,0:07:40.15,Dial_JP,,0,0,0,,もしかして　さゆりん
Dialogue: 0,0:07:40.31,0:07:42.70,Dial_JP,,0,0,0,,コスメ　コスメ買いに来たんだよ
Dialogue: 0,0:07:43.01,0:07:45.94,Dial_JP,,0,0,0,,そうだ　冬木ってコスメ詳しいじゃん
Dialogue: 0,0:07:45.94,0:07:48.28,Dial_JP,,0,0,0,,よかったら選ぶのつきあってくれない
Dialogue: 0,0:07:52.09,0:07:53.71,Dial_JP,,0,0,0,,ありがとうございました
Dialogue: 0,0:07:54.43,0:07:57.80,Dial_JP,,0,0,0,,いやぁ　やっぱ見てると欲しくなっちゃうよねぇ
Dialogue: 0,0:07:58.36,0:08:01.18,Dial_JP,,0,0,0,,じゃあ　シェアするやつはまた学校に持ってくね
Dialogue: 0,0:08:01.75,0:08:02.83,Dial_JP,,0,0,0,,サンキュー
Dialogue: 0,0:08:02.83,0:08:07.80,Dial_JP,,0,0,0,,うち的には　バレンタイン限定色のリップがかなり好きかも
Dialogue: 0,0:08:08.52,0:08:10.16,Dial_JP,,0,0,0,,バレンタインと言えばさぁ
Dialogue: 0,0:08:10.49,0:08:12.68,Dial_JP,,0,0,0,,さゆりんはどんなチョコが好きなの
Dialogue: 0,0:08:14.26,0:08:16.07,Dial_JP,,0,0,0,,さゆりん　どうしたの
Dialogue: 0,0:08:16.91,0:08:19.52,Dial_JP,,0,0,0,,私は生チョコとか好きだなぁ
Dialogue: 0,0:08:19.92,0:08:21.19,Dial_JP,,0,0,0,,わかる
Dialogue: 0,0:08:21.32,0:08:25.17,Dial_JP,,0,0,0,,ロイズの生チョコとか札幌行ったときは絶対買う
Dialogue: 0,0:08:26.49,0:08:28.32,Dial_JP,,0,0,0,,札幌行きたい
Dialogue: 0,0:08:28.68,0:08:32.21,Dial_JP,,0,0,0,,ヤバ　うちそろそろチョコの材料買いに行くね
Dialogue: 0,0:08:33.79,0:08:35.49,Dial_JP,,0,0,0,,したっけ　またね
Dialogue: 0,0:08:42.68,0:08:45.67,Dial_JP,,0,0,0,,私も一緒に買う
Dialogue: 0,0:08:47.67,0:08:49.97,Dial_JP,,0,0,0,,いや　勘違いすんなよ　あれだぞ
Dialogue: 0,0:08:50.17,0:08:52.34,Dial_JP,,0,0,0,,お前とかにあげるチョコだからな
Dialogue: 0,0:08:55.73,0:08:58.98,Dial_JP,,0,0,0,,うち　さゆりんになまらうまいチョコ作るよ　絶対
Dialogue: 0,0:08:59.26,0:09:01.19,Dial_JP,,0,0,0,,よーし　行くよー
Dialogue: 0,0:09:01.19,0:09:03.56,Dial_JP,,0,0,0,,おい　ちょっ　走るな
Dialogue: 0,0:09:06.07,0:09:09.57,Dial_JP,,0,0,0,,チョコ作りでわかんないとこあったらいつでも連絡してね
Dialogue: 0,0:09:09.57,0:09:11.25,Dial_JP,,0,0,0,,わかった　ありがと
Dialogue: 0,0:09:11.25,0:09:12.33,Dial_JP,,0,0,0,,またね
Dialogue: 0,0:09:16.21,0:09:17.13,Dial_JP,,0,0,0,,冬木
Dialogue: 0,0:09:18.80,0:09:19.95,Dial_JP,,0,0,0,,冬木は
Dialogue: 0,0:09:24.09,0:09:27.11,Dial_JP,,0,0,0,,四季に本命のチョコ　あげないの
Dialogue: 0,0:09:36.96,0:09:38.89,Dial_JP,,0,0,0,,な　なして翼
Dialogue: 0,0:09:38.89,0:09:41.30,Dial_JP,,0,0,0,,いや　だって仲いいから…
Dialogue: 0,0:09:41.68,0:09:43.60,Dial_JP,,0,0,0,,それは友達だもん
Dialogue: 0,0:09:43.60,0:09:45.96,Dial_JP,,0,0,0,,さゆりんも翼となかよぴじゃん
Dialogue: 0,0:09:45.96,0:09:48.69,Dial_JP,,0,0,0,,私らはただゲームするだけだし
Dialogue: 0,0:09:53.32,0:09:55.53,Dial_JP,,0,0,0,,いや　ごめん　急に
Dialogue: 0,0:09:55.53,0:09:57.32,Dial_JP,,0,0,0,,ううん　いいの
Dialogue: 0,0:09:57.32,0:09:59.25,Dial_JP,,0,0,0,,ちょびっとびっくりしただけ
Dialogue: 0,0:09:59.44,0:10:01.04,Dial_JP,,0,0,0,,じゃあ　また学校で
Dialogue: 0,0:10:01.81,0:10:02.75,Dial_JP,,0,0,0,,またね
Dialogue: 0,0:10:15.58,0:10:17.21,Dial_JP,,0,0,0,,どっちなんだろう
Dialogue: 0,0:10:31.08,0:10:34.32,Dial_JP,,0,0,0,,期末の範囲もだいたい復習できたな
Dialogue: 0,0:10:37.34,0:10:40.23,Dial_JP,,0,0,0,,べべべ　別に期待することなんかないか
Dialogue: 0,0:10:40.23,0:10:42.62,Dial_JP,,0,0,0,,試験も近いし　それどころじゃないよな
Dialogue: 0,0:10:43.37,0:10:44.68,Dial_JP,,0,0,0,,勉強　勉強
Dialogue: 0,0:10:56.80,0:10:58.85,Dial_JP,,0,0,0,,さゆりん　まだおきてる
Dialogue: 0,0:10:58.85,0:11:01.48,Dial_JP,,0,0,0,,うちはチョコほとんど完成したんだケド
Dialogue: 0,0:11:01.48,0:11:03.73,Dial_JP,,0,0,0,,さゆりん大丈夫か心配になってさ
Dialogue: 0,0:11:07.59,0:11:08.69,Dial_JP,,0,0,0,,さゆりんだ
Dialogue: 0,0:11:08.88,0:11:11.59,Dial_JP,,0,0,0,,この時間はいつもゲームしてるから起きてる
Dialogue: 0,0:11:11.95,0:11:13.49,Dial_JP,,0,0,0,,チョコは今から作る
Dialogue: 0,0:11:16.78,0:11:18.85,Dial_JP,,0,0,0,,いやぁ　ごめんね　急に
Dialogue: 0,0:11:18.85,0:11:22.42,Dial_JP,,0,0,0,,でもさゆりんと通話するの初めてだから　なんかうれしい
Dialogue: 0,0:11:23.69,0:11:25.27,Dial_JP,,0,0,0,,まぁ　それは置いといて
Dialogue: 0,0:11:25.27,0:11:26.33,Dial_JP,,0,0,0,,おっ　置かれた
Dialogue: 0,0:11:26.49,0:11:28.74,Dial_JP,,0,0,0,,チョコ　どうやって作ったらいい
Dialogue: 0,0:11:28.96,0:11:31.29,Dial_JP,,0,0,0,,できれば難しくないやつがいいんだけど
Dialogue: 0,0:11:32.23,0:11:34.03,Dial_JP,,0,0,0,,うちに任せて
Dialogue: 0,0:11:34.30,0:11:37.40,Dial_JP,,0,0,0,,まずはチョコを包丁で細かく刻むんだよ
Dialogue: 0,0:11:37.93,0:11:38.68,Dial_JP,,0,0,0,,了解
Dialogue: 0,0:11:41.97,0:11:43.60,Dial_JP,,0,0,0,,終わった　次は
Dialogue: 0,0:11:43.60,0:11:44.66,Dial_JP,,0,0,0,,はっや
Dialogue: 0,0:11:44.96,0:11:47.69,Dial_JP,,0,0,0,,今日一緒に買った生クリームがあったでしょ
Dialogue: 0,0:11:47.69,0:11:50.44,Dial_JP,,0,0,0,,とりま　それをボウルに入れて　湯煎するの
Dialogue: 0,0:11:50.44,0:11:51.44,Dial_JP,,0,0,0,,湯煎
Dialogue: 0,0:11:51.44,0:11:53.84,Dial_JP,,0,0,0,,湯煎はねぇ　温めたお湯に
Dialogue: 0,0:11:53.84,0:11:56.56,Dial_JP,,0,0,0,,別の容器ごと入れて温めることだよ
Dialogue: 0,0:11:56.56,0:11:57.78,Dial_JP,,0,0,0,,なるほど
Dialogue: 0,0:11:58.25,0:12:01.28,Dial_JP,,0,0,0,,生クリームは　チョコの半分の量だよ
Dialogue: 0,0:12:01.28,0:12:02.69,Dial_JP,,0,0,0,,じゃあ　こんくらいか
Dialogue: 0,0:12:05.25,0:12:07.86,Dial_JP,,0,0,0,,火を止めたら　刻んだチョコを入れて
Dialogue: 0,0:12:07.86,0:12:10.21,Dial_JP,,0,0,0,,溶かしながらまぜまぜして
Dialogue: 0,0:12:10.59,0:12:13.13,Dial_JP,,0,0,0,,あとは冷蔵庫で１２時間冷やして
Dialogue: 0,0:12:13.54,0:12:15.76,Dial_JP,,0,0,0,,固まったら好きな大きさに切って
Dialogue: 0,0:12:15.76,0:12:17.88,Dial_JP,,0,0,0,,ココアパウダーをかければ完成
Dialogue: 0,0:12:18.07,0:12:20.27,Dial_JP,,0,0,0,,本当にメッチャ簡単だった
Dialogue: 0,0:12:20.65,0:12:22.54,Dial_JP,,0,0,0,,冬木はチョコ　どんな感じ
Dialogue: 0,0:12:23.60,0:12:25.31,Dial_JP,,0,0,0,,うちはねぇ
Dialogue: 0,0:12:27.18,0:12:29.52,Dial_JP,,0,0,0,,明日のお楽しみだよー
Dialogue: 0,0:12:29.95,0:12:31.76,Dial_JP,,0,0,0,,結局　何個作ったん
Dialogue: 0,0:12:31.76,0:12:34.49,Dial_JP,,0,0,0,,70個　前年度更新
Dialogue: 0,0:12:34.49,0:12:36.95,Dial_JP,,0,0,0,,お前の友達の数に震えるわ
Dialogue: 0,0:12:37.28,0:12:39.42,Dial_JP,,0,0,0,,よくそんなモチベ上げれるな
Dialogue: 0,0:12:39.42,0:12:41.94,Dial_JP,,0,0,0,,だってみんな喜んでくれるし
Dialogue: 0,0:12:41.94,0:12:46.38,Dial_JP,,0,0,0,,それに　渡したらきっとおもしろい反応するだろうなぁとか
Dialogue: 0,0:12:46.38,0:12:48.41,Dial_JP,,0,0,0,,想像するだけでワクワクするから
Dialogue: 0,0:12:49.18,0:12:52.04,Dial_JP,,0,0,0,,結局　うちがいちばん楽しんでるんだよね
Dialogue: 0,0:12:52.83,0:12:56.22,Dial_JP,,0,0,0,,さゆりんは誰のこと考えながら作ってるの
Dialogue: 0,0:12:57.25,0:12:59.32,Dial_JP,,0,0,0,,お前にあげるって言ったろ
Dialogue: 0,0:12:59.32,0:13:01.54,Dial_JP,,0,0,0,,あんま言わせんなよ　ハズい
Dialogue: 0,0:13:02.07,0:13:03.45,Dial_JP,,0,0,0,,うれしい
Dialogue: 0,0:13:06.07,0:13:07.06,Dial_JP,,0,0,0,,他には
Dialogue: 0,0:13:07.89,0:13:09.80,Dial_JP,,0,0,0,,他に渡す人いないの
Dialogue: 0,0:13:11.55,0:13:13.80,Dial_JP,,0,0,0,,ずっと気になってたんだけど
Dialogue: 0,0:13:15.01,0:13:16.88,Dial_JP,,0,0,0,,もしかして　さゆりんさ
Dialogue: 0,0:13:18.15,0:13:19.45,Dial_JP,,0,0,0,,翼のこと
Dialogue: 0,0:13:21.41,0:13:21.78,Dial_JP,,0,0,0,,す…
Dialogue: 0,0:13:25.95,0:13:27.33,Dial_JP,,0,0,0,,ダメー
Dialogue: 0,0:13:28.14,0:13:30.46,Dial_JP,,0,0,0,,おっおい　どした　大丈夫か
Dialogue: 0,0:13:30.67,0:13:31.96,Dial_JP,,0,0,0,,何があったんだよ
Dialogue: 0,0:13:32.14,0:13:33.02,Dial_JP,,0,0,0,,冬木
Dialogue: 0,0:13:33.67,0:13:37.97,Dial_JP,,0,0,0,,作ったチョコの上に調味料とかしょうゆさしが落ちちゃって
Dialogue: 0,0:13:39.03,0:13:40.63,Dial_JP,,0,0,0,,チョコは　大丈夫なのか
Dialogue: 0,0:13:41.37,0:13:43.37,Dial_JP,,0,0,0,,しょうゆまみれになっちゃった
Dialogue: 0,0:13:43.62,0:13:45.12,Dial_JP,,0,0,0,,まさか　全部じゃ
Dialogue: 0,0:13:45.12,0:13:46.61,Dial_JP,,0,0,0,,全部だね
Dialogue: 0,0:13:47.69,0:13:49.01,Dial_JP,,0,0,0,,ふ　冬木
Dialogue: 0,0:13:49.01,0:13:53.28,Dial_JP,,0,0,0,,いやぁ　これは片づけてなかったうちが悪いね
Dialogue: 0,0:13:53.62,0:13:55.83,Dial_JP,,0,0,0,,さゆりんは生チョコ　大丈夫そう
Dialogue: 0,0:13:55.83,0:13:58.30,Dial_JP,,0,0,0,,さっき言った残りの工程　覚えてる
Dialogue: 0,0:14:01.14,0:14:02.37,Dial_JP,,0,0,0,,よかった
Dialogue: 0,0:14:02.37,0:14:05.18,Dial_JP,,0,0,0,,したっけ　うち後片づけするから切るね
Dialogue: 0,0:14:05.43,0:14:06.03,Dial_JP,,0,0,0,,おい
Dialogue: 0,0:14:13.05,0:14:14.98,Dial_JP,,0,0,0,,優しすぎだろ
Dialogue: 0,0:14:22.79,0:14:26.61,Dial_JP,,0,0,0,,いや　昨日はよふかし勉強しちゃったから
Dialogue: 0,0:14:26.61,0:14:28.55,Dial_JP,,0,0,0,,全然眠れなかったな
Dialogue: 0,0:14:31.53,0:14:33.52,Dial_JP,,0,0,0,,いや　ほんとにね
Dialogue: 0,0:14:36.54,0:14:38.45,Dial_JP,,0,0,0,,来い
Dialogue: 0,0:14:40.31,0:14:41.65,Dial_JP,,0,0,0,,ないですよね
Dialogue: 0,0:14:45.32,0:14:47.10,Dial_JP,,0,0,0,,翼　おはよう
Dialogue: 0,0:14:49.10,0:14:51.16,Dial_JP,,0,0,0,,お　おはよう　冬木さん
Dialogue: 0,0:14:51.87,0:14:52.50,Dial_JP,,0,0,0,,あれ？
Dialogue: 0,0:14:53.15,0:14:54.19,Dial_JP,,0,0,0,,冬木さん
Dialogue: 0,0:14:54.50,0:14:56.33,Dial_JP,,0,0,0,,少し　目元が赤い
Dialogue: 0,0:14:56.33,0:14:58.51,Dial_JP,,0,0,0,,はいこれ　翼にあげる
Dialogue: 0,0:15:00.06,0:15:01.14,Dial_JP,,0,0,0,,まさか
Dialogue: 0,0:15:02.36,0:15:03.30,Dial_JP,,0,0,0,,これって
Dialogue: 0,0:15:03.30,0:15:05.05,Dial_JP,,0,0,0,,バレンタインだからね
Dialogue: 0,0:15:05.05,0:15:06.59,Dial_JP,,0,0,0,,おいしいよ　それ
Dialogue: 0,0:15:06.59,0:15:08.48,Dial_JP,,0,0,0,,東京にはあんまないっしょ
Dialogue: 0,0:15:09.14,0:15:10.64,Dial_JP,,0,0,0,,ありがとう　冬木さん
Dialogue: 0,0:15:10.64,0:15:12.43,Dial_JP,,0,0,0,,大切にいただくよ
Dialogue: 0,0:15:18.12,0:15:19.64,Dial_JP,,0,0,0,,おっはよ　さゆりん
Dialogue: 0,0:15:19.64,0:15:20.86,Dial_JP,,0,0,0,,これもらって
Dialogue: 0,0:15:22.08,0:15:23.12,Dial_JP,,0,0,0,,これ
Dialogue: 0,0:15:27.57,0:15:28.00,Dial_JP,,0,0,0,,ふゆ…
Dialogue: 0,0:15:28.00,0:15:30.35,Dial_JP,,0,0,0,,ふゆみな　俺にもチョコくれよ
Dialogue: 0,0:15:30.35,0:15:31.74,Dial_JP,,0,0,0,,おけおけ
Dialogue: 0,0:15:33.20,0:15:34.84,Dial_JP,,0,0,0,,手作りじゃねぇの
Dialogue: 0,0:15:34.84,0:15:38.31,Dial_JP,,0,0,0,,今年は諸事情により生産中止なんだよ～だ
Dialogue: 0,0:15:38.31,0:15:40.62,Dial_JP,,0,0,0,,なんだよ　楽しみにしてたのに
Dialogue: 0,0:15:40.62,0:15:42.04,Dial_JP,,0,0,0,,ごめんって
Dialogue: 0,0:15:42.04,0:15:44.26,Dial_JP,,0,0,0,,ってか　もらっといて文句言うなし
Dialogue: 0,0:15:45.39,0:15:47.69,Dial_JP,,0,0,0,,マジガッカリだわぁ
Dialogue: 0,0:15:49.09,0:15:50.62,Dial_JP,,0,0,0,,まっつーん
Dialogue: 0,0:15:52.17,0:15:53.19,Dial_JP,,0,0,0,,何何
Dialogue: 0,0:15:53.83,0:15:56.40,Dial_JP,,0,0,0,,今年はチョコ　作らなかったんだ
Dialogue: 0,0:15:56.67,0:15:57.98,Dial_JP,,0,0,0,,何かあったのかな
Dialogue: 0,0:15:58.41,0:16:00.07,Dial_JP,,0,0,0,,あんがと　じゃね
Dialogue: 0,0:16:02.13,0:16:02.77,Dial_JP,,0,0,0,,おい
Dialogue: 0,0:16:03.56,0:16:05.74,Dial_JP,,0,0,0,,次　冬木に　あんなこと言ったら
Dialogue: 0,0:16:06.60,0:16:08.15,Dial_JP,,0,0,0,,マジで殴るからな
Dialogue: 0,0:16:27.13,0:16:30.18,Dial_JP,,0,0,0,,今日から部活動も試験休みに入るからな
Dialogue: 0,0:16:30.47,0:16:33.91,Dial_JP,,0,0,0,,各掃除当番以外は　すぐ下校するように
Dialogue: 0,0:16:45.46,0:16:48.11,Dial_JP,,0,0,0,,あとは　ゴミ投げ行けば終わりだね
Dialogue: 0,0:16:48.35,0:16:51.06,Dial_JP,,0,0,0,,したっけ　あとは２人に任せるわ
Dialogue: 0,0:16:53.29,0:16:57.50,Dial_JP,,0,0,0,,それにしても　いつも吹部の練習が聞こえてくるから
Dialogue: 0,0:16:57.50,0:17:01.00,Dial_JP,,0,0,0,,放課後に学校が静かなのも　変な感じがするね
Dialogue: 0,0:17:01.00,0:17:01.92,Dial_JP,,0,0,0,,そだね
Dialogue: 0,0:17:02.29,0:17:04.02,Dial_JP,,0,0,0,,うちらしかいないみたい
Dialogue: 0,0:17:05.57,0:17:08.96,Dial_JP,,0,0,0,,そ　そういえば　チョコありがとね
Dialogue: 0,0:17:09.30,0:17:11.25,Dial_JP,,0,0,0,,帰ったら食べさせてもらうよ
Dialogue: 0,0:17:13.41,0:17:14.28,Dial_JP,,0,0,0,,冬木さん
Dialogue: 0,0:17:29.37,0:17:30.31,Dial_JP,,0,0,0,,冬木さん
Dialogue: 0,0:17:31.82,0:17:36.12,Dial_JP,,0,0,0,,俺でよかったら　何があったか　話してほしい
Dialogue: 0,0:17:40.27,0:17:41.96,Dial_JP,,0,0,0,,そうだったんだ
Dialogue: 0,0:17:42.42,0:17:45.55,Dial_JP,,0,0,0,,作ったチョコ　全部ダメになっちゃったんだ
Dialogue: 0,0:17:45.84,0:17:49.32,Dial_JP,,0,0,0,,ホントは何個か大丈夫そうだったんだけどね
Dialogue: 0,0:17:49.68,0:17:53.21,Dial_JP,,0,0,0,,割れただけとか　牛乳がちょっとかかっただけとか
Dialogue: 0,0:17:53.93,0:17:57.45,Dial_JP,,0,0,0,,だけど一回失敗したチョコは誰にもあげたくないじゃん
Dialogue: 0,0:17:58.95,0:18:00.73,Dial_JP,,0,0,0,,でも　なんかやっぱり
Dialogue: 0,0:18:01.77,0:18:04.31,Dial_JP,,0,0,0,,作ったチョコあげたかったなぁって
Dialogue: 0,0:18:06.30,0:18:09.19,Dial_JP,,0,0,0,,ガッカリさせちゃったかなぁって
Dialogue: 0,0:18:12.12,0:18:15.44,Dial_JP,,0,0,0,,翼にも食べてほしかったなぁって
Dialogue: 0,0:18:22.21,0:18:27.18,Dial_JP,,0,0,0,,まぁでも　ママにも片づけなさいって言われてたのに守れなかったし
Dialogue: 0,0:18:27.59,0:18:31.87,Dial_JP,,0,0,0,,通話してた友達にも変なこと聞いて困らせちゃったし
Dialogue: 0,0:18:32.44,0:18:34.26,Dial_JP,,0,0,0,,だから　きっとおだちすぎて
Dialogue: 0,0:18:34.26,0:18:36.06,Dial_JP,,0,0,0,,バチが当たったんだよ
Dialogue: 0,0:18:44.20,0:18:45.31,Dial_JP,,0,0,0,,翼
Dialogue: 0,0:18:52.25,0:18:53.04,Dial_JP,,0,0,0,,今
Dialogue: 0,0:18:54.86,0:18:56.74,Dial_JP,,0,0,0,,俺にできることは
Dialogue: 0,0:19:49.30,0:19:50.51,Dial_JP,,0,0,0,,これって
Dialogue: 0,0:19:51.51,0:19:53.63,Dial_JP,,0,0,0,,冬木さんがカラオケで歌ってた曲
Dialogue: 0,0:19:54.31,0:19:56.08,Dial_JP,,0,0,0,,俺　ピアノ習ってたから
Dialogue: 0,0:19:56.08,0:19:59.64,Dial_JP,,0,0,0,,できるかぎり耳コピで弾いてみたけど　どうだった
Dialogue: 0,0:20:00.62,0:20:02.84,Dial_JP,,0,0,0,,すっご　メッチャ弾けてたよ
Dialogue: 0,0:20:03.46,0:20:05.27,Dial_JP,,0,0,0,,でも　なしてこの曲
Dialogue: 0,0:20:05.89,0:20:09.13,Dial_JP,,0,0,0,,冬木さんにはたくさん　元気をもらってるから
Dialogue: 0,0:20:09.40,0:20:12.03,Dial_JP,,0,0,0,,俺も冬木さんに元気あげたくて
Dialogue: 0,0:20:14.27,0:20:16.24,Dial_JP,,0,0,0,,この曲　大好きなんだぁ
Dialogue: 0,0:20:16.69,0:20:18.45,Dial_JP,,0,0,0,,聴くと元気出るじゃん
Dialogue: 0,0:20:21.46,0:20:25.05,Dial_JP,,0,0,0,,翼ってなしてこういうことすんのかなぁ　ホント
Dialogue: 0,0:20:26.48,0:20:28.75,Dial_JP,,0,0,0,,なんまら元気になったし
Dialogue: 0,0:20:29.15,0:20:32.10,Dial_JP,,0,0,0,,マジ最高　うれしみがヤバい
Dialogue: 0,0:20:32.10,0:20:34.22,Dial_JP,,0,0,0,,つばちゃ　イケメンかぁ
Dialogue: 0,0:20:34.22,0:20:35.52,Dial_JP,,0,0,0,,よかった
Dialogue: 0,0:20:37.06,0:20:38.26,Dial_JP,,0,400,0,,秋野さん
Dialogue: 0,0:20:37.06,0:20:38.26,Dial_JP,,400,0,0,,さゆりん
Dialogue: 0,0:20:38.67,0:20:40.03,Dial_JP,,0,0,0,,なして　ここに
Dialogue: 0,0:20:41.04,0:20:44.80,Dial_JP,,0,0,0,,まぁ　あれだ　チョコ渡すために来たんだ
Dialogue: 0,0:20:48.41,0:20:49.48,Dial_JP,,0,0,0,,そっか
Dialogue: 0,0:20:49.48,0:20:51.42,Dial_JP,,0,0,0,,したっけ　うちは帰るね
Dialogue: 0,0:20:53.10,0:20:54.02,Dial_JP,,0,0,0,,冬木に
Dialogue: 0,0:20:56.75,0:20:59.37,Dial_JP,,0,0,0,,忘れたのかよ　約束したろ
Dialogue: 0,0:20:59.37,0:21:00.07,Dial_JP,,0,0,0,,友チョコ
Dialogue: 0,0:21:00.36,0:21:02.64,Dial_JP,,0,0,0,,友チョコ
Dialogue: 0,0:21:03.39,0:21:06.48,Dial_JP,,0,0,0,,さ…　さゆりん　だいしゅき
Dialogue: 0,0:21:06.48,0:21:09.10,Dial_JP,,0,0,0,,おっおい　お前　鼻水
Dialogue: 0,0:21:09.10,0:21:10.72,Dial_JP,,0,0,0,,ねねね　開けていい
Dialogue: 0,0:21:11.16,0:21:12.95,Dial_JP,,0,0,0,,いいけど　今食べんの
Dialogue: 0,0:21:13.38,0:21:14.86,Dial_JP,,0,0,0,,今食べたいの
Dialogue: 0,0:21:15.06,0:21:16.48,Dial_JP,,0,600,0,,ハズいんだけど
Dialogue: 0,0:21:15.59,0:21:16.70,Dial_JP,,0,0,0,,ハッズ
Dialogue: 0,0:21:16.70,0:21:20.55,Dial_JP,,0,0,0,,自分がもらえると思って露骨に反応しちゃったよ俺
Dialogue: 0,0:21:20.84,0:21:21.89,Dial_JP,,0,0,0,,潜りたい
Dialogue: 0,0:21:21.89,0:21:24.55,Dial_JP,,0,0,0,,地中の奥底でひっそりとしていたい
Dialogue: 0,0:21:25.15,0:21:26.04,Dial_JP,,0,0,0,,四季
Dialogue: 0,0:21:26.94,0:21:27.91,Dial_JP,,0,0,0,,ほら　これ
Dialogue: 0,0:21:29.95,0:21:31.00,Dial_JP,,0,0,0,,おっ　俺にも
Dialogue: 0,0:21:31.00,0:21:32.96,Dial_JP,,0,0,0,,一応な　弟子だし
Dialogue: 0,0:21:33.21,0:21:35.82,Dial_JP,,0,0,0,,冬木のチョコ作ったときに多くできたやつだから
Dialogue: 0,0:21:37.62,0:21:39.40,Dial_JP,,0,0,0,,ありがとう　秋野さん
Dialogue: 0,0:21:41.69,0:21:44.53,Dial_JP,,0,0,0,,さっきのピアノ　カッコよかったぞ
Dialogue: 0,0:21:49.11,0:21:50.77,Dial_JP,,0,0,0,,うんま
Dialogue: 0,0:21:50.77,0:21:53.31,Dial_JP,,0,0,0,,さゆりん　これ　なまらうまいよ
Dialogue: 0,0:21:53.53,0:21:55.88,Dial_JP,,0,0,0,,マジか　初めて作ったのに
Dialogue: 0,0:21:56.77,0:21:59.00,Dial_JP,,0,0,0,,翼もさゆりんからもらってる
Dialogue: 0,0:21:59.00,0:22:01.01,Dial_JP,,0,0,0,,冬木と同じ友チョコな
Dialogue: 0,0:22:01.01,0:22:04.09,Dial_JP,,0,0,0,,翼もさゆりんも一緒に食べようよ
Dialogue: 0,0:22:04.71,0:22:05.40,Dial_JP,,0,0,0,,うん
Dialogue: 0,0:22:05.69,0:22:08.49,Dial_JP,,0,0,0,,冬木さんからもらったチョコ　ポケット入れてたから
Dialogue: 0,0:22:08.49,0:22:10.68,Dial_JP,,0,0,0,,こっちも一緒に食べてみていいかな
Dialogue: 0,0:22:11.09,0:22:12.90,Dial_JP,,0,0,0,,私もカバンに入ってる
Dialogue: 0,0:22:13.10,0:22:14.86,Dial_JP,,0,0,0,,いいねいいね
Dialogue: 0,0:22:14.86,0:22:17.11,Dial_JP,,0,0,0,,チョコパしよ　チョコパ
Dialogue: 1,0:00:00.97,0:00:05.74,Dial_CH,,0,0,0,,我將要去尋找
Dialogue: 1,0:00:05.74,0:00:10.84,Dial_CH,,0,0,0,,你那太陽般的微笑
Dialogue: 1,0:00:10.84,0:00:15.20,Dial_CH,,0,0,0,,向日葵隨風搖曳
Dialogue: 1,0:00:15.37,0:00:20.00,Dial_CH,,0,0,0,,卻無法不朝向你
Dialogue: 1,0:00:20.45,0:00:22.57,Dial_CH,,0,0,0,,沒關係
Dialogue: 1,0:00:22.57,0:00:27.67,Dial_CH,,0,0,0,,用盡渾身的勇氣
Dialogue: 1,0:00:27.67,0:00:32.51,Dial_CH,,0,0,0,,將心意訴說給你
Dialogue: 1,0:00:33.35,0:00:35.38,Dial_CH,,0,0,0,,喜歡你
Dialogue: 1,0:02:12.32,0:02:13.49,Dial_CH,,0,500,0,,謝謝
Dialogue: 1,0:02:16.51,0:02:18.67,Dial_CH,,0,0,0,,冬木同學唱得真棒
Dialogue: 1,0:02:18.67,0:02:21.24,Dial_CH,,0,0,0,,是啊 一看就經常來
Dialogue: 1,0:02:21.65,0:02:25.67,Dial_CH,,0,0,0,,冬美每次來KTV總要唱這首
Dialogue: 1,0:02:25.67,0:02:28.45,Dial_CH,,0,0,0,,嗯 我超喜歡這首歌
Dialogue: 1,0:02:28.45,0:02:30.29,Dial_CH,,0,0,0,,是不是聽了就開心啊
Dialogue: 1,0:02:31.74,0:02:33.11,Dial_CH,,0,0,0,,話說
Dialogue: 1,0:02:34.28,0:02:35.69,Dial_CH,,0,0,0,,抱歉 你說什麼
Dialogue: 1,0:02:35.69,0:02:39.27,Dial_CH,,0,0,0,,四季經常來KTV嗎
Dialogue: 1,0:02:39.27,0:02:43.23,Dial_CH,,0,0,0,,沒有 也就和家裡人唱過幾次
Dialogue: 1,0:02:43.23,0:02:45.83,Dial_CH,,0,0,0,,所以這次冬木同學邀請我來
Dialogue: 1,0:02:45.83,0:02:47.23,Dial_CH,,0,0,0,,我還挺緊張的
Dialogue: 1,0:02:47.48,0:02:48.55,Dial_CH,,0,0,0,,秋野同學呢
Dialogue: 1,0:02:50.67,0:02:53.16,Dial_CH,,0,0,0,,來是來過 雖然都自己來
Dialogue: 1,0:02:55.70,0:02:58.25,Dial_CH,,0,0,0,,一… 一個人也挺好的
Dialogue: 1,0:02:58.78,0:03:00.39,Dial_CH,,0,0,0,,人的娛樂方式都不同
Dialogue: 1,0:03:00.39,0:03:02.00,Dial_CH,,0,0,0,,我覺得還挺不錯的
Dialogue: 1,0:03:02.00,0:03:05.46,Dial_CH,,0,0,0,,四季 你這人實在太好懂了
Dialogue: 1,0:03:05.79,0:03:08.18,Dial_CH,,0,0,0,,四季也點點歌吧
Dialogue: 1,0:03:09.24,0:03:10.58,Dial_CH,,700,0,0,,這個怎麼樣
Dialogue: 1,0:03:08.18,0:03:10.58,Dial_CH,,0,600,0,,秋野同學唱點什麼
Dialogue: 1,0:03:10.58,0:03:11.83,Dial_CH,,700,0,0,,那 那個
Dialogue: 1,0:03:12.32,0:03:14.92,Dial_CH,,0,0,0,,我不太聽流行歌
Dialogue: 1,0:03:17.98,0:03:20.66,Dial_CH,,0,0,0,,我也來一起點
Dialogue: 1,0:03:22.09,0:03:23.87,Dial_CH,,0,0,0,,冬美不是剛唱完嗎
Dialogue: 1,0:03:23.87,0:03:27.59,Dial_CH,,0,0,0,,我只是來幫他倆一起找找
Dialogue: 1,0:03:27.81,0:03:29.15,Dial_CH,,0,0,0,,二位意下如何
Dialogue: 1,0:03:30.82,0:03:31.64,Dial_CH,,0,0,0,,嗯
Dialogue: 1,0:03:31.64,0:03:33.21,Dial_CH,,0,800,0,,做得漂亮 冬木
Dialogue: 1,0:03:31.64,0:03:33.21,Dial_CH,,800,0,0,,做得漂亮 冬木同學
Dialogue: 1,0:03:33.45,0:03:35.07,Dial_CH,,0,0,0,,冬美 到你的歌了
Dialogue: 1,0:03:38.08,0:03:39.45,Dial_CH,,0,0,0,,一起唱吧
Dialogue: 1,0:03:47.04,0:03:48.95,Dial_CH,,0,0,0,,馬上就期末考試了
Dialogue: 1,0:03:49.15,0:03:51.88,Dial_CH,,0,0,0,,這次考試範圍也太廣了
Dialogue: 1,0:03:52.29,0:03:53.33,Dial_CH,,0,0,0,,是吧 四季
Dialogue: 1,0:03:54.75,0:03:55.63,Dial_CH,,0,0,0,,是啊
Dialogue: 1,0:03:55.63,0:03:58.53,Dial_CH,,0,0,0,,要不下次我們開場學習會吧
Dialogue: 1,0:03:58.90,0:04:00.60,Dial_CH,,0,0,0,,好啊 開唄
Dialogue: 1,0:04:00.77,0:04:03.16,Dial_CH,,0,0,0,,秋野同學的美甲 好可愛
Dialogue: 1,0:04:03.16,0:04:04.71,Dial_CH,,0,0,0,,謝 謝謝
Dialogue: 1,0:04:04.71,0:04:06.27,Dial_CH,,0,0,0,,這個我特別喜歡
Dialogue: 1,0:04:12.41,0:04:16.24,Dial_CH,,0,0,0,,說起來 馬上就到情人節了
Dialogue: 1,0:04:19.32,0:04:22.24,Dial_CH,,0,0,0,,我對巧克力什麼的一點都不感興趣呢
Dialogue: 1,0:04:22.24,0:04:23.74,Dial_CH,,0,0,0,,是 是啊
Dialogue: 1,0:04:23.95,0:04:26.03,Dial_CH,,0,0,0,,裝什麼呢
Dialogue: 1,0:04:26.03,0:04:28.37,Dial_CH,,0,0,0,,給你們兩塊友情巧克力倒也無妨
Dialogue: 1,0:04:28.37,0:04:30.88,Dial_CH,,0,0,0,,真的嗎 還好開口了
Dialogue: 1,0:04:30.88,0:04:31.88,Dial_CH,,0,0,0,,那敢情好
Dialogue: 1,0:04:32.77,0:04:34.80,Dial_CH,,0,0,0,,情人節啊
Dialogue: 1,0:04:35.95,0:04:39.29,Dial_CH,,0,0,0,,冬木同學會給誰送巧克力嗎
Dialogue: 1,0:04:39.84,0:04:43.26,Dial_CH,,0,0,0,,冬美 記得給我巧克力
Dialogue: 1,0:04:44.42,0:04:45.47,Dial_CH,,0,0,0,,行
Dialogue: 1,0:04:47.43,0:04:50.34,Dial_CH,,0,0,0,,本來今年也準備做超多巧克力
Dialogue: 1,0:04:50.34,0:04:52.80,Dial_CH,,0,0,0,,去年做了多少個來著
Dialogue: 1,0:04:53.83,0:04:55.27,Dial_CH,,0,0,0,,60個左右
Dialogue: 1,0:04:55.27,0:04:58.02,Dial_CH,,0,0,0,,當時就跟食堂阿姨給人盛飯一樣
Dialogue: 1,0:04:59.15,0:05:00.36,Dial_CH,,0,0,0,,喔
Dialogue: 1,0:05:00.66,0:05:03.43,Dial_CH,,0,0,0,,原來她會給所有人發啊
Dialogue: 1,0:05:03.43,0:05:06.80,Dial_CH,,0,0,0,,咦 我為什麼鬆了一口氣
Dialogue: 1,0:05:08.80,0:05:11.29,Dial_CH,,0,0,0,,秋野同學呢 做巧克力嗎
Dialogue: 1,0:05:12.13,0:05:16.13,Dial_CH,,0,0,0,,免了 得花不少錢 不如花在愛好上
Dialogue: 1,0:05:16.13,0:05:17.20,Dial_CH,,0,0,0,,真有意思
Dialogue: 1,0:05:17.43,0:05:20.23,Dial_CH,,0,0,0,,秋野同學好帥啊 這麼果決
Dialogue: 1,0:05:21.43,0:05:23.21,Dial_CH,,0,0,0,,這回答真有她的風範
Dialogue: 1,0:05:23.21,0:05:26.19,Dial_CH,,0,0,0,,四季在東京的時候收到過巧克力嗎
Dialogue: 1,0:05:26.47,0:05:28.25,Dial_CH,,0,0,0,,只收到過家人的
Dialogue: 1,0:05:28.25,0:05:29.81,Dial_CH,,0,0,0,,大部分人都這樣
Dialogue: 1,0:05:29.81,0:05:31.97,Dial_CH,,0,0,0,,家人給的肯定不算啊
Dialogue: 1,0:05:31.97,0:05:33.81,Dial_CH,,0,0,0,,四季收不到巧克力
Dialogue: 1,0:05:33.81,0:05:35.19,Dial_CH,,0,0,0,,這還真沒想到
Dialogue: 1,0:05:37.06,0:05:38.41,Dial_CH,,0,0,0,,散了吧
Dialogue: 1,0:05:38.41,0:05:39.32,Dial_CH,,0,0,0,,拜拜
Dialogue: 1,0:05:39.32,0:05:40.65,Dial_CH,,0,0,0,,待會見
Dialogue: 1,0:05:40.85,0:05:43.81,Dial_CH,,0,0,0,,今天和這麼多人聊了天 真開心
Dialogue: 1,0:05:43.81,0:05:45.12,Dial_CH,,0,0,0,,還好來了
Dialogue: 1,0:05:45.87,0:05:46.86,Dial_CH,,600,0,0,,翼
Dialogue: 1,0:05:45.87,0:05:46.53,Dial_CH,,0,600,0,,四季
Dialogue: 1,0:05:48.65,0:05:51.84,Dial_CH,,0,0,0,,今天感覺怎麼樣 玩得還開心嗎
Dialogue: 1,0:05:51.84,0:05:53.50,Dial_CH,,0,0,0,,嗯 很開心
Dialogue: 1,0:05:53.50,0:05:54.76,Dial_CH,,0,0,0,,沙友友呢
Dialogue: 1,0:05:55.16,0:05:56.09,Dial_CH,,0,0,0,,我也
Dialogue: 1,0:05:56.32,0:05:58.52,Dial_CH,,0,0,0,,那就好
Dialogue: 1,0:05:58.52,0:06:00.09,Dial_CH,,0,0,0,,下次有這種機會我再約你們
Dialogue: 1,0:06:01.89,0:06:05.28,Dial_CH,,0,0,0,,秋野同學剛剛叫我有什麼事嗎
Dialogue: 1,0:06:06.46,0:06:08.64,Dial_CH,,0,0,0,,不 沒什麼
Dialogue: 1,0:06:10.47,0:06:12.10,Dial_CH,,0,0,0,,喔 那回家吧
Dialogue: 1,0:06:12.10,0:06:15.19,Dial_CH,,0,0,0,,話說 翼唱歌挺好聽啊
Dialogue: 1,0:06:15.76,0:06:17.06,Dial_CH,,0,0,0,,是嗎
Dialogue: 1,0:06:24.10,0:06:25.55,Dial_CH,,0,0,0,,沙友友
Dialogue: 1,0:06:29.91,0:06:30.78,Dial_CH,,0,0,0,,不好意思
Dialogue: 1,0:06:50.14,0:06:51.50,Dial_CH,,0,0,0,,什麼巧克力
Dialogue: 1,0:06:51.97,0:06:53.96,Dial_CH,,0,0,0,,哪有肝活動重要
Dialogue: 1,0:07:09.88,0:07:11.05,Dial_CH,,0,0,0,,沙友友
Dialogue: 1,0:07:12.60,0:07:13.78,Dial_CH,,0,0,0,,嗨
Dialogue: 1,0:07:13.78,0:07:17.08,Dial_CH,,0,0,0,,冬 冬木 你在這幹嘛
Dialogue: 1,0:07:17.45,0:07:19.96,Dial_CH,,0,0,0,,我來買做巧克力的材料
Dialogue: 1,0:07:21.68,0:07:23.08,Dial_CH,,0,0,0,,這 這樣啊
Dialogue: 1,0:07:23.78,0:07:26.02,Dial_CH,,0,0,0,,沙友友也是來買東西的嗎
Dialogue: 1,0:07:27.41,0:07:30.57,Dial_CH,,0,0,0,,我啊 我來買指甲油的 這不美甲掉了嘛
Dialogue: 1,0:07:31.05,0:07:32.26,Dial_CH,,0,0,0,,我看起來也沒掉啊
Dialogue: 1,0:07:32.84,0:07:34.51,Dial_CH,,0,0,0,,還 還真是
Dialogue: 1,0:07:38.36,0:07:40.15,Dial_CH,,0,0,0,,難道沙友友是來
Dialogue: 1,0:07:40.31,0:07:42.70,Dial_CH,,0,0,0,,美妝 我是來買美妝的
Dialogue: 1,0:07:43.01,0:07:45.94,Dial_CH,,0,0,0,,對了對了 冬木你會挑
Dialogue: 1,0:07:45.94,0:07:48.28,Dial_CH,,0,0,0,,你要沒事的話幫我看看唄
Dialogue: 1,0:07:52.09,0:07:53.71,Dial_CH,,0,0,0,,謝謝惠顧
Dialogue: 1,0:07:54.43,0:07:57.80,Dial_CH,,0,0,0,,果然逛了就會想買啊
Dialogue: 1,0:07:58.36,0:08:01.18,Dial_CH,,0,0,0,,那說好分著用的我什麼時候再帶到學校吧
Dialogue: 1,0:08:01.75,0:08:02.83,Dial_CH,,0,0,0,,謝啦
Dialogue: 1,0:08:02.83,0:08:07.80,Dial_CH,,0,0,0,,我好喜歡這個情人節限定色的唇膏啊
Dialogue: 1,0:08:08.52,0:08:10.16,Dial_CH,,0,0,0,,說到情人節
Dialogue: 1,0:08:10.49,0:08:12.68,Dial_CH,,0,0,0,,沙友友喜歡什麼樣的巧克力呀
Dialogue: 1,0:08:14.26,0:08:16.07,Dial_CH,,0,0,0,,沙友友 你怎麼啦
Dialogue: 1,0:08:16.91,0:08:19.52,Dial_CH,,0,0,0,,我 我比較喜歡生巧之類的吧
Dialogue: 1,0:08:19.92,0:08:21.19,Dial_CH,,0,0,0,,我懂我懂
Dialogue: 1,0:08:21.32,0:08:25.17,Dial_CH,,0,0,0,,我每次去札幌必買Royce'的生巧
Dialogue: 1,0:08:26.49,0:08:28.32,Dial_CH,,0,0,0,,好想去札幌啊
Dialogue: 1,0:08:28.68,0:08:32.21,Dial_CH,,0,0,0,,壞了 我得趕緊去買巧克力的材料了
Dialogue: 1,0:08:33.79,0:08:35.49,Dial_CH,,0,0,0,,那我先走啦
Dialogue: 1,0:08:42.68,0:08:45.67,Dial_CH,,0,0,0,,我也和你一起去買點
Dialogue: 1,0:08:47.67,0:08:49.97,Dial_CH,,0,0,0,,但你別誤會啊 我就是
Dialogue: 1,0:08:50.17,0:08:52.34,Dial_CH,,0,0,0,,我只是打算做巧克力送你
Dialogue: 1,0:08:55.73,0:08:58.98,Dial_CH,,0,0,0,,我指定要給沙友友做超好吃的巧克力
Dialogue: 1,0:08:59.26,0:09:01.19,Dial_CH,,0,0,0,,衝啊
Dialogue: 1,0:09:01.19,0:09:03.56,Dial_CH,,0,0,0,,喂 跑什麼啊
Dialogue: 1,0:09:06.07,0:09:09.57,Dial_CH,,0,0,0,,要是做的時候有什麼不明白的就問我吧
Dialogue: 1,0:09:09.57,0:09:11.25,Dial_CH,,0,0,0,,好的 謝啦
Dialogue: 1,0:09:11.25,0:09:12.33,Dial_CH,,0,0,0,,拜拜
Dialogue: 1,0:09:16.21,0:09:17.13,Dial_CH,,0,0,0,,冬木
Dialogue: 1,0:09:18.80,0:09:19.95,Dial_CH,,0,0,0,,冬木你
Dialogue: 1,0:09:24.09,0:09:27.11,Dial_CH,,0,0,0,,你不給四季送真愛巧克力嗎
Dialogue: 1,0:09:36.96,0:09:38.89,Dial_CH,,0,0,0,,為 為什麼是翼
Dialogue: 1,0:09:38.89,0:09:41.30,Dial_CH,,0,0,0,,就是 看你倆關係還不錯…
Dialogue: 1,0:09:41.68,0:09:43.60,Dial_CH,,0,0,0,,那不是因為是好朋友嘛
Dialogue: 1,0:09:43.60,0:09:45.96,Dial_CH,,0,0,0,,沙友友不也和翼挺好的嘛
Dialogue: 1,0:09:45.96,0:09:48.69,Dial_CH,,0,0,0,,我倆就是一起玩玩遊戲而已
Dialogue: 1,0:09:53.32,0:09:55.53,Dial_CH,,0,0,0,,抱歉 我這冷不伶仃地
Dialogue: 1,0:09:55.53,0:09:57.32,Dial_CH,,0,0,0,,沒事啊
Dialogue: 1,0:09:57.32,0:09:59.25,Dial_CH,,0,0,0,,就是有點沒反應過來
Dialogue: 1,0:09:59.44,0:10:01.04,Dial_CH,,0,0,0,,那學校見
Dialogue: 1,0:10:01.81,0:10:02.75,Dial_CH,,0,0,0,,拜拜
Dialogue: 1,0:10:15.58,0:10:17.21,Dial_CH,,0,0,0,,到底是不是呢
Dialogue: 1,0:10:31.08,0:10:34.32,Dial_CH,,0,0,0,,期末考試範圍裡的應該複習得差不多了
Dialogue: 1,0:10:37.34,0:10:40.23,Dial_CH,,0,0,0,,我我我 我也沒期待什麼
Dialogue: 1,0:10:40.23,0:10:42.62,Dial_CH,,0,0,0,,馬上就要考試了 哪有功夫想那些
Dialogue: 1,0:10:43.37,0:10:44.68,Dial_CH,,0,0,0,,學學學
Dialogue: 1,0:10:56.80,0:10:58.85,Dial_CH,,0,0,0,,沙友友 還醒著嗎
Dialogue: 1,0:10:58.85,0:11:01.48,Dial_CH,,0,0,0,,我的巧克力都差不多做完啦
Dialogue: 1,0:11:01.48,0:11:03.73,Dial_CH,,0,0,0,,但有點擔心你情況如何
Dialogue: 1,0:11:07.59,0:11:08.69,Dial_CH,,0,0,0,,沙友友回覆我了
Dialogue: 1,0:11:08.88,0:11:11.59,Dial_CH,,0,0,0,,這個時間我一般都在打遊戲所以肯定醒著
Dialogue: 1,0:11:11.95,0:11:13.49,Dial_CH,,0,0,0,,這就準備做巧克力
Dialogue: 1,0:11:16.78,0:11:18.85,Dial_CH,,0,0,0,,嘿嘿 抱歉啦 突然打電話
Dialogue: 1,0:11:18.85,0:11:22.42,Dial_CH,,0,0,0,,第一次給沙友友打電話好開心啊
Dialogue: 1,0:11:23.69,0:11:25.27,Dial_CH,,0,0,0,,喔 不重要
Dialogue: 1,0:11:25.27,0:11:26.33,Dial_CH,,0,0,0,,被 被無視了
Dialogue: 1,0:11:26.49,0:11:28.74,Dial_CH,,0,0,0,,巧克力怎麼做啊
Dialogue: 1,0:11:28.96,0:11:31.29,Dial_CH,,0,0,0,,可以的話我想做個不太難的
Dialogue: 1,0:11:32.23,0:11:34.03,Dial_CH,,0,0,0,,我教你
Dialogue: 1,0:11:34.30,0:11:37.40,Dial_CH,,0,0,0,,先用菜刀把巧克力剁碎
Dialogue: 1,0:11:37.93,0:11:38.68,Dial_CH,,0,0,0,,明白
Dialogue: 1,0:11:41.97,0:11:43.60,Dial_CH,,0,0,0,,好了 然後呢
Dialogue: 1,0:11:43.60,0:11:44.66,Dial_CH,,0,0,0,,這麼快
Dialogue: 1,0:11:44.96,0:11:47.69,Dial_CH,,0,0,0,,今天不是一起買了鮮奶油嗎
Dialogue: 1,0:11:47.69,0:11:50.44,Dial_CH,,0,0,0,,把那個倒進碗裡 水浴加熱
Dialogue: 1,0:11:50.44,0:11:51.44,Dial_CH,,0,0,0,,什麼水浴
Dialogue: 1,0:11:51.44,0:11:53.84,Dial_CH,,0,0,0,,水浴啊 就是把別的容器
Dialogue: 1,0:11:53.84,0:11:56.56,Dial_CH,,0,0,0,,整個放到熱水裡加熱
Dialogue: 1,0:11:56.56,0:11:57.78,Dial_CH,,0,0,0,,懂了
Dialogue: 1,0:11:58.25,0:12:01.28,Dial_CH,,0,0,0,,鮮奶油和巧克力要1:2喔
Dialogue: 1,0:12:01.28,0:12:02.69,Dial_CH,,0,0,0,,那大概是這麼多吧
Dialogue: 1,0:12:05.25,0:12:07.86,Dial_CH,,0,0,0,,關火後放入切碎的巧克力
Dialogue: 1,0:12:07.86,0:12:10.21,Dial_CH,,0,0,0,,攪拌至融化均勻
Dialogue: 1,0:12:10.59,0:12:13.13,Dial_CH,,0,0,0,,然後放入冰箱冷凍一兩個小時
Dialogue: 1,0:12:13.54,0:12:15.76,Dial_CH,,0,0,0,,凝固後切成你想要的形狀
Dialogue: 1,0:12:15.76,0:12:17.88,Dial_CH,,0,0,0,,再撒上可可粉就大功告成了
Dialogue: 1,0:12:18.07,0:12:20.27,Dial_CH,,0,0,0,,還真的挺簡單的
Dialogue: 1,0:12:20.65,0:12:22.54,Dial_CH,,0,0,0,,你做的巧克力是什麼樣的
Dialogue: 1,0:12:23.60,0:12:25.31,Dial_CH,,0,0,0,,我的啊
Dialogue: 1,0:12:27.18,0:12:29.52,Dial_CH,,0,0,0,,明天再揭秘
Dialogue: 1,0:12:29.95,0:12:31.76,Dial_CH,,0,0,0,,一共做了多少
Dialogue: 1,0:12:31.76,0:12:34.49,Dial_CH,,0,0,0,,70個 打破了去年的紀錄
Dialogue: 1,0:12:34.49,0:12:36.95,Dial_CH,,0,0,0,,你朋友多得嚇人啊
Dialogue: 1,0:12:37.28,0:12:39.42,Dial_CH,,0,0,0,,虧你還這麼有動力
Dialogue: 1,0:12:39.42,0:12:41.94,Dial_CH,,0,0,0,,因為大家都會很開心呀
Dialogue: 1,0:12:41.94,0:12:46.38,Dial_CH,,0,0,0,,而且對方收到後的反應肯定會很有趣
Dialogue: 1,0:12:46.38,0:12:48.41,Dial_CH,,0,0,0,,我光想想就激動死了
Dialogue: 1,0:12:49.18,0:12:52.04,Dial_CH,,0,0,0,,這麼一想 我才是最樂在其中的
Dialogue: 1,0:12:52.83,0:12:56.22,Dial_CH,,0,0,0,,沙友友是想著給誰呢
Dialogue: 1,0:12:57.25,0:12:59.32,Dial_CH,,0,0,0,,不是說了要給你了嗎
Dialogue: 1,0:12:59.32,0:13:01.54,Dial_CH,,0,0,0,,別老問我 害羞
Dialogue: 1,0:13:02.07,0:13:03.45,Dial_CH,,0,0,0,,開心
Dialogue: 1,0:13:06.07,0:13:07.06,Dial_CH,,0,0,0,,還有嗎
Dialogue: 1,0:13:07.89,0:13:09.80,Dial_CH,,0,0,0,,不打算送別人嗎
Dialogue: 1,0:13:11.55,0:13:13.80,Dial_CH,,0,0,0,,我一直挺在意的
Dialogue: 1,0:13:15.01,0:13:16.88,Dial_CH,,0,0,0,,難道沙友友你
Dialogue: 1,0:13:18.15,0:13:19.45,Dial_CH,,0,0,0,,對翼
Dialogue: 1,0:13:21.41,0:13:21.78,Dial_CH,,0,0,0,,有好…
Dialogue: 1,0:13:25.95,0:13:27.33,Dial_CH,,0,0,0,,別啊
Dialogue: 1,0:13:28.14,0:13:30.46,Dial_CH,,0,0,0,,喂 沒事吧 怎麼了
Dialogue: 1,0:13:30.67,0:13:31.96,Dial_CH,,0,0,0,,發生什麼事了
Dialogue: 1,0:13:32.14,0:13:33.02,Dial_CH,,0,0,0,,冬木
Dialogue: 1,0:13:33.67,0:13:37.97,Dial_CH,,0,0,0,,調料和醬油灑在我做好的巧克力上了
Dialogue: 1,0:13:39.03,0:13:40.63,Dial_CH,,0,0,0,,巧克力沒事吧
Dialogue: 1,0:13:41.37,0:13:43.37,Dial_CH,,0,0,0,,都沾上醬油了
Dialogue: 1,0:13:43.62,0:13:45.12,Dial_CH,,0,0,0,,別是全部吧
Dialogue: 1,0:13:45.12,0:13:46.61,Dial_CH,,0,0,0,,全軍覆沒了
Dialogue: 1,0:13:47.69,0:13:49.01,Dial_CH,,0,0,0,,冬木
Dialogue: 1,0:13:49.01,0:13:53.28,Dial_CH,,0,0,0,,沒事 都怪咱沒有好好收拾
Dialogue: 1,0:13:53.62,0:13:55.83,Dial_CH,,0,0,0,,生巧你自己會處理了吧
Dialogue: 1,0:13:55.83,0:13:58.30,Dial_CH,,0,0,0,,還記得剛剛說的後續工序嗎
Dialogue: 1,0:14:01.14,0:14:02.37,Dial_CH,,0,0,0,,那敢情好
Dialogue: 1,0:14:02.37,0:14:05.18,Dial_CH,,0,0,0,,我得收拾收拾殘局了 先掛了啊
Dialogue: 1,0:14:05.43,0:14:06.03,Dial_CH,,0,0,0,,喂
Dialogue: 1,0:14:13.05,0:14:14.98,Dial_CH,,0,0,0,,你也太老好人了吧
Dialogue: 1,0:14:22.79,0:14:26.61,Dial_CH,,0,0,0,,唉 昨天光顧著學習
Dialogue: 1,0:14:26.61,0:14:28.55,Dial_CH,,0,0,0,,都沒怎麼睡
Dialogue: 1,0:14:31.53,0:14:33.52,Dial_CH,,0,0,0,,唉 真的
Dialogue: 1,0:14:36.54,0:14:38.45,Dial_CH,,0,0,0,,來
Dialogue: 1,0:14:40.31,0:14:41.65,Dial_CH,,0,0,0,,就知道沒有
Dialogue: 1,0:14:45.32,0:14:47.10,Dial_CH,,0,0,0,,翼 早安
Dialogue: 1,0:14:49.10,0:14:51.16,Dial_CH,,0,0,0,,早 早安 冬木同學
Dialogue: 1,0:14:51.87,0:14:52.50,Dial_CH,,0,0,0,,嗯？
Dialogue: 1,0:14:53.15,0:14:54.19,Dial_CH,,0,0,0,,冬木同學
Dialogue: 1,0:14:54.50,0:14:56.33,Dial_CH,,0,0,0,,眼角有點紅
Dialogue: 1,0:14:56.33,0:14:58.51,Dial_CH,,0,0,0,,來 這是送給你的
Dialogue: 1,0:15:00.06,0:15:01.14,Dial_CH,,0,0,0,,難道說
Dialogue: 1,0:15:02.36,0:15:03.30,Dial_CH,,0,0,0,,這就是
Dialogue: 1,0:15:03.30,0:15:05.05,Dial_CH,,0,0,0,,情人節嘛
Dialogue: 1,0:15:05.05,0:15:06.59,Dial_CH,,0,0,0,,這款挺好吃的
Dialogue: 1,0:15:06.59,0:15:08.48,Dial_CH,,0,0,0,,東京應該不常見吧
Dialogue: 1,0:15:09.14,0:15:10.64,Dial_CH,,0,0,0,,謝謝 冬木同學
Dialogue: 1,0:15:10.64,0:15:12.43,Dial_CH,,0,0,0,,我一定會好好珍惜的
Dialogue: 1,0:15:18.12,0:15:19.64,Dial_CH,,0,0,0,,早安 沙友友
Dialogue: 1,0:15:19.64,0:15:20.86,Dial_CH,,0,0,0,,這個給你
Dialogue: 1,0:15:22.08,0:15:23.12,Dial_CH,,0,0,0,,這是
Dialogue: 1,0:15:27.57,0:15:28.00,Dial_CH,,0,0,0,,冬…
Dialogue: 1,0:15:28.00,0:15:30.35,Dial_CH,,0,0,0,,冬美 我的巧克力呢
Dialogue: 1,0:15:30.35,0:15:31.74,Dial_CH,,0,0,0,,Okk
Dialogue: 1,0:15:33.20,0:15:34.84,Dial_CH,,0,0,0,,怎麼不是自己做的
Dialogue: 1,0:15:34.84,0:15:38.31,Dial_CH,,0,0,0,,今年情況特殊 暫時停產啦
Dialogue: 1,0:15:38.31,0:15:40.62,Dial_CH,,0,0,0,,什麼嘛 我還滿心期待呢
Dialogue: 1,0:15:40.62,0:15:42.04,Dial_CH,,0,0,0,,不好意思啦
Dialogue: 1,0:15:42.04,0:15:44.26,Dial_CH,,0,0,0,,反正給也給了 你少抱怨兩句
Dialogue: 1,0:15:45.39,0:15:47.69,Dial_CH,,0,0,0,,真失望了
Dialogue: 1,0:15:49.09,0:15:50.62,Dial_CH,,0,0,0,,松尾
Dialogue: 1,0:15:52.17,0:15:53.19,Dial_CH,,0,0,0,,怎麼了怎麼了
Dialogue: 1,0:15:53.83,0:15:56.40,Dial_CH,,0,0,0,,今年她沒做巧克力啊
Dialogue: 1,0:15:56.67,0:15:57.98,Dial_CH,,0,0,0,,發生了什麼意外嗎
Dialogue: 1,0:15:58.41,0:16:00.07,Dial_CH,,0,0,0,,謝謝你 再見
Dialogue: 1,0:16:02.13,0:16:02.77,Dial_CH,,0,0,0,,喂
Dialogue: 1,0:16:03.56,0:16:05.74,Dial_CH,,0,0,0,,你再敢對冬木說那種話
Dialogue: 1,0:16:06.60,0:16:08.15,Dial_CH,,0,0,0,,當心我削你
Dialogue: 1,0:16:27.13,0:16:30.18,Dial_CH,,0,0,0,,今天起社團活動因考試全面暫停
Dialogue: 1,0:16:30.47,0:16:33.91,Dial_CH,,0,0,0,,不值日的同學都盡早回家
Dialogue: 1,0:16:45.46,0:16:48.11,Dial_CH,,0,0,0,,就剩扔垃圾了
Dialogue: 1,0:16:48.35,0:16:51.06,Dial_CH,,0,0,0,,交給你們了啊
Dialogue: 1,0:16:53.29,0:16:57.50,Dial_CH,,0,0,0,,平常總能聽見吹奏部的練習
Dialogue: 1,0:16:57.50,0:17:01.00,Dial_CH,,0,0,0,,現在這麼安靜總覺得有點不適應
Dialogue: 1,0:17:01.00,0:17:01.92,Dial_CH,,0,0,0,,是啊
Dialogue: 1,0:17:02.29,0:17:04.02,Dial_CH,,0,0,0,,像只有咱倆一樣
Dialogue: 1,0:17:05.57,0:17:08.96,Dial_CH,,0,0,0,,對 對了 感謝你的巧克力
Dialogue: 1,0:17:09.30,0:17:11.25,Dial_CH,,0,0,0,,我打算回家再吃
Dialogue: 1,0:17:13.41,0:17:14.28,Dial_CH,,0,0,0,,冬木同學
Dialogue: 1,0:17:29.37,0:17:30.31,Dial_CH,,0,0,0,,冬木同學
Dialogue: 1,0:17:31.82,0:17:36.12,Dial_CH,,0,0,0,,你要是不介意 能跟我講講嗎
Dialogue: 1,0:17:40.27,0:17:41.96,Dial_CH,,0,0,0,,是這樣啊
Dialogue: 1,0:17:42.42,0:17:45.55,Dial_CH,,0,0,0,,做好的巧克力都吃不了了
Dialogue: 1,0:17:45.84,0:17:49.32,Dial_CH,,0,0,0,,其實也有個別看起來還行的
Dialogue: 1,0:17:49.68,0:17:53.21,Dial_CH,,0,0,0,,有只壞了一點點的 沾了點牛奶的
Dialogue: 1,0:17:53.93,0:17:57.45,Dial_CH,,0,0,0,,但我就是不想把這種瑕疵品送給別人
Dialogue: 1,0:17:58.95,0:18:00.73,Dial_CH,,0,0,0,,但我還是止不住地想
Dialogue: 1,0:18:01.77,0:18:04.31,Dial_CH,,0,0,0,,想送別人自己親手做的巧克力
Dialogue: 1,0:18:06.30,0:18:09.19,Dial_CH,,0,0,0,,想著我是不是讓大家失望了
Dialogue: 1,0:18:12.12,0:18:15.44,Dial_CH,,0,0,0,,想讓你也能嚐嚐
Dialogue: 1,0:18:22.21,0:18:27.18,Dial_CH,,0,0,0,,媽媽都提醒我了 讓我收拾好 我也沒聽進去
Dialogue: 1,0:18:27.59,0:18:31.87,Dial_CH,,0,0,0,,還讓電話那頭的朋友擔心了
Dialogue: 1,0:18:32.44,0:18:34.26,Dial_CH,,0,0,0,,肯定是我太得意
Dialogue: 1,0:18:34.26,0:18:36.06,Dial_CH,,0,0,0,,結果糟了天譴
Dialogue: 1,0:18:44.20,0:18:45.31,Dial_CH,,0,0,0,,翼
Dialogue: 1,0:18:52.25,0:18:53.04,Dial_CH,,0,0,0,,現在
Dialogue: 1,0:18:54.86,0:18:56.74,Dial_CH,,0,0,0,,我唯一能做的是
Dialogue: 1,0:19:49.30,0:19:50.51,Dial_CH,,0,0,0,,這是
Dialogue: 1,0:19:51.51,0:19:53.63,Dial_CH,,0,0,0,,你在KTV裡唱過的歌
Dialogue: 1,0:19:54.31,0:19:56.08,Dial_CH,,0,0,0,,我學過鋼琴
Dialogue: 1,0:19:56.08,0:19:59.64,Dial_CH,,0,0,0,,盡可能靠記憶彈出來了 好聽嗎
Dialogue: 1,0:20:00.62,0:20:02.84,Dial_CH,,0,0,0,,厲害 彈得特別好
Dialogue: 1,0:20:03.46,0:20:05.27,Dial_CH,,0,0,0,,為什麼要彈這首歌
Dialogue: 1,0:20:05.89,0:20:09.13,Dial_CH,,0,0,0,,因為你總是能帶給我許多歡樂
Dialogue: 1,0:20:09.40,0:20:12.03,Dial_CH,,0,0,0,,所以我也想為你帶來歡樂
Dialogue: 1,0:20:14.27,0:20:16.24,Dial_CH,,0,0,0,,我超喜歡這首歌
Dialogue: 1,0:20:16.69,0:20:18.45,Dial_CH,,0,0,0,,是不是聽了就開心啊
Dialogue: 1,0:20:21.46,0:20:25.05,Dial_CH,,0,0,0,,你啊 說真的 怎麼總能做出這種事呢
Dialogue: 1,0:20:26.48,0:20:28.75,Dial_CH,,0,0,0,,我現在超高興
Dialogue: 1,0:20:29.15,0:20:32.10,Dial_CH,,0,0,0,,眼淚都給我笑出來了
Dialogue: 1,0:20:32.10,0:20:34.22,Dial_CH,,0,0,0,,你怎麼這麼會啊
Dialogue: 1,0:20:34.22,0:20:35.52,Dial_CH,,0,0,0,,太好了
Dialogue: 1,0:20:37.06,0:20:38.26,Dial_CH,,0,400,0,,秋野同學
Dialogue: 1,0:20:37.06,0:20:38.26,Dial_CH,,400,0,0,,沙友友
Dialogue: 1,0:20:38.67,0:20:40.03,Dial_CH,,0,0,0,,你怎麼會在這裡
Dialogue: 1,0:20:41.04,0:20:44.80,Dial_CH,,0,0,0,,就那個 來送巧克力的
Dialogue: 1,0:20:48.41,0:20:49.48,Dial_CH,,0,0,0,,是嗎
Dialogue: 1,0:20:49.48,0:20:51.42,Dial_CH,,0,0,0,,那我就先走了啊
Dialogue: 1,0:20:53.10,0:20:54.02,Dial_CH,,0,0,0,,給你的
Dialogue: 1,0:20:56.75,0:20:59.37,Dial_CH,,0,0,0,,別告訴我你忘了啊 約好的
Dialogue: 1,0:20:59.37,0:21:00.07,Dial_CH,,0,0,0,,友情巧克力
Dialogue: 1,0:21:00.36,0:21:02.64,Dial_CH,,0,0,0,,友情巧克力
Dialogue: 1,0:21:03.39,0:21:06.48,Dial_CH,,0,0,0,,沙… 沙友友 愛死你了
Dialogue: 1,0:21:06.48,0:21:09.10,Dial_CH,,0,0,0,,哎 不是 鼻涕別蹭我身上
Dialogue: 1,0:21:09.10,0:21:10.72,Dial_CH,,0,0,0,,我能現在打開嗎
Dialogue: 1,0:21:11.16,0:21:12.95,Dial_CH,,0,0,0,,可以是可以 你要現在吃嗎
Dialogue: 1,0:21:13.38,0:21:14.86,Dial_CH,,0,0,0,,就想現在吃啊
Dialogue: 1,0:21:15.06,0:21:16.48,Dial_CH,,0,600,0,,搞得我怪尷尬的
Dialogue: 1,0:21:15.59,0:21:16.70,Dial_CH,,0,0,0,,尷尬死了
Dialogue: 1,0:21:16.70,0:21:20.55,Dial_CH,,0,0,0,,我那反應明顯就是以為要給我啊
Dialogue: 1,0:21:20.84,0:21:21.89,Dial_CH,,0,0,0,,想就地挖個坑
Dialogue: 1,0:21:21.89,0:21:24.55,Dial_CH,,0,0,0,,把自己給埋了
Dialogue: 1,0:21:25.15,0:21:26.04,Dial_CH,,0,0,0,,四季
Dialogue: 1,0:21:26.94,0:21:27.91,Dial_CH,,0,0,0,,收著吧
Dialogue: 1,0:21:29.95,0:21:31.00,Dial_CH,,0,0,0,,我 我也有份嗎
Dialogue: 1,0:21:31.00,0:21:32.96,Dial_CH,,0,0,0,,好說歹說也是師徒
Dialogue: 1,0:21:33.21,0:21:35.82,Dial_CH,,0,0,0,,正好給冬木做完巧克力還剩了點料
Dialogue: 1,0:21:37.62,0:21:39.40,Dial_CH,,0,0,0,,謝謝 秋野同學
Dialogue: 1,0:21:41.69,0:21:44.53,Dial_CH,,0,0,0,,你剛剛彈鋼琴的樣子 挺帥的
Dialogue: 1,0:21:49.11,0:21:50.77,Dial_CH,,0,0,0,,好吃
Dialogue: 1,0:21:50.77,0:21:53.31,Dial_CH,,0,0,0,,沙友友 你做的這個超好吃
Dialogue: 1,0:21:53.53,0:21:55.88,Dial_CH,,0,0,0,,真的嗎 但我第一次做
Dialogue: 1,0:21:56.77,0:21:59.00,Dial_CH,,0,0,0,,翼也有份呢
Dialogue: 1,0:21:59.00,0:22:01.01,Dial_CH,,0,0,0,,但和你一樣也是友情巧克力
Dialogue: 1,0:22:01.01,0:22:04.09,Dial_CH,,0,0,0,,咱三人一起吃嘛
Dialogue: 1,0:22:04.71,0:22:05.40,Dial_CH,,0,0,0,,好
Dialogue: 1,0:22:05.69,0:22:08.49,Dial_CH,,0,0,0,,你給的巧克力還在口袋裡呢
Dialogue: 1,0:22:08.49,0:22:10.68,Dial_CH,,0,0,0,,可以一起吃吧
Dialogue: 1,0:22:11.09,0:22:12.90,Dial_CH,,0,0,0,,你送我的也在書包裡
Dialogue: 1,0:22:13.10,0:22:14.86,Dial_CH,,0,0,0,,好呀好呀
Dialogue: 1,0:22:14.86,0:22:17.11,Dial_CH,,0,0,0,,開巧克力派對囉
