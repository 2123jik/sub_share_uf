Dialogue: 0,0:04:03.89,0:04:08.19,Title_CHT,,0,0,0,,{\fad(100,270)\blur5\pos(75,490)}第4話\N夜{\fscx118}　{\fscx100}的電話超讓人心癢癢
Dialogue: 0,0:04:03.89,0:04:08.19,Title_CHS,,0,0,0,,{\fad(100,270)\blur5\pos(110,552)}晚
Dialogue: 4,0:00:10.37,0:00:11.18,Dial_JP,,0,0,0,,ってて
Dialogue: 4,0:00:15.63,0:00:19.79,Dial_JP,,0,0,0,,本当に学校行けるのかな　この吹雪で
Dialogue: 4,0:00:20.08,0:00:22.96,Dial_JP,,0,0,0,,おまけに昨日のスキーで筋肉痛
Dialogue: 4,0:00:23.95,0:00:26.42,Dial_JP,,0,0,0,,北海道は試される大地
Dialogue: 4,0:00:28.26,0:00:32.60,Dial_JP,,0,0,0,,この吹雪を乗り越えて　真の道民になるのです
Dialogue: 4,0:00:33.37,0:00:34.39,Dial_JP,,0,0,0,,おばあちゃん
Dialogue: 4,0:00:35.77,0:00:37.52,Dial_JP,,0,0,0,,俺　頑張るよ
Dialogue: 4,0:00:38.21,0:00:39.15,Dial_JP,,0,0,0,,いってきます
Dialogue: 4,0:01:03.37,0:01:05.78,Dial_JP,,0,0,0,,無理　無理　無理
Dialogue: 4,0:01:07.92,0:01:09.17,Dial_JP,,0,0,0,,寒すぎる
Dialogue: 4,0:01:09.74,0:01:11.36,Dial_JP,,0,0,0,,筋肉痛　痛い
Dialogue: 4,0:01:11.81,0:01:14.33,Dial_JP,,0,0,0,,雪が顔に当たる　痛い
Dialogue: 4,0:01:15.82,0:01:18.64,Dial_JP,,0,0,0,,冷たい通り越して刺さってる
Dialogue: 4,0:01:19.94,0:01:22.88,Dial_JP,,0,0,0,,目の前も真っ白で全然見えないし
Dialogue: 4,0:01:23.37,0:01:25.25,Dial_JP,,0,0,0,,きびきび動けないし
Dialogue: 4,0:01:25.56,0:01:27.69,Dial_JP,,0,0,0,,ほぼもう遭難だ　これ
Dialogue: 4,0:01:33.15,0:01:36.08,Dial_JP,,0,0,0,,冬木さんは　こんな日でも
Dialogue: 4,0:01:36.50,0:01:39.16,Dial_JP,,0,0,0,,いつもみたいに登校してるんだろうなぁ
Dialogue: 4,0:01:49.42,0:01:50.31,Dial_JP,,0,0,0,,よし
Dialogue: 4,0:01:52.42,0:01:53.26,Dial_JP,,0,0,0,,すみません
Dialogue: 4,0:01:57.25,0:01:58.39,Dial_JP,,0,0,0,,死ぬ
Dialogue: 4,0:02:05.72,0:02:07.25,Dial_JP,,0,0,0,,走馬灯が見える
Dialogue: 4,0:02:08.97,0:02:11.08,Dial_JP,,0,0,0,,さよなら　北海道
Dialogue: 4,0:02:11.98,0:02:14.45,Dial_JP,,0,0,0,,さよなら　俺の人生
Dialogue: 4,0:02:14.45,0:02:16.41,Dial_JP,,0,0,0,,ちょっとなしたの
Dialogue: 4,0:02:16.68,0:02:19.67,Dial_JP,,0,0,0,,こんなふぶいてるのに歩きはわや
Dialogue: 4,0:02:20.06,0:02:22.12,Dial_JP,,0,0,0,,車で一緒に行こうよ
Dialogue: 4,0:02:23.92,0:02:26.36,Dial_JP,,0,0,0,,これは　あの世
Dialogue: 4,0:02:26.36,0:02:28.82,Dial_JP,,0,0,0,,いいから　早く乗んな
Dialogue: 4,0:02:29.09,0:02:32.51,Dial_JP,,0,0,0,,イッ　アッダァ
Dialogue: 4,0:04:06.31,0:04:08.98,Dial_JP,,500,0,0,,お…　おはようございます
Dialogue: 4,0:04:09.44,0:04:11.48,Dial_JP,,0,0,0,,すみません　急に
Dialogue: 4,0:04:11.48,0:04:13.83,Dial_JP,,0,0,0,,ママ　車出していいよ
Dialogue: 4,0:04:14.46,0:04:15.96,Dial_JP,,0,0,0,,おけまる
Dialogue: 4,0:04:16.80,0:04:18.62,Dial_JP,,0,0,0,,今日しばれるしょ
Dialogue: 4,0:04:18.86,0:04:22.54,Dial_JP,,0,0,0,,なんも遠慮しないで　自分ちみたいにくつろいじゃって
Dialogue: 4,0:04:23.15,0:04:24.14,Dial_JP,,0,0,0,,ギャルだ
Dialogue: 4,0:04:25.08,0:04:27.38,Dial_JP,,0,0,0,,というか　お母さん？
Dialogue: 4,0:04:27.60,0:04:29.67,Dial_JP,,0,0,0,,お姉さんじゃなくて　お母さん
Dialogue: 4,0:04:29.95,0:04:32.01,Dial_JP,,0,0,0,,そして冬木さんにそっくり
Dialogue: 4,0:04:32.36,0:04:34.62,Dial_JP,,0,0,0,,これが血脈の力
Dialogue: 4,0:04:35.23,0:04:37.45,Dial_JP,,0,0,0,,翼んちは豪邸だから
Dialogue: 4,0:04:37.45,0:04:39.99,Dial_JP,,0,0,0,,うちの車じゃ狭くてくつろげないでしょ
Dialogue: 4,0:04:39.99,0:04:42.33,Dial_JP,,0,0,0,,いっ　いや　そんなことは
Dialogue: 4,0:04:42.93,0:04:45.04,Dial_JP,,0,0,0,,この子が最近みーがよく話す
Dialogue: 4,0:04:45.04,0:04:47.36,Dial_JP,,0,0,0,,お城みたいな家に住んでるお坊ちゃま
Dialogue: 4,0:04:47.36,0:04:49.39,Dial_JP,,0,0,0,,お…　お坊ちゃま
Dialogue: 4,0:04:50.47,0:04:54.24,Dial_JP,,0,0,0,,したっけ　もっとちゃんとメイクしてくればよかったぁ
Dialogue: 4,0:04:54.24,0:04:57.28,Dial_JP,,0,0,0,,もうママ　なに翼にアピってんの
Dialogue: 4,0:04:57.28,0:04:58.11,Dial_JP,,0,0,0,,あぴっ？
Dialogue: 4,0:04:58.46,0:04:59.96,Dial_JP,,0,0,0,,そっか　そっか
Dialogue: 4,0:04:59.96,0:05:01.99,Dial_JP,,0,0,0,,君がうわさの翼くんかぁ
Dialogue: 4,0:05:03.70,0:05:05.70,Dial_JP,,0,0,0,,なんだ　このもどかしさは
Dialogue: 4,0:05:05.70,0:05:09.11,Dial_JP,,0,0,0,,翼くんはさぁ　地元に彼女とかいるの
Dialogue: 4,0:05:09.11,0:05:09.66,Dial_JP,,0,0,0,,かっ…
Dialogue: 4,0:05:09.91,0:05:11.82,Dial_JP,,0,0,0,,何その慌てっぷり
Dialogue: 4,0:05:12.44,0:05:13.91,Dial_JP,,500,0,0,,イデデデ
Dialogue: 4,0:05:12.80,0:05:13.40,Dial_JP,,0,600,0,,あれ
Dialogue: 4,0:05:14.10,0:05:16.12,Dial_JP,,0,0,0,,ごめん　大丈夫
Dialogue: 4,0:05:16.64,0:05:19.88,Dial_JP,,0,0,0,,いっ　いや　筋肉痛で
Dialogue: 4,0:05:20.59,0:05:24.44,Dial_JP,,0,0,0,,スキー授業でふだん使わない筋肉を使ったから…
Dialogue: 4,0:05:24.98,0:05:26.16,Dial_JP,,0,0,0,,ありゃま
Dialogue: 4,0:05:26.78,0:05:28.96,Dial_JP,,0,0,0,,したっけ　あれだね
Dialogue: 4,0:05:29.71,0:05:32.90,Dial_JP,,0,0,0,,翼とはあんまり激しい運動できないねぇ
Dialogue: 4,0:05:33.23,0:05:34.90,Dial_JP,,0,0,0,,いや　言い方…
Dialogue: 4,0:05:36.48,0:05:38.64,Dial_JP,,0,0,0,,みーは体力あるからねぇ
Dialogue: 4,0:05:38.64,0:05:41.24,Dial_JP,,0,0,0,,一日中ぶっ通しでも平気だもんね
Dialogue: 4,0:05:41.83,0:05:43.45,Dial_JP,,0,0,0,,こっちもなかなか
Dialogue: 4,0:05:44.44,0:05:46.35,Dial_JP,,0,0,0,,冬木さんは元気だね
Dialogue: 4,0:05:46.35,0:05:48.34,Dial_JP,,0,0,0,,うちは全然平気
Dialogue: 4,0:05:48.34,0:05:49.92,Dial_JP,,0,0,0,,そ　そうなんだ
Dialogue: 4,0:05:51.87,0:05:53.95,Dial_JP,,0,0,0,,えっと　あの…
Dialogue: 4,0:05:54.27,0:05:55.98,Dial_JP,,0,0,0,,彼女とかはいません
Dialogue: 4,0:05:56.45,0:05:57.99,Dial_JP,,0,0,0,,もったいない
Dialogue: 4,0:05:57.99,0:05:58.70,Dial_JP,,0,0,0,,いえ
Dialogue: 4,0:05:58.70,0:06:00.78,Dial_JP,,0,0,0,,もったいないって言われても
Dialogue: 4,0:06:00.78,0:06:03.18,Dial_JP,,0,0,0,,うちのみーはどう　めんこくない
Dialogue: 4,0:06:03.18,0:06:06.73,Dial_JP,,0,0,0,,ちょっと　ママ　ハズいからガチでやめてよ
Dialogue: 4,0:06:07.06,0:06:11.56,Dial_JP,,0,0,0,,この感じ　冬木さんと初めて会ったころを思い出す
Dialogue: 4,0:06:11.78,0:06:15.87,Dial_JP,,0,0,0,,だって翼くん　うちのパパに似ててめんこいんだもん
Dialogue: 4,0:06:15.87,0:06:18.11,Dial_JP,,0,0,0,,ママ　久々にキュンキュンしちゃう
Dialogue: 4,0:06:18.48,0:06:20.91,Dial_JP,,0,0,0,,みー・アンド・つばちのみつばちカップル
Dialogue: 4,0:06:20.91,0:06:23.04,Dial_JP,,0,0,0,,なまらめんこいと思うんだけどなぁ
Dialogue: 4,0:06:23.04,0:06:26.76,Dial_JP,,0,0,0,,勢いが怒とうすぎてどう反応していいかわからない
Dialogue: 4,0:06:27.02,0:06:27.99,Dial_JP,,0,0,0,,ママ
Dialogue: 4,0:06:33.76,0:06:37.04,Dial_JP,,0,0,0,,いや　そんなガチで怒んないでよ
Dialogue: 4,0:06:37.04,0:06:39.71,Dial_JP,,0,0,0,,初めてつばちに会えてアガっちゃったんだもん
Dialogue: 4,0:06:41.37,0:06:44.33,Dial_JP,,0,0,0,,冬木さんって　怒るとこうなるんだ
Dialogue: 4,0:06:44.60,0:06:47.35,Dial_JP,,0,0,0,,全然怖くないけど気をつけよう
Dialogue: 4,0:06:53.99,0:06:56.41,Dial_JP,,0,0,0,,つばちは東京から来たんだよね
Dialogue: 4,0:06:56.41,0:06:58.40,Dial_JP,,0,0,0,,こんな吹雪は初めてでしょ
Dialogue: 4,0:06:58.40,0:07:01.75,Dial_JP,,0,0,0,,正直なぜ休校にならないんだと思いました
Dialogue: 4,0:07:01.75,0:07:03.43,Dial_JP,,0,0,0,,いや　それな
Dialogue: 4,0:07:03.43,0:07:04.74,Dial_JP,,0,0,0,,でもねぇ翼
Dialogue: 4,0:07:04.74,0:07:07.36,Dial_JP,,0,0,0,,これくらいだと休みにならないのさぁ
Dialogue: 4,0:07:07.93,0:07:10.83,Dial_JP,,0,0,0,,もし東京でこれくらい雪が降ってたら
Dialogue: 4,0:07:10.83,0:07:13.76,Dial_JP,,0,0,0,,世界の終わりみたいな騒ぎになる気がするよ
Dialogue: 4,0:07:13.76,0:07:15.87,Dial_JP,,0,0,0,,ニュースになるもんね
Dialogue: 4,0:07:15.87,0:07:17.63,Dial_JP,,0,0,0,,こっちだと普通なのに
Dialogue: 4,0:07:18.00,0:07:21.62,Dial_JP,,0,0,0,,東京からしたら　こっちが普通じゃないんでしょ
Dialogue: 4,0:07:21.62,0:07:23.58,Dial_JP,,0,0,0,,でも少し意外でした
Dialogue: 4,0:07:25.08,0:07:27.46,Dial_JP,,0,0,0,,道民の方は寒さにお強いので
Dialogue: 4,0:07:27.46,0:07:30.22,Dial_JP,,0,0,0,,こういうときも普通に外に出られるのかと
Dialogue: 4,0:07:30.50,0:07:32.39,Dial_JP,,0,0,0,,ないないない
Dialogue: 4,0:07:38.32,0:07:41.04,Dial_JP,,0,0,0,,汽車とかバス以外で通学してる子たちは
Dialogue: 4,0:07:41.04,0:07:43.83,Dial_JP,,0,0,0,,親とかに送迎してもらうこと多いよ
Dialogue: 4,0:07:44.34,0:07:45.65,Dial_JP,,0,0,0,,そうなんですか
Dialogue: 4,0:07:45.65,0:07:47.49,Dial_JP,,0,0,0,,冬とかはわりとね
Dialogue: 4,0:07:47.92,0:07:51.22,Dial_JP,,0,0,0,,うちはオシャレのために気合いで薄着してるけど
Dialogue: 4,0:07:51.22,0:07:54.47,Dial_JP,,0,0,0,,普通に寒いから　冬は外出たくない
Dialogue: 4,0:07:54.47,0:07:56.45,Dial_JP,,0,0,0,,そ　そうなんだ
Dialogue: 4,0:07:56.45,0:07:59.16,Dial_JP,,0,0,0,,おばあちゃんの言う真の道民って
Dialogue: 4,0:07:59.16,0:08:00.94,Dial_JP,,0,0,0,,いったいなんだったんだろう
Dialogue: 4,0:08:01.51,0:08:04.26,Dial_JP,,0,0,0,,でも冬コーデってゲキ高すぎて
Dialogue: 4,0:08:04.26,0:08:06.95,Dial_JP,,0,0,0,,先にお財布が凍死するんだよね
Dialogue: 4,0:08:07.28,0:08:09.33,Dial_JP,,0,0,0,,ブーツとかコートとか
Dialogue: 4,0:08:09.33,0:08:12.16,Dial_JP,,0,0,0,,冬長いから　服代がヤバい
Dialogue: 4,0:08:12.42,0:08:17.08,Dial_JP,,0,0,0,,うちもお小遣いじゃ欲しい服全然買えないから　バイトしたい
Dialogue: 4,0:08:17.08,0:08:19.09,Dial_JP,,0,0,0,,みーはまだバイトダメ
Dialogue: 4,0:08:19.40,0:08:20.68,Dial_JP,,0,0,0,,なしてぇ
Dialogue: 4,0:08:20.68,0:08:22.69,Dial_JP,,0,0,0,,パパもダメって言うし
Dialogue: 4,0:08:23.16,0:08:25.35,Dial_JP,,0,0,0,,仲むつまじい親子だなぁ
Dialogue: 4,0:08:25.82,0:08:28.15,Dial_JP,,0,0,0,,北海道のギャルは大変そうだ
Dialogue: 4,0:08:28.69,0:08:29.65,Dial_JP,,0,0,0,,でも
Dialogue: 4,0:08:29.65,0:08:33.53,Dial_JP,,0,0,0,,２人とも今のままで　十分きれいだけどなぁ
Dialogue: 4,0:08:42.54,0:08:44.52,Dial_JP,,0,0,0,,つ…　つばち
Dialogue: 4,0:08:44.52,0:08:46.64,Dial_JP,,0,0,0,,そんな褒めてもなんにも出ないよ
Dialogue: 4,0:08:46.64,0:08:50.61,Dial_JP,,0,0,0,,ホント翼　たまにそういうことするからね
Dialogue: 4,0:08:50.61,0:08:53.49,Dial_JP,,0,0,0,,しまった　また声に出てた
Dialogue: 4,0:08:57.89,0:08:59.38,Dial_JP,,0,0,0,,着いたよー
Dialogue: 4,0:08:59.80,0:09:03.27,Dial_JP,,0,0,0,,ありがとうございました　本当に助かりました
Dialogue: 4,0:09:04.36,0:09:06.97,Dial_JP,,0,0,0,,つばちの家ってうちと近いんだよね
Dialogue: 4,0:09:06.97,0:09:07.65,Dial_JP,,0,0,0,,はい
Dialogue: 4,0:09:08.05,0:09:10.07,Dial_JP,,0,0,0,,歩いて　10分くらいです
Dialogue: 4,0:09:10.32,0:09:14.08,Dial_JP,,0,0,0,,したっけ　またふぶいたらうちの車で送ったげる
Dialogue: 4,0:09:14.41,0:09:16.93,Dial_JP,,0,0,0,,いいんですか　すごく助かります
Dialogue: 4,0:09:16.93,0:09:20.49,Dial_JP,,0,0,0,,おけおけ　そんときはみーに連絡して
Dialogue: 4,0:09:20.49,0:09:23.22,Dial_JP,,0,0,0,,わかりました　ありがとうございます
Dialogue: 4,0:09:28.47,0:09:29.86,Dial_JP,,0,0,0,,いってら
Dialogue: 4,0:09:30.38,0:09:32.55,Dial_JP,,0,0,0,,はい　いってきます
Dialogue: 4,0:09:34.26,0:09:35.20,Dial_JP,,0,0,0,,みー
Dialogue: 4,0:09:35.20,0:09:36.18,Dial_JP,,0,0,0,,なに
Dialogue: 4,0:09:36.70,0:09:40.06,Dial_JP,,0,0,0,,さっきの　ファインプレーだったっしょや
Dialogue: 4,0:09:44.04,0:09:45.59,Dial_JP,,0,0,0,,ちょびっとね
Dialogue: 4,0:09:46.73,0:09:47.90,Dial_JP,,0,0,0,,じゃね
Dialogue: 4,0:09:50.40,0:09:53.69,Dial_JP,,0,0,0,,翼　早く教室に避難するよー
Dialogue: 4,0:09:54.15,0:09:55.24,Dial_JP,,0,0,0,,目に雪がぁ
Dialogue: 4,0:09:55.71,0:09:57.74,Dial_JP,,0,0,0,,筋肉痛がぁ
Dialogue: 4,0:09:58.25,0:10:00.45,Dial_JP,,0,0,0,,こんなにふぶいてるのに
Dialogue: 4,0:10:00.90,0:10:03.28,Dial_JP,,0,0,0,,なんだか春だねぇ
Dialogue: 4,0:10:15.74,0:10:16.65,Dial_JP,,0,0,0,,大丈夫？
Dialogue: 4,0:10:16.65,0:10:17.82,Dial_JP,,0,0,0,,肩貸す？
Dialogue: 4,0:10:17.82,0:10:19.90,Dial_JP,,0,0,0,,いや　大丈夫だから
Dialogue: 4,0:10:21.20,0:10:22.29,Dial_JP,,0,0,0,,秋野さんだ
Dialogue: 4,0:10:24.81,0:10:26.48,Dial_JP,,0,0,0,,沙友理ちゃん
Dialogue: 4,0:10:26.84,0:10:28.42,Dial_JP,,0,0,0,,おっはよぉ
Dialogue: 4,0:10:33.86,0:10:36.95,Dial_JP,,0,0,0,,冬木　お前　マジ許さん
Dialogue: 4,0:10:37.66,0:10:39.49,Dial_JP,,0,0,0,,沙友理ちゃん　なしたの
Dialogue: 4,0:10:39.86,0:10:42.65,Dial_JP,,0,0,0,,やっぱり　秋野さんも筋肉痛
Dialogue: 4,0:10:43.35,0:10:44.29,Dial_JP,,0,0,0,,四季も
Dialogue: 4,0:10:44.88,0:10:47.34,Dial_JP,,0,0,0,,わりと　全身がっつり
Dialogue: 4,0:10:47.34,0:10:49.09,Dial_JP,,0,0,0,,わかりみがすごい
Dialogue: 4,0:10:49.09,0:10:52.64,Dial_JP,,0,0,0,,初心者クラスの私らには負荷がでかすぎた
Dialogue: 4,0:10:53.53,0:10:54.49,Dial_JP,,0,0,0,,確かに
Dialogue: 4,0:10:55.32,0:10:56.57,Dial_JP,,0,0,0,,もう
Dialogue: 4,0:10:56.57,0:10:59.88,Dial_JP,,0,0,0,,２人ばっか仲よしなのズルい
Dialogue: 4,0:10:59.88,0:11:02.53,Dial_JP,,0,0,0,,べっ　別にそんな仲よしって感じでも
Dialogue: 4,0:11:02.87,0:11:03.88,Dial_JP,,0,0,0,,なぁ　四季
Dialogue: 4,0:11:04.90,0:11:05.48,Dial_JP,,0,0,0,,うん
Dialogue: 4,0:11:05.83,0:11:08.84,Dial_JP,,0,0,0,,まぁ　メッチャってわけじゃないかもね
Dialogue: 4,0:11:10.68,0:11:14.66,Dial_JP,,0,0,0,,うちも今から筋肉痛になる
Dialogue: 4,0:11:22.03,0:11:25.63,Dial_JP,,0,0,0,,そういえば翼　カーディガンとかブランケット買ったんだね
Dialogue: 4,0:11:25.63,0:11:29.52,Dial_JP,,0,0,0,,うん　北海道に住んでたら持ってないと不便だし
Dialogue: 4,0:11:29.52,0:11:32.80,Dial_JP,,0,0,0,,いつも冬木さんに借りるのも申し訳ないからね
Dialogue: 4,0:11:33.75,0:11:36.21,Dial_JP,,0,0,0,,何も気にしなくていいのに
Dialogue: 4,0:11:37.42,0:11:39.64,Dial_JP,,0,0,0,,したっけ　これはこれは
Dialogue: 4,0:11:40.71,0:11:41.81,Dial_JP,,0,0,0,,カイロは持ってる
Dialogue: 4,0:11:47.31,0:11:48.95,Dial_JP,,0,0,0,,持ってきてないけど
Dialogue: 4,0:11:50.52,0:11:53.96,Dial_JP,,0,0,0,,冬木さんが薄着でいられる理由が垣間見えた
Dialogue: 4,0:11:54.60,0:11:56.42,Dial_JP,,0,0,0,,じゃあ　ほら貸すよ
Dialogue: 4,0:11:56.42,0:11:57.87,Dial_JP,,0,0,0,,いっぱい使って
Dialogue: 4,0:11:57.87,0:12:00.24,Dial_JP,,0,0,0,,北見の寒さは厳しいぞぉ
Dialogue: 4,0:12:00.24,0:12:02.32,Dial_JP,,0,0,0,,あ　ありがとう
Dialogue: 4,0:12:06.18,0:12:08.40,Dial_JP,,0,0,0,,それにしても不思議な気分だ
Dialogue: 4,0:12:09.69,0:12:14.09,Dial_JP,,0,0,0,,冬木さんみたいなギャルとこんなふうにしゃべれるようになるなんて
Dialogue: 4,0:12:15.18,0:12:18.48,Dial_JP,,0,0,0,,東京にいたころだったら　考えられないなぁ
Dialogue: 4,0:12:19.39,0:12:21.94,Dial_JP,,0,0,0,,そろそろ新しいリップ欲しいなぁ
Dialogue: 4,0:12:21.94,0:12:24.17,Dial_JP,,0,0,0,,したっけ　放課後に買いに行けば
Dialogue: 4,0:12:25.77,0:12:27.76,Dial_JP,,0,0,0,,今「したっけ」ってゆった
Dialogue: 4,0:12:27.76,0:12:30.23,Dial_JP,,0,0,0,,翼が北海道弁使ったぁ
Dialogue: 4,0:12:32.85,0:12:33.91,Dial_JP,,0,0,0,,ホントだ
Dialogue: 4,0:12:34.15,0:12:37.70,Dial_JP,,0,0,0,,きっとうちのがうつったんだぁ　なんかうれしい
Dialogue: 4,0:12:37.94,0:12:40.86,Dial_JP,,0,0,0,,これでつばちゃも道民の仲間入りだねぇ
Dialogue: 4,0:12:41.20,0:12:42.46,Dial_JP,,0,0,0,,そっか
Dialogue: 4,0:12:43.70,0:12:44.97,Dial_JP,,0,0,0,,道民
Dialogue: 4,0:12:46.18,0:12:47.01,Dial_JP,,0,0,0,,四季
Dialogue: 4,0:12:50.08,0:12:52.80,Dial_JP,,0,0,0,,冬木を道民の基準にしちゃダメだよ
Dialogue: 4,0:12:53.94,0:12:55.88,Dial_JP,,0,0,0,,四季ももう気付いてるんでしょ
Dialogue: 4,0:12:56.23,0:12:58.90,Dial_JP,,0,0,0,,冬木はいろいろ規格外ってことをさ
Dialogue: 4,0:13:02.10,0:13:03.63,Dial_JP,,0,0,0,,そんなことないよ
Dialogue: 4,0:13:03.63,0:13:06.00,Dial_JP,,0,0,0,,うちずっと北海道育ちだもん
Dialogue: 4,0:13:06.00,0:13:07.93,Dial_JP,,0,0,0,,それは私も同じ
Dialogue: 4,0:13:08.32,0:13:12.54,Dial_JP,,0,0,0,,だけど　ほとんど方言使わないし　特別なまってもいない
Dialogue: 4,0:13:12.97,0:13:16.21,Dial_JP,,0,0,0,,スキーとかのウィンタースポーツも苦手なほう
Dialogue: 4,0:13:16.61,0:13:19.18,Dial_JP,,0,0,0,,私みたいな道民もいっぱいいるし
Dialogue: 4,0:13:20.48,0:13:24.76,Dial_JP,,0,0,0,,秋野さん　ふだんこんなに強く言うことないからしぼんでる
Dialogue: 4,0:13:25.19,0:13:29.78,Dial_JP,,0,0,0,,うちの家族とか　札幌の親戚はみんな北海道弁使うよ
Dialogue: 4,0:13:30.04,0:13:32.34,Dial_JP,,0,0,0,,私んちはほとんど使ってない
Dialogue: 4,0:13:32.69,0:13:35.13,Dial_JP,,0,0,0,,使ってるの　おじいちゃんおばあちゃんくらいだし
Dialogue: 4,0:13:36.35,0:13:41.28,Dial_JP,,0,0,0,,たぶん　地域とか家庭とか　世代でも差があるんだろうなぁ
Dialogue: 4,0:13:42.83,0:13:44.39,Dial_JP,,0,0,0,,秋野さん　それ…
Dialogue: 4,0:13:45.05,0:13:45.88,Dial_JP,,0,0,0,,気付いた
Dialogue: 4,0:13:45.88,0:13:47.81,Dial_JP,,0,0,0,,いや　まぁ一応ね
Dialogue: 4,0:13:47.81,0:13:51.60,Dial_JP,,0,0,0,,別に四季があんまり気が進まないならやらなくてもいいけど
Dialogue: 4,0:13:51.88,0:13:53.14,Dial_JP,,0,0,0,,そんなことないよ
Dialogue: 4,0:13:53.56,0:13:55.92,Dial_JP,,0,0,0,,俺　秋野さんと一緒にやりたい
Dialogue: 4,0:14:00.89,0:14:02.58,Dial_JP,,0,0,0,,四季　むくすぎるぞ
Dialogue: 4,0:14:03.06,0:14:05.25,Dial_JP,,0,0,0,,秋野さんは俺の師匠なんだ
Dialogue: 4,0:14:05.47,0:14:07.04,Dial_JP,,0,0,0,,冬木さんも弟子になる
Dialogue: 4,0:14:07.04,0:14:08.29,Dial_JP,,0,0,0,,なるなるぅ
Dialogue: 4,0:14:08.29,0:14:10.75,Dial_JP,,0,0,0,,なんの師匠かわかんないけど　なるぅ
Dialogue: 4,0:14:10.75,0:14:12.33,Dial_JP,,0,0,0,,だってさ　師匠
Dialogue: 4,0:14:14.82,0:14:16.79,Dial_JP,,0,0,0,,うちも一緒にいい
Dialogue: 4,0:14:20.30,0:14:24.22,Dial_JP,,0,0,0,,いいよ　そしたら放課後　東武に集合ね
Dialogue: 4,0:14:24.22,0:14:26.85,Dial_JP,,0,0,0,,やったぁ　なまら楽しみ
Dialogue: 4,0:14:26.85,0:14:27.80,Dial_JP,,0,0,0,,東武？
Dialogue: 4,0:14:35.13,0:14:37.36,Dial_JP,,0,0,0,,あっちがファッション系で
Dialogue: 4,0:14:37.94,0:14:39.86,Dial_JP,,0,0,0,,こっちがフードコート
Dialogue: 4,0:14:40.10,0:14:42.72,Dial_JP,,0,0,0,,スーパーにはいっぱいお肉があるよぉ
Dialogue: 4,0:14:44.52,0:14:46.45,Dial_JP,,0,0,0,,すごく広いんだね
Dialogue: 4,0:14:46.45,0:14:48.74,Dial_JP,,0,0,0,,東京のほうがもっと立派だろ
Dialogue: 4,0:14:50.03,0:14:53.95,Dial_JP,,0,0,0,,でも　よくあるショッピングモールとはちょっと違う感じがする
Dialogue: 4,0:14:53.95,0:14:55.67,Dial_JP,,0,0,0,,そう　どこが
Dialogue: 4,0:14:55.67,0:14:57.24,Dial_JP,,0,0,0,,ゆったりしてたり
Dialogue: 4,0:14:57.24,0:14:59.29,Dial_JP,,0,0,0,,そりゃ土地があるからな
Dialogue: 4,0:15:00.35,0:15:04.28,Dial_JP,,0,0,0,,雰囲気もせかせかしてなくて　落ち着けるっていうか
Dialogue: 4,0:15:05.07,0:15:06.00,Dial_JP,,0,0,0,,そうかな
Dialogue: 4,0:15:06.28,0:15:07.35,Dial_JP,,0,0,0,,そうだって
Dialogue: 4,0:15:09.20,0:15:09.88,Dial_JP,,0,0,0,,ダメ
Dialogue: 4,0:15:10.31,0:15:11.62,Dial_JP,,0,0,0,,もう少し　逃げて
Dialogue: 4,0:15:11.62,0:15:13.40,Dial_JP,,0,0,0,,左左　気をつけて
Dialogue: 4,0:15:13.40,0:15:15.24,Dial_JP,,0,0,0,,そう　そこで　グレネード
Dialogue: 4,0:15:24.58,0:15:25.91,Dial_JP,,0,0,0,,やったぁ
Dialogue: 4,0:15:30.92,0:15:32.83,Dial_JP,,0,0,0,,俺　ちょっと　トイレに
Dialogue: 4,0:15:32.83,0:15:35.23,Dial_JP,,0,0,0,,そっち　突き当たりの左ね
Dialogue: 4,0:15:35.23,0:15:36.30,Dial_JP,,0,0,0,,いってら
Dialogue: 4,0:15:38.98,0:15:39.87,Dial_JP,,0,0,0,,ねねねっ
Dialogue: 4,0:15:40.20,0:15:41.38,Dial_JP,,0,0,0,,なんだよ
Dialogue: 4,0:15:41.38,0:15:43.99,Dial_JP,,0,0,0,,帰り　ちょっとコスメ見ていかない
Dialogue: 4,0:15:43.99,0:15:45.72,Dial_JP,,0,0,0,,絶対さゆりんも好きっしょ
Dialogue: 4,0:15:46.02,0:15:47.68,Dial_JP,,0,0,0,,さ　さゆりん
Dialogue: 4,0:15:47.68,0:15:49.93,Dial_JP,,0,0,0,,沙友理だから　さゆりんね
Dialogue: 4,0:15:50.18,0:15:51.52,Dial_JP,,0,0,0,,行く　行こ
Dialogue: 4,0:15:53.09,0:15:53.81,Dial_JP,,0,0,0,,うん
Dialogue: 4,0:15:54.87,0:15:58.28,Dial_JP,,0,0,0,,カラコンとか高いし　一緒に買いたいかも
Dialogue: 4,0:15:58.72,0:16:00.02,Dial_JP,,0,0,0,,それよき
Dialogue: 4,0:16:00.02,0:16:01.53,Dial_JP,,0,0,0,,２人でシェアしよ
Dialogue: 4,0:16:01.73,0:16:03.79,Dial_JP,,0,0,0,,うちはね　リップと
Dialogue: 4,0:16:03.79,0:16:06.36,Dial_JP,,0,0,0,,あと　シャンプーも買いたいんだぁ
Dialogue: 4,0:16:07.68,0:16:08.99,Dial_JP,,0,0,0,,冬木ってさ
Dialogue: 4,0:16:10.47,0:16:12.03,Dial_JP,,0,0,0,,マジでいいヤツだな
Dialogue: 4,0:16:16.93,0:16:19.61,Dial_JP,,0,0,0,,学校で変に突っかかったりして　ごめんな
Dialogue: 4,0:16:20.05,0:16:23.72,Dial_JP,,0,0,0,,ううん　全然気にしてないよ
Dialogue: 4,0:16:24.80,0:16:25.88,Dial_JP,,0,0,0,,戻ってきた
Dialogue: 4,0:16:42.67,0:16:45.63,Dial_JP,,0,0,0,,翼チョイスのシャンプー　買ったったぁ
Dialogue: 4,0:16:46.42,0:16:48.68,Dial_JP,,0,0,0,,カラコンも四季のお墨付きだしな
Dialogue: 4,0:16:49.66,0:16:51.32,Dial_JP,,0,0,0,,合わなかったらごめん
Dialogue: 4,0:16:52.87,0:16:54.37,Dial_JP,,0,0,0,,全然
Dialogue: 4,0:16:54.37,0:16:57.63,Dial_JP,,0,0,0,,ハモった　マジラブち
Dialogue: 4,0:16:59.98,0:17:01.96,Dial_JP,,0,0,0,,そろそろ帰らなきゃだね
Dialogue: 4,0:17:02.62,0:17:03.59,Dial_JP,,0,0,0,,そだね
Dialogue: 4,0:17:05.56,0:17:06.05,Dial_JP,,0,0,0,,そうだ
Dialogue: 4,0:17:06.72,0:17:10.30,Dial_JP,,0,0,0,,帰る前に　つばちゃとさゆりんと３人でさぁ
Dialogue: 4,0:17:10.83,0:17:11.81,Dial_JP,,0,0,0,,これにしない
Dialogue: 4,0:17:11.81,0:17:13.40,Dial_JP,,0,0,0,,いいけど　四季は
Dialogue: 4,0:17:13.80,0:17:15.31,Dial_JP,,0,0,0,,いいっしょ
Dialogue: 4,0:17:42.38,0:17:43.00,Dial_JP,,0,0,0,,あれ
Dialogue: 4,0:17:43.66,0:17:46.92,Dial_JP,,0,0,0,,英語のワークって授業中に回収するんだっけ
Dialogue: 4,0:17:48.01,0:17:49.81,Dial_JP,,0,0,0,,冬木さんなら知ってるかな
Dialogue: 4,0:18:01.07,0:18:02.24,Dial_JP,,0,0,0,,冬木さん
Dialogue: 4,0:18:02.24,0:18:03.19,Dial_JP,,0,0,0,,返事はやっ
Dialogue: 4,0:18:03.19,0:18:04.94,Dial_JP,,0,0,0,,半身浴ちゅう
Dialogue: 4,0:18:06.80,0:18:08.46,Dial_JP,,0,0,0,,ご　ごめんね
Dialogue: 4,0:18:08.46,0:18:10.96,Dial_JP,,0,0,0,,お風呂から上がったら　教えてくれ…
Dialogue: 4,0:18:14.67,0:18:18.24,Dial_JP,,0,0,0,,さてさて　翼はどんな反応するかな
Dialogue: 4,0:18:18.64,0:18:20.16,Dial_JP,,0,0,0,,慌ててそう
Dialogue: 4,0:18:21.47,0:18:25.27,Dial_JP,,0,0,0,,入浴中にごめんね　キツネのおもちゃかわいいね
Dialogue: 4,0:18:33.14,0:18:34.56,Dial_JP,,0,0,0,,って　これ
Dialogue: 4,0:18:35.73,0:18:39.89,Dial_JP,,0,0,0,,こんなの見たら絶対勉強に集中できるわけない
Dialogue: 4,0:18:40.19,0:18:42.20,Dial_JP,,0,0,0,,かなり思い切っちゃったけど
Dialogue: 4,0:18:42.20,0:18:44.82,Dial_JP,,0,0,0,,これならおもしろい反応してくるはず
Dialogue: 4,0:18:45.46,0:18:46.19,Dial_JP,,0,0,0,,来た
Dialogue: 4,0:18:46.55,0:18:49.02,Dial_JP,,0,0,0,,すごく美容にこだわってるんだね
Dialogue: 4,0:18:49.02,0:18:51.55,Dial_JP,,0,0,0,,写真から細やかな取り組みが見えて
Dialogue: 4,0:18:51.55,0:18:54.33,Dial_JP,,0,0,0,,冬木さんの真面目さがすごく伝わってくるよ
Dialogue: 4,0:18:57.38,0:18:59.78,Dial_JP,,0,0,0,,あれでよかったんだろうか
Dialogue: 4,0:19:02.94,0:19:03.90,Dial_JP,,0,0,0,,通話
Dialogue: 4,0:19:04.34,0:19:06.21,Dial_JP,,0,0,0,,でっ　出るべきだろうか
Dialogue: 4,0:19:10.88,0:19:11.91,Dial_JP,,0,0,0,,もしもし
Dialogue: 4,0:19:12.48,0:19:15.55,Dial_JP,,0,0,0,,出ないという理性は今　殉職した
Dialogue: 4,0:19:15.76,0:19:17.06,Dial_JP,,0,0,0,,見えてる
Dialogue: 4,0:19:19.16,0:19:20.19,Dial_JP,,0,0,0,,おーい
Dialogue: 4,0:19:21.46,0:19:22.30,Dial_JP,,0,0,0,,冬木さん
Dialogue: 4,0:19:22.30,0:19:25.33,Dial_JP,,0,0,0,,おふ　お風呂で　ビデオ通話はさすがに
Dialogue: 4,0:19:25.33,0:19:27.90,Dial_JP,,0,0,0,,やっといつもの反応って感じ
Dialogue: 4,0:19:28.28,0:19:30.12,Dial_JP,,0,0,0,,顔　真っ赤だよ
Dialogue: 4,0:19:31.47,0:19:33.59,Dial_JP,,0,0,0,,映って　ない
Dialogue: 4,0:19:35.23,0:19:36.66,Dial_JP,,0,0,0,,なまらウケる
Dialogue: 4,0:19:36.66,0:19:38.28,Dial_JP,,0,0,0,,楽しい
Dialogue: 4,0:19:40.54,0:19:42.95,Dial_JP,,0,0,0,,いつもより打点たけぇ
Dialogue: 4,0:19:44.32,0:19:46.85,Dial_JP,,0,0,0,,これ以上は生命の危機を感じる
Dialogue: 4,0:19:47.94,0:19:51.19,Dial_JP,,0,0,0,,ねねねっ　翼は毎日お風呂つかるの
Dialogue: 4,0:19:51.77,0:19:52.75,Dial_JP,,0,0,0,,つかるよ
Dialogue: 4,0:19:53.01,0:19:54.66,Dial_JP,,0,0,0,,さっき上がったばっかり
Dialogue: 4,0:19:55.63,0:19:58.56,Dial_JP,,0,0,0,,うちと　ママ以外は２日に１回とかだよ
Dialogue: 4,0:19:58.56,0:20:00.26,Dial_JP,,0,0,0,,シャワーは毎日浴びるけど
Dialogue: 4,0:20:00.64,0:20:01.85,Dial_JP,,0,0,0,,そうなの
Dialogue: 4,0:20:01.85,0:20:05.24,Dial_JP,,0,0,0,,寒いから毎日　湯船につかってるかと思ってた
Dialogue: 4,0:20:05.24,0:20:09.37,Dial_JP,,0,0,0,,なんかパパは汗かかないし　光熱費爆上がりするから
Dialogue: 4,0:20:09.37,0:20:11.27,Dial_JP,,0,0,0,,毎日はやばたんってゆってた
Dialogue: 4,0:20:11.53,0:20:14.49,Dial_JP,,0,0,0,,でも　冬木さんとお母さんが毎日入るなら
Dialogue: 4,0:20:14.49,0:20:16.05,Dial_JP,,0,0,0,,結局　意味ないんじゃ
Dialogue: 4,0:20:16.05,0:20:18.78,Dial_JP,,0,0,0,,半身浴なら　ギリオッケーなんだって
Dialogue: 4,0:20:18.78,0:20:21.45,Dial_JP,,0,0,0,,冬の節約は大変そうだね
Dialogue: 4,0:20:21.45,0:20:25.79,Dial_JP,,0,0,0,,そういえば　昔はよく家族で温泉旅行行ってたなぁ
Dialogue: 4,0:20:25.79,0:20:27.25,Dial_JP,,0,0,0,,温泉いいねぇ
Dialogue: 4,0:20:27.25,0:20:29.10,Dial_JP,,0,0,0,,北見にも温泉いっぱいあるから
Dialogue: 4,0:20:29.10,0:20:29.92,Dial_JP,,0,0,0,,行ってみな
Dialogue: 4,0:20:29.92,0:20:31.84,Dial_JP,,0,0,0,,うん　調べてみるよ
Dialogue: 4,0:20:31.84,0:20:34.60,Dial_JP,,0,0,0,,それともうちと一緒に行く
Dialogue: 4,0:20:36.89,0:20:40.55,Dial_JP,,0,0,0,,俺はもうそんなにあたふたしないよ　冬木さん
Dialogue: 4,0:20:41.48,0:20:43.47,Dial_JP,,0,0,0,,寂しい
Dialogue: 4,0:20:43.99,0:20:46.48,Dial_JP,,0,0,0,,そういえばつばちゃは今何してんの
Dialogue: 4,0:20:46.74,0:20:48.17,Dial_JP,,0,0,0,,英語のワークだよ
Dialogue: 4,0:20:48.61,0:20:50.15,Dial_JP,,0,0,0,,今日の分やってたんだ
Dialogue: 4,0:20:50.65,0:20:51.38,Dial_JP,,0,0,0,,そうだ
Dialogue: 4,0:20:51.38,0:20:54.29,Dial_JP,,0,0,0,,そもそもこれ　明日提出でよかったんだよね
Dialogue: 4,0:20:54.29,0:20:55.90,Dial_JP,,0,0,0,,そのへんのこと聞きたくて
Dialogue: 4,0:20:56.10,0:20:57.53,Dial_JP,,0,0,0,,ヤバ
Dialogue: 4,0:20:57.53,0:20:59.87,Dial_JP,,0,0,0,,うち　それまだ１ページもやってな…
Dialogue: 4,0:21:00.20,0:21:01.20,Dial_JP,,0,0,0,,冬木さん
Dialogue: 4,0:21:21.48,0:21:22.63,Dial_JP,,0,0,0,,どうしたの　冬木さん
Dialogue: 4,0:21:22.63,0:21:23.64,Dial_JP,,0,0,0,,大丈夫
Dialogue: 4,0:21:24.34,0:21:25.24,Dial_JP,,0,0,0,,冬木さん
Dialogue: 4,0:21:26.92,0:21:27.81,Dial_JP,,0,0,0,,見た
Dialogue: 4,0:21:29.97,0:21:30.52,Dial_JP,,0,0,0,,なに
Dialogue: 4,0:21:30.76,0:21:31.61,Dial_JP,,0,0,0,,さっき…
Dialogue: 4,0:21:31.61,0:21:34.66,Dial_JP,,0,0,0,,ごめん　びっくりしてスマホ落としかけて
Dialogue: 4,0:21:37.22,0:21:38.47,Dial_JP,,0,0,0,,そっか
Dialogue: 4,0:21:38.47,0:21:40.87,Dial_JP,,0,0,0,,うち　そろそろ上がるから切らなきゃ
Dialogue: 4,0:21:42.66,0:21:44.32,Dial_JP,,0,0,0,,じゃあ　また明日
Dialogue: 4,0:21:47.50,0:21:49.93,Dial_JP,,0,0,0,,どうしたんだろ　冬木さん
Dialogue: 4,0:21:50.67,0:21:53.63,Dial_JP,,0,0,0,,そんなにワークのことがショックだったのかな
Dialogue: 4,0:22:01.55,0:22:04.67,Dial_JP,,0,0,0,,慣れないことはするもんじゃないなぁ
Dialogue: 4,0:22:06.19,0:22:07.59,Dial_JP,,0,0,0,,みー　出た
Dialogue: 4,0:22:08.40,0:22:11.67,Dial_JP,,0,0,0,,ママもお風呂入りたい…　どうした
Dialogue: 4,0:22:11.67,0:22:12.56,Dial_JP,,0,0,0,,のぼせた
Dialogue: 4,0:22:16.72,0:22:18.44,Dial_JP,,0,0,0,,ちょびっとね
Dialogue: 4,0:22:22.73,0:22:26.86,Dial_JP,,0,0,0,,翌日　冬木さんは提出が間に合わなかったので
Dialogue: 4,0:22:26.86,0:22:28.75,Dial_JP,,0,0,0,,先生に怒られていた
Dialogue: 5,0:00:10.37,0:00:11.18,Dial_CH,,0,0,0,,痛痛痛
Dialogue: 5,0:00:15.63,0:00:19.79,Dial_CH,,0,0,0,,這種大雪天 我真能去學校嗎
Dialogue: 5,0:00:20.08,0:00:22.96,Dial_CH,,0,0,0,,再加上昨天滑雪留下的肌肉酸痛
Dialogue: 5,0:00:23.95,0:00:26.42,Dial_CH,,0,0,0,,北海道可是試煉之地
Dialogue: 5,0:00:28.26,0:00:32.60,Dial_CH,,0,0,0,,唯有戰勝這樣的大雪 才能成為真正的北海道人
Dialogue: 5,0:00:33.37,0:00:34.39,Dial_CH,,0,0,0,,奶奶
Dialogue: 5,0:00:35.77,0:00:37.52,Dial_CH,,0,0,0,,我會加油的
Dialogue: 5,0:00:38.21,0:00:39.15,Dial_CH,,0,0,0,,我出發了
Dialogue: 5,0:01:03.37,0:01:05.78,Dial_CH,,0,0,0,,不行不行不行
Dialogue: 5,0:01:07.92,0:01:09.17,Dial_CH,,0,0,0,,這也太冷了
Dialogue: 5,0:01:09.74,0:01:11.36,Dial_CH,,0,0,0,,肌肉好疼
Dialogue: 5,0:01:11.81,0:01:14.33,Dial_CH,,0,0,0,,雪打到臉上 好疼
Dialogue: 5,0:01:15.82,0:01:18.64,Dial_CH,,0,0,0,,彷彿被針扎一樣的冷
Dialogue: 5,0:01:19.94,0:01:22.88,Dial_CH,,0,0,0,,而且眼前一片白色什麼都看不見
Dialogue: 5,0:01:23.37,0:01:25.25,Dial_CH,,0,0,0,,每一步都很艱難
Dialogue: 5,0:01:25.56,0:01:27.69,Dial_CH,,0,0,0,,都快算是遇難了吧
Dialogue: 5,0:01:33.15,0:01:36.08,Dial_CH,,0,0,0,,冬木同學在這種天裡
Dialogue: 5,0:01:36.50,0:01:39.16,Dial_CH,,0,0,0,,大概也和往常一樣上學吧
Dialogue: 5,0:01:49.42,0:01:50.31,Dial_CH,,0,0,0,,加油
Dialogue: 5,0:01:52.42,0:01:53.26,Dial_CH,,0,0,0,,不好意思
Dialogue: 5,0:01:57.25,0:01:58.39,Dial_CH,,0,0,0,,要死了
Dialogue: 5,0:02:05.72,0:02:07.25,Dial_CH,,0,0,0,,彷彿迴光返照了
Dialogue: 5,0:02:08.97,0:02:11.08,Dial_CH,,0,0,0,,再見了 北海道
Dialogue: 5,0:02:11.98,0:02:14.45,Dial_CH,,0,0,0,,再見了 我的人生
Dialogue: 5,0:02:14.45,0:02:16.41,Dial_CH,,0,0,0,,你這是怎麼了
Dialogue: 5,0:02:16.68,0:02:19.67,Dial_CH,,0,0,0,,下這麼大的雪可不能在外面走啊
Dialogue: 5,0:02:20.06,0:02:22.12,Dial_CH,,0,0,0,,快上車吧 咱們一起去
Dialogue: 5,0:02:23.92,0:02:26.36,Dial_CH,,0,0,0,,這裡是地府嗎
Dialogue: 5,0:02:26.36,0:02:28.82,Dial_CH,,0,0,0,,好啦 快上車吧
Dialogue: 5,0:02:29.09,0:02:32.51,Dial_CH,,0,0,0,,好疼
Dialogue: 5,0:04:06.31,0:04:08.98,Dial_CH,,500,0,0,,早… 早安
Dialogue: 5,0:04:09.44,0:04:11.48,Dial_CH,,0,0,0,,不好意思 突然麻煩您
Dialogue: 5,0:04:11.48,0:04:13.83,Dial_CH,,0,0,0,,媽媽 可以走了喔
Dialogue: 5,0:04:14.46,0:04:15.96,Dial_CH,,0,0,0,,好
Dialogue: 5,0:04:16.80,0:04:18.62,Dial_CH,,0,0,0,,今天真的冷
Dialogue: 5,0:04:18.86,0:04:22.54,Dial_CH,,0,0,0,,什麼都別客氣 跟在自己家一樣 隨意點
Dialogue: 5,0:04:23.15,0:04:24.14,Dial_CH,,0,0,0,,是辣妹
Dialogue: 5,0:04:25.08,0:04:27.38,Dial_CH,,0,0,0,,這是媽媽？
Dialogue: 5,0:04:27.60,0:04:29.67,Dial_CH,,0,0,0,,不是姐姐 是媽媽？
Dialogue: 5,0:04:29.95,0:04:32.01,Dial_CH,,0,0,0,,簡直跟冬木同學一個模子裡刻出來的
Dialogue: 5,0:04:32.36,0:04:34.62,Dial_CH,,0,0,0,,這就是家族遺傳的力量嗎
Dialogue: 5,0:04:35.23,0:04:37.45,Dial_CH,,0,0,0,,翼家可是豪宅
Dialogue: 5,0:04:37.45,0:04:39.99,Dial_CH,,0,0,0,,我家車這麼小怎麼可能坐得舒服啊
Dialogue: 5,0:04:39.99,0:04:42.33,Dial_CH,,0,0,0,,沒 沒有 才不會…
Dialogue: 5,0:04:42.93,0:04:45.04,Dial_CH,,0,0,0,,他就是最近你經常提起的
Dialogue: 5,0:04:45.04,0:04:47.36,Dial_CH,,0,0,0,,住在像城堡一樣的房子的小少爺
Dialogue: 5,0:04:47.36,0:04:49.39,Dial_CH,,0,0,0,,小… 小少爺
Dialogue: 5,0:04:50.47,0:04:54.24,Dial_CH,,0,0,0,,完了 早知道好好化個妝了
Dialogue: 5,0:04:54.24,0:04:57.28,Dial_CH,,0,0,0,,媽媽幹嘛啊 不至於在翼面前炫耀自己吧
Dialogue: 5,0:04:57.28,0:04:58.11,Dial_CH,,0,0,0,,api？
Dialogue: 5,0:04:58.46,0:04:59.96,Dial_CH,,0,0,0,,是嗎是嗎
Dialogue: 5,0:04:59.96,0:05:01.99,Dial_CH,,0,0,0,,你就是那個翼啊
Dialogue: 5,0:05:03.70,0:05:05.70,Dial_CH,,0,0,0,,莫名焦躁
Dialogue: 5,0:05:05.70,0:05:09.11,Dial_CH,,0,0,0,,翼 你在老家那邊有女朋友嗎
Dialogue: 5,0:05:09.11,0:05:09.66,Dial_CH,,0,0,0,,女…
Dialogue: 5,0:05:09.91,0:05:11.82,Dial_CH,,0,0,0,,你慌什麼
Dialogue: 5,0:05:12.44,0:05:13.91,Dial_CH,,500,0,0,,好痛痛痛
Dialogue: 5,0:05:12.80,0:05:13.40,Dial_CH,,0,600,0,,咦
Dialogue: 5,0:05:14.10,0:05:16.12,Dial_CH,,0,0,0,,抱歉 沒事吧
Dialogue: 5,0:05:16.64,0:05:19.88,Dial_CH,,0,0,0,,沒事 只是肌肉酸痛
Dialogue: 5,0:05:20.59,0:05:24.44,Dial_CH,,0,0,0,,因為滑雪課上用上了平時用不到的肌肉
Dialogue: 5,0:05:24.98,0:05:26.16,Dial_CH,,0,0,0,,天啊
Dialogue: 5,0:05:26.78,0:05:28.96,Dial_CH,,0,0,0,,也就是說
Dialogue: 5,0:05:29.71,0:05:32.90,Dial_CH,,0,0,0,,不太能找你做劇烈運動了
Dialogue: 5,0:05:33.23,0:05:34.90,Dial_CH,,0,0,0,,這措辭…
Dialogue: 5,0:05:36.48,0:05:38.64,Dial_CH,,0,0,0,,畢竟小美體能充足
Dialogue: 5,0:05:38.64,0:05:41.24,Dial_CH,,0,0,0,,一整天動個不停也一點事沒有
Dialogue: 5,0:05:41.83,0:05:43.45,Dial_CH,,0,0,0,,她媽的措辭也了不得
Dialogue: 5,0:05:44.44,0:05:46.35,Dial_CH,,0,0,0,,冬木同學倒是很有精神呢
Dialogue: 5,0:05:46.35,0:05:48.34,Dial_CH,,0,0,0,,我完全沒事喔
Dialogue: 5,0:05:48.34,0:05:49.92,Dial_CH,,0,0,0,,是 是嗎
Dialogue: 5,0:05:51.87,0:05:53.95,Dial_CH,,0,0,0,,那個…
Dialogue: 5,0:05:54.27,0:05:55.98,Dial_CH,,0,0,0,,我沒有女朋友
Dialogue: 5,0:05:56.45,0:05:57.99,Dial_CH,,0,0,0,,多可惜啊
Dialogue: 5,0:05:57.99,0:05:58.70,Dial_CH,,0,0,0,,沒有沒有
Dialogue: 5,0:05:58.70,0:06:00.78,Dial_CH,,0,0,0,,也算不上可惜吧
Dialogue: 5,0:06:00.78,0:06:03.18,Dial_CH,,0,0,0,,我家的小美怎麼樣 是不是老可愛了
Dialogue: 5,0:06:03.18,0:06:06.73,Dial_CH,,0,0,0,,媽 你幹嘛 害羞死了 少說兩句吧
Dialogue: 5,0:06:07.06,0:06:11.56,Dial_CH,,0,0,0,,這個感覺 就跟和冬木同學剛遇見的時候一樣
Dialogue: 5,0:06:11.78,0:06:15.87,Dial_CH,,0,0,0,,因為翼君太可愛了 和你爸一樣一樣的
Dialogue: 5,0:06:15.87,0:06:18.11,Dial_CH,,0,0,0,,你媽媽我可是很久沒這麼心動了
Dialogue: 5,0:06:18.48,0:06:20.91,Dial_CH,,0,0,0,,小美和翼寶 甜蜜蜜小兩口
Dialogue: 5,0:06:20.91,0:06:23.04,Dial_CH,,0,0,0,,哎呀 可真是太可愛了
Dialogue: 5,0:06:23.04,0:06:26.76,Dial_CH,,0,0,0,,阿姨越說越來勁了 我該怎麼回答啊
Dialogue: 5,0:06:27.02,0:06:27.99,Dial_CH,,0,0,0,,媽媽
Dialogue: 5,0:06:33.76,0:06:37.04,Dial_CH,,0,0,0,,別真生氣呀
Dialogue: 5,0:06:37.04,0:06:39.71,Dial_CH,,0,0,0,,媽媽就是第一次見翼寶太高興啦
Dialogue: 5,0:06:41.37,0:06:44.33,Dial_CH,,0,0,0,,冬木同學生氣了原來是這個樣子
Dialogue: 5,0:06:44.60,0:06:47.35,Dial_CH,,0,0,0,,雖然完全不可怕 但我還是小心點吧
Dialogue: 5,0:06:53.99,0:06:56.41,Dial_CH,,0,0,0,,翼寶是從東京來的哈
Dialogue: 5,0:06:56.41,0:06:58.40,Dial_CH,,0,0,0,,第一次見這樣的暴風雪吧
Dialogue: 5,0:06:58.40,0:07:01.75,Dial_CH,,0,0,0,,說實話我都納悶怎麼不停課
Dialogue: 5,0:07:01.75,0:07:03.43,Dial_CH,,0,0,0,,確實
Dialogue: 5,0:07:03.43,0:07:04.74,Dial_CH,,0,0,0,,但是啊 翼
Dialogue: 5,0:07:04.74,0:07:07.36,Dial_CH,,0,0,0,,這點雪可放不了假
Dialogue: 5,0:07:07.93,0:07:10.83,Dial_CH,,0,0,0,,東京要是下這麼大的雪
Dialogue: 5,0:07:10.83,0:07:13.76,Dial_CH,,0,0,0,,那可能就是世界末日級別的大事了
Dialogue: 5,0:07:13.76,0:07:15.87,Dial_CH,,0,0,0,,那是得上新聞
Dialogue: 5,0:07:15.87,0:07:17.63,Dial_CH,,0,0,0,,但是在這邊就根本不是回事了
Dialogue: 5,0:07:18.00,0:07:21.62,Dial_CH,,0,0,0,,在東京人看來肯定覺得這邊才不正常
Dialogue: 5,0:07:21.62,0:07:23.58,Dial_CH,,0,0,0,,不過有一點我挺意外的
Dialogue: 5,0:07:25.08,0:07:27.46,Dial_CH,,0,0,0,,我以為北海道人都比較抗凍
Dialogue: 5,0:07:27.46,0:07:30.22,Dial_CH,,0,0,0,,這種天也能隨便出門
Dialogue: 5,0:07:30.50,0:07:32.39,Dial_CH,,0,0,0,,不會不會不會
Dialogue: 5,0:07:38.32,0:07:41.04,Dial_CH,,0,0,0,,平時不坐電車或者公車上學的
Dialogue: 5,0:07:41.04,0:07:43.83,Dial_CH,,0,0,0,,這種天一般就讓家裡開車送了
Dialogue: 5,0:07:44.34,0:07:45.65,Dial_CH,,0,0,0,,原來是這樣
Dialogue: 5,0:07:45.65,0:07:47.49,Dial_CH,,0,0,0,,冬天經常是這樣
Dialogue: 5,0:07:47.92,0:07:51.22,Dial_CH,,0,0,0,,我是為了打扮得漂亮才穿得少
Dialogue: 5,0:07:51.22,0:07:54.47,Dial_CH,,0,0,0,,冷還是冷 所以冬天我可不想出門
Dialogue: 5,0:07:54.47,0:07:56.45,Dial_CH,,0,0,0,,這 這樣啊
Dialogue: 5,0:07:56.45,0:07:59.16,Dial_CH,,0,0,0,,奶奶說的真正的北海道人
Dialogue: 5,0:07:59.16,0:08:00.94,Dial_CH,,0,0,0,,到底是什麼樣的呢
Dialogue: 5,0:08:01.51,0:08:04.26,Dial_CH,,0,0,0,,但是冬裝都貴死了
Dialogue: 5,0:08:04.26,0:08:06.95,Dial_CH,,0,0,0,,錢包得比人先凍死
Dialogue: 5,0:08:07.28,0:08:09.33,Dial_CH,,0,0,0,,什麼靴子啊 大衣啊
Dialogue: 5,0:08:09.33,0:08:12.16,Dial_CH,,0,0,0,,冬天還超長 買衣服得花老多錢了
Dialogue: 5,0:08:12.42,0:08:17.08,Dial_CH,,0,0,0,,我的零用錢也完全不夠買我想要的衣服 好想去打工啊
Dialogue: 5,0:08:17.08,0:08:19.09,Dial_CH,,0,0,0,,小美還不能打工喔
Dialogue: 5,0:08:19.40,0:08:20.68,Dial_CH,,0,0,0,,為什麼啊
Dialogue: 5,0:08:20.68,0:08:22.69,Dial_CH,,0,0,0,,你爸也不讓
Dialogue: 5,0:08:23.16,0:08:25.35,Dial_CH,,0,0,0,,母女關係真好
Dialogue: 5,0:08:25.82,0:08:28.15,Dial_CH,,0,0,0,,北海道辣妹也不容易呀
Dialogue: 5,0:08:28.69,0:08:29.65,Dial_CH,,0,0,0,,不過
Dialogue: 5,0:08:29.65,0:08:33.53,Dial_CH,,0,0,0,,我倒是覺得兩位現在這樣就夠漂亮了
Dialogue: 5,0:08:42.54,0:08:44.52,Dial_CH,,0,0,0,,翼… 翼寶
Dialogue: 5,0:08:44.52,0:08:46.64,Dial_CH,,0,0,0,,誇老阿姨也沒好處喔
Dialogue: 5,0:08:46.64,0:08:50.61,Dial_CH,,0,0,0,,他就是這樣 動不動就來這麼一下
Dialogue: 5,0:08:50.61,0:08:53.49,Dial_CH,,0,0,0,,糟了 又把心裡話說出來了
Dialogue: 5,0:08:57.89,0:08:59.38,Dial_CH,,0,0,0,,到啦
Dialogue: 5,0:08:59.80,0:09:03.27,Dial_CH,,0,0,0,,謝謝您 幫大忙了
Dialogue: 5,0:09:04.36,0:09:06.97,Dial_CH,,0,0,0,,翼寶家離我們那裡挺近的吧
Dialogue: 5,0:09:06.97,0:09:07.65,Dial_CH,,0,0,0,,是的
Dialogue: 5,0:09:08.05,0:09:10.07,Dial_CH,,0,0,0,,走路也就10分鐘
Dialogue: 5,0:09:10.32,0:09:14.08,Dial_CH,,0,0,0,,那要是再下暴風雪了再來坐我家的車啊
Dialogue: 5,0:09:14.41,0:09:16.93,Dial_CH,,0,0,0,,真的可以嗎 太感謝了
Dialogue: 5,0:09:16.93,0:09:20.49,Dial_CH,,0,0,0,,沒問題沒問題 到時候你就和小美說
Dialogue: 5,0:09:20.49,0:09:23.22,Dial_CH,,0,0,0,,好的 謝謝您
Dialogue: 5,0:09:28.47,0:09:29.86,Dial_CH,,0,0,0,,去吧
Dialogue: 5,0:09:30.38,0:09:32.55,Dial_CH,,0,0,0,,好的 再見
Dialogue: 5,0:09:34.26,0:09:35.20,Dial_CH,,0,0,0,,小美
Dialogue: 5,0:09:35.20,0:09:36.18,Dial_CH,,0,0,0,,什麼
Dialogue: 5,0:09:36.70,0:09:40.06,Dial_CH,,0,0,0,,剛剛媽那個是不是神助攻
Dialogue: 5,0:09:44.04,0:09:45.59,Dial_CH,,0,0,0,,就一點點
Dialogue: 5,0:09:46.73,0:09:47.90,Dial_CH,,0,0,0,,拜拜
Dialogue: 5,0:09:50.40,0:09:53.69,Dial_CH,,0,0,0,,翼 趕快去教室避難吧
Dialogue: 5,0:09:54.15,0:09:55.24,Dial_CH,,0,0,0,,雪飄眼睛裡了
Dialogue: 5,0:09:55.71,0:09:57.74,Dial_CH,,0,0,0,,肌肉好痛
Dialogue: 5,0:09:58.25,0:10:00.45,Dial_CH,,0,0,0,,暴雪下得這麼大
Dialogue: 5,0:10:00.90,0:10:03.28,Dial_CH,,0,0,0,,卻聞到了一絲春意
Dialogue: 5,0:10:15.74,0:10:16.65,Dial_CH,,0,0,0,,還好嗎
Dialogue: 5,0:10:16.65,0:10:17.82,Dial_CH,,0,0,0,,要我摻著你嗎？
Dialogue: 5,0:10:17.82,0:10:19.90,Dial_CH,,0,0,0,,不用 我沒事
Dialogue: 5,0:10:21.20,0:10:22.29,Dial_CH,,0,0,0,,是秋野同學
Dialogue: 5,0:10:24.81,0:10:26.48,Dial_CH,,0,0,0,,沙友理
Dialogue: 5,0:10:26.84,0:10:28.42,Dial_CH,,0,0,0,,早安呀
Dialogue: 5,0:10:33.86,0:10:36.95,Dial_CH,,0,0,0,,冬木 我跟你沒完
Dialogue: 5,0:10:37.66,0:10:39.49,Dial_CH,,0,0,0,,沙友理 你怎麼啦
Dialogue: 5,0:10:39.86,0:10:42.65,Dial_CH,,0,0,0,,秋野同學也肌肉酸痛吧
Dialogue: 5,0:10:43.35,0:10:44.29,Dial_CH,,0,0,0,,四季也痛嗎
Dialogue: 5,0:10:44.88,0:10:47.34,Dial_CH,,0,0,0,,是啊 渾身硬邦邦的
Dialogue: 5,0:10:47.34,0:10:49.09,Dial_CH,,0,0,0,,知音啊
Dialogue: 5,0:10:49.09,0:10:52.64,Dial_CH,,0,0,0,,那天對我們這種初學者還是負荷太大了
Dialogue: 5,0:10:53.53,0:10:54.49,Dial_CH,,0,0,0,,確實
Dialogue: 5,0:10:55.32,0:10:56.57,Dial_CH,,0,0,0,,幹嘛呀
Dialogue: 5,0:10:56.57,0:10:59.88,Dial_CH,,0,0,0,,就你倆這麼熱絡太不公平了
Dialogue: 5,0:10:59.88,0:11:02.53,Dial_CH,,0,0,0,,也 也沒有關係特別好吧
Dialogue: 5,0:11:02.87,0:11:03.88,Dial_CH,,0,0,0,,是吧 四季
Dialogue: 5,0:11:04.90,0:11:05.48,Dial_CH,,0,0,0,,嗯
Dialogue: 5,0:11:05.83,0:11:08.84,Dial_CH,,0,0,0,,是啊 沒到你說的那種程度
Dialogue: 5,0:11:10.68,0:11:14.66,Dial_CH,,0,0,0,,我現在開始肌肉酸痛了
Dialogue: 5,0:11:22.03,0:11:25.63,Dial_CH,,0,0,0,,說起來 翼也買毛衫和毯子了呀
Dialogue: 5,0:11:25.63,0:11:29.52,Dial_CH,,0,0,0,,是啊 在北海道住著沒有這些也不太方便
Dialogue: 5,0:11:29.52,0:11:32.80,Dial_CH,,0,0,0,,總管冬木同學借也不太好意思
Dialogue: 5,0:11:33.75,0:11:36.21,Dial_CH,,0,0,0,,你看你客氣什麼呀
Dialogue: 5,0:11:37.42,0:11:39.64,Dial_CH,,0,0,0,,那 這個呢
Dialogue: 5,0:11:40.71,0:11:41.81,Dial_CH,,0,0,0,,暖暖包你有嗎
Dialogue: 5,0:11:47.31,0:11:48.95,Dial_CH,,0,0,0,,這個倒是沒有
Dialogue: 5,0:11:50.52,0:11:53.96,Dial_CH,,0,0,0,,我好像窺探出了她為什麼能穿這麼少了
Dialogue: 5,0:11:54.60,0:11:56.42,Dial_CH,,0,0,0,,那 這個借你吧
Dialogue: 5,0:11:56.42,0:11:57.87,Dial_CH,,0,0,0,,好好用吧
Dialogue: 5,0:11:57.87,0:12:00.24,Dial_CH,,0,0,0,,北見的寒冷可不講道理了
Dialogue: 5,0:12:00.24,0:12:02.32,Dial_CH,,0,0,0,,謝 謝謝你
Dialogue: 5,0:12:06.18,0:12:08.40,Dial_CH,,0,0,0,,感覺真奇妙
Dialogue: 5,0:12:09.69,0:12:14.09,Dial_CH,,0,0,0,,我居然能跟冬木同學這種辣妹這麼聊得來
Dialogue: 5,0:12:15.18,0:12:18.48,Dial_CH,,0,0,0,,在東京實在無法想像
Dialogue: 5,0:12:19.39,0:12:21.94,Dial_CH,,0,0,0,,差不多要買新唇膏了
Dialogue: 5,0:12:21.94,0:12:24.17,Dial_CH,,0,0,0,,那放學後去買唄
Dialogue: 5,0:12:25.77,0:12:27.76,Dial_CH,,0,0,0,,你剛剛說方言了
Dialogue: 5,0:12:27.76,0:12:30.23,Dial_CH,,0,0,0,,你開始講北海道話了
Dialogue: 5,0:12:32.85,0:12:33.91,Dial_CH,,0,0,0,,還真是
Dialogue: 5,0:12:34.15,0:12:37.70,Dial_CH,,0,0,0,,肯定是被我耳濡目染了 真開心
Dialogue: 5,0:12:37.94,0:12:40.86,Dial_CH,,0,0,0,,這樣你也是算是個北海道人了
Dialogue: 5,0:12:41.20,0:12:42.46,Dial_CH,,0,0,0,,是嗎
Dialogue: 5,0:12:43.70,0:12:44.97,Dial_CH,,0,0,0,,北海道人
Dialogue: 5,0:12:46.18,0:12:47.01,Dial_CH,,0,0,0,,四季
Dialogue: 5,0:12:50.08,0:12:52.80,Dial_CH,,0,0,0,,不能把冬木當成標準北海道人喔
Dialogue: 5,0:12:53.94,0:12:55.88,Dial_CH,,0,0,0,,你也注意到了吧
Dialogue: 5,0:12:56.23,0:12:58.90,Dial_CH,,0,0,0,,她各方面都異於常人
Dialogue: 5,0:13:02.10,0:13:03.63,Dial_CH,,0,0,0,,哪有
Dialogue: 5,0:13:03.63,0:13:06.00,Dial_CH,,0,0,0,,我可是土生土長的北海道人
Dialogue: 5,0:13:06.00,0:13:07.93,Dial_CH,,0,0,0,,我也是啊
Dialogue: 5,0:13:08.32,0:13:12.54,Dial_CH,,0,0,0,,但我基本上不說方言 也沒什麼口音
Dialogue: 5,0:13:12.97,0:13:16.21,Dial_CH,,0,0,0,,我還不擅長滑雪之類的冬季運動
Dialogue: 5,0:13:16.61,0:13:19.18,Dial_CH,,0,0,0,,像我這樣的北海道人還挺多的
Dialogue: 5,0:13:20.48,0:13:24.76,Dial_CH,,0,0,0,,秋野同學平時說話不怎麼強勢 現在有點畏畏縮縮
Dialogue: 5,0:13:25.19,0:13:29.78,Dial_CH,,0,0,0,,咱家裡人還有札幌的親戚們都是講北海道話的喔
Dialogue: 5,0:13:30.04,0:13:32.34,Dial_CH,,0,0,0,,我家基本上不說
Dialogue: 5,0:13:32.69,0:13:35.13,Dial_CH,,0,0,0,,只有爺爺奶奶說
Dialogue: 5,0:13:36.35,0:13:41.28,Dial_CH,,0,0,0,,或許各地區 家庭 各代人之間會有差別吧
Dialogue: 5,0:13:42.83,0:13:44.39,Dial_CH,,0,0,0,,秋野同學 你手上是…
Dialogue: 5,0:13:45.05,0:13:45.88,Dial_CH,,0,0,0,,這個啊
Dialogue: 5,0:13:45.88,0:13:47.81,Dial_CH,,0,0,0,,我順手拿了
Dialogue: 5,0:13:47.81,0:13:51.60,Dial_CH,,0,0,0,,四季不想玩的話 不用勉強
Dialogue: 5,0:13:51.88,0:13:53.14,Dial_CH,,0,0,0,,不啊
Dialogue: 5,0:13:53.56,0:13:55.92,Dial_CH,,0,0,0,,我想和秋野同學一起玩
Dialogue: 5,0:14:00.89,0:14:02.58,Dial_CH,,0,0,0,,四季 你也太純真了
Dialogue: 5,0:14:03.06,0:14:05.25,Dial_CH,,0,0,0,,秋野同學是我的師父
Dialogue: 5,0:14:05.47,0:14:07.04,Dial_CH,,0,0,0,,冬木同學也要來當徒弟嗎
Dialogue: 5,0:14:07.04,0:14:08.29,Dial_CH,,0,0,0,,我當我當
Dialogue: 5,0:14:08.29,0:14:10.75,Dial_CH,,0,0,0,,雖然不知道是什麼的師父 但我要當
Dialogue: 5,0:14:10.75,0:14:12.33,Dial_CH,,0,0,0,,可以嗎 師父
Dialogue: 5,0:14:14.82,0:14:16.79,Dial_CH,,0,0,0,,我可以嗎
Dialogue: 5,0:14:20.30,0:14:24.22,Dial_CH,,0,0,0,,行吧 那放學後在東武集合
Dialogue: 5,0:14:24.22,0:14:26.85,Dial_CH,,0,0,0,,好喔 超期待
Dialogue: 5,0:14:26.85,0:14:27.80,Dial_CH,,0,0,0,,東武？
Dialogue: 5,0:14:35.13,0:14:37.36,Dial_CH,,0,0,0,,那邊是時裝區
Dialogue: 5,0:14:37.94,0:14:39.86,Dial_CH,,0,0,0,,這裡是美食廣場
Dialogue: 5,0:14:40.10,0:14:42.72,Dial_CH,,0,0,0,,超市裡全都是肉
Dialogue: 5,0:14:44.52,0:14:46.45,Dial_CH,,0,0,0,,好寬敞
Dialogue: 5,0:14:46.45,0:14:48.74,Dial_CH,,0,0,0,,東京那邊的應該更大些吧
Dialogue: 5,0:14:50.03,0:14:53.95,Dial_CH,,0,0,0,,但這裡跟那邊常見的購物中心不太一樣
Dialogue: 5,0:14:53.95,0:14:55.67,Dial_CH,,0,0,0,,是嗎 哪裡不一樣
Dialogue: 5,0:14:55.67,0:14:57.24,Dial_CH,,0,0,0,,這裡的寬敞給人感覺比較舒適
Dialogue: 5,0:14:57.24,0:14:59.29,Dial_CH,,0,0,0,,地方大是這樣的
Dialogue: 5,0:15:00.35,0:15:04.28,Dial_CH,,0,0,0,,整體待著很舒適 能讓人靜得下心來
Dialogue: 5,0:15:05.07,0:15:06.00,Dial_CH,,0,0,0,,是嗎
Dialogue: 5,0:15:06.28,0:15:07.35,Dial_CH,,0,0,0,,他說是那應該就是了
Dialogue: 5,0:15:09.20,0:15:09.88,Dial_CH,,0,0,0,,不行
Dialogue: 5,0:15:10.31,0:15:11.62,Dial_CH,,0,0,0,,還差一點 快跑
Dialogue: 5,0:15:11.62,0:15:13.40,Dial_CH,,0,0,0,,左邊左邊 小心
Dialogue: 5,0:15:13.40,0:15:15.24,Dial_CH,,0,0,0,,對 就現在 扔手榴彈
Dialogue: 5,0:15:24.58,0:15:25.91,Dial_CH,,0,0,0,,成功了
Dialogue: 5,0:15:30.92,0:15:32.83,Dial_CH,,0,0,0,,我去趟廁所
Dialogue: 5,0:15:32.83,0:15:35.23,Dial_CH,,0,0,0,,往那邊走到底再左轉
Dialogue: 5,0:15:35.23,0:15:36.30,Dial_CH,,0,0,0,,慢走
Dialogue: 5,0:15:38.98,0:15:39.87,Dial_CH,,0,0,0,,問你啊
Dialogue: 5,0:15:40.20,0:15:41.38,Dial_CH,,0,0,0,,幹嘛呀
Dialogue: 5,0:15:41.38,0:15:43.99,Dial_CH,,0,0,0,,回去的時候要不要看看化妝品
Dialogue: 5,0:15:43.99,0:15:45.72,Dial_CH,,0,0,0,,沙友友肯定也愛逛吧
Dialogue: 5,0:15:46.02,0:15:47.68,Dial_CH,,0,0,0,,沙 沙友友
Dialogue: 5,0:15:47.68,0:15:49.93,Dial_CH,,0,0,0,,沙友理 所以是沙友友
Dialogue: 5,0:15:50.18,0:15:51.52,Dial_CH,,0,0,0,,去不去 去唄
Dialogue: 5,0:15:53.09,0:15:53.81,Dial_CH,,0,0,0,,好
Dialogue: 5,0:15:54.87,0:15:58.28,Dial_CH,,0,0,0,,美瞳也挺貴的 我們可以湊個單
Dialogue: 5,0:15:58.72,0:16:00.02,Dial_CH,,0,0,0,,那敢情好
Dialogue: 5,0:16:00.02,0:16:01.53,Dial_CH,,0,0,0,,咱們拼著用吧
Dialogue: 5,0:16:01.73,0:16:03.79,Dial_CH,,0,0,0,,我還想買唇膏
Dialogue: 5,0:16:03.79,0:16:06.36,Dial_CH,,0,0,0,,還有洗髮精
Dialogue: 5,0:16:07.68,0:16:08.99,Dial_CH,,0,0,0,,冬木
Dialogue: 5,0:16:10.47,0:16:12.03,Dial_CH,,0,0,0,,你這人真的 挺好的
Dialogue: 5,0:16:16.93,0:16:19.61,Dial_CH,,0,0,0,,對不起 以前總在學校冒犯你
Dialogue: 5,0:16:20.05,0:16:23.72,Dial_CH,,0,0,0,,沒事沒事 我不介意的
Dialogue: 5,0:16:24.80,0:16:25.88,Dial_CH,,0,0,0,,他回來了
Dialogue: 5,0:16:42.67,0:16:45.63,Dial_CH,,0,0,0,,買了翼挑的洗髮精
Dialogue: 5,0:16:46.42,0:16:48.68,Dial_CH,,0,0,0,,美瞳也是四季嚴選呢
Dialogue: 5,0:16:49.66,0:16:51.32,Dial_CH,,0,0,0,,不合適的話我謝罪
Dialogue: 5,0:16:52.87,0:16:54.37,Dial_CH,,0,0,0,,完美
Dialogue: 5,0:16:54.37,0:16:57.63,Dial_CH,,0,0,0,,同步啦 天生好閨蜜
Dialogue: 5,0:16:59.98,0:17:01.96,Dial_CH,,0,0,0,,差不多該回家了
Dialogue: 5,0:17:02.62,0:17:03.59,Dial_CH,,0,0,0,,是啊
Dialogue: 5,0:17:05.56,0:17:06.05,Dial_CH,,0,0,0,,對了
Dialogue: 5,0:17:06.72,0:17:10.30,Dial_CH,,0,0,0,,回去前咱三人
Dialogue: 5,0:17:10.83,0:17:11.81,Dial_CH,,0,0,0,,試試這個唄
Dialogue: 5,0:17:11.81,0:17:13.40,Dial_CH,,0,0,0,,我沒意見 四季呢
Dialogue: 5,0:17:13.80,0:17:15.31,Dial_CH,,0,0,0,,拍一個嘛
Dialogue: 5,0:17:42.38,0:17:43.00,Dial_CH,,0,0,0,,話說
Dialogue: 5,0:17:43.66,0:17:46.92,Dial_CH,,0,0,0,,英語作業是上課時候交嗎
Dialogue: 5,0:17:48.01,0:17:49.81,Dial_CH,,0,0,0,,冬木同學應該知道吧
Dialogue: 5,0:18:01.07,0:18:02.24,Dial_CH,,0,0,0,,冬木同學
Dialogue: 5,0:18:02.24,0:18:03.19,Dial_CH,,0,0,0,,回覆得好快
Dialogue: 5,0:18:03.19,0:18:04.94,Dial_CH,,0,0,0,,在半身浴呢
Dialogue: 5,0:18:06.80,0:18:08.46,Dial_CH,,0,0,0,,對 對不起
Dialogue: 5,0:18:08.46,0:18:10.96,Dial_CH,,0,0,0,,等你泡完再告訴我…
Dialogue: 5,0:18:14.67,0:18:18.24,Dial_CH,,0,0,0,,讓我來瞧瞧翼會怎麼回我呢
Dialogue: 5,0:18:18.64,0:18:20.16,Dial_CH,,0,0,0,,肯定慌死了
Dialogue: 5,0:18:21.47,0:18:25.27,Dial_CH,,0,0,0,,抱歉在你泡澡時打擾你 狐狸玩偶很可愛
Dialogue: 5,0:18:33.14,0:18:34.56,Dial_CH,,0,0,0,,這
Dialogue: 5,0:18:35.73,0:18:39.89,Dial_CH,,0,0,0,,看了這個還讓我怎麼認真學習啊
Dialogue: 5,0:18:40.19,0:18:42.20,Dial_CH,,0,0,0,,我都豁出去了
Dialogue: 5,0:18:42.20,0:18:44.82,Dial_CH,,0,0,0,,你可得來點有意思的反應啊
Dialogue: 5,0:18:45.46,0:18:46.19,Dial_CH,,0,0,0,,來了
Dialogue: 5,0:18:46.55,0:18:49.02,Dial_CH,,0,0,0,,感覺你很注重保養皮膚
Dialogue: 5,0:18:49.02,0:18:51.55,Dial_CH,,0,0,0,,從照片可以看出你下了很多功夫
Dialogue: 5,0:18:51.55,0:18:54.33,Dial_CH,,0,0,0,,感受到了冬木同學那份一絲不苟的態度
Dialogue: 5,0:18:57.38,0:18:59.78,Dial_CH,,0,0,0,,這回覆應該沒問題吧
Dialogue: 5,0:19:02.94,0:19:03.90,Dial_CH,,0,0,0,,電話
Dialogue: 5,0:19:04.34,0:19:06.21,Dial_CH,,0,0,0,,我應該接嗎
Dialogue: 5,0:19:10.88,0:19:11.91,Dial_CH,,0,0,0,,你好
Dialogue: 5,0:19:12.48,0:19:15.55,Dial_CH,,0,0,0,,那份拉著我不接的理性已然因公殉職了
Dialogue: 5,0:19:15.76,0:19:17.06,Dial_CH,,0,0,0,,看得見嗎
Dialogue: 5,0:19:19.16,0:19:20.19,Dial_CH,,0,0,0,,喂
Dialogue: 5,0:19:21.46,0:19:22.30,Dial_CH,,0,0,0,,冬木同學
Dialogue: 5,0:19:22.30,0:19:25.33,Dial_CH,,0,0,0,,在泡澡期間打視訊電話是否有點不妥呢
Dialogue: 5,0:19:25.33,0:19:27.90,Dial_CH,,0,0,0,,終於是平常的反應了呢
Dialogue: 5,0:19:28.28,0:19:30.12,Dial_CH,,0,0,0,,臉都紅成猴屁股了
Dialogue: 5,0:19:31.47,0:19:33.59,Dial_CH,,0,0,0,,我 沒開攝影機啊
Dialogue: 5,0:19:35.23,0:19:36.66,Dial_CH,,0,0,0,,太有趣了
Dialogue: 5,0:19:36.66,0:19:38.28,Dial_CH,,0,0,0,,超有意思
Dialogue: 5,0:19:40.54,0:19:42.95,Dial_CH,,0,0,0,,出的招比平時更難接
Dialogue: 5,0:19:44.32,0:19:46.85,Dial_CH,,0,0,0,,再這樣下去我感覺小命不保
Dialogue: 5,0:19:47.94,0:19:51.19,Dial_CH,,0,0,0,,你會每天都泡澡嗎
Dialogue: 5,0:19:51.77,0:19:52.75,Dial_CH,,0,0,0,,泡啊
Dialogue: 5,0:19:53.01,0:19:54.66,Dial_CH,,0,0,0,,剛泡完
Dialogue: 5,0:19:55.63,0:19:58.56,Dial_CH,,0,0,0,,我家除了我和媽媽都是兩天一次
Dialogue: 5,0:19:58.56,0:20:00.26,Dial_CH,,0,0,0,,雖然沖澡是每天都沖
Dialogue: 5,0:20:00.64,0:20:01.85,Dial_CH,,0,0,0,,是嗎
Dialogue: 5,0:20:01.85,0:20:05.24,Dial_CH,,0,0,0,,我還以為這麼冷的天 肯定會天天泡呢
Dialogue: 5,0:20:05.24,0:20:09.37,Dial_CH,,0,0,0,,爸爸不怎麼出汗 而且怕瓦斯費爆炸
Dialogue: 5,0:20:09.37,0:20:11.27,Dial_CH,,0,0,0,,所以就說別每天都泡
Dialogue: 5,0:20:11.53,0:20:14.49,Dial_CH,,0,0,0,,但你和你媽媽每天都泡
Dialogue: 5,0:20:14.49,0:20:16.05,Dial_CH,,0,0,0,,那不是沒什麼區別嗎
Dialogue: 5,0:20:16.05,0:20:18.78,Dial_CH,,0,0,0,,爸爸說半身浴就還好啦
Dialogue: 5,0:20:18.78,0:20:21.45,Dial_CH,,0,0,0,,冬天真難省錢啊
Dialogue: 5,0:20:21.45,0:20:25.79,Dial_CH,,0,0,0,,以前家裡還經常一起去泡溫泉呢
Dialogue: 5,0:20:25.79,0:20:27.25,Dial_CH,,0,0,0,,溫泉好啊
Dialogue: 5,0:20:27.25,0:20:29.10,Dial_CH,,0,0,0,,北見是有很多溫泉的
Dialogue: 5,0:20:29.10,0:20:29.92,Dial_CH,,0,0,0,,你也去泡一泡唄
Dialogue: 5,0:20:29.92,0:20:31.84,Dial_CH,,0,0,0,,嗯 我去查一查
Dialogue: 5,0:20:31.84,0:20:34.60,Dial_CH,,0,0,0,,還是說 要我陪你一起去呢
Dialogue: 5,0:20:36.89,0:20:40.55,Dial_CH,,0,0,0,,我已經不吃這一套了 冬木同學
Dialogue: 5,0:20:41.48,0:20:43.47,Dial_CH,,0,0,0,,那多沒意思
Dialogue: 5,0:20:43.99,0:20:46.48,Dial_CH,,0,0,0,,你現在在做什麼呢
Dialogue: 5,0:20:46.74,0:20:48.17,Dial_CH,,0,0,0,,英語作業
Dialogue: 5,0:20:48.61,0:20:50.15,Dial_CH,,0,0,0,,在寫今天的
Dialogue: 5,0:20:50.65,0:20:51.38,Dial_CH,,0,0,0,,對了
Dialogue: 5,0:20:51.38,0:20:54.29,Dial_CH,,0,0,0,,作業是要明天交的吧
Dialogue: 5,0:20:54.29,0:20:55.90,Dial_CH,,0,0,0,,本來就是想問一問這事
Dialogue: 5,0:20:56.10,0:20:57.53,Dial_CH,,0,0,0,,糟了
Dialogue: 5,0:20:57.53,0:20:59.87,Dial_CH,,0,0,0,,我還一個字都沒動呢…
Dialogue: 5,0:21:00.20,0:21:01.20,Dial_CH,,0,0,0,,冬木同學
Dialogue: 5,0:21:21.48,0:21:22.63,Dial_CH,,0,0,0,,怎麼了 冬木同學
Dialogue: 5,0:21:22.63,0:21:23.64,Dial_CH,,0,0,0,,沒事吧
Dialogue: 5,0:21:24.34,0:21:25.24,Dial_CH,,0,0,0,,冬木同學
Dialogue: 5,0:21:26.92,0:21:27.81,Dial_CH,,0,0,0,,你看見了嗎
Dialogue: 5,0:21:29.97,0:21:30.52,Dial_CH,,0,0,0,,什麼
Dialogue: 5,0:21:30.76,0:21:31.61,Dial_CH,,0,0,0,,就剛才…
Dialogue: 5,0:21:31.61,0:21:34.66,Dial_CH,,0,0,0,,對不起 你嚇到我了 手機沒拿穩差點掉了
Dialogue: 5,0:21:37.22,0:21:38.47,Dial_CH,,0,0,0,,這樣啊
Dialogue: 5,0:21:38.47,0:21:40.87,Dial_CH,,0,0,0,,我也差不多泡夠了
Dialogue: 5,0:21:42.66,0:21:44.32,Dial_CH,,0,0,0,,好 明天見
Dialogue: 5,0:21:47.50,0:21:49.93,Dial_CH,,0,0,0,,冬木同學是怎麼了
Dialogue: 5,0:21:50.67,0:21:53.63,Dial_CH,,0,0,0,,作業的事有那麼震驚嗎
Dialogue: 5,0:22:01.55,0:22:04.67,Dial_CH,,0,0,0,,就不該做這種不習慣的事
Dialogue: 5,0:22:06.19,0:22:07.59,Dial_CH,,0,0,0,,小美 出來了啊
Dialogue: 5,0:22:08.40,0:22:11.67,Dial_CH,,0,0,0,,我也想泡一下… 怎麼了
Dialogue: 5,0:22:11.67,0:22:12.56,Dial_CH,,0,0,0,,泡暈了嗎
Dialogue: 5,0:22:16.72,0:22:18.44,Dial_CH,,0,0,0,,一點點
Dialogue: 5,0:22:22.73,0:22:26.86,Dial_CH,,0,0,0,,次日 冬木同學沒能按時交作業
Dialogue: 5,0:22:26.86,0:22:28.75,Dial_CH,,0,0,0,,被老師訓了一頓
