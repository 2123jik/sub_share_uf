Dialogue: 0,0:04:58.83,0:05:00.04,字幕制作,,0,0,0,,{\fn方正大黑_GBK\fs45\b1\pos(960,960)}字幕制作\N{\fs60}星空字幕组
Dialogue: 0,0:05:00.05,0:05:01.56,CHS,,0,0,0,,数周之前
Dialogue: 0,0:05:03.79,0:05:06.20,CHS,,0,0,0,,第6队最近怎么样
Dialogue: 1,0:05:03.79,0:05:06.20,JAP,,0,0,0,,近頃どうだね？第６は
Dialogue: 0,0:05:06.45,0:05:08.07,CHS,,0,0,0,,一切顺利
Dialogue: 1,0:05:06.45,0:05:08.07,JAP,,0,0,0,,順調ですよ
Dialogue: 0,0:05:08.22,0:05:10.22,CHS,,0,0,0,,毕竟有黄大队长坐镇
Dialogue: 1,0:05:08.22,0:05:10.22,JAP,,0,0,0,,黄大隊長がいますから
Dialogue: 0,0:05:10.60,0:05:11.77,CHS,,0,0,0,,今天也很和平
Dialogue: 1,0:05:10.60,0:05:11.77,JAP,,0,0,0,,今も平和に…
Dialogue: 0,0:05:13.72,0:05:15.50,CHS,,0,0,0,,怎么可以
Dialogue: 1,0:05:13.72,0:05:15.50,JAP,,0,0,0,,なんと〜！
Dialogue: 0,0:05:19.47,0:05:20.22,CHS,,0,0,0,,不错啊
Dialogue: 1,0:05:19.47,0:05:20.22,JAP,,0,0,0,,ほお…
Dialogue: 0,0:05:19.68,0:05:19.68,ED,,0,0,0,,
Dialogue: 0,0:05:19.68,0:05:19.72,字幕制作,,0,0,0,,
Dialogue: 0,0:05:20.23,0:05:20.23,OPJP,,0,0,0,,
Dialogue: 0,0:05:20.23,0:05:20.23,OPJP,,0,0,0,,
Dialogue: 0,0:05:20.62,0:05:23.57,CHS,,0,0,0,,这就是经过庇护后达到了光速的速度吗
Dialogue: 1,0:05:20.62,0:05:23.57,JAP,,0,0,0,,これが加護を受け光速まで達するスピードか
Dialogue: 0,0:05:21.05,0:05:23.05,字幕制作,,0,0,0,,
Dialogue: 0,0:05:30.61,0:05:34.15,CHS,,0,0,0,,日下部 你需要绝对的静养
Dialogue: 1,0:05:30.61,0:05:34.15,JAP,,0,0,0,,日下部さん！あなたは絶対安静ですよ！
Dialogue: 0,0:05:34.15,0:05:35.87,CHS,,0,0,0,,请马上回到床上去
Dialogue: 1,0:05:34.15,0:05:35.87,JAP,,0,0,0,,ベッドに戻ってください！
Dialogue: 0,0:05:36.82,0:05:38.42,CHS,,0,0,0,,让他们去吧
Dialogue: 1,0:05:36.82,0:05:38.42,JAP,,0,0,0,,やらせておきなさい
Dialogue: 0,0:05:39.07,0:05:40.90,CHS,,0,0,0,,看样子他们是不会停的
Dialogue: 1,0:05:39.07,0:05:40.90,JAP,,0,0,0,,ありゃ止まりはしないよ
Dialogue: 0,0:05:41.40,0:05:45.02,CHS,,0,0,0,,班兹那家伙 以前就是个固执的男人啊
Dialogue: 1,0:05:41.40,0:05:45.02,JAP,,0,0,0,,バーンズのヤツも　昔気質の頑固な男だ
Dialogue: 0,0:05:45.41,0:05:48.05,CHS,,0,0,0,,只会用这种蹩脚的交流方式
Dialogue: 1,0:05:45.41,0:05:48.05,JAP,,0,0,0,,不器用な対話しかできんのだよ
Dialogue: 0,0:05:49.25,0:05:54.34,CHS,,0,0,0,,被少年的成长触动后 他也有点激动了
Dialogue: 1,0:05:49.25,0:05:54.34,JAP,,0,0,0,,少年の成長に触発されて　中身はグツグツたぎっている
Dialogue: 0,0:05:54.80,0:05:56.30,CHS,,0,0,0,,为什么保持沉默
Dialogue: 1,0:05:54.80,0:05:56.30,JAP,,0,0,0,,なんで黙ってた！
Dialogue: 0,0:06:00.35,0:06:02.42,CHS,,0,0,0,,无论有什么理由都不可原谅
Dialogue: 1,0:06:00.35,0:06:02.42,JAP,,0,0,0,,どんな理由だろうと許さねえ！
Dialogue: 0,0:06:03.07,0:06:05.10,CHS,,0,0,0,,消防官要有大志
Dialogue: 1,0:06:03.07,0:06:05.10,JAP,,0,0,0,,消防官には大志がある
Dialogue: 0,0:06:05.35,0:06:07.60,CHS,,0,0,0,,不能为个人情感所动摇
Dialogue: 1,0:06:05.35,0:06:07.60,JAP,,0,0,0,,個人の感情で動いてはいられない
Dialogue: 0,0:06:10.00,0:06:11.35,CHS,,0,0,0,,你先退后
Dialogue: 1,0:06:10.00,0:06:11.35,JAP,,0,0,0,,下がっていなさい
Dialogue: 0,0:06:13.61,0:06:15.47,CHS,,0,0,0,,他准备升温了
Dialogue: 1,0:06:13.61,0:06:15.47,JAP,,0,0,0,,温まってきたようだ
Dialogue: 0,0:06:27.25,0:06:29.55,CHS,,0,0,0,,光是靠近就觉得要被压垮了
Dialogue: 1,0:06:27.25,0:06:29.55,JAP,,0,0,0,,近づいただけで押し潰されそうだ
Dialogue: 0,0:06:29.92,0:06:31.75,CHS,,0,0,0,,在体内燃烧火焰
Dialogue: 1,0:06:29.92,0:06:31.75,JAP,,0,0,0,,体内で炎を燃やし
Dialogue: 0,0:06:31.75,0:06:35.09,CHS,,0,0,0,,将生成的热能在体中循环
Dialogue: 1,0:06:31.75,0:06:35.09,JAP,,0,0,0,,生じた熱エネルギーを体中に循環させ
Dialogue: 0,0:06:35.09,0:06:38.09,CHS,,0,0,0,,发挥出惊人的身体能力
Dialogue: 1,0:06:35.09,0:06:38.09,JAP,,0,0,0,,驚異的な身体能力を発揮させる
Dialogue: 0,0:06:38.47,0:06:41.80,CHS,,0,0,0,,他不负火焰化身之名
Dialogue: 1,0:06:38.47,0:06:41.80,JAP,,0,0,0,,まさに“炎の化身”と呼ぶべきほどに
Dialogue: 0,0:06:41.80,0:06:45.60,CHS,,0,0,0,,班兹的身体是热能的集合
Dialogue: 1,0:06:41.80,0:06:45.60,JAP,,0,0,0,,バーンズの体は熱エネルギーの塊なのだ
Dialogue: 0,0:06:45.95,0:06:48.22,CHS,,0,0,0,,能力不够的人会丧命的
Dialogue: 1,0:06:45.95,0:06:48.22,JAP,,0,0,0,,弱い者は命を落とす
Dialogue: 0,0:06:49.02,0:06:51.57,CHS,,0,0,0,,那我就不能告诉你真相
Dialogue: 1,0:06:49.02,0:06:51.57,JAP,,0,0,0,,ならば真実を語るわけにはいかない
Dialogue: 0,0:06:51.87,0:06:54.62,CHS,,0,0,0,,想知道的话 就展示出与之相符的实力
Dialogue: 1,0:06:51.87,0:06:54.62,JAP,,0,0,0,,知りたければ　それに足る力を見せて
Dialogue: 0,0:06:54.82,0:06:56.49,CHS,,0,0,0,,来说服我
Dialogue: 1,0:06:54.82,0:06:56.49,JAP,,0,0,0,,納得させてみたまえ
Dialogue: 0,0:06:56.77,0:06:57.82,CHS,,0,0,0,,什么
Dialogue: 1,0:06:56.77,0:06:57.82,JAP,,0,0,0,,はあ〜？
Dialogue: 0,0:06:57.97,0:07:02.32,CHS,,0,0,0,,班兹大队长今天是来说12年前的事的吧
Dialogue: 1,0:06:57.97,0:07:02.32,JAP,,0,0,0,,バーンズ大隊長は　今日12年前のことを話しに来たんだろ？
Dialogue: 0,0:07:02.32,0:07:03.83,CHS,,0,0,0,,开什么玩笑
Dialogue: 1,0:07:02.32,0:07:03.83,JAP,,0,0,0,,ふざけんなよ！
Dialogue: 0,0:07:04.40,0:07:06.65,CHS,,0,0,0,,怎么 没信心吗
Dialogue: 1,0:07:04.40,0:07:06.65,JAP,,0,0,0,,なんだ…自信がないのか？
Dialogue: 0,0:07:06.65,0:07:09.15,CHS,,0,0,0,,当然有 这个狗屎 大
Dialogue: 1,0:07:06.65,0:07:09.15,JAP,,0,0,0,,違う！このクソ…だ…い…
Dialogue: 0,0:07:12.00,0:07:13.17,CHS,,0,0,0,,大骗子
Dialogue: 1,0:07:12.00,0:07:13.17,JAP,,0,0,0,,ウソつき！
Dialogue: 0,0:07:14.45,0:07:17.13,CHS,,0,0,0,,刚才他说了狗屎吧 还是对长官
Dialogue: 1,0:07:14.45,0:07:17.13,JAP,,0,0,0,,今“クソ”って言ったな　上官に
Dialogue: 0,0:07:17.35,0:07:19.59,CHS,,0,0,0,,很努力控制住了呢
Dialogue: 1,0:07:17.35,0:07:19.59,JAP,,0,0,0,,精いっぱい遠慮しましたね
Dialogue: 0,0:07:23.02,0:07:25.57,CHS,,0,0,0,,好 我明白了
Dialogue: 1,0:07:23.02,0:07:25.57,JAP,,0,0,0,,はい…分かりました
Dialogue: 0,0:07:26.42,0:07:27.72,CHS,,0,0,0,,我会展示给你看的
Dialogue: 1,0:07:26.42,0:07:27.72,JAP,,0,0,0,,見せてやりますよ
Dialogue: 0,0:07:28.12,0:07:30.75,CHS,,0,0,0,,我没有你想象中的软弱
Dialogue: 1,0:07:28.12,0:07:30.75,JAP,,0,0,0,,あなたが思うほど俺はひ弱じゃない
Dialogue: 0,0:07:48.00,0:07:50.95,CHS,,0,0,0,,被救的就是这条幼小娇弱的生命
Dialogue: 1,0:07:48.00,0:07:50.95,JAP,,0,0,0,,助けられたのはこの小さくかよわい命…
Dialogue: 0,0:07:51.33,0:07:52.52,CHS,,0,0,0,,只有一个人吗
Dialogue: 1,0:07:51.33,0:07:52.52,JAP,,0,0,0,,たった１つか
Dialogue: 0,0:07:53.20,0:07:55.87,CHS,,0,0,0,,我要打倒它 我要打倒它
Dialogue: 1,0:07:53.20,0:07:55.87,JAP,,0,0,0,,倒してやる　倒してやる…
Dialogue: 0,0:07:55.87,0:07:58.52,CHS,,0,0,0,,不能原谅那个混蛋 打倒它
Dialogue: 1,0:07:55.87,0:07:58.52,JAP,,0,0,0,,あの野郎許さねえ…倒す
Dialogue: 0,0:08:03.34,0:08:06.44,CHS,,0,0,0,,居然已经长得这般强大茁壮了啊
Dialogue: 1,0:08:03.34,0:08:06.44,JAP,,0,0,0,,ここまで強く　大きくなるとはな
Dialogue: 0,0:08:06.44,0:08:08.23,CHS,,0,0,0,,我会让你吐出一切的
Dialogue: 1,0:08:06.44,0:08:08.23,JAP,,0,0,0,,何が何でも教えてもらう！
Dialogue: 0,0:08:12.06,0:08:14.00,CHS,,0,0,0,,你的觉悟只有这点吗
Dialogue: 1,0:08:12.06,0:08:14.00,JAP,,0,0,0,,お前の覚悟はそんなものか！
Dialogue: 0,0:08:14.55,0:08:16.62,CHS,,0,0,0,,就像蜡烛的火苗啊
Dialogue: 1,0:08:14.55,0:08:16.62,JAP,,0,0,0,,まるでろうそくの火だな
Dialogue: 0,0:08:17.65,0:08:19.15,CHS,,0,0,0,,别小看我啊
Dialogue: 1,0:08:17.65,0:08:19.15,JAP,,0,0,0,,ナメんなよ…
Dialogue: 0,0:08:20.12,0:08:21.97,CHS,,0,0,0,,我才不是蜡烛
Dialogue: 1,0:08:20.12,0:08:21.97,JAP,,0,0,0,,俺はこんなものじゃねえ！
Dialogue: 0,0:08:38.05,0:08:40.22,CHS,,0,0,0,,你听到什么都不会后悔吗
Dialogue: 1,0:08:38.05,0:08:40.22,JAP,,0,0,0,,何を聞いても後悔しないか！
Dialogue: 0,0:08:40.40,0:08:43.50,CHS,,0,0,0,,为了找出真相 即便憎恶着火焰
Dialogue: 1,0:08:40.40,0:08:43.50,JAP,,0,0,0,,真実を知るため　炎を恨みながらも
Dialogue: 0,0:08:43.72,0:08:45.65,CHS,,0,0,0,,我也还是成为了消防官
Dialogue: 1,0:08:43.72,0:08:45.65,JAP,,0,0,0,,俺は消防官になったんだ！
Dialogue: 0,0:08:57.56,0:08:59.77,CHS,,0,0,0,,曾经那么小的火苗
Dialogue: 1,0:08:57.56,0:08:59.77,JAP,,0,0,0,,あんな小さかった炎が…
Dialogue: 0,0:09:01.82,0:09:04.20,CHS,,0,0,0,,居然燃烧到这种程度了啊
Dialogue: 1,0:09:01.82,0:09:04.20,JAP,,0,0,0,,ここまで大きくなるとはな
Dialogue: 0,0:09:05.30,0:09:06.42,CHS,,0,0,0,,这感觉久违了
Dialogue: 1,0:09:05.30,0:09:06.42,JAP,,0,0,0,,久しぶりだ…
Dialogue: 0,0:09:07.16,0:09:09.07,CHS,,0,0,0,,受伤的手臂都发麻了
Dialogue: 1,0:09:07.16,0:09:09.07,JAP,,0,0,0,,受け止めた腕がしびれている
Dialogue: 0,0:09:10.37,0:09:11.60,CHS,,0,0,0,,你变强了啊
Dialogue: 1,0:09:10.37,0:09:11.60,JAP,,0,0,0,,強くなったな
Dialogue: 0,0:09:14.02,0:09:15.95,CHS,,0,0,0,,我接收到你的觉悟了
Dialogue: 1,0:09:14.02,0:09:15.95,JAP,,0,0,0,,お前の覚悟は伝わった
Dialogue: 0,0:09:16.25,0:09:18.96,CHS,,0,0,0,,好 我会告诉你一切
Dialogue: 1,0:09:16.25,0:09:18.96,JAP,,0,0,0,,よかろう　全てを話してやる
Dialogue: 0,0:09:19.63,0:09:23.90,CHS,,0,0,0,,那场火灾的真相和你知道的不同
Dialogue: 1,0:09:19.63,0:09:23.90,JAP,,0,0,0,,あの火災…真実はお前の知るものとは違う
Dialogue: 0,0:09:24.90,0:09:28.42,CHS,,0,0,0,,和你战斗过的传教者一伙在12年前
Dialogue: 1,0:09:24.90,0:09:28.42,JAP,,0,0,0,,お前が戦った伝導者の一味は12年前…
Dialogue: 0,0:09:28.73,0:09:31.49,CHS,,0,0,0,,第贰拾四话 ｢燃烧的过去｣
Dialogue: 0,0:09:29.20,0:09:30.87,CHS,,0,0,0,,就开始行动了
Dialogue: 1,0:09:29.20,0:09:30.87,JAP,,0,0,0,,既に動いていた
Dialogue: 0,0:09:31.61,0:09:33.58,CHS,,0,0,0,,太阳历一百八十六年
Dialogue: 0,0:09:40.92,0:09:42.32,CHS,,0,0,0,,感觉到什么了吗
Dialogue: 1,0:09:40.92,0:09:42.32,JAP,,0,0,0,,何か感じるか？
Dialogue: 0,0:09:42.55,0:09:45.42,CHS,,0,0,0,,我不是说了传教者在这附近吗
Dialogue: 1,0:09:42.55,0:09:45.42,JAP,,0,0,0,,伝導者がこの辺だって言ったんだろ？
Dialogue: 0,0:09:45.82,0:09:49.20,CHS,,0,0,0,,要产生了哦 新的安德拉爆炎
Dialogue: 1,0:09:45.82,0:09:49.20,JAP,,0,0,0,,生まれるよ　新しいアドラバースト
Dialogue: 0,0:09:53.25,0:09:54.41,CHS,,0,0,0,,来了 就是他
Dialogue: 1,0:09:53.25,0:09:54.41,JAP,,0,0,0,,キタコレ！
Dialogue: 0,0:09:54.55,0:09:57.14,@屏幕字,,0,0,0,,{\fs60\bord3\pos(286,8４５)}　※传教者\N　　　麾下\N\N\N\N{\fs72}\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N※蒿梅雅
Dialogue: 0,0:09:57.25,0:10:01.32,CHS,,0,0,0,,传教者事先就知道会有那场火灾发生
Dialogue: 1,0:09:57.25,0:10:01.32,JAP,,0,0,0,,伝導者は　事前にあの火事が起きることを知っていた
Dialogue: 0,0:10:01.60,0:10:04.47,CHS,,0,0,0,,果然 传教者和那帮人
Dialogue: 1,0:10:01.60,0:10:04.47,JAP,,0,0,0,,やっぱり　伝導者と連中が…
Dialogue: 0,0:10:05.72,0:10:08.68,CHS,,0,0,0,,那场火灾的起因被弄清了
Dialogue: 1,0:10:05.72,0:10:08.68,JAP,,0,0,0,,あの火事の出火原因ははっきりしていた
Dialogue: 0,0:10:08.92,0:10:09.80,CHS,,0,0,0,,不是你做的
Dialogue: 1,0:10:08.92,0:10:09.80,JAP,,0,0,0,,お前じゃない
Dialogue: 0,0:10:09.80,0:10:10.67,CHS,,0,0,0,,没错
Dialogue: 1,0:10:09.80,0:10:10.67,JAP,,0,0,0,,そうです！
Dialogue: 0,0:10:10.89,0:10:12.60,CHS,,0,0,0,,有个鬼焰人在那里
Dialogue: 1,0:10:10.89,0:10:12.60,JAP,,0,0,0,,鬼の焔ビトがいたんです！
Dialogue: 0,0:10:14.44,0:10:15.37,@屏幕字,,0,0,0,,{\fs60\bord3\pos(286,8４５)}　※传教者\N　　　麾下\N\N\N\N{\fs72}\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N※蒿梅雅
Dialogue: 0,0:10:15.68,0:10:18.02,CHS,,0,0,0,,欢迎欢迎 第三人
Dialogue: 1,0:10:15.68,0:10:18.02,JAP,,0,0,0,,歓迎するぜ　３人目
Dialogue: 0,0:10:23.72,0:10:24.45,CHS,,0,0,0,,象
Dialogue: 1,0:10:23.72,0:10:24.45,JAP,,0,0,0,,ショウ！
Dialogue: 0,0:10:29.15,0:10:29.95,CHS,,0,0,0,,森罗
Dialogue: 1,0:10:29.15,0:10:29.95,JAP,,0,0,0,,シンラ！
Dialogue: 0,0:10:29.95,0:10:32.41,CHS,,0,0,0,,快点 逃走 快点
Dialogue: 1,0:10:29.95,0:10:32.41,JAP,,0,0,0,,早く　逃げなさい！早く！
Dialogue: 0,0:10:36.35,0:10:40.67,CHS,,0,0,0,,快点 森罗 快 逃
Dialogue: 1,0:10:36.35,0:10:40.67,JAP,,0,0,0,,早く　シンラ…逃げ…て…
Dialogue: 0,0:10:50.51,0:10:51.35,CHS,,0,0,0,,鬼
Dialogue: 1,0:10:50.51,0:10:51.35,JAP,,0,0,0,,鬼…
Dialogue: 0,0:11:02.40,0:11:04.35,CHS,,0,0,0,,象 象
Dialogue: 1,0:11:02.40,0:11:04.35,JAP,,0,0,0,,ショウ！ショウ！
Dialogue: 0,0:11:05.25,0:11:08.75,CHS,,0,0,0,,12年前 那场火灾的火源
Dialogue: 1,0:11:05.25,0:11:08.75,JAP,,0,0,0,,12年前の　あの火事の出火元は…
Dialogue: 0,0:11:10.57,0:11:12.57,CHS,,0,0,0,,是你的弟弟象
Dialogue: 1,0:11:10.57,0:11:12.57,JAP,,0,0,0,,お前の弟のショウ
Dialogue: 0,0:11:14.17,0:11:16.24,CHS,,0,0,0,,象 象
Dialogue: 1,0:11:14.17,0:11:16.24,JAP,,0,0,0,,ショウ！ショウ！
Dialogue: 0,0:11:17.25,0:11:19.32,CHS,,0,0,0,,受到象的安德拉爆炎影响
Dialogue: 1,0:11:17.25,0:11:19.32,JAP,,0,0,0,,ショウのアドラバーストの影響で
Dialogue: 0,0:11:19.82,0:11:22.77,CHS,,0,0,0,,你觉醒了第三代的能力
Dialogue: 1,0:11:19.82,0:11:22.77,JAP,,0,0,0,,お前は第三世代の能力に目覚めた
Dialogue: 0,0:11:36.81,0:11:39.89,CHS,,0,0,0,,你知道我们遮住眼睛的理由吧
Dialogue: 1,0:11:36.81,0:11:39.89,JAP,,0,0,0,,俺たちが目を隠している理由は分かってるな？
Dialogue: 0,0:11:40.05,0:11:41.72,CHS,,0,0,0,,那当然了
Dialogue: 1,0:11:40.05,0:11:41.72,JAP,,0,0,0,,当たり前だろ
Dialogue: 0,0:11:42.25,0:11:45.82,CHS,,0,0,0,,直接目视太阳的话眼睛会被烧掉的
Dialogue: 1,0:11:42.25,0:11:45.82,JAP,,0,0,0,,太陽は直接見ると目が焼かれるからね
Dialogue: 0,0:11:46.20,0:11:49.72,CHS,,0,0,0,,太阳光芒四丈 然人子毋能目视
Dialogue: 1,0:11:46.20,0:11:49.72,JAP,,0,0,0,,太陽は輝けど　人の子には見えず
Dialogue: 0,0:11:49.97,0:11:54.12,CHS,,0,0,0,,欲想接近神界 唯有诚心感受
Dialogue: 1,0:11:49.97,0:11:54.12,JAP,,0,0,0,,神界に近づきたくば　心でただ感じよ
Dialogue: 0,0:12:11.47,0:12:14.82,CHS,,0,0,0,,你看到的那个长角焰人
Dialogue: 1,0:12:11.47,0:12:14.82,JAP,,0,0,0,,お前が見たという　角の焔ビトは…
Dialogue: 0,0:12:16.22,0:12:17.25,CHS,,0,0,0,,是妈妈
Dialogue: 1,0:12:16.22,0:12:17.25,JAP,,0,0,0,,母さん？
Dialogue: 0,0:12:22.19,0:12:23.20,CHS,,0,0,0,,怎么会
Dialogue: 1,0:12:22.19,0:12:23.20,JAP,,0,0,0,,そんな…
Dialogue: 0,0:12:23.77,0:12:26.60,CHS,,0,0,0,,我 是为了找出那个焰人
Dialogue: 1,0:12:23.77,0:12:26.60,JAP,,0,0,0,,俺は　あの焔ビトを捜すため…
Dialogue: 0,0:12:27.50,0:12:28.67,CHS,,0,0,0,,打倒它
Dialogue: 1,0:12:27.50,0:12:28.67,JAP,,0,0,0,,ぶっ倒すために
Dialogue: 0,0:12:29.20,0:12:30.85,CHS,,0,0,0,,才一直走到这步的
Dialogue: 1,0:12:29.20,0:12:30.85,JAP,,0,0,0,,これまでやってきたのに
Dialogue: 0,0:12:46.42,0:12:48.20,CHS,,0,0,0,,火灾原因是象
Dialogue: 1,0:12:46.42,0:12:48.20,JAP,,0,0,0,,出火原因がショウで
Dialogue: 0,0:12:48.84,0:12:51.87,CHS,,0,0,0,,我看到的鬼焰人 是妈妈
Dialogue: 1,0:12:48.84,0:12:51.87,JAP,,0,0,0,,俺が見た鬼の焔ビトが　母だった…
Dialogue: 0,0:12:52.70,0:12:54.70,CHS,,0,0,0,,那我妈妈
Dialogue: 1,0:12:52.70,0:12:54.70,JAP,,0,0,0,,それなら　俺の母は…
Dialogue: 0,0:12:55.45,0:12:56.55,CHS,,0,0,0,,她怎么样了
Dialogue: 1,0:12:55.45,0:12:56.55,JAP,,0,0,0,,どうなったんですか？
Dialogue: 0,0:12:57.10,0:13:01.27,CHS,,0,0,0,,我到火灾现场时 已经过了15分钟
Dialogue: 1,0:12:57.10,0:13:01.27,JAP,,0,0,0,,私が火事現場に着いたのは　出火から15分後
Dialogue: 0,0:13:03.45,0:13:04.70,CHS,,0,0,0,,里面的生存者呢
Dialogue: 1,0:13:03.45,0:13:04.70,JAP,,0,0,0,,中に生存者は？
Dialogue: 0,0:13:04.90,0:13:06.85,CHS,,0,0,0,,为什么不灭火
Dialogue: 1,0:13:04.90,0:13:06.85,JAP,,0,0,0,,なんで消火活動をしていない！
Dialogue: 0,0:13:07.07,0:13:11.07,CHS,,0,0,0,,这不是普通的火焰 用水根本扑不灭
Dialogue: 1,0:13:07.07,0:13:11.07,JAP,,0,0,0,,この炎普通じゃない！放水で全く弱まらない！
Dialogue: 0,0:13:14.45,0:13:16.20,CHS,,0,0,0,,重新开始灭火
Dialogue: 1,0:13:14.45,0:13:16.20,JAP,,0,0,0,,消火作業を再開しろ！
Dialogue: 0,0:13:16.57,0:13:20.42,CHS,,0,0,0,,对火焰抗性强的第三代能力者 跟我来
Dialogue: 1,0:13:16.57,0:13:20.42,JAP,,0,0,0,,炎耐性の強い第三世代能力者は　私に続け！
Dialogue: 0,0:13:20.87,0:13:23.60,CHS,,0,0,0,,突入进去 确保生还者
Dialogue: 1,0:13:20.87,0:13:23.60,JAP,,0,0,0,,中に突入し　生存者を確認する！
Dialogue: 0,0:13:30.10,0:13:31.77,CHS,,0,0,0,,3 2 1
Dialogue: 1,0:13:30.10,0:13:31.77,JAP,,0,0,0,,３　２　１…
Dialogue: 0,0:13:36.40,0:13:37.39,CHS,,0,0,0,,有生还者
Dialogue: 1,0:13:36.40,0:13:37.39,JAP,,0,0,0,,生存者です！
Dialogue: 0,0:13:37.60,0:13:39.35,CHS,,0,0,0,,把急救人员叫来
Dialogue: 1,0:13:37.60,0:13:39.35,JAP,,0,0,0,,救急要員を呼べ！
Dialogue: 0,0:13:39.35,0:13:39.90,CHS,,0,0,0,,是
Dialogue: 1,0:13:39.35,0:13:39.90,JAP,,0,0,0,,はい！
Dialogue: 0,0:13:41.47,0:13:45.27,CHS,,0,0,0,,放开我 妈妈和象 还在里面
Dialogue: 1,0:13:41.47,0:13:45.27,JAP,,0,0,0,,放せ！まだ中に　母さんとショウが…
Dialogue: 0,0:13:45.55,0:13:47.75,CHS,,0,0,0,,有坏鬼在接近他们
Dialogue: 1,0:13:45.55,0:13:47.75,JAP,,0,0,0,,悪い鬼が近くにいるんだ！
Dialogue: 0,0:13:48.30,0:13:49.06,CHS,,0,0,0,,班兹
Dialogue: 1,0:13:48.30,0:13:49.06,JAP,,0,0,0,,バーンズ
Dialogue: 0,0:13:49.75,0:13:52.25,CHS,,0,0,0,,扑不灭的火 鬼
Dialogue: 1,0:13:49.75,0:13:52.25,JAP,,0,0,0,,消えない炎…鬼…
Dialogue: 0,0:13:52.82,0:13:54.27,CHS,,0,0,0,,我有种不好的预感
Dialogue: 1,0:13:52.82,0:13:54.27,JAP,,0,0,0,,嫌な予感しかしない
Dialogue: 0,0:13:55.10,0:13:56.20,CHS,,0,0,0,,准备突入
Dialogue: 1,0:13:55.10,0:13:56.20,JAP,,0,0,0,,突入する！
Dialogue: 0,0:13:59.35,0:14:02.16,CHS,,0,0,0,,伪装成母亲的尸体已经放置好了
Dialogue: 1,0:13:59.35,0:14:02.16,JAP,,0,0,0,,母親に見せかけた死体はセットした
Dialogue: 0,0:14:02.57,0:14:05.30,CHS,,0,0,0,,蒿梅雅 怎么样 能操纵吗
Dialogue: 1,0:14:02.57,0:14:05.30,JAP,,0,0,0,,ハウメア　どうだ？操れたか？
Dialogue: 0,0:14:07.33,0:14:09.22,CHS,,0,0,0,,蒿梅雅 怎么样
Dialogue: 1,0:14:07.33,0:14:09.22,JAP,,0,0,0,,ハウメア　どうだ？
Dialogue: 0,0:14:09.47,0:14:10.25,CHS,,0,0,0,,蒿梅雅
Dialogue: 1,0:14:09.47,0:14:10.25,JAP,,0,0,0,,ハウメア
Dialogue: 0,0:14:10.95,0:14:11.95,CHS,,0,0,0,,好了吗
Dialogue: 1,0:14:10.95,0:14:11.95,JAP,,0,0,0,,できてるのか？
Dialogue: 0,0:14:13.42,0:14:15.75,CHS,,0,0,0,,喂 蒿梅雅
Dialogue: 1,0:14:13.42,0:14:15.75,JAP,,0,0,0,,お〜い　ハウメア！
Dialogue: 0,0:14:16.97,0:14:17.75,CHS,,0,0,0,,蒿梅雅
Dialogue: 1,0:14:16.97,0:14:17.75,JAP,,0,0,0,,ハウメア？
Dialogue: 0,0:14:17.76,0:14:19.47,CHS,,0,0,0,,你好吵啊 卡隆
Dialogue: 1,0:14:17.76,0:14:19.47,JAP,,0,0,0,,うるせえな　カロン！
Dialogue: 0,0:14:19.47,0:14:20.51,CHS,,0,0,0,,我不是在干吗
Dialogue: 1,0:14:19.47,0:14:20.51,JAP,,0,0,0,,今やってんだろ！
Dialogue: 0,0:14:20.67,0:14:23.39,CHS,,0,0,0,,别妨碍我 吵死了 杀了你啊混蛋
Dialogue: 1,0:14:20.67,0:14:23.39,JAP,,0,0,0,,邪魔すんなら　うせろ　殺すぞ　てめえ！
Dialogue: 0,0:14:23.90,0:14:25.90,CHS,,0,0,0,,听到了就回一声啊
Dialogue: 1,0:14:23.90,0:14:25.90,JAP,,0,0,0,,聞こえてるなら返事しろ
Dialogue: 0,0:14:26.07,0:14:26.77,CHS,,0,0,0,,啊
Dialogue: 1,0:14:26.07,0:14:26.77,JAP,,0,0,0,,はあ？
Dialogue: 0,0:14:26.95,0:14:29.15,CHS,,0,0,0,,回你的话 你能帮我吗
Dialogue: 1,0:14:26.95,0:14:29.15,JAP,,0,0,0,,返事したら手伝ってくれんのか？
Dialogue: 0,0:14:29.15,0:14:30.40,CHS,,0,0,0,,不行吧
Dialogue: 1,0:14:29.15,0:14:30.40,JAP,,0,0,0,,できねえだろ！
Dialogue: 0,0:14:30.40,0:14:33.82,CHS,,0,0,0,,那就闭嘴 蠢样 快点被风吹走吧
Dialogue: 1,0:14:30.40,0:14:33.82,JAP,,0,0,0,,だったら黙ってアホ面　風になびかせてろ！
Dialogue: 0,0:14:34.07,0:14:37.35,CHS,,0,0,0,,啊 对不起 我错了
Dialogue: 1,0:14:34.07,0:14:37.35,JAP,,0,0,0,,ああ…悪かった　悪かったよ
Dialogue: 0,0:14:41.65,0:14:42.85,CHS,,0,0,0,,好可怕
Dialogue: 1,0:14:41.65,0:14:42.85,JAP,,0,0,0,,怖えな…
Dialogue: 0,0:14:46.96,0:14:49.88,CHS,,0,0,0,,这个情况 已经
Dialogue: 1,0:14:46.96,0:14:49.88,JAP,,0,0,0,,この状況…もう既に！
Dialogue: 0,0:14:59.13,0:15:00.27,CHS,,0,0,0,,鬼和婴儿
Dialogue: 1,0:14:59.13,0:15:00.27,JAP,,0,0,0,,鬼と赤子！
Dialogue: 0,0:15:04.22,0:15:07.35,CHS,,0,0,0,,带着婴儿过来吧
Dialogue: 1,0:15:04.22,0:15:07.35,JAP,,0,0,0,,赤さん連れて　こっちにおいで〜
Dialogue: 0,0:15:07.35,0:15:08.12,CHS,,0,0,0,,站住
Dialogue: 1,0:15:07.35,0:15:08.12,JAP,,0,0,0,,待て！
Dialogue: 0,0:15:09.90,0:15:12.15,CHS,,0,0,0,,班兹 这里要塌了 快撤退
Dialogue: 1,0:15:09.90,0:15:12.15,JAP,,0,0,0,,バーンズ　崩れるぞ！退避しろ！
Dialogue: 0,0:15:12.15,0:15:13.15,CHS,,0,0,0,,那个焰人
Dialogue: 1,0:15:12.15,0:15:13.15,JAP,,0,0,0,,焔ビトが！
Dialogue: 0,0:15:15.95,0:15:16.82,CHS,,0,0,0,,快点
Dialogue: 1,0:15:15.95,0:15:16.82,JAP,,0,0,0,,急げ！
Dialogue: 0,0:15:16.82,0:15:18.32,CHS,,0,0,0,,注意头顶
Dialogue: 1,0:15:16.82,0:15:18.32,JAP,,0,0,0,,頭上に注意しろ！
Dialogue: 0,0:15:27.55,0:15:28.25,CHS,,0,0,0,,咦
Dialogue: 1,0:15:27.55,0:15:28.25,JAP,,0,0,0,,ん？
Dialogue: 0,0:15:34.50,0:15:35.45,CHS,,0,0,0,,啊
Dialogue: 1,0:15:34.50,0:15:35.45,JAP,,0,0,0,,あ…
Dialogue: 0,0:15:39.87,0:15:42.80,CHS,,0,0,0,,鬼焰人 安德拉爆炎
Dialogue: 1,0:15:39.87,0:15:42.80,JAP,,0,0,0,,鬼の焔ビト　アドラバースト…
Dialogue: 0,0:15:43.40,0:15:44.47,CHS,,0,0,0,,安德拉连接
Dialogue: 1,0:15:43.40,0:15:44.47,JAP,,0,0,0,,アドラリンク
Dialogue: 0,0:15:45.67,0:15:47.32,CHS,,0,0,0,,右眼的火焰止不住躁动
Dialogue: 1,0:15:45.67,0:15:47.32,JAP,,0,0,0,,右目の炎が治まらない
Dialogue: 0,0:15:48.20,0:15:51.92,CHS,,0,0,0,,眼睛就跟过去看见异界的光后被烧伤一样
Dialogue: 1,0:15:48.20,0:15:51.92,JAP,,0,0,0,,かつて異界の光を見て　目を焼かれ失ったときのようだ
Dialogue: 0,0:15:52.50,0:15:54.30,CHS,,0,0,0,,妈妈 象
Dialogue: 1,0:15:52.50,0:15:54.30,JAP,,0,0,0,,お母さん！ショウ！
Dialogue: 0,0:15:54.30,0:15:56.52,CHS,,0,0,0,,危险 不能靠近那里
Dialogue: 1,0:15:54.30,0:15:56.52,JAP,,0,0,0,,危ない！近づいたらダメだ！
Dialogue: 0,0:15:56.67,0:15:58.67,CHS,,0,0,0,,那个少年不是目标吗
Dialogue: 1,0:15:56.67,0:15:58.67,JAP,,0,0,0,,あの少年は狙われなかったのか…
Dialogue: 0,0:15:59.32,0:16:00.82,CHS,,0,0,0,,虽然觉醒了能力
Dialogue: 1,0:15:59.32,0:16:00.82,JAP,,0,0,0,,能力に目覚めたか
Dialogue: 0,0:16:01.52,0:16:03.62,CHS,,0,0,0,,但是 这个火焰还太弱了
Dialogue: 1,0:16:01.52,0:16:03.62,JAP,,0,0,0,,だが…炎が　まだ弱い
Dialogue: 0,0:16:04.52,0:16:05.45,CHS,,0,0,0,,班兹
Dialogue: 1,0:16:04.52,0:16:05.45,JAP,,0,0,0,,バーンズ
Dialogue: 0,0:16:05.66,0:16:06.35,CHS,,0,0,0,,知道
Dialogue: 1,0:16:05.66,0:16:06.35,JAP,,0,0,0,,ああ…
Dialogue: 0,0:16:11.46,0:16:12.25,CHS,,0,0,0,,我要去
Dialogue: 1,0:16:11.46,0:16:12.25,JAP,,0,0,0,,俺が…
Dialogue: 0,0:16:12.25,0:16:13.37,CHS,,0,0,0,,好好听着
Dialogue: 1,0:16:12.25,0:16:13.37,JAP,,0,0,0,,よく聞くんだ
Dialogue: 0,0:16:15.47,0:16:17.37,CHS,,0,0,0,,你的妈妈已经死了
Dialogue: 1,0:16:15.47,0:16:17.37,JAP,,0,0,0,,君のお母さんは亡くなった
Dialogue: 0,0:16:20.17,0:16:21.67,CHS,,0,0,0,,弟弟也是
Dialogue: 1,0:16:20.17,0:16:21.67,JAP,,0,0,0,,そして弟もだ
Dialogue: 0,0:16:29.39,0:16:32.15,CHS,,0,0,0,,为什么您 说了谎
Dialogue: 1,0:16:29.39,0:16:32.15,JAP,,0,0,0,,なんで…ウソをついていたんですか？
Dialogue: 0,0:16:32.67,0:16:34.27,CHS,,0,0,0,,我不想你踏进这里
Dialogue: 1,0:16:32.67,0:16:34.27,JAP,,0,0,0,,踏み込ませないためだ
Dialogue: 0,0:16:35.05,0:16:38.37,CHS,,0,0,0,,可能哪个时候 你就会成为他们的目标
Dialogue: 1,0:16:35.05,0:16:38.37,JAP,,0,0,0,,お前も　いつかヤツらに狙われるかもしれなかった
Dialogue: 0,0:16:39.72,0:16:43.40,CHS,,0,0,0,,为了让你惧恨火焰 我说了谎
Dialogue: 1,0:16:39.72,0:16:43.40,JAP,,0,0,0,,お前が炎を恐れ嫌うように　ウソを吹き込んだ
Dialogue: 0,0:16:43.92,0:16:47.65,CHS,,0,0,0,,我认为畏惧火焰的话 你就不会去用起火能力
Dialogue: 1,0:16:43.92,0:16:47.65,JAP,,0,0,0,,炎を恐れれば　発火能力を使うことを避け
Dialogue: 0,0:16:47.90,0:16:50.80,CHS,,0,0,0,,不会进入到这个世界里了
Dialogue: 1,0:16:47.90,0:16:50.80,JAP,,0,0,0,,この世界に入ってはこないだろうと考えたからだ
Dialogue: 0,0:16:51.35,0:16:53.70,CHS,,0,0,0,,我很讨厌火 现在也讨厌
Dialogue: 1,0:16:51.35,0:16:53.70,JAP,,0,0,0,,嫌いですよ…今でも！
Dialogue: 0,0:16:54.12,0:16:55.45,CHS,,0,0,0,,不管真相如何
Dialogue: 1,0:16:54.12,0:16:55.45,JAP,,0,0,0,,真実がどうでも
Dialogue: 0,0:16:55.87,0:16:58.65,CHS,,0,0,0,,都是火焰从我们家夺走了一切
Dialogue: 1,0:16:55.87,0:16:58.65,JAP,,0,0,0,,炎が俺の家族から全てを奪っていった
Dialogue: 0,0:16:59.70,0:17:01.90,CHS,,0,0,0,,是火焰搅乱了一切
Dialogue: 1,0:16:59.70,0:17:01.90,JAP,,0,0,0,,炎が全てを狂わせたんです
Dialogue: 0,0:17:02.25,0:17:04.25,CHS,,0,0,0,,我怎么可能会喜欢上它
Dialogue: 1,0:17:02.25,0:17:04.25,JAP,,0,0,0,,好きになれるわけがない！
Dialogue: 0,0:17:05.12,0:17:08.80,CHS,,0,0,0,,但是 你还是借助它 走到了这里
Dialogue: 1,0:17:05.12,0:17:08.80,JAP,,0,0,0,,だが　お前はその炎を使いここまで来た
Dialogue: 0,0:17:13.56,0:17:16.07,CHS,,0,0,0,,我今天来这里就是为了说这些
Dialogue: 1,0:17:13.56,0:17:16.07,JAP,,0,0,0,,私が今日ここに来た訳は以上だ
Dialogue: 0,0:17:16.55,0:17:17.44,CHS,,0,0,0,,请等一下
Dialogue: 1,0:17:16.55,0:17:17.44,JAP,,0,0,0,,待ってください
Dialogue: 0,0:17:19.32,0:17:22.36,CHS,,0,0,0,,班兹大队长曾经 通过安德拉连接
Dialogue: 1,0:17:19.32,0:17:22.36,JAP,,0,0,0,,バーンズ大隊長は　アドラリンクをして
Dialogue: 0,0:17:22.57,0:17:24.12,CHS,,0,0,0,,看到过那片地狱吗
Dialogue: 1,0:17:22.57,0:17:24.12,JAP,,0,0,0,,あの地獄を見たんですか？
Dialogue: 0,0:17:24.62,0:17:25.12,CHS,,0,0,0,,是啊
Dialogue: 1,0:17:24.62,0:17:25.12,JAP,,0,0,0,,ああ…
Dialogue: 0,0:17:25.87,0:17:28.87,CHS,,0,0,0,,这个右眼就是直视地狱之火的代价
Dialogue: 1,0:17:25.87,0:17:28.87,JAP,,0,0,0,,この右目は地獄の炎を見た代償だ
Dialogue: 0,0:17:29.52,0:17:30.99,CHS,,0,0,0,,12年前的鬼
Dialogue: 1,0:17:29.52,0:17:30.99,JAP,,0,0,0,,12年前の鬼は
Dialogue: 0,0:17:31.62,0:17:34.15,CHS,,0,0,0,,是从眼睛里长出角的焰人吗
Dialogue: 1,0:17:31.62,0:17:34.15,JAP,,0,0,0,,目から角が生えた焔ビトだったんですか？
Dialogue: 0,0:17:34.90,0:17:35.67,CHS,,0,0,0,,没错
Dialogue: 1,0:17:34.90,0:17:35.67,JAP,,0,0,0,,そうだ
Dialogue: 0,0:17:36.47,0:17:38.96,CHS,,0,0,0,,那个鬼 是妈妈啊
Dialogue: 1,0:17:36.47,0:17:38.96,JAP,,0,0,0,,あの鬼は　母さんだったんじゃ…
Dialogue: 0,0:17:41.80,0:17:44.07,CHS,,0,0,0,,我妈妈去哪里了
Dialogue: 1,0:17:41.80,0:17:44.07,JAP,,0,0,0,,母さんは　どこへ行ったんですか？
Dialogue: 0,0:17:45.72,0:17:47.65,CHS,,0,0,0,,那之后没人见过她
Dialogue: 1,0:17:45.72,0:17:47.65,JAP,,0,0,0,,その後を見た者はいない
Dialogue: 0,0:17:53.22,0:17:58.02,CHS,,0,0,0,,进行安德拉连接的话 也许就能再次见到那个焰人
Dialogue: 1,0:17:53.22,0:17:58.02,JAP,,0,0,0,,アドラリンクをすれば　もう一度　あの焔ビトに会える
Dialogue: 0,0:17:59.27,0:18:00.77,CHS,,0,0,0,,再次见到妈妈
Dialogue: 1,0:17:59.27,0:18:00.77,JAP,,0,0,0,,母さんにもう一度！
Dialogue: 0,0:18:01.57,0:18:04.02,CHS,,0,0,0,,可是 要怎样才能再连接上
Dialogue: 1,0:18:01.57,0:18:04.02,JAP,,0,0,0,,でも　どうやってまたリンクすれば？
Dialogue: 0,0:18:05.82,0:18:08.47,CHS,,0,0,0,,那个人可能知道些什么
Dialogue: 1,0:18:05.82,0:18:08.47,JAP,,0,0,0,,あの人　何か知っているかもしれない
Dialogue: 0,0:18:09.55,0:18:12.99,CHS,,0,0,0,,日下部 请快点躺回床上
Dialogue: 1,0:18:09.55,0:18:12.99,JAP,,0,0,0,,日下部さん　早くベッドに戻ってください
Dialogue: 0,0:18:18.90,0:18:19.75,CHS,,0,0,0,,很像
Dialogue: 1,0:18:18.90,0:18:19.75,JAP,,0,0,0,,似てる！
Dialogue: 0,0:18:19.75,0:18:22.59,CHS,,0,0,0,,天啊 真的很像吗
Dialogue: 1,0:18:19.75,0:18:22.59,JAP,,0,0,0,,なんと〜！似てるんですか？
Dialogue: 0,0:18:22.95,0:18:25.15,CHS,,0,0,0,,那个 阿古中队长
Dialogue: 1,0:18:22.95,0:18:25.15,JAP,,0,0,0,,あの…アーグ中隊長
Dialogue: 0,0:18:25.47,0:18:26.09,CHS,,0,0,0,,我在
Dialogue: 1,0:18:25.47,0:18:26.09,JAP,,0,0,0,,はい？
Dialogue: 0,0:18:26.45,0:18:29.72,CHS,,0,0,0,,难道说阿古中队长是 第4队的
Dialogue: 1,0:18:26.45,0:18:29.72,JAP,,0,0,0,,アーグ中隊長って　もしかして　第４の？
Dialogue: 0,0:18:29.72,0:18:31.37,CHS,,0,0,0,,啊 是的
Dialogue: 1,0:18:29.72,0:18:31.37,JAP,,0,0,0,,ああ…はい
Dialogue: 0,0:18:31.81,0:18:36.60,CHS,,0,0,0,,第4队的苍一郎阿古大队长是我的祖父
Dialogue: 1,0:18:31.81,0:18:36.60,JAP,,0,0,0,,第４の蒼一郎アーグ大隊長は　私の祖父です
Dialogue: 0,0:18:36.87,0:18:38.45,CHS,,0,0,0,,咦 为什么
Dialogue: 1,0:18:36.87,0:18:38.45,JAP,,0,0,0,,えっ　なんで？
Dialogue: 0,0:18:39.02,0:18:40.62,CHS,,0,0,0,,果然很像吗
Dialogue: 1,0:18:39.02,0:18:40.62,JAP,,0,0,0,,やっぱり似てます？
Dialogue: 0,0:18:40.62,0:18:41.67,CHS,,0,0,0,,不 不是
Dialogue: 1,0:18:40.62,0:18:41.67,JAP,,0,0,0,,ああ　いえ！
Dialogue: 0,0:18:41.67,0:18:44.57,CHS,,0,0,0,,只是感觉 标志什么的很像而已
Dialogue: 1,0:18:41.67,0:18:44.57,JAP,,0,0,0,,なんか　記号的な所が似ているだけなんで
Dialogue: 0,0:18:44.57,0:18:45.47,CHS,,0,0,0,,没关系的
Dialogue: 1,0:18:44.57,0:18:45.47,JAP,,0,0,0,,大丈夫です
Dialogue: 0,0:18:45.47,0:18:46.49,CHS,,0,0,0,,没关系
Dialogue: 1,0:18:45.47,0:18:46.49,JAP,,0,0,0,,大丈夫？
Dialogue: 0,0:18:49.20,0:18:53.05,CHS,,0,0,0,,那个 我可以见一见阿古大队长吗
Dialogue: 1,0:18:49.20,0:18:53.05,JAP,,0,0,0,,あの…アーグ大隊長に会うことって　できますか？
Dialogue: 0,0:18:53.37,0:18:55.20,CHS,,0,0,0,,见大队长 吗
Dialogue: 1,0:18:53.37,0:18:55.20,JAP,,0,0,0,,大隊長に…ですか
Dialogue: 0,0:19:00.58,0:19:01.97,CHS,,0,0,0,,报告完毕
Dialogue: 1,0:19:00.58,0:19:01.97,JAP,,0,0,0,,報告は以上です
Dialogue: 0,0:19:03.72,0:19:08.67,CHS,,0,0,0,,安德拉连接和阿古大队长之间可能有某种联系
Dialogue: 1,0:19:03.72,0:19:08.67,JAP,,0,0,0,,アドラリンクとアーグ大隊長に何か関係があるかもしれないと…
Dialogue: 0,0:19:08.85,0:19:09.37,CHS,,0,0,0,,是的
Dialogue: 1,0:19:08.85,0:19:09.37,JAP,,0,0,0,,はい
Dialogue: 0,0:19:09.95,0:19:11.47,CHS,,0,0,0,,为了确认这点
Dialogue: 1,0:19:09.95,0:19:11.47,JAP,,0,0,0,,それを確認するために
Dialogue: 0,0:19:11.75,0:19:15.97,CHS,,0,0,0,,我拜托了他的亲人 第6队的亚沙子阿古中队长
Dialogue: 1,0:19:11.75,0:19:15.97,JAP,,0,0,0,,血縁者である　第６のアサコ･アーグ中隊長に　頼んでみました
Dialogue: 0,0:19:16.32,0:19:21.45,CHS,,0,0,0,,正好 我准备联系消防厅长官
Dialogue: 1,0:19:16.32,0:19:21.45,JAP,,0,0,0,,ちょうど　消防庁長官と連絡を取ろうと考えていたところだ
Dialogue: 0,0:19:22.22,0:19:25.02,CHS,,0,0,0,,我试试从这边接触他
Dialogue: 1,0:19:22.22,0:19:25.02,JAP,,0,0,0,,こちら側からも接触を試みてみよう
Dialogue: 0,0:19:25.42,0:19:26.02,CHS,,0,0,0,,但是
Dialogue: 1,0:19:25.42,0:19:26.02,JAP,,0,0,0,,しかし…
Dialogue: 0,0:19:26.80,0:19:30.30,CHS,,0,0,0,,如果班兹大队长说的是真的
Dialogue: 1,0:19:26.80,0:19:30.30,JAP,,0,0,0,,バーンズ大隊長の話が真実だとするなら
Dialogue: 0,0:19:30.82,0:19:35.27,CHS,,0,0,0,,传教者他们就和你家的那件事息息相关
Dialogue: 1,0:19:30.82,0:19:35.27,JAP,,0,0,0,,伝導者の一味がお前の家族の事件に関わっていたことになる
Dialogue: 0,0:19:35.77,0:19:39.83,CHS,,0,0,0,,我认为是敌人的鬼 其实是我的妈妈这件事
Dialogue: 1,0:19:35.77,0:19:39.83,JAP,,0,0,0,,俺が敵と思っていた鬼の正体が　母だというのは
Dialogue: 0,0:19:40.02,0:19:42.08,CHS,,0,0,0,,我不会完全相信的
Dialogue: 1,0:19:40.02,0:19:42.08,JAP,,0,0,0,,簡単には信じられないことですが
Dialogue: 0,0:19:42.50,0:19:45.85,CHS,,0,0,0,,毕竟我原以为象已经死去 但他现在也还活着
Dialogue: 1,0:19:42.50,0:19:45.85,JAP,,0,0,0,,死んだと思っていたショウが生きていたという事実もあります
Dialogue: 0,0:19:46.50,0:19:50.12,CHS,,0,0,0,,如果 森罗的妈妈变成了焰人
Dialogue: 1,0:19:46.50,0:19:50.12,JAP,,0,0,0,,もしも　シンラのお母さんが焔ビトとなっても
Dialogue: 0,0:19:50.12,0:19:52.25,CHS,,0,0,0,,现在还活着的话
Dialogue: 1,0:19:50.12,0:19:52.25,JAP,,0,0,0,,まだ生きているというのなら…
Dialogue: 0,0:19:53.70,0:19:57.65,CHS,,0,0,0,,我会找出把焰人变回人类的办法
Dialogue: 1,0:19:53.70,0:19:57.65,JAP,,0,0,0,,焔ビトを　元の人に戻す方法を見つけてみせます！
