Dialogue: 0,0:23:53.49,0:23:57.05,屏幕字背景,,0,0,0,,{\an1\c&H000000&\fs160\3c&HFFFFFF&\pos(10,652)}　第貳話{\fs30}\N　\N{\fs240}「消防官之心」
Dialogue: 0,0:00:32.22,0:00:34.50,CHS,,0,0,0,,下一站是田端 田端
Dialogue: 0,0:00:34.93,0:00:37.55,CHS,,0,0,0,,今日天照運轉率正常
Dialogue: 0,0:00:38.14,0:00:40.02,CHS,,0,0,0,,列車即將按時到達
Dialogue: 0,0:00:45.98,0:00:48.64,CHS2,,0,0,0,,在本站上車的各位乘客 下面播報一則通知
Dialogue: 0,0:00:48.19,0:00:50.57,CHS,,0,0,0,,這裡還有小孩子 請冷靜行動
Dialogue: 0,0:00:56.61,0:00:58.18,CHS,,0,0,0,,發大火了呀
Dialogue: 0,0:01:00.58,0:01:01.75,CHS,,0,0,0,,是焰人啊
Dialogue: 0,0:01:01.87,0:01:03.18,CHS,,0,0,0,,又是火災嗎
Dialogue: 0,0:01:02.75,0:01:06.75,CHS2,,0,0,0,,請按工作人員的指示 迅速離開站台
Dialogue: 0,0:01:25.55,0:01:26.86,CHS,,0,0,0,,你應該很痛吧
Dialogue: 0,0:01:30.11,0:01:31.53,CHS,,0,0,0,,我馬上讓你解脫
Dialogue: 0,0:01:31.65,0:01:33.49,CHS,,0,0,0,,特殊消防隊來了
Dialogue: 0,0:01:35.20,0:01:38.95,CHS,,0,0,0,,無關人員速速離開 這裡很危險
Dialogue: 0,0:01:39.87,0:01:41.04,CHS,,0,0,0,,你也是
Dialogue: 0,0:01:41.37,0:01:43.58,CHS,,0,0,0,,別待在這種地方 快點離開
Dialogue: 0,0:01:43.71,0:01:44.88,CHS,,0,0,0,,唉 你是
Dialogue: 0,0:01:45.00,0:01:47.00,CHS,,0,0,0,,中隊長 你在愣著幹嘛
Dialogue: 0,0:01:47.67,0:01:48.59,CHS,,0,0,0,,對不起
Dialogue: 0,0:01:51.34,0:01:55.15,CHS,,0,0,0,,8時10分 對焰人進行鎮魂
Dialogue: 0,0:01:55.80,0:01:56.61,CHS,,0,0,0,,明白
Dialogue: 0,0:01:57.43,0:02:00.18,CHS,,0,0,0,,修女 請開始禱告
Dialogue: 0,0:02:00.64,0:02:01.21,CHS,,0,0,0,,好的
Dialogue: 0,0:02:03.44,0:02:05.52,CHS,,0,0,0,,火焰乃靈魂之氣息
Dialogue: 0,0:02:05.52,0:02:07.55,CHS,,0,0,0,,特殊滅火彈 發射
Dialogue: 0,0:02:05.92,0:02:08.21,CHS2,,0,0,0,,黑煙乃靈魂之解脫
Dialogue: 0,0:02:13.21,0:02:15.38,CHS,,0,0,0,,核心摧毀衝擊錐 準備
Dialogue: 0,0:02:26.29,0:02:29.50,CHS,,0,0,0,,灰燼化為灰燼 其靈魂啊
Dialogue: 0,0:02:32.05,0:02:34.05,CHS,,0,0,0,,歸於熊熊烈焰之中吧
Dialogue: 0,0:02:40.01,0:02:40.84,CHS,,0,0,0,,拉托姆
Dialogue: 0,0:02:41.89,0:02:42.72,CHS,,0,0,0,,拉托姆
Dialogue: 0,0:02:44.44,0:02:47.40,CHS,,0,0,0,,好厲害 就是這個
Dialogue: 0,0:03:08.25,0:03:10.72,CHS,,0,0,0,,修女 哪裡受傷了嗎
Dialogue: 0,0:03:11.30,0:03:11.98,CHS,,0,0,0,,沒有
Dialogue: 0,0:03:11.98,0:03:13.09,CHS,,0,0,0,,修女
Dialogue: 0,0:03:15.10,0:03:16.05,CHS,,0,0,0,,你是
Dialogue: 0,0:03:16.34,0:03:18.72,CHS,,0,0,0,,是的 剛才沒來得及說
Dialogue: 0,0:03:20.51,0:03:26.54,CHS,,0,0,0,,我是今天開始 被分配到第8特殊消防隊的第三代消防官
Dialogue: 0,0:03:27.33,0:03:28.50,CHS,,0,0,0,,森羅日下部
Dialogue: 0,0:03:38.57,0:03:42.35,CHS,,0,0,0,,這就是傳說中的 惡魔的足跡嗎
Dialogue: 0,0:05:26.41,0:05:30.07,CHS,,0,0,0,,雖說是新設立的部隊 卻沒什麼新設備啊
Dialogue: 0,0:05:31.56,0:05:32.41,CHS,,0,0,0,,破破爛爛的
Dialogue: 0,0:05:33.60,0:05:35.31,CHS,,0,0,0,,森羅 進來
Dialogue: 0,0:05:35.65,0:05:36.30,CHS,,0,0,0,,是
Dialogue: 0,0:05:52.58,0:05:53.32,CHS,,0,0,0,,挺破對吧
Dialogue: 0,0:05:53.32,0:05:54.67,CHS,,0,0,0,,啊 沒有
Dialogue: 0,0:05:58.25,0:05:59.27,CHS,,0,0,0,,打擾了
Dialogue: 0,0:05:59.90,0:06:00.88,CHS,,0,0,0,,來了啊
Dialogue: 0,0:06:01.47,0:06:05.95,CHS,,0,0,0,,我是第8特殊消防隊大隊長 秋樽櫻備
Dialogue: 0,0:06:07.90,0:06:11.64,CHS,,0,0,0,,打招呼的這點時間 就別在那訓練了啊
Dialogue: 0,0:06:12.14,0:06:12.90,CHS,,0,0,0,,這樣啊
Dialogue: 0,0:06:13.85,0:06:18.01,CHS,,0,0,0,,武久火繩 破爛第8隊的中隊長
Dialogue: 0,0:06:21.78,0:06:23.47,CHS,,0,0,0,,然後 森羅
Dialogue: 0,0:06:24.47,0:06:28.30,CHS,,0,0,0,,簡歷上的照片 為什麼是笑著的
Dialogue: 0,0:06:28.32,0:06:30.33,CHS,,0,0,0,,是 不好意思
Dialogue: 0,0:06:30.66,0:06:35.07,CHS,,0,0,0,,我好像有個毛病 因為緊張而表情僵硬的時候就會笑
Dialogue: 0,0:06:35.38,0:06:35.90,CHS,,0,0,0,,什麼
Dialogue: 0,0:06:36.30,0:06:37.58,CHS,,0,0,0,,啊 不是
Dialogue: 0,0:06:38.75,0:06:41.58,CHS,,0,0,0,,一緊張就會笑 臉就會
Dialogue: 0,0:06:58.15,0:06:59.21,CHS,,0,0,0,,抱歉 抱歉
Dialogue: 0,0:06:59.69,0:07:02.19,CHS,,0,0,0,,你這傢伙挺可愛啊
Dialogue: 0,0:07:02.32,0:07:05.24,CHS,,0,0,0,,所以也經常會被誤解吧
Dialogue: 0,0:07:05.40,0:07:07.98,CHS,,0,0,0,,是的 並沒有瞧不起人的意思
Dialogue: 0,0:07:11.33,0:07:14.52,CHS,,0,0,0,,可愛 應該是覺得噁心吧
Dialogue: 0,0:07:15.25,0:07:16.92,CHS,,0,0,0,,所以呢 森羅
Dialogue: 0,0:07:17.70,0:07:20.52,CHS,,0,0,0,,你入隊的動機是什麼
Dialogue: 0,0:07:20.72,0:07:21.25,CHS,,0,0,0,,是
Dialogue: 0,0:07:22.71,0:07:25.38,CHS,,0,0,0,,我是為了成為英雄而來的
Dialogue: 0,0:07:27.75,0:07:31.75,CHS,,0,0,0,,想成為英雄的志向很好 但是消防官們是一個團隊
Dialogue: 0,0:07:32.27,0:07:35.04,CHS,,0,0,0,,一定要注意相互的協調性啊
Dialogue: 0,0:07:35.90,0:07:37.21,CHS,,0,0,0,,英雄啊
Dialogue: 0,0:07:38.44,0:07:42.49,CHS,,0,0,0,,你應該是因為小時候的某些事
Dialogue: 0,0:07:42.78,0:07:46.07,CHS,,0,0,0,,在訓練學校裡被稱為“惡魔”對吧
Dialogue: 0,0:07:47.04,0:07:52.72,CHS,,0,0,0,,難道不是因為評價太差 才想當消防官來提高分數嗎
Dialogue: 0,0:07:53.83,0:07:55.83,CHS,,0,0,0,,那就是英雄嗎
Dialogue: 0,0:08:01.13,0:08:02.17,CHS2,,0,0,0,,修女
Dialogue: 0,0:08:02.30,0:08:04.18,CHS2,,0,0,0,,什麼事 茉希
Dialogue: 0,0:08:05.05,0:08:07.89,CHS2,,0,0,0,,你剛才在車站 被新入隊員
Dialogue: 0,0:08:08.01,0:08:10.47,CHS2,,0,0,0,,公主抱了對吧
Dialogue: 0,0:08:11.02,0:08:12.07,CHS2,,0,0,0,,那個時候
Dialogue: 0,0:08:12.61,0:08:15.44,CHS,,0,0,0,,肯定有種命中注定的感覺吧
Dialogue: 0,0:08:15.72,0:08:16.27,CHS,,0,0,0,,唉
Dialogue: 0,0:08:20.90,0:08:23.87,CHS,,0,0,0,,茉希平時明明看起來很冷淡
Dialogue: 0,0:08:25.32,0:08:28.95,CHS,,0,0,0,,腦子裡卻還是少女心泛濫啊
Dialogue: 0,0:08:34.07,0:08:34.87,CHS,,0,0,0,,打擾了
Dialogue: 0,0:08:36.32,0:08:38.58,CHS,,0,0,0,,剛才真的是非常感謝
Dialogue: 0,0:08:39.71,0:08:41.32,CHS,,0,0,0,,沒 沒什麼
Dialogue: 0,0:08:44.59,0:08:46.55,CHS,,0,0,0,,英雄就應該這樣
Dialogue: 0,0:08:46.55,0:08:46.98,CHS,,0,0,0,,啊
Dialogue: 0,0:08:47.61,0:08:49.27,CHS,,0,0,0,,果然是命運啊
Dialogue: 0,0:08:53.60,0:08:55.58,CHS,,0,0,0,,可愛的愛麗絲大人作為修女
Dialogue: 0,0:08:55.58,0:08:58.18,CHS,,0,0,0,,可不能這麼暴力哦
Dialogue: 0,0:08:58.18,0:09:00.30,CHS,,0,0,0,,真好啊 好浪漫
Dialogue: 0,0:09:05.11,0:09:08.98,CHS,,0,0,0,,為了配合你的能力 把褲腳修短了
Dialogue: 0,0:09:09.33,0:09:11.41,CHS,,0,0,0,,尺寸合身嗎
Dialogue: 0,0:09:11.72,0:09:13.98,CHS,,0,0,0,,是的 謝謝
Dialogue: 0,0:09:16.87,0:09:18.63,CHS,,0,0,0,,感覺有種好聞的味道
Dialogue: 0,0:09:19.17,0:09:21.63,CHS,,0,0,0,,這就是濕濕的女孩身上的香氣嗎
Dialogue: 0,0:09:21.96,0:09:24.84,CHS,,0,0,0,,等等 我可沒在想那種事
Dialogue: 0,0:09:32.64,0:09:36.73,CHS,,0,0,0,,那個 櫻備大隊長 差不多該
Dialogue: 0,0:09:37.23,0:09:41.00,CHS,,0,0,0,,好的 大家都到了那就開始吧
Dialogue: 0,0:09:44.61,0:09:48.91,CHS,,0,0,0,,現在在這裡的諸位 有一件事 說不定也會發生在你們身上
Dialogue: 0,0:09:49.45,0:09:52.87,CHS,,0,0,0,,那就是讓居住在地球上的所有人類都感到恐怖的
Dialogue: 0,0:09:53.45,0:09:55.33,CHS,,0,0,0,,人體自燃現象
Dialogue: 0,0:09:59.12,0:10:04.00,CHS,,0,0,0,,某一天 世界上突然開始出現人體自燃的現象
Dialogue: 0,0:10:04.51,0:10:08.13,CHS,,0,0,0,,他們是第一代人體自燃的受害者
Dialogue: 0,0:10:08.55,0:10:13.22,CHS,,0,0,0,,他們失去了自我 狂暴至死
Dialogue: 0,0:10:13.93,0:10:15.97,CHS,,0,0,0,,被稱為焰人 令人恐懼
Dialogue: 0,0:10:17.14,0:10:22.23,CHS,,0,0,0,,如果不摧毀焰人心臟部分的核心 就無法讓他們停止活動
Dialogue: 0,0:10:22.65,0:10:24.57,CHS,,0,0,0,,也就是“鎮魂”
Dialogue: 0,0:10:25.78,0:10:27.90,CHS,,0,0,0,,我們特殊消防隊的任務
Dialogue: 0,0:10:28.15,0:10:32.70,CHS,,0,0,0,,就是對焰人鎮魂 然後解救人類和焰人的靈魂
Dialogue: 0,0:10:33.58,0:10:38.71,CHS,,0,0,0,,所以我們要儘快解開人體自燃之謎
Dialogue: 0,0:10:38.96,0:10:43.34,CHS,,0,0,0,,將人類從火焰的恐怖中救出
Dialogue: 0,0:10:43.59,0:10:45.21,CHS,,0,0,0,,是我們最重要的使命
Dialogue: 0,0:10:48.47,0:10:50.22,CHS,,0,0,0,,我要成為英雄
Dialogue: 0,0:10:50.97,0:10:53.92,CHS,,0,0,0,,不對 是我必須成為英雄
Dialogue: 0,0:11:04.94,0:11:06.01,CHS,,0,0,0,,媽媽
Dialogue: 0,0:11:07.82,0:11:11.67,CHS,,0,0,0,,媽媽 我要成為超級英雄
Dialogue: 0,0:11:11.90,0:11:13.90,CHS,,0,0,0,,這樣就能保護你和小象了
Dialogue: 0,0:11:14.18,0:11:15.67,CHS,,0,0,0,,好帥氣啊
Dialogue: 0,0:11:20.27,0:11:21.17,CHS,,0,0,0,,惡魔
Dialogue: 0,0:11:23.21,0:11:26.35,CHS,,0,0,0,,怎麼能收養這麼危險的小孩呢
Dialogue: 0,0:11:26.78,0:11:30.64,CHS,,0,0,0,,行了 老奶奶 在孫子面前別這樣
Dialogue: 0,0:11:30.81,0:11:32.01,CHS,,0,0,0,,什麼孫子
Dialogue: 0,0:11:33.58,0:11:36.24,CHS,,0,0,0,,這個孩子知道自己做了什麼嗎
Dialogue: 0,0:11:37.26,0:11:40.48,CHS,,0,0,0,,即使如此 即使如此
Dialogue: 0,0:11:41.14,0:11:43.50,CHS,,0,0,0,,你這是什麼表情啊
Dialogue: 0,0:11:48.61,0:11:52.53,CHS,,0,0,0,,守護 約定
Dialogue: 0,0:11:57.87,0:11:58.41,CHS,,0,0,0,,是警報
Dialogue: 0,0:11:58.84,0:11:59.50,CHS,,0,0,0,,森羅
Dialogue: 0,0:11:59.50,0:12:02.75,CHS,,0,0,0,,焰人出現了 30秒內做好準備
Dialogue: 0,0:12:02.98,0:12:03.50,CHS,,0,0,0,,是
Dialogue: 0,0:12:09.59,0:12:12.42,CHS,,0,0,0,,台東區烏越地區出現了焰人
Dialogue: 0,0:12:12.76,0:12:14.80,CHS,,0,0,0,,火災現場是鎮裡的工廠
Dialogue: 0,0:12:15.39,0:12:17.93,CHS,,0,0,0,,焰人化的是工廠廠長的夫人
Dialogue: 0,0:12:29.23,0:12:31.27,CHS,,0,0,0,,消防廳上野本部
Dialogue: 0,0:12:31.27,0:12:32.84,CHS,,0,0,0,,與第4分團協力
Dialogue: 0,0:12:33.03,0:12:35.27,CHS,,0,0,0,,將她進行鎮魂 鎮壓
Dialogue: 0,0:12:39.95,0:12:42.84,CHS,,0,0,0,,出發了 快點坐進火柴盒裡
Dialogue: 0,0:12:54.81,0:12:57.43,CHS,,0,0,0,,現在 有緊急車輛通過
Dialogue: 0,0:12:57.64,0:13:02.87,CHS,,0,0,0,,正在通行中的車輛請停止並清空道路
Dialogue: 0,0:13:05.35,0:13:08.52,CHS,,0,0,0,,第8特殊消防隊 出動
Dialogue: 0,0:13:17.30,0:13:19.35,CHS,,0,0,0,,這可是成為英雄的機會哦
Dialogue: 0,0:13:39.68,0:13:40.90,CHS,,0,0,0,,青線 到達
Dialogue: 0,0:13:43.90,0:13:47.70,CHS,,0,0,0,,這次的焰人 非常具有攻擊性啊
Dialogue: 0,0:13:48.21,0:13:50.65,CHS,,0,0,0,,雖然我們正在控制火勢蔓延
Dialogue: 0,0:13:50.90,0:13:53.55,CHS,,0,0,0,,但是不對焰人進行鎮魂的話 就無法
Dialogue: 0,0:13:53.55,0:13:54.58,CHS,,0,0,0,,修女
Dialogue: 0,0:13:56.38,0:13:59.91,CHS,,0,0,0,,請 請讓我的妻子安息吧
Dialogue: 0,0:14:00.18,0:14:03.74,CHS,,0,0,0,,焰人 是被捲入火焰的迷失之人
Dialogue: 0,0:14:04.67,0:14:07.95,CHS,,0,0,0,,以至高無上的太陽神的名義 將慈悲
Dialogue: 0,0:14:10.25,0:14:13.55,CHS,,0,0,0,,第8特殊消防隊 衝進去
Dialogue: 0,0:14:13.55,0:14:14.32,CHS,,0,0,0,,是
Dialogue: 0,0:14:18.90,0:14:20.21,CHS,,0,0,0,,好了 弄完了
Dialogue: 0,0:14:20.21,0:14:21.01,CHS,,0,0,0,,太好了
Dialogue: 0,0:14:21.30,0:14:23.24,CHS,,0,0,0,,這樣就能保護大家了
Dialogue: 0,0:14:27.18,0:14:28.77,CHS,,0,0,0,,媽媽 看啊
Dialogue: 0,0:14:29.10,0:14:30.32,CHS,,0,0,0,,像英雄一樣吧
Dialogue: 0,0:14:30.32,0:14:32.32,CHS,,0,0,0,,嗯 真帥氣呢
Dialogue: 0,0:14:41.37,0:14:42.70,CHS,,0,0,0,,在裡面
Dialogue: 0,0:14:42.91,0:14:47.35,CHS,,0,0,0,,簡直就是一堵拒絕我們進入的火牆啊
Dialogue: 0,0:14:47.62,0:14:51.46,CHS,,0,0,0,,對于夫人來說這裡是非常重要的地方吧
Dialogue: 0,0:14:58.90,0:15:00.55,CHS,,0,0,0,,媽媽 象
Dialogue: 0,0:15:08.67,0:15:10.48,CHS,,0,0,0,,森羅 還好嗎
Dialogue: 0,0:15:12.44,0:15:13.06,CHS,,0,0,0,,我
Dialogue: 0,0:15:14.15,0:15:16.32,CHS,,0,0,0,,不是要成為英雄嗎
Dialogue: 0,0:15:16.82,0:15:19.84,CHS,,0,0,0,,消防官可不會丟下伙伴逃走
Dialogue: 0,0:15:20.15,0:15:22.58,CHS,,0,0,0,,一個人慢了就會拖累大家
Dialogue: 0,0:15:23.32,0:15:26.24,CHS,,0,0,0,,我們身上纏繞著的藍色發光體
Dialogue: 0,0:15:26.45,0:15:30.54,CHS,,0,0,0,,就是在煙與火的世界裡 將同伴們緊緊相連的紐帶
Dialogue: 0,0:15:31.12,0:15:32.54,CHS,,0,0,0,,絕對不能被切斷
Dialogue: 0,0:15:33.38,0:15:36.27,CHS,,0,0,0,,懷有恐懼之心 便能夠冷靜的判斷
Dialogue: 0,0:15:36.70,0:15:40.05,CHS,,0,0,0,,但是 不能成為一個膽小鬼
Dialogue: 0,0:15:45.43,0:15:46.87,CHS,,0,0,0,,沒有問題
Dialogue: 0,0:15:49.30,0:15:50.04,CHS,,0,0,0,,茉希
Dialogue: 0,0:15:50.35,0:15:51.95,CHS,,0,0,0,,我來開路
Dialogue: 0,0:16:00.55,0:16:01.92,CHS,,0,0,0,,火焰被吸走了
Dialogue: 0,0:16:03.87,0:16:04.41,CHS,,0,0,0,,森羅
Dialogue: 0,0:16:06.70,0:16:07.52,CHS,,0,0,0,,森羅
Dialogue: 0,0:16:13.87,0:16:14.78,CHS,,0,0,0,,森羅
Dialogue: 0,0:16:17.27,0:16:19.84,CHS,,0,0,0,,森羅 快逃
Dialogue: 0,0:16:20.61,0:16:21.55,CHS,,0,0,0,,快點
Dialogue: 0,0:16:24.38,0:16:25.24,CHS,,0,0,0,,媽媽
Dialogue: 0,0:16:28.10,0:16:31.64,CHS,,0,0,0,,起火的原因 好像是兒子森羅
Dialogue: 0,0:16:32.35,0:16:36.35,CHS,,0,0,0,,弟弟小象 燒的骨頭都不剩了
Dialogue: 0,0:16:37.07,0:16:41.24,CHS,,0,0,0,,是叫第三代嗎 突然噴火了對吧
Dialogue: 0,0:16:41.47,0:16:42.84,CHS,,0,0,0,,好可怕呢
Dialogue: 0,0:16:46.03,0:16:47.81,CHS,,0,0,0,,怎麼可能逃跑呢
Dialogue: 0,0:16:48.70,0:16:50.15,CHS,,0,0,0,,不是我啊
Dialogue: 0,0:16:52.15,0:16:56.38,CHS,,0,0,0,,那場火災發生時 有什麼東西 在那裡
Dialogue: 0,0:16:58.64,0:17:02.24,CHS,,0,0,0,,除了媽媽 象和我之外的某個東西
Dialogue: 0,0:17:05.63,0:17:07.30,CHS,,0,0,0,,我要把那個混蛋的真身
Dialogue: 0,0:17:08.22,0:17:10.50,CHS,,0,0,0,,那張扭曲變形的笑臉
Dialogue: 0,0:17:11.14,0:17:12.50,CHS,,0,0,0,,好噁心
Dialogue: 0,0:17:12.50,0:17:13.27,CHS,,0,0,0,,惡魔
Dialogue: 0,0:17:15.85,0:17:19.32,CHS,,0,0,0,,從那天開始 我就不能正常微笑了
Dialogue: 0,0:17:20.90,0:17:22.03,CHS,,0,0,0,,惡魔
Dialogue: 0,0:17:22.15,0:17:24.92,CHS,,0,0,0,,喂 惡魔 站起來
Dialogue: 0,0:17:25.45,0:17:26.41,CHS,,0,0,0,,惡魔
Dialogue: 0,0:17:28.45,0:17:30.64,CHS,,0,0,0,,藍色的 光
Dialogue: 0,0:17:34.16,0:17:37.01,CHS,,0,0,0,,虧你還有惡魔這種嚇人的綽號
Dialogue: 0,0:17:37.17,0:17:39.52,CHS,,0,0,0,,原來你就是隻軟腳蝦嗎
Dialogue: 0,0:17:40.30,0:17:41.64,CHS,,0,0,0,,我失去意識了
Dialogue: 0,0:17:42.84,0:17:43.58,CHS,,0,0,0,,幾分鐘
Dialogue: 0,0:17:43.87,0:17:45.98,CHS,,0,0,0,,什麼 大概5秒吧
Dialogue: 0,0:17:46.84,0:17:49.84,CHS,,0,0,0,,沒事吧 能站著就自己站起來
Dialogue: 0,0:17:50.05,0:17:51.81,CHS,,0,0,0,,沒事吧 森羅
Dialogue: 0,0:17:51.81,0:17:52.55,CHS,,0,0,0,,嗯
Dialogue: 0,0:17:59.12,0:18:00.87,CHS,,0,0,0,,全員 戰鬥準備
Dialogue: 0,0:18:08.07,0:18:12.67,CHS,,0,0,0,,21時10分 對焰人 廠長夫人進行鎮魂
Dialogue: 0,0:18:12.81,0:18:13.50,CHS,,0,0,0,,明白
Dialogue: 0,0:18:15.92,0:18:18.75,CHS,,0,0,0,,森羅 我和茉希來吸引她的注意力
Dialogue: 0,0:18:18.95,0:18:21.00,CHS,,0,0,0,,你來給她致命一腳
Dialogue: 0,0:18:21.41,0:18:22.10,CHS,,0,0,0,,好的
Dialogue: 0,0:18:24.52,0:18:25.58,CHS,,0,0,0,,行動開始
Dialogue: 0,0:18:45.78,0:18:47.86,CHS,,0,0,0,,好燙
Dialogue: 0,0:18:54.72,0:18:57.15,CHS,,0,0,0,,二式消防斧改刺突
Dialogue: 0,0:19:12.90,0:19:14.38,CHS,,0,0,0,,成為英雄
Dialogue: 0,0:19:14.80,0:19:18.50,CHS,,0,0,0,,應該就能守護媽媽和象了
Dialogue: 0,0:19:22.60,0:19:26.35,CHS,,0,0,0,,媽媽 象 對不起
Dialogue: 0,0:19:27.27,0:19:28.99,CHS,,0,0,0,,我沒有遵守約定
Dialogue: 0,0:19:29.82,0:19:33.21,CHS,,0,0,0,,但是 我要遵守另一個約定
Dialogue: 0,0:19:45.27,0:19:48.21,CHS,,0,0,0,,媽媽 我要上了
Dialogue: 0,0:19:53.81,0:19:55.58,CHS,,0,0,0,,我才不是什麼惡魔
Dialogue: 0,0:19:56.18,0:19:58.98,CHS,,0,0,0,,我 一定要成為英雄
Dialogue: 0,0:20:00.47,0:20:03.10,CHS,,0,0,0,,好的 去吧
Dialogue: 0,0:20:04.58,0:20:05.67,CHS,,0,0,0,,我上了
Dialogue: 0,0:20:14.32,0:20:16.32,CHS,,0,0,0,,修女 禱告
Dialogue: 0,0:20:16.44,0:20:17.10,CHS,,0,0,0,,是
Dialogue: 0,0:20:18.01,0:20:18.83,CHS,,0,0,0,,大隊長
Dialogue: 0,0:20:18.98,0:20:21.12,CHS,,0,0,0,,森羅 對準核心
Dialogue: 0,0:20:31.59,0:20:33.10,CHS,,0,0,0,,你是個惡魔
Dialogue: 0,0:20:36.39,0:20:38.47,CHS,,0,0,0,,火焰乃靈魂之氣息
Dialogue: 0,0:20:38.93,0:20:41.73,CHS,,0,0,0,,噁心 扭曲的笑臉
Dialogue: 0,0:20:44.89,0:20:47.31,CHS,,0,0,0,,黑煙乃靈魂之解脫
Dialogue: 0,0:20:48.36,0:20:51.64,CHS,,0,0,0,,灰燼化為灰燼 其靈魂啊
Dialogue: 0,0:20:55.49,0:20:56.57,CHS,,0,0,0,,靈魂啊
Dialogue: 0,0:21:00.45,0:21:03.08,CHS,,0,0,0,,燃燒吧
Dialogue: 0,0:21:09.72,0:21:13.59,CHS,,0,0,0,,真厲害 這就是第三代的火力
Dialogue: 0,0:21:14.55,0:21:16.38,CHS,,0,0,0,,歸於熊熊烈焰之中吧
Dialogue: 0,0:21:20.35,0:21:21.18,CHS,,0,0,0,,拉托姆
Dialogue: 0,0:21:30.52,0:21:33.21,CHS,,0,0,0,,修女 我 妻子呢
Dialogue: 0,0:21:33.78,0:21:37.41,CHS,,0,0,0,,夫人被安詳地送入熊熊烈焰之中了
Dialogue: 0,0:21:38.24,0:21:40.98,CHS,,0,0,0,,是森羅隊員對她進行了無痛苦的鎮魂
Dialogue: 0,0:21:49.00,0:21:50.92,CHS,,0,0,0,,謝謝你 森羅隊員
Dialogue: 0,0:21:52.30,0:21:53.41,CHS,,0,0,0,,謝謝
Dialogue: 0,0:21:57.84,0:21:59.18,CHS,,0,0,0,,大家辛苦了
Dialogue: 0,0:21:59.18,0:22:01.67,CHS,,0,0,0,,消防官們 謝謝你們
Dialogue: 0,0:22:02.22,0:22:03.60,CHS,,0,0,0,,以後你們還會
Dialogue: 0,0:22:03.72,0:22:06.68,CHS,,0,0,0,,經常收到這樣的喝彩
Dialogue: 0,0:22:07.39,0:22:08.48,CHS,,0,0,0,,很帥氣哦
Dialogue: 0,0:22:11.67,0:22:15.10,CHS,,0,0,0,,這不是向成為英雄踏出第一步了嘛
Dialogue: 0,0:00:00.00,0:00:00.00,JAP,,0,0,0,,
