Dialogue: 0,0:23:38.48,0:23:42.05,屏幕字背景,,0,0,0,,{\an1\c&H000000&\fs160\3c&HFFFFFF&\pos(110,652)}第貳拾壹話{\fs30}　　\N　\N{\fs240}｢相連的人｣
Dialogue: 0,0:20:22.11,0:20:25.62,@屏幕字,,0,0,0,,{\bord2\fs60\pos(1536,10)}※灰焰騎士團
Dialogue: 0,0:20:22.11,0:20:25.62,@屏幕字,,0,0,0,,{\bord2\fs60\pos(326,10)}※次席騎士
Dialogue: 0,0:20:22.11,0:20:25.62,屏幕字,,0,0,0,,{\bord2\pos(110,832)}※菲拉
Dialogue: 0,0:00:10.00,0:00:17.22,CHS,,0,0,0,,拉夫魯斯和他的使徒們利用太陽神賜予的火焰和人類發展的科技
Dialogue: 0,0:00:17.40,0:00:19.42,CHS,,0,0,0,,製造出了天照
Dialogue: 0,0:00:20.47,0:00:24.87,CHS,,0,0,0,,天照的聖火滋養了人類的生命
Dialogue: 0,0:00:25.25,0:00:29.37,CHS,,0,0,0,,為他們在極東之地建立國家奠定了基礎
Dialogue: 0,0:00:50.17,0:00:52.02,CHS,,0,0,0,,地鐵的車站嗎
Dialogue: 0,0:01:04.93,0:01:07.07,CHS,,0,0,0,,防火外套瞬間就被熔化了
Dialogue: 0,0:01:07.57,0:01:08.87,CHS,,0,0,0,,火力真強啊
Dialogue: 0,0:01:10.65,0:01:11.62,CHS,,0,0,0,,在哪裡
Dialogue: 0,0:01:12.57,0:01:14.05,CHS,,0,0,0,,聲音也聽不見
Dialogue: 0,0:01:15.57,0:01:16.94,CHS,,0,0,0,,在黑暗裡
Dialogue: 0,0:01:20.17,0:01:26.82,CHS,,0,0,0,,持有毀滅人類的火焰 安德拉爆炎的男人不該在你們那裡
Dialogue: 0,0:01:27.75,0:01:29.92,CHS,,0,0,0,,省得我們再去找了
Dialogue: 0,0:01:30.29,0:01:32.07,CHS,,0,0,0,,交出安德拉爆炎
Dialogue: 0,0:01:33.80,0:01:35.62,CHS,,0,0,0,,你們想把森羅怎麼樣
Dialogue: 0,0:01:36.07,0:01:37.84,CHS,,0,0,0,,你們的目的是什麼
Dialogue: 0,0:01:42.72,0:01:43.60,CHS,,0,0,0,,死吧
Dialogue: 0,0:03:20.90,0:03:22.40,CHS,,0,0,0,,利希特搜查官
Dialogue: 0,0:03:23.57,0:03:25.52,CHS,,0,0,0,,完全被孤立了
Dialogue: 0,0:03:25.70,0:03:28.02,CHS,,0,0,0,,敵人什麼時候出現都有可能
Dialogue: 0,0:03:28.97,0:03:30.79,CHS,,0,0,0,,我是不會掉以輕心的
Dialogue: 0,0:03:32.54,0:03:33.55,CHS,,0,0,0,,停下
Dialogue: 0,0:03:34.85,0:03:35.95,CHS,,0,0,0,,利希特搜查官
Dialogue: 0,0:03:36.46,0:03:38.00,CHS,,0,0,0,,站在那別動
Dialogue: 0,0:03:39.42,0:03:40.85,CHS,,0,0,0,,救命啊 森羅
Dialogue: 0,0:03:41.45,0:03:43.55,CHS,,0,0,0,,安德拉爆炎的持有者
Dialogue: 0,0:03:43.85,0:03:47.50,CHS,,0,0,0,,你如果還想要他的命 就跟我們走
Comment: 0,0:03:47.95,0:03:49.80,CHS,,0,0,0,,森羅 (飛流,Rapid)
Dialogue: 0,0:03:47.95,0:03:49.80,CHS,,0,0,0,,森羅 飛流
Dialogue: 0,0:03:47.95,0:03:49.80,CHS,,0,0,0,,{\fs48\pos(1029,1002)}Rapid
Dialogue: 0,0:03:49.80,0:03:50.37,CHS,,0,0,0,,什麼
Dialogue: 0,0:03:50.67,0:03:52.50,CHS,,0,0,0,,就那個 虎爪遊戲那個
Dialogue: 0,0:03:52.50,0:03:53.60,CHS,,0,0,0,,你安靜點
Dialogue: 0,0:04:01.85,0:04:03.86,CHS,,0,0,0,,真是卓越的速度
Comment: 0,0:04:04.00,0:04:05.40,CHS,,0,0,0,,(飛流,Rapid)嗎
Dialogue: 0,0:04:04.00,0:04:05.40,CHS,,0,0,0,,飛流嗎
Dialogue: 0,0:04:04.00,0:04:05.40,CHS,,0,0,0,,{\fs48\pos(930,1002)}Rapid
Dialogue: 0,0:04:05.72,0:04:08.05,CHS,,0,0,0,,這名字比踢俠踢擊要棒
Comment: 0,0:04:10.00,0:04:12.65,CHS,,0,0,0,,長見識了吧 (飛流俠踢擊,Rapid Man Kick)
Dialogue: 0,0:04:10.00,0:04:12.65,CHS,,0,0,0,,長見識了吧 飛流俠踢擊
Dialogue: 0,0:04:10.00,0:04:12.65,CHS,,0,0,0,,{\fs48\pos(1120,1002)}Rapid Man Kick
Comment: 0,0:04:12.87,0:04:15.15,CHS,,0,0,0,,只要(飛流,Rapid)就好了吧
Dialogue: 0,0:04:12.87,0:04:15.15,CHS,,0,0,0,,只要飛流就好了吧
Dialogue: 0,0:04:12.87,0:04:15.15,CHS,,0,0,0,,{\fs48\pos(900,1002)}Rapid
Dialogue: 0,0:04:15.54,0:04:18.22,CHS,,0,0,0,,那名字又會被新門大隊長駁回的
Comment: 0,0:04:18.37,0:04:20.57,CHS,,0,0,0,,不 一定要加(俠,Man)
Dialogue: 0,0:04:18.37,0:04:20.57,CHS,,0,0,0,,不 一定要加俠
Dialogue: 0,0:04:18.37,0:04:20.57,CHS,,0,0,0,,{\fs48\pos(1120,1002)}Man
Comment: 0,0:04:21.32,0:04:22.92,CHS,,0,0,0,,因為(森羅萬象,Shinramansho)
Dialogue: 0,0:04:21.32,0:04:22.92,CHS,,0,0,0,,因為森羅萬象
Dialogue: 0,0:04:21.32,0:04:22.92,CHS,,0,0,0,,{\fs48\pos(1020,1002)}Shinramansho
Dialogue: 0,0:04:23.46,0:04:26.62,CHS,,0,0,0,,萬是連接我和弟弟的字
Comment: 0,0:04:27.30,0:04:28.07,CHS,,0,0,0,,(我,Shinnra)
Dialogue: 0,0:04:27.30,0:04:28.07,CHS,,0,0,0,,我
Dialogue: 0,0:04:27.30,0:04:28.07,CHS,,0,0,0,,{\fs48\pos(960,1002)}Shinnra
Comment: 0,0:04:28.67,0:04:30.02,CHS,,0,0,0,,(弟弟,Shou)
Dialogue: 0,0:04:28.67,0:04:30.02,CHS,,0,0,0,,弟弟
Dialogue: 0,0:04:28.67,0:04:30.02,CHS,,0,0,0,,{\fs48\pos(960,1002)}Shou
Comment: 0,0:04:30.77,0:04:31.57,CHS,,0,0,0,,(萬,Mann)
Dialogue: 0,0:04:30.77,0:04:31.57,CHS,,0,0,0,,萬
Dialogue: 0,0:04:30.77,0:04:31.57,CHS,,0,0,0,,{\fs48\pos(960,1002)}Mann
Dialogue: 0,0:04:31.70,0:04:33.65,CHS,,0,0,0,,也就是
Comment: 0,0:04:33.92,0:04:37.32,CHS,,0,0,0,,(森羅萬象,Shinnra Bann Shou)
Dialogue: 0,0:04:33.92,0:04:37.32,CHS,,0,0,0,,森羅萬象
Dialogue: 0,0:04:33.92,0:04:37.32,CHS,,0,0,0,,{\fs48\pos(960,1002)}Shinnra Bann Shou
Dialogue: 0,0:04:37.70,0:04:39.75,CHS,,0,0,0,,所以我是會用Man的男人
Dialogue: 0,0:04:39.90,0:04:40.77,CHS,,0,0,0,,原來如此
Dialogue: 0,0:04:40.95,0:04:44.25,CHS,,0,0,0,,這樣的話 那個嚴厲的新門大隊長也會同意的吧
Dialogue: 0,0:04:47.55,0:04:48.12,CHS,,0,0,0,,那是
Dialogue: 0,0:04:48.52,0:04:50.10,CHS,,0,0,0,,是火繩中隊長嗎
Dialogue: 0,0:04:50.55,0:04:53.85,CHS,,0,0,0,,其他人也在和白衣人戰鬥吧
Dialogue: 0,0:04:54.65,0:04:57.00,CHS,,0,0,0,,我們也不能落後
Dialogue: 0,0:05:09.09,0:05:11.39,CHS,,0,0,0,,這個位置好像暴露了
Dialogue: 0,0:05:15.56,0:05:17.20,CHS,,0,0,0,,對手在黑暗裡
Dialogue: 0,0:05:17.67,0:05:20.95,CHS,,0,0,0,,放出的光太強烈了 沒辦法鎖定位置
Dialogue: 0,0:05:21.85,0:05:24.73,CHS,,0,0,0,,剛才試著控制跳彈擴大了射擊範圍
Dialogue: 0,0:05:24.92,0:05:26.30,CHS,,0,0,0,,但好像都沒有射中
Dialogue: 0,0:05:27.17,0:05:29.00,CHS,,0,0,0,,周圍有很多障礙物
Dialogue: 0,0:05:29.45,0:05:31.52,CHS,,0,0,0,,要嘗試採取近戰嗎
Dialogue: 0,0:05:35.80,0:05:38.05,CHS,,0,0,0,,不管怎樣 位置已經暴露了
Dialogue: 0,0:05:38.62,0:05:39.58,CHS,,0,0,0,,現在要先移動
Dialogue: 0,0:05:41.80,0:05:45.17,CHS,,0,0,0,,不要停下來 從這裡過去接近敵人
Dialogue: 0,0:05:47.47,0:05:50.02,CHS,,0,0,0,,我們也看著情況支援吧
Dialogue: 0,0:05:50.22,0:05:54.32,CHS,,0,0,0,,她可是亞羅哦 我們沒有出場的機會吧
Dialogue: 0,0:05:54.90,0:05:56.97,CHS,,0,0,0,,我能控制子彈彈跳
Dialogue: 0,0:05:57.35,0:05:59.45,CHS,,0,0,0,,同樣是使用遠距離武器
Dialogue: 0,0:05:59.60,0:06:01.92,CHS,,0,0,0,,近戰的話 我應該會有勝算
Dialogue: 0,0:06:02.62,0:06:05.92,CHS,,0,0,0,,你覺得那裡能夠躲過我的箭嗎
Dialogue: 0,0:06:07.65,0:06:08.57,CHS,,0,0,0,,恰恰相反
Dialogue: 0,0:06:08.75,0:06:10.92,CHS,,0,0,0,,你已經無處可躲了
Comment: 0,0:06:11.42,0:06:12.37,CHS,,0,0,0,,(破,Break)
Dialogue: 0,0:06:11.42,0:06:12.37,CHS,,0,0,0,,破
Dialogue: 0,0:06:11.42,0:06:12.37,CHS,,0,0,0,,{\fs48\pos(960,1002)}Break
Dialogue: 0,0:06:14.40,0:06:15.02,CHS,,0,0,0,,該死
Dialogue: 0,0:06:29.77,0:06:31.67,CHS,,0,0,0,,這裡是你的狩獵場嗎
Dialogue: 0,0:06:32.01,0:06:34.70,CHS,,0,0,0,,我不會放過盯上的獵物
Dialogue: 0,0:06:35.20,0:06:37.32,CHS,,0,0,0,,那個安德拉爆炎我也收下了
Dialogue: 0,0:06:41.20,0:06:45.22,CHS,,0,0,0,,你們這種人根本不理解生命的重量
Dialogue: 0,0:06:45.67,0:06:47.27,CHS,,0,0,0,,我不會把森羅交給你們
Dialogue: 0,0:06:47.87,0:06:50.50,CHS,,0,0,0,,世事萬變
Dialogue: 0,0:06:50.86,0:06:53.57,CHS,,0,0,0,,世界現在也在發生巨大的變化
Dialogue: 0,0:06:54.15,0:06:58.00,CHS,,0,0,0,,人類不需要對這些遷移注入感情
Dialogue: 0,0:06:58.67,0:07:01.67,CHS,,0,0,0,,那些訴說存在意義或主張的人
Dialogue: 0,0:07:01.92,0:07:04.40,CHS,,0,0,0,,都是無法遵守世間規則的愚者
Dialogue: 0,0:07:05.10,0:07:08.79,CHS,,0,0,0,,森羅日下部在想什麼 想幹什麼
Dialogue: 0,0:07:09.46,0:07:11.07,CHS,,0,0,0,,一點意義都沒有
Dialogue: 0,0:07:11.92,0:07:15.10,CHS,,0,0,0,,傳教者必須得到安德拉爆炎
Dialogue: 0,0:07:15.84,0:07:17.20,CHS,,0,0,0,,把他交出來
Dialogue: 0,0:07:18.10,0:07:20.40,CHS,,0,0,0,,一旦某人加入一個組織
Dialogue: 0,0:07:20.72,0:07:23.72,CHS,,0,0,0,,個人情感就永遠是次要的
Dialogue: 0,0:07:24.40,0:07:28.22,CHS,,0,0,0,,而如果上升到國家甚至世界 那就更理所當然了
Dialogue: 0,0:07:29.15,0:07:33.15,CHS,,0,0,0,,在人類突然自燃 突然離世的世界裡
Dialogue: 0,0:07:34.17,0:07:38.15,CHS,,0,0,0,,與其在混亂中迷惘徘徊 自我停滯
Dialogue: 0,0:07:38.77,0:07:40.55,CHS,,0,0,0,,不如割捨情感
Dialogue: 0,0:07:40.95,0:07:44.27,CHS,,0,0,0,,盡到身為社會齒輪之一的義務
Dialogue: 0,0:07:44.55,0:07:45.62,CHS,,0,0,0,,也算給世界做貢獻了
Dialogue: 0,0:07:46.45,0:07:49.96,CHS,,0,0,0,,包括我在內 會這麼想的人不在少數
Dialogue: 0,0:07:50.97,0:07:53.17,CHS,,0,0,0,,因為那樣會更輕鬆
Dialogue: 0,0:07:53.35,0:07:55.60,CHS,,0,0,0,,懷抱著感情生活太累了
Dialogue: 0,0:07:56.93,0:07:58.85,CHS,,0,0,0,,那你為什麼要反抗
Dialogue: 0,0:08:02.27,0:08:05.15,CHS,,0,0,0,,你說森羅的感情無所謂
Dialogue: 0,0:08:06.19,0:08:07.75,CHS,,0,0,0,,讓我交出部下
Dialogue: 0,0:08:08.48,0:08:09.60,CHS,,0,0,0,,你在瞧不起誰
Dialogue: 0,0:08:10.27,0:08:13.00,CHS,,0,0,0,,的確 感情豐富會很痛苦
Dialogue: 0,0:08:15.37,0:08:17.77,CHS,,0,0,0,,不過我現在得燃起來啊
Dialogue: 0,0:08:26.50,0:08:28.27,CHS,,0,0,0,,太漂亮了
Dialogue: 0,0:08:31.17,0:08:35.65,CHS,,0,0,0,,漂亮的轟鳴 漂亮的衝擊波
Dialogue: 0,0:08:36.17,0:08:38.82,CHS,,0,0,0,,那個男人到底在射什麼
Dialogue: 0,0:08:45.32,0:08:48.65,CHS,,0,0,0,,發射普通的7.62mm×51mm的子彈
Dialogue: 0,0:08:49.17,0:08:51.37,CHS,,0,0,0,,把子彈速度提升到極限
Dialogue: 0,0:08:52.52,0:08:54.22,CHS,,0,0,0,,就算沒有直接命中
Dialogue: 0,0:08:54.40,0:08:58.02,CHS,,0,0,0,,超高速帶來的音爆 也足以詐得人死無全屍
Dialogue: 0,0:08:59.62,0:09:03.17,CHS,,0,0,0,,這種只發射一次就會破壞槍筒的威力
Dialogue: 0,0:09:03.77,0:09:05.45,CHS,,0,0,0,,就跟大炮差不多啊
Dialogue: 0,0:09:05.83,0:09:07.45,CHS,,0,0,0,,亞羅沒事吧
Dialogue: 0,0:09:17.47,0:09:20.30,CHS,,0,0,0,,雖然是想找時機支援
Dialogue: 0,0:09:20.77,0:09:24.20,CHS,,0,0,0,,但這就算是開輛坦克也衝不進去吧
Dialogue: 0,0:09:31.20,0:09:34.80,CHS,,0,0,0,,全身無力 視線也
Dialogue: 0,0:09:35.86,0:09:38.30,CHS,,0,0,0,,感覺眼皮都黏在眼球上了
Dialogue: 0,0:09:39.78,0:09:42.52,CHS,,0,0,0,,意識正在脫離軀體
Dialogue: 0,0:09:44.32,0:09:46.55,CHS,,0,0,0,,地下又黑 灰塵又多
Dialogue: 0,0:09:47.08,0:09:51.22,CHS,,0,0,0,,只有硝煙的味道特別明顯啊
Dialogue: 0,0:09:53.32,0:09:57.42,CHS,,0,0,0,,對面的射擊手 情況如何
Dialogue: 0,0:10:02.10,0:10:06.47,CHS,,0,0,0,,在人類突然自燃 突然離世的世界裡
Dialogue: 0,0:10:08.35,0:10:10.82,CHS,,0,0,0,,不關心自己的性命
Dialogue: 0,0:10:11.40,0:10:13.67,CHS,,0,0,0,,也是為世界獻身的方式啊
Dialogue: 0,0:10:15.98,0:10:17.67,CHS,,0,0,0,,我死了之後
Dialogue: 0,0:10:31.27,0:10:35.20,CHS,,0,0,0,,真是的 第8隊明明沒有中隊
Dialogue: 0,0:10:35.52,0:10:37.50,CHS,,0,0,0,,還要我當中隊長
Dialogue: 0,0:10:38.60,0:10:41.35,CHS,,0,0,0,,櫻備大隊長一個人的話 放不下心啊
Dialogue: 0,0:10:42.60,0:10:43.95,CHS,,0,0,0,,我死了之後
Dialogue: 0,0:10:44.26,0:10:46.62,CHS,,0,0,0,,誰來照顧隊裡的部下
Dialogue: 0,0:10:50.89,0:10:53.20,CHS,,0,0,0,,我沒被徹底解決
Dialogue: 0,0:10:53.55,0:10:58.62,CHS,,0,0,0,,是因為第一擊沒有擊中有第8隊隊標的左肩
Dialogue: 0,0:11:01.82,0:11:03.65,CHS,,0,0,0,,利用對手的火焰
Dialogue: 0,0:11:04.78,0:11:06.27,CHS,,0,0,0,,讓速度更快
Dialogue: 0,0:11:27.64,0:11:29.42,CHS,,0,0,0,,消耗太多了
Dialogue: 0,0:11:30.14,0:11:32.37,CHS,,0,0,0,,暫時動不了了
Dialogue: 0,0:11:35.77,0:11:40.42,CHS,,0,0,0,,結果 論毅力的話 還是比不上年輕人啊
Dialogue: 0,0:11:46.95,0:11:49.35,CHS,,0,0,0,,你們是放出霧和陽炎的
Dialogue: 0,0:11:50.67,0:11:53.70,CHS,,0,0,0,,終於現身了啊 膽小鬼
Dialogue: 0,0:11:54.20,0:11:57.60,CHS,,0,0,0,,避免以短對長也是戰術的基礎
Dialogue: 0,0:11:58.05,0:12:00.67,CHS,,0,0,0,,亞羅完成了她的使命
Dialogue: 0,0:12:04.32,0:12:07.92,CHS,,0,0,0,,被笨蛋和膽小鬼殺掉的心情如何
Dialogue: 0,0:12:08.14,0:12:11.14,CHS,,0,0,0,,你現在只能任人宰割
Dialogue: 0,0:12:11.62,0:12:13.30,CHS,,0,0,0,,我來送你一程吧
Dialogue: 0,0:12:22.72,0:12:26.07,CHS,,0,0,0,,遺憾 那也是陽炎
Dialogue: 0,0:12:26.30,0:12:27.20,CHS,,0,0,0,,去死吧
Dialogue: 0,0:12:27.45,0:12:30.41,CHS,,0,0,0,,你的垂死掙扎還是挺強的
Dialogue: 0,0:12:30.57,0:12:32.50,CHS,,0,0,0,,不過打不中就沒意義了
Dialogue: 0,0:12:36.62,0:12:39.12,CHS,,0,0,0,,不 我正中目標了
Dialogue: 0,0:12:56.56,0:13:00.62,CHS,,0,0,0,,既可從天而降 也可由地而生
Dialogue: 0,0:13:01.10,0:13:02.95,CHS,,0,0,0,,橫跨天地的
Dialogue: 0,0:13:03.27,0:13:03.87,CHS,,0,0,0,,呃
Dialogue: 0,0:13:04.94,0:13:05.60,CHS,,0,0,0,,呵
Dialogue: 0,0:13:06.37,0:13:07.17,CHS,,0,0,0,,正是騎士
Dialogue: 0,0:13:11.24,0:13:14.55,CHS,,0,0,0,,我看到亞瑟在天花板上偷看了
Dialogue: 0,0:13:15.05,0:13:16.42,CHS,,0,0,0,,就把他打下來了
Dialogue: 0,0:13:19.17,0:13:22.82,CHS,,0,0,0,,把我這位居於天上的英雄召喚回地上的
Dialogue: 0,0:13:23.22,0:13:26.15,CHS,,0,0,0,,中隊長 是你嗎
Dialogue: 0,0:13:29.55,0:13:31.80,CHS,,0,0,0,,不用我說 你也知道情況了吧
Dialogue: 0,0:13:32.25,0:13:32.92,CHS,,0,0,0,,當然
Dialogue: 0,0:13:33.20,0:13:36.81,CHS,,0,0,0,,現在才露臉 他們是在伏爾甘工坊的那伙人吧
Dialogue: 0,0:13:37.89,0:13:39.75,CHS,,0,0,0,,米拉奇 交給你了
Dialogue: 0,0:13:40.52,0:13:41.67,CHS,,0,0,0,,是你啊
Dialogue: 0,0:13:42.44,0:13:45.07,CHS,,0,0,0,,讓我用陽炎解決你第二次吧
Dialogue: 0,0:13:49.55,0:13:51.65,CHS,,0,0,0,,還是這一手啊
Dialogue: 0,0:13:52.03,0:13:55.72,CHS,,0,0,0,,用這一手就能解決一切了
Dialogue: 0,0:13:56.12,0:13:56.82,CHS,,0,0,0,,死吧
Dialogue: 0,0:14:08.90,0:14:12.52,CHS,,0,0,0,,剛才的攻擊裡 沒有生命的重量
Dialogue: 0,0:14:13.22,0:14:15.27,CHS,,0,0,0,,在戰場上感受生命
Dialogue: 0,0:14:15.70,0:14:19.87,CHS,,0,0,0,,自己的 同伴的 包括敵人的生命
Dialogue: 0,0:14:20.42,0:14:22.07,CHS,,0,0,0,,有了生命的意識
Dialogue: 0,0:14:22.07,0:14:24.62,CHS,,0,0,0,,就不會那麼緊張了
Dialogue: 0,0:14:25.30,0:14:27.77,CHS,,0,0,0,,不要被牽制或者佯攻迷惑了
Dialogue: 0,0:14:28.07,0:14:30.75,CHS,,0,0,0,,抓住真正要你性命的攻擊
Dialogue: 0,0:14:32.15,0:14:33.50,CHS,,0,0,0,,集中注意
Dialogue: 0,0:14:34.25,0:14:37.02,CHS,,0,0,0,,感受生命的話 就不會緊張
Dialogue: 0,0:14:39.33,0:14:43.12,CHS,,0,0,0,,現在的我掌握了武士技能 有兼職在身
Dialogue: 0,0:14:44.42,0:14:45.57,CHS,,0,0,0,,我是騎士武士
Dialogue: 0,0:14:51.38,0:14:54.02,CHS,,0,0,0,,等等 集中注意
Dialogue: 0,0:14:55.09,0:14:58.05,CHS,,0,0,0,,說騎士武士的話 我就變成武士了
Dialogue: 0,0:14:58.60,0:14:59.62,CHS,,0,0,0,,那就是
Dialogue: 0,0:15:00.62,0:15:01.62,CHS,,0,0,0,,什麼樣
Dialogue: 0,0:15:04.27,0:15:06.57,CHS,,0,0,0,,啊 對了 反過來啊
Dialogue: 0,0:15:07.25,0:15:08.48,CHS,,0,0,0,,武士騎士
Dialogue: 0,0:15:13.65,0:15:15.95,CHS,,0,0,0,,你的動態視力太好了
Dialogue: 0,0:15:16.30,0:15:20.87,CHS,,0,0,0,,因此容易被看到的東西和細微的動作欺騙
Dialogue: 0,0:15:25.08,0:15:27.50,CHS,,0,0,0,,眼前看到的東西不是全部
Dialogue: 0,0:15:28.34,0:15:32.21,CHS,,0,0,0,,我本來想放出一堆佯攻的陽炎試探一下
Dialogue: 0,0:15:32.40,0:15:34.40,CHS,,0,0,0,,他是在假裝看破一切嗎
Dialogue: 0,0:15:35.10,0:15:35.97,CHS,,0,0,0,,那麼
Dialogue: 0,0:15:36.40,0:15:39.10,CHS,,0,0,0,,他應該會覺得這大量的群體攻擊裡
Dialogue: 0,0:15:39.37,0:15:42.15,CHS,,0,0,0,,混雜了一個真正的攻擊吧
Dialogue: 0,0:15:42.92,0:15:45.35,CHS,,0,0,0,,但那全都是假的
Dialogue: 0,0:15:47.06,0:15:51.70,CHS,,0,0,0,,要奪人性命的攻擊有著獨特的呼吸
Dialogue: 0,0:15:52.35,0:15:54.50,CHS,,0,0,0,,發現那種生命的呼吸
Dialogue: 0,0:15:56.42,0:15:58.07,CHS,,0,0,0,,就是這招 笨蛋
Dialogue: 0,0:16:00.53,0:16:02.85,CHS,,0,0,0,,要取人性命的呼吸
Dialogue: 0,0:16:03.58,0:16:04.95,CHS,,0,0,0,,生命的呼吸
Dialogue: 0,0:16:06.20,0:16:08.96,CHS,,0,0,0,,在你被陽炎騙到 露出破綻之前
Dialogue: 0,0:16:09.08,0:16:11.84,CHS,,0,0,0,,我是絕對不會接近你的
Dialogue: 0,0:16:13.40,0:16:17.93,CHS,,0,0,0,,當你露出破綻的那一刻 我就暗中用飛刀解決你
Dialogue: 0,0:16:18.67,0:16:19.75,CHS,,0,0,0,,首先是
Dialogue: 0,0:16:22.07,0:16:23.32,CHS,,0,0,0,,生命的呼吸
Dialogue: 0,0:16:24.27,0:16:26.97,CHS,,0,0,0,,居合聖劍
Dialogue: 0,0:16:37.95,0:16:41.47,CHS,,0,0,0,,你這傢伙 我就呼吸一下你也要砍我嗎
Dialogue: 0,0:16:42.07,0:16:42.67,CHS,,0,0,0,,哼
Dialogue: 0,0:16:43.62,0:16:46.75,CHS,,0,0,0,,不要擅自定論 我可是騎士武士啊
Dialogue: 0,0:16:50.70,0:16:52.95,CHS,,0,0,0,,不 不可能
Dialogue: 0,0:16:55.00,0:16:57.67,CHS,,0,0,0,,他沒想在霧中刺殺我
Dialogue: 0,0:16:57.67,0:16:59.55,CHS,,0,0,0,,而是想刺殺中隊長
Dialogue: 0,0:17:00.09,0:17:02.01,CHS,,0,0,0,,這人怎麼這麼狡猾
Dialogue: 0,0:17:03.10,0:17:03.90,CHS,,0,0,0,,站得起來嗎
Dialogue: 0,0:17:05.47,0:17:06.70,CHS,,0,0,0,,做得不錯
Dialogue: 0,0:17:09.69,0:17:10.90,CHS,,0,0,0,,還有一個呢
Dialogue: 0,0:17:11.23,0:17:13.40,CHS,,0,0,0,,丟下同伴逃跑了
Dialogue: 0,0:17:14.37,0:17:15.98,CHS,,0,0,0,,那傢伙的臉太怪了
Dialogue: 0,0:17:16.53,0:17:17.55,CHS,,0,0,0,,真的是人嗎
Dialogue: 0,0:17:18.52,0:17:19.05,CHS,,0,0,0,,怎麼說
Dialogue: 0,0:17:19.85,0:17:21.77,CHS,,0,0,0,,他的臉很像是捏出來的
Dialogue: 0,0:17:21.77,0:17:23.40,CHS,,0,0,0,,但他不是人還能是什麼
Dialogue: 0,0:17:32.13,0:17:33.85,CHS,,0,0,0,,還是先會合吧
Dialogue: 0,0:17:33.96,0:17:35.67,CHS,,0,0,0,,好 你帶路
Dialogue: 0,0:17:39.55,0:17:40.52,CHS,,0,0,0,,算了
Dialogue: 0,0:17:44.97,0:17:47.05,CHS,,0,0,0,,又是岔路
Dialogue: 0,0:17:47.40,0:17:50.50,CHS,,0,0,0,,地底太糟糕了 這也太難懂了
Dialogue: 0,0:17:50.95,0:17:53.37,CHS,,0,0,0,,我們該去哪邊呢
Dialogue: 0,0:17:57.07,0:18:00.85,CHS,,0,0,0,,左邊的路好像有什麼在發光
Dialogue: 0,0:18:04.35,0:18:06.47,CHS,,0,0,0,,咦 為什麼越來越近了
Dialogue: 0,0:18:06.55,0:18:08.17,CHS,,0,0,0,,眼 眼睛
Dialogue: 0,0:18:11.27,0:18:12.92,CHS,,0,200,0,,鬼啊
Dialogue: 0,0:18:11.27,0:18:12.92,CHS,,400,0,0,,噫
Dialogue: 0,0:18:13.25,0:18:15.45,CHS,,0,0,0,,說誰是獨眼巨猩呢
Dialogue: 0,0:18:15.75,0:18:18.15,CHS,,0,0,0,,沒人說
Dialogue: 0,0:18:18.47,0:18:20.80,CHS,,0,0,0,,咦 是茉希
Dialogue: 0,0:18:21.47,0:18:23.60,CHS,,0,0,0,,那 那個鬼的眼睛
Dialogue: 0,0:18:24.27,0:18:26.12,CHS,,0,0,0,,噗嘶噗嘶和梅拉梅拉
Dialogue: 0,0:18:28.62,0:18:30.07,CHS,,0,0,0,,茉希哇
Dialogue: 0,0:18:30.07,0:18:31.92,CHS,,0,0,0,,乖 不哭不哭
Dialogue: 0,0:18:37.40,0:18:39.82,CHS,,0,0,0,,突然出現兩個活體反應
Dialogue: 0,0:18:40.22,0:18:43.15,CHS,,0,0,0,,15公尺處 眼睛能看到的距離啊
Dialogue: 0,0:18:43.60,0:18:44.67,CHS,,0,0,0,,是伙伴嗎
Dialogue: 0,0:18:45.95,0:18:49.57,CHS,,0,0,0,,你們再也見不到伙伴了
Dialogue: 0,0:18:56.50,0:18:57.37,CHS,,0,0,0,,麗莎
Dialogue: 0,0:18:58.65,0:19:02.27,CHS,,0,0,0,,居然穿著最討厭的消防官的外套
Dialogue: 0,0:19:02.75,0:19:05.75,CHS,,0,0,0,,你這樣子真是蠢透了 伏爾甘
Dialogue: 0,0:19:08.68,0:19:10.80,CHS,,0,0,0,,你穿什麼都很合適啊
Dialogue: 0,0:19:12.85,0:19:15.55,CHS,,0,0,0,,你成為自己討厭的消防官
Dialogue: 0,0:19:15.55,0:19:17.48,CHS,,0,0,0,,來這地下幹什麼
Dialogue: 0,0:19:17.82,0:19:19.12,CHS,,0,0,0,,你真傻啊
Dialogue: 0,0:19:19.30,0:19:21.87,CHS,,0,0,0,,我當然是為了來見麗莎你啊
Dialogue: 0,0:19:27.35,0:19:29.55,CHS,,0,0,0,,怎麼了 菲拉
Dialogue: 0,0:19:30.77,0:19:33.40,CHS,,0,0,0,,是誰把你撿回來的
Dialogue: 0,0:19:33.85,0:19:38.47,CHS,,0,0,0,,是誰把你這隻無知的野貓教化成人的
Dialogue: 0,0:19:38.92,0:19:42.65,CHS,,0,0,0,,還有驅使火焰 驅使男人的方法
Dialogue: 0,0:19:42.65,0:19:45.27,CHS,,0,0,0,,全都是我教給你的啊
Dialogue: 0,0:19:45.95,0:19:50.89,CHS,,0,0,0,,你只是利用我教給你的知識去接近伏爾甘而已
Dialogue: 0,0:19:51.40,0:19:53.17,CHS,,0,0,0,,你能從伏爾甘那裡得到東西
Dialogue: 0,0:19:53.17,0:19:55.42,CHS,,0,0,0,,也多虧了有我的教導
Dialogue: 0,0:19:55.77,0:19:58.82,CHS,,0,0,0,,因為你實際上是隻無知的野貓
Dialogue: 0,0:19:59.10,0:20:02.32,CHS,,0,0,0,,需要我再多教教你嗎
Dialogue: 0,0:20:02.55,0:20:04.11,CHS,,0,0,0,,你離麗莎遠點
Dialogue: 0,0:20:16.46,0:20:21.72,CHS,,0,0,0,,灰焰騎士團菲拉 這才是我的真名
Dialogue: 0,0:20:25.60,0:20:28.82,CHS,,0,0,0,,對 你要保護我
Dialogue: 0,0:20:28.97,0:20:29.45,CHS,,0,0,0,,是
Dialogue: 0,0:20:29.80,0:20:31.22,CHS,,0,0,0,,不對 麗莎
Dialogue: 0,0:20:31.43,0:20:32.26,CHS,,0,0,0,,閉嘴
Dialogue: 0,0:20:34.60,0:20:35.67,CHS,,0,0,0,,鐵鎧鼠
Dialogue: 0,0:20:36.56,0:20:40.20,CHS,,0,0,0,,我不知道你教了麗莎什麼東西
Dialogue: 0,0:20:40.87,0:20:44.30,CHS,,0,0,0,,大人本就應該教導後輩啊
Dialogue: 0,0:20:44.60,0:20:47.11,CHS,,0,0,0,,少假仁假義了 臭老頭
Dialogue: 0,0:20:49.07,0:20:51.25,CHS,,0,0,0,,這樣看來 你才是無知的人啊
Dialogue: 0,0:20:51.25,0:20:53.83,CHS,,0,0,0,,無能的第8隊大隊長
Dialogue: 0,0:20:54.17,0:20:55.80,CHS,,0,0,0,,隨便你說我什麼
Dialogue: 0,0:20:56.10,0:20:59.85,CHS,,0,0,0,,明明你都不知道人體自燃的火焰是什麼
Dialogue: 0,0:21:01.04,0:21:04.45,CHS,,0,0,0,,我們傳教者知曉一切
Dialogue: 0,0:21:06.82,0:21:11.95,CHS,,0,0,0,,侵襲這個世界的人體自燃現象產生的原因
Dialogue: 0,0:21:12.55,0:21:16.90,CHS,,0,0,0,,能人為引發人體自燃的焰蟲真身
Dialogue: 0,0:21:17.17,0:21:20.85,CHS,,0,0,0,,森羅日下部擁有的安德拉爆炎的秘密
Dialogue: 0,0:21:21.52,0:21:25.90,CHS,,0,0,0,,為什麼它會被稱作滅亡之火
Dialogue: 0,0:21:25.90,0:21:29.15,CHS,,0,0,0,,這個世界曾經發生過什麼
Dialogue: 0,0:21:30.03,0:21:32.92,CHS,,0,0,0,,現在正在發生著什麼
Dialogue: 0,0:21:34.03,0:21:37.27,CHS,,0,0,0,,傳教者全都知道
Dialogue: 0,0:21:38.55,0:21:41.55,CHS,,0,0,0,,而我什麼都不會告訴你
Dialogue: 0,0:21:43.50,0:21:46.37,CHS,,0,0,0,,你也真的不適合教人啊
Dialogue: 0,0:21:48.65,0:21:50.97,CHS,,0,0,0,,有趣的男人
Dialogue: 0,0:00:00.00,0:00:00.00,JAP,,0,0,0,,
